#!/usr/bin/env sh
# ─────────────────────────────────────────────────────────────────────────────
# Pre-commit gate: when Legion voting is enabled (legion.json "votingEnabled"),
# the trusted panel (claude / openai / gemini / deepseek) must authenticate
# LIVE before a commit — no point committing when a panel key is dead.
#
# Legion voting is OFF by default project-wide (SS-A44) and, per author ruling
# 2026-08-22, considered unreliable in practice (never once caught a real
# defect) — LiveKeyValidationTests skips this check entirely with no network
# calls while votingEnabled=false, so this gate is a no-op until voting is
# re-enabled.
#
# Offline / no-network bypass (use sparingly):
#   SKIP_LLM_KEY_CHECK=1 git commit -m "..."
# ─────────────────────────────────────────────────────────────────────────────
set -e

# ── Async-safe siloing: content-only commits skip the build+key gate ─────────
# Multiple sessions can share one working tree (parallel story/code work). The
# LLM-key validation below runs `dotnet test`, which BUILDS the solution from
# working-tree source — so another session's uncompiled .cs WIP would otherwise
# fail the build and block an unrelated docs/prose/data commit. If nothing
# build-affecting is staged, the gate is irrelevant to this commit — skip it so
# story/content work commits independently of anyone's in-progress code.
# (Code commits — anything staging .cs/.csproj/.sln/.props/.targets — still get
#  the full MCP-doc + LLM-key gate below.)
if ! git diff --cached --name-only | grep -qE '\.(cs|csproj|sln|props|targets)$'; then
  echo "pre-commit: content-only commit (no code staged) — skipping build + LLM-key gate."
  exit 0
fi

# ── Keep the MCP tool reference in sync ──────────────────────────────────────
# When any MCP tool source is staged, regenerate docs/MCP_TOOLS.md from the live
# [McpServerTool] attributes and stage it, so the doc never drifts from the code.
# Non-fatal: a regen failure only warns — the LLM-key gate below is the real
# blocker. Runs only when tool sources change, so normal commits are unaffected.
if git diff --cached --name-only | grep -qE 'Prose\.Mcp/(Tools|ToolDocGenerator)'; then
  echo "pre-commit: MCP tools changed — regenerating docs/MCP_TOOLS.md…"
  if dotnet run --project v3/Prose.Mcp -- --export-tools docs/MCP_TOOLS.md >/dev/null 2>&1; then
    git add docs/MCP_TOOLS.md
    echo "pre-commit: docs/MCP_TOOLS.md refreshed and staged."
  else
    echo "pre-commit: WARN — MCP tool doc regen failed; committing without refresh." >&2
  fi
fi

if [ "${SKIP_LLM_KEY_CHECK:-0}" = "1" ]; then
  echo "pre-commit: SKIP_LLM_KEY_CHECK=1 — skipping live LLM key validation."
  exit 0
fi

echo "pre-commit: validating Prose trusted LLM panel keys (live)…"
if dotnet test v3/Prose.UnitTests -c Release \
      --filter "Category=LiveKeysTrusted" \
      --nologo --verbosity quiet; then
  echo "pre-commit: all trusted LLM keys valid — proceeding."
  exit 0
fi

cat >&2 <<'MSG'

pre-commit: BLOCKED — a trusted LLM key failed live validation.
  Fix/rotate the failing key, then re-commit:
    • local:  %APPDATA%\MindAttic\LLM\providers.json
    • cloud:  Azure Key Vault secret  MindAttic--Vault--LLM--<provider>--apiKey
  Or narrow legion.json "voters" to the providers that work.
  Offline bypass (last resort):  SKIP_LLM_KEY_CHECK=1 git commit ...
MSG
exit 1
