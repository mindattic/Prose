{
  "name": "prose-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Cypress headless navigation suite for the Prose Blazor app.",
  "scripts": {
    "docs": "node --use-system-ca tools/build-readme.js",
    "e2e": "cypress run",
    "e2e:open": "cypress open",
    "e2e:nav": "cypress run --spec cypress/e2e/navigation.cy.js",
    "e2e:strand": "cypress run --spec cypress/e2e/strand-smoke.cy.js"
  },
  "devDependencies": {
    "cypress": "^15.20.0",
    "marked": "^14.0.0"
  }
}
