<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Needed to resolve System.Windows.Automation (UIAutomationClient/UIAutomationTypes) —
         the client-side UI Automation API used to fill and confirm a native file dialog from
         outside the browser sandbox. No WPF UI is actually shown; this is a headless watcher. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
