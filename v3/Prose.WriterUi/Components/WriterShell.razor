@* The render mode is set by the host page, not here — this library intentionally has no
   FrameworkReference to the ASP.NET Core server assemblies, matching Prose.ObserverUi.

   This component is composition and state: which book, which beat, what saving means, and what a
   chip click should do. The surfaces themselves live in MenuBar / BeatNavigator / ProseEditor /
   EntityLinkModal, so that adding a pane or a panel does not mean growing one file without end. *@
@inject WriterService Writer
@inject WikiService Wiki
@inject ReadAloudUiService ReadAloud
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="writer">

    <a class="skip-link" href="#beat-pane">Skip to the beat</a>

    <h1 class="visually-hidden">
        @(book is null ? "Prose Writer" : $"{book.Title} — Prose Writer")
    </h1>

    <MenuBar Books="books"
             BookMenuOpen="bookMenuOpen"
             Book="book"
             BeatCount="@(spine?.Count ?? 0)"
             HasBeat="@(beat is not null)"
             Mode="mode"
             Dirty="Dirty"
             Saving="saving"
             Exporting="exporting"
             Theme="theme"
             OnToggleBookMenu="ToggleBookMenu"
             OnOpenBook="OpenBookAsync"
             OnSetMode="SetMode"
             OnSave="() => SaveAsync(false)"
             OnExport="ExportAsync"
             OnToggleTheme="ToggleThemeAsync"
             OnOpenSettings="() => settingsOpen = true"
             OnFormat="FormatAsync"
             OnInsertEmDash="InsertEmDashAsync"
             OnAddEntity="AddEntityAsync"
             OnReadAloud="ReadAloudAsync"
             OnStopReading="StopReadingAsync"
             Speaking="speaking"
             FindOpen="findOpen"
             OnToggleFind="OpenFind"
             FindingsOpen="findingsOpen"
             OnToggleFindings="() => findingsOpen = !findingsOpen"
             Scale="scale"
             OnScale="StepScaleAsync" />

    <div class="body">

        <BeatNavigator Spine="spine" CurrentBeatId="beatId" OnSelect="OpenBeatAsync" />

        @* tabindex="-1" so the skip link can actually move focus here; without it the browser
           scrolls but focus stays in the menubar and the next Tab returns to Export. *@
        <main class="pane" id="beat-pane" tabindex="-1">
            @if (beat is null)
            {
                <div class="empty">No beat selected.</div>
            }
            else
            {
                @if (conflict is not null)
                {
                    @* Both texts, side by side. This banner used to offer "discard mine" and
                       "overwrite" while showing NEITHER — asking the author to choose which of two
                       versions to destroy without letting them see either one, when conflict.Text
                       was sitting in memory the whole time. *@
                    <div class="banner danger" role="alert">
                        <strong>This beat changed underneath you.</strong>
                        Something else wrote to it while you had it open — another session, a CLI
                        command, or a tool. Read both before choosing; one of them is about to go.
                    </div>

                    <div class="conflict">
                        <section class="conflict-side">
                            <h3>Yours <span class="muted">@WordsIn(draft) words, unsaved</span></h3>
                            <pre class="conflict-text">@Plain(draft)</pre>
                            <button class="mini" @onclick="OverwriteConflictAsync">Keep mine — overwrite theirs</button>
                        </section>

                        <section class="conflict-side">
                            <h3>Theirs <span class="muted">@WordsIn(conflict.Text) words, saved · v@conflict.Version</span></h3>
                            <pre class="conflict-text">@Plain(conflict.Text)</pre>
                            <button class="mini" @onclick="ReloadFromConflictAsync">Take theirs — discard mine</button>
                        </section>
                    </div>
                }

                @if (problems.Count > 0)
                {
                    <div class="banner danger" role="alert">
                        <strong>Not saved — the markup is malformed.</strong>
                        <ul>
                            @foreach (var p in problems)
                            {
                                <li>@p.Message <span class="muted">(at character @p.Offset)</span></li>
                            }
                        </ul>
                    </div>
                }

                @if (jsError is not null)
                {
                    <div class="banner danger" role="alert">
                        <strong>The Display editor could not start — switched to Markdown mode.</strong>
                        <div class="muted">@jsError</div>
                        Your text is safe and still editable here. This is usually a stale cached
                        script: reload the window (Ctrl+R) to pick up the current build.
                    </div>
                }

                @if (tagNote is not null)
                {
                    <div class="banner info" role="status">@tagNote</div>
                }

                @if (exportNote is not null)
                {
                    <div class="banner info" role="status">
                        @exportNote
                        @if (exportDir is not null)
                        {
                            <button class="mini" @onclick="OpenExportFolderAsync">Open folder</button>
                        }
                    </div>
                }

                <ProseEditor @ref="editor"
                             Text="draft"
                             TextChanged="OnDraftChanged"
                             Mode="mode"
                             EntityContextMenu="OnEntityChipContextMenu"
                             EntityClick="OnEntityChipClick"
                             DiscussRequested="OnDiscussRequested"
                             ContextMenuRequested="OnContextMenuAsync"
                             OnDisconnected="OnEditorDisconnected"
                             OnJsError="OnEditorJsError" />
            }
        </main>

        @if (findingsOpen && book is not null)
        {
            <FindingsPanel BookNodeId="book.Id"
                           OnJumpToBeat="OpenBeatAsync"
                           OnClose="() => findingsOpen = false" />
        }

        @if (findOpen && book is not null)
        {
            <FindPanel BookNodeId="book.Id" CurrentBeatId="beatId"
                       OnJumpToBeat="OpenBeatAsync"
                       OnClose="() => findOpen = false" />
        }

        @if (book is not null && beat is not null)
        {
            <DiscussPanel @ref="discussPanel"
                          BookNodeId="book.Id"
                          BeatId="beat.Id"
                          OnJumpToBeat="OpenBeatAsync"
                          OnOpenSettings="() => settingsOpen = true"
                          OnBeatWritten="ReloadAfterProposalAsync" />
        }
    </div>

    <footer class="statusbar">
        <span class="dot @(connected ? "ok" : "bad")" aria-hidden="true"></span>
        <span>PID: @hubProcessId</span>
        <span class="sep">·</span>
        <span>@(connected ? "Connected" : "Disconnected")</span>
        <span class="sep">·</span>
        <span role="status">@activity</span>
        @if (sweepNote is not null)
        {
            @* The background sweep, said out loud. It spends real money for minutes and used to
               do so with no indication it had started, finished, failed or cost anything. *@
            <span class="sep">·</span>
            <span role="status" class="muted">@sweepNote</span>
            <button class="mini" @onclick="() => sweepNote = null"
                    aria-label="Dismiss the consistency check result">✕</button>
        }
        @if (beat is not null)
        {
            <div class="spacer"></div>
            <span class="muted">@WordCount words</span>
            <span class="sep">·</span>
            <span class="muted">v@beat.Version</span>
            @if (Dirty)
            {
                <span class="sep">·</span>
                <span class="dirty">unsaved</span>
            }
        }
    </footer>
</div>

@if (settingsOpen)
{
    <SettingsPanel OnClose="() => settingsOpen = false" />
}

<ContextMenu Items="contextItems" X="contextAt.X" Y="contextAt.Y"
             OnClose="() => contextItems = []" />

@if (pendingDelete is not null)
{
    @* Shows the prose. A confirmation that asks "are you sure" without showing what is about to
       be lost is one the author learns to click through — which is exactly when it stops
       protecting them. Same reason the conflict banner now shows both texts. *@
    <div class="scrim" aria-hidden="true" @onclick="() => pendingDelete = null"></div>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="delete-title">
        <h2 id="delete-title">Delete this beat?</h2>
        <p class="muted">This removes the beat and its prose from the book. It cannot be undone here.</p>
        <pre class="delete-preview">@Shorten(Prose.Core.Services.BeatMarkup.StripEntityTags(pendingDelete.Text), 1200)</pre>
        <div class="modal-actions">
            <button class="mini" @onclick="() => pendingDelete = null">Keep it</button>
            <div class="spacer"></div>
            <button class="danger-btn" @onclick="ConfirmDeleteAsync">Delete the beat</button>
        </div>
    </div>
}

@if (entityModal is not null)
{
    <EntityLinkModal Model="entityModal"
                     Search="entitySearch"
                     SearchChanged="v => entitySearch = v"
                     Searching="searching"
                     Matches="matches"
                     OnSearch="SearchEntitiesAsync"
                     OnChoose="ChooseEntity"
                     OnApply="ApplyEntityAsync"
                     OnRemove="RemoveEntityAsync"
                     OnCancel="CloseEntityModal" />
}

@code {
    private List<WriterService.BookListItem>? books;
    private WriterService.BookListItem? book;
    private List<WriterService.SpineItem>? spine;

    private Guid beatId;
    private WriterService.OpenBeat? beat;
    private string draft = "";
    private EditorMode mode = EditorMode.Display;

    private ProseEditor? editor;
    private DiscussPanel? discussPanel;
    private bool settingsOpen;
    private bool speaking;
    private System.Threading.Timer? autosave;

    private bool bookMenuOpen;
    private bool saving;
    private bool exporting;
    private string? exportNote;
    private string? exportDir;
    private bool analysisPending;
    private string theme = "dark";

    /// <summary>The text-size multiplier. Read back from the browser on first render so the
    /// author's choice survives a reload, and clamped by the JS side.</summary>
    private double scale = 1;
    private string? tagNote;
    private string? jsError;
    private WriterService.OpenBeat? conflict;
    private IReadOnlyList<Prose.Core.Services.BeatMarkup.MarkupProblem> problems = [];

    private EntityLinkModal.State? entityModal;
    private string entitySearch = "";
    private bool searching;
    private List<Prose.Core.Services.EntityLookupMatch>? matches;

    // The UI runs inside the Hub, so this process IS the Hub the status bar is reporting on.
    private readonly int hubProcessId = Environment.ProcessId;
    private bool connected = true;
    private string activity = "Idle";

    private bool Dirty => beat is not null && draft != beat.Text;

    private int WordCount =>
        Prose.Core.Services.ProseInline.StripFormatting(
            Prose.Core.Services.BeatMarkup.StripEntityTags(draft))
            .Split([' ', '\n', '\r', '\t'], StringSplitOptions.RemoveEmptyEntries).Length;

    /// <summary>
    /// How often unsaved prose is written back. Costs nothing: an autosave passes
    /// <c>deferAnalysis: true</c>, which is exactly what that parameter was built for — the
    /// paid logic sweep still waits until the author leaves the beat.
    /// </summary>
    private static readonly TimeSpan AutosaveInterval = TimeSpan.FromSeconds(20);

    protected override void OnInitialized()
    {
        // Before this existed, everything since the last manual Save was lost on Alt+F4, on the
        // window X, and whenever the Hub health check flipped the splash back over the editor.
        autosave = new System.Threading.Timer(
            _ => _ = InvokeAsync(AutosaveTickAsync), null, AutosaveInterval, AutosaveInterval);
    }

    private async Task AutosaveTickAsync()
    {
        if (!Dirty || saving || book is null || beat is null) return;
        await SaveAsync(finishing: false, quiet: true);
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { theme = await JS.InvokeAsync<string>("proseWriter.getTheme"); StateHasChanged(); }
        catch (JSDisconnectedException) { connected = false; }
        catch (JSException) { /* theme is a preference; never worth failing a render over */ }

        try { scale = await JS.InvokeAsync<double>("proseWriter.applyScale"); StateHasChanged(); }
        catch (JSDisconnectedException) { connected = false; }
        catch (JSException) { /* a text size is a preference; never worth failing a render over */ }

        // Ctrl+F belongs to the shell rather than to a panel: it has to work whether or not Find
        // is already open, and it is the shell that knows which book to search.
        shellRef ??= DotNetObjectReference.Create(this);
        await JsVoidAsync("proseHotkeys.registerShell", shellRef);
    }

    private DotNetObjectReference<WriterShell>? shellRef;

    /// <summary>One notch bigger or smaller. 10% a press: small enough to land where the author
    /// wants, large enough that reaching 200% is six presses rather than twenty.</summary>
    private async Task StepScaleAsync(int direction)
    {
        var wanted = scale + (direction >= 0 ? 0.1 : -0.1);
        try { scale = await JS.InvokeAsync<double>("proseWriter.setScale", wanted); }
        catch (JSDisconnectedException) { connected = false; }
        catch (JSException ex) { jsError = ex.Message; }
    }

    /// <summary>Ctrl+F. Toggling rather than only opening: pressing it again with Find already up
    /// is how everyone closes a find bar.</summary>
    [JSInvokable]
    public Task OpenFind()
    {
        findOpen = !findOpen;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private bool findOpen;

    /// <summary>The findings inbox. Closed by default — it is a thing the author goes and looks
    /// at, not a thing that should sit beside the prose demanding attention while they write.</summary>
    private bool findingsOpen;

    // ── Editor callbacks ───────────────────────────────────────────────────

    private void OnDraftChanged(string text) => draft = text;

    private void OnEditorDisconnected() => connected = false;

    private void OnEditorJsError(string message)
    {
        // A broken editor surface is bad; a dead application is worse. Markdown mode needs no
        // JavaScript at all, so it is always a safe place to land.
        jsError = message;
        mode = EditorMode.Markdown;
    }

    /// <summary>
    /// The author right-clicked a selection. Unsaved edits are not a problem here — the anchor is
    /// located in the beat as STORED, and a passage the author has just typed and not yet saved
    /// simply will not be found, which the panel reports rather than guessing at.
    /// </summary>
    private void OnDiscussRequested(ProseEditor.SelectedSpan span)
        => discussPanel?.BeginFor(span);

    private async Task OnEntityChipContextMenu(ProseEditor.EntityChip chip)
    {
        entityModal = new EntityLinkModal.State
        {
            IsNew = false, Guid = chip.Guid, Repo = chip.Repo, Text = chip.Text,
        };
        entitySearch = chip.Text;
        await SearchEntitiesAsync();
    }

    /// <summary>
    /// Left-click on an entity chip: open that entity's wiki page in the default browser.
    ///
    /// <para>Launched from the Hub rather than with <c>window.open</c> because this page is
    /// normally displayed inside Writer.exe's WebView2 host, which may swallow a popup or divert
    /// it into a second WebView2 window. The Hub is always on the author's own machine, so
    /// shelling to the shell is both available and predictable.</para>
    ///
    /// <para>Phase 6 replaces this with an entity pane in this same window — losing your place in
    /// the manuscript is the worst possible answer to "tell me about this character".</para>
    /// </summary>
    private async Task OnEntityChipClick(ProseEditor.EntityChip chip)
    {
        if (!Guid.TryParse(chip.Guid, out var id)) return;

        // The chip carries the guid and a repo hint, but the wiki is addressed by slug, and the
        // hint is explicitly non-authoritative (see BeatMarkup) — so resolve it properly.
        var route = await Wiki.GetRouteAsync(id);
        if (route is null)
        {
            activity = "That tag points at an entity that no longer exists.";
            return;
        }

        var url = $"http://127.0.0.1:5900/repo/{Uri.EscapeDataString(route.Value.Type)}/{Uri.EscapeDataString(route.Value.Slug)}";
        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(url)
            {
                UseShellExecute = true,
            });
            activity = "Opened in browser";
        }
        catch (Exception ex)
        {
            // No default browser, or the shell refused. Say so — a click that silently does
            // nothing is worse than one that explains itself.
            activity = $"Could not open a browser: {ex.Message}";
        }
    }

    // ── Book and beat ──────────────────────────────────────────────────────

    private async Task ToggleBookMenu()
    {
        bookMenuOpen = !bookMenuOpen;
        if (bookMenuOpen && books is null)
        {
            activity = "Loading books…";
            books = await Writer.ListBooksAsync();
            activity = "Idle";
        }
    }

    private async Task OpenBookAsync(WriterService.BookListItem b)
    {
        bookMenuOpen = false;
        book = b;
        spine = null;
        beat = null;
        beatId = default;
        exportNote = null;   // book-scoped, unlike the beat banners ClearBeatState handles
        exportDir = null;
        activity = "Loading book…";
        StateHasChanged();

        spine = await Writer.GetSpineAsync(b.Id);
        activity = "Idle";
        if (spine.Count > 0) await OpenBeatAsync(spine[0].BeatId);
    }

    private async Task OpenBeatAsync(Guid id)
    {
        // Leaving a beat is when the deferred analysis runs — one pass per finished edit, rather
        // than one per save. A beat with unsaved changes is saved on the way out, not dropped.
        if (beat is not null && id != beatId)
        {
            if (Dirty)
            {
                await SaveAsync(finishing: true);

                // SaveAsync reports failure by setting state, never by throwing: malformed markup
                // leaves `problems`, and a concurrent write leaves `conflict`. Falling through
                // would run ClearBeatState() over both banners and then overwrite `draft` with the
                // beat that was clicked — destroying the author's edit AND the explanation for why
                // it could not be saved, with nothing on screen afterwards to say either happened.
                // Stay on this beat; the banner already says why.
                if (problems.Count > 0 || conflict is not null) return;
            }
            else RunDeferredAnalysis();
        }

        ClearBeatState();
        beatId = id;
        beat = await Writer.GetBeatAsync(id);
        draft = beat?.Text ?? "";
    }

    /// <summary>
    /// Pick up a beat that an approved proposal just rewrote underneath the editor.
    ///
    /// <para>Not optional, and not the same as <see cref="OpenBeatAsync"/>: this beat is already
    /// open, so that method's "leaving a beat" path would not run. Without the reload the editor
    /// keeps showing the pre-approval prose, and the next autosave — twenty seconds later, with no
    /// one touching anything — writes it straight back over the change the author just approved.</para>
    /// </summary>
    private async Task ReloadAfterProposalAsync(Guid id)
    {
        if (id != beatId) return;

        ClearBeatState();
        beat = await Writer.GetBeatAsync(id);
        draft = beat?.Text ?? "";
        activity = "Change applied.";
        StateHasChanged();
    }

    private void ClearBeatState()
    {
        problems = [];
        tagNote = null;
        conflict = null;
    }

    private void SetMode(EditorMode m) => mode = m;

    /// <param name="quiet">An autosave the author did not ask for. Suppresses the tag-diff
    /// banner, which would otherwise pop up every few seconds saying nothing new. Failures are
    /// never quiet: malformed markup and conflicts still raise their banners.</param>
    private async Task SaveAsync(bool finishing, bool quiet = false)
    {
        if (book is null || beat is null || saving) return;
        saving = true;
        activity = quiet ? "Autosaving…" : "Saving…";
        ClearBeatState();

        try
        {
            var result = await Writer.SaveBeatAsync(book.Id, beat.Id, draft, beat.UpdatedAt,
                                                    deferAnalysis: !finishing);
            problems = result.Problems;
            if (problems.Count > 0) return;

            // The scanner may have rewritten tags. Assigning the stored text back into the draft
            // is what re-renders the editor — ProseEditor pushes HTML whenever the text it is
            // handed differs from what it last drew.
            beat = result.Beat;
            draft = result.Beat.Text;
            analysisPending = !finishing && result.Changed;
            if (!quiet) tagNote = DescribeTagDiff(result);
        }
        catch (Prose.Core.Services.BeatConflictException ex)
        {
            conflict = new WriterService.OpenBeat(beat.Id, beat.ChapterNodeId, ex.CurrentText,
                                                  ex.CurrentUpdatedAt, beat.Version);
        }
        finally
        {
            saving = false;
            activity = "Idle";
        }
    }

    private static string? DescribeTagDiff(WriterService.SaveResult r)
    {
        if (!r.Changed) return "No change — the text you saved matches what was already stored.";

        var parts = new List<string>();
        if (r.Tags.Added.Count > 0) parts.Add($"tagged {string.Join(", ", r.Tags.Added)}");
        if (r.Tags.Removed.Count > 0) parts.Add($"dropped the tag on {string.Join(", ", r.Tags.Removed)}");
        return parts.Count == 0 ? null : "Saved. The entity scanner " + string.Join("; ", parts) + ".";
    }

    /// <summary>Reader-visible, for the conflict panels: the author is comparing what they WROTE,
    /// and entity wrappers are ~55 characters of difference per link that they did not type.</summary>
    private static string Plain(string? markup)
        => Prose.Core.Services.Discussion.BeatDiscussTarget.PlainText(markup);

    private static int WordsIn(string? markup)
        => Plain(markup).Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;

    private async Task ReloadFromConflictAsync()
    {
        if (conflict is null) return;
        beat = conflict;
        draft = conflict.Text;
        conflict = null;
        await Task.CompletedTask;
    }

    private async Task OverwriteConflictAsync()
    {
        if (conflict is null) return;
        var mine = draft;
        beat = conflict;
        draft = mine;
        conflict = null;
        await SaveAsync(finishing: false);
    }

    // ── Export ─────────────────────────────────────────────────────────────

    /// <summary>
    /// Render the open book to the publish folder and say where it went.
    ///
    /// <para>Saves first when the beat is dirty: "export the newest version" has to mean the words
    /// currently on screen, and an export of the text as it was two keystrokes ago is worse than
    /// no export, because it looks like it worked.</para>
    ///
    /// <para>Free and deterministic — docx, epub, pdf, no LLM call. See
    /// <see cref="WriterService.ExportBookAsync"/> for why this is not the full export bundle.</para>
    /// </summary>
    private async Task ExportAsync()
    {
        if (book is null || exporting) return;

        if (Dirty)
        {
            await SaveAsync(finishing: false);
            // A markup problem already blocked the save and is on screen; exporting stale text now
            // would quietly contradict that banner.
            if (problems.Count > 0) return;
        }

        exporting = true;
        exportNote = null;
        exportDir = null;
        activity = "Exporting…";
        StateHasChanged();

        try
        {
            var result = await Writer.ExportBookAsync(book.Id);
            exportDir = result.Directory;
            exportNote = $"Exported {string.Join(", ", result.Files)} to {result.Directory} " +
                         $"in {result.Elapsed.TotalSeconds:0.0}s.";
        }
        catch (Exception ex)
        {
            // Export reaches QuestPDF, OpenXML and the file system; a locked output file (the
            // author has the docx open) is the everyday failure and must not kill the circuit.
            exportNote = $"Export failed: {ex.Message}";
        }
        finally
        {
            exporting = false;
            activity = "Idle";
        }
    }

    /// <summary>Open the publish folder in Explorer. Same reasoning as the entity-chip click: the
    /// Hub is on the author's own machine, and a WebView2 host may swallow anything else.</summary>
    private async Task OpenExportFolderAsync()
    {
        if (exportDir is null) return;
        try
        {
            System.Diagnostics.Process.Start(new System.Diagnostics.ProcessStartInfo(exportDir)
            {
                UseShellExecute = true,
            });
        }
        catch (Exception ex)
        {
            exportNote = $"Could not open {exportDir}: {ex.Message}";
        }
        await Task.CompletedTask;
    }

    /// <summary>What the background sweep is doing, in the status bar. Null when nothing is.</summary>
    private string? sweepNote;

    /// <summary>
    /// Run the logic sweep over everything the finished edit could have broken.
    ///
    /// <para>Still not awaited — six logic rules over a blast radius take minutes and the author
    /// has already moved on — but no longer silent. It used to start, spend real money for
    /// minutes, and finish or fail with no indication of any of it, which is not something an
    /// author can reason about and is the first thing they turn off when they notice.</para>
    /// </summary>
    private void RunDeferredAnalysis()
    {
        if (book is null || !analysisPending) return;

        // Ids captured now because the fields will have changed by the time this finishes.
        var (bookId, finished) = (book.Id, beatId);
        analysisPending = false;
        sweepNote = "Checking what that edit could have broken…";

        _ = Task.Run(async () =>
        {
            try
            {
                var report = await Writer.RunDeferredAnalysisAsync(bookId, finished);
                sweepNote = Describe(report);
            }
            catch (Exception ex)
            {
                sweepNote = $"The consistency check failed: {ex.Message}";
            }

            // InvokeAsync: this is a thread-pool continuation, and touching the render tree from
            // one without marshalling is how a Blazor circuit dies with no message.
            await InvokeAsync(StateHasChanged);
        });
    }

    private static string Describe(WriterService.SweepReport r)
    {
        if (r.Error is not null) return $"The consistency check failed: {r.Error}";
        if (!r.Ran) return "Nothing downstream of that edit needed checking.";

        var cost = r.Cost > 0 ? $" · {r.Cost:C4}" : "";
        var took = $" · {r.Elapsed.TotalSeconds:0}s";
        return r.Findings == 0
            ? $"Checked {r.BeatsChecked} beats — nothing found{took}{cost}."
            : $"Checked {r.BeatsChecked} beats — {r.Findings} finding" +
              $"{(r.Findings == 1 ? "" : "s")} recorded{took}{cost}.";
    }

    // ── Toolbar ────────────────────────────────────────────────────────────

    private Task FormatAsync(string command)
        => editor is null ? Task.CompletedTask : editor.FormatAsync(command);

    private Task InsertEmDashAsync()
        => editor is null ? Task.CompletedTask : editor.InsertEmDashAsync();

    /// <summary>
    /// Speak the selected passage — or the whole beat when nothing is selected, since "read it
    /// back to me" almost always means the beat when the caret is just sitting in it.
    /// </summary>
    private async Task ReadAloudAsync()
    {
        if (editor is null || beat is null) return;

        var sel = await editor.GetSelectionAsync();
        var text = sel is { Ok: true } && !string.IsNullOrWhiteSpace(sel.Text) ? sel.Text : draft;
        if (string.IsNullOrWhiteSpace(text)) return;

        activity = "Speaking…";
        try
        {
            var audio = await ReadAloud.SpeakAsync(text);
            speaking = true;
            await JsVoidAsync("proseSpeech.play", audio.Base64, audio.MimeType);
            activity = audio.Free ? "Idle" : $"Read aloud in the book voice ({audio.Engine}) — this one cost characters.";
        }
        catch (Exception ex)
        {
            // Reaching a voice is an everyday failure (no engine installed, no key, ffmpeg gone).
            // It must not take the circuit down, and the message has to say what to install.
            speaking = false;
            tagNote = ex.Message;
            activity = "Idle";
        }
    }

    private async Task StopReadingAsync()
    {
        speaking = false;
        await JsVoidAsync("proseSpeech.stop");
    }

    // ── Context menu ───────────────────────────────────────────────────────

    private IReadOnlyList<ContextMenu.Item> contextItems = [];
    private (int X, int Y) contextAt;

    /// <summary>
    /// Build the menu for what was actually right-clicked.
    ///
    /// <para>The items are closures over <paramref name="target"/>, so each one acts on the span
    /// the author clicked rather than on whatever the selection has become by the time they pick.
    /// Opening the menu moves focus, which is enough to lose a selection.</para>
    /// </summary>
    private Task OnContextMenuAsync(ProseEditor.ContextTarget target)
    {
        contextAt = (target.X, target.Y);

        var items = new List<ContextMenu.Item>();

        if (target.HasSelection)
        {
            items.Add(new ContextMenu.Item(
                "Talk about this", () => TalkAboutAsync(target),
                Hint: "asks, or proposes a change"));
            items.Add(new ContextMenu.Item(
                "Read aloud", () => ReadTextAsync(target.SelectedText!)));
        }

        if (target.OnEntity)
        {
            if (items.Count > 0) items.Add(ContextMenu.Item.Separator());
            items.Add(new ContextMenu.Item(
                $"Edit link — {Shorten(target.EntityText, 28)}…",
                () => EditEntityAsync(target)));
            items.Add(new ContextMenu.Item("Remove link", RemoveEntityAsync));
            items.Add(new ContextMenu.Item(
                "Open in the wiki", () => OpenEntityAsync(target),
                Hint: "also: click the chip"));
        }
        else if (target.HasSelection)
        {
            items.Add(new ContextMenu.Item(
                "Link to an entity…", AddEntityAsync,
                Disabled: mode != EditorMode.Display,
                Hint: mode == EditorMode.Display ? null : "Display mode only"));
        }

        if (items.Count > 0) items.Add(ContextMenu.Item.Separator());
        items.Add(new ContextMenu.Item(
            "Read the whole beat aloud", () => ReadTextAsync(draft),
            Disabled: string.IsNullOrWhiteSpace(draft)));

        // Structure. Ordered by what a drafting novelist actually reaches for: "this is two
        // beats" is the commonest real act, and delete is last because it is the only one that
        // destroys something.
        items.Add(ContextMenu.Item.Separator());
        items.Add(new ContextMenu.Item(
            "Split the beat here", SplitAtCaretAsync,
            Disabled: beat is null || mode != EditorMode.Display,
            Hint: mode == EditorMode.Display ? "at the caret" : "Display mode only"));
        items.Add(new ContextMenu.Item(
            "Insert a beat after this one", InsertBeatAsync, Disabled: beat is null));
        items.Add(new ContextMenu.Item(
            "Merge into the beat before", JoinPreviousAsync,
            Disabled: beat is null || IsFirstBeat));
        items.Add(new ContextMenu.Item(
            "Delete this beat…", BeginDeleteAsync, Disabled: beat is null));

        contextItems = items;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task TalkAboutAsync(ProseEditor.ContextTarget target)
    {
        if (target.Span is { } span) OnDiscussRequested(span);
        return Task.CompletedTask;
    }

    private Task EditEntityAsync(ProseEditor.ContextTarget target)
        => OnEntityChipContextMenu(
            new ProseEditor.EntityChip(target.EntityGuid!, target.EntityRepo ?? "", target.EntityText ?? ""));

    private Task OpenEntityAsync(ProseEditor.ContextTarget target)
        => OnEntityChipClick(
            new ProseEditor.EntityChip(target.EntityGuid!, target.EntityRepo ?? "", ""));

    /// <summary>Speak an explicit passage — the menu already knows what was selected, so unlike
    /// the toolbar button this never has to ask the editor again.</summary>
    private async Task ReadTextAsync(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return;

        activity = "Speaking…";
        try
        {
            var audio = await ReadAloud.SpeakAsync(text);
            speaking = true;
            await JsVoidAsync("proseSpeech.play", audio.Base64, audio.MimeType);
            activity = audio.Free ? "Idle" : $"Read aloud in the book voice ({audio.Engine}) — this one cost characters.";
        }
        catch (Exception ex)
        {
            speaking = false;
            tagNote = ex.Message;
            activity = "Idle";
        }
    }

    private static string Shorten(string? s, int max)
    {
        s = (s ?? "").Replace('\n', ' ').Trim();
        return s.Length <= max ? s : s[..max] + "…";
    }

    // ── Structure ──────────────────────────────────────────────────────────

    private bool IsFirstBeat => spine is { Count: > 0 } && spine[0].BeatId == beatId;

    /// <summary>
    /// Split at the caret.
    ///
    /// <para>The caret arrives in reader-visible coordinates and is mapped to a stored offset
    /// here. Handing the raw plain offset to the workbench would cut inside an entity tag on any
    /// beat with a link before the caret — which is most of them.</para>
    /// </summary>
    private async Task SplitAtCaretAsync()
    {
        if (book is null || beat is null || editor is null) return;

        // Unsaved text first: the split is a database operation on the STORED beat, and splitting
        // stored text the author has already edited past would silently discard the edit.
        if (Dirty)
        {
            await SaveAsync(finishing: false);
            if (problems.Count > 0 || conflict is not null) return;
        }

        var caret = await editor.GetCaretOffsetAsync();
        if (caret <= 0)
        {
            tagNote = "Put the caret where the split should go first.";
            return;
        }

        var stored = beat.Text ?? "";
        var map = Prose.Core.Services.Discussion.PlainTextMap.Build(stored);
        if (caret >= map.Plain.Length)
        {
            tagNote = "The caret is at the end of the beat — there would be nothing to split off.";
            return;
        }

        var at = map.ToSource(caret);
        await StructuralAsync(
            () => Writer.SplitBeatAsync(book.Id, beat.ChapterNodeId, beat.Id, at),
            "Split.");
    }

    private Task InsertBeatAsync()
    {
        if (book is null || beat is null) return Task.CompletedTask;
        return StructuralAsync(async () =>
        {
            var created = await Writer.InsertBeatAsync(book.Id, beat.ChapterNodeId, beat.Id);
            return created.Id;   // open the new beat — inserting one means writing in it
        }, "Beat inserted.");
    }

    private Task JoinPreviousAsync()
    {
        if (book is null || beat is null) return Task.CompletedTask;
        var target = beat;
        return StructuralAsync(async () =>
        {
            await Writer.JoinWithPreviousAsync(book.Id, target.ChapterNodeId, target.Id);
            // The merged text lives in the PREVIOUS beat now, which is where the author is
            // looking — landing them on a deleted beat would show an empty editor.
            var index = spine?.FindIndex(s => s.BeatId == target.Id) ?? -1;
            return index > 0 ? spine![index - 1].BeatId : Guid.Empty;
        }, "Merged into the beat before.");
    }

    /// <summary>
    /// Ask before deleting, by SHOWING the prose that would go.
    ///
    /// <para>A confirmation that does not show what is about to be lost is a confirmation nobody
    /// reads. This one puts the beat's own first lines in the dialog.</para>
    /// </summary>
    private Task BeginDeleteAsync()
    {
        if (beat is null) return Task.CompletedTask;
        pendingDelete = beat;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private WriterService.OpenBeat? pendingDelete;

    private Task ConfirmDeleteAsync()
    {
        if (book is null || pendingDelete is null) return Task.CompletedTask;

        var doomed = pendingDelete;
        pendingDelete = null;
        return StructuralAsync(async () =>
        {
            var index = spine?.FindIndex(s => s.BeatId == doomed.Id) ?? -1;
            await Writer.DeleteBeatAsync(book.Id, doomed.ChapterNodeId, doomed.Id);

            // Land on a neighbour rather than on nothing.
            if (spine is null || spine.Count <= 1) return Guid.Empty;
            return index > 0 ? spine[index - 1].BeatId : spine[1].BeatId;
        }, "Beat deleted.");
    }

    /// <summary>
    /// The shape every structural act shares: do it, reload the spine because the beat list has
    /// changed underneath the author, and open wherever the act says they should now be.
    /// </summary>
    private Task StructuralAsync(Func<Task<Prose.Core.Data.Entities.Beat>> act, string note)
        => StructuralAsync(async () => (await act()).Id, note);

    private async Task StructuralAsync(Func<Task<Guid>> act, string note)
    {
        if (book is null) return;

        activity = "Restructuring…";
        try
        {
            var land = await act();

            // The spine is the beat list AND the ordering; a structural act invalidates both, and
            // a stale list is one where clicking row nine opens row ten.
            spine = await Writer.GetSpineAsync(book.Id);

            ClearBeatState();
            if (land != Guid.Empty) { beatId = land; beat = await Writer.GetBeatAsync(land); }
            else { beat = spine.Count > 0 ? await Writer.GetBeatAsync(spine[0].BeatId) : null; beatId = beat?.Id ?? Guid.Empty; }
            draft = beat?.Text ?? "";

            tagNote = note;
        }
        catch (Exception ex)
        {
            // Structural operations touch several rows. Failing loudly and leaving the author on
            // the beat they started from is the only safe outcome.
            tagNote = $"That could not be done: {ex.Message}";
        }
        finally { activity = "Idle"; }
    }

    private async Task AddEntityAsync()
    {
        if (editor is null) return;

        if (mode != EditorMode.Display)
        {
            tagNote = "Switch to Display mode to link an entity — Markdown mode edits the raw tags directly.";
            return;
        }

        var sel = await editor.GetSelectionAsync();
        if (sel is null || !sel.Ok || string.IsNullOrWhiteSpace(sel.Text))
        {
            tagNote = "Select the words you want to link first.";
            return;
        }

        entityModal = new EntityLinkModal.State { IsNew = true, Text = sel.Text.Trim() };
        entitySearch = sel.Text.Trim();
        await SearchEntitiesAsync();
    }

    // ── Entity modal ───────────────────────────────────────────────────────

    private async Task SearchEntitiesAsync()
    {
        if (book is null || string.IsNullOrWhiteSpace(entitySearch)) { matches = null; return; }
        searching = true;
        activity = "Searching entities…";
        StateHasChanged();
        try
        {
            matches = (await Writer.SearchEntitiesAsync(book.Id, entitySearch)).ToList();
        }
        finally
        {
            searching = false;
            activity = "Idle";
        }
    }

    private void ChooseEntity(Prose.Core.Services.EntityLookupMatch m)
    {
        if (entityModal is null) return;
        entityModal.Guid = m.Id.ToString();
        entityModal.Repo = m.EntityType;
    }

    private async Task ApplyEntityAsync()
    {
        if (entityModal is null || !entityModal.CanApply || editor is null) return;

        if (entityModal.IsNew)
            await editor.WrapSelectionAsync(entityModal.Guid, entityModal.Repo);
        else
            await editor.ApplyEntityAsync(entityModal.Guid, entityModal.Repo, entityModal.Text);

        CloseEntityModal();
    }

    private async Task RemoveEntityAsync()
    {
        if (editor is not null) await editor.RemoveEntityAsync();
        CloseEntityModal();
    }

    private void CloseEntityModal()
    {
        entityModal = null;
        matches = null;
        entitySearch = "";
    }

    private async Task JsVoidAsync(string identifier, params object?[] args)
    {
        try { await JS.InvokeVoidAsync(identifier, args); }
        catch (JSDisconnectedException) { connected = false; }
        catch (JSException ex) { jsError = ex.Message; }
    }

    private async Task ToggleThemeAsync()
    {
        theme = theme == "light" ? "dark" : "light";
        try { await JS.InvokeVoidAsync("proseWriter.setTheme", theme); }
        catch (JSDisconnectedException) { connected = false; }
        catch (JSException ex) { jsError = ex.Message; }
    }

    public async ValueTask DisposeAsync()
    {
        if (autosave is not null) await autosave.DisposeAsync();

        // The Ctrl+F listener lives on the document, so it outlives this component unless it is
        // taken down here.
        if (shellRef is not null)
        {
            await JsVoidAsync("proseHotkeys.unregisterShell");
            shellRef.Dispose();
            shellRef = null;
        }

        // Last chance to keep the open beat. Best-effort: circuit teardown is not guaranteed to
        // run to completion, which is why the periodic autosave above is the real guarantee and
        // this is only the tail of it.
        try
        {
            if (Dirty) await SaveAsync(finishing: true, quiet: true);
        }
        catch
        {
            // Nothing can be shown and nothing can be retried — the circuit is going away.
        }

        // Closing the book is the other "you are done with this beat" moment.
        RunDeferredAnalysis();
    }
}
