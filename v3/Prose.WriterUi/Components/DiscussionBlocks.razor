@using Markdig
@* Renders one turn's blocks.

   Assistant output is DATA here, never markup. Markdown goes through Markdig with HTML disabled,
   and every other block is a typed component — nothing the model produces is handed to
   MarkupString unexamined. Beat prose already round-trips HTML-escaped through ProseRenderer; a
   conversation about the prose holds the same line. *@

@foreach (var block in Blocks)
{
    switch (block)
    {
        case DiscussionBlock.Text t:
            <div class="d-md">@RenderMarkdown(t.Markdown)</div>
            break;

        case DiscussionBlock.Quote q:
            <button class="d-quote" @onclick="() => OnJumpToBeat.InvokeAsync(q.BeatId)"
                    title="Open this beat">
                <span class="d-quote-text">@q.Excerpt</span>
                @if (q.Label is not null)
                {
                    <span class="d-quote-where">@q.Label</span>
                }
            </button>
            break;

        case DiscussionBlock.Choice c:
            <div class="d-choice">
                <div class="d-choice-q">@c.Question</div>
                @foreach (var opt in c.Options)
                {
                    <button class="d-choice-opt" @onclick="() => OnChoose.InvokeAsync(opt.Label)">
                        <span class="d-choice-label">@opt.Label</span>
                        @if (opt.Detail is not null)
                        {
                            <span class="d-choice-detail">@opt.Detail</span>
                        }
                    </button>
                }
            </div>
            break;

        case DiscussionBlock.Confirm k:
            @* The safety mechanism for a spoken request, so it is rendered as a thing that must be
               answered, not a summary that can be skimmed past. Nothing acts until Confirm. *@
            <div class="d-confirm @(Actionable ? "" : "spent")">
                <div class="d-confirm-head">I heard</div>
                <div class="d-confirm-said">@k.Restatement</div>

                @if (k.Steps.Count > 0)
                {
                    <ol class="d-confirm-steps">
                        @foreach (var step in k.Steps)
                        {
                            <li>@step</li>
                        }
                    </ol>
                }

                @if (k.Caution is not null)
                {
                    <div class="d-confirm-caution"><strong>Worth knowing:</strong> @k.Caution</div>
                }

                @if (Actionable)
                {
                    <div class="d-confirm-actions">
                        <button class="primary" @onclick="() => OnConfirm.InvokeAsync(k)">Confirm</button>
                        <button class="mini" @onclick="() => OnAdjust.InvokeAsync(k)">Adjust</button>
                        <button class="mini" @onclick="() => OnCancel.InvokeAsync(k)">Cancel</button>
                    </div>
                }
                else
                {
                    @* An old confirmation keeps its text — it is the record of what was agreed —
                       but never its buttons. A stale Confirm that still looks pressable is an
                       invitation to approve something twice. *@
                    <div class="d-confirm-spent muted">Answered above.</div>
                }
            </div>
            break;

        case DiscussionBlock.Table t2:
            <figure class="d-table-wrap">
                @if (t2.Caption is { Length: > 0 })
                {
                    <figcaption class="d-table-caption">@t2.Caption</figcaption>
                }
                <table class="d-table">
                    <thead>
                        <tr>
                            @foreach (var col in t2.Columns)
                            {
                                <th scope="col">@col</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in t2.Rows)
                        {
                            <tr>
                                @for (var c = 0; c < t2.Columns.Count; c++)
                                {
                                    @* Padded rather than indexed blindly: a short row from a model
                                       must not take the panel down mid-render. *@
                                    <td>@(c < row.Count ? row[c] : "")</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </figure>
            break;

        case DiscussionBlock.Chart c3:
            @* Inline SVG, drawn here from the numbers. No charting library: this UI runs inside a
               desktop window that may have no network at all, and a chart that silently fails to
               draw is worse than the table it replaced. *@
            <figure class="d-chart">
                <figcaption class="d-chart-title">@c3.Title</figcaption>
                <svg viewBox="@($"0 0 100 {ChartHeight(c3)}")" role="img"
                     aria-label="@ChartDescription(c3)" class="d-chart-svg"
                     preserveAspectRatio="none">
                    @{ var max = c3.Bars.Count == 0 ? 1 : Math.Max(1, c3.Bars.Max(b => b.Value)); }
                    @for (var i = 0; i < c3.Bars.Count; i++)
                    {
                        var bar = c3.Bars[i];
                        var width = Math.Max(0.5, 100 * Math.Max(0, bar.Value) / max);
                        <rect x="0" y="@(i * 14 + 2)" width="@width.ToString("0.##", Invariant)"
                              height="8" rx="1" class="d-chart-bar"></rect>
                    }
                </svg>
                @* The numbers in text beside the picture, always. An SVG alone is unreadable to a
                   screen reader whatever its aria-label says, and these are counts, not trends. *@
                <ul class="d-chart-legend">
                    @foreach (var bar in c3.Bars)
                    {
                        <li><span class="d-chart-label">@bar.Label</span>
                            <span class="d-chart-value">@bar.Value.ToString("0.##")@c3.Unit</span></li>
                    }
                </ul>
            </figure>
            break;

        case DiscussionBlock.Proposal p:
            @* The only thing in the Writer that can change prose, so it shows the exact words
               that would be written and nothing acts until Approve. *@
            <div class="d-proposal">
                <div class="d-proposal-head">Proposed replacement</div>
                <pre class="d-proposal-text">@ProposalText(p.ProposalId)</pre>

                @if (ProposalStatus(p.ProposalId) is { } status && status != "proposed")
                {
                    <div class="d-proposal-done muted">@StatusLine(status)</div>
                }
                else if (Actionable)
                {
                    <div class="d-proposal-actions">
                        <button class="primary" @onclick="() => OnApprove.InvokeAsync(p.ProposalId)">
                            Approve and write
                        </button>
                        <button class="mini" @onclick="() => OnReject.InvokeAsync(p.ProposalId)">
                            Reject
                        </button>
                    </div>
                    <div class="muted d-proposal-note">
                        Only the quoted passage is written. Everything else in the beat must come
                        back byte-identical or the write is refused.
                    </div>
                }
            </div>
            break;
    }
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<DiscussionBlock> Blocks { get; set; } = [];
    [Parameter] public EventCallback<Guid> OnJumpToBeat { get; set; }
    [Parameter] public EventCallback<string> OnChoose { get; set; }

    /// <summary>True only for the last turn in the thread. A confirmation earlier in the
    /// conversation has already been answered, and re-offering its buttons would let the author
    /// approve the same request a second time, out of order.</summary>
    [Parameter] public bool Actionable { get; set; }

    [Parameter] public EventCallback<DiscussionBlock.Confirm> OnConfirm { get; set; }
    [Parameter] public EventCallback<DiscussionBlock.Confirm> OnAdjust { get; set; }
    [Parameter] public EventCallback<DiscussionBlock.Confirm> OnCancel { get; set; }

    /// <summary>Proposals the panel has already loaded, by id. Passed in rather than fetched here
    /// so one render of a thread is one query, not one per block.</summary>
    [Parameter] public IReadOnlyDictionary<Guid, DiscussionUiService.ProposalRow> Proposals { get; set; }
        = new Dictionary<Guid, DiscussionUiService.ProposalRow>();

    [Parameter] public EventCallback<Guid> OnApprove { get; set; }
    [Parameter] public EventCallback<Guid> OnReject { get; set; }

    private string ProposalText(Guid id)
        => Proposals.TryGetValue(id, out var p)
            ? p.Replacement
            : "(this proposal could not be loaded)";

    private string? ProposalStatus(Guid id)
        => Proposals.TryGetValue(id, out var p) ? p.Status : null;

    private static string StatusLine(string status) => status switch
    {
        "applied" => "Written to the beat.",
        "rejected" => "Rejected. Nothing was written.",
        // A refusal is not a rejection: the author said yes and the guard said the beat had moved.
        "refused" => "Could not be applied — the passage had changed. Nothing was written.",
        _ => status,
    };

    private static readonly System.Globalization.CultureInfo Invariant =
        System.Globalization.CultureInfo.InvariantCulture;

    private static int ChartHeight(DiscussionBlock.Chart c) => Math.Max(14, c.Bars.Count * 14 + 4);

    /// <summary>What the picture says, for anyone not looking at it. Not "bar chart" — the values,
    /// because they are the content and the shape is only how they are arranged.</summary>
    private static string ChartDescription(DiscussionBlock.Chart c)
        => $"{c.Title}: " + string.Join(", ",
            c.Bars.Select(b => $"{b.Label} {b.Value.ToString("0.##", Invariant)}{c.Unit}"));

    private static readonly Markdig.MarkdownPipeline Pipeline =
        new Markdig.MarkdownPipelineBuilder()
            .UseAdvancedExtensions()    // matches MarkdownService, the only other renderer here
            .Build();

    /// <summary>
    /// Render an assistant turn's markdown, with any HTML in it neutralised first.
    ///
    /// <para>The angle brackets are escaped in the SOURCE rather than disabled in the pipeline:
    /// this Markdig (1.1.2) predates <c>DisableHtml()</c>, and escaping is version-proof besides.
    /// Markdown's own syntax is punctuation Markdig still sees — <c>*</c>, <c>_</c>, <c>#</c>,
    /// backticks — so emphasis, lists and code spans all survive; only raw markup dies, which is
    /// the entire point.</para>
    ///
    /// <para>This matters more here than it looks. Beat prose carries real
    /// <c>&lt;entity guid="…"&gt;</c> markup, so a turn quoting a beat back to the author would
    /// otherwise inject live tags into the panel.</para>
    /// </summary>
    private MarkupString RenderMarkdown(string? markdown)
    {
        var safe = (markdown ?? "")
            .Replace("&", "&amp;")
            .Replace("<", "&lt;")
            .Replace(">", "&gt;");
        return (MarkupString)Markdig.Markdown.ToHtml(safe, Pipeline);
    }
}
