@* The render mode is set by the host page, not here — same contract as WriterShell. *@
@using Prose.WriterUi.Services
@inject SpineService Spine
@inject WriterService Writer
@implements IDisposable

<div class="spine">

    <header class="menubar">
        <div class="menu">
            <button class="menu-title" @onclick="() => bookMenuOpen = !bookMenuOpen">Book</button>
            @if (bookMenuOpen)
            {
                <div class="menu-drop" role="menu">
                    @if (books is null)
                    {
                        <div class="menu-note">Loading…</div>
                    }
                    else
                    {
                        @foreach (var b in books)
                        {
                            <button role="menuitem" @onclick="() => OpenBookAsync(b)">
                                @b.Title <span class="muted">@b.NodeCode</span>
                            </button>
                        }
                    }
                </div>
            }
        </div>

        @if (book is not null)
        {
            <span class="book-title">@book.Title</span>
            <span class="muted">@ChapterCount ch · @BeatCount beats · @LedgerTotal ledger rows</span>
        }

        <div class="spacer"></div>

        <input class="filter" type="search" placeholder="Filter the spine…"
               value="@filter" @oninput="OnFilterInput" />

        <span class="status @(statusIsError ? "err" : "")">@status</span>
    </header>

    @if (book is null)
    {
        <div class="empty">Open a book to read its order of events.</div>
    }
    else
    {
        <div class="panes">

            <section class="outline" aria-label="Outline">
                <div class="pane-head">
                    <h2>Outline</h2>
                    <span class="muted">@OutlineStamp</span>
                    <div class="spacer"></div>
                    <button class="primary" disabled="@(!outlineDirty || busy)" @onclick="SaveOutlineAsync">
                        @(busy ? "Saving…" : outlineDirty ? "Save outline" : "Saved")
                    </button>
                </div>
                <textarea class="outline-text" spellcheck="false"
                          value="@outlineText" @oninput="OnOutlineInput"
                          placeholder="No outline yet. This book's order of events has never been written down."></textarea>
            </section>

            <section class="spinelist" aria-label="Order of events">
                <div class="pane-head">
                    <h2>Order of events</h2>
                    <span class="muted">@VisibleBeatCount shown</span>
                </div>

                <div class="rows">
                    @if (rows is null)
                    {
                        <div class="empty">Loading…</div>
                    }
                    else
                    {
                        @foreach (var r in Visible())
                        {
                            @if (r.BeatId is null)
                            {
                                <div class="chapter">@r.ChapterTitle</div>
                            }
                            else
                            {
                                var id = r.BeatId.Value;
                                <div class="row @(expanded == id ? "open" : "")">
                                    <button class="rowhead" @onclick="() => ToggleAsync(id)">
                                        <span class="ord">@r.Ordinal.ToString("D4")</span>
                                        <span class="summary @(r.SummaryState == "stale" ? "stale" : "")">
                                            @(string.IsNullOrWhiteSpace(r.EventSummary)
                                                ? "(no event summary)"
                                                : r.EventSummary)
                                        </span>
                                        <span class="chars">@r.Chars.ToString("N0")</span>
                                        <span class="badge @(r.LedgerCount == 0 ? "zero" : "")">@r.LedgerCount</span>
                                    </button>

                                    @if (expanded == id)
                                    {
                                        <div class="ledger">
                                            @if (ledger is null)
                                            {
                                                <div class="empty small">Loading ledger…</div>
                                            }
                                            else if (ledger.Count == 0)
                                            {
                                                <div class="empty small">This beat declares no state changes.</div>
                                            }
                                            else
                                            {
                                                <table>
                                                    <thead>
                                                        <tr>
                                                            <th>Entity</th><th>Aspect</th><th>Verb</th>
                                                            <th>From</th><th>To</th><th>Story time</th>
                                                            <th>Source</th><th></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var e in ledger)
                                                        {
                                                            var draft = Draft(e);
                                                            <tr>
                                                                <td class="ent" title="@e.EntityType">@e.EntityName</td>
                                                                <td><input value="@draft.AspectKey" @oninput="ev => SetAspect(draft, ev)" /></td>
                                                                <td><input class="narrow" value="@draft.Verb" @oninput="ev => SetVerb(draft, ev)" /></td>
                                                                <td><input value="@draft.OldValue" @oninput="ev => SetOld(draft, ev)" /></td>
                                                                <td><input value="@draft.NewValue" @oninput="ev => SetNew(draft, ev)" /></td>
                                                                <td><input class="when" value="@FormatWhen(draft)" @oninput="ev => SetWhen(draft, ev)" /></td>
                                                                <td class="src">@e.Source</td>
                                                                <td class="acts">
                                                                    <button class="primary" disabled="@busy" @onclick="() => SaveLedgerAsync(e.Id, draft)">Save</button>
                                                                    <button class="danger" disabled="@busy" @onclick="() => DeleteLedgerAsync(e.Id)">Delete</button>
                                                                </td>
                                                            </tr>
                                                            @if (!string.IsNullOrWhiteSpace(e.Snippet))
                                                            {
                                                                <tr class="snip"><td colspan="8">@e.Snippet</td></tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }
                </div>
            </section>
        </div>
    }
</div>

@code {
    private List<WriterService.BookListItem>? books;
    private WriterService.BookListItem? book;
    private bool bookMenuOpen;

    private SpineService.Outline? outline;
    private string outlineText = "";
    private bool outlineDirty;

    private List<SpineService.SpineRow>? rows;
    private Guid? expanded;
    private List<SpineService.LedgerRow>? ledger;
    private readonly Dictionary<long, LedgerDraft> drafts = [];

    private string filter = "";
    private string status = "";
    private bool statusIsError;
    private bool busy;

    private CancellationTokenSource cts = new();

    /// <summary>Mutable copy of a ledger row while the author is typing in it. Kept per-row id so
    /// re-rendering the table (which happens on every keystroke) does not discard edits.</summary>
    private sealed class LedgerDraft
    {
        public string AspectKey { get; set; } = "";
        public string Verb { get; set; } = "";
        public string? OldValue { get; set; }
        public string? NewValue { get; set; }
        public DateTime AtStoryTime { get; set; }
    }

    private string OutlineStamp => outline?.GeneratedAt is { } g
        ? $"saved {g.ToLocalTime():yyyy-MM-dd HH:mm}"
        : "never saved";

    private int ChapterCount => rows?.Count(r => r.BeatId is null) ?? 0;
    private int BeatCount => rows?.Count(r => r.BeatId is not null) ?? 0;
    private int LedgerTotal => rows?.Where(r => r.BeatId is not null).Sum(r => r.LedgerCount) ?? 0;
    private int VisibleBeatCount => Visible().Count(r => r.BeatId is not null);

    protected override async Task OnInitializedAsync()
        => books = await Writer.ListBooksAsync(cts.Token);

    private async Task OpenBookAsync(WriterService.BookListItem b)
    {
        bookMenuOpen = false;
        book = b;
        expanded = null;
        ledger = null;
        drafts.Clear();
        status = "";
        statusIsError = false;

        outline = await Spine.GetOutlineAsync(b.Id, cts.Token);
        outlineText = outline.Text;
        outlineDirty = false;

        rows = await Spine.GetSpineAsync(b.Id, cts.Token);
    }

    private void OnOutlineInput(ChangeEventArgs e)
    {
        outlineText = e.Value?.ToString() ?? "";
        outlineDirty = outlineText != (outline?.Text ?? "");
    }

    private void OnFilterInput(ChangeEventArgs e) => filter = e.Value?.ToString() ?? "";

    /// <summary>Filtering keeps a chapter header whenever any beat under it survives, so the list
    /// never shows orphan beats with no idea what chapter they are in.</summary>
    private IEnumerable<SpineService.SpineRow> Visible()
    {
        if (rows is null) yield break;
        if (string.IsNullOrWhiteSpace(filter)) { foreach (var r in rows) yield return r; yield break; }

        var needle = filter.Trim();
        SpineService.SpineRow? pendingChapter = null;
        foreach (var r in rows)
        {
            if (r.BeatId is null) { pendingChapter = r; continue; }

            var hit = (r.EventSummary ?? "").Contains(needle, StringComparison.OrdinalIgnoreCase)
                   || (r.BeatTitle ?? "").Contains(needle, StringComparison.OrdinalIgnoreCase)
                   || r.ChapterTitle.Contains(needle, StringComparison.OrdinalIgnoreCase);
            if (!hit) continue;

            if (pendingChapter is not null) { yield return pendingChapter; pendingChapter = null; }
            yield return r;
        }
    }

    private async Task ToggleAsync(Guid beatId)
    {
        if (expanded == beatId) { expanded = null; ledger = null; return; }
        expanded = beatId;
        ledger = null;
        drafts.Clear();
        ledger = await Spine.GetLedgerAsync(beatId, cts.Token);
    }

    private LedgerDraft Draft(SpineService.LedgerRow e)
    {
        if (drafts.TryGetValue(e.Id, out var d)) return d;
        d = new LedgerDraft
        {
            AspectKey = e.AspectKey,
            Verb = e.Verb,
            OldValue = e.OldValue,
            NewValue = e.NewValue,
            AtStoryTime = e.AtStoryTime,
        };
        drafts[e.Id] = d;
        return d;
    }

    // Razor attribute values are themselves double-quoted, so a lambda with a string literal in it
    // cannot be written inline. These exist for that reason and no other.
    private static string Text(ChangeEventArgs e) => e.Value?.ToString() ?? "";
    private static void SetAspect(LedgerDraft d, ChangeEventArgs e) => d.AspectKey = Text(e);
    private static void SetVerb(LedgerDraft d, ChangeEventArgs e) => d.Verb = Text(e);
    private static void SetOld(LedgerDraft d, ChangeEventArgs e) => d.OldValue = Text(e);
    private static void SetNew(LedgerDraft d, ChangeEventArgs e) => d.NewValue = Text(e);

    private static string FormatWhen(LedgerDraft d) => d.AtStoryTime.ToString("s");

    /// <summary>Story-time is the axis the whole ledger sorts on, so an unparseable edit is left
    /// alone rather than defaulted — silently rewriting it to "now" would reorder the book.</summary>
    private static void SetWhen(LedgerDraft d, ChangeEventArgs e)
    {
        if (DateTime.TryParse(Text(e), out var parsed)) d.AtStoryTime = parsed;
    }

    private async Task SaveOutlineAsync()
    {
        if (book is null) return;
        busy = true;
        try
        {
            outline = await Spine.SaveOutlineAsync(book.Id, outlineText, cts.Token);
            outlineText = outline.Text;
            outlineDirty = false;
            Say($"Outline saved — {outlineText.Length:N0} chars.");
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private async Task SaveLedgerAsync(long id, LedgerDraft d)
    {
        if (book is null || expanded is null) return;
        busy = true;
        try
        {
            await Spine.SaveLedgerRowAsync(id, d.AspectKey, d.Verb, d.OldValue, d.NewValue,
                                           d.AtStoryTime, cts.Token);
            drafts.Remove(id);
            ledger = await Spine.GetLedgerAsync(expanded.Value, cts.Token);
            Say("Ledger row saved.");
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private async Task DeleteLedgerAsync(long id)
    {
        if (book is null || expanded is null) return;
        busy = true;
        try
        {
            await Spine.DeleteLedgerRowAsync(id, cts.Token);
            drafts.Remove(id);
            ledger = await Spine.GetLedgerAsync(expanded.Value, cts.Token);
            rows = await Spine.GetSpineAsync(book.Id, cts.Token);
            Say("Ledger row deleted.");
        }
        catch (Exception ex) { Fail(ex); }
        finally { busy = false; }
    }

    private void Say(string msg) { status = msg; statusIsError = false; }
    private void Fail(Exception ex) { status = ex.Message; statusIsError = true; }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}
