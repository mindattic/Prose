@* No @page here. Prose.Hub maps Blazor with MapRazorComponents<App>() and App.razor carries no
   <Router>, so EVERY discovered page route renders App.razor — a second @page would be found,
   return 200, and serve the observability document. Program.cs gives this component its own
   endpoint instead. *@
@using Microsoft.AspNetCore.Components.Web
@using Prose.WriterUi.Components
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Prose Writer</title>
    @* Stamped before the stylesheets so a light-theme user never sees a frame of dark. *@
    <script>
        (function () {
            try {
                var t = localStorage.getItem('prose.writer.theme');
                document.documentElement.setAttribute('data-theme', t === 'light' ? 'light' : 'dark');
            } catch (e) { /* blocked site data — the dark default in the markup stands */ }
        })();
    </script>
    @* Cache-busted per deployed build. Without this the WebView2 profile (which deliberately
       survives a redeploy, so the author's session does) keeps serving the JS it cached the first
       time the window opened. That is not cosmetic: the editor is wired up through JS interop, so
       a stale writer.js means "proseEditor is undefined", which throws and takes the Blazor
       circuit down — the whole page stops responding. Found 2026-09-12. *@
    <link rel="stylesheet" href="_content/Prose.WriterUi/tokens.css?v=@AssetVersion" />
    <link rel="stylesheet" href="_content/Prose.WriterUi/writer.css?v=@AssetVersion" />
    @* After writer.css: the Discuss panel is a third column in the layout writer.css defines. *@
    <link rel="stylesheet" href="_content/Prose.WriterUi/discuss.css?v=@AssetVersion" />
    <script src="_content/Prose.WriterUi/js/theme.js?v=@AssetVersion"></script>
    <script src="_content/Prose.WriterUi/js/writer.js?v=@AssetVersion"></script>
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>
<body>
    <WriterShell @rendermode="RenderMode.InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    // Shared with /repo so the two root documents cannot drift — see HubAssets for why a stale
    // asset here is a frozen window, not a cosmetic problem.
    private static string AssetVersion => HubAssets.Version;
}
