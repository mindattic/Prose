@page "/books"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@using Prose.Core.Models
@using Prose.Core.Interfaces
@using Prose.Core.Services
@using Prose.Shared.Services
@inject IBookRepository BookRepo
@inject IChapterRepository ChapterRepo
@inject FindingsService Findings
@inject MotifService MotifSvc
@inject BookExportService ExportSvc
@inject ToastNotifier Toast
@inject NavigationManager Nav
@inject IWriteAccessProvider Access

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-danger mb-0"><i class="bi bi-book me-2"></i>Bookshelf</h4>
    <div class="d-flex gap-2 align-items-center">
        <a href="/series" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-collection"></i><div class="btn-lbl"> Series</div>
        </a>
        @if (books.Count > 0)
        {
            <button class="btn btn-sm btn-outline-info" @onclick="OpenBulk" title="Export every book in one go">
                <i class="bi bi-cloud-download"></i><div class="btn-lbl"> Export all</div>
            </button>
        }
        @if (Access.IsAdministrator)
        {
            <button class="btn btn-sm btn-outline-danger" @onclick="CreateNew">
                <i class="bi bi-plus-lg"></i><div class="btn-lbl"> New Book</div>
            </button>
        }
    </div>
</div>

@* ── Bulk Export Modal ─────────────────────────────────────────── *@
@if (bulkExportOpen)
{
    <div class="modal-backdrop fade show" style="z-index:1050;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index:1055;" @onclick="CloseBulk">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content bg-dark text-light border-info">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-info"><i class="bi bi-cloud-download me-2"></i>Export every book</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseBulk" disabled="@bulkBusy"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-3">
                        Builds one file per book in the chosen format, then drops them into
                        <code>engine/exports/all-@DateTime.Now.ToString("yyyy-MM-dd-HHmm")/</code>.
                        Books with no chapters yet are skipped.
                    </p>
                    @if (bulkBusy)
                    {
                        <div class="text-info"><span class="spinner-border spinner-border-sm me-2"></span>Building @bulkFormat.ToUpperInvariant() for @books.Count book(s)…</div>
                    }
                    else if (!string.IsNullOrEmpty(bulkResult))
                    {
                        <div class="alert alert-success small mb-0"><i class="bi bi-check-circle me-1"></i>@bulkResult</div>
                    }
                    else
                    {
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-outline-info" @onclick='() => RunBulk("pdf")'><i class="bi bi-filetype-pdf me-1"></i>PDF</button>
                            <button class="btn btn-outline-info" @onclick='() => RunBulk("md")'><i class="bi bi-markdown me-1"></i>Markdown</button>
                            <button class="btn btn-outline-info" @onclick='() => RunBulk("epub")'><i class="bi bi-book me-1"></i>EPUB</button>
                            <button class="btn btn-outline-info" @onclick='() => RunBulk("html")'><i class="bi bi-filetype-html me-1"></i>HTML</button>
                        </div>
                    }
                </div>
                <div class="modal-footer border-secondary">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseBulk" disabled="@bulkBusy">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@* â”€â”€ New Book Modal â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
@if (newBookOpen)
{
    <div class="modal-backdrop fade show" style="z-index:1050;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index:1055;" @onclick="CloseNewBook">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content bg-dark text-light border-danger">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-danger"><i class="bi bi-book-half me-2"></i>New Book</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseNewBook"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Title <span class="text-danger">*</span></label>
                        <input class="form-control bg-black text-light border-secondary" @bind="newTitle" placeholder="Half Rate" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Tagline</label>
                        <input class="form-control bg-black text-light border-secondary" @bind="newTagline" placeholder="Some debts can't be paid in QUANTA." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Premise</label>
                        <textarea class="form-control bg-black text-light border-secondary" rows="3"
                                  @bind="newPremise" placeholder="One paragraph: who, what they want, what stands in their way."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Arc target</label>
                        <input class="form-control bg-black text-light border-secondary" @bind="newArcTarget"
                               placeholder="Where does this book land â€” redemption refused, downfall, escape?" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Protagonist(s) â€” comma-separated</label>
                        <input class="form-control bg-black text-light border-secondary" @bind="newProtagonists"
                               placeholder="Kyle Ellen Corbin, Sasha Võ" />
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseNewBook">Cancel</button>
                    <button class="btn btn-danger btn-sm" @onclick="SaveNewBook"
                            disabled="@string.IsNullOrWhiteSpace(newTitle)">
                        <i class="bi bi-check-lg"></i> Create
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Edit Book Modal ──────────────────────────────── *@
@if (editBook != null)
{
    <div class="modal-backdrop fade show" style="z-index:1050;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index:1055;" @onclick="CloseEdit">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content bg-dark text-light border-info">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-info"><i class="bi bi-pencil me-2"></i>Edit Book</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseEdit"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Title <span class="text-danger">*</span></label>
                        <input class="form-control bg-black text-light border-secondary" @bind="editTitle" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Tagline</label>
                        <input class="form-control bg-black text-light border-secondary" @bind="editTagline" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Premise</label>
                        <textarea class="form-control bg-black text-light border-secondary" rows="3"
                                  @bind="editPremise"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Arc target</label>
                        <input class="form-control bg-black text-light border-secondary" @bind="editArcTarget" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Protagonist(s) — comma-separated</label>
                        <input class="form-control bg-black text-light border-secondary" @bind="editProtagonists" />
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseEdit">Cancel</button>
                    <button class="btn btn-info btn-sm" @onclick="SaveEditBook"
                            disabled="@string.IsNullOrWhiteSpace(editTitle)">
                        <i class="bi bi-check-lg"></i> Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* â”€â”€ Archive Book Modal â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
@if (archiveBook != null)
{
    <div class="modal-backdrop fade show" style="z-index:1050;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index:1055;" @onclick="CloseArchive">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content bg-dark text-light border-warning">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning"><i class="bi bi-archive me-2"></i>Archive Book</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseArchive"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        You are about to archive <strong class="text-danger">@archiveBook.Title</strong>.
                        The book file moves to <code>engine/data/archives/books/</code>; chapters stay in place.
                    </p>
                    <p class="small text-muted mb-2">
                        To confirm, paste this book's id below:
                    </p>
                    <div class="mb-2">
                        <code class="user-select-all small text-info">@archiveBook.Id</code>
                    </div>
                    <input class="form-control bg-black text-light border-secondary font-monospace small"
                           @bind="archiveConfirmId"
                           @bind:event="oninput"
                           placeholder="Paste the book id to enable archive" />
                    @if (!string.IsNullOrEmpty(archiveError))
                    {
                        <div class="text-danger small mt-2">@archiveError</div>
                    }
                </div>
                <div class="modal-footer border-secondary">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseArchive">Cancel</button>
                    <button class="btn btn-warning btn-sm" @onclick="ConfirmArchive"
                            disabled="@(!string.Equals(archiveConfirmId, archiveBook.Id, StringComparison.Ordinal))">
                        <i class="bi bi-archive"></i> Archive
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* â”€â”€ Bookshelf Grid â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
<div class="bookshelf-grid">
    @foreach (var book in books)
    {
        var chapterCount = book.ChapterIds.Count;
        var bookId = book.Id;
        <div class="book-card" data-book-id="@bookId" @onclick="@(() => Nav.NavigateTo($"/write/{bookId}"))">
            <div class="book-card-cover" style="@CoverStyle(book)">
                @if (string.IsNullOrEmpty(book.CoverImageUrl))
                {
                    <div class="book-card-cover-templated">
                        <div class="book-card-protag">@(book.Protagonists.FirstOrDefault() ?? "")</div>
                        <div class="book-card-title">@book.Title.ToUpperInvariant()</div>
                        @if (!string.IsNullOrEmpty(book.Tagline))
                        {
                            <div class="book-card-tagline">@book.Tagline</div>
                        }
                    </div>
                }
                @if (Access.IsAdministrator)
                {
                    <button type="button"
                            class="book-card-edit-btn"
                            title="Edit book metadata"
                            @onclick="@(() => OpenEdit(book))"
                            @onclick:stopPropagation="true">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button type="button"
                            class="book-card-archive-btn"
                            title="Archive this book"
                            @onclick="@(() => OpenArchive(book))"
                            @onclick:stopPropagation="true">
                        <i class="bi bi-archive"></i>
                    </button>
                }
            </div>
            <div class="book-card-meta">
                <span class="badge bg-secondary">@chapterCount @(chapterCount == 1 ? "chapter" : "chapters")</span>
                <span class="badge bg-dark text-muted">@book.Status</span>
                @if (bookStats.TryGetValue(bookId, out var s) && s.TotalBeats > 0)
                {
                    var pct = (int)Math.Round(100.0 * s.DoneBeats / s.TotalBeats);
                    var pctClass = pct >= 100 ? "bg-success"
                                 : pct >= 50  ? "bg-info text-dark"
                                 : "bg-warning text-dark";
                    <span class="badge @pctClass" title="Beats with prose / total beats">
                        @pct% (@s.DoneBeats/@s.TotalBeats beats)
                    </span>
                }
                @if (bookStats.TryGetValue(bookId, out var s2) && s2.DriftCount > 0)
                {
                    <span class="badge bg-warning text-dark" title="Open outline-drift findings">
                        <i class="bi bi-shield-exclamation me-1"></i>@s2.DriftCount drift
                    </span>
                }
                @if (bookStats.TryGetValue(bookId, out var s3) && s3.MotifCount > 0)
                {
                    <span class="badge bg-secondary" title="Registered motifs">
                        <i class="bi bi-tags me-1"></i>@s3.MotifCount
                    </span>
                }
            </div>
        </div>
    }

    @if (Access.IsAdministrator)
    {
        <div class="book-card book-card-new" @onclick="CreateNew">
            <div class="book-card-cover book-card-cover-new">
                <i class="bi bi-plus-lg"></i>
                <div class="small mt-2">New Book</div>
            </div>
        </div>
    }
</div>

@* â”€â”€ Loose Chapters â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ *@
@if (looseChapters.Any())
{
    <div class="mt-5">
        <h5 class="text-warning mb-2">
            <i class="bi bi-files me-2"></i>Loose Chapters
            <span class="text-muted small ms-2">â€” not yet assigned to a book</span>
        </h5>
        <div class="loose-chapters-strip">
            @foreach (var c in looseChapters)
            {
                <a class="loose-chapter-card" href="@($"/stories/write/{c.Id}")">
                    <div class="loose-chapter-title">@c.Title</div>
                    <div class="loose-chapter-meta">
                        @if (c.Characters.Any())
                        {
                            <span class="text-muted small">@string.Join(", ", c.Characters.Take(2))</span>
                        }
                        <span class="text-muted small ms-2">@c.Modified.ToString("yyyy-MM-dd")</span>
                    </div>
                </a>
            }
        </div>
    </div>
}

