@code {
    private List<Book> books = [];
    private List<Chapter> looseChapters = [];

    private bool newBookOpen;
    private string newTitle = "";
    private string newTagline = "";
    private string newPremise = "";
    private string newArcTarget = "";
    private string newProtagonists = "";

    private Book? archiveBook;
    private string archiveConfirmId = "";
    private string archiveError = "";

    // Bulk export modal state. ExportAll runs on Task.Run so the SignalR loop
    // stays responsive — PDF for a multi-book corpus can take many seconds.
    private bool bulkExportOpen;
    private bool bulkBusy;
    private string bulkFormat = "";
    private string bulkResult = "";

    // Edit-book modal state. The full Book is captured so save can write back
    // to the same record; field strings are bound to the inputs and folded
    // back on save.
    private Book? editBook;
    private string editTitle = "";
    private string editTagline = "";
    private string editPremise = "";
    private string editArcTarget = "";
    private string editProtagonists = "";

    protected override void OnInitialized()
    {
        Reload();
    }

    private void Reload()
    {
        books = BookRepo.ListBooks();

        var allChapters = ChapterRepo.ListChapters();

        // A chapter is "loose" if its BookId is null OR points to a book that no longer exists.
        var bookIds = books.Select(b => b.Id).ToHashSet();
        looseChapters = allChapters
            .Where(c => string.IsNullOrEmpty(c.BookId) || !bookIds.Contains(c.BookId))
            .ToList();

        // Per-book stats: beat completion %, drift findings count, motif count.
        // Single pass over chapters → group by BookId to keep cold-load
        // costs in check; ListChapters already deserializes every chapter.
        bookStats.Clear();
        var chaptersByBook = allChapters
            .Where(c => !string.IsNullOrEmpty(c.BookId) && bookIds.Contains(c.BookId!))
            .GroupBy(c => c.BookId!);
        foreach (var group in chaptersByBook)
        {
            var beats     = group.SelectMany(c => c.Beats ?? new List<ChapterBeat>()).ToList();
            var totalBeats = beats.Count;
            var doneBeats  = beats.Count(b => !string.IsNullOrWhiteSpace(b.Text));
            var driftCount = 0;
            try
            {
                foreach (var c in group)
                    driftCount += Findings.ListByChapter(c.Id)
                        .Count(f => f.Status == FindingStatus.New
                                 && (f.Category == FindingCategory.OutlineDrift
                                     || (f.Summary?.StartsWith("OUTLINE-DRIFT", StringComparison.OrdinalIgnoreCase) ?? false)));
            }
            catch { /* findings DB may not be ready on first run */ }
            int motifCount = 0;
            try { motifCount = MotifSvc.Load(group.Key).Motifs.Count; }
            catch { }
            bookStats[group.Key] = new BookStats(totalBeats, doneBeats, driftCount, motifCount);
        }
    }

    /// <summary>
    /// Per-book stats surfaced on each book card. Computed once on Reload from
    /// a single ListChapters pass plus per-chapter findings counts.
    /// </summary>
    private record BookStats(int TotalBeats, int DoneBeats, int DriftCount, int MotifCount);
    private Dictionary<string, BookStats> bookStats = new();

    private static string CoverStyle(Book book) =>
        string.IsNullOrEmpty(book.CoverImageUrl) ? "" : $"background-image: url('{book.CoverImageUrl}');";

    private void OpenBulk()
    {
        bulkExportOpen = true;
        bulkBusy = false;
        bulkFormat = "";
        bulkResult = "";
    }

    private void CloseBulk()
    {
        if (bulkBusy) return; // Don't let the modal close mid-build.
        bulkExportOpen = false;
    }

    private async Task RunBulk(string format)
    {
        if (bulkBusy) return;
        bulkFormat = format;
        bulkBusy = true;
        bulkResult = "";
        StateHasChanged();
        try
        {
            // PDF for the whole corpus is CPU-bound and can hold the SignalR
            // loop for tens of seconds — offload so the spinner stays alive.
            var result = await Task.Run(() => ExportSvc.ExportAll(format));
            bulkResult = $"Wrote {result.Files.Count} file(s) to {result.Directory}"
                       + (result.Skipped > 0 ? $" — {result.Skipped} book(s) skipped (no chapters)" : "");
            Toast.Success("EXPORT-ALL-OK", $"{format.ToUpperInvariant()}: {result.Files.Count} book(s) → {result.Directory}");
        }
        catch (Exception ex)
        {
            bulkResult = $"Failed: {ex.Message}";
            Toast.Error("EXPORT-ALL-FAIL", $"{format.ToUpperInvariant()} bulk export failed: {ex.Message}");
        }
        finally
        {
            bulkBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CreateNew()
    {
        if (!Access.IsAdministrator) return;
        newTitle = newTagline = newPremise = newArcTarget = newProtagonists = "";
        newBookOpen = true;
    }
    private void CloseNewBook() => newBookOpen = false;

    private void SaveNewBook()
    {
        if (!Access.IsAdministrator) return;
        if (string.IsNullOrWhiteSpace(newTitle)) return;
        var book = new Book
        {
            Title        = newTitle.Trim(),
            Tagline      = string.IsNullOrWhiteSpace(newTagline) ? null : newTagline.Trim(),
            Premise      = newPremise.Trim(),
            ArcTarget    = newArcTarget.Trim(),
            Protagonists = newProtagonists
                .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .ToList(),
            Status       = "drafting",
        };
        BookRepo.SaveBook(book);
        newBookOpen = false;
        // Land directly on the outline â€” that's where the work begins for a new book.
        Nav.NavigateTo($"/books/{book.Id}/outline");
    }

    private void OpenEdit(Book book)
    {
        if (!Access.IsAdministrator) return;
        editBook         = book;
        editTitle        = book.Title;
        editTagline      = book.Tagline ?? "";
        editPremise      = book.Premise ?? "";
        editArcTarget    = book.ArcTarget ?? "";
        editProtagonists = string.Join(", ", book.Protagonists ?? new List<string>());
    }

    private void CloseEdit() => editBook = null;

    private void SaveEditBook()
    {
        if (!Access.IsAdministrator || editBook == null) return;
        if (string.IsNullOrWhiteSpace(editTitle)) return;
        editBook.Title        = editTitle.Trim();
        editBook.Tagline      = string.IsNullOrWhiteSpace(editTagline) ? null : editTagline.Trim();
        editBook.Premise      = editPremise.Trim();
        editBook.ArcTarget    = editArcTarget.Trim();
        editBook.Protagonists = editProtagonists
            .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .ToList();
        BookRepo.SaveBook(editBook);
        editBook = null;
        Reload();
    }

    private void OpenArchive(Book book)
    {
        if (!Access.IsAdministrator) return;
        archiveBook = book;
        archiveConfirmId = "";
        archiveError = "";
    }

    private void CloseArchive()
    {
        archiveBook = null;
        archiveConfirmId = "";
        archiveError = "";
    }

    private void ConfirmArchive()
    {
        if (!Access.IsAdministrator) return;
        if (archiveBook == null) return;
        if (!string.Equals(archiveConfirmId, archiveBook.Id, StringComparison.Ordinal))
        {
            archiveError = "The id you entered doesn't match. Paste the full book id shown above.";
            return;
        }
        BookRepo.ArchiveBook(archiveBook.Id);
        archiveBook = null;
        archiveConfirmId = "";
        archiveError = "";
        Reload();
    }
}
