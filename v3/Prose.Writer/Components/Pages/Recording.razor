@page "/publish/{BookId}/audio"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@using Prose.Core.Models
@using Prose.Core.Interfaces
@using Prose.Core.Services
@using Prose.Shared.Services
@inject IBookRepository Books
@inject BookExportService ExportSvc
@inject ToastNotifier Toast
@inject NavigationManager Nav

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="small text-muted mb-1">
                <a href="@($"/publish/{BookId}")" class="text-muted text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Publish
                </a>
            </div>
            <h4 class="text-danger mb-0"><i class="bi bi-mic me-2"></i>Recording</h4>
            @if (book != null)
            {
                <div class="text-muted small">@book.Title</div>
            }
        </div>
    </div>

    @if (book == null)
    {
        <div class="alert alert-danger">Book not found. <a href="/books">Back to bookshelf</a></div>
    }
    else
    {
        <div class="alert alert-warning small">
            <i class="bi bi-exclamation-triangle me-1"></i>
            <strong>API cost:</strong> ElevenLabs charges per character. A 200,000-character book runs
            ~$30+ at standard tier. The export fails fast if no API key is configured.
        </div>

        <div class="card bg-dark border-secondary mb-3">
            <div class="card-body">
                <h5 class="text-info"><i class="bi bi-soundwave me-2"></i>Generate audiobook</h5>
                <p class="text-muted small">
                    Each chapter is split at paragraph boundaries into ≤3500-character chunks
                    (ElevenLabs' input cap), one MP3 per chunk in playback order. Files land in
                    <code>engine/exports/{slug}.{shortId}.audio/</code> as
                    <code>chapter-NNN-part-MMM.mp3</code>. Concatenate with ffmpeg / Audacity /
                    Calibre when you're ready to ship.
                </p>
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-info" @onclick="Generate" disabled="@working">
                        @if (working)
                        {
                            <span class="spinner-border spinner-border-sm me-1" />
                            <span>Generating… (this can take minutes)</span>
                        }
                        else
                        {
                            <i class="bi bi-mic-fill me-1"></i>
                            <span>Generate audiobook</span>
                        }
                    </button>
                    <span class="text-muted small">@bookSize</span>
                </div>
                @if (!string.IsNullOrEmpty(lastResult))
                {
                    <div class="alert alert-success mt-3 mb-0 small"><i class="bi bi-check-circle me-1"></i>@lastResult</div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string BookId { get; set; } = "";

    private Book? book;
    private bool working;
    private string lastResult = "";
    private string bookSize = "";

    protected override void OnInitialized()
    {
        try
        {
            book = Books.LoadBook(BookId);
            if (book != null)
            {
                bookSize = $"{book.ChapterIds.Count} chapter(s)";
            }
        }
        catch (Exception ex) { Toast.Error("RECORDING-LOAD", $"Couldn't load book: {ex.Message}"); }
    }

    private async Task Generate()
    {
        if (book == null || working) return;
        working = true;
        lastResult = "";
        StateHasChanged();
        try
        {
            var dir = await ExportSvc.ExportAudioAsync(book.Id);
            lastResult = $"Exported: {dir}";
            Toast.Success("RECORDING-OK", $"Audiobook built at {dir}");
        }
        catch (Exception ex)
        {
            Toast.Error("RECORDING-FAIL", $"Audiobook export failed: {ex.Message}");
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
