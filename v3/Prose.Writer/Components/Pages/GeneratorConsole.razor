@page "/generators"
@inject ScriptRunnerService Runner
@implements IDisposable

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-danger mb-0">Generator Console</h4>
    <div class="d-flex gap-2 align-items-center">
        @if (isRunning)
        {
            <button class="btn btn-sm btn-outline-danger" @onclick="KillRun">
                <i class="bi bi-stop-fill"></i> Kill
            </button>
        }
        else if (activeScript != null)
        {
            <button class="btn btn-sm btn-outline-warning" @onclick="RunActive">
                <i class="bi bi-play-fill"></i> Run
            </button>
        }
    </div>
</div>

<div class="row g-3">
    @* Left: category browser *@
    <div class="col-md-4 col-lg-3">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted">
                <i class="bi bi-folder2"></i> Generators
                <span class="badge bg-secondary ms-2">@generators.Count</span>
            </div>
            <div class="card-body p-0" style="max-height:600px;overflow-y:auto;">
                @foreach (var cat in CategoryStyles)
                {
                    var gens = generators.Where(g => g.Category == cat.Key).ToList();
                    if (gens.Count == 0) continue;
                    <div class="border-bottom border-secondary border-opacity-25">
                        <button class="btn btn-link text-start w-100 py-2 px-3 text-decoration-none"
                                style="color: @cat.Value.Color;"
                                @onclick="@(() => ToggleCat(cat.Key))">
                            <i class="bi @cat.Value.Icon me-1"></i>
                            <span class="small fw-semibold">@cat.Key</span>
                            <span class="badge bg-secondary ms-1" style="font-size:0.65rem;">@gens.Count</span>
                        </button>
                        @if (expandedCat == cat.Key)
                        {
                            @foreach (var gen in gens)
                            {
                                var active = activeScript?.Script.Name == gen.Script.Name;
                                <button class="btn btn-link text-start w-100 py-1 px-4 text-decoration-none small"
                                        style="color:@(active ? "#e6edf3" : "#8b949e"); background:@(active ? "#1c2128" : "transparent");"
                                        @onclick="@(() => SelectScript(gen))">
                                    @gen.Label
                                </button>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* Right: active script + terminal *@
    <div class="col-md-8 col-lg-9">
        @if (activeScript == null)
        {
            <div class="card bg-dark text-light border-secondary">
                <div class="card-body text-center py-5">
                    <i class="bi bi-terminal" style="font-size:3rem;color:#30363d;"></i>
                    <p class="mt-3 text-muted">Select a generator from the panel.</p>
                    <p class="small text-muted">Generators create entity JSON files in <code>engine/data/</code>. Runs are additive — existing files are not overwritten.</p>
                </div>
            </div>
        }
        else
        {
            <div class="card bg-dark text-light border-secondary mb-2">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="fw-semibold">@activeScript.Label</span>
                    <span class="small text-muted">@activeScript.Category — @activeScript.Script.Language</span>
                </div>
                <div class="card-body pb-2">
                    <p class="small text-muted mb-2">@activeScript.Script.Description</p>
                    @if (activeScript.Script.Args.Count > 0)
                    {
                        <div class="mb-2">
                            <div class="small text-muted mb-1">Available arguments:</div>
                            @foreach (var arg in activeScript.Script.Args)
                            {
                                <span class="badge bg-secondary me-1 mb-1" title="@arg.Desc"><code>@arg.Flag</code></span>
                            }
                        </div>
                    }
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-dark border-secondary text-muted">args</span>
                        <input type="text" class="form-control bg-dark text-light border-secondary"
                               placeholder="optional arguments…"
                               @bind="scriptArgs" disabled="@isRunning" />
                    </div>
                </div>
            </div>

            <div class="card bg-dark border-secondary">
                <div class="card-header text-muted d-flex justify-content-between align-items-center" style="font-size:0.8rem;">
                    <span><i class="bi bi-terminal-fill"></i> @activeScript.Script.RelativePath</span>
                    @if (isRunning)
                    {
                        <span class="spinner-border spinner-border-sm text-warning"></span>
                    }
                    else if (lastExitCode.HasValue)
                    {
                        <span class="badge @(lastExitCode == 0 ? "bg-success" : "bg-danger")">
                            exit @lastExitCode
                        </span>
                    }
                </div>
                <div class="p-2" style="background:#0d1117;max-height:460px;overflow-y:auto;font-family:monospace;font-size:0.78rem;">
                    @if (outputLines.Count == 0)
                    {
                        <span class="text-muted">$ node @activeScript.Script.RelativePath @scriptArgs</span>
                    }
                    else
                    {
                        @foreach (var line in outputLines)
                        {
                            <div style="color:@(line.IsError ? "#f85149" : "#8b949e");white-space:pre-wrap;">@line.Text</div>
                        }
                    }
                </div>
            </div>
        }
    </div>
</div>

@code {
    private record GenEntry(string Label, string Category, ScriptInfo Script);
    private record CatStyle(string Color, string Icon);

    private static readonly Dictionary<string, CatStyle> CategoryStyles = new()
    {
        ["Characters"]     = new("#d2a8ff", "bi-people-fill"),
        ["Organizations"]  = new("#79c0ff", "bi-building"),
        ["Gear & Weapons"] = new("#f85149", "bi-crosshair"),
        ["World & Places"] = new("#3fb950", "bi-globe2"),
        ["Culture"]        = new("#f0883e", "bi-palette2"),
        ["Science & Tech"] = new("#58a6ff", "bi-cpu"),
        ["Documents"]      = new("#e6edf3", "bi-file-earmark-text"),
        ["Other"]          = new("#8b949e", "bi-three-dots"),
    };

    private List<GenEntry> generators = [];
    private GenEntry? activeScript;
    private string expandedCat = "";
    private string scriptArgs = "";
    private List<ScriptOutputLine> outputLines = [];
    private int? lastExitCode;
    private bool isRunning;
    private CancellationTokenSource? cts;

    protected override void OnInitialized()
    {
        var all = Runner.GetAllScripts();
        generators = all
            .Where(s => s.Name.StartsWith("generate_", StringComparison.OrdinalIgnoreCase) && s.Language == "node")
            .Select(s => new GenEntry(FormatLabel(s.Name), Categorize(s.Name), s))
            .OrderBy(g => g.Category).ThenBy(g => g.Label)
            .ToList();

        if (CategoryStyles.Count > 0)
            expandedCat = CategoryStyles.Keys.First(k => generators.Any(g => g.Category == k));
    }

    private void SelectScript(GenEntry gen)
    {
        activeScript = gen;
        outputLines.Clear();
        lastExitCode = null;
        scriptArgs = "";
    }

    private void ToggleCat(string cat) =>
        expandedCat = expandedCat == cat ? "" : cat;

    private async Task RunActive()
    {
        if (activeScript == null || isRunning) return;
        outputLines.Clear();
        lastExitCode = null;
        isRunning = true;
        cts = new CancellationTokenSource();

        var progress = new Progress<ScriptOutputLine>(line =>
        {
            outputLines.Add(line);
            if (outputLines.Count > 2000) outputLines.RemoveAt(0);
            InvokeAsync(StateHasChanged);
        });

        try
        {
            lastExitCode = await Runner.RunAsync(activeScript.Script, scriptArgs, progress, cts.Token);
        }
        finally
        {
            isRunning = false;
            cts.Dispose();
            cts = null;
            StateHasChanged();
        }
    }

    private void KillRun()
    {
        cts?.Cancel();
    }

    private static string FormatLabel(string name)
    {
        var s = name.Replace("generate_", "").Replace("_", " ").Trim();
        return System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(s);
    }

    private static string Categorize(string name)
    {
        var n = name.ToLowerInvariant();
        if (n.Contains("character") || n.Contains("civilian") || n.Contains("npc") || n.Contains("people")) return "Characters";
        if (n.Contains("corp") || n.Contains("faction") || n.Contains("gang") || n.Contains("subsidiary")) return "Organizations";
        if (n.Contains("firearm") || n.Contains("weapon") || n.Contains("ammo") || n.Contains("armor") ||
            n.Contains("cyber") || n.Contains("augment") || n.Contains("genemod") || n.Contains("apparel") ||
            n.Contains("pharma") || n.Contains("equipment")) return "Gear & Weapons";
        if (n.Contains("place") || n.Contains("location") || n.Contains("district") || n.Contains("geography") ||
            n.Contains("transport") || n.Contains("world") || n.Contains("zone") || n.Contains("automata") ||
            n.Contains("creature") || n.Contains("anomal") || n.Contains("flyover") || n.Contains("wasteland")) return "World & Places";
        if (n.Contains("culture") || n.Contains("art") || n.Contains("music") || n.Contains("food") ||
            n.Contains("quote") || n.Contains("slang") || n.Contains("entertainment") || n.Contains("goods")) return "Culture";
        if (n.Contains("tech") || n.Contains("bci") || n.Contains("cyberlimb") || n.Contains("material") ||
            n.Contains("specimen") || n.Contains("psionic") || n.Contains("lab")) return "Science & Tech";
        if (n.Contains("document") || n.Contains("lore") || n.Contains("report") || n.Contains("news") ||
            n.Contains("weird") || n.Contains("snt") || n.Contains("legal") || n.Contains("language")) return "Documents";
        return "Other";
    }

    public void Dispose() => cts?.Cancel();
}
