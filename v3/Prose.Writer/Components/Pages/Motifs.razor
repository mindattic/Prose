@page "/books/{BookId}/motifs"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@using Prose.Core.Models
@using Prose.Core.Interfaces
@using Prose.Core.Services
@using Prose.Shared.Services
@inject IBookRepository BookRepo
@inject IChapterRepository ChapterRepo
@inject DatabaseService CanonDb
@inject MotifService MotifSvc
@inject ToastNotifier Toast
@inject NavigationManager Nav

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="small text-muted mb-1">
                <a href="/books" class="text-muted text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Bookshelf
                </a>
            </div>
            <h4 class="text-danger mb-0"><i class="bi bi-tags me-2"></i>Motifs</h4>
            @if (book != null)
            {
                <div class="text-muted small">@book.Title</div>
            }
        </div>
        @if (book != null)
        {
            <div class="d-flex gap-2 align-items-center">
                <a href="@($"/write/{book.Id}")" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-pencil-square me-1"></i>Write
                </a>
                <button class="btn btn-sm btn-info" @onclick="DetectMotifs" disabled="@(detectingMotifs || projects.Count == 0)">
                    @if (detectingMotifs)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Detecting…</span>
                    }
                    else
                    {
                        <i class="bi bi-search me-1"></i>
                        <span>Auto-detect from chapters</span>
                    }
                </button>
            </div>
        }
    </div>

    @if (book == null)
    {
        <div class="alert alert-danger">Book not found. <a href="/books">Back to bookshelf</a></div>
    }
    else
    {
        <p class="text-muted small">
            Motifs are recurring phrases, named objects, or images that thread through a book.
            Detection scans every chapter for italicized recurring phrases and capitalized named
            objects (canonical character names are excluded). Accept moves a proposal into the
            registered list; Dismiss hides it from the current session.
        </p>

        <h6 class="text-success mt-4">Registered Motifs
            @if (motifInventory != null && motifInventory.Motifs.Any())
            {
                <span class="badge bg-secondary ms-2">@motifInventory.Motifs.Count</span>
            }
        </h6>
        @if (motifInventory != null && motifInventory.Motifs.Any())
        {
            <ul class="list-group mb-3">
                @foreach (var m in motifInventory.Motifs)
                {
                    <li class="list-group-item bg-black text-light border-secondary">
                        <strong>@m.Name</strong>
                        <span class="badge bg-dark text-info ms-2">@m.Kind</span>
                        <div class="small text-muted">@m.Description</div>
                        @if (m.ReferencedInChapterIds.Any())
                        {
                            <div class="small text-success">Referenced in @m.ReferencedInChapterIds.Count chapter(s).</div>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="text-muted small mb-3">No motifs registered yet — click Auto-detect to surface candidates from the chapters.</div>
        }

        <h6 class="text-warning mt-4">Proposals
            @if (motifProposals.Any())
            {
                <span class="badge bg-warning text-dark ms-2">@motifProposals.Count</span>
            }
        </h6>
        @if (!motifProposals.Any() && !detectingMotifs)
        {
            <div class="text-muted small">Run Auto-detect to surface candidate motifs.</div>
        }
        @foreach (var (chapterTitle, p) in motifProposals)
        {
            <div class="card bg-black border-warning mb-2">
                <div class="card-body py-2 px-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <div class="flex-grow-1">
                            <strong>@p.Name</strong>
                            <span class="badge bg-dark text-info ms-2">@p.Kind</span>
                            <span class="text-muted small ms-2">in @chapterTitle</span>
                            <div class="small text-muted">@p.Description</div>
                            <div class="small text-warning">@p.Evidence</div>
                        </div>
                        <div class="d-flex gap-1 flex-shrink-0">
                            <button class="btn btn-sm btn-success py-0" @onclick="() => AcceptMotif(p)">
                                <i class="bi bi-check-lg"></i> Accept
                            </button>
                            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => DismissMotif(p)">
                                <i class="bi bi-x-lg"></i> Dismiss
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string BookId { get; set; } = "";

    private Book? book;
    private List<Chapter> projects = new();
    private MotifInventory? motifInventory;
    private List<(string chapterTitle, MotifProposal proposal)> motifProposals = new();
    private HashSet<string> dismissedProposalKeys = new();
    private bool detectingMotifs;

    protected override void OnInitialized()
    {
        try
        {
            book = BookRepo.LoadBook(BookId);
            if (book != null)
            {
                projects = book.ChapterIds
                    .Select(ChapterRepo.LoadChapter)
                    .Where(c => c != null)
                    .Cast<Chapter>()
                    .OrderBy(c => c.Number ?? int.MaxValue)
                    .ToList();
                motifInventory = MotifSvc.Load(BookId);
            }
        }
        catch (Exception ex)
        {
            Toast.Error("MOTIFS-LOAD", $"Couldn't load motifs page: {ex.Message}");
        }
    }

    private void DetectMotifs()
    {
        if (book == null || detectingMotifs) return;
        detectingMotifs = true;
        StateHasChanged();
        try
        {
            // Canonical character names are excluded from proposals to avoid flagging "Kyle" as a motif.
            var knownNames = CanonDb.Characters.Select(c => c.Name).Where(n => !string.IsNullOrEmpty(n));
            motifProposals.Clear();
            foreach (var c in projects)
            {
                var proposals = MotifSvc.ProposeFromChapter(BookId, c, knownNames);
                foreach (var p in proposals)
                {
                    var key = $"{p.Kind}::{p.Name}".ToLowerInvariant();
                    if (dismissedProposalKeys.Contains(key)) continue;
                    motifProposals.Add((c.Title, p));
                }
            }
            Toast.Success("MOTIFS-DETECT", $"Found {motifProposals.Count} candidate(s) across {projects.Count} chapter(s).");
        }
        catch (Exception ex)
        {
            Toast.Error("MOTIFS-DETECT-FAIL", $"Detection failed: {ex.Message}");
        }
        finally
        {
            detectingMotifs = false;
            StateHasChanged();
        }
    }

    private void AcceptMotif(MotifProposal p)
    {
        if (book == null) return;
        try
        {
            var sourceChapter = motifProposals.FirstOrDefault(t => t.proposal.Name == p.Name).chapterTitle;
            var introducedIn  = projects.FirstOrDefault(c => c.Title == sourceChapter)?.Id ?? "";
            MotifSvc.Plant(BookId, p.Name, p.Description, p.Kind, introducedIn);
            motifInventory = MotifSvc.Load(BookId);
            motifProposals.RemoveAll(t => string.Equals(t.proposal.Name, p.Name, StringComparison.OrdinalIgnoreCase));
            Toast.Success("MOTIFS-ACCEPT", $"Planted motif '{p.Name}'.");
        }
        catch (Exception ex)
        {
            Toast.Error("MOTIFS-ACCEPT-FAIL", $"Couldn't accept '{p.Name}': {ex.Message}");
        }
    }

    private void DismissMotif(MotifProposal p)
    {
        var key = $"{p.Kind}::{p.Name}".ToLowerInvariant();
        dismissedProposalKeys.Add(key);
        motifProposals.RemoveAll(t => string.Equals(t.proposal.Name, p.Name, StringComparison.OrdinalIgnoreCase));
    }
}
