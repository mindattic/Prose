@page "/findings"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@using Microsoft.AspNetCore.Authorization
@using Prose.Core.Services
@inject FindingsService Store
@inject ContinuousQualityService Monitor
@inject FindingApplyService Apply
@inject ContinuityService Continuity
@inject ContinuityApplyService ContinuityApply
@inject IJSRuntime JS
@inject NavigationManager Nav

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <div class="small text-muted mb-1">
            <a href="/" class="text-muted text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Home</a>
        </div>
        <h4 class="text-info mb-0"><i class="bi bi-inbox me-2"></i>Inbox</h4>
        <p class="small text-muted mb-0">
            One triage page for everything that needs your attention. Findings (auto-detected
            contradictions, clichés, anachronisms, voice drift) live alongside continuity
            contradictions (conflicting atomic claims about an entity). Resolve at your own pace —
            both sets persist in the database and only leave the inbox when you mark them done.
        </p>
    </div>
    <div class="d-flex flex-column gap-1 align-items-end">
        <div class="small text-muted">Pause/resume autonomous scans</div>
        <button class="btn btn-sm @(Monitor.Enabled ? "btn-outline-warning" : "btn-outline-success")"
                @onclick="ToggleMonitor">
            @(Monitor.Enabled ? "Pause monitor" : "Resume monitor")
        </button>
    </div>
</div>

@* ── Stats strip ─────────────────────────────────────────── *@
<div class="row g-2 mb-3">
    <div class="col-md-2"><div class="finding-stat"><div class="lbl">New</div><div class="val text-warning">@newCount</div></div></div>
    <div class="col-md-2"><div class="finding-stat"><div class="lbl">Triaged</div><div class="val text-info">@triagedCount</div></div></div>
    <div class="col-md-2"><div class="finding-stat"><div class="lbl">Applied</div><div class="val text-success">@appliedCount</div></div></div>
    <div class="col-md-2"><div class="finding-stat"><div class="lbl">Dismissed</div><div class="val text-muted">@dismissedCount</div></div></div>
    <div class="col-md-2"><div class="finding-stat"><div class="lbl">Contradicted</div><div class="val text-warning">@(contradictionPairs.Count + contradictionGroups.Count)</div></div></div>
    <div class="col-md-2"><div class="finding-stat"><div class="lbl">Pending apply</div><div class="val text-info">@pendingApply.Count</div></div></div>
</div>

@if (!string.IsNullOrEmpty(contradictionStatus))
{
    <div class="alert alert-info small py-2">@contradictionStatus</div>
}
@if (!string.IsNullOrEmpty(contradictionError))
{
    <div class="alert alert-danger small py-2">@contradictionError</div>
}

@* ── Conflicting-claims wizard (one (entity, predicate) at a time) ───── *@
@if (showContradictions)
{
    var wizardCurrent = CurrentWizardGroup;
    var wizardTotal = wizardResolved + contradictionGroups.Count;
    var wizardPct = wizardTotal == 0 ? 0 : (int)Math.Round(100.0 * wizardResolved / wizardTotal);
    if (wizardCurrent is not null)
    {
        <div class="card bg-dark text-light mb-3 border-warning continuity-wizard">
            <div class="card-header bg-warning bg-opacity-25 border-warning d-flex justify-content-between align-items-center">
                <strong><i class="bi bi-exclamation-diamond me-1"></i>Conflicting claims</strong>
                <span class="small text-muted">
                    Decided <strong class="text-success">@wizardResolved</strong>
                    · Left <strong class="text-warning">@WizardRemaining</strong>
                    @if (wizardSkipped.Count > 0)
                    {
                        <text> · Skipped <strong>@wizardSkipped.Count</strong></text>
                    }
                </span>
            </div>
            <div class="card-body">
                <div class="progress mb-3" style="height:6px;background:#1c2128;">
                    <div class="progress-bar bg-success" role="progressbar" style="width:@wizardPct%"></div>
                </div>

                <h5 class="mb-1">@ConflictQuestion(wizardCurrent)</h5>
                <p class="small text-muted mb-3">
                    @wizardCurrent.Claims.Count passages disagree — pick the true one.
                    Picking one resolves the rest automatically.
                </p>

                <div class="row g-3">
                    @foreach (var c in wizardCurrent.Claims)
                    {
                        <div class="@OptionColClass(wizardCurrent.Claims.Count)">
                            <div class="continuity-wizard-option h-100 d-flex flex-column">
                                <div class="small text-muted mb-1">
                                    @c.SourceType
                                    @if (!string.IsNullOrEmpty(c.SourceChapterTitle))
                                    {
                                        <span> · ch.@c.SourceChapterNumber @c.SourceChapterTitle</span>
                                    }
                                </div>
                                <div class="fw-bold fs-6 mb-1">@c.Object</div>
                                @if (!string.IsNullOrEmpty(c.Snippet))
                                {
                                    <div class="small fst-italic text-muted flex-grow-1">"@c.Snippet"</div>
                                }
                                else
                                {
                                    <div class="flex-grow-1"></div>
                                }
                                <button class="btn btn-success mt-3 w-100" disabled="@contradictionWorking"
                                        @onclick="@(() => WizardMakeCanonical(c.ClaimUid))">
                                    <i class="bi bi-check2 me-1"></i>This is true
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <button class="btn btn-sm btn-outline-danger" disabled="@contradictionWorking"
                            @onclick="WizardRejectAll">
                        <i class="bi bi-x-circle me-1"></i>None of these — reject all
                    </button>
                    <div class="d-flex gap-2 align-items-center">
                        @if (wizardSkipped.Count > 0)
                        {
                            <button class="btn btn-sm btn-link text-muted text-decoration-none" @onclick="WizardShowSkipped">
                                Show @wizardSkipped.Count skipped
                            </button>
                        }
                        <button class="btn btn-sm btn-outline-secondary" disabled="@contradictionWorking"
                                @onclick="WizardSkip">
                            Skip <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (contradictionGroups.Count > 0 && wizardSkipped.Count > 0)
    {
        <div class="alert alert-info small py-2 d-flex justify-content-between align-items-center mb-3">
            <span>
                <i class="bi bi-skip-forward me-1"></i>
                You skipped @wizardSkipped.Count conflict@(wizardSkipped.Count == 1 ? "" : "s") this session.
                Decided @wizardResolved.
            </span>
            <button class="btn btn-sm btn-outline-info" @onclick="WizardShowSkipped">
                Bring them back
            </button>
        </div>
    }
}

@* ── Contradiction-pairs wizard (A vs B, pick winner) ──────── *@
@if (showContradictions)
{
    var pairCurrent = CurrentPairWizard;
    var pairTotal = pairResolved + contradictionPairs.Count;
    var pairPct = pairTotal == 0 ? 0 : (int)Math.Round(100.0 * pairResolved / pairTotal);
    if (pairCurrent is not null)
    {
        var pairKey = PairKey(pairCurrent);
        var customOpen = customOpenFor == pairKey;
        <div class="card bg-dark text-light mb-3 border-warning continuity-wizard">
            <div class="card-header bg-warning bg-opacity-25 border-warning d-flex justify-content-between align-items-center">
                <strong><i class="bi bi-exclamation-triangle me-1"></i>Contradiction pairs</strong>
                <span class="small text-muted">
                    Decided <strong class="text-success">@pairResolved</strong>
                    · Left <strong class="text-warning">@PairWizardRemaining</strong>
                    @if (pairSkipped.Count > 0)
                    {
                        <text> · Skipped <strong>@pairSkipped.Count</strong></text>
                    }
                </span>
            </div>
            <div class="card-body">
                <div class="progress mb-3" style="height:6px;background:#1c2128;">
                    <div class="progress-bar bg-success" role="progressbar" style="width:@pairPct%"></div>
                </div>

                <h5 class="mb-1">@ConflictQuestion(pairCurrent.A.EntityName, pairCurrent.A.Predicate)</h5>
                <p class="small text-muted mb-3">
                    Two passages give different values — pick the true one or supply a third.
                </p>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="continuity-wizard-option h-100 d-flex flex-column">
                            <div class="small text-muted mb-1">
                                A · @SourceLabel(pairCurrent.A)
                                @if (pairCurrent.A.ExtractedBy is { Count: > 0 })
                                {
                                    <span> · by @string.Join(", ", pairCurrent.A.ExtractedBy)</span>
                                }
                            </div>
                            <div class="fw-bold fs-6 mb-1">@pairCurrent.A.Object</div>
                            @if (!string.IsNullOrEmpty(pairCurrent.A.Snippet))
                            {
                                <div class="small fst-italic text-muted flex-grow-1">"@pairCurrent.A.Snippet"</div>
                            }
                            else
                            {
                                <div class="flex-grow-1"></div>
                            }
                            <button class="btn btn-success mt-3 w-100" disabled="@contradictionWorking"
                                    @onclick="@(() => DoResolve(pairCurrent, "A", null))">
                                <i class="bi bi-check2 me-1"></i>This is true
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="continuity-wizard-option h-100 d-flex flex-column">
                            <div class="small text-muted mb-1">
                                B · @SourceLabel(pairCurrent.B)
                                @if (pairCurrent.B.ExtractedBy is { Count: > 0 })
                                {
                                    <span> · by @string.Join(", ", pairCurrent.B.ExtractedBy)</span>
                                }
                            </div>
                            <div class="fw-bold fs-6 mb-1">@pairCurrent.B.Object</div>
                            @if (!string.IsNullOrEmpty(pairCurrent.B.Snippet))
                            {
                                <div class="small fst-italic text-muted flex-grow-1">"@pairCurrent.B.Snippet"</div>
                            }
                            else
                            {
                                <div class="flex-grow-1"></div>
                            }
                            <button class="btn btn-success mt-3 w-100" disabled="@contradictionWorking"
                                    @onclick="@(() => DoResolve(pairCurrent, "B", null))">
                                <i class="bi bi-check2 me-1"></i>This is true
                            </button>
                        </div>
                    </div>
                </div>

                @if (customOpen)
                {
                    <div class="mt-3">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><code class="text-warning">@pairCurrent.A.Predicate</code> =</span>
                            <input class="form-control" @bind="customValue" placeholder="agreed-upon value" />
                            <button class="btn btn-success" disabled="@(contradictionWorking || string.IsNullOrWhiteSpace(customValue))"
                                    @onclick="@(() => DoResolve(pairCurrent, "custom", customValue))">Save</button>
                            <button class="btn btn-outline-secondary" @onclick="@(() => customOpenFor = null)">Cancel</button>
                        </div>
                    </div>
                }

                <div class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <button class="btn btn-sm btn-outline-info" disabled="@(contradictionWorking || customOpen)"
                            @onclick="@(() => OpenCustom(pairCurrent))">
                        <i class="bi bi-pencil me-1"></i>Use a custom value…
                    </button>
                    <div class="d-flex gap-2 align-items-center">
                        @if (pairSkipped.Count > 0)
                        {
                            <button class="btn btn-sm btn-link text-muted text-decoration-none" @onclick="PairWizardShowSkipped">
                                Show @pairSkipped.Count skipped
                            </button>
                        }
                        <button class="btn btn-sm btn-outline-secondary" disabled="@contradictionWorking"
                                @onclick="PairWizardSkip">
                            Skip <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (contradictionPairs.Count > 0 && pairSkipped.Count > 0)
    {
        <div class="alert alert-info small py-2 d-flex justify-content-between align-items-center mb-3">
            <span>
                <i class="bi bi-skip-forward me-1"></i>
                You skipped @pairSkipped.Count pair@(pairSkipped.Count == 1 ? "" : "s") this session.
                Decided @pairResolved.
            </span>
            <button class="btn btn-sm btn-outline-info" @onclick="PairWizardShowSkipped">
                Bring them back
            </button>
        </div>
    }
}

@* ── Continuity claims awaiting apply to entity record ── *@
@if (showContradictions && pendingApply.Count > 0)
{
    <div class="card bg-dark text-light mb-3 border-info">
        <div class="card-header bg-info bg-opacity-25 border-info d-flex justify-content-between align-items-center">
            <strong><i class="bi bi-arrow-right-circle me-1"></i>Canonical claims ready to apply</strong>
            <span class="badge bg-info">@pendingApply.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-dark table-hover small mb-0">
                <thead><tr><th>Entity</th><th>Predicate</th><th>Value</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in pendingApply)
                    {
                        <tr>
                            <td>@c.EntityName <span class="text-muted">(@c.EntityKind)</span></td>
                            <td><code>@c.Predicate</code></td>
                            <td>@c.Object</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-info py-0" disabled="@contradictionWorking"
                                        @onclick="() => DoApplyClaim(c)">
                                    @(applyingUid == c.ClaimUid ? "applying…" : "Apply")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* ── Filter chips ───────────────────────────────────────── *@
<div class="mb-2 d-flex flex-wrap gap-1 align-items-center">
    <span class="small text-muted me-2">Status:</span>
    <button class="btn btn-sm @(filter is null ? "btn-info" : "btn-outline-secondary")" @onclick="() => SetFilter(null)">All</button>
    <button class="btn btn-sm @(filter == FindingStatus.New ? "btn-warning text-dark" : "btn-outline-secondary")" @onclick="() => SetFilter(FindingStatus.New)">New</button>
    <button class="btn btn-sm @(filter == FindingStatus.Triaged ? "btn-info" : "btn-outline-secondary")" @onclick="() => SetFilter(FindingStatus.Triaged)">Triaged</button>
    <button class="btn btn-sm @(filter == FindingStatus.Applied ? "btn-success" : "btn-outline-secondary")" @onclick="() => SetFilter(FindingStatus.Applied)">Applied</button>
    <button class="btn btn-sm @(filter == FindingStatus.Dismissed ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => SetFilter(FindingStatus.Dismissed)">Dismissed</button>
    <button class="btn btn-sm @(driftOnly ? "btn-warning text-dark" : "btn-outline-secondary") ms-2"
            @onclick="ToggleDriftOnly"
            title="Show only outline-vs-prose drift findings (OUTLINE-DRIFT prefix)">
        <i class="bi bi-shield-exclamation me-1"></i>Drift only
    </button>
    <span class="small text-muted ms-3 me-1">Continuity:</span>
    <button class="btn btn-sm @(showContradictions ? "btn-warning text-dark" : "btn-outline-secondary")"
            @onclick="() => { showContradictions = !showContradictions; }">
        <i class="bi bi-@(showContradictions ? "eye-fill" : "eye-slash") me-1"></i>
        @(showContradictions ? "Hide" : "Show") contradictions
    </button>
    <button class="btn btn-sm btn-outline-info ms-3" @onclick="Refresh"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
</div>
<div class="mb-3 d-flex flex-wrap gap-1 align-items-center">
    <span class="small text-muted me-2">Category:</span>
    <button class="btn btn-sm @(categoryFilter is null ? "btn-secondary" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(null)">All</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.Contradiction ? "btn-warning text-dark" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.Contradiction)"
            title="Canon-contradiction findings">
        <i class="bi bi-exclamation-triangle me-1"></i>Canon</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.Voice ? "btn-primary" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.Voice)"
            title="Voice-harvest and voice-drift findings">
        <i class="bi bi-mic me-1"></i>Voice</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.OutlineDrift ? "btn-warning text-dark" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.OutlineDrift)"
            title="Outline-vs-prose drift">
        <i class="bi bi-shield-exclamation me-1"></i>Drift</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.GearContradiction ? "btn-secondary" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.GearContradiction)"
            title="Gear carry / weapon contradiction findings">
        <i class="bi bi-tools me-1"></i>Gear</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.BehaviorContradiction ? "btn-secondary" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.BehaviorContradiction)"
            title="Character behavior invariant violations">
        <i class="bi bi-person-exclamation me-1"></i>Behavior</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.Cliche ? "btn-info text-dark" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.Cliche)"
            title="Cliché / craft-tic pattern findings">
        <i class="bi bi-chat-square me-1"></i>Cliché</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.Anachronism ? "btn-secondary" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.Anachronism)"
            title="Timeline and anachronism findings">
        <i class="bi bi-clock-history me-1"></i>Anachronism</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.SemanticDrift ? "btn-warning text-dark" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.SemanticDrift)"
            title="High score / low bible-or-intent alignment (SemanticFidelityService)">
        <i class="bi bi-signpost-split me-1"></i>Semantic Drift</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.ReaderKnows ? "btn-primary" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.ReaderKnows)"
            title="Reader-knowledge-state ledger entries">
        <i class="bi bi-eye me-1"></i>Reader Knows</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.StructuralFailure ? "btn-danger" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.StructuralFailure)"
            title="Blocking pre-flight structural diagnostic failures">
        <i class="bi bi-exclamation-octagon me-1"></i>Structural</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.Liberty ? "btn-secondary" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.Liberty)"
            title="Rule-of-Cool creative-liberty findings (canon-addition candidates, advisories, warnings)">
        <i class="bi bi-stars me-1"></i>Liberty</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.Causality ? "btn-secondary" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.Causality)"
            title="Cause-and-effect / common-sense plausibility lens">
        <i class="bi bi-arrow-repeat me-1"></i>Causality</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.Interpersonal ? "btn-secondary" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.Interpersonal)"
            title="Interpersonal-dynamics lens">
        <i class="bi bi-people me-1"></i>Interpersonal</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.AffectBehavior ? "btn-secondary" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.AffectBehavior)"
            title="Emotion-drives-action lens">
        <i class="bi bi-emoji-frown me-1"></i>Affect</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.Xray ? "btn-secondary" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.Xray)"
            title="X-Ray reveal proposals — prose reveals a canon detail not yet in the entity record">
        <i class="bi bi-search me-1"></i>X-Ray</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.BookAudit ? "btn-secondary" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.BookAudit)"
            title="Gateway/Sequel commandment audit">
        <i class="bi bi-journal-check me-1"></i>Book Audit</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.StoryScope ? "btn-warning text-dark" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.StoryScope)"
            title="StoryScope structural anti-tell audit (SS-A... countermeasures)">
        <i class="bi bi-robot me-1"></i>StoryScope</button>
    <button class="btn btn-sm @(categoryFilter == FindingCategory.Other ? "btn-secondary" : "btn-outline-secondary")"
            @onclick="() => SetCategoryFilter(FindingCategory.Other)"
            title="Other / uncategorised findings">
        Other</button>
</div>

@if (items.Count == 0)
{
    <div class="alert alert-success small py-2">
        <i class="bi bi-check-circle me-1"></i>No findings@(filter is null ? " yet" : $" with status {filter}").
    </div>
}
else if (filter == FindingStatus.Applied || filter == FindingStatus.Dismissed)
{
    @* Read-only views: keep the flat list — there's nothing to decide. *@
    @foreach (var f in VisibleItems)
    {
        var isDrift = IsDrift(f);
        <div class="card bg-dark text-light border-secondary mb-2">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <span class="badge @CategoryBadge(f.Category) me-1">@f.Category</span>
                        <span class="badge @SeverityBadge(f.Severity) me-1">@f.Severity</span>
                        <span class="badge @StatusBadge(f.Status)">@f.Status</span>
                        @if (isDrift)
                        {
                            <span class="badge bg-warning text-dark ms-1" title="Outline-vs-prose drift">
                                <i class="bi bi-shield-exclamation me-1"></i>Drift
                            </span>
                        }
                        <span class="ms-2 small text-muted">@f.DetectedAt.ToLocalTime().ToString("g")</span>
                    </div>
                    <div class="small text-muted"><code>@RelPath(f.FilePath)</code></div>
                </div>
                <div class="fw-bold mb-1">@f.Summary</div>
                @if (!string.IsNullOrWhiteSpace(f.Snippet))
                {
                    <div class="small fst-italic text-muted mb-2">"@f.Snippet"</div>
                }
            </div>
        </div>
    }
}
else
{
    @* Wizard: one actionable finding at a time. *@
    var actionable = WizardableFindings.ToList();
    var fTotal = findingsResolved + items.Count(f => f.Status != FindingStatus.Applied && f.Status != FindingStatus.Dismissed);
    var fPct = fTotal == 0 ? 0 : (int)Math.Round(100.0 * findingsResolved / fTotal);
    var current = actionable.FirstOrDefault();
    if (current is not null)
    {
        var isDrift = IsDrift(current);
        var hasAutoFix = !string.IsNullOrWhiteSpace(current.SuggestedFix) && !string.IsNullOrWhiteSpace(current.Snippet);
        <div class="card bg-dark text-light border-secondary mb-3 findings-wizard">
            <div class="card-header border-secondary d-flex justify-content-between align-items-center" style="background:#161b22;">
                <strong><i class="bi bi-inbox me-1"></i>Findings inbox</strong>
                <span class="small text-muted">
                    Decided <strong class="text-success">@findingsResolved</strong>
                    · Left <strong class="text-warning">@actionable.Count</strong>
                    @if (findingsSkipped.Count > 0)
                    {
                        <text> · Skipped <strong>@findingsSkipped.Count</strong></text>
                    }
                </span>
            </div>
            <div class="card-body p-3">
                <div class="progress mb-3" style="height:6px;background:#1c2128;">
                    <div class="progress-bar bg-success" role="progressbar" style="width:@fPct%"></div>
                </div>

                <div class="d-flex justify-content-between align-items-start mb-2 flex-wrap gap-2">
                    <div>
                        <span class="badge @CategoryBadge(current.Category) me-1">@current.Category</span>
                        <span class="badge @SeverityBadge(current.Severity) me-1">@current.Severity</span>
                        <span class="badge @StatusBadge(current.Status)">@current.Status</span>
                        @if (isDrift)
                        {
                            <span class="badge bg-warning text-dark ms-1" title="Outline-vs-prose drift">
                                <i class="bi bi-shield-exclamation me-1"></i>Drift
                            </span>
                        }
                        <span class="ms-2 small text-muted">@current.DetectedAt.ToLocalTime().ToString("g")</span>
                    </div>
                    <div class="small text-muted"><code>@RelPath(current.FilePath)</code></div>
                </div>

                <div class="fw-bold fs-6 mb-2">@current.Summary</div>
                @if (!string.IsNullOrWhiteSpace(current.Snippet))
                {
                    <div class="border border-secondary rounded p-2 mb-2 small fst-italic text-muted">
                        "@current.Snippet"
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(current.SuggestedFix))
                {
                    <div class="border border-success rounded p-2 mb-2 small">
                        <div class="text-success mb-1"><i class="bi bi-magic me-1"></i>Suggested fix</div>
                        <div>@current.SuggestedFix</div>
                    </div>
                }
                @if (applyMessages.TryGetValue(current.Id, out var msg))
                {
                    <div class="alert alert-@(msg.Css) small py-1 px-2 mb-2">@msg.Text</div>
                }

                <div class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex gap-2 flex-wrap">
                        @if (hasAutoFix)
                        {
                            <button class="btn btn-success" disabled="@(applying == current.Id)"
                                    @onclick="() => FindingsApplyAndAdvance(current.Id)">
                                <i class="bi bi-magic me-1"></i>@(applying == current.Id ? "applying…" : "Apply fix")
                            </button>
                        }
                        <button class="btn btn-outline-success"
                                @onclick="() => FindingsResolveAndAdvance(current.Id, FindingStatus.Applied)">
                            <i class="bi bi-check2 me-1"></i>Mark applied
                        </button>
                        <button class="btn btn-outline-secondary"
                                @onclick="() => FindingsResolveAndAdvance(current.Id, FindingStatus.Dismissed)">
                            <i class="bi bi-trash me-1"></i>Dismiss
                        </button>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        @if (findingsSkipped.Count > 0)
                        {
                            <button class="btn btn-sm btn-link text-muted text-decoration-none" @onclick="FindingsShowSkipped">
                                Show @findingsSkipped.Count skipped
                            </button>
                        }
                        <button class="btn btn-sm btn-outline-secondary"
                                @onclick="FindingsSkip">
                            Skip <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (findingsSkipped.Count > 0)
    {
        <div class="alert alert-info small py-2 d-flex justify-content-between align-items-center">
            <span>
                <i class="bi bi-skip-forward me-1"></i>
                You skipped @findingsSkipped.Count finding@(findingsSkipped.Count == 1 ? "" : "s") this session.
                Decided @findingsResolved.
            </span>
            <button class="btn btn-sm btn-outline-info" @onclick="FindingsShowSkipped">
                Bring them back
            </button>
        </div>
    }
    else
    {
        <div class="alert alert-success small py-2">
            <i class="bi bi-check-circle me-1"></i>Inbox zero. @(findingsResolved > 0 ? $"{findingsResolved} decided this session." : "Nothing to triage.")
        </div>
    }
}

<style>
    .finding-stat { background:#1c2128; border-radius:4px; padding:8px 12px; text-align:center; }
    .finding-stat .lbl { font-size:.7rem; text-transform:uppercase; color:var(--bs-secondary); }
    .finding-stat .val { font-size:1.4rem; font-weight:600; }

    /* Conflicts wizard (mirrors /continuity) */
    .continuity-wizard-option {
        background:#0d1117;
        border:1px solid #30363d;
        border-radius:8px;
        padding:14px;
        transition: border-color .15s ease, background-color .15s ease;
    }
    .continuity-wizard-option:hover {
        border-color:#3fb950;
        background:#101820;
    }
    .continuity-wizard-option .btn-success {
        background:#238636;
        border-color:#238636;
    }
    .continuity-wizard-option .btn-success:hover {
        background:#2ea043;
        border-color:#2ea043;
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "drift")] public string? DriftQuery { get; set; }

    private FindingStatus? filter;
    private bool driftOnly;
    private FindingCategory? categoryFilter;
    private List<Finding> items = new();
    private int newCount, triagedCount, appliedCount, dismissedCount;
    /// <summary>
    /// Items rendered in the list view. When the Drift-only chip is active,
    /// narrow to findings categorized OutlineDrift OR (for backward compat
    /// with rows written before the category promotion) whose summary carries
    /// the OUTLINE-DRIFT prefix. Category chip further narrows by FindingCategory.
    /// </summary>
    private IEnumerable<Finding> VisibleItems =>
        (driftOnly ? items.Where(IsDrift) : items)
        .Where(f => categoryFilter is null || f.Category == categoryFilter);

    private static bool IsDrift(Finding f) =>
        f.Category == FindingCategory.OutlineDrift
        || (f.Summary ?? "").StartsWith("OUTLINE-DRIFT", StringComparison.OrdinalIgnoreCase);
    private long? applying;
    private readonly Dictionary<long, (string Css, string Text)> applyMessages = new();

    // Continuity-side state — same shape as /continuity, surfaced here so the
    // user has one inbox for findings + contradictions rather than two pages.
    private bool showContradictions = true;
    private List<ContradictionPair> contradictionPairs = new();
    private List<ContradictionGroup> contradictionGroups = new();
    private List<ContinuityClaim> pendingApply = new();
    private bool contradictionWorking;
    private string contradictionStatus = "";
    private string contradictionError = "";
    private string? customOpenFor;
    private string customValue = "";
    private string applyingUid = "";

    // ── Conflicting-claims wizard (mirrors /continuity) ─────────
    private HashSet<string> wizardSkipped = new();
    private int wizardResolved;
    private ContradictionGroup? CurrentWizardGroup =>
        contradictionGroups.FirstOrDefault(g => !wizardSkipped.Contains(g.Key));
    private int WizardRemaining =>
        contradictionGroups.Count(g => !wizardSkipped.Contains(g.Key));

    // ── Contradiction-pairs wizard ──────────────────────────────
    private HashSet<string> pairSkipped = new();
    private int pairResolved;
    private static string PairKey(ContradictionPair p) => p.A.ClaimUid + "|" + p.B.ClaimUid;
    private ContradictionPair? CurrentPairWizard =>
        contradictionPairs.FirstOrDefault(p => !pairSkipped.Contains(PairKey(p)));
    private int PairWizardRemaining =>
        contradictionPairs.Count(p => !pairSkipped.Contains(PairKey(p)));

    // ── Findings wizard ──────────────────────────────────────────
    private HashSet<long> findingsSkipped = new();
    private int findingsResolved;
    private IEnumerable<Finding> WizardableFindings =>
        VisibleItems.Where(f => f.Status != FindingStatus.Applied
                             && f.Status != FindingStatus.Dismissed
                             && !findingsSkipped.Contains(f.Id));

    protected override void OnInitialized() => Refresh();

    /// <summary>
    /// Query-param sync: ?drift=1 sets driftOnly on entry. Runs ahead of the
    /// localStorage hop in OnAfterRenderAsync so a deep-link beats the saved
    /// preference (explicit URL wins, matching the /entity tab behavior).
    /// </summary>
    protected override void OnParametersSet()
    {
        if (DriftQuery == "1" && !driftOnly) driftOnly = true;
        if (DriftQuery == "0" && driftOnly)  driftOnly = false;
    }

    /// <summary>Restore filter + scroll position from localStorage on first render.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var savedFilter = await JS.InvokeAsync<string?>("ssState.get", "findings:filter");
            if (Enum.TryParse<FindingStatus>(savedFilter ?? "", out var f) && f != filter)
            {
                filter = f;
                Refresh();
                StateHasChanged();
            }
            var savedDrift = await JS.InvokeAsync<string?>("ssState.get", "findings:drift-only");
            if (savedDrift == "1" && !driftOnly)
            {
                driftOnly = true;
                StateHasChanged();
            }
            await JS.InvokeVoidAsync("ssState.installAutoScroll", "findings:scroll");
            await JS.InvokeVoidAsync("ssState.restoreScroll",     "findings:scroll");
        }
        catch { /* JS may be unavailable during prerender */ }
    }

    private void Refresh()
    {
        items = Store.List(filter, limit: 200).ToList();
        newCount       = Store.CountByStatus(FindingStatus.New);
        triagedCount   = Store.CountByStatus(FindingStatus.Triaged);
        appliedCount   = Store.CountByStatus(FindingStatus.Applied);
        dismissedCount = Store.CountByStatus(FindingStatus.Dismissed);

        try
        {
            contradictionPairs  = Continuity.GetContradictions();
            contradictionGroups = Continuity.GetContradictionGroups();
            pendingApply        = Continuity.GetByStatus("CANONICAL")
                                            .Where(c => string.IsNullOrEmpty(c.AppliedAt))
                                            .ToList();
        }
        catch (Exception ex)
        {
            contradictionError = "Continuity load failed: " + ex.Message;
            contradictionPairs.Clear();
            contradictionGroups.Clear();
            pendingApply.Clear();
        }
    }

    // ── Continuity actions ──────────────────────────────────────────────────

    private void MakeCanonical(string claimUid)
    {
        contradictionWorking = true; contradictionError = "";
        try
        {
            Continuity.MakeCanonical(claimUid, "Selected from /findings inbox.");
            contradictionStatus = "Canonical claim set; siblings rejected.";
            Refresh();
        }
        catch (Exception ex) { contradictionError = ex.Message; }
        finally { contradictionWorking = false; }
    }

    private void RejectClaim(string claimUid)
    {
        contradictionWorking = true; contradictionError = "";
        try
        {
            Continuity.RejectClaim(claimUid, "Rejected from /findings inbox.");
            contradictionStatus = "Claim rejected.";
            Refresh();
        }
        catch (Exception ex) { contradictionError = ex.Message; }
        finally { contradictionWorking = false; }
    }

    // ── Conflicting-claims wizard actions ───────────────────────

    private void WizardMakeCanonical(string claimUid)
    {
        contradictionWorking = true; contradictionError = "";
        try
        {
            Continuity.MakeCanonical(claimUid, "Selected from /findings wizard.");
            wizardResolved++;
            contradictionStatus = "Resolved — siblings rejected automatically.";
            Refresh();
        }
        catch (Exception ex) { contradictionError = ex.Message; }
        finally { contradictionWorking = false; }
    }

    private void WizardRejectAll()
    {
        var g = CurrentWizardGroup;
        if (g is null) return;
        contradictionWorking = true; contradictionError = "";
        try
        {
            foreach (var c in g.Claims)
                Continuity.RejectClaim(c.ClaimUid, "All values rejected from /findings wizard.");
            wizardResolved++;
            contradictionStatus = $"All {g.Claims.Count} values rejected.";
            Refresh();
        }
        catch (Exception ex) { contradictionError = ex.Message; }
        finally { contradictionWorking = false; }
    }

    private void WizardSkip()
    {
        var g = CurrentWizardGroup;
        if (g is not null) wizardSkipped.Add(g.Key);
    }

    private void WizardShowSkipped() => wizardSkipped.Clear();

    private static string OptionColClass(int count) =>
        count <= 1 ? "col-12"
        : count == 3 ? "col-md-4"
        : "col-md-6";

    private static string ConflictQuestion(ContradictionGroup g) =>
        ConflictQuestion(g.EntityName, g.Predicate);

    private static string ConflictQuestion(string entityName, string predicate)
    {
        var name = string.IsNullOrWhiteSpace(entityName) ? "this entity" : entityName;
        var pred = (predicate ?? "").ToLowerInvariant();
        return pred switch
        {
            "age"               => $"What is {name}'s age?",
            "name"              => $"What is {name}'s name?",
            "build"             => $"What is {name}'s build?",
            "height"            => $"What is {name}'s height?",
            "weight"            => $"What is {name}'s weight?",
            "eye_color" or "eyes" => $"What colour are {name}'s eyes?",
            "hair" or "hair_color" => $"What is {name}'s hair?",
            "employment"        => $"What is {name}'s employment?",
            "occupation"        => $"What is {name}'s occupation?",
            "knowledge"         => $"What does {name} know?",
            "location"          => $"Where is {name}?",
            "home_turf" or "hometurf" => $"Where is {name}'s home turf?",
            "affiliation"       => $"What is {name}'s affiliation?",
            "status"            => $"What is {name}'s status?",
            "relationship"      => $"What is {name}'s relationship?",
            _                   => $"What is {name}'s {pred.Replace('_', ' ')}?"
        };
    }

    private void PairWizardSkip()
    {
        var p = CurrentPairWizard;
        if (p is not null) pairSkipped.Add(PairKey(p));
    }

    private void PairWizardShowSkipped() => pairSkipped.Clear();

    // ── Findings wizard actions ─────────────────────────────────

    private void FindingsResolveAndAdvance(long id, FindingStatus s)
    {
        Store.SetStatus(id, s);
        findingsResolved++;
        Refresh();
    }

    private void FindingsSkip()
    {
        var f = WizardableFindings.FirstOrDefault();
        if (f is not null) findingsSkipped.Add(f.Id);
    }

    private void FindingsShowSkipped() => findingsSkipped.Clear();

    private async Task FindingsApplyAndAdvance(long id)
    {
        applying = id;
        applyMessages.Remove(id);
        StateHasChanged();
        try
        {
            var result = await Apply.ApplyAsync(id);
            if (result.Outcome == ApplyOutcome.Applied)
            {
                Store.SetStatus(id, FindingStatus.Applied);
                findingsResolved++;
                applyMessages.Remove(id);
            }
            else
            {
                applyMessages[id] = result.Outcome switch
                {
                    ApplyOutcome.SnippetNotFound => ("warning",   result.Detail ?? "Snippet not found in file — edit manually."),
                    ApplyOutcome.NoSuggestedFix  => ("secondary", "This finding has no suggested fix."),
                    ApplyOutcome.NoSnippet       => ("secondary", "This finding has no snippet to anchor a replacement."),
                    ApplyOutcome.FileMissing     => ("danger",    "Source file is gone."),
                    _                            => ("danger",    result.Detail ?? "Apply failed."),
                };
            }
        }
        catch (Exception ex)
        {
            applyMessages[id] = ("danger", ex.Message);
        }
        finally
        {
            applying = null;
            Refresh();
        }
    }

    private void OpenCustom(ContradictionPair pair)
    {
        customOpenFor = pair.A.ClaimUid + "|" + pair.B.ClaimUid;
        customValue = "";
    }

    private async Task DoResolve(ContradictionPair pair, string winner, string? customObj)
    {
        if (winner == "custom" && string.IsNullOrWhiteSpace(customObj))
        {
            contradictionError = "Custom requires a value.";
            return;
        }
        contradictionWorking = true; contradictionError = "";
        try
        {
            await Task.Run(() => Continuity.Resolve(pair.A.ClaimUid, pair.B.ClaimUid, winner, customObj ?? "", ""));
            customOpenFor = null;
            customValue = "";
            pairResolved++;
            contradictionStatus = $"Resolved {pair.A.EntityName}.{pair.A.Predicate} (winner: {winner}).";
            Refresh();
        }
        catch (Exception ex)
        {
            contradictionError = "Resolve error: " + ex.Message;
        }
        finally
        {
            contradictionWorking = false; StateHasChanged();
        }
    }

    private async Task DoApplyClaim(ContinuityClaim claim)
    {
        contradictionWorking = true; applyingUid = claim.ClaimUid; contradictionError = "";
        try
        {
            var r = await ContinuityApply.ApplyAsync(claim.ClaimUid);
            if (r.Ok)
            {
                contradictionStatus = $"Applied to {Path.GetFileName(r.EntityFile)} → {r.FieldPath} (confidence {r.DecisionConfidence:P0}).";
                Refresh();
            }
            else
            {
                contradictionError = "Apply failed: " + r.Error;
            }
        }
        catch (Exception ex)
        {
            contradictionError = "Apply error: " + ex.Message;
        }
        finally
        {
            contradictionWorking = false; applyingUid = ""; StateHasChanged();
        }
    }

    private static string SourceLabel(ContinuityClaim c) => c.SourceType switch
    {
        "prose"            => $"prose ch.{c.SourceChapterNumber}",
        "entity_record"    => $"record {Path.GetFileName(c.SourcePath ?? "")}",
        "writer_assertion" => "writer",
        _                  => c.SourceType,
    };

    private static string ClaimStatusBadge(string s) => s switch
    {
        "CANONICAL"    => "bg-success",
        "CONFIRMED"    => "bg-success bg-opacity-50",
        "NEW"          => "bg-info",
        "CONTRADICTED" => "bg-warning text-dark",
        "REJECTED"     => "bg-secondary",
        "SUPERSEDED"   => "bg-secondary",
        _              => "bg-light text-dark",
    };

    private void SetFilter(FindingStatus? s)
    {
        filter = s;
        Refresh();
        _ = PersistFilterAsync();
    }

    private void SetCategoryFilter(FindingCategory? c)
    {
        categoryFilter = c;
    }

    private async Task PersistFilterAsync()
    {
        try { await JS.InvokeVoidAsync("ssState.set", "findings:filter", filter?.ToString() ?? ""); }
        catch { }
    }

    private void ToggleDriftOnly()
    {
        driftOnly = !driftOnly;
        _ = PersistDriftOnlyAsync();
        // Reflect into the URL so the current view is shareable. Use replace
        // so the back button doesn't have a stop on every toggle, and skip
        // the ?drift= param entirely when it's off (cleaner URL on default).
        var url = driftOnly ? "/findings?drift=1" : "/findings";
        Nav.NavigateTo(url, replace: true);
    }

    private async Task PersistDriftOnlyAsync()
    {
        try { await JS.InvokeVoidAsync("ssState.set", "findings:drift-only", driftOnly ? "1" : "0"); }
        catch { }
    }

    private void SetStatus(long id, FindingStatus s)
    {
        Store.SetStatus(id, s);
        Refresh();
    }

    private async Task DoApply(long id)
    {
        applying = id;
        applyMessages.Remove(id);
        StateHasChanged();
        try
        {
            var result = await Apply.ApplyAsync(id);
            applyMessages[id] = result.Outcome switch
            {
                ApplyOutcome.Applied         => ("success", "Fix applied to file. Backup written to engine/data/archives/findings/."),
                ApplyOutcome.SnippetNotFound => ("warning", result.Detail ?? "Snippet not found in file — edit manually."),
                ApplyOutcome.NoSuggestedFix  => ("secondary", "This finding has no suggested fix."),
                ApplyOutcome.NoSnippet       => ("secondary", "This finding has no snippet to anchor a replacement."),
                ApplyOutcome.FileMissing     => ("danger", "Source file is gone."),
                _                            => ("danger", result.Detail ?? "Apply failed."),
            };
        }
        catch (Exception ex)
        {
            applyMessages[id] = ("danger", ex.Message);
        }
        finally
        {
            applying = null;
            Refresh();
        }
    }

    private void ToggleMonitor()
    {
        Monitor.Enabled = !Monitor.Enabled;
    }

    private static string CategoryBadge(FindingCategory c) => c switch
    {
        FindingCategory.Contradiction          => "bg-warning text-dark",
        FindingCategory.Cliche                 => "bg-info text-dark",
        FindingCategory.Anachronism            => "bg-purple",
        FindingCategory.Voice                  => "bg-primary",
        FindingCategory.OutlineDrift           => "bg-warning text-dark",
        FindingCategory.GearContradiction      => "bg-secondary",
        FindingCategory.BehaviorContradiction  => "bg-secondary",
        FindingCategory.SemanticDrift          => "bg-warning text-dark",
        FindingCategory.ReaderKnows            => "bg-primary",
        FindingCategory.StructuralFailure      => "bg-danger",
        FindingCategory.StoryScope             => "bg-warning text-dark",
        _                                      => "bg-secondary",
    };

    private static string SeverityBadge(FindingSeverity s) => s switch
    {
        FindingSeverity.High   => "bg-danger",
        FindingSeverity.Medium => "bg-warning text-dark",
        _                      => "bg-secondary",
    };

    private static string StatusBadge(FindingStatus s) => s switch
    {
        FindingStatus.New       => "bg-warning text-dark",
        FindingStatus.Triaged   => "bg-info text-dark",
        FindingStatus.Applied   => "bg-success",
        FindingStatus.Dismissed => "bg-secondary",
        _                       => "bg-secondary",
    };

    private static string RelPath(string p)
    {
        var idx = p.IndexOf("engine", StringComparison.OrdinalIgnoreCase);
        return idx >= 0 ? p[idx..].Replace('\\', '/') : Path.GetFileName(p);
    }
}
