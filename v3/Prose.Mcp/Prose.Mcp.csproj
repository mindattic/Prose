<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Prose.Mcp</RootNamespace>
    <AssemblyName>Prose.Mcp</AssemblyName>
    <!-- Explicit (not just a publish-time flag): Prose.Hub references this project (another
         Exe) for ToolDispatch's reflection over the migrated tool classes. Publishing Prose.Hub
         framework-dependent for win-x64 fails with NETSDK1151 unless both ends of an Exe-to-Exe
         project reference agree on this in-project, not just on the command line. -->
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Anthropic's C# Model Context Protocol SDK. The server-side bits live in the
         core package; the package version intentionally floats so security updates
         flow without touching this csproj. -->
    <PackageReference Include="ModelContextProtocol" Version="*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Re-uses every Core service (repos, BookOutlineService, SemanticIndexService,
         MotifService, WritingQualityService, etc) via AddProseServices(). -->
    <ProjectReference Include="..\Prose.Core\Prose.Core.csproj" />
  </ItemGroup>

</Project>
