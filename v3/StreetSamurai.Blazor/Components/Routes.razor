<Router AppAssembly="typeof(Program).Assembly"
        AdditionalAssemblies="new[] { typeof(StreetSamurai.Shared.Components.Pages.Home).Assembly }"
        NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(StreetSamurai.Shared.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
