<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\StreetSamurai.Core\StreetSamurai.Core.csproj" />
    <ProjectReference Include="..\StreetSamurai.Shared\StreetSamurai.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>mindattic-vault-shared</UserSecretsId>
  </PropertyGroup>

  <!-- Include world data in published output so Azure deployment is self-contained.
       STREETSAMURAI_DATA_ROOT env var overrides this path (set in Azure App Configuration). -->
  <ItemGroup>
    <Content Include="..\..\engine\data\**\*" CopyToPublishDirectory="PreserveNewest">
      <Link>engine\data\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Pull latest CBG bundle from MindAttic.Shared into wwwroot before each build.
       Idempotent: when MindAttic.Shared hasn't changed, this is a no-op rewrite.
       If MindAttic.Shared isn't checked out next to this repo, the target is skipped. -->
  <Target Name="SyncMindAtticShared" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_SharedSync>$(MSBuildThisFileDirectory)..\..\..\MindAttic.Shared\sync\sync-streetsamurai.ps1</_SharedSync>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_SharedSync)&quot;"
          Condition="Exists('$(_SharedSync)')"
          ContinueOnError="true" />
  </Target>

</Project>
