<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\StreetSamurai.Core\StreetSamurai.Core.csproj" />
    <ProjectReference Include="..\StreetSamurai.Shared\StreetSamurai.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- PROD Data Protection key-ring persistence + at-rest protection for
         MindAttic.Authentication. Only the production code path uses these
         (DefaultAzureCredential → Blob + Key Vault); dev persists to the file system. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Blobs" Version="1.5.3" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <!-- CLI builds go to a separate output dir so the running server never blocks a rebuild.
       Pass -p:CliRun=true (or set env var CliRun=true) for any dotnet run / dotnet build
       invoked as a CLI command rather than the web host. -->
  <PropertyGroup Condition="'$(CliRun)' == 'true'">
    <OutputPath>bin\$(Configuration)\cli\$(TargetFramework)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!-- Include world data in published output so Azure deployment is self-contained.
       STREETSAMURAI_DATA_ROOT env var overrides this path (set in Azure App Configuration). -->
  <ItemGroup>
    <Content Include="..\..\engine\data\**\*" CopyToPublishDirectory="PreserveNewest">
      <Link>engine\data\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <!-- Pull latest subscribed components from MindAttic.UiUx into wwwroot before each build.
       Idempotent: when MindAttic.UiUx hasn't changed, this is a no-op rewrite.
       If MindAttic.UiUx isn't checked out next to this repo, the target is skipped. -->
  <Target Name="SyncMindAtticComponents" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_ContentSync>$(MSBuildThisFileDirectory)..\..\..\MindAttic.UiUx\sync\sync-streetsamurai.ps1</_ContentSync>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_ContentSync)&quot;"
          Condition="Exists('$(_ContentSync)')"
          ContinueOnError="true" />
  </Target>

</Project>
