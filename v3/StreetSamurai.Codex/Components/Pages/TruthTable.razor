@page "/truth-table"
@using Microsoft.EntityFrameworkCore
@using StreetSamurai.Core.Data
@using StreetSamurai.Core.Data.Entities
@using StreetSamurai.Core.Services
@inject IDbContextFactory<StreetSamuraiDbContext> Db
@inject BeatVerificationService VerifySvc

<PageTitle>Truth Table</PageTitle>

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <div class="small text-muted mb-1">
            <a href="/" class="text-muted text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Home</a>
        </div>
        <h4 class="text-info mb-0"><i class="bi bi-table me-2"></i>Truth Table</h4>
        <p class="small text-muted mb-0">
            Per-beat verification status against declared
            <code>BeatBlueprintDecision</code> contracts. BLOCKER findings block
            <code>ss --export-node</code>. Run <code>ss --verify-book --slug CODE</code>
            to refresh.
        </p>
    </div>
</div>

@* Story selector *@
<div class="d-flex align-items-center gap-2 mb-3">
    <label class="small text-muted mb-0">Story:</label>
    <select class="form-select form-select-sm bg-dark text-light border-secondary" style="max-width:320px"
            @onchange="OnStoryChanged">
        <option value="">— select a story —</option>
        @foreach (var s in books)
        {
            <option value="@s.Slug" selected="@(selectedSlug == s.Slug)">
                @(s.NodeCode ?? s.Slug) — @s.Title
            </option>
        }
    </select>
    @if (!string.IsNullOrEmpty(selectedSlug) && !running)
    {
        <button class="btn btn-sm btn-outline-info" @onclick="RunVerify">
            <i class="bi bi-arrow-clockwise me-1"></i>Re-verify
        </button>
    }
    @if (running)
    {
        <span class="text-muted small"><span class="spinner-border spinner-border-sm me-1"></span>Verifying…</span>
    }
</div>

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger small py-2">@error</div>
}

@if (summary != null)
{
    @* Story-level summary strip *@
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-2">
            <div class="tt-stat">
                <div class="lbl">Beats checked</div>
                <div class="val text-light">@summary.BeatsChecked</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="tt-stat">
                <div class="lbl">BLOCKER</div>
                <div class="val @(summary.Blockers > 0 ? "text-danger" : "text-success")">@summary.Blockers</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="tt-stat">
                <div class="lbl">MODERATE</div>
                <div class="val @(summary.Moderates > 0 ? "text-warning" : "text-success")">@summary.Moderates</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="tt-stat">
                <div class="lbl">MINOR</div>
                <div class="val text-secondary">@summary.Minors</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="tt-stat">
                <div class="lbl">Truth score</div>
                <div class="val @TruthScoreClass">@TruthScore%</div>
            </div>
        </div>
        <div class="col-6 col-md-2">
            <div class="tt-stat">
                <div class="lbl">Export gate</div>
                <div class="val @(summary.Blockers == 0 ? "text-success" : "text-danger")">
                    @(summary.Blockers == 0 ? "PASS" : "BLOCKED")
                </div>
            </div>
        </div>
    </div>

    @* Per-beat table *@
    @if (beatRows.Count == 0)
    {
        <p class="text-muted small">No verification results yet. Run <code>ss --verify-book --slug @selectedSlug</code> first.</p>
    }
    else
    {
        <div class="tt-scroll">
        <table class="table table-dark table-sm table-hover tt-table">
            <thead>
                <tr>
                    <th style="width:3rem">#</th>
                    <th>Beat goal</th>
                    @foreach (var ct in CheckTypes)
                    {
                        <th class="text-center" style="min-width:90px">@ct</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in beatRows)
                {
                    var anyFail = row.Checks.Values.Any(r => r.Result == "Fail");
                    <tr class="@(anyFail ? "tt-row-fail" : "")"
                        @onclick="() => ToggleRow(row.BeatId)"
                        style="cursor:pointer">
                        <td class="text-muted small">@row.SortKey.ToString("0")</td>
                        <td class="small text-truncate" style="max-width:260px" title="@row.Goal">@row.Goal</td>
                        @foreach (var ct in CheckTypes)
                        {
                            <td class="text-center">
                                @if (row.Checks.TryGetValue(ct, out var res))
                                {
                                    <span class="tt-chip @ResultClass(res.Result, res.Severity)" title="@res.Evidence">
                                        @ResultIcon(res.Result)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">–</span>
                                }
                            </td>
                        }
                    </tr>
                    @if (expandedBeat == row.BeatId)
                    {
                        <tr class="tt-detail">
                            <td colspan="@(CheckTypes.Length + 2)">
                                <div class="ps-3 py-1">
                                    @if (!string.IsNullOrEmpty(row.DeclaredPurpose))
                                    {
                                        <div class="small mb-1"><strong>Contract:</strong> @row.DeclaredPurpose</div>
                                    }
                                    @foreach (var kv in row.Checks.Where(kv => kv.Value.Result != "Pass" && kv.Value.Result != "Skipped"))
                                    {
                                        <div class="small mb-1">
                                            <span class="@ResultClass(kv.Value.Result, kv.Value.Severity) tt-chip me-1">@kv.Key</span>
                                            @kv.Value.Evidence
                                        </div>
                                    }
                                    @if (!row.Checks.Any(kv => kv.Value.Result != "Pass" && kv.Value.Result != "Skipped"))
                                    {
                                        <span class="small text-success">All checks pass.</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
        </div>
    }
}

<style>
    .tt-stat { background: rgba(255,255,255,.04); border-radius: 6px; padding: .4rem .6rem; }
    .tt-stat .lbl { font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; color: var(--bs-secondary); }
    .tt-stat .val { font-size: 1.35rem; font-weight: 600; line-height: 1.2; }
    .tt-scroll { overflow-x: auto; }
    .tt-table { font-size: .82rem; min-width: 760px; }
    .tt-table thead th { font-size: .72rem; text-transform: uppercase; letter-spacing: .04em; color: var(--bs-secondary); border-bottom: 1px solid rgba(255,255,255,.1); }
    .tt-row-fail { background: rgba(220, 53, 69, .06) !important; }
    .tt-chip { display: inline-block; padding: 1px 5px; border-radius: 4px; font-size: .72rem; font-weight: 600; }
    .tt-chip-pass    { background: rgba(25,135,84,.25); color: #75de9d; }
    .tt-chip-fail-bl { background: rgba(220,53,69,.35); color: #f8a0a8; }
    .tt-chip-fail-mo { background: rgba(255,193,7,.25); color: #ffc107; }
    .tt-chip-partial { background: rgba(13,202,240,.2); color: #0dcaf0; }
    .tt-chip-skip    { background: rgba(108,117,125,.15); color: #6c757d; }
    .tt-detail td { background: rgba(0,0,0,.2); }
</style>

@code {
    static readonly string[] CheckTypes = new[]
    {
        "BannedPattern", "EventType", "SubplotCarrier",
        "EscalationFloor", "EscalationMonotonic", "DeclaredPurpose",
    };

    record BookRow(string? NodeCode, string Slug, string Title);
    record BeatRow(Guid BeatId, double SortKey, string Goal, string? DeclaredPurpose,
                   Dictionary<string, VerifResult> Checks);
    record VerifResult(string Result, string Severity, string? Evidence);

    List<BookRow> books = new();
    string? selectedSlug;
    bool running;
    string? error;
    BookVerificationSummary? summary;
    List<BeatRow> beatRows = new();
    Guid? expandedBeat;

    int TruthScore => summary is { BeatsChecked: > 0 }
        ? (int)(100.0 * summary.Passed / (summary.BeatsChecked * CheckTypes.Length + 1))
        : 0;
    string TruthScoreClass => TruthScore >= 85 ? "text-success" : TruthScore >= 60 ? "text-warning" : "text-danger";

    protected override async Task OnInitializedAsync()
    {
        await using var db = await Db.CreateDbContextAsync();
        books = await db.Nodes.AsNoTracking()
            .Where(n => n.Kind == "book")
            .OrderBy(n => n.NodeCode ?? n.Slug)
            .Select(n => new BookRow(n.NodeCode, n.Slug, n.Title))
            .ToListAsync();
    }

    async Task OnStoryChanged(ChangeEventArgs e)
    {
        selectedSlug = e.Value as string;
        summary = null;
        beatRows.Clear();
        expandedBeat = null;
        error = null;
        if (!string.IsNullOrEmpty(selectedSlug))
            await LoadVerificationResults();
    }

    async Task LoadVerificationResults()
    {
        if (string.IsNullOrEmpty(selectedSlug)) return;
        try
        {
            await using var db = await Db.CreateDbContextAsync();

            // Resolve story + chapter node IDs
            var storyNode = await db.Nodes.AsNoTracking()
                .FirstOrDefaultAsync(n => n.Slug == selectedSlug || n.NodeCode == selectedSlug);
            if (storyNode == null) { error = $"Story '{selectedSlug}' not found."; return; }

            var chapterIds = await db.Nodes.AsNoTracking()
                .Where(n => n.ParentNodeId == storyNode.Id)
                .Select(n => n.Id).ToListAsync();
            var allNodeIds = new List<Guid>(chapterIds.Count + 1) { storyNode.Id };
            allNodeIds.AddRange(chapterIds);

            // Load beats with their blueprint decisions
            var beats = await db.BeatNodes.AsNoTracking()
                .Where(bn => allNodeIds.Contains(bn.NodeId) && bn.IsEnabled)
                .OrderBy(bn => bn.SortKey)
                .Select(bn => new
                {
                    bn.BeatId,
                    bn.SortKey,
                    Label = bn.Beat.Title ?? bn.Beat.Description ?? "",
                })
                .ToListAsync();

            var beatIds = beats.Select(b => b.BeatId).ToList();

            var decisions = await db.BeatBlueprintDecisions.AsNoTracking()
                .Where(d => beatIds.Contains(d.BeatId))
                .Select(d => new { d.BeatId, d.DeclaredPurpose })
                .ToDictionaryAsync(d => d.BeatId, d => d.DeclaredPurpose);

            var verifications = await db.BeatVerifications.AsNoTracking()
                .Where(v => beatIds.Contains(v.BeatId))
                .ToListAsync();

            var verifByBeat = verifications
                .GroupBy(v => v.BeatId)
                .ToDictionary(g => g.Key, g => g.ToDictionary(v => v.CheckType, v => v));

            beatRows = beats.Select(b =>
            {
                var checks = new Dictionary<string, VerifResult>();
                if (verifByBeat.TryGetValue(b.BeatId, out var bv))
                {
                    foreach (var kv in bv)
                        checks[kv.Key] = new VerifResult(kv.Value.Result, kv.Value.Severity, kv.Value.Evidence);
                }
                decisions.TryGetValue(b.BeatId, out var purpose);
                return new BeatRow(b.BeatId, b.SortKey, b.Label, purpose, checks);
            }).ToList();

            // Build summary from loaded data (no re-run)
            var allV = verifications;
            summary = new BookVerificationSummary(
                NodeId:       storyNode.Id,
                Slug:         selectedSlug,
                BeatsChecked: beats.Count,
                Blockers:     allV.Count(v => v.Result == "Fail" && v.Severity == "BLOCKER"),
                Moderates:    allV.Count(v => v.Result == "Fail" && v.Severity == "MODERATE"),
                Minors:       allV.Count(v => v.Result == "Fail" && v.Severity == "MINOR"),
                Passed:       allV.Count(v => v.Result == "Pass"),
                Skipped:      allV.Count(v => v.Result == "Skipped"),
                Findings:     allV.Where(v => v.Result == "Fail")
                                  .Select(v => new BeatVerificationResult(
                                      BeatId:    v.BeatId,
                                      CheckType: v.CheckType,
                                      Result:    v.Result,
                                      Severity:  v.Severity,
                                      Evidence:  v.Evidence))
                                  .ToList());
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    async Task RunVerify()
    {
        if (string.IsNullOrEmpty(selectedSlug) || running) return;
        running = true; error = null; summary = null; beatRows.Clear();
        StateHasChanged();
        try
        {
            summary = await VerifySvc.VerifyBookAsync(selectedSlug);
            await LoadVerificationResults();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { running = false; }
    }

    void ToggleRow(Guid beatId)
        => expandedBeat = expandedBeat == beatId ? null : beatId;

    static string ResultClass(string result, string severity) => result switch
    {
        "Pass"    => "tt-chip-pass",
        "Partial" => "tt-chip-partial",
        "Skipped" => "tt-chip-skip",
        "Fail"    => severity == "BLOCKER" ? "tt-chip-fail-bl" : "tt-chip-fail-mo",
        _         => "tt-chip-skip",
    };

    static string ResultIcon(string result) => result switch
    {
        "Pass"    => "✓",
        "Partial" => "~",
        "Skipped" => "–",
        "Fail"    => "✗",
        _         => "?",
    };
}
