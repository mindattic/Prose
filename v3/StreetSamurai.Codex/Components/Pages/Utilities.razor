@page "/utilities"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@inject FixPhiService FixPhi
@inject FixIdentityCorruptionService FixIdentity
@inject TagNormalizerService TagNormalizer
@inject TagWeaponLethalityService TagLethality
@inject AssignTiersService AssignTiers
@inject CrossReferenceService CrossRef
@inject ScriptRunnerService ScriptRunner
@inject IJSRuntime JS
@implements IDisposable

<div class="d-flex justify-content-between align-items-center mb-1">
    <h4 class="text-danger mb-0">Utilities</h4>
    <small class="text-muted">Admin-only maintenance tools. Changes write directly to entity JSON files.</small>
</div>
<p class="text-muted mb-4">All utilities run inside the app with full entity index access, live progress, and cancel support.</p>

@* ── Section: World Integrity ──────────────────────────────────────── *@
<h6 class="text-secondary text-uppercase mb-3" style="font-size:.7rem;letter-spacing:.1em;">World Integrity</h6>
<div class="row g-3 mb-4">

    @* Fix Phi *@
    <div class="col-lg-6">
        <div class="card bg-dark border-secondary h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="text-light fw-semibold"><i class="bi bi-currency-exchange me-2 text-warning"></i>Fix Φ / Quanta</span>
                <small class="text-muted">Replaces word-form "Phi"/"phi" with "Quanta"/"quanta"</small>
            </div>
            <div class="card-body d-flex flex-column">
                <p class="text-muted small mb-3">Enforces the world rule that the currency is Φ (Quanta). Finds all prose occurrences of the word "Phi" or "phi" (not the symbol) and replaces them. Safe to re-run.</p>
                <div class="mt-auto">
                    @UtilityControls("phi", phiRunning, phiResult, phiError, RunFixPhi, () => phiCts?.Cancel(), ClearPhi)
                    @ProgressBar(phiProgress, phiRunning)
                    @ResultBadge(phiResult, phiError)
                </div>
            </div>
        </div>
    </div>

    @* Fix Identity Corruption *@
    <div class="col-lg-6">
        <div class="card bg-dark border-secondary h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="text-light fw-semibold"><i class="bi bi-bandaid me-2 text-danger"></i>Fix Identity Corruption</span>
                <small class="text-muted">Strips wiki markup from name/title/aliases</small>
            </div>
            <div class="card-body d-flex flex-column">
                <p class="text-muted small mb-3">Removes <code>[[Name|id]]</code> wiki syntax that leaked into identity fields (name, title, aliases, codename, etc.) during a wiki scan. Extracts the display text and leaves clean strings.</p>
                <div class="mt-auto">
                    @UtilityControls("idfix", idRunning, idResult, idError, RunFixIdentity, () => idCts?.Cancel(), ClearId)
                    @ProgressBar(idProgress, idRunning)
                    @ResultBadge(idResult, idError)
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Section: Tags & Metadata ──────────────────────────────────────── *@
<h6 class="text-secondary text-uppercase mb-3" style="font-size:.7rem;letter-spacing:.1em;">Tags &amp; Metadata</h6>
<div class="row g-3 mb-4">

    @* Tag Normalizer *@
    <div class="col-lg-6">
        <div class="card bg-dark border-secondary h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="text-light fw-semibold"><i class="bi bi-tags me-2 text-info"></i>Normalize Tags</span>
                <small class="text-muted">Lowercase, deduplicate, validate keywords</small>
            </div>
            <div class="card-body d-flex flex-column">
                <p class="text-muted small mb-3">Three passes: (1) add "person"/"synthetic" category tags, (2) lowercase and deduplicate all tags, (3) remove tags whose required keywords are absent from entity text. Removes noise tags added incorrectly.</p>
                <div class="mb-2 d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="tnCat" @bind="tnAddCategory" disabled="@tnRunning" />
                        <label class="form-check-label text-muted small" for="tnCat">Add category tags</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="tnKw" @bind="tnValidateKeywords" disabled="@tnRunning" />
                        <label class="form-check-label text-muted small" for="tnKw">Validate keywords</label>
                    </div>
                </div>
                <div class="mt-auto">
                    @UtilityControls("tn", tnRunning, tnResult, tnError, RunTagNormalizer, () => tnCts?.Cancel(), ClearTn)
                    @ProgressBar(tnProgress, tnRunning)
                    @ResultBadge(tnResult, tnError)
                </div>
            </div>
        </div>
    </div>

    @* Tag Weapon Lethality *@
    <div class="col-lg-6">
        <div class="card bg-dark border-secondary h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="text-light fw-semibold"><i class="bi bi-exclamation-diamond me-2 text-danger"></i>Tag Weapon Lethality</span>
                <small class="text-muted">Assigns lethal / less_lethal / non_lethal</small>
            </div>
            <div class="card-body d-flex flex-column">
                <p class="text-muted small mb-3">Classifies every weapon and ammunition entity with a lethality tag. Uses category defaults then keyword overrides. Skips weapons that already have a lethality tag unless overwrite is enabled.</p>
                <div class="mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="tlOver" @bind="tlOverwrite" disabled="@tlRunning" />
                        <label class="form-check-label text-muted small" for="tlOver">Overwrite existing lethality tags</label>
                    </div>
                </div>
                <div class="mt-auto">
                    @UtilityControls("tl", tlRunning, tlResult, tlError, RunTagLethality, () => tlCts?.Cancel(), ClearTl)
                    @ProgressBar(tlProgress, tlRunning)
                    @ResultBadge(tlResult, tlError)
                </div>
            </div>
        </div>
    </div>

    @* Assign Tiers *@
    <div class="col-lg-6">
        <div class="card bg-dark border-secondary h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="text-light fw-semibold"><i class="bi bi-bar-chart-steps me-2 text-success"></i>Assign Character Tiers</span>
                <small class="text-muted">Infers social tier 1–5 from role keywords</small>
            </div>
            <div class="card-body d-flex flex-column">
                <p class="text-muted small mb-3">Sets the <code>tier</code> field (1 = survival margin, 5 = power elite) on people and synthetics using keyword matching on role, description, affiliation, and tags. Skips entities that already have a tier.</p>
                <div class="mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="atOver" @bind="atOverwrite" disabled="@atRunning" />
                        <label class="form-check-label text-muted small" for="atOver">Overwrite existing tiers</label>
                    </div>
                </div>
                <div class="mt-auto">
                    @UtilityControls("at", atRunning, atResult, atError, RunAssignTiers, () => atCts?.Cancel(), ClearAt)
                    @ProgressBar(atProgress, atRunning)
                    @ResultBadge(atResult, atError)
                </div>
            </div>
        </div>
    </div>

    @* Cross Reference *@
    <div class="col-lg-6">
        <div class="card bg-dark border-secondary h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="text-light fw-semibold"><i class="bi bi-diagram-3 me-2 text-primary"></i>Build Cross-References</span>
                <small class="text-muted">Populates related_entities[] from entity text</small>
            </div>
            <div class="card-body d-flex flex-column">
                <p class="text-muted small mb-3">Scans prose fields for entity name mentions and writes matching IDs to a <code>related_entities</code> array. Complements wiki links — this field is used by the graph and story engine. Self-references are excluded.</p>
                <div class="mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="crClear" @bind="crClearFirst" disabled="@crRunning" />
                        <label class="form-check-label text-muted small" for="crClear">Clear existing related_entities first</label>
                    </div>
                </div>
                <div class="mt-auto">
                    @UtilityControls("cr", crRunning, crResult, crError, RunCrossRef, () => crCts?.Cancel(), ClearCr)
                    @ProgressBar(crProgress, crRunning)
                    @ResultBadge(crResult, crError)
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Section: Script Runner ────────────────────────────────────────── *@
<h6 class="text-secondary text-uppercase mb-3" style="font-size:.7rem;letter-spacing:.1em;">Script Runner</h6>
<div class="card bg-dark border-secondary mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="text-light fw-semibold"><i class="bi bi-terminal me-2 text-warning"></i>Script Runner</span>
        <small class="text-muted">Run any <code>.py</code> or <code>.js</code> script with live output</small>
    </div>
    <div class="card-body">
        <div class="row g-3 mb-3">
            <div class="col-md-5">
                <label class="form-label text-muted small mb-1">Script</label>
                <select class="form-select form-select-sm bg-dark text-light border-secondary"
                        @bind="selectedScriptPath" disabled="@scriptRunning">
                    <option value="">-- Select a script --</option>
                    @foreach (var s in allScripts.OrderBy(s => s.Name))
                    {
                        <option value="@s.FullPath">@s.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label text-muted small mb-1">Arguments</label>
                <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                       placeholder="e.g. --dry-run --repo people"
                       @bind="scriptArgs" disabled="@scriptRunning" />
            </div>
            <div class="col-md-2 d-flex align-items-end gap-2">
                @if (!scriptRunning)
                {
                    <button class="btn btn-sm btn-warning w-100" @onclick="RunScript" disabled="@string.IsNullOrEmpty(selectedScriptPath)">
                        <i class="bi bi-play-fill me-1"></i>Run
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-danger w-100" @onclick="() => scriptCts?.Cancel()">
                        <i class="bi bi-stop-fill me-1"></i>Kill
                    </button>
                }
            </div>
        </div>

        @if (selectedScript is { } sel)
        {
            <div class="border border-secondary rounded p-2 mb-3 bg-black" style="font-size:.8rem;">
                @if (!string.IsNullOrEmpty(sel.Description))
                {
                    <p class="text-light mb-2"><i class="bi bi-info-circle me-1 text-info"></i>@sel.Description</p>
                }
                @if (sel.Args.Count > 0)
                {
                    <table class="table table-sm table-dark mb-0" style="font-size:.75rem;">
                        <thead>
                            <tr>
                                <th class="text-secondary fw-normal" style="width:30%;">Flag</th>
                                <th class="text-secondary fw-normal">Description</th>
                                <th class="text-secondary fw-normal text-end" style="width:12%;">Default</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var arg in sel.Args)
                            {
                                <tr>
                                    <td><code class="text-warning">@arg.Flag</code></td>
                                    <td class="text-muted">@arg.Desc</td>
                                    <td class="text-end text-muted">@(arg.Default ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <span class="text-muted" style="font-size:.75rem;">No arguments documented.</span>
                }
            </div>
        }

        @if (scriptRunning || scriptLines.Count > 0)
        {
            <div class="d-flex gap-3 mb-2 align-items-center">
                @if (scriptRunning)
                {
                    <span class="badge bg-warning text-dark"><i class="bi bi-circle-fill me-1" style="font-size:.5em;vertical-align:middle;"></i>Running</span>
                }
                else if (scriptExitCode.HasValue)
                {
                    <span class="badge @(scriptExitCode == 0 ? "bg-success" : "bg-danger")">
                        Exit @scriptExitCode — @(scriptElapsed?.ToString(@"mm\:ss") ?? "")
                    </span>
                }
                <small class="text-muted">@scriptLines.Count lines</small>
                <button class="btn btn-outline-secondary btn-sm ms-auto" style="font-size:.7rem;padding:1px 8px;"
                        @onclick="ClearScript"><i class="bi bi-x"></i> Clear</button>
            </div>
            <pre id="script-terminal" class="p-2 rounded small mb-0"
                 style="background:#0d0d0d;color:#d4d4d4;max-height:480px;overflow-y:auto;font-family:'Cascadia Code','Consolas',monospace;font-size:.78rem;line-height:1.45;white-space:pre-wrap;word-break:break-all;">@foreach (var line in scriptLines)
{<span class="@(line.IsError ? "text-danger" : "")">@line.Text</span><br/>}</pre>
        }
    </div>
</div>

@* ── Shared render fragments ────────────────────────────────────────── *@
@code {
    private RenderFragment UtilityControls(string id, bool running, UtilityResult? result, string? error,
        Func<Task> runFn, Action cancelFn, Action clearFn) => __builder =>
    {
        if (!running)
        {
            <button class="btn btn-sm btn-outline-light me-2" @onclick="runFn">
                <i class="bi bi-play-fill me-1"></i>Run
            </button>
        }
        else
        {
            <button class="btn btn-sm btn-outline-danger me-2" @onclick="cancelFn">
                <i class="bi bi-stop-fill me-1"></i>Cancel
            </button>
        }
        @if (result != null || error != null)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="clearFn">
                <i class="bi bi-x me-1"></i>Clear
            </button>
        }
    };

    private RenderFragment ProgressBar(UtilityProgress? prog, bool running) => __builder =>
    {
        if (prog == null && !running) return;
        var pct = prog is { TotalFiles: > 0 } p ? (int)(p.FilesScanned * 100.0 / p.TotalFiles) : 0;
        <div class="mt-2 mb-1">
            <div class="progress bg-secondary" style="height:4px;">
                <div class="progress-bar @(running ? "progress-bar-animated progress-bar-striped" : "") bg-info" style="width:@pct%"></div>
            </div>
            <div class="d-flex justify-content-between mt-1">
                <small class="text-muted">@(prog?.FilesScanned.ToString("N0") ?? "0") / @(prog?.TotalFiles.ToString("N0") ?? "…") files</small>
                <small class="text-muted">@(prog?.ChangesApplied.ToString("N0") ?? "0") changes</small>
            </div>
        </div>
    };

    private RenderFragment ResultBadge(UtilityResult? result, string? error) => __builder =>
    {
        @if (result != null)
        {
            <div class="alert alert-secondary mt-2 mb-0 py-1 px-2 small">
                <i class="bi bi-check-circle text-success me-1"></i>
                @result.FilesScanned.ToString("N0") scanned — @result.FilesModified.ToString("N0") modified — @result.ChangesApplied.ToString("N0") changes
                @if (result.Warnings is { Count: > 0 })
                { <span class="text-warning ms-2">@result.Warnings.Count warning(s)</span> }
            </div>
        }
        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger mt-2 mb-0 py-1 px-2 small"><i class="bi bi-exclamation-triangle me-1"></i>@error</div>
        }
    };

    // ── Helper ─────────────────────────────────────────────────────
    private async Task<UtilityResult?> RunUtility(
        Func<IProgress<UtilityProgress>, CancellationToken, Task<UtilityResult>> fn,
        Action<bool> setRunning, Action<UtilityProgress> setProgress,
        Action<UtilityResult?> setResult, Action<string?> setError,
        CancellationTokenSource cts)
    {
        setRunning(true); setResult(null); setError(null);
        UtilityResult? result = null;
        try
        {
            var prog = new Progress<UtilityProgress>(p => { setProgress(p); InvokeAsync(StateHasChanged); });
            result = await fn(prog, cts.Token);
        }
        catch (OperationCanceledException) { setError("Cancelled."); }
        catch (Exception ex)               { setError(ex.Message); }
        finally { setRunning(false); setResult(result); StateHasChanged(); }
        return result;
    }
}

@code {
    // ── Fix Phi ───────────────────────────────────────────────────
    private bool phiRunning; private UtilityProgress? phiProgress; private UtilityResult? phiResult; private string? phiError; private CancellationTokenSource? phiCts;
    private Task RunFixPhi()  { phiCts = new(); return RunUtility((p, c) => FixPhi.RunAsync(p, 4, c), v => phiRunning = v, p => phiProgress = p, r => phiResult = r, e => phiError = e, phiCts); }
    private void ClearPhi()   { phiResult = null; phiProgress = null; phiError = null; }

    // ── Fix Identity ──────────────────────────────────────────────
    private bool idRunning; private UtilityProgress? idProgress; private UtilityResult? idResult; private string? idError; private CancellationTokenSource? idCts;
    private Task RunFixIdentity() { idCts = new(); return RunUtility((p, c) => FixIdentity.RunAsync(p, 4, c), v => idRunning = v, p => idProgress = p, r => idResult = r, e => idError = e, idCts); }
    private void ClearId()    { idResult = null; idProgress = null; idError = null; }

    // ── Tag Normalizer ────────────────────────────────────────────
    private bool tnRunning; private UtilityProgress? tnProgress; private UtilityResult? tnResult; private string? tnError; private CancellationTokenSource? tnCts;
    private bool tnAddCategory = true; private bool tnValidateKeywords = true;
    private Task RunTagNormalizer() { tnCts = new(); return RunUtility((p, c) => TagNormalizer.RunAsync(new TagNormalizerService.Options(tnAddCategory, tnValidateKeywords), p, 4, c), v => tnRunning = v, p => tnProgress = p, r => tnResult = r, e => tnError = e, tnCts); }
    private void ClearTn()    { tnResult = null; tnProgress = null; tnError = null; }

    // ── Tag Lethality ─────────────────────────────────────────────
    private bool tlRunning; private UtilityProgress? tlProgress; private UtilityResult? tlResult; private string? tlError; private CancellationTokenSource? tlCts;
    private bool tlOverwrite;
    private Task RunTagLethality() { tlCts = new(); return RunUtility((p, c) => TagLethality.RunAsync(tlOverwrite, p, 4, c), v => tlRunning = v, p => tlProgress = p, r => tlResult = r, e => tlError = e, tlCts); }
    private void ClearTl()    { tlResult = null; tlProgress = null; tlError = null; }

    // ── Assign Tiers ──────────────────────────────────────────────
    private bool atRunning; private UtilityProgress? atProgress; private UtilityResult? atResult; private string? atError; private CancellationTokenSource? atCts;
    private bool atOverwrite;
    private Task RunAssignTiers() { atCts = new(); return RunUtility((p, c) => AssignTiers.RunAsync(atOverwrite, p, 4, c), v => atRunning = v, p => atProgress = p, r => atResult = r, e => atError = e, atCts); }
    private void ClearAt()    { atResult = null; atProgress = null; atError = null; }

    // ── Cross Reference ───────────────────────────────────────────
    private bool crRunning; private UtilityProgress? crProgress; private UtilityResult? crResult; private string? crError; private CancellationTokenSource? crCts;
    private bool crClearFirst = true;
    private Task RunCrossRef() { crCts = new(); return RunUtility((p, c) => CrossRef.RunAsync(crClearFirst, p, 4, c), v => crRunning = v, p => crProgress = p, r => crResult = r, e => crError = e, crCts); }
    private void ClearCr()    { crResult = null; crProgress = null; crError = null; }

    // ── Script Runner ─────────────────────────────────────────────
    private IReadOnlyList<ScriptInfo> allScripts = [];
    private string selectedScriptPath = "";
    private string scriptArgs = "";
    private bool scriptRunning; private int? scriptExitCode; private TimeSpan? scriptElapsed;
    private CancellationTokenSource? scriptCts;
    private readonly List<ScriptOutputLine> scriptLines = [];
    private const int MaxTerminalLines = 2000;

    private ScriptInfo? selectedScript => allScripts.FirstOrDefault(s => s.FullPath == selectedScriptPath);

    protected override void OnInitialized() => allScripts = ScriptRunner.GetAllScripts();

    private async Task RunScript()
    {
        if (selectedScript == null) return;
        scriptRunning = true; scriptExitCode = null; scriptElapsed = null; scriptLines.Clear();
        scriptCts = new CancellationTokenSource();
        var started = DateTime.Now;
        var prog = new Progress<ScriptOutputLine>(async line =>
        {
            lock (scriptLines) { scriptLines.Add(line); if (scriptLines.Count > MaxTerminalLines) scriptLines.RemoveAt(0); }
            await InvokeAsync(StateHasChanged);
            try { await JS.InvokeVoidAsync("scrollTerminalToBottom", "script-terminal"); } catch { }
        });
        try   { scriptExitCode = await ScriptRunner.RunAsync(selectedScript, scriptArgs, prog, scriptCts.Token); }
        catch (OperationCanceledException) { scriptLines.Add(new ScriptOutputLine("[killed]", true, DateTime.Now)); }
        catch (Exception ex)               { scriptLines.Add(new ScriptOutputLine($"[error: {ex.Message}]", true, DateTime.Now)); }
        finally { scriptElapsed = DateTime.Now - started; scriptRunning = false; StateHasChanged(); }
    }

    private void ClearScript() { scriptLines.Clear(); scriptExitCode = null; scriptElapsed = null; }

    public void Dispose()
    {
        phiCts?.Dispose(); idCts?.Dispose(); tnCts?.Dispose(); tlCts?.Dispose();
        atCts?.Dispose(); crCts?.Dispose(); scriptCts?.Dispose();
    }
}
