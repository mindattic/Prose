@using Microsoft.EntityFrameworkCore
@using StreetSamurai.Core.Data
@using StreetSamurai.Core.Services
@using StreetSamurai.Shared.Services
@using EpisodeEntity = StreetSamurai.Core.Data.Entities.Episode
@using EpisodeBeatEntity = StreetSamurai.Core.Data.Entities.EpisodeBeat
@inject ChapterRecordingService Recordings
@inject EpisodeAudioService Audio
@inject IDbContextFactory<StreetSamuraiDbContext> DbFactory
@inject ToastNotifier Toast
@implements IDisposable

@*
   Inline narration controls that live on the writer page. The hierarchy on this
   panel — Book → Chapter → Beat — mirrors the on-disk layout one-for-one. Each
   beat is a paragraph; a beat is either unrecorded, in-flight, or ready, and
   each is individually replaceable without disturbing its siblings (the
   pearl-necklace property the user asked for).
*@

<div class="card bg-black border-secondary mb-3">
    <div class="card-header py-2 px-3 d-flex justify-content-between align-items-center">
        <div>
            <i class="bi bi-mic-fill text-info me-2"></i>
            <span class="text-light">Chapter @ChapterPositionLabel — Recording</span>
            @if (recording != null)
            {
                <span class="badge bg-@StatusColor(recording.Status) ms-2 text-uppercase">@recording.Status</span>
                @if (StaleCount > 0)
                {
                    <span class="badge bg-danger ms-2" title="Beats whose prose has drifted past the recorded audio. Combined export skips these — re-record to close the gap.">
                        <i class="bi bi-exclamation-triangle me-1"></i>@StaleCount stale
                    </span>
                }
            }
            else
            {
                <span class="badge bg-secondary ms-2">not recorded</span>
            }
        </div>
        <div class="d-flex gap-2">
            @if (recording == null)
            {
                <button class="btn btn-sm btn-outline-info" @onclick="RecordAsync" disabled="@working">
                    <i class="bi bi-record-circle me-1"></i>Record this chapter
                </button>
            }
            else
            {
                @if (recording.Status == "narrating" || recording.Status == "generating")
                {
                    <button class="btn btn-sm btn-outline-warning" @onclick="StopAsync">
                        <i class="bi bi-stop-circle me-1"></i>Stop
                    </button>
                }
                @if (StaleCount > 0 && recording.Status == "ready")
                {
                    <button class="btn btn-sm btn-warning" @onclick="ReRecordStaleAsync" disabled="@working"
                            title="@($"Re-narrate only the {StaleCount} stale beat(s); existing audio stays.")">
                        <i class="bi bi-arrow-repeat me-1"></i>Re-record stale (@StaleCount)
                    </button>
                }
                <button class="btn btn-sm btn-outline-warning" @onclick="ReRecordAsync" disabled="@working" title="Replaces all audio for this chapter">
                    <i class="bi bi-arrow-repeat me-1"></i>Re-record all
                </button>
                @if (recording.Status == "ready" && !string.IsNullOrEmpty(recording.CombinedAudioPath))
                {
                    @if (StaleCount > 0)
                    {
                        <button class="btn btn-sm btn-outline-secondary" disabled
                                title="@($"{StaleCount} beat(s) need re-recording before the combined audio is complete.")">
                            <i class="bi bi-download me-1"></i>chapter.@DownloadExt (incomplete)
                        </button>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-success" href="@DownloadHref" download>
                            <i class="bi bi-download me-1"></i>chapter.@DownloadExt
                        </a>
                    }
                }
            }
        </div>
    </div>

    @if (recording != null)
    {
        <div class="card-body p-2">
            @if (!string.IsNullOrEmpty(combinedAudioUrl))
            {
                <div class="mb-2 px-2">
                    <div class="text-muted small mb-1">String of pearls — entire chapter</div>
                    <audio controls src="@combinedAudioUrl" class="w-100" style="height:36px;"></audio>
                </div>
            }

            <table class="table table-dark table-sm align-middle mb-0">
                <thead>
                    <tr class="text-muted small">
                        <th style="width:48px;">#</th>
                        <th>Beat (paragraph)</th>
                        <th style="width:80px;">Audio</th>
                        <th style="width:130px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @{ int position = 0; }
                @{
                    // Top-of-list insert: targets afterBeatIndex == -1 in service.
                    <tr class="insert-row">
                        <td colspan="4" class="p-0">
                            <button class="btn btn-sm btn-link text-info py-0 px-2 w-100 text-start"
                                    style="text-decoration:none; opacity:0.55;"
                                    title="Insert a new empty beat at the top"
                                    @onclick="() => InsertBeatAsync(-1)" disabled="@working">
                                <i class="bi bi-plus-circle me-1"></i><span class="small">insert beat</span>
                            </button>
                        </td>
                    </tr>
                }
                @foreach (var beat in recording.Beats.OrderBy(b => b.SortKey))
                {
                    position++;
                    var beatIdx = beat.Index;
                    var preview = beat.Text.Length > 130 ? beat.Text[..130] + "…" : beat.Text;
                    var isEditing = editingBeatIndex == beatIdx;
                    var isFirst = position == 1;
                    <tr>
                        <td class="text-muted">@position</td>
                        <td>
                            @if (isEditing)
                            {
                                <textarea class="form-control form-control-sm bg-black text-light border-secondary"
                                          rows="@Math.Max(2, beat.Text.Length / 100 + 1)"
                                          @bind="editingBeatText"></textarea>
                                <div class="d-flex gap-2 mt-1">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveBeatEditAsync(beatIdx)" disabled="@savingEdit">
                                        <i class="bi bi-check-lg me-1"></i>Save
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelBeatEdit">Cancel</button>
                                </div>
                            }
                            else
                            {
                                <span class="text-light" style="cursor:text;" @onclick="() => StartBeatEdit(beat)">@preview</span>
                                @if (beat.Stale)
                                {
                                    <div class="text-danger small mt-1">
                                        <i class="bi bi-exclamation-triangle me-1"></i>prose drifted past recording — audio invalidated, re-record
                                    </div>
                                }
                                else if (beat.WasCorrected && string.IsNullOrEmpty(beat.AudioPath))
                                {
                                    <div class="text-warning small mt-1">
                                        <i class="bi bi-exclamation-triangle me-1"></i>edited — needs re-narration
                                    </div>
                                }
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(beat.AudioPath))
                            {
                                <audio controls preload="none"
                                       src="@($"/api/episodes/{recording.Id}/audio/{beatIdx}")"
                                       style="height:24px; max-width:80px;"></audio>
                            }
                            else if (recording.Status == "narrating" || recording.Status == "generating")
                            {
                                <span class="spinner-border spinner-border-sm text-muted"></span>
                            }
                            else
                            {
                                <span class="text-muted small">—</span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <button class="btn btn-sm btn-outline-secondary py-0 px-1" title="Edit text (blank lines auto-split into new beats)"
                                        @onclick="() => StartBeatEdit(beat)">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-info py-0 px-1" title="Split this beat at the nearest sentence boundary near the middle"
                                        @onclick="() => SplitBeatAsync(beatIdx)" disabled="@working">
                                    <i class="bi bi-scissors"></i>
                                </button>
                                @if (!isFirst)
                                {
                                    <button class="btn btn-sm btn-outline-info py-0 px-1" title="Merge this beat into the previous one"
                                            @onclick="() => JoinBeatAsync(beatIdx)" disabled="@working">
                                        <i class="bi bi-arrow-up-circle"></i>
                                    </button>
                                }
                                @if (!string.IsNullOrEmpty(beat.AudioPath))
                                {
                                    <button class="btn btn-sm btn-outline-warning py-0 px-1" title="Re-record this beat"
                                            @onclick="() => RerecordBeatAsync(beatIdx)" disabled="@working">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                    <tr class="insert-row">
                        <td colspan="4" class="p-0">
                            <button class="btn btn-sm btn-link text-info py-0 px-2 w-100 text-start"
                                    style="text-decoration:none; opacity:0.55;"
                                    title="Insert a new empty beat below this one (no split needed)"
                                    @onclick="() => InsertBeatAsync(beatIdx)" disabled="@working">
                                <i class="bi bi-plus-circle me-1"></i><span class="small">insert beat</span>
                            </button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public string BookId { get; set; } = "";
    [Parameter] public string ChapterId { get; set; } = "";
    /// <summary>1-based position of this chapter within the book, for the header.</summary>
    [Parameter] public int ChapterNumber { get; set; }

    private EpisodeEntity? recording;
    private bool working;
    private bool savingEdit;
    private int? editingBeatIndex;
    private string editingBeatText = "";
    private System.Threading.Timer? poll;
    private string? lastChapterIdRendered;

    private string ChapterPositionLabel => ChapterNumber > 0 ? ChapterNumber.ToString() : "";

    /// <summary>Count of beats whose audio is stale (prose edited past the
    /// recording). Surfaces in the header as a warning chip and gates the
    /// combined-export Download button — the user shouldn't ship a "chapter"
    /// audio file that's missing paragraphs.</summary>
    private int StaleCount => recording?.Beats?.Count(b => b.Stale) ?? 0;

    private string? combinedAudioUrl =>
        recording is { Status: "ready", CombinedAudioPath: { Length: > 0 } }
            ? $"/api/episodes/{recording.Id}/episode.wav"
            : null;

    private string DownloadExt =>
        recording?.CombinedAudioPath?.EndsWith(".mp3", StringComparison.OrdinalIgnoreCase) == true ? "mp3" : "wav";

    private string DownloadHref =>
        recording == null ? "#" : $"/api/episodes/{recording.Id}/episode.wav";

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(ChapterId)) return;
        if (lastChapterIdRendered == ChapterId) return;
        lastChapterIdRendered = ChapterId;

        await LoadRecordingAsync();
    }

    private async Task LoadRecordingAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        recording = await db.Episodes
            .Include(e => e.Beats)
            .AsNoTracking()
            .FirstOrDefaultAsync(e => e.ChapterId == ChapterId);
        await InvokeAsync(StateHasChanged);

        // If something is in-flight, poll for updates.
        if (recording != null && (recording.Status == "narrating" || recording.Status == "generating"))
            StartPolling();
    }

    private void StartPolling()
    {
        poll?.Dispose();
        poll = new System.Threading.Timer(async _ =>
        {
            await LoadRecordingAsync();
            if (recording == null) return;
            if (recording.Status == "ready" || recording.Status == "failed" || recording.Status == "stopped")
            {
                poll?.Dispose();
                poll = null;
            }
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(3));
    }

    private async Task RecordAsync()
    {
        if (working) return;
        working = true;
        StateHasChanged();
        try
        {
            await Task.Run(() => Recordings.RecordChapterAsync(ChapterId));
            await LoadRecordingAsync();
            StartPolling();
            Toast.Success("REC", "Chapter recording started.");
        }
        catch (Exception ex) { Toast.Error("REC-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task ReRecordAsync()
    {
        if (working) return;
        working = true;
        StateHasChanged();
        try
        {
            await Task.Run(() => Recordings.ReRecordChapterAsync(ChapterId));
            await LoadRecordingAsync();
            StartPolling();
            Toast.Success("RE-REC", "Re-recording started; old audio dropped.");
        }
        catch (Exception ex) { Toast.Error("RE-REC-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task StopAsync()
    {
        if (recording == null) return;
        if (Audio.CancelNarration(recording.Id))
        {
            Toast.Info("STOP", "Narration cancelled. Already-narrated beats stay.");
            await LoadRecordingAsync();
        }
    }

    private void StartBeatEdit(EpisodeBeatEntity beat)
    {
        editingBeatIndex = beat.Index;
        editingBeatText = beat.Text;
    }

    private void CancelBeatEdit()
    {
        editingBeatIndex = null;
        editingBeatText = "";
    }

    private async Task SaveBeatEditAsync(int beatIdx)
    {
        if (recording == null || savingEdit) return;
        savingEdit = true;
        StateHasChanged();
        try
        {
            // Route through ChapterRecordingService so the canon ChapterBeat
            // is updated in lock-step — keeps the writer view in sync with
            // what's in the recording panel, and prevents the next chapter
            // save's desync sweep from clobbering this edit.
            await Recordings.UpdateBeatTextWithCanonSyncAsync(recording.Id, beatIdx, editingBeatText);
            await LoadRecordingAsync();
            editingBeatIndex = null;
            editingBeatText = "";
            Toast.Success("BEAT-EDIT", $"Beat {beatIdx + 1} text updated. Hit ↻ to re-record.");
        }
        catch (Exception ex) { Toast.Error("BEAT-EDIT-FAIL", ex.Message); }
        finally { savingEdit = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task SplitBeatAsync(int beatIdx)
    {
        if (recording == null || working) return;
        working = true;
        StateHasChanged();
        try
        {
            await Audio.SplitBeatAsync(recording.Id, beatIdx);
            await LoadRecordingAsync();
            Toast.Success("BEAT-SPLIT", "Beat split — both halves need re-recording.");
        }
        catch (Exception ex) { Toast.Error("BEAT-SPLIT-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task JoinBeatAsync(int beatIdx)
    {
        if (recording == null || working) return;
        working = true;
        StateHasChanged();
        try
        {
            await Audio.JoinBeatWithPreviousAsync(recording.Id, beatIdx);
            await LoadRecordingAsync();
            Toast.Success("BEAT-JOIN", "Beat merged into the previous one.");
        }
        catch (Exception ex) { Toast.Error("BEAT-JOIN-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task ReRecordStaleAsync()
    {
        if (recording == null || working) return;
        working = true;
        StateHasChanged();
        try
        {
            // Stale beats already have AudioPath=null from the desync sweep,
            // so NarrateAsync's "skip beats that have audio" guard naturally
            // limits the work to just the stale ones. Stitch window is seeded
            // from neighbours' LastRequestId so they sound continuous.
            _ = Task.Run(() => Audio.NarrateAsync(recording.Id));
            await LoadRecordingAsync();
            StartPolling();
            Toast.Success("RE-REC-STALE", $"Re-recording {StaleCount} stale beat(s)…");
        }
        catch (Exception ex) { Toast.Error("RE-REC-STALE-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task InsertBeatAsync(int afterBeatIndex)
    {
        if (recording == null || working) return;
        working = true;
        StateHasChanged();
        try
        {
            var newIndex = await Audio.InsertBeatAfterAsync(recording.Id, afterBeatIndex, "");
            await LoadRecordingAsync();
            // Drop the user straight into editing the new (empty) beat so they
            // can type without an extra "edit" click. Matches the writer's
            // pearl-necklace ergonomic — insert and immediately compose.
            editingBeatIndex = newIndex;
            editingBeatText = "";
            Toast.Success("BEAT-INSERT", afterBeatIndex < 0 ? "New beat inserted at top." : $"New beat inserted after beat {afterBeatIndex + 1}.");
        }
        catch (Exception ex) { Toast.Error("BEAT-INSERT-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task RerecordBeatAsync(int beatIdx)
    {
        if (recording == null || working) return;
        working = true;
        StateHasChanged();
        try
        {
            await Audio.InvalidateBeatAudioAsync(recording.Id, beatIdx);
            _ = Task.Run(() => Audio.NarrateAsync(recording.Id));
            await LoadRecordingAsync();
            StartPolling();
            Toast.Success("BEAT-RE-REC", $"Re-recording beat {beatIdx + 1}…");
        }
        catch (Exception ex) { Toast.Error("BEAT-RE-REC-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    private static string StatusColor(string status) => status switch
    {
        "ready"           => "success",
        "ready_for_audio" => "info",
        "narrating"       => "primary",
        "generating"      => "primary",
        "failed"          => "danger",
        "stopped"         => "warning",
        _                 => "secondary",
    };

    public void Dispose() => poll?.Dispose();
}
