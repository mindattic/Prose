@inject HtmlExportService ExportSvc
@using Microsoft.Extensions.Logging
@inject ILogger<ExportButton> Log

@if (exporting)
{
    <div class="d-inline-flex align-items-center gap-2">
        <svg width="24" height="24" viewBox="0 0 36 36" class="radial-progress">
            <circle cx="18" cy="18" r="15" fill="none" stroke="#30363d" stroke-width="3" />
            <circle cx="18" cy="18" r="15" fill="none" stroke="#dc3545" stroke-width="3"
                    stroke-dasharray="@($"{94.25 * progress / 100:F1}") 94.25"
                    stroke-linecap="round" transform="rotate(-90 18 18)" />
            <text x="18" y="20" text-anchor="middle" fill="#e6edf3" font-size="8">@((int)progress)%</text>
        </svg>
        <small class="text-muted">@statusText</small>
    </div>
}
else if (errorText != null)
{
    <span class="text-danger small">@errorText</span>
}
else
{
    <button class="btn btn-sm @ButtonClass" style="@ExtraStyle" @onclick="DoExport" title="@Title">
        <i class="bi bi-file-earmark-code"></i> @Label
    </button>
}

@code {
    [Parameter] public string Mode { get; set; } = "entry";
    [Parameter] public string RepoName { get; set; } = "";
    [Parameter] public string EntryName { get; set; } = "";
    [Parameter] public string EntryJson { get; set; } = "";
    [Parameter] public Func<List<(string name, string json)>>? GetRepoEntries { get; set; }
    [Parameter] public Func<Dictionary<string, List<(string name, string json)>>>? GetAllRepos { get; set; }
    [Parameter] public string ExtraStyle { get; set; } = "";

    private bool exporting;
    private double progress;
    private string statusText = "";
    private string? errorText;

    private string Label => Mode switch { "entry" => "Export", "repo" => "Export", "all" => "Export All", _ => "Export" };
    private string Title => Mode switch { "entry" => $"Export {EntryName} as .htm", "repo" => $"Export all {RepoName} as .htm", "all" => "Export all repos as .htm", _ => "Export" };
    private string ButtonClass => "btn-outline-info";

    private async Task DoExport()
    {
        exporting = true;
        progress = 0;
        statusText = "Preparing...";
        errorText = null;

        try
        {
            // Gather data on the Blazor sync context (repos aren't thread-safe)
            string? resultPath = null;

            switch (Mode)
            {
                case "entry":
                    statusText = "Exporting entry...";
                    await InvokeAsync(StateHasChanged);
                    resultPath = ExportSvc.ExportEntry(RepoName, EntryName, EntryJson);
                    progress = 100;
                    break;

                case "repo":
                    if (GetRepoEntries != null)
                    {
                        statusText = "Loading entries...";
                        await InvokeAsync(StateHasChanged);
                        var entries = GetRepoEntries();
                        statusText = $"Exporting {entries.Count} entries...";
                        await InvokeAsync(StateHasChanged);

                        // Run the actual file writing on a background thread
                        var capturedEntries = entries;
                        resultPath = await Task.Run(() =>
                            ExportSvc.ExportRepo(RepoName, capturedEntries, (cur, tot) =>
                            {
                                progress = (double)cur / tot * 100;
                                statusText = $"{cur}/{tot}";
                            }));
                    }
                    break;

                case "all":
                    if (GetAllRepos != null)
                    {
                        statusText = "Loading all repos...";
                        await InvokeAsync(StateHasChanged);
                        var repos = GetAllRepos();
                        var totalEntries = repos.Values.Sum(r => r.Count);
                        statusText = $"Exporting {totalEntries} entries across {repos.Count} repos...";
                        await InvokeAsync(StateHasChanged);

                        var capturedRepos = repos;
                        resultPath = await Task.Run(() =>
                            ExportSvc.ExportAll(capturedRepos, (cur, tot) =>
                            {
                                progress = (double)cur / tot * 100;
                                statusText = $"{cur}/{tot}";
                            }));
                    }
                    break;
            }

            progress = 100;
            statusText = resultPath != null ? $"Done! Saved to exports/" : "Nothing to export";
            Log.LogInformation("Export complete: mode={Mode}, path={Path}", Mode, resultPath);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Export failed: mode={Mode}, repo={Repo}", Mode, RepoName);
            errorText = $"Export failed: {ex.Message}";
            exporting = false;
            return;
        }

        await InvokeAsync(StateHasChanged);
        await Task.Delay(2000);
        exporting = false;
        await InvokeAsync(StateHasChanged);
    }
}
