@* Reusable header for entity detail pages. *@
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="entity-detail-header">
    <div class="entity-detail-nav">
        <button class="btn btn-sm btn-outline-secondary" @onclick="GoBack">
            <i class="bi bi-arrow-left"></i>
        </button>
    </div>
    <div class="entity-detail-title-block">
        <div class="entity-detail-type-badge badge-@Type">@TypeLabel</div>
        <h2 class="entity-detail-name">@Name</h2>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <div class="entity-detail-subtitle text-muted">@Subtitle</div>
        }
    </div>
    @if (Tags.Any())
    {
        <div class="entity-detail-tags">
            @foreach (var tag in Tags.Take(10))
            {
                <a href="/search?tag=@Uri.EscapeDataString(tag)" class="entity-tag entity-tag-link">@tag</a>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter, EditorRequired] public string Type { get; set; } = "";
    [Parameter, EditorRequired] public string TypeLabel { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string BackRoute { get; set; } = "/";
    [Parameter] public List<string> Tags { get; set; } = [];

    private async Task GoBack()
    {
        try { await JS.InvokeVoidAsync("history.back"); }
        catch { Nav.NavigateTo(BackRoute); }
    }
}
