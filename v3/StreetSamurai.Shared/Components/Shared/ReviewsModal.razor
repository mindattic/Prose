@namespace StreetSamurai.Shared.Components.Shared

@* Shared, sortable reviews modal. Used for both STRAND full reviews and per-BEAT
   micro-reviews. Caller supplies the already-latest-run-deduped items (one per
   persona) so this component is pure presentation: sort high/low, show the
   reviewer's score + body, and reveal the persona's psychometric profile. *@

@if (Visible)
{
    <div class="rvm-backdrop" @onclick="CloseAsync"></div>
    <div class="rvm-sheet" role="dialog" aria-modal="true">
        <div class="rvm-head">
            <div>
                <h5 class="mb-0 text-light">@Title</h5>
                <span class="text-muted small">@Items.Count reviewer@(Items.Count == 1 ? "" : "s") · most recent run only</span>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleSort" title="Toggle sort order">
                    <i class="bi bi-sort-@(sortDesc ? "down" : "up")"></i>
                    @(sortDesc ? "Highest first" : "Lowest first")
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseAsync" aria-label="Close"><i class="bi bi-x-lg"></i></button>
            </div>
        </div>
        <div class="rvm-body">
            @if (Items.Count == 0)
            {
                <div class="text-muted p-4 text-center">No reviews yet — run <code>/review-strand</code>.</div>
            }
            else
            {
                @foreach (var r in Sorted)
                {
                    var pct = Max > 0 ? r.Score / Max * 100.0 : r.Score;
                    <div class="rvm-row">
                        <div class="d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-@Color(pct) rvm-score">@FormatScore(r.Score)@ScoreSuffix</span>
                                <strong class="text-light">@r.Persona</strong>
                                <span class="text-muted small">@r.Provider</span>
                            </div>
                            @if (!string.IsNullOrEmpty(r.Profile))
                            {
                                <button class="btn btn-sm btn-link p-0 text-info" @onclick="() => Toggle(r)" title="Psychometric profile">
                                    <i class="bi bi-person-badge"></i> @(expanded.Contains(r) ? "hide" : "profile")
                                </button>
                            }
                        </div>
                        @if (expanded.Contains(r) && !string.IsNullOrEmpty(r.Profile))
                        {
                            <div class="rvm-profile">@r.Profile</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(r.Body))
                        {
                            <div class="rvm-text">@r.Body</div>
                        }
                    </div>
                }
            }
        </div>
    </div>
}

@code {
    /// <summary>One deduped reviewer row. Score is raw (0-100 for strands, 1-5 for beat
    /// micro-scores); set <see cref="Max"/> to colour-normalize. Profile is the persona's
    /// psychometric summary line (null = no profile).</summary>
    public sealed record Item(string Persona, string Provider, double Score, string Body, string? Profile);

    [Parameter] public bool Visible { get; set; }
    [Parameter] public string Title { get; set; } = "Reviews";
    [Parameter] public IReadOnlyList<Item> Items { get; set; } = Array.Empty<Item>();
    [Parameter] public double Max { get; set; } = 100;
    [Parameter] public string ScoreSuffix { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }

    private bool sortDesc = true;
    private readonly HashSet<Item> expanded = new();

    private IEnumerable<Item> Sorted => sortDesc ? Items.OrderByDescending(i => i.Score) : Items.OrderBy(i => i.Score);

    private void ToggleSort() => sortDesc = !sortDesc;
    private void Toggle(Item i) { if (!expanded.Add(i)) expanded.Remove(i); }
    private async Task CloseAsync() { expanded.Clear(); await OnClose.InvokeAsync(); }

    private static string FormatScore(double s) => s % 1 == 0 ? s.ToString("0") : s.ToString("0.0");
    private static string Color(double pct) => pct >= 80 ? "success" : pct >= 60 ? "info" : pct >= 40 ? "warning" : "danger";
}

<style>
    .rvm-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 1050; }
    .rvm-sheet { position: fixed; top: 0; right: 0; bottom: 0; width: min(560px, 96vw); background: #121212; border-left: 1px solid #2a2a2a; z-index: 1051; display: flex; flex-direction: column; box-shadow: -8px 0 28px rgba(0,0,0,0.5); }
    .rvm-head { display: flex; align-items: center; justify-content: space-between; padding: 0.9rem 1rem; border-bottom: 1px solid #2a2a2a; }
    .rvm-body { overflow-y: auto; padding: 0.5rem 0.75rem 2rem; }
    .rvm-row { padding: 0.7rem 0.5rem; border-bottom: 1px solid #1f1f1f; }
    .rvm-score { font-variant-numeric: tabular-nums; }
    .rvm-profile { margin-top: 0.4rem; font-size: 0.78rem; color: #5bc0de; font-family: ui-monospace, monospace; }
    .rvm-text { margin-top: 0.45rem; color: #ced4da; font-size: 0.88rem; white-space: pre-wrap; line-height: 1.4; }
</style>
