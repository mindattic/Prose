@using StreetSamurai.Core.Interfaces
@inject IJSRuntime JS
@inject IAudioFileService AudioFiles

@if (Visible)
{
    <div class="audio-player bg-dark border border-secondary rounded @CssClass">
        @if (audioUrl != null)
        {
            <audio id="@audioId" src="@audioUrl" preload="auto"
                   @onended="OnEnded" @ontimeupdate="OnTimeUpdate"></audio>
        }

        @* ── Error (inline) ────────────────────────── *@
        @if (errorMessage != null)
        {
            <div class="d-flex align-items-center gap-2 px-3 py-1" style="font-size: 0.75rem;">
                <i class="bi bi-exclamation-triangle text-warning"></i>
                <small class="text-warning">@errorMessage</small>
                <button class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick='() => errorMessage = null' style="font-size: 0.65rem;"><i class="bi bi-x"></i></button>
            </div>
        }

        @* ── Controls row (centered) ───────────────── *@
        <div class="d-flex align-items-center justify-content-center gap-2 py-1">
            @* Read Selected / Read All *@
            <button class="btn btn-sm btn-outline-info px-2" @onclick="OnReadSelected" disabled="@loading" title="Narrate selected text (select 3+ words)" style="height: 32px; font-size: 0.75rem; line-height: 24px;">
                <i class="bi bi-text-indent-left"></i><div class="btn-lbl"> Selected</div>
            </button>
            <button class="btn btn-sm btn-outline-info px-2" @onclick="OnReadAll" disabled="@loading" title="Narrate entire document" style="height: 32px; font-size: 0.75rem; line-height: 24px;">
                <i class="bi bi-megaphone"></i><div class="btn-lbl"> All</div>
            </button>

            @* Rewind *@
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Seek(-10)" disabled="@(audioUrl == null)" title="Back 10s" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                <i class="bi bi-skip-backward-fill"></i>
            </button>

            @* Play / Pause *@
            <button class="btn btn-sm @(playing ? "btn-danger" : "btn-outline-danger")" @onclick="TogglePlayback" disabled="@(audioUrl == null)" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                @if (loading) { <span class="spinner-border spinner-border-sm"></span> }
                else { <i class="bi @(playing ? "bi-pause-fill" : "bi-play-fill")"></i> }
            </button>

            @* Stop *@
            <button class="btn btn-sm btn-outline-secondary" @onclick="Stop" disabled="@(audioUrl == null)" title="Stop" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                <i class="bi bi-stop-fill"></i>
            </button>

            @* Forward *@
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Seek(10)" disabled="@(audioUrl == null)" title="Forward 10s" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                <i class="bi bi-skip-forward-fill"></i>
            </button>

            @* Time *@
            <small class="text-muted" style="font-variant-numeric: tabular-nums; line-height: 32px;">
                @FormatTime(currentTime) / @FormatTime(duration)
            </small>

            @* Save + Dismiss *@
            <button class="btn btn-sm btn-outline-secondary" @onclick="SaveAudio" disabled="@(saving || audioData == null)" title="Save" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                <i class="bi @(saving ? "bi-hourglass-split" : "bi-download")"></i>
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="Dismiss" title="Close" style="width: 32px; height: 32px; padding: 0; display: inline-flex; align-items: center; justify-content: center;">
                <i class="bi bi-x"></i>
            </button>
        </div>

        @* ── Progress bar (full width, bottom edge) ── *@
        <div id="@progressId" style="cursor: pointer; padding: 0; margin: 0 -1px -1px -1px;" @onclick="OnProgressClick">
            <div style="height: 4px; background: #30363d;">
                <div style="height: 4px; background: #dc3545; width: @(duration > 0 ? (currentTime / duration * 100) : 0)%; transition: width 0.1s linear;"></div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public EventCallback OnDismissed { get; set; }
    [Parameter] public EventCallback<string> OnInsertTag { get; set; }
    [Parameter] public EventCallback OnReadSelected { get; set; }
    [Parameter] public EventCallback OnReadAll { get; set; }
    [Parameter] public bool HasSelection { get; set; }
    [Parameter] public bool ShowTagInserter { get; set; } = true;
    [Parameter] public string Engine { get; set; } = "elevenlabs";
    [Parameter] public EventCallback<string> EngineChanged { get; set; }

    private async Task OnEngineChanged() => await EngineChanged.InvokeAsync(Engine);

    private string audioId = $"audio-{Guid.CreateVersion7():N}";
    private string progressId = $"progress-{Guid.CreateVersion7():N}";
    private string? audioUrl;
    private byte[]? audioData;
    private bool loading;
    private bool playing;
    private bool saving;
    private string? savedPath;
    private string? errorMessage;
    private double currentTime;
    private double duration;

    public async Task LoadAudioAsync(byte[] audioData)
    {
        loading = true;
        playing = false;
        errorMessage = null;
        audioUrl = null;
        this.audioData = audioData;
        savedPath = null;
        currentTime = 0;
        duration = 0;
        StateHasChanged();

        try
        {
            var base64 = Convert.ToBase64String(audioData);
            audioUrl = $"data:audio/mpeg;base64,{base64}";
            loading = false;
            StateHasChanged();

            await Task.Delay(200);
            duration = await JS.InvokeAsync<double>("eval",
                $"(function(){{ var a=document.getElementById('{audioId}'); return a ? a.duration || 0 : 0; }})()");
            await PlayAsync();
        }
        catch (Exception ex)
        {
            loading = false;
            errorMessage = ex.Message;
            StateHasChanged();
        }
    }

    public void SetLoading(bool loading)
    {
        this.loading = loading;
        if (loading) { playing = false; currentTime = 0; duration = 0; }
        StateHasChanged();
    }

    public void SetError(string message)
    {
        loading = false;
        errorMessage = message;
        StateHasChanged();
    }

    private async Task PlayAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", $"document.getElementById('{audioId}')?.play()");
            playing = true;
        }
        catch { }
    }

    private async Task TogglePlayback()
    {
        if (playing)
        {
            await JS.InvokeVoidAsync("eval", $"document.getElementById('{audioId}')?.pause()");
            playing = false;
        }
        else
            await PlayAsync();
    }

    private async Task Stop()
    {
        await JS.InvokeVoidAsync("eval",
            $"(function(){{ var a=document.getElementById('{audioId}'); if(a){{ a.pause(); a.currentTime=0; }} }})()");
        playing = false;
        currentTime = 0;
    }

    private async Task Seek(double seconds)
    {
        await JS.InvokeVoidAsync("eval",
            $"(function(){{ var a=document.getElementById('{audioId}'); if(a) a.currentTime=Math.max(0,Math.min(a.duration||0,a.currentTime+({seconds}))); }})()");
    }

    private async Task OnProgressClick(MouseEventArgs e)
    {
        if (duration <= 0) return;
        var fraction = await JS.InvokeAsync<double>("eval",
            $"(function(){{ var el=document.getElementById('{progressId}'); if(!el) return 0; var r=el.getBoundingClientRect(); return Math.max(0,Math.min(1,({e.ClientX}-r.left)/r.width)); }})()");
        var newTime = fraction * duration;
        await JS.InvokeVoidAsync("eval",
            $"(function(){{ var a=document.getElementById('{audioId}'); if(a) a.currentTime={newTime}; }})()");
        currentTime = newTime;
    }

    private async Task OnTimeUpdate()
    {
        try
        {
            var vals = await JS.InvokeAsync<double[]>("eval",
                $"(function(){{ var a=document.getElementById('{audioId}'); return a ? [a.currentTime, a.duration||0] : [0,0]; }})()");
            currentTime = vals[0];
            if (vals[1] > 0) duration = vals[1];
        }
        catch { }
    }

    private void OnEnded() { playing = false; StateHasChanged(); }

    private async Task SaveAudio()
    {
        if (audioData == null || saving) return;
        saving = true; StateHasChanged();
        try { savedPath = await AudioFiles.SaveAudioAsync(audioData); }
        catch (Exception ex) { errorMessage = $"Save failed: {ex.Message}"; }
        finally { saving = false; StateHasChanged(); }
    }

    private void OpenInExplorer() { if (savedPath != null) AudioFiles.RevealInExplorer(savedPath); }

    private async Task Dismiss()
    {
        if (playing)
            await JS.InvokeVoidAsync("eval", $"(function(){{ var a=document.getElementById('{audioId}'); if(a) a.pause(); }})()");
        audioUrl = null; audioData = null; playing = false; loading = false;
        saving = false; savedPath = null; errorMessage = null;
        currentTime = 0; duration = 0; Visible = false;
        await OnDismissed.InvokeAsync();
    }

    private static string FormatTime(double seconds)
    {
        if (double.IsNaN(seconds) || seconds < 0) seconds = 0;
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.Hours > 0 ? $"{ts.Hours}:{ts.Minutes:D2}:{ts.Seconds:D2}" : $"{ts.Minutes}:{ts.Seconds:D2}";
    }
}
