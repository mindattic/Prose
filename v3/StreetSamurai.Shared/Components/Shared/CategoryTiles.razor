@inject CharacterRepository CharRepo
@inject SyntheticLifeRepository SynthRepo
@inject ArchetypeRepository ArchetypeRepo
@inject CorponationRepository CorpRepo
@inject SubsidiaryRepository SubsidiaryRepo
@inject FactionRepository FactionRepo
@inject WeaponryRepository WeaponRepo
@inject AmmunitionRepository AmmoRepo
@inject CyberwareRepository CyberRepo
@inject EquipmentRepository EquipRepo
@inject ApparelRepository ApparelRepo
@inject GenemodRepository GenemodRepo
@inject PharmaceuticalRepository PharmaRepo
@inject DistrictRepository DistrictRepo
@inject TransportationRepository TransportRepo
@inject MaterialRepository MaterialRepo
@inject TechnologyRepository TechRepo
@inject AutomatonRepository AutomatonRepo
@inject WorldbuildingDocRepository DocRepo
@inject QuoteRepository QuoteRepo
@inject VocabularyRepository VocabRepo
@inject NewsRepository NewsRepo
@inject EntertainmentRepository EntertainmentRepo
@inject ConsumerGoodRepository GoodsRepo
@inject ContractRepository ContractRepo

<div class="board-grid">
    <a href="/board/characters" class="board-tile">
        <i class="bi bi-people-fill board-tile-icon"></i>
        <div class="board-tile-name">Characters</div>
        <span class="board-tile-count">@(charCount)</span>
    </a>
    <a href="/board/organizations" class="board-tile">
        <i class="bi bi-buildings board-tile-icon"></i>
        <div class="board-tile-name">Organizations</div>
        <span class="board-tile-count">@(orgCount)</span>
    </a>
    <a href="/board/gear" class="board-tile">
        <i class="bi bi-tools board-tile-icon"></i>
        <div class="board-tile-name">Gear</div>
        <span class="board-tile-count">@(gearCount)</span>
    </a>
    <a href="/board/world" class="board-tile">
        <i class="bi bi-globe2 board-tile-icon"></i>
        <div class="board-tile-name">World</div>
        <span class="board-tile-count">@(worldCount)</span>
    </a>
    <a href="/board/culture" class="board-tile">
        <i class="bi bi-palette2 board-tile-icon"></i>
        <div class="board-tile-name">Culture</div>
        <span class="board-tile-count">@(cultureCount)</span>
    </a>
    <a href="/board/tools" class="board-tile">
        <i class="bi bi-grid-3x3-gap board-tile-icon"></i>
        <div class="board-tile-name">Tools</div>
    </a>
    <a href="contracts" class="board-tile">
        <i class="bi bi-file-earmark-check board-tile-icon"></i>
        <div class="board-tile-name">Contracts</div>
        <span class="board-tile-count">@contractCount</span>
    </a>
</div>

@code {
    int charCount, orgCount, gearCount, worldCount, cultureCount, contractCount;

    protected override void OnInitialized()
    {
        charCount    = CharRepo.GetAll().Count + SynthRepo.GetAll().Count + ArchetypeRepo.GetAll().Count;
        orgCount     = CorpRepo.GetAll().Count + SubsidiaryRepo.GetAll().Count + FactionRepo.GetAll().Count;
        gearCount    = WeaponRepo.GetAll().Count + AmmoRepo.GetAll().Count + CyberRepo.GetAll().Count
                     + EquipRepo.GetAll().Count + ApparelRepo.GetAll().Count + GenemodRepo.GetAll().Count
                     + PharmaRepo.GetAll().Count;
        worldCount   = DistrictRepo.GetAll().Count + TransportRepo.GetAll().Count + MaterialRepo.GetAll().Count
                     + TechRepo.GetAll().Count + AutomatonRepo.GetAll().Count;
        cultureCount = DocRepo.GetAll().Count + QuoteRepo.GetAll().Count + VocabRepo.GetAll().Count
                     + NewsRepo.GetAll().Count + EntertainmentRepo.GetAll().Count + GoodsRepo.GetAll().Count;
        contractCount = ContractRepo.GetAll().Count;
    }
}
