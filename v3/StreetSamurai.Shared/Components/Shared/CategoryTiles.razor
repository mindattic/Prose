@inject CharacterRepository CharRepo
@inject SyntheticLifeRepository SynthRepo
@inject ArchetypeRepository ArchetypeRepo
@inject CorponationRepository CorpRepo
@inject SubsidiaryRepository SubsidiaryRepo
@inject FactionRepository FactionRepo
@inject WeaponryRepository WeaponRepo
@inject AmmunitionRepository AmmoRepo
@inject CyberwareRepository CyberRepo
@inject EquipmentRepository EquipRepo
@inject ApparelRepository ApparelRepo
@inject GenemodRepository GenemodRepo
@inject PharmaceuticalRepository PharmaRepo
@inject DistrictRepository DistrictRepo
@inject TransportationRepository TransportRepo
@inject MaterialRepository MaterialRepo
@inject TechnologyRepository TechRepo
@inject AutomatonRepository AutomatonRepo
@inject WorldbuildingDocRepository DocRepo
@inject QuoteRepository QuoteRepo
@inject VocabularyRepository VocabRepo
@inject NewsRepository NewsRepo
@inject EntertainmentRepository EntertainmentRepo
@inject ConsumerGoodRepository GoodsRepo
@inject ContractRepository ContractRepo
@inject LabSpecimenRepository LabSpecimenRepo
@inject FlyoverEntityRepository FlyoverRepo
@inject PsionicRepository PsionicRepo
@inject IWriteAccessProvider Access

<div class="home-sections">

    @* ── Writing ────────────────────────────────────────────────────── *@
    @if (Access.IsContributor)
    {
        <div class="board-section">
            <div class="board-section-label">Writing</div>
            <div class="board-grid">
                <a href="/books" class="board-tile board-tile-tool"
                   title="Bookshelf — every book in the project. Pick one to drill into chapters, outline, motifs, review, and continuity.">
                    <i class="bi bi-book board-tile-icon"></i>
                    <div class="board-tile-name">Bookshelf</div>
                </a>
                <a href="/series" class="board-tile board-tile-tool"
                   title="Series — group books into multi-book arcs. Stub for now; future home for series-level outlines and continuity.">
                    <i class="bi bi-collection board-tile-icon"></i>
                    <div class="board-tile-name">Series</div>
                </a>
            </div>
        </div>
    }

    @* ── Repositories ──────────────────────────────────────────────── *@
    <div class="board-section">
        <div class="board-section-label">Repositories</div>
        <div class="board-grid">
            <a href="/board/characters" class="board-tile"
               title="Characters — people, synthetic life (AIs / androids / robots / cyborg AIs / etc.), archetypes, and ceramic men. Browse and edit full psychology, speech patterns, behavioral rules, cyberware, and timelines.">
                <i class="bi bi-people-fill board-tile-icon"></i>
                <div class="board-tile-name">Characters</div>
                <span class="board-tile-count">@charCount</span>
            </a>
            <a href="/board/organizations" class="board-tile"
               title="Organizations — corporate nation-states (corponations), their subsidiaries, and non-corporate factions (gangs, syndicates, movements). Who controls what territory, and what they want.">
                <i class="bi bi-buildings board-tile-icon"></i>
                <div class="board-tile-name">Organizations</div>
                <span class="board-tile-count">@orgCount</span>
            </a>
            <a href="/board/gear" class="board-tile"
               title="Gear — weaponry, ammunition, cyberware, equipment, apparel, genemods, and pharmaceuticals. Tactical use, manufacturer, tier, and cultural context for everything a character can carry, wear, or take.">
                <i class="bi bi-tools board-tile-icon"></i>
                <div class="board-tile-name">Gear</div>
                <span class="board-tile-count">@gearCount</span>
            </a>
            <a href="/board/world" class="board-tile"
               title="World — places (districts, buildings, landmarks), transportation (vehicles + the Pulse), materials, technology, automata (autonomous machines, NOT synthetic life), and the literary rules that govern prose.">
                <i class="bi bi-globe2 board-tile-icon"></i>
                <div class="board-tile-name">World</div>
                <span class="board-tile-count">@worldCount</span>
            </a>
            <a href="/board/culture" class="board-tile"
               title="Culture — long-form lore documents, in-world quotes, GLMZ vocabulary, news archive, entertainment (films / books / music), and consumer goods. The texture of daily life in 2200.">
                <i class="bi bi-palette2 board-tile-icon"></i>
                <div class="board-tile-name">Culture</div>
                <span class="board-tile-count">@cultureCount</span>
            </a>
            <a href="contracts" class="board-tile"
               title="Contracts — freelance contract registry. Generated jobs with twists, moral dilemmas, and persistent reputation/consequence effects across stories.">
                <i class="bi bi-file-earmark-check board-tile-icon"></i>
                <div class="board-tile-name">Contracts</div>
                <span class="board-tile-count">@contractCount</span>
            </a>
        </div>
    </div>

    @* ── World Data ─────────────────────────────────────────────────── *@
    <div class="board-section">
        <div class="board-section-label">World Data</div>
        <div class="board-grid">
            <a href="quotes" class="board-tile board-tile-data"
               title="Quotes — in-world quotations attributed to characters, documents, or sources. Pull-quote material for chapters and epigraphs.">
                <i class="bi bi-quote board-tile-icon"></i>
                <div class="board-tile-name">Quotes</div>
                <span class="board-tile-count">@quoteCount</span>
            </a>
            <a href="vocabulary" class="board-tile board-tile-data"
               title="Vocabulary — GLMZ-specific terminology: street slang, corporate jargon, technical terms with definitions and usage context. The dictionary the world speaks.">
                <i class="bi bi-chat-quote board-tile-icon"></i>
                <div class="board-tile-name">Vocabulary</div>
                <span class="board-tile-count">@vocabCount</span>
            </a>
            <a href="archetypes" class="board-tile board-tile-data"
               title="Archetypes — psychological / narrative archetype templates with trait weights. Used to seed character generation and anchor recurring patterns.">
                <i class="bi bi-person-bounding-box board-tile-icon"></i>
                <div class="board-tile-name">Archetypes</div>
                <span class="board-tile-count">@archetypeCount</span>
            </a>
            <a href="rules" class="board-tile board-tile-data"
               title="World Rules — hard prose constraints injected into every generation call as NON-NEGOTIABLE. Sentence length limits, banned cliches, grounded-prose requirements.">
                <i class="bi bi-book board-tile-icon"></i>
                <div class="board-tile-name">World Rules</div>
            </a>
        </div>
    </div>

    @* ── Visualizations ─────────────────────────────────────────────── *@
    <div class="board-section">
        <div class="board-section-label">Visualizations</div>
        <div class="board-grid">
            <a href="graph" class="board-tile board-tile-viz"
               title="World Graph — 2D D3 force-directed view of every entity and relationship. Pan, zoom, click any node to drill in.">
                <i class="bi bi-diagram-3 board-tile-icon"></i>
                <div class="board-tile-name">World Graph</div>
            </a>
            <a href="graph-3d" class="board-tile board-tile-viz"
               title="World Graph 3D — three-dimensional rendering of the same graph. Spatial clustering reveals tight subgraphs the 2D view smushes flat.">
                <i class="bi bi-bounding-box board-tile-icon"></i>
                <div class="board-tile-name">World Graph 3D</div>
            </a>
            <a href="map" class="board-tile board-tile-viz"
               title="Map — geographic layout of GLMZ districts and exits. Zork-style directional travel between places, computed from real coordinates.">
                <i class="bi bi-map-fill board-tile-icon"></i>
                <div class="board-tile-name">Map</div>
            </a>
            <a href="heritage" class="board-tile board-tile-viz"
               title="Heritage — ethnic / genetic ancestry heatmap of the cast. Visualizes the Ubiquitous Diaspora across every named character.">
                <i class="bi bi-tree-fill board-tile-icon"></i>
                <div class="board-tile-name">Heritage</div>
            </a>
        </div>
    </div>

    @* ── Tools ──────────────────────────────────────────────────────── *@
    <div class="board-section">
        <div class="board-section-label">Tools</div>
        <div class="board-grid">
            <a href="/dashboard" class="board-tile board-tile-tool"
               title="Dashboard — live overview: entity counts across all repositories, world-graph size, story counts, configured-service status. Your at-a-glance health check.">
                <i class="bi bi-speedometer2 board-tile-icon"></i>
                <div class="board-tile-name">Dashboard</div>
            </a>
            <a href="/ask" class="board-tile board-tile-tool"
               title="Ask — natural-language questions against the live JSON + chapter prose. Reindexes on save so answers always reflect the current truth on disk.">
                <i class="bi bi-chat-dots board-tile-icon"></i>
                <div class="board-tile-name">Ask</div>
            </a>
            <a href="/atlas" class="board-tile board-tile-tool"
               title="Atlas — system-wide directory of every entity type, service, and architectural component. The whole codebase + canon expressed as a hierarchy.">
                <i class="bi bi-book-half board-tile-icon"></i>
                <div class="board-tile-name">Atlas</div>
            </a>
            @if (Access.IsAdministrator)
            {
                <a href="/architecture" class="board-tile board-tile-tool"
                   title="Architecture — live scan of every service, CLI verb, MCP tool, Razor page, and script in the codebase, with duplicate-cluster detection. The inventory we work from when we ask &quot;what does this do, do we have two of these, can it die?&quot;">
                    <i class="bi bi-diagram-3 board-tile-icon"></i>
                    <div class="board-tile-name">Architecture</div>
                </a>
            }
            @if (Access.IsContributor)
            {
                <a href="/continuity" class="board-tile board-tile-tool"
                   title="Continuity — unified atomic-claim store. Extracts (entity, predicate, object) triples from chapter prose AND entity records via Legion Quorum, surfaces contradictions, lets you resolve A / B / custom, and applies the agreed value back to the entity record.">
                    <i class="bi bi-database-check board-tile-icon"></i>
                    <div class="board-tile-name">Continuity</div>
                </a>
            }
        </div>
    </div>

</div>

@code {
    int charCount, orgCount, gearCount, worldCount, cultureCount, contractCount;
    int quoteCount, vocabCount, archetypeCount;

    protected override void OnInitialized()
    {
        // Count() runs SELECT COUNT(*); GetAll() loads + deserializes every row.
        // Home page cold-start dropped from ~40s to <1s after this switch.
        charCount    = CharRepo.Count() + SynthRepo.Count();
        orgCount     = CorpRepo.Count() + SubsidiaryRepo.Count() + FactionRepo.Count();
        gearCount    = WeaponRepo.Count() + AmmoRepo.Count() + CyberRepo.Count()
                     + EquipRepo.Count() + ApparelRepo.Count() + GenemodRepo.Count()
                     + PharmaRepo.Count() + PsionicRepo.Count();
        worldCount   = DistrictRepo.Count() + TransportRepo.Count() + MaterialRepo.Count()
                     + TechRepo.Count() + AutomatonRepo.Count()
                     + LabSpecimenRepo.Count() + FlyoverRepo.Count();
        cultureCount = DocRepo.Count() + NewsRepo.Count()
                     + EntertainmentRepo.Count() + GoodsRepo.Count();
        contractCount  = ContractRepo.Count();
        quoteCount     = QuoteRepo.Count();
        vocabCount     = VocabRepo.Count();
        archetypeCount = ArchetypeRepo.Count();
    }
}
