@* Reusable pagination bar. Shows < currentPage/totalPages > navigation.
   Usage: <PaginationBar CurrentPage="currentPage" TotalPages="TotalPages" OnPageChanged="p => currentPage = p" /> *@

@if (TotalPages > 1)
{
    <div class="d-flex align-items-center gap-1 mt-2" style="font-size:0.75rem;">
        <button class="btn btn-sq btn-outline-secondary" disabled="@(CurrentPage <= 1)"
                @onclick="() => Go(CurrentPage - 1)" title="Previous">
            <i class="bi bi-chevron-left"></i>
        </button>

        <span class="text-muted px-2">@CurrentPage / @TotalPages</span>

        <button class="btn btn-sq btn-outline-secondary" disabled="@(CurrentPage >= TotalPages)"
                @onclick="() => Go(CurrentPage + 1)" title="Next">
            <i class="bi bi-chevron-right"></i>
        </button>
    </div>
}

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private async Task Go(int page)
    {
        if (page < 1 || page > TotalPages || page == CurrentPage) return;
        await OnPageChanged.InvokeAsync(page);
    }
}
