@* Reusable pagination bar — full-width swipe slider.
   Usage: <PaginationBar CurrentPage="currentPage" TotalPages="TotalPages" OnPageChanged="p => currentPage = p" /> *@

@if (TotalPages > 1)
{
    <div class="dict-pager">
        <input type="range" class="dict-pager-track"
               min="1" max="@TotalPages"
               value="@CurrentPage"
               @oninput="OnInput" />
        <span class="dict-pager-label">@CurrentPage / @TotalPages</span>
    </div>
}

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; } = 1;
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private async Task OnInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var p))
            await OnPageChanged.InvokeAsync(p);
    }
}
