@* Admin-only image generation panel. Shows a carousel of entity portraits; admins
   can generate new images or archive individual ones (with confirmation). *@
@inject DallEService Dalle
@inject MediaService Media
@inject IWriteAccessProvider Access

<div class="entity-image-panel">

    @* ── Carousel ──────────────────────────────────────────────────── *@
    @if (images.Count > 0)
    {
        <div class="entity-carousel">
            @foreach (var img in images)
            {
                var captured = img;
                <div class="entity-carousel-item">
                    <img src="/api/media/@img?t=@imageKey"
                         class="entity-carousel-img"
                         alt="@EntityName"
                         onerror="this.classList.add('entity-carousel-img-missing')" />
                    @if (Access.IsContributor)
                    {
                        <button class="btn btn-sm entity-carousel-archive"
                                @onclick="async () => await ConfirmArchive(captured)"
                                title="Archive @img">
                            <i class="bi bi-archive"></i>
                        </button>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="entity-carousel-empty">
            <div class="entity-carousel-placeholder"></div>
        </div>
    }

    @* ── Generate controls (admin only) ───────────────────────────── *@
    @if (Access.IsContributor)
    {
        <div class="entity-image-controls">
            <textarea class="form-control form-control-sm bg-dark text-light border-secondary entity-image-prompt-input"
                      rows="3"
                      @bind="currentPrompt"
                      placeholder="Image prompt — describe the scene, setting, lighting, style…"></textarea>
            <div class="d-flex gap-2 mt-2">
                <button class="btn btn-sm btn-outline-primary flex-grow-1"
                        @onclick="Generate"
                        disabled="@(generating || string.IsNullOrWhiteSpace(currentPrompt))">
                    @if (generating)
                    {
                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                        <span>Generating…</span>
                    }
                    else
                    {
                        <i class="bi bi-stars me-1"></i>
                        <span>@(images.Count == 0 ? "Generate with DALL-E 3" : "Generate Another")</span>
                    }
                </button>
            </div>
        </div>
    }

</div>

@* ── Dialogs ────────────────────────────────────────────────────────── *@
<ConfirmDialog @ref="confirmDialog"
               ConfirmLabel="Archive"
               CancelLabel="Keep" />
<MessageBox @ref="msgBox" />

@code {
    /// <summary>Entity GUID — used as filename prefix in media/.</summary>
    [Parameter, EditorRequired] public string EntityId { get; set; } = "";
    /// <summary>Midjourney prompt stored on the entity — for reference.</summary>
    [Parameter] public string MidjourneyPrompt { get; set; } = "";
    /// <summary>DALL-E 3 prompt stored on the entity — pre-populates the generate textarea.</summary>
    [Parameter] public string Dalle3Prompt { get; set; } = "";
    /// <summary>Entity name for alt text.</summary>
    [Parameter] public string EntityName { get; set; } = "";

    private ConfirmDialog confirmDialog = default!;
    private MessageBox msgBox = default!;

    private List<string> images = [];
    private string currentPrompt = "";
    private bool generating;
    private long imageKey = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();

    protected override void OnParametersSet()
    {
        LoadImages();
        if (string.IsNullOrWhiteSpace(currentPrompt) && !string.IsNullOrWhiteSpace(Dalle3Prompt))
            currentPrompt = Dalle3Prompt;
    }

    private void LoadImages()
    {
        if (string.IsNullOrWhiteSpace(EntityId)) { images = []; return; }
        images = Media.GetFilesForEntity(EntityId)
            .Where(f =>
            {
                var ext = Path.GetExtension(f).ToLowerInvariant();
                return ext is ".png" or ".jpg" or ".jpeg" or ".webp";
            })
            .ToList();
    }

    private async Task Generate()
    {
        if (string.IsNullOrWhiteSpace(currentPrompt) || string.IsNullOrWhiteSpace(EntityId)) return;
        generating = true;
        StateHasChanged();
        try
        {
            await Dalle.GenerateAndSaveAsync(EntityId, currentPrompt);
            imageKey = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
            LoadImages();
        }
        catch (Exception ex)
        {
            await msgBox.ShowAsync("Generation Failed", ex.Message, MessageBox.Kind.Error);
        }
        finally
        {
            generating = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmArchive(string filename)
    {
        bool confirmed = await confirmDialog.ShowAsync(
            "Archive this image?",
            $"{filename} will be moved to the archive. You can recover it manually from engine/data/media/archives/.",
            ConfirmDialog.Kind.Danger);

        if (!confirmed) return;

        Media.Archive(filename);
        imageKey = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
        LoadImages();
        StateHasChanged();
        await msgBox.ShowAsync("Archived", $"{filename} moved to archive.", MessageBox.Kind.Success);
    }
}
