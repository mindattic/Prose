@using StreetSamurai.Core.Data.Entities
@using StreetSamurai.Core.Interfaces
@using StreetSamurai.Core.Services
@inject FamilyTieService Family
@inject FamilyGeneratorService Generator
@inject IWriteAccessProvider Access
@inject ToastNotifier Toast

@if (loading)
{
    <div class="card bg-dark text-light border-secondary mb-3">
        <div class="card-header text-muted small">
            <i class="bi bi-people me-1"></i> Family
        </div>
        <div class="card-body small text-muted">
            <span class="spinner-border spinner-border-sm me-2"></span> loading family ties...
        </div>
    </div>
}
else
{
    <div class="card bg-dark text-light border-secondary mb-3">
        <div class="card-header text-muted small d-flex justify-content-between align-items-center">
            <span><i class="bi bi-people me-1"></i> Family</span>
            <span>
                @if (TotalCount > 0) { <span class="me-2">@TotalCount linked</span> }
                @if (Access.IsAdministrator && proposal == null)
                {
                    <span class="d-inline-flex align-items-center gap-2">
                        <label class="form-check-label small text-muted" style="cursor:pointer;">
                            <input type="checkbox" class="form-check-input me-1" @bind="includeCousins" />
                            with cousins
                        </label>
                        <button class="btn btn-sm btn-outline-info" @onclick="ProposeFamily" disabled="@proposing"
                                title="Generate parents / siblings / spouse / children using the canon name pool. With cousins also generates aunts, uncles, and their children.">
                            @if (proposing) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            else { <i class="bi bi-magic me-1"></i> }
                            <span>Propose family</span>
                        </button>
                    </span>
                }
            </span>
        </div>
        <div class="card-body">
            @if (TotalCount > 0)
            {
                @RenderGroup("Parents",      snapshot!.Parents,      "bi-person-fill-up")
                @RenderGroup("Spouses",      snapshot!.Spouses,      "bi-heart-fill")
                @RenderGroup("Siblings",     snapshot!.Siblings,     "bi-people-fill")
                @RenderGroup("Children",     snapshot!.Children,     "bi-person-fill-down")
                @RenderGroup("Grandparents", snapshot!.Grandparents, "bi-tree-fill")
                @RenderGroup("Cousins",      snapshot!.Cousins,      "bi-diagram-3")
            }
            else if (proposal == null)
            {
                <div class="small text-muted">
                    No family ties yet.
                    @if (Access.IsAdministrator) { <span>Click <em>Propose family</em> above, or use the CLI:</span> }
                    <code class="d-block mt-1">ss --family-gen propose --of @EntityId --commit</code>
                </div>
            }

            @if (Access.IsAdministrator && proposal == null)
            {
                <div class="mt-3 pt-3 border-top border-secondary">
                    <div class="d-flex flex-wrap gap-1 mb-2">
                        <button class="btn btn-sm btn-outline-secondary" @onclick='() => OpenAdd("parent")'><i class="bi bi-plus-lg me-1"></i>parent</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick='() => OpenAdd("sibling")'><i class="bi bi-plus-lg me-1"></i>sibling</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick='() => OpenAdd("spouse")'><i class="bi bi-plus-lg me-1"></i>spouse</button>
                        @if (!string.IsNullOrEmpty(addMode))
                        {
                            <button class="btn btn-sm btn-link text-muted" @onclick="CloseAdd"><i class="bi bi-x-lg"></i></button>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(addMode))
                    {
                        <div class="small">
                            <label class="text-muted mb-1">
                                Search for an existing character to link as <strong>@addMode</strong>:
                            </label>
                            <input class="form-control form-control-sm bg-dark text-light border-secondary"
                                   placeholder="Type 2+ characters of their name..."
                                   @bind="addQuery" @bind:event="oninput" @bind:after="RunSearch" />
                            @if (searching)
                            {
                                <div class="text-muted mt-1 small"><span class="spinner-border spinner-border-sm me-1"></span>searching...</div>
                            }
                            else if (searchHits != null && searchHits.Count == 0 && addQuery.Length >= 2)
                            {
                                <div class="text-muted mt-1 small">No matches.</div>
                            }
                            else if (searchHits != null && searchHits.Count > 0)
                            {
                                <div class="d-flex flex-column gap-1 mt-1">
                                    @foreach (var hit in searchHits)
                                    {
                                        <button class="btn btn-sm btn-outline-info text-start"
                                                @onclick="() => LinkExisting(hit)" disabled="@linking">
                                            @hit.Name
                                            <span class="text-muted ms-1">(@hit.Id.ToString().Substring(0, 8))</span>
                                        </button>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(linkStatus))
                            {
                                <div class="mt-2 small @(linkSuccess ? "text-success" : "text-danger")">@linkStatus</div>
                            }
                        </div>
                    }
                </div>
            }

            @if (proposal != null)
            {
                <div class="mt-3 pt-3 border-top border-secondary">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong class="small">Proposal — review and apply</strong>
                        <span>
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="DiscardProposal" disabled="@applying">
                                Discard
                            </button>
                            <button class="btn btn-sm btn-outline-secondary me-1" @onclick="RerollProposal" disabled="@(proposing || applying)"
                                    title="Re-roll with a fresh random seed">
                                <i class="bi bi-shuffle me-1"></i>Re-roll
                            </button>
                            <button class="btn btn-sm btn-success" @onclick="ApplySelected" disabled="@(applying || selected.Count == 0)">
                                @if (applying) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                else { <i class="bi bi-check2 me-1"></i> }
                                <span>Apply (@selected.Count)</span>
                            </button>
                        </span>
                    </div>
                    @RenderProposalGroup("Parents",      proposal.Parents)
                    @RenderProposalGroup("Spouses",      proposal.Spouses)
                    @RenderProposalGroup("Siblings",     proposal.Siblings)
                    @RenderProposalGroup("Children",     proposal.Children)
                    @RenderProposalGroup("Aunts/Uncles",       proposal.AuntsUncles     .Select(au  => au.Person).ToList())
                    @RenderProposalGroup("Aunt/Uncle Spouses", proposal.AuntUncleSpouses.Select(aus => aus.Person).ToList())
                    @RenderProposalGroup("Cousins",            proposal.Cousins         .Select(c   => c.Person ).ToList())
                    @if (!string.IsNullOrEmpty(applyStatus))
                    {
                        <div class="mt-2 small @(applySuccess ? "text-success" : "text-danger")">@applyStatus</div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string EntityId { get; set; } = "";

    private bool loading = true;
    private FamilyTieService.FamilySnapshot? snapshot;
    private string lastLoadedFor = "";
    private Guid resolvedEntityId;

    private bool proposing;
    private bool applying;
    private bool includeCousins;
    private FamilyGeneratorService.FamilyProposal? proposal;
    private HashSet<Guid> selected = new();
    private string? applyStatus;
    private bool applySuccess;

    // ── manual add-tie flow ──
    private string addMode = "";    // "" | "parent" | "sibling" | "spouse"
    private string addQuery = "";
    private bool searching;
    private bool linking;
    private List<Entity>? searchHits;
    private string? linkStatus;
    private bool linkSuccess;
    private System.Threading.CancellationTokenSource? searchCts;

    private int TotalCount =>
        (snapshot?.Parents.Count ?? 0) + (snapshot?.Siblings.Count ?? 0) +
        (snapshot?.Spouses.Count ?? 0) + (snapshot?.Children.Count ?? 0) +
        (snapshot?.Grandparents.Count ?? 0) + (snapshot?.Cousins.Count ?? 0);

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(EntityId, lastLoadedFor, StringComparison.OrdinalIgnoreCase)) return;
        lastLoadedFor = EntityId;
        proposal = null; selected.Clear(); applyStatus = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true; snapshot = null;
        StateHasChanged();
        try
        {
            if (TryParseId(EntityId, out var id))
            {
                resolvedEntityId = id;
                snapshot = await Family.GetSnapshotAsync(id);
            }
        }
        catch (Exception ex)
        {
            Toast.Warning("FAMILY-001", $"Could not load family for {EntityId}: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task ProposeFamily()
    {
        if (resolvedEntityId == Guid.Empty) return;
        proposing = true; applyStatus = null;
        StateHasChanged();
        try
        {
            proposal = await Generator.ProposeAsync(resolvedEntityId, rng: null, includeCousins: includeCousins);
            // Default-select every proposed character; user uncheck to skip
            selected = new HashSet<Guid>(proposal.All.Select(p => p.Id));
        }
        catch (Exception ex)
        {
            Toast.Error("FAMILY-002", $"Proposal failed: {ex.Message}");
            applyStatus = ex.Message; applySuccess = false;
        }
        finally { proposing = false; StateHasChanged(); }
    }

    private async Task RerollProposal()
    {
        // Same as ProposeFamily but explicit so the button label reads correctly
        await ProposeFamily();
    }

    private void DiscardProposal()
    {
        proposal = null; selected.Clear(); applyStatus = null;
    }

    private async Task ApplySelected()
    {
        if (proposal == null || selected.Count == 0) return;
        applying = true; applyStatus = null;
        StateHasChanged();
        try
        {
            // Build a filtered proposal containing only checked characters.
            // FamilyProposal is a record so we use the with-expression.
            var filtered = proposal with
            {
                Parents          = proposal.Parents         .Where(p   => selected.Contains(p.Id)).ToList(),
                Siblings         = proposal.Siblings        .Where(p   => selected.Contains(p.Id)).ToList(),
                Spouses          = proposal.Spouses         .Where(p   => selected.Contains(p.Id)).ToList(),
                Children         = proposal.Children        .Where(p   => selected.Contains(p.Id)).ToList(),
                AuntsUncles      = proposal.AuntsUncles     .Where(au  => selected.Contains(au.Person.Id)).ToList(),
                AuntUncleSpouses = proposal.AuntUncleSpouses.Where(aus => selected.Contains(aus.Person.Id)).ToList(),
                Cousins          = proposal.Cousins         .Where(c   => selected.Contains(c.Person.Id)).ToList(),
            };
            var ids = await Generator.ApplyProposalAsync(filtered);
            applySuccess = true;
            applyStatus = $"Applied — {ids.Count} new characters created.";
            Toast.Success("FAMILY-003", $"{ids.Count} new family members for {EntityId}");
            // Clear and re-load the snapshot so the new ties show up
            proposal = null; selected.Clear();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            applySuccess = false;
            applyStatus = $"Apply failed: {ex.Message}";
            Toast.Error("FAMILY-004", ex.Message);
        }
        finally { applying = false; StateHasChanged(); }
    }

    private void ToggleSelected(Guid id)
    {
        if (!selected.Add(id)) selected.Remove(id);
    }

    private static bool TryParseId(string s, out Guid id) =>
        Guid.TryParse(s, out id) || (s.Length == 32 && Guid.TryParseExact(s, "N", out id));

    private void OpenAdd(string mode)
    {
        addMode = mode; addQuery = ""; searchHits = null; linkStatus = null;
    }

    private void CloseAdd()
    {
        addMode = ""; addQuery = ""; searchHits = null; linkStatus = null;
        searchCts?.Cancel();
    }

    private async Task RunSearch()
    {
        // Debounce by cancelling the previous search if user is still typing
        searchCts?.Cancel();
        searchCts = new System.Threading.CancellationTokenSource();
        var ct = searchCts.Token;
        if (string.IsNullOrWhiteSpace(addQuery) || addQuery.Length < 2)
        {
            searchHits = null; StateHasChanged(); return;
        }
        searching = true; StateHasChanged();
        try
        {
            await Task.Delay(150, ct);   // small debounce so we don't query on every keystroke
            searchHits = await Family.SearchCharactersByNameAsync(addQuery, resolvedEntityId, 8, ct);
        }
        catch (TaskCanceledException) { /* superseded by next keystroke */ }
        finally { searching = false; StateHasChanged(); }
    }

    private async Task LinkExisting(Entity other)
    {
        if (resolvedEntityId == Guid.Empty || string.IsNullOrEmpty(addMode)) return;
        linking = true; linkStatus = null;
        StateHasChanged();
        try
        {
            switch (addMode)
            {
                case "parent":  await Family.AddParentAsync(other.Id, resolvedEntityId, "manual"); break;
                case "sibling": await Family.AddSiblingAsync(resolvedEntityId, other.Id, "manual"); break;
                case "spouse":  await Family.AddSpouseAsync(resolvedEntityId, other.Id, "manual"); break;
            }
            linkSuccess = true;
            linkStatus  = $"Linked {other.Name} as {addMode}.";
            Toast.Success("FAMILY-005", $"{other.Name} <-> {EntityId} ({addMode})");
            CloseAdd();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            linkSuccess = false;
            linkStatus = ex.Message;
            Toast.Error("FAMILY-006", ex.Message);
        }
        finally { linking = false; StateHasChanged(); }
    }

    private RenderFragment RenderGroup(string label, List<Entity> entities, string icon) => __builder =>
    {
        if (entities.Count == 0) return;
        <div class="mb-2 small">
            <div class="text-muted mb-1">
                <i class="bi @icon me-1"></i>@label (@entities.Count)
            </div>
            <div class="d-flex flex-wrap gap-1">
                @foreach (var e in entities)
                {
                    <a href="/entity/@e.Id" class="badge bg-secondary text-decoration-none">@e.Name</a>
                }
            </div>
        </div>
    };

    private RenderFragment RenderProposalGroup(string label,
        List<FamilyGeneratorService.ProposedCharacter> rows) => __builder =>
    {
        if (rows.Count == 0) return;
        <div class="mb-2 small">
            <div class="text-muted mb-1">@label (@rows.Count)</div>
            <div class="d-flex flex-column gap-1">
                @foreach (var p in rows)
                {
                    var checkedNow = selected.Contains(p.Id);
                    <label class="d-flex align-items-center gap-2" style="cursor:pointer;">
                        <input type="checkbox" class="form-check-input" checked="@checkedNow"
                               @onchange="@(_ => ToggleSelected(p.Id))" />
                        <span class="text-light">@p.FirstName @p.LastName</span>
                        <span class="text-muted">age @p.Age · @p.Gender · @p.Role</span>
                    </label>
                }
            </div>
        </div>
    };
}
