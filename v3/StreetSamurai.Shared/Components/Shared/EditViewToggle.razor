@* Wraps editor content with a read-only/edit toggle.
   In read-only mode (default), shows EntryViewer with beautifully formatted content.
   In edit mode, shows the child content (form fields).
   State persists per-repo across navigation. *@

<div class="ev-header">
    <h5 class="text-danger ev-header-title">@Title</h5>
    <div class="d-flex align-items-center gap-2 flex-shrink-0">
        @if (Rating >= 0)
        {
            <StarRating Value="@Rating" ValueChanged="OnStarChanged" />
        }
        @if (Access.IsContributor)
        {
            @if (editMode)
            {
                @HeaderButtons
            }
            @if (!HideToggle)
            {
                <button class="btn btn-sq @(editMode ? "btn-danger" : "btn-outline-secondary")"
                        style="@(editMode ? "margin: 0px 5px 0px 0px;" : "")"
                        @onclick="Toggle" title="@(editMode ? "Exit edit mode" : "Edit")">
                    <i class="bi bi-pencil"></i>
                </button>
            }
        }
    </div>
</div>

@if (editMode && Access.IsContributor)
{
    @ChildContent
}
else
{
    <EntryViewer Json="@Json" />
}

@code {
    [Parameter] public string RepoName { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Json { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? HeaderButtons { get; set; }
    [Parameter] public bool HideToggle { get; set; } = false;
    [Parameter] public double Rating { get; set; } = -1;
    [Parameter] public EventCallback<double> RatingChanged { get; set; }
    [Inject] private ViewModeService ViewMode { get; set; } = default!;
    [Inject] private IWriteAccessProvider Access { get; set; } = default!;

    private bool editMode;

    protected override void OnInitialized() => editMode = ViewMode.IsEditMode(RepoName);

    private void Toggle()
    {
        editMode = !editMode;
        ViewMode.SetEditMode(RepoName, editMode);
    }

    private async Task OnStarChanged(double value)
    {
        Rating = value;
        await RatingChanged.InvokeAsync(value);
    }
}
