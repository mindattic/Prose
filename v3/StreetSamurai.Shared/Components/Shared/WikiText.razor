@using StreetSamurai.Core.Services
@inject WikiLinkService Wiki

@* Renders prose with [[Entity]] markup as clickable links. Auto-detect option will
   wrap any known entity name (use sparingly — it overrides writer intent). *@

@if (segments != null)
{
    <span class="wiki-text @ExtraClass">
        @foreach (var s in segments)
        {
            switch (s.Kind)
            {
                case WikiSegmentKind.Text:
                    <text>@s.Text</text>
                    break;
                case WikiSegmentKind.Link:
                    <a class="wiki-link" href="@($"/entity/{Uri.EscapeDataString(s.EntityId!)}")" title="@($"Open {s.EntityName}")">@s.Text</a>
                    break;
                case WikiSegmentKind.Stub:
                    <a class="wiki-link wiki-link-stub" href="@($"/entity/stub/{Uri.EscapeDataString(s.StubSlug!)}")" title="@($"Stub: {s.EntityName} (not yet in canon)")">@s.Text</a>
                    break;
                case WikiSegmentKind.Dangling:
                    <span class="wiki-dangling" title="@($"No entity matches '{s.EntityName}'")">@s.Text</span>
                    break;
            }
        }
    </span>
}

@code {
    [Parameter] public string? Text { get; set; }
    [Parameter] public bool AutoLink { get; set; }
    [Parameter] public string? ExtraClass { get; set; }

    private List<WikiSegment>? segments;

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(Text)) { segments = new(); return; }
        var src = AutoLink ? PreLinkAuto(Text) : Text;
        segments = Wiki.Extract(src);
    }

    private string PreLinkAuto(string text)
    {
        // AutoLink builds bracketed markup then renders to HTML. Here we want
        // segments, not HTML, so we run AutoLink to get the bracketed form
        // and discard the HTML — Extract re-parses it cleanly.
        var html = Wiki.AutoLink(text);
        // Extract operates on the bracketed source; reconstruct it by stripping
        // anchor tags AutoLink emitted.
        var stripped = System.Text.RegularExpressions.Regex.Replace(
            html, @"<a [^>]*href=""/entity/[^""]+""[^>]*>([^<]*)</a>", m => m.Groups[1].Value);
        return stripped;
    }
}

<style>
    .wiki-text { white-space: pre-wrap; }
    .wiki-link { color: #6cf; text-decoration: none; border-bottom: 1px dotted #6cf; }
    .wiki-link:hover { color: #9df; border-bottom-color: #9df; }
    .wiki-link-stub { color: #fc6; border-bottom: 1px dotted #fc6; }
    .wiki-link-stub:hover { color: #fd9; border-bottom-color: #fd9; }
    .wiki-dangling { color: #c66; border-bottom: 1px dotted #c66; cursor: help; }
</style>
