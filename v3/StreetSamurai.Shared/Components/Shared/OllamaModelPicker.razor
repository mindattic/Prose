@* Single-source dropdown for the local Ollama chat model.
   Reused by /ask and /settings so the catalog lives in exactly one place,
   and stays in sync with MindAttic.Legion's LlmProviderCatalog ("ollama"). *@

<select class="@CssClass" value="@Value" @onchange="HandleChange" disabled="@Disabled" @attributes="ExtraAttributes">
    @foreach (var group in groups)
    {
        <optgroup label="@group.Label">
            @foreach (var m in group.Models)
            {
                <option value="@m.Id">@m.Display</option>
            }
        </optgroup>
    }
</select>

@code {
    /// <summary>Currently selected Ollama model id (e.g. "qwen3:1.7b").</summary>
    [Parameter] public string Value { get; set; } = "";

    /// <summary>Two-way binding callback.</summary>
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    /// <summary>Whether the dropdown should be disabled (e.g. while a request is in flight).</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>CSS classes applied to the select element. Defaults match the dark theme.</summary>
    [Parameter] public string CssClass { get; set; } = "form-select bg-dark text-light border-secondary";

    /// <summary>Any extra HTML attributes (e.g. inline style, aria-*, data-*) splatted onto the select.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? ExtraAttributes { get; set; }

    private record ModelEntry(string Id, string Display);
    private record ModelGroup(string Label, ModelEntry[] Models);

    /// <summary>
    /// Catalog of every Ollama model exposed in the UI. Must stay aligned with
    /// MindAttic.Legion.LlmProviderCatalog's "ollama" entry — same ids, same set —
    /// so anything voted on in Legion is also pickable here.
    /// </summary>
    private static readonly ModelGroup[] groups =
    {
        new("Qwen (Alibaba — instruct/general)", new[]
        {
            new ModelEntry("qwen3:1.7b",  "Qwen3 1.7B (~1.4 GB, fast)"),
            new ModelEntry("qwen3:4b",    "Qwen3 4B (~2.5 GB)"),
            new ModelEntry("qwen3:8b",    "Qwen3 8B (~5.2 GB)"),
            new ModelEntry("qwen3:14b",   "Qwen3 14B (~9.3 GB)"),
            // Disabled — over 10 GB on disk, currently unaffordable on the C: drive.
            // new ModelEntry("qwen3:32b",   "Qwen3 32B (~20 GB)"),
            new ModelEntry("qwen2.5:14b", "Qwen2.5 14B (~9 GB)"),
            // new ModelEntry("qwen2.5:32b", "Qwen2.5 32B (~20 GB)"),
        }),
        new("Llama (Meta — general purpose)", new[]
        {
            new ModelEntry("llama3.2:1b", "Llama 3.2 1B (fastest, ~1.3 GB)"),
            new ModelEntry("llama3.2:3b", "Llama 3.2 3B (~2 GB)"),
            new ModelEntry("llama3.1:8b", "Llama 3.1 8B (~4.7 GB)"),
            // Disabled — over 10 GB on disk, currently unaffordable on the C: drive.
            // new ModelEntry("llama3.3:70b","Llama 3.3 70B (~40 GB)"),
        }),
        new("Other", new[]
        {
            new ModelEntry("phi4:14b",        "Phi 4 14B (Microsoft, ~9 GB)"),
            new ModelEntry("deepseek-r1:14b", "DeepSeek R1 14B (reasoning, ~9 GB)"),
            new ModelEntry("mistral:7b",      "Mistral 7B (~4.4 GB)"),
            new ModelEntry("gemma2:9b",       "Gemma 2 9B (~5.4 GB)"),
        }),
    };

    private async Task HandleChange(ChangeEventArgs e)
    {
        var next = e.Value?.ToString() ?? "";
        if (next == Value) return;
        Value = next;
        await ValueChanged.InvokeAsync(next);
    }
}
