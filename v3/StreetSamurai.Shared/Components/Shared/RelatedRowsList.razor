@* Generic list renderer for related-entity tabs (Sub-Places, Inhabitants,
   Personnel, Members, etc.). Each row links to /entity/{Id} for navigation. *@
@inject NavigationManager Nav

<div class="entity-detail-body">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0 text-light">@Title <span class="badge bg-secondary">@Rows.Count</span></h6>
    </div>
    @if (Rows.Count == 0)
    {
        <div class="text-muted small">No @Title.ToLowerInvariant() recorded.</div>
    }
    else
    {
        <div class="row g-2">
            @foreach (var r in Rows)
            {
                <div class="col-md-6 col-lg-4">
                    <a href="@($"/entity/{r.Id}")" class="card bg-dark border-secondary text-decoration-none small">
                        <div class="card-body p-2">
                            <div class="text-info fw-bold">@r.Name</div>
                            @if (!string.IsNullOrWhiteSpace(r.Caption))
                            {
                                <div class="text-muted">@r.Caption</div>
                            }
                            <div class="text-muted" style="font-size:.65rem;">@r.Type</div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public IReadOnlyList<RelatedRow> Rows { get; set; } = Array.Empty<RelatedRow>();

    public record RelatedRow(string Id, string Name, string Caption, string Type);
}
