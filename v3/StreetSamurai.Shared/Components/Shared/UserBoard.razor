@* User board — custom Blazor dropdown, no Bootstrap JS.
   Toggle open/close with the username button; click outside to close. *@

@inject IWriteAccessProvider Access
@inject ProfileService ProfileSvc
@inject NavigationManager Nav
@implements IDisposable

@if (!Access.IsReadOnlyMode && Access.CurrentUserRole != "Visitor")
{
    <div class="ub-wrap">
        @if (open)
        {
            <div class="ub-backdrop" @onclick="Close"></div>
        }
        <button class="topnav-link ub-trigger @(open ? "ub-open" : "")"
                type="button" @onclick="Toggle">
            @if (!string.IsNullOrEmpty(avatarUrl))
            {
                <img src="@avatarUrl" class="topnav-avatar" alt="@Access.CurrentUserName" />
            }
            else
            {
                <i class="bi bi-person-circle"></i>
            }
            <span class="topnav-username">@Access.CurrentUserName</span>
            <i class="bi bi-chevron-down ub-chevron"></i>
        </button>

        @if (open)
        {
            <div class="ub-panel">
                @if (Access.IsAdministrator)
                {
                    <a href="/rules" class="user-board-tile">
                        <i class="bi bi-book"></i><span>World Rules</span>
                    </a>
                    <a href="/users" class="user-board-tile">
                        <i class="bi bi-people-fill"></i><span>Users</span>
                    </a>
                    <a href="/settings" class="user-board-tile">
                        <i class="bi bi-gear"></i><span>Settings</span>
                    </a>
                    <a href="/logging" class="user-board-tile">
                        <i class="bi bi-journal-code"></i><span>Logging</span>
                    </a>
                    <a href="/utilities" class="user-board-tile">
                        <i class="bi bi-tools"></i><span>Utilities</span>
                    </a>
                    <a href="/books" class="user-board-tile">
                        <i class="bi bi-book"></i><span>Bookshelf</span>
                    </a>
                }
                else
                {
                    <a href="/settings" class="user-board-tile">
                        <i class="bi bi-sliders"></i><span>Display</span>
                    </a>
                    <a href="/profile" class="user-board-tile">
                        <i class="bi bi-person"></i><span>Profile</span>
                    </a>
                    @if (Access.IsContributor)
                    {
                        <a href="/books" class="user-board-tile">
                            <i class="bi bi-book"></i><span>Bookshelf</span>
                        </a>
                    }
                }
                <div class="user-board-logout">
                    <form method="post" action="/_ma-auth/logout">
                        <Microsoft.AspNetCore.Components.Forms.AntiforgeryToken />
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
}
else if (!Access.IsReadOnlyMode)
{
    <NavLink class="topnav-link" href="login">
        <i class="bi bi-box-arrow-in-right"></i>
        <span class="topnav-username"> Login</span>
    </NavLink>
}

@code {
    private string? avatarUrl;
    private bool open;

    protected override void OnInitialized()
    {
        ProfileSvc.AvatarUpdated += OnAvatarUpdated;
        Nav.LocationChanged += OnLocationChanged;
        LoadAvatar();
    }

    private void LoadAvatar() =>
        avatarUrl = ProfileSvc.GetAvatar(Access.CurrentUserName ?? "");

    private void OnAvatarUpdated()
    {
        LoadAvatar();
        InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        open = false;
        InvokeAsync(StateHasChanged);
    }

    private void Toggle() => open = !open;
    private void Close() => open = false;

    public void Dispose()
    {
        ProfileSvc.AvatarUpdated -= OnAvatarUpdated;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
