@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Logging
@using StreetSamurai.Core.Data
@using StreetSamurai.Core.Data.Entities
@inject RelationshipDiscoveryService Discovery
@inject IDbContextFactory<StreetSamuraiDbContext> DbFactory
@inject WorldGraphService Graph
@inject ILogger<SemanticEdgeSuggestions> Log

@if (loading)
{
    <div class="card bg-dark text-light border-secondary mb-3">
        <div class="card-header text-muted small">
            <i class="bi bi-diagram-3 me-1"></i> Semantic edge suggestions
        </div>
        <div class="card-body small text-muted">
            <span class="spinner-border spinner-border-sm me-2"></span> finding semantically-related entities…
        </div>
    </div>
}
else if (suggestions != null && suggestions.Count > 0)
{
    <div class="card bg-dark text-light border-secondary mb-3">
        <div class="card-header text-muted small d-flex justify-content-between">
            <span><i class="bi bi-diagram-3 me-1"></i> Semantic edge suggestions</span>
            <span>@suggestions.Count candidate@(suggestions.Count == 1 ? "" : "s") · click to add</span>
        </div>
        <div class="card-body">
            <p class="small text-muted mb-3">
                Entities semantically related to <strong>@Name</strong> that are NOT yet edge-connected.
                Pick a relation type and accept to add the edge.
            </p>
            <div class="d-flex flex-column gap-2">
                @foreach (var s in suggestions)
                {
                    var key = s.TargetEntityId.ToString();
                    var relType = relTypeFor.GetValueOrDefault(key, "related_to");
                    <div class="d-flex align-items-center gap-2 small">
                        <span class="badge bg-secondary" style="min-width:3.5rem;">@s.Similarity.ToString("F3")</span>
                        <a class="text-info text-decoration-none" href="/entity/@s.TargetEntityId">
                            <strong>@s.TargetName</strong>
                            <span class="text-muted ms-1">@s.TargetType</span>
                        </a>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary ms-auto"
                                style="width:auto;"
                                @bind="relTypeFor[key]"
                                disabled="@(adding == key || accepted.Contains(key))">
                            @foreach (var rt in RelationTypes)
                            {
                                <option value="@rt">@rt</option>
                            }
                        </select>
                        @if (accepted.Contains(key))
                        {
                            <span class="badge bg-success"><i class="bi bi-check-lg me-1"></i> added</span>
                        }
                        else if (adding == key)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-outline-info" @onclick="() => AddEdge(s, relType)">
                                <i class="bi bi-plus-lg"></i> Add
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => Dismiss(s)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        }
                    </div>
                }
            </div>
            @if (errorMessage != null)
            {
                <div class="alert alert-danger small mt-3 mb-0">@errorMessage</div>
            }
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    private static readonly string[] RelationTypes =
    {
        "related_to", "knows", "works_with", "located_at", "member_of",
        "owns", "carries", "wields", "wears", "drives", "frequents", "rival_of",
        "ally_of", "employed_by", "affiliated_with", "lives_at", "mentioned_with",
    };

    private bool loading = true;
    private string? errorMessage;
    private string? adding;
    private List<RelationshipDiscoveryService.SemanticEdgeSuggestion>? suggestions;
    private readonly Dictionary<string, string> relTypeFor = new();
    private readonly HashSet<string> accepted = new();
    private readonly HashSet<string> dismissed = new();

    private string lastLoadedFor = "";

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(Name, lastLoadedFor, StringComparison.OrdinalIgnoreCase)) return;
        lastLoadedFor = Name;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true; suggestions = null; errorMessage = null;
        accepted.Clear(); dismissed.Clear(); relTypeFor.Clear();
        StateHasChanged();
        try
        {
            var raw = await Discovery.SuggestSemanticEdgesAsync(Name, k: 8);
            suggestions = raw.ToList();
            foreach (var s in suggestions)
                relTypeFor[s.TargetEntityId.ToString()] = "related_to";
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "SemanticEdgeSuggestions load failed for {Name}", Name);
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task AddEdge(RelationshipDiscoveryService.SemanticEdgeSuggestion s, string relType)
    {
        var key = s.TargetEntityId.ToString();
        if (accepted.Contains(key) || adding == key) return;
        adding = key;
        errorMessage = null;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            // Resolve source entity by name (the parent EntityDetail page). Cheap
            // — Name is indexed via the unique slug.
            var source = await db.Entities.AsNoTracking()
                .Where(e => e.Name == Name)
                .Select(e => new { e.Id })
                .FirstOrDefaultAsync();
            if (source == null)
            {
                errorMessage = $"Source entity '{Name}' not found.";
                return;
            }
            // Idempotency guard — don't double-add an open edge of the same type.
            var existing = await db.Edges.AsNoTracking()
                .Where(e => e.SourceId == source.Id
                         && e.TargetId == s.TargetEntityId
                         && e.RelationType == relType
                         && e.StoryValidUntil == null)
                .AnyAsync();
            if (!existing)
            {
                db.Edges.Add(new Edge
                {
                    SourceId       = source.Id,
                    TargetId       = s.TargetEntityId,
                    RelationType   = relType,
                    Description    = $"Semantic edge accepted from /entity ({s.Similarity:F3} similarity)",
                    Weight         = s.Similarity,
                    Sentiment      = "neutral",
                    Source         = "ui:semantic_edge_suggestion",
                });
                await db.SaveChangesAsync();
            }
            // Refresh the in-memory graph so the suggestion no longer surfaces.
            try { Graph.EnsureFresh(); } catch { /* graph refresh is best-effort */ }
            accepted.Add(key);
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Add-edge failed for {Source}→{Target}", Name, s.TargetName);
            errorMessage = ex.Message;
        }
        finally
        {
            adding = null;
            StateHasChanged();
        }
    }

    private void Dismiss(RelationshipDiscoveryService.SemanticEdgeSuggestion s)
    {
        var key = s.TargetEntityId.ToString();
        dismissed.Add(key);
        suggestions?.RemoveAll(x => x.TargetEntityId == s.TargetEntityId);
        StateHasChanged();
    }
}
