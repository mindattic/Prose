@* Renders text with entity names as clickable cross-reference links.
   Usage:
     <XrefText Text="@someField" />
     <XrefText Text="@longDescription" Paragraphs="true" />
*@

@inject XrefService Xref
@inject NavigationManager Nav
@inject StreetSamurai.Core.Services.AppLinks Links

@if (Paragraphs)
{
    @foreach (var para in GetParagraphs())
    {
        <p>@RenderSegments(para)</p>
    }
}
else
{
    @RenderSegments(Text ?? "")
}

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    /// <summary>When true, splits on blank lines and wraps each paragraph in a &lt;p&gt; tag.</summary>
    [Parameter] public bool Paragraphs { get; set; }

    /// <summary>When true, forces NER auto-linking regardless of the global EnablePlainTextNer setting.</summary>
    [Parameter] public bool EnableNer { get; set; }

    private string currentPageId = "";

    protected override void OnParametersSet()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        currentPageId = System.Web.HttpUtility.ParseQueryString(uri.Query)["id"] ?? "";
    }

    private IEnumerable<string> GetParagraphs() =>
        (Text ?? "").Split(["\n\n", "\r\n\r\n"], StringSplitOptions.RemoveEmptyEntries);

    private RenderFragment RenderSegments(string text) => builder =>
    {
        int seq = 0;
        foreach (var seg in Xref.ParseSegments(text, EnableNer))
        {
            if (seg is XrefSegment xref)
            {
                if (xref.Entry.Id == currentPageId)
                {
                    builder.OpenElement(seq++, "strong");
                    builder.AddContent(seq++, xref.Text);
                    builder.CloseElement();
                }
                else
                {
                    builder.OpenElement(seq++, "a");
                    // Entity pages live in the Codex host — cross-app when this renders in Writer.
                    builder.AddAttribute(seq++, "href", Links.Codex($"{xref.Entry.Route}?id={xref.Entry.Id}"));
                    builder.AddAttribute(seq++, "class", $"xref-link xref-{xref.Entry.Type}");
                    builder.AddAttribute(seq++, "title", string.IsNullOrWhiteSpace(xref.Entry.Subtitle)
                        ? xref.Entry.Type
                        : $"{xref.Entry.Type} — {xref.Entry.Subtitle}");
                    builder.AddContent(seq++, xref.Text);
                    builder.CloseElement();
                }
            }
            else if (seg is BrokenLinkSegment broken)
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "xref-broken");
                builder.AddAttribute(seq++, "title", "Entity not found");
                builder.AddContent(seq++, broken.Text);
                builder.CloseElement();
            }
            else
            {
                builder.AddContent(seq++, seg.Text);
            }
        }
    };
}
