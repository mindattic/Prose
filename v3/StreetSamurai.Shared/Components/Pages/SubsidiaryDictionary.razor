@page "/subsidiaries"
@inject SubsidiaryRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject WorldGraphService Graph

<div class="dict-layout">
    <div class="dict-list">
        <div class="card bg-dark text-light border-secondary mb-2 card-body">
            <FilterBar AllTags="allTags" @bind-Filter="filter" SelectedTags="selectedTags" SelectedTagsChanged="OnTagsChanged" />

        </div>
        <div class="dict-items">
            @foreach (var s in SortedItems)
            {
                <div class="list-item text-light @(editing?.Name == s.Name ? "active" : "")" @onclick="() => Edit(s)">
                    <div class="fw-bold small">@s.Name</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@s.ParentCorponation</div>
                </div>
            }
        </div>
    </div>

    <div class="dict-editor">
        @if (editing != null)
        {
            <EditViewToggle RepoName="subsidiaries" Title="@(isNew ? "New Subsidiary" : editing.Name)" Json="@System.Text.Json.JsonSerializer.Serialize(editing)" HideToggle="@_confirmDelete" Rating="@(editing?.Rating ?? 0)" RatingChanged="OnRatingChanged">
                <HeaderButtons>
                    @if (!_confirmDelete)
                    {
                        <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i><div class="btn-lbl"> Save</div></button>
                        @if (!isNew) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-archive"></i></button> }
                    }
                    else
                    {
                        <span class="small text-muted me-1">Archive Entry?</span>
                        <button class="btn btn-sm btn-danger" @onclick="DoDelete"><div class="btn-lbl">Yes</div></button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false"><div class="btn-lbl">No</div></button>
                    }
                </HeaderButtons>
                <ChildContent>
                    <div class="row g-3 mb-3">
                        <div class="col-4"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Name" /></div>
                        <div class="col-4"><div class="field-label">Parent CorpoNation</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.ParentCorponation" /></div>
                        <div class="col-4"><div class="field-label">Line of Business</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.LineOfBusiness" /></div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-8"><div class="field-label">Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.Description"></textarea></div>
                        <div class="col-4">
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" @bind="editing.PublicFacing" />
                                <label class="form-check-label text-muted">Public Facing</label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3"><div class="field-label">Known Products (one per line)</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editKnownProducts"></textarea></div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <div style="flex: 1; min-width: 200px;"><div class="field-label">Image Prompt</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.MidjourneyPrompt"></textarea></div>
                        <div style="flex: 1; min-width: 200px;"><div class="field-label">DALL-E 3 Prompt</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.Dalle3Prompt"></textarea></div>
                    </div>
                </ChildContent>
            </EditViewToggle>
        }
        else { <div class="text-muted d-flex align-items-center justify-content-center h-100">Select a subsidiary or create a new one</div> }
    </div>
</div>

@code {
    private List<SubsidiaryData> items = [];
    private SubsidiaryData? editing;
    private bool isNew, _confirmDelete;
    private string originalName = "";
    private string filter = "";
    private List<(string name, int count)> allTags = [];
    private HashSet<string> selectedTags = [];
    private string editKnownProducts = "";

    private List<SubsidiaryData> FilteredItems
    {
        get
        {
            IEnumerable<SubsidiaryData> result = items;
            if (!string.IsNullOrWhiteSpace(filter))
                result = result.Where(s => s.Name.Contains(filter, StringComparison.OrdinalIgnoreCase));
            if (selectedTags.Count > 0)
                result = result.Where(s => selectedTags.All(t => s.Tags.Contains(t)));
            return result.ToList();
        }
    }
    private List<SubsidiaryData> SortedItems => FilteredItems.OrderBy(x => x.Name).ToList();

    protected override void OnInitialized() { Repo.Reload(); items = Repo.GetAll(); RebuildTags(); if (Nav.Uri.Contains("new=true")) AddNew(); else { var qid = Nav.Uri.Contains("id=") ? Uri.UnescapeDataString(Nav.Uri.Split(new[]{"id="}, StringSplitOptions.None).Last().Split(new[]{"&"}, StringSplitOptions.None)[0]) : ""; if (!string.IsNullOrEmpty(qid)) { var t = items.FirstOrDefault(e => e.Id == qid); if (t != null) Edit(t); } } }
    private void RebuildTags() { allTags = items.SelectMany(s => s.Tags).GroupBy(t => t).Select(g => (g.Key, g.Count())).OrderBy(t => t.Key).ToList(); }
    private void OnTagsChanged(HashSet<string> tags) { selectedTags = tags; }
    private void AddNew() { editing = new SubsidiaryData(); isNew = true; _confirmDelete = false; editKnownProducts = ""; }
    private void Edit(SubsidiaryData s) { _ = JS.InvokeVoidAsync("localStorage.setItem", "ss_sel_subsidiaries", s.Id); editing = s; originalName = s.Name; isNew = false; _confirmDelete = false; editKnownProducts = string.Join("\n", s.KnownProducts); if (!Nav.Uri.Contains("id=" + s.Id)) Nav.NavigateTo(Nav.Uri.Split('?')[0] + "?id=" + s.Id, forceLoad: false); }
    private void SaveEdit()
    {
        if (editing == null || string.IsNullOrWhiteSpace(editing.Name)) return;
        editing.KnownProducts = editKnownProducts.Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        if (!isNew && originalName != editing.Name) Repo.Delete(originalName);
        Repo.Save(editing); editing = null; items = Repo.GetAll(); RebuildTags();
    }
    private void DoDelete() { if (editing == null) return; Graph.RemoveNode(editing.Name); Repo.Delete(editing.Name); editing = null; _confirmDelete = false; items = Repo.GetAll(); RebuildTags(); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("writeInterop.autoResizeAll");
        if (firstRender && editing == null && items.Count > 0 && !Nav.Uri.Contains("new=true") && !Nav.Uri.Contains("id="))
        {
            var lastId = "";
            try { lastId = await JS.InvokeAsync<string>("localStorage.getItem", "ss_sel_subsidiaries") ?? ""; } catch { }
            var target = (!string.IsNullOrEmpty(lastId) ? items.FirstOrDefault(x => x.Id == lastId) : null) ?? items.First();
            if (target != null) { Edit(target); StateHasChanged(); }
        }
    }
    private List<(string name, string json)> GetExportEntries() => items.Select(e => (e.Name, System.Text.Json.JsonSerializer.Serialize(e))).ToList();
    private void OnRatingChanged(double value) { if (editing == null) return; editing.Rating = value; Repo.Save(editing); }
}