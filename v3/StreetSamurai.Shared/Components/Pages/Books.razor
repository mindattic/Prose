@page "/books"
@attribute [Authorize(Roles = "Contributor,Administrator")]
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@inject IBookRepository BookRepo
@inject IChapterRepository ChapterRepo
@inject NavigationManager Nav
@inject IWriteAccessProvider Access

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-danger mb-0"><i class="bi bi-book me-2"></i>Bookshelf</h4>
    <div class="d-flex gap-2 align-items-center">
        <a href="/series" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-collection"></i><div class="btn-lbl"> Series</div>
        </a>
        @if (Access.IsAdministrator)
        {
            <button class="btn btn-sm btn-outline-danger" @onclick="CreateNew">
                <i class="bi bi-plus-lg"></i><div class="btn-lbl"> New Book</div>
            </button>
        }
    </div>
</div>

@* ── New Book Modal ──────────────────────────────── *@
@if (newBookOpen)
{
    <div class="modal-backdrop fade show" style="z-index:1050;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index:1055;" @onclick="CloseNewBook">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content bg-dark text-light border-danger">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-danger"><i class="bi bi-book-half me-2"></i>New Book</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseNewBook"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Title <span class="text-danger">*</span></label>
                        <input class="form-control bg-black text-light border-secondary" @bind="newTitle" placeholder="Half Rate" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Tagline</label>
                        <input class="form-control bg-black text-light border-secondary" @bind="newTagline" placeholder="Some debts can't be paid in QUANTA." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Premise</label>
                        <textarea class="form-control bg-black text-light border-secondary" rows="3"
                                  @bind="newPremise" placeholder="One paragraph: who, what they want, what stands in their way."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Arc target</label>
                        <input class="form-control bg-black text-light border-secondary" @bind="newArcTarget"
                               placeholder="Where does this book land — redemption refused, downfall, escape?" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Protagonist(s) — comma-separated</label>
                        <input class="form-control bg-black text-light border-secondary" @bind="newProtagonists"
                               placeholder="Kyle Ellen Corbin-Vasik, Sasha Võ" />
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseNewBook">Cancel</button>
                    <button class="btn btn-danger btn-sm" @onclick="SaveNewBook"
                            disabled="@string.IsNullOrWhiteSpace(newTitle)">
                        <i class="bi bi-check-lg"></i> Create
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Archive Book Modal ──────────────────────────── *@
@if (archiveBook != null)
{
    <div class="modal-backdrop fade show" style="z-index:1050;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index:1055;" @onclick="CloseArchive">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content bg-dark text-light border-warning">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning"><i class="bi bi-archive me-2"></i>Archive Book</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseArchive"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">
                        You are about to archive <strong class="text-danger">@archiveBook.Title</strong>.
                        The book file moves to <code>engine/data/archives/books/</code>; chapters stay in place.
                    </p>
                    <p class="small text-muted mb-2">
                        To confirm, paste this book's id below:
                    </p>
                    <div class="mb-2">
                        <code class="user-select-all small text-info">@archiveBook.Id</code>
                    </div>
                    <input class="form-control bg-black text-light border-secondary font-monospace small"
                           @bind="archiveConfirmId"
                           @bind:event="oninput"
                           placeholder="Paste the book id to enable archive" />
                    @if (!string.IsNullOrEmpty(archiveError))
                    {
                        <div class="text-danger small mt-2">@archiveError</div>
                    }
                </div>
                <div class="modal-footer border-secondary">
                    <button class="btn btn-secondary btn-sm" @onclick="CloseArchive">Cancel</button>
                    <button class="btn btn-warning btn-sm" @onclick="ConfirmArchive"
                            disabled="@(!string.Equals(archiveConfirmId, archiveBook.Id, StringComparison.Ordinal))">
                        <i class="bi bi-archive"></i> Archive
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Bookshelf Grid ──────────────────────────────── *@
<div class="bookshelf-grid">
    @foreach (var book in books)
    {
        var chapterCount = book.ChapterIds.Count;
        var bookId = book.Id;
        <div class="book-card" @onclick="@(() => Nav.NavigateTo($"/books/{bookId}/chapters"))">
            <div class="book-card-cover" style="@CoverStyle(book)">
                @if (string.IsNullOrEmpty(book.CoverImageUrl))
                {
                    <div class="book-card-cover-templated">
                        <div class="book-card-protag">@(book.Protagonists.FirstOrDefault() ?? "")</div>
                        <div class="book-card-title">@book.Title.ToUpperInvariant()</div>
                        @if (!string.IsNullOrEmpty(book.Tagline))
                        {
                            <div class="book-card-tagline">@book.Tagline</div>
                        }
                    </div>
                }
                @if (Access.IsAdministrator)
                {
                    <button type="button"
                            class="book-card-archive-btn"
                            title="Archive this book"
                            @onclick="@(() => OpenArchive(book))"
                            @onclick:stopPropagation="true">
                        <i class="bi bi-archive"></i>
                    </button>
                }
            </div>
            <div class="book-card-meta">
                <span class="badge bg-secondary">@chapterCount @(chapterCount == 1 ? "chapter" : "chapters")</span>
                <span class="badge bg-dark text-muted">@book.Status</span>
            </div>
        </div>
    }

    @if (Access.IsAdministrator)
    {
        <div class="book-card book-card-new" @onclick="CreateNew">
            <div class="book-card-cover book-card-cover-new">
                <i class="bi bi-plus-lg"></i>
                <div class="small mt-2">New Book</div>
            </div>
        </div>
    }
</div>

@* ── Loose Chapters ──────────────────────────────── *@
@if (looseChapters.Any())
{
    <div class="mt-5">
        <h5 class="text-warning mb-2">
            <i class="bi bi-files me-2"></i>Loose Chapters
            <span class="text-muted small ms-2">— not yet assigned to a book</span>
        </h5>
        <div class="loose-chapters-strip">
            @foreach (var c in looseChapters)
            {
                <a class="loose-chapter-card" href="@($"/stories/write/{c.Id}")">
                    <div class="loose-chapter-title">@c.Title</div>
                    <div class="loose-chapter-meta">
                        @if (c.Characters.Any())
                        {
                            <span class="text-muted small">@string.Join(", ", c.Characters.Take(2))</span>
                        }
                        <span class="text-muted small ms-2">@c.Modified.ToString("yyyy-MM-dd")</span>
                    </div>
                </a>
            }
        </div>
    </div>
}

<style>
    .bookshelf-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 24px;
    }
    .book-card {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        cursor: pointer;
        transition: transform 0.15s ease;
    }
    .book-card:hover { transform: translateY(-4px); }
    .book-card-cover {
        aspect-ratio: 2 / 3;
        background-size: cover;
        background-position: center;
        background-color: #1a1a1a;
        border: 1px solid #333;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 16px rgba(0,0,0,0.6);
    }
    .book-card-cover-templated {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, #2a0a0a 0%, #0a0a1a 50%, #1a0a2a 100%);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 16px;
        color: #fff;
    }
    .book-card-protag {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #ff4444;
        font-weight: bold;
    }
    .book-card-title {
        font-family: 'Cinzel', 'Trajan Pro', serif;
        font-size: 1.4rem;
        font-weight: 900;
        line-height: 1.05;
        text-shadow: 0 2px 6px rgba(0,0,0,0.8);
        letter-spacing: 0.02em;
    }
    .book-card-tagline {
        font-size: 0.7rem;
        font-style: italic;
        color: #cccccc;
        text-shadow: 0 1px 3px rgba(0,0,0,0.8);
    }
    .book-card-meta {
        display: flex;
        gap: 6px;
        margin-top: 8px;
        flex-wrap: wrap;
    }
    .book-card-cover-new {
        background: transparent !important;
        border: 2px dashed #555 !important;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        color: #888;
        font-size: 2rem;
    }
    .book-card-new:hover .book-card-cover-new { border-color: #c00 !important; color: #c00; }

    .book-card-archive-btn {
        position: absolute;
        top: 6px;
        right: 6px;
        background: rgba(0, 0, 0, 0.55);
        border: 1px solid #444;
        color: #ddd;
        width: 28px;
        height: 28px;
        padding: 0;
        line-height: 1;
        border-radius: 3px;
        opacity: 0;
        transition: opacity 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }
    .book-card:hover .book-card-archive-btn { opacity: 1; }
    .book-card-archive-btn:hover { color: #ffc107; border-color: #ffc107; }

    .loose-chapters-strip {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        padding-bottom: 8px;
    }
    .loose-chapter-card {
        flex: 0 0 240px;
        background: #1a1a1a;
        border: 1px solid #333;
        border-left: 3px solid #ffc107;
        padding: 10px 12px;
        text-decoration: none;
        color: inherit;
        transition: border-left-color 0.15s ease;
    }
    .loose-chapter-card:hover { border-left-color: #c00; }
    .loose-chapter-title { font-weight: 600; font-size: 0.9rem; margin-bottom: 4px; color: #eee; }
    .loose-chapter-meta { font-size: 0.75rem; }
</style>

@code {
    private List<Book> books = [];
    private List<Chapter> looseChapters = [];

    private bool newBookOpen;
    private string newTitle = "";
    private string newTagline = "";
    private string newPremise = "";
    private string newArcTarget = "";
    private string newProtagonists = "";

    private Book? archiveBook;
    private string archiveConfirmId = "";
    private string archiveError = "";

    protected override void OnInitialized()
    {
        Reload();
    }

    private void Reload()
    {
        books = BookRepo.ListBooks();

        // A chapter is "loose" if its BookId is null OR points to a book that no longer exists.
        var bookIds = books.Select(b => b.Id).ToHashSet();
        looseChapters = ChapterRepo.ListChapters()
            .Where(c => string.IsNullOrEmpty(c.BookId) || !bookIds.Contains(c.BookId))
            .ToList();
    }

    private static string CoverStyle(Book book) =>
        string.IsNullOrEmpty(book.CoverImageUrl) ? "" : $"background-image: url('{book.CoverImageUrl}');";

    private void CreateNew()
    {
        if (!Access.IsAdministrator) return;
        newTitle = newTagline = newPremise = newArcTarget = newProtagonists = "";
        newBookOpen = true;
    }
    private void CloseNewBook() => newBookOpen = false;

    private void SaveNewBook()
    {
        if (!Access.IsAdministrator) return;
        if (string.IsNullOrWhiteSpace(newTitle)) return;
        var book = new Book
        {
            Title        = newTitle.Trim(),
            Tagline      = string.IsNullOrWhiteSpace(newTagline) ? null : newTagline.Trim(),
            Premise      = newPremise.Trim(),
            ArcTarget    = newArcTarget.Trim(),
            Protagonists = newProtagonists
                .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .ToList(),
            Status       = "drafting",
        };
        BookRepo.SaveBook(book);
        newBookOpen = false;
        // Land directly on the outline — that's where the work begins for a new book.
        Nav.NavigateTo($"/books/{book.Id}/outline");
    }

    private void OpenArchive(Book book)
    {
        if (!Access.IsAdministrator) return;
        archiveBook = book;
        archiveConfirmId = "";
        archiveError = "";
    }

    private void CloseArchive()
    {
        archiveBook = null;
        archiveConfirmId = "";
        archiveError = "";
    }

    private void ConfirmArchive()
    {
        if (!Access.IsAdministrator) return;
        if (archiveBook == null) return;
        if (!string.Equals(archiveConfirmId, archiveBook.Id, StringComparison.Ordinal))
        {
            archiveError = "The id you entered doesn't match. Paste the full book id shown above.";
            return;
        }
        BookRepo.ArchiveBook(archiveBook.Id);
        archiveBook = null;
        archiveConfirmId = "";
        archiveError = "";
        Reload();
    }
}
