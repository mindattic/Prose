    {
        selfRef?.Dispose();
    }

    private async Task LoadAsync()
    {
        loading = true;
        StateHasChanged();
        await using var db = await DbFactory.CreateDbContextAsync();
        nodes = await db.Nodes
            .Where(s => s.ParentNodeId == null) // top-level only on this view
            .AsNoTracking()
            .ToListAsync();
        var ids = nodes.Select(s => s.Id).ToHashSet();

        // Recursive descendant count: walk the parent → children map in memory
        // so a book node reports total beats across all chapter children,
        // not just the (zero) direct memberships. Single Node read + single
        // NodeBeat read covers the whole site; the in-memory rollup is O(N)
        // and cheaper than a recursive CTE per row.
        var parentMap = await db.Nodes
            .AsNoTracking()
            .Where(s => s.ParentNodeId != null)
            .Select(s => new { s.Id, s.ParentNodeId })
            .ToListAsync();
        var byParent = parentMap
            .GroupBy(s => s.ParentNodeId!.Value)
            .ToDictionary(g => g.Key, g => g.Select(x => x.Id).ToList());

        var perNodeBeatCount = await db.NodeBeats
            .GroupBy(sb => sb.NodeId)
            .Select(g => new { NodeId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.NodeId, x => x.Count);

        beatCounts = new Dictionary<Guid, int>(ids.Count);
        foreach (var top in ids)
        {
            int total = 0;
            var stack = new Stack<Guid>();
            stack.Push(top);
            var visited = new HashSet<Guid>();
            while (stack.Count > 0)
            {
                var id = stack.Pop();
                if (!visited.Add(id)) continue; // cycle guard
                total += perNodeBeatCount.GetValueOrDefault(id, 0);
                if (byParent.TryGetValue(id, out var kids))
                    foreach (var k in kids) stack.Push(k);
            }
            beatCounts[top] = total;
        }

        childCounts = byParent
            .Where(kvp => ids.Contains(kvp.Key))
            .ToDictionary(kvp => kvp.Key, kvp => kvp.Value.Count);

        // Load full child node entities for top-level parents that have children,
        // so the inline expansion view can render them without an extra round-trip.
        var parentIds = childCounts.Keys.ToHashSet();
        if (parentIds.Count > 0)
        {
            var childList = await db.Nodes
                .Where(s => s.ParentNodeId != null && parentIds.Contains(s.ParentNodeId.Value))
                .AsNoTracking()
                .ToListAsync();
            childNodes = childList
                .GroupBy(s => s.ParentNodeId!.Value)
                .ToDictionary(g => g.Key, g => g.ToList());

            // Also seed beat counts for children so the expanded rows show accurate counts.
            foreach (var kid in childList)
                if (!beatCounts.ContainsKey(kid.Id))
                    beatCounts[kid.Id] = perNodeBeatCount.GetValueOrDefault(kid.Id, 0);
        }
        else
        {
            childNodes = new();
        }

        // Page estimates: sum beat text length per node, divide by ~5.2 chars/word / 250 words/page.
        var allIds = nodes.Select(s => s.Id)
            .Concat(childNodes.Values.SelectMany(v => v.Select(c => c.Id)))
            .Distinct().ToList();
        var charCounts = await db.NodeBeats
            .AsNoTracking()
            .Where(sb => allIds.Contains(sb.NodeId) && sb.IsEnabled)
            .Join(db.Beats.AsNoTracking().Where(b => b.Text != null && b.Text != ""),
                  sb => sb.BeatId, b => b.Id, (sb, b) => new { sb.NodeId, b.Text })
            .GroupBy(x => x.NodeId)
            .Select(g => new { NodeId = g.Key, Chars = g.Sum(x => (long)x.Text!.Length) })
            .ToDictionaryAsync(x => x.NodeId);
        pageCounts = charCounts.ToDictionary(kvp => kvp.Key, kvp => (int)(kvp.Value.Chars / 5.2 / 250));
        audioDurations = charCounts.ToDictionary(kvp => kvp.Key, kvp =>
        {
            var totalMinutes = (int)(kvp.Value.Chars / 5.2 / 150);
            return totalMinutes >= 60
                ? $"{totalMinutes / 60}h {totalMinutes % 60:D2}m"
                : $"{totalMinutes}m";
        });

        grouped = nodes.GroupBy(s => s.Kind).OrderBy(g => g.Key);
        loading = false;
        StateHasChanged();
    }

