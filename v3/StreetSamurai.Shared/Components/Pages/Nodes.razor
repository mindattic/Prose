    private int BarPct(int count)
    {
        var max = scoreBuckets.Count > 0 ? scoreBuckets.Max(b => b.Value) : 0;
        return max <= 0 ? 0 : (int)Math.Round(count * 100.0 / max);
    }

    private static string ScoreBadge(int score) =>
        score >= 80 ? "bg-success" : score >= 60 ? "bg-info text-dark" : score >= 40 ? "bg-warning text-dark" : "bg-danger";

    // Enforces the hierarchy: series → story → chapter.
    // Returns an error message if the combination is invalid, null if OK.
    private static string? KindCompatibilityError(string parentKind, string childKind) => (parentKind, childKind) switch
    {
        ("series", "story")   => null,
        ("story",  "chapter") => null,
        ("story",  "story")   => "A story cannot contain another story — only a series can.",
        ("series", "chapter") => "A chapter must be under a story, not directly under a series.",
        ("chapter", _)        => "A chapter cannot contain other nodes (it holds beats).",
        _                     => $"A '{childKind}' cannot be placed under a '{parentKind}'.",
    };
}
