@page "/nodes"
@page "/stories"
@page "/strands"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@using Microsoft.EntityFrameworkCore
@using StreetSamurai.Core.Data
@using StreetSamurai.Shared.Services
@using NodeEntity = StreetSamurai.Core.Data.Entities.Node
@inject IDbContextFactory<StreetSamuraiDbContext> DbFactory
@inject NavigationManager Nav
@inject ToastNotifier Toast
@inject IJSRuntime JS
@inject StreetSamurai.Core.Services.IUniverseContext Universe
@inject StreetSamurai.Core.Services.NodeWorkbenchService Workbench
@inject StreetSamurai.Core.Services.DocxExportService Docx
@inject StreetSamurai.Core.Services.ManuscriptExportService Manuscript
@inject StreetSamurai.Core.Services.NodeReviewService ReviewSvc
@inject StreetSamurai.Shared.Services.TabService TabSvc
@implements IDisposable

@*
   Story index over the node tree (SeriesNode / StoryNode / ChapterNode).
   Lists every top-level node grouped by kind. Click to open in the
   unified writer/recorder at /node/{id}. The Create CTA below creates a
   blank top-level node and routes you there.
*@

<div class="container py-3" style="max-width: 1100px;" id="nodes-list-root">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="text-danger mb-0"><i class="bi bi-collection me-2"></i>Stories</h4>
            <div class="text-muted small">Series contain stories; stories contain chapters; chapters contain beats.</div>
        </div>
        <div class="d-flex gap-2 align-items-end">
            <input class="form-control form-control-sm bg-black text-light border-secondary"
                   placeholder="New story title…" @bind="newTitle" @bind:event="oninput" style="width:240px;" />
            <select class="form-select form-select-sm bg-black text-light border-secondary" @bind="newKind" style="width:120px;">
                <option value="series">series</option>
                <option value="story">story</option>
                <option value="chapter">chapter</option>
            </select>
            <button class="btn btn-sm btn-outline-info" @onclick="CreateAsync" disabled="@(string.IsNullOrWhiteSpace(newTitle))">
                <i class="bi bi-plus-circle me-1"></i>Create
            </button>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading stories…</div>
    }
    else if (nodes.Count == 0)
    {
        <div class="card bg-dark border-secondary text-center py-5">
            <div class="text-muted mb-2">
                <i class="bi bi-stars" style="font-size:2rem; opacity:0.4;"></i>
            </div>
            <h6 class="text-light mb-2">No stories yet</h6>
            <div class="text-muted small mb-3">
                The tree has three levels — a <em>series</em> groups stories, a <em>story</em> is a single arc, and its <em>chapters</em> hold the beats.
                <br />Type a title above and click Create, or run <code>ss --write-story --seed "&hellip;"</code> from the CLI to generate one with the LLM.
            </div>
        </div>
    }
    else
    {
        @foreach (var group in grouped)
        {
            <div class="card bg-dark border-secondary mb-3">
                <div class="card-header py-2 px-3">
                    <span class="text-uppercase text-muted small">@group.Key</span>
                    <span class="text-muted small ms-2">@group.Count() node(s)</span>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var s in group.OrderBy(x => x.Title))
                    {
                        var beatCount = beatCounts.GetValueOrDefault(s.Id, 0);
                        var childCount = childCounts.GetValueOrDefault(s.Id, 0);
                        <li class="list-group-item bg-dark text-light border-secondary" data-node-id="@s.Id" data-has-children="@(childCount > 0 ? "true" : "false")">
                            @if (editingId == s.Id)
                            {
                                @* ── Inline edit: title + full description ───────────────── *@
                                <div class="mb-2">
                                    <label class="form-label small text-muted mb-1">Title</label>
                                    <input class="form-control form-control-sm bg-black text-light border-secondary"
                                           @bind="editTitle" @bind:event="oninput" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small text-muted mb-1">Synopsis <span class="text-muted" style="font-size:0.75em">(internal generation seed)</span></label>
                                    <textarea class="form-control form-control-sm bg-black text-light border-secondary"
                                              rows="3" placeholder="One-line generation seed / logline"
                                              @bind="editSynopsis" @bind:event="oninput"></textarea>
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small text-muted mb-1">Summary <span class="text-muted" style="font-size:0.75em">(back-of-book / KDP)</span></label>
                                    <textarea class="form-control form-control-sm bg-black text-light border-secondary"
                                              rows="5" placeholder="~100–150 word jacket blurb for KDP / store listings"
                                              @bind="editSummary" @bind:event="oninput"></textarea>
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-success" @onclick="SaveEditAsync"
                                            disabled="@(savingEdit || string.IsNullOrWhiteSpace(editTitle))">
                                        @if (savingEdit) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                        <i class="bi bi-check-lg me-1"></i>Save
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit" disabled="@savingEdit">Cancel</button>
                                    <code class="text-muted node-guid ms-auto align-self-center">@s.Id</code>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="node-drag-handle me-2" title="Drag to reorder or move into a collection">
                                        <i class="bi bi-grip-vertical"></i>
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(s.NodeCode))
                                    {
                                        <span class="node-code-chip me-1" title="Node code">@s.NodeCode</span>
                                    }
                                    <a href="@($"/node/{s.Slug}")" class="text-info text-decoration-none flex-grow-1"
                                       @onclick:preventDefault @onclick="() => OpenNode(s.Slug)">
                                        <strong>@s.Title</strong>
                                    </a>
                                    <div class="d-flex align-items-center gap-2 small">
                                        @if (childCount > 0)
                                        {
                                            <button class="btn btn-sm btn-link text-muted p-0 border-0"
                                                    title="@(expandedParents.Contains(s.Id) ? "Collapse episodes" : "Expand episodes")"
                                                    @onclick="() => ToggleExpand(s.Id)">
                                                <i class="bi bi-diagram-3 me-1"></i>@childCount
                                                <i class="bi bi-chevron-@(expandedParents.Contains(s.Id) ? "up" : "down") ms-1" style="font-size:0.65rem;"></i>
                                            </button>
                                        }
                                        @if (beatCount > 0)
                                        {
                                            <span class="text-muted" title="Beats across all episodes">
                                                <i class="bi bi-three-dots me-1"></i>@beatCount
                                            </span>
                                        }
                                        @{ var pages = pageCounts.GetValueOrDefault(s.Id, 0); }
                                        @if (pages > 0)
                                        {
                                            <span class="text-muted" title="Estimated pages (word count ÷ 250)">
                                                <i class="bi bi-file-text me-1"></i>@pages pg
                                            </span>
                                        }
                                        @{ var audioDur = audioDurations.GetValueOrDefault(s.Id); }
                                        @if (!string.IsNullOrEmpty(audioDur))
                                        {
                                            <span class="text-muted" title="Estimated audio duration (word count ÷ 150 wpm)">
                                                <i class="bi bi-headphones me-1"></i>@audioDur
                                            </span>
                                        }
                                        @if (s.Score.HasValue)
                                        {
                                            <span class="badge @ScoreBadge((int)Math.Round(s.Score.Value))" title="Reader score (latest run)">
                                                <i class="bi bi-star-half me-1"></i>@s.Score.Value.ToString("0")%
                                            </span>
                                        }
                                        <span class="badge bg-@StatusColor(s.Status) text-uppercase">@StatusLabel(s.Status)</span>
                                        <button class="btn btn-sm btn-outline-light" title="Edit title &amp; description"
                                                @onclick="() => BeginEdit(s)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-warning" title="Show reader reviews"
                                                @onclick="() => OpenReviewsAsync(s)">
                                            <i class="bi bi-star-half me-1"></i>Reviews
                                        </button>
                                        <button class="btn btn-sm btn-outline-info" title="Score history chart"
                                                @onclick="() => OpenScoreHistory(s)">
                                            <i class="bi bi-graph-up"></i>
                                        </button>
                                        @if (childCount > 0)
                                        {
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-success dropdown-toggle" type="button"
                                                        data-bs-toggle="dropdown"
                                                        disabled="@(exportingCollectionId == s.Id)"
                                                        title="Export the full collection — all episodes concatenated">
                                                    @if (exportingCollectionId == s.Id)
                                                    {
                                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                                    }
                                                    else
                                                    {
                                                        <i class="bi bi-collection-play me-1"></i>
                                                    }
                                                    Export Collection
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                                    <li><h6 class="dropdown-header">Audio</h6></li>
                                                    <li>
                                                        <button class="dropdown-item" @onclick="() => ExportCollectionAudiobookAsync(s.Id)">
                                                            <i class="bi bi-mic me-2"></i>Export Audio (.mp3)
                                                        </button>
                                                    </li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li><h6 class="dropdown-header">Manuscript</h6></li>
                                                    <li>
                                                        <button class="dropdown-item" @onclick="() => ExportCollectionManuscriptAsync(s.Id)">
                                                            <i class="bi bi-file-earmark-richtext me-2"></i>Export Manuscript (.epub + .docx + .pdf)
                                                        </button>
                                                    </li>
                                                    <li>
                                                        <button class="dropdown-item" @onclick='() => ExportCollectionAsync(s.Id, "MARKDOWN", "Markdown .md", id => Manuscript.ExportMarkdownAsync(id))'>
                                                            <i class="bi bi-markdown me-2"></i>Markdown (.md)
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        }
                                    </div>
                                </div>
                                @* Full description — so you can see what each story is about at a glance. *@
                                @if (!string.IsNullOrWhiteSpace(s.Synopsis))
                                {
                                    <div class="node-synopsis-line mt-1">@s.Synopsis</div>
                                }
                                else
                                {
                                    <div class="node-synopsis-line node-synopsis-empty mt-1">No description yet — click the pencil to add one.</div>
                                }
                                @* Full GUID — a stable handle to refer to this node (CLI, conversation). Click to copy. *@
                                <code class="text-muted node-guid" title="Click to copy full id"
                                      @onclick="() => CopyGuidAsync(s.Id)">@s.Id</code>
                            }
                        </li>
                        @* ── Inline child nodes (expanded when the episode count badge is clicked) ── *@
                        @if (expandedParents.Contains(s.Id) && childNodes.TryGetValue(s.Id, out var kids))
                        {
                            @foreach (var kid in kids.OrderBy(k => k.SortKey).ThenBy(k => k.Title))
                            {
                                var kidBeats = beatCounts.GetValueOrDefault(kid.Id, 0);
                                <li class="list-group-item bg-dark text-light border-secondary node-child-row" data-node-id="@kid.Id" data-has-children="false">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="node-drag-handle me-1" title="Drag to reorder or move to a different collection">
                                            <i class="bi bi-grip-vertical"></i>
                                        </span>
                                        <a href="@($"/node/{kid.Slug}")" class="text-info text-decoration-none flex-grow-1 ms-2"
                                           @onclick:preventDefault @onclick="() => OpenNode(kid.Slug)">
                                            <i class="bi bi-arrow-return-right me-2 text-secondary" style="font-size:0.75rem;"></i>@kid.Title
                                        </a>
                                        <div class="d-flex align-items-center gap-2 small">
                                            @if (kidBeats > 0)
                                            {
                                                <span class="text-muted"><i class="bi bi-three-dots me-1"></i>@kidBeats</span>
                                            }
                                            @if (kid.Score.HasValue)
                                            {
                                                <span class="badge @ScoreBadge((int)Math.Round(kid.Score.Value))">
                                                    <i class="bi bi-star-half me-1"></i>@kid.Score.Value.ToString("0")%
                                                </span>
                                            }
                                            <span class="badge bg-@StatusColor(kid.Status) text-uppercase">@StatusLabel(kid.Status)</span>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(kid.Synopsis))
                                    {
                                        <div class="node-synopsis-line mt-1 ms-4">@kid.Synopsis</div>
                                    }
                                </li>
                            }
                        }
                    }
                </ul>
            </div>
        }
    }
</div>

@* ── Score history chart modal ───────────────────────────────────────── *@
<ScoreHistoryModal Visible="scoreHistoryOpen"
                   NodeId="scoreHistoryNodeId"
                   NodeTitle="scoreHistoryTitle"
                   OnClose="() => scoreHistoryOpen = false" />

@* ── Reader-reviews bottom sheet ─────────────────────────────────────── *@
@if (reviewsOpen)
{
    <div class="review-sheet-backdrop" @onclick="CloseReviews"></div>
    <div class="review-sheet" @onclick:stopPropagation>
        <div class="review-sheet-header d-flex justify-content-between align-items-start gap-2">
            <div>
                <strong class="text-light"><i class="bi bi-star-half me-1 text-warning"></i>Reader reviews — @reviewsTitle</strong>
                <div><code class="node-guid">@reviewsNodeId</code></div>
            </div>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CloseReviews"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="review-sheet-body">
            @if (reviewsLoading)
            {
                <div class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading reviews…</div>
            }
            else if (reviewList.Count == 0)
            {
                <div class="text-muted">
                    No reviews yet for this node. Run
                    <code>ss --review-story --slug @reviewsSlug --readers 128</code> to generate them.
                </div>
            }
            else
            {
                @if (reviewSummary != null)
                {
                    <div class="review-summary mb-3">
                        <div class="d-flex align-items-center gap-3 flex-wrap mb-2">
                            <span class="review-avg">@reviewSummary.AvgScore.ToString("0.0")<span class="review-avg-max">/100</span></span>
                            <span class="text-muted small">@reviewSummary.ReviewCount reviews · generated @reviewSummary.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            @if (reviewStaleNote)
                            {
                                <span class="badge bg-danger" title="The node's beat count changed since these reviews were written.">story edited since</span>
                            }
                        </div>
                        @foreach (var b in scoreBuckets)
                        {
                            <div class="d-flex align-items-center gap-2 review-bar-row">
                                <span class="review-bar-label">@b.Key</span>
                                <div class="review-bar-track"><div class="review-bar-fill" style="width:@(BarPct(b.Value))%"></div></div>
                                <span class="review-bar-count">@b.Value</span>
                            </div>
                        }
                        <div class="review-summary-md mt-2">@reviewSummary.SummaryMarkdown</div>
                    </div>
                    <hr class="border-secondary" />
                }
                <div class="review-list">
                    @foreach (var r in reviewList)
                    {
                        <div class="review-card">
                            <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                                <div>
                                    <strong class="text-light">@r.PersonaName</strong>
                                    <span class="badge bg-secondary ms-1" title="@r.Model">@r.ProviderId</span>
                                </div>
                                <span class="badge @ScoreBadge(r.Score)">@r.Score/100</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(r.PersonaBlurb))
                            {
                                <div class="text-muted review-blurb">@r.PersonaBlurb</div>
                            }
                            <div class="review-text">@r.ReviewText</div>
                            @if (!string.IsNullOrWhiteSpace(r.Improvements))
                            {
                                <ul class="review-fixes">
                                    @foreach (var fix in r.Improvements.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                    {
                                        <li>@fix</li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

<style>
    .node-code-chip { font-size: 0.65rem; font-weight: 700; color: #0dcaf0; background: rgba(13,202,240,0.1); border: 1px solid rgba(13,202,240,0.3); border-radius: 3px; padding: 1px 5px; letter-spacing: 0.04em; font-family: monospace; flex-shrink: 0; }
    .node-guid { font-size: 0.68rem; color: #6c757d; cursor: pointer; }
    .node-guid:hover { color: #0dcaf0; }
    .node-synopsis-line { font-size: 0.85rem; color: #adb5bd; white-space: pre-wrap; line-height: 1.35; }
    .node-synopsis-empty { font-style: italic; color: #5c636a; }
    .review-sheet-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 1080; }
    .review-sheet {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 1090;
        background: #0f0f0f; border-top: 1px solid #2a2a2a;
        box-shadow: 0 -8px 24px rgba(0,0,0,0.5);
        max-height: 82vh; overflow-y: auto;
        animation: review-sheet-rise 0.18s ease-out;
    }
    @@keyframes review-sheet-rise { from { transform: translateY(100%); } to { transform: translateY(0); } }
    .review-sheet-header { padding: 0.75rem 1rem; border-bottom: 1px solid #2a2a2a; position: sticky; top: 0; background: #0f0f0f; z-index: 1; }
    .review-sheet-body { padding: 0.85rem 1rem 1.5rem; max-width: 920px; margin: 0 auto; }
    .review-avg { font-size: 2rem; font-weight: 700; color: #ffc107; line-height: 1; }
    .review-avg-max { font-size: 0.9rem; color: #6c757d; font-weight: 400; }
    .review-bar-row { font-size: 0.75rem; }
    .review-bar-label { width: 52px; color: #adb5bd; text-align: right; }
    .review-bar-track { flex-grow: 1; height: 8px; background: #1c1c1c; border-radius: 4px; overflow: hidden; }
    .review-bar-fill { height: 100%; background: #ffc107; }
    .review-bar-count { width: 28px; color: #adb5bd; }
    .review-summary-md { color: #e6edf3; font-size: 0.9rem; white-space: pre-wrap; background: rgba(255,193,7,0.05); border: 1px solid rgba(255,193,7,0.25); border-radius: 6px; padding: 0.6rem 0.8rem; }
    .review-card { border: 1px solid #2a2a2a; border-radius: 6px; padding: 0.6rem 0.8rem; margin-bottom: 0.6rem; background: #161616; }
    .review-blurb { font-size: 0.72rem; font-style: italic; margin-bottom: 0.35rem; }
    .review-text { color: #ced4da; font-size: 0.88rem; white-space: pre-wrap; }
    .review-fixes { margin: 0.4rem 0 0; padding-left: 1.1rem; color: #9fb6c2; font-size: 0.82rem; }
    .review-fixes li { margin-bottom: 0.15rem; }
    .node-child-row { background: #0d0d0d !important; border-left: 2px solid #1a3a2a !important; }
    .node-child-row:hover { background: #111 !important; }
    .node-drag-handle { cursor: grab; color: #4a4a4a; user-select: none; flex-shrink: 0; }
    .node-drag-handle:hover { color: #0dcaf0; }
    .node-drag-handle:active { cursor: grabbing; }
    [data-node-id].node-dragging { opacity: 0.45; }
    [data-node-id].node-drop-before { box-shadow: inset 0 3px 0 0 #0dcaf0 !important; }
    [data-node-id].node-drop-after  { box-shadow: inset 0 -3px 0 0 #0dcaf0 !important; }
    [data-node-id].node-drop-child  { background: rgba(13,202,240,0.07) !important; outline: 2px solid rgba(13,202,240,0.45); outline-offset: -2px; }
</style>

@code {
    private bool loading = true;
    private List<NodeEntity> nodes = new();
    private IEnumerable<IGrouping<string, NodeEntity>> grouped = Array.Empty<IGrouping<string, NodeEntity>>();
    private DotNetObjectReference<Nodes>? selfRef;
    private bool dragAttached;
    /// <summary>Direct-beat count per top-level node id. Lets the index
    /// show a "this has stuff" cue without opening every node.</summary>
    private Dictionary<Guid, int> beatCounts = new();
    /// <summary>Number of direct child nodes per top-level node id —
    /// e.g. a book node reports its chapter count here.</summary>
    private Dictionary<Guid, int> childCounts = new();
    /// <summary>Full child node entities per top-level node id — populated for inline expansion.</summary>
    private Dictionary<Guid, List<NodeEntity>> childNodes = new();
    /// <summary>Top-level node ids whose children are currently expanded inline.</summary>
    private HashSet<Guid> expandedParents = new();
    /// <summary>Estimated page count per node id (word count / 250).</summary>
    private Dictionary<Guid, int> pageCounts = new();
    /// <summary>Estimated audio duration per node id, formatted as "Xh Ym" at 150 wpm.</summary>
    private Dictionary<Guid, string> audioDurations = new();
    /// <summary>Id of the parent node currently running a collection export. Null when idle.</summary>
    private Guid? exportingCollectionId;
    private string newTitle = "";
    private string newKind = "story";

    // ── Inline title/synopsis/summary editing ────────────────────────────
    private Guid? editingId;
    private string editTitle = "";
    private string editSynopsis = "";
    private string editSummary = "";
    private bool savingEdit;

    private void BeginEdit(NodeEntity s)
    {
        editingId = s.Id;
        editTitle = s.Title;
        editSynopsis = s.Synopsis ?? "";
        editSummary = s.Summary ?? "";
    }

    private void CancelEdit()
    {
        editingId = null;
        editTitle = editSynopsis = editSummary = "";
    }

    private async Task SaveEditAsync()
    {
        if (editingId is not { } id || string.IsNullOrWhiteSpace(editTitle)) return;
        savingEdit = true;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.Nodes.FirstOrDefaultAsync(x => x.Id == id);
            if (entity == null) { Toast.Error("NODE-EDIT", "Story not found."); return; }
            entity.Title = editTitle.Trim();
            entity.Synopsis = string.IsNullOrWhiteSpace(editSynopsis) ? null : editSynopsis.Trim();
            entity.Summary = string.IsNullOrWhiteSpace(editSummary) ? null : editSummary.Trim();
            entity.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();

            // Reflect the change in the already-loaded list without a full reload.
            var local = nodes.FirstOrDefault(x => x.Id == id);
            if (local != null) { local.Title = entity.Title; local.Synopsis = entity.Synopsis; local.Summary = entity.Summary; }
            grouped = nodes.GroupBy(s => s.Kind).OrderBy(g => g.Key);
            CancelEdit();
            Toast.Info("SAVED", "Story updated.");
        }
        catch (Exception ex)
        {
            Toast.Error("NODE-EDIT-FAIL", ex.InnerException?.Message ?? ex.Message);
        }
        finally
        {
            savingEdit = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!dragAttached && !loading)
        {
            try
            {
                selfRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("streetsamurai.attachNodeDragHandlers", "nodes-list-root", selfRef);
                dragAttached = true;
            }
            catch { /* JS not loaded yet — will retry on next render */ }
        }
    }

    [Microsoft.JSInterop.JSInvokable]
    public async Task OnNodeDropped(string draggedId, string targetId, string mode)
    {
        if (!Guid.TryParse(draggedId, out var dragId) ||
            !Guid.TryParse(targetId, out var targetGuid)) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var dragged = await db.Nodes.FirstOrDefaultAsync(s => s.Id == dragId);
        var target  = await db.Nodes.FirstOrDefaultAsync(s => s.Id == targetGuid);
        if (dragged == null || target == null) return;

        Guid? newParentId;
        double newSortKey;

        if (mode == "child")
        {
            // Append as last child of the target collection.
            newParentId = target.Id;
            var maxSk = await db.Nodes
                .Where(s => s.ParentNodeId == target.Id && s.Id != dragId)
                .MaxAsync(s => (double?)s.SortKey) ?? 0.0;
            newSortKey = maxSk + 100.0;
        }
        else
        {
            // "before" or "after" — insert as sibling of target at target's parent level.
            newParentId = target.ParentNodeId;
            var siblings = await db.Nodes
                .Where(s => s.ParentNodeId == newParentId && s.Id != dragId)
                .OrderBy(s => s.SortKey)
                .Select(s => new { s.Id, s.SortKey })
                .ToListAsync();
            var targetIdx = siblings.FindIndex(s => s.Id == targetGuid);

            if (mode == "after")
            {
                var prevSk = targetIdx >= 0 ? siblings[targetIdx].SortKey : 0.0;
                var nextSk = (targetIdx >= 0 && targetIdx + 1 < siblings.Count)
                    ? siblings[targetIdx + 1].SortKey : prevSk + 200.0;
                newSortKey = (prevSk + nextSk) / 2.0;
            }
            else // "before"
            {
                var nextSk = targetIdx >= 0 ? siblings[targetIdx].SortKey : 100.0;
                var prevSk = targetIdx > 0 ? siblings[targetIdx - 1].SortKey : nextSk - 200.0;
                newSortKey = (prevSk + nextSk) / 2.0;
            }
        }

        // Enforce kind hierarchy: series→story→chapter. Reject invalid drops.
        if (newParentId.HasValue)
        {
            var parentNode = mode == "child"
                ? target
                : await db.Nodes.AsNoTracking().FirstOrDefaultAsync(s => s.Id == newParentId);
            if (parentNode != null)
            {
                var err = KindCompatibilityError(parentNode.Kind, dragged.Kind);
                if (err != null) { Toast.Error("DROP-INVALID", err); return; }
            }
        }
        else if (dragged is StreetSamurai.Core.Data.Entities.ChapterNode)
        {
            Toast.Error("DROP-INVALID", "A chapter must be under a story. Drop it onto a story instead.");
            return;
        }

        dragged.ParentNodeId = newParentId;
        dragged.SortKey = newSortKey;
        dragged.UpdatedAt = DateTime.UtcNow;
        await db.SaveChangesAsync();

        dragAttached = false;
        await InvokeAsync(LoadAsync);
    }

