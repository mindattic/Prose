    private async Task ExportCollectionManuscriptAsync(Guid nodeId)
    {
        if (exportingCollectionId != null) return;
        exportingCollectionId = nodeId;
        await InvokeAsync(StateHasChanged);
        try
        {
            // docx first — it increments node.Version; the rest then share that version.
            await Docx.ExportNodeAsync(nodeId);
