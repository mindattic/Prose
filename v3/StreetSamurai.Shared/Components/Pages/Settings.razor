                               value="@SettingsSvc.TtsPauseSectionMs"
                               @onchange="@(e => SettingsSvc.TtsPauseSectionMs = int.Parse(e.Value?.ToString() ?? "1800"))" />
                        <div class="text-muted small">After paragraphs preceding a <code>##</code> section header.</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small">Scene break: @SettingsSvc.TtsPauseSceneMs ms</label>
                        <input type="range" class="form-range" min="0" max="3000" step="50"
                               value="@SettingsSvc.TtsPauseSceneMs"
                               @onchange="@(e => SettingsSvc.TtsPauseSceneMs = int.Parse(e.Value?.ToString() ?? "1000"))" />
                        <div class="text-muted small">After paragraphs preceding a <code>---</code> divider.</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small">Paragraph: @SettingsSvc.TtsPauseParagraphMs ms</label>
                        <input type="range" class="form-range" min="0" max="2000" step="25"
                               value="@SettingsSvc.TtsPauseParagraphMs"
                               @onchange="@(e => SettingsSvc.TtsPauseParagraphMs = int.Parse(e.Value?.ToString() ?? "400"))" />
                        <div class="text-muted small">After paragraphs ending on <code>.</code>/<code>!</code>/<code>?</code>/<code>"</code>.</div>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small">Continuation: @SettingsSvc.TtsPauseContinuationMs ms</label>
                        <input type="range" class="form-range" min="0" max="1500" step="25"
                               value="@SettingsSvc.TtsPauseContinuationMs"
                               @onchange="@(e => SettingsSvc.TtsPauseContinuationMs = int.Parse(e.Value?.ToString() ?? "200"))" />
                        <div class="text-muted small">After paragraphs ending mid-sentence (comma, em-dash, no terminator).</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Audio Storage ────────────────────────────────────── *@
@* Local-first recording: beats stay on disk during a session. The deploy
   hook pushes them up to Azure Blob automatically. This card is the
   manual lever for the rare reverse case — pulling down beats recorded
   on production into the local backup so a developer can scrub/publish
   from local. *@
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted d-flex justify-content-between align-items-center">
                <span>Audio Storage — Local ⇄ Azure Blob</span>
                @if (audioSyncLastReport != null)
                {
                    <span class="badge @(audioSyncLastReport.Failed == 0 ? "bg-success" : "bg-warning")">
                        Last sync: @audioSyncLastReport.Beats scanned · @audioSyncLastReport.CopiedAToB↑ · @audioSyncLastReport.CopiedBToA↓
                    </span>
                }
            </div>
            <div class="card-body">
                <p class="text-muted small mb-2">
                    Recordings made on localhost stay local during your session and ride to Azure Blob on the next deploy.
                    Recordings made on production live in Azure Blob — click below to pull them down to your local backup
                    for editing or publishing offline. The sync is bidirectional newest-wins per beat (±2 s tolerance);
                    safe to run any time.
                </p>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-info" @onclick="RunAudioSyncAsync" disabled="@audioSyncRunning">
                        @if (audioSyncRunning)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span><text>Syncing...</text>
                        }
                        else
                        {
                            <i class="bi bi-cloud-arrow-down-fill me-1"></i><text>Sync now (cloud ⇄ local)</text>
                        }
                    </button>
                    @if (audioSyncLastReport != null)
                    {
                        <span class="text-muted small">
                            in-sync @audioSyncLastReport.InSync ·
                            new on local @audioSyncLastReport.CreatedOnA ·
                            new on blob @audioSyncLastReport.CreatedOnB ·
                            failed @audioSyncLastReport.Failed
                        </span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

