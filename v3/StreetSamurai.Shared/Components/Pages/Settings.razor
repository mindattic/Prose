    private Task RetestDeepseek() => RetestProvider("deepseek");
    private Task RetestMistral() => RetestProvider("mistral");
    private Task RetestGrok() => RetestProvider("grok");
    private Task RetestGroq() => RetestProvider("groq");
    private Task RetestTogether() => RetestProvider("together");
