@page "/settings"
@inject SettingsService SettingsSvc
@inject IWriteAccessProvider Access
@inject LlmRouter LlmRouter
@inject ElevenLabsTtsService TtsSvc
@inject WorldGraphService Graph
@inject IPathProvider Paths
@inject XrefService XrefSvc
@inject ExportDiscoveryService ExportDiscovery
@inject CanonExportService CanonExport
@inject HtmlExportService HtmlExportSvc
@inject EmailService EmailSvc
@inject PasswordPolicyDescriptor Policy
@inject AuthenticationStateProvider AuthStateProvider
@inject StreetSamurai.Core.Services.AudioReconciliationService AudioReconciler
@inject StreetSamurai.Core.Interfaces.IAudioStore RuntimeAudioStore
@inject StreetSamurai.Shared.Services.ToastNotifier Toast
@inject Microsoft.Extensions.Configuration.IConfiguration AppConfig
@inject Microsoft.Extensions.Logging.ILoggerFactory AppLogs
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging
@using StreetSamurai.Core.Interfaces
@using StreetSamurai.Core.Services

@if (Access.IsAdministrator)
{
<div class="d-flex justify-content-between align-items-center mb-1">
    <h4 class="text-danger mb-0">Settings</h4>
    <div class="d-flex gap-2">
        <a href="/settings/ai" class="btn btn-sm btn-outline-info">
            <i class="bi bi-cpu"></i><div class="btn-lbl"> AI Panels</div>
        </a>
        <button class="btn btn-sm btn-success" @onclick="SaveSettings">
            <i class="bi bi-floppy"></i><div class="btn-lbl"> Save</div>
        </button>
        @if (confirmReset)
        {
            <span class="d-flex align-items-center gap-1">
                <small class="text-warning">Reset all settings to defaults?</small>
                <button class="btn btn-sm btn-danger" @onclick="DoReset"><div class="btn-lbl">Yes</div></button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirmReset = false"><div class="btn-lbl">No</div></button>
            </span>
        }
        else
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirmReset = true">
                <i class="bi bi-arrow-counterclockwise"></i><div class="btn-lbl"> Reset to Defaults</div>
            </button>
        }
    </div>
</div>
<p class="text-muted mb-3">Configure API keys, LLM providers, TTS narration, and canon paths.</p>

@* ── Display ──────────────────────────────────────────── *@
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted">Display</div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label text-muted">Theme</label>
                        <select class="form-select bg-dark text-light border-secondary" @bind="SettingsSvc.Theme">
                            <option value="auto">Auto (Universe)</option>
                            <option value="glmz">GLMZ</option>
                            <option value="fantasy">Fantasy</option>
                            <option value="dark">Dark</option>
                            <option value="light">Light</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted">UI Font</label>
                        <select class="form-select bg-dark text-light border-secondary" @bind="SettingsSvc.FontFamily">
                            <option value="Outfit">Outfit</option>
                            <option value="Inter">Inter</option>
                            <option value="Roboto">Roboto</option>
                            <option value="Source Sans 3">Source Sans 3</option>
                            <option value="Nunito">Nunito</option>
                            <option value="Poppins">Poppins</option>
                            <option value="Helvetica Neue">Helvetica Neue (System)</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted">Editor Font Size</label>
                        <input type="number" class="form-control bg-dark text-light border-secondary"
                               @bind="SettingsSvc.EditorFontSize" @bind:event="onchange" />
                    </div>
                    <div class="col-md-auto pb-1">
                        <div class="form-check form-switch">
                            <input type="checkbox" class="form-check-input" id="repoListOnRight"
                                   checked="@SettingsSvc.RepoListOnRight"
                                   @onchange="e => { SettingsSvc.RepoListOnRight = (bool)(e.Value ?? false); }" />
                            <label class="form-check-label text-muted small" for="repoListOnRight">Repo list on right</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Active Provider + Canon ───────────────────────────── *@
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted">General</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label text-muted">Active LLM Provider</label>
                        <select class="form-select bg-dark text-light border-secondary" @bind="SettingsSvc.ActiveLlmProvider">
                            <option value="claude">Claude (Anthropic)</option>
                            <option value="openai">OpenAI</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted">Canon Root Path</label>
                        <input type="text" class="form-control bg-dark text-light border-secondary"
                               placeholder="D:\Projects\MindAttic\StreetSamurai"
                               @bind="SettingsSvc.CanonRootPath" @bind:event="onchange" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted">Max Tokens</label>
                        <input type="number" class="form-control bg-dark text-light border-secondary"
                               @bind="SettingsSvc.MaxTokens" @bind:event="onchange" />
                    </div>
                </div>
                <div class="row g-3 mt-1">
                    <div class="col-md-3">
                        <label class="form-label text-muted">Timestamp Format</label>
                        <select class="form-select bg-dark text-light border-secondary" @bind="SettingsSvc.TimestampFormat">
                            @foreach (var (fmt, example) in StreetSamurai.Core.Services.SettingsService.TimestampFormats)
                            {
                                <option value="@fmt">@example</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted">Timezone</label>
                        <select class="form-select bg-dark text-light border-secondary" @bind="SettingsSvc.TimezoneId">
                            @foreach (var tz in TimeZoneInfo.GetSystemTimeZones())
                            {
                                <option value="@tz.Id">@tz.DisplayName</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Options ──────────────────────────────────────────── *@
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted">Options</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label text-muted">Rebuild the world graph from all canon data.</label>
                        <div class="input-group">
                            <button class="btn btn-outline-warning" @onclick="RebuildGraph" disabled="@rebuilding">
                                @if (rebuilding) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                <i class="bi bi-diagram-3"></i><div class="btn-lbl"> Rebuild Graph</div>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted">Scan every data file for corrupt or malformed JSON.</label>
                        <div class="input-group">
                            <button class="btn btn-outline-success" @onclick="ValidateJson" disabled="@validating">
                                @if (validating) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                <i class="bi bi-check-circle"></i><div class="btn-lbl"> Validate All JSON</div>
                            </button>
                            @if (validationResult != null)
                            {
                                <span class="input-group-text bg-dark border-secondary">
                                    <span class="badge @(_validationErrors == 0 ? "bg-success" : "bg-danger")">
                                        @validationTotal files — @(_validationErrors == 0 ? "all valid" : $"{_validationErrors} broken")
                                    </span>
                                </span>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted">Auto-link capitalized entity names in plain prose. Explicit [[wiki]] links always work.</label>
                        <div class="form-check form-switch mt-1">
                            <input type="checkbox" class="form-check-input" id="enableNer"
                                   checked="@SettingsSvc.EnablePlainTextNer"
                                   @onchange="e => SettingsSvc.EnablePlainTextNer = (bool)(e.Value ?? false)" />
                            <label class="form-check-label text-muted small" for="enableNer">Dynamic Entity Linking</label>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted">Output format for autonomous stories. Markdown is editor-native; HTML is the legacy wrapper.</label>
                        <div class="form-check form-switch mt-1">
                            <input type="checkbox" class="form-check-input" id="saveStoriesAsMarkdown"
                                   checked="@SettingsSvc.SaveStoriesAsMarkdown"
                                   @onchange="e => SettingsSvc.SaveStoriesAsMarkdown = (bool)(e.Value ?? false)" />
                            <label class="form-check-label text-muted small" for="saveStoriesAsMarkdown">
                                Save stories as @(SettingsSvc.SaveStoriesAsMarkdown ? "Markdown" : "HTML")
                            </label>
                        </div>
                    </div>
                    @* Publish button removed — deploying via Azure CI/CD *@
                </div>
                @if (brokenFiles.Count > 0)
                {
                    <div class="mt-2">
                        @foreach (var err in brokenFiles)
                        {
                            <div class="small text-danger"><i class="bi bi-x-circle"></i> @err</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* FTP Publishing section removed — deploying via Azure CI/CD *@

@* ── Review Voting ─────────────────────────────────────── *@
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted"><span><i class="bi bi-people"></i> Review Voting</span></div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Controls the sampled review panel. Changes take effect on the next run — no restart needed.
                </p>
                <div class="row g-3 align-items-end">
                    <div class="col-md-2">
                        <label class="form-label text-muted">Ballots</label>
                        <input type="number" class="form-control bg-dark text-light border-secondary" min="1"
                               value="@SettingsSvc.ReviewBallots"
                               @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var v)) SettingsSvc.ReviewBallots = v; }" />
                        <div class="form-text text-muted">Score-only ballots per run</div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted">Prose upgrades</label>
                        <input type="number" class="form-control bg-dark text-light border-secondary" min="0"
                               value="@SettingsSvc.ReviewProse"
                               @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var v)) SettingsSvc.ReviewProse = v; }" />
                        <div class="form-text text-muted">Full reviews per run</div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted">Panel size</label>
                        <input type="number" class="form-control bg-dark text-light border-secondary" min="1"
                               value="@SettingsSvc.ReviewPanel"
                               @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var v)) SettingsSvc.ReviewPanel = v; }" />
                        <div class="form-text text-muted">Persona pool depth</div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted">Readers</label>
                        <input type="number" class="form-control bg-dark text-light border-secondary" min="1"
                               value="@SettingsSvc.ReviewReaders"
                               @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var v)) SettingsSvc.ReviewReaders = v; }" />
                        <div class="form-text text-muted">Default reader count</div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted">Max concurrency</label>
                        <input type="number" class="form-control bg-dark text-light border-secondary" min="1" max="50"
                               value="@SettingsSvc.ReviewMaxConcurrency"
                               @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var v)) SettingsSvc.ReviewMaxConcurrency = v; }" />
                        <div class="form-text text-muted">Parallel ballot slots (1–50)</div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label text-muted">Judge provider</label>
                        <select class="form-select bg-dark text-light border-secondary"
                                value="@SettingsSvc.ReviewJudgeProvider"
                                @onchange="e => SettingsSvc.ReviewJudgeProvider = e.Value?.ToString() ?? SettingsSvc.ReviewJudgeProvider">
                            <option value="claude">claude</option>
                            <option value="openai">openai</option>
                            <option value="gemini">gemini</option>
                            <option value="deepseek">deepseek</option>
                        </select>
                        <div class="form-text text-muted">Synthesizes the summary</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label text-muted">Allowed providers (comma-separated)</label>
                        <input type="text" class="form-control bg-dark text-light border-secondary"
                               value="@SettingsSvc.ReviewAllowedProviders"
                               @onchange="e => SettingsSvc.ReviewAllowedProviders = e.Value?.ToString() ?? SettingsSvc.ReviewAllowedProviders" />
                        <div class="form-text text-muted">Restrict ballots to these providers. Leave blank to use all active. Example: <code>claude,openai</code></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Canon Data Export ─────────────────────────────────── *@
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted"><span><i class="bi bi-download"></i> Canon Data Export</span></div>
            <div class="card-body">
                <p class="text-muted small mb-3">
                    Dump canon JSON to your Downloads folder.
                    Per-repo and global exports are zipped; per-entity exports happen on each entity page.
                </p>
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label text-muted">Export a single repo (.zip)</label>
                        <select class="form-select bg-dark text-light border-secondary" @bind="selectedRepo">
                            <option value="">— pick a repo —</option>
                            @foreach (var (name, count) in repoCounts)
                            {
                                <option value="@name">@(name) (@count)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-outline-info" @onclick="DoExportRepo"
                                disabled="@(exporting || string.IsNullOrEmpty(selectedRepo))">
                            @if (exporting && exportScope == "repo") { <span class="spinner-border spinner-border-sm me-1"></span> }
                            else { <i class="bi bi-file-zip me-1"></i> }
                            <div class="btn-lbl">Export Repo</div>
                        </button>
                    </div>
                    <div class="col-md-5 d-flex align-items-end justify-content-end">
                        <div class="text-end">
                            <label class="form-label text-muted d-block">Everything, all repos in one archive.</label>
                            <button class="btn btn-outline-warning" @onclick="DoExportAll" disabled="@exporting">
                                @if (exporting && exportScope == "all") { <span class="spinner-border spinner-border-sm me-1"></span> }
                                else { <i class="bi bi-archive me-1"></i> }
                                <div class="btn-lbl">Export Everything</div>
                            </button>
                        </div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(exportStatus))
                {
                    <div class="mt-3 small @(exportSuccess ? "text-success" : "text-danger")">
                        @exportStatus
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@* ── LLM Providers ─────────────────────────────────────── *@
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted d-flex justify-content-between align-items-center">
                <span>Anthropic API <a href="https://console.anthropic.com/" target="_blank" class="text-muted" style="font-size:0.7rem;"><i class="bi bi-box-arrow-up-right"></i></a></span>
                @StatusBadge("anthropic")
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted">API Key</label>
                        <div class="input-group">
                            <input type="@KeyType("anthropic")" class="form-control bg-dark text-light border-secondary" placeholder="sk-ant-..." @bind="SettingsSvc.ApiKey" @bind:event="onchange" @bind:after="RetestAnthropic" />
                            <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleKeyVisibility("anthropic")'><i class="bi @(visibleKeys.Contains("anthropic") ? "bi-eye-slash" : "bi-eye")"></i></button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">Model</label>
                        <select class="form-select bg-dark text-light border-secondary" @bind="SettingsSvc.Model" @bind:after="RetestAnthropic">
                            <option value="claude-sonnet-4-6">Claude Sonnet 4.6</option>
                            <option value="claude-opus-4-6">Claude Opus 4.6</option>
                            <option value="claude-haiku-4-5-20251001">Claude Haiku 4.5</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted d-flex justify-content-between align-items-center">
                <span>OpenAI API <a href="https://platform.openai.com/" target="_blank" class="text-muted" style="font-size:0.7rem;"><i class="bi bi-box-arrow-up-right"></i></a></span>
                @StatusBadge("openai")
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted">API Key</label>
                        <div class="input-group">
                            <input type="@KeyType("openai")" class="form-control bg-dark text-light border-secondary" placeholder="sk-..." @bind="SettingsSvc.OpenAiApiKey" @bind:event="onchange" @bind:after="RetestOpenai" />
                            <button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleKeyVisibility("openai")'><i class="bi @(visibleKeys.Contains("openai") ? "bi-eye-slash" : "bi-eye")"></i></button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">Model</label>
                        <select class="form-select bg-dark text-light border-secondary" @bind="SettingsSvc.OpenAiModel" @bind:after="RetestOpenai">
                            <option value="gpt-4.1-mini">GPT-4.1 Mini</option>
                            <option value="gpt-4.1">GPT-4.1</option>
                            <option value="gpt-4o">GPT-4o</option>
                            <option value="o3-mini">o3-mini</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted d-flex justify-content-between align-items-center"><span>Google Gemini <a href="https://aistudio.google.com/" target="_blank" class="text-muted" style="font-size:0.7rem;"><i class="bi bi-box-arrow-up-right"></i></a></span> @StatusBadge("gemini")</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label text-muted">API Key</label><div class="input-group"><input type="@KeyType("gemini")" class="form-control bg-dark text-light border-secondary" placeholder="AIza..." @bind="SettingsSvc.GeminiApiKey" @bind:event="onchange" @bind:after="RetestGemini" /><button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleKeyVisibility("gemini")'><i class="bi @(visibleKeys.Contains("gemini") ? "bi-eye-slash" : "bi-eye")"></i></button></div></div>
                    <div class="col-md-6"><label class="form-label text-muted">Model</label>
                        <select class="form-select bg-dark text-light border-secondary" @bind="SettingsSvc.GeminiModel" @bind:after="RetestGemini">
                            <option value="gemini-2.5-pro">Gemini 2.5 Pro</option>
                            <option value="gemini-2.5-flash">Gemini 2.5 Flash</option>
                            <option value="gemini-2.0-flash">Gemini 2.0 Flash</option>
                        </select></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted d-flex justify-content-between align-items-center"><span>DeepSeek <a href="https://platform.deepseek.com/" target="_blank" class="text-muted" style="font-size:0.7rem;"><i class="bi bi-box-arrow-up-right"></i></a></span> @StatusBadge("deepseek")</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label text-muted">API Key</label><div class="input-group"><input type="@KeyType("deepseek")" class="form-control bg-dark text-light border-secondary" placeholder="sk-..." @bind="SettingsSvc.DeepSeekApiKey" @bind:event="onchange" @bind:after="RetestDeepseek" /><button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleKeyVisibility("deepseek")'><i class="bi @(visibleKeys.Contains("deepseek") ? "bi-eye-slash" : "bi-eye")"></i></button></div></div>
                    <div class="col-md-6"><label class="form-label text-muted">Model</label>
                        <select class="form-select bg-dark text-light border-secondary" @bind="SettingsSvc.DeepSeekModel" @bind:after="RetestDeepseek">
                            <option value="deepseek-chat">DeepSeek Chat (V3)</option>
                            <option value="deepseek-reasoner">DeepSeek Reasoner (R1)</option>
                        </select></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted d-flex justify-content-between align-items-center"><span>Mistral <a href="https://console.mistral.ai/" target="_blank" class="text-muted" style="font-size:0.7rem;"><i class="bi bi-box-arrow-up-right"></i></a></span> @StatusBadge("mistral")</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6"><label class="form-label text-muted">API Key</label><div class="input-group"><input type="@KeyType("mistral")" class="form-control bg-dark text-light border-secondary" @bind="SettingsSvc.MistralApiKey" @bind:event="onchange" @bind:after="RetestMistral" /><button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleKeyVisibility("mistral")'><i class="bi @(visibleKeys.Contains("mistral") ? "bi-eye-slash" : "bi-eye")"></i></button></div></div>
                    <div class="col-md-6"><label class="form-label text-muted">Model</label>
                        <select class="form-select bg-dark text-light border-secondary" @bind="SettingsSvc.MistralModel" @bind:after="RetestMistral">
                            <option value="mistral-large-latest">Mistral Large</option>
                            <option value="mistral-medium-latest">Mistral Medium</option>
                            <option value="mistral-small-latest">Mistral Small</option>
                            <option value="codestral-latest">Codestral</option>
                        </select></div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted d-flex justify-content-between align-items-center"><span>Grok (xAI) <a href="https://console.x.ai/" target="_blank" class="text-muted" style="font-size:0.7rem;"><i class="bi bi-box-arrow-up-right"></i></a></span> @StatusBadge("grok")</div>
            <div class="card-body">
                <div class="row g-3">
