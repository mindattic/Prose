    private string selectedRepo = "";
    private bool exporting;
    private string exportScope = "";   // "repo" | "all" — drives which spinner shows
    private string? exportStatus;
    private bool exportSuccess;
    private List<(string name, int count)> repoCounts = [];

    private async Task DoExportRepo()
    {
        if (string.IsNullOrWhiteSpace(selectedRepo)) return;
        exporting = true; exportScope = "repo"; exportStatus = null;
        StateHasChanged();
        try
        {
            var r = await CanonExport.ExportRepoAsync(selectedRepo);
            exportSuccess = true;
            exportStatus = $"Saved {r.EntryCount} entries ({FormatBytes(r.Bytes)}) → {r.Path}";
        }
        catch (Exception ex) { exportSuccess = false; exportStatus = ex.Message; }
        finally { exporting = false; exportScope = ""; StateHasChanged(); }
    }

    private async Task DoExportAll()
    {
        exporting = true; exportScope = "all"; exportStatus = null;
        StateHasChanged();
        try
        {
            var r = await CanonExport.ExportAllAsync();
            exportSuccess = true;
            exportStatus = $"Saved {r.EntryCount} entries across all repos ({FormatBytes(r.Bytes)}) → {r.Path}";
        }
        catch (Exception ex) { exportSuccess = false; exportStatus = ex.Message; }
        finally { exporting = false; exportScope = ""; StateHasChanged(); }
    }

    private static string FormatBytes(long b) =>
        b < 1024 ? $"{b} B" :
        b < 1024 * 1024 ? $"{b / 1024.0:F1} KB" :
        $"{b / 1024.0 / 1024.0:F2} MB";

