    // ── Voice Profile editor (single-form CRUD against SettingsSvc) ──────
    // Pattern: <newProfile> is the bound editor model. When the user clicks
    // a row's edit button, we copy that row into newProfile and remember
    // <editingProfileId> so SaveVoiceProfile writes back to the same id
    // (upsert). Otherwise (empty editingProfileId) it inserts a new row.
    private StreetSamurai.Core.Models.VoiceProfile newProfile = new() { Stability = 0.5, SimilarityBoost = 0.75, Style = 0.0 };
    private string editingProfileId = "";
    private string profileFeedback = "";

    private void EditVoiceProfile(string profileId)
    {
        var src = SettingsSvc.VoiceProfiles.FirstOrDefault(p => p.Id == profileId);
        if (src == null) return;
        editingProfileId = profileId;
        newProfile = new StreetSamurai.Core.Models.VoiceProfile
        {
            Id = src.Id, Label = src.Label, VoiceId = src.VoiceId, Model = src.Model,
            Stability = src.Stability, SimilarityBoost = src.SimilarityBoost,
            Style = src.Style, UseSpeakerBoost = src.UseSpeakerBoost,
        };
        profileFeedback = $"Editing \"{src.Label}\" — changes overwrite this profile on Save.";
        StateHasChanged();
    }

    private void SaveVoiceProfile()
    {
        if (string.IsNullOrWhiteSpace(newProfile.Label) || string.IsNullOrWhiteSpace(newProfile.VoiceId)) return;
        // For an edit, retain the id; for a new profile, let SettingsService mint one.
        if (string.IsNullOrEmpty(editingProfileId)) newProfile.Id = "";
        var saved = SettingsSvc.UpsertVoiceProfile(newProfile);
        profileFeedback = string.IsNullOrEmpty(editingProfileId)
            ? $"Added profile \"{saved.Label}\"."
            : $"Updated profile \"{saved.Label}\".";
        ResetProfileEditor();
    }

    private void DeleteVoiceProfile(string profileId)
    {
        var match = SettingsSvc.VoiceProfiles.FirstOrDefault(p => p.Id == profileId);
        SettingsSvc.DeleteVoiceProfile(profileId);
        if (editingProfileId == profileId) ResetProfileEditor();
        profileFeedback = match != null ? $"Deleted profile \"{match.Label}\"." : "";
    }

    private void ResetProfileEditor()
    {
        editingProfileId = "";
        newProfile = new StreetSamurai.Core.Models.VoiceProfile { Stability = 0.5, SimilarityBoost = 0.75, Style = 0.0 };
        StateHasChanged();
    }


