    private async Task TestAllProviders()
    {
        var names = new[] { "anthropic", "openai", "gemini", "deepseek", "mistral", "grok", "groq", "together", "openrouter", "fireworks", "cohere" };
        await Task.WhenAll(names.Select(n => { var c = GetTestConfig(n); return TestProvider(n, c.key, c.endpoint, c.authHeader, c.body); }));
    }

    private async Task RetestProvider(string name)
    {
        var c = GetTestConfig(name);
        await TestProvider(name, c.key, c.endpoint, c.authHeader, c.body);
    }

    private Task RetestAnthropic() => RetestProvider("anthropic");
