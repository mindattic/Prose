    private async Task TestProvider(string name, string key, string endpoint, string authHeader, string body)
    {
        if (string.IsNullOrWhiteSpace(key)) { _apiStatus[name] = "none"; await InvokeAsync(StateHasChanged); return; }
        _apiStatus[name] = "testing";
        await InvokeAsync(StateHasChanged);

        if (name == "gemini")
        {
            endpoint = $"https://generativelanguage.googleapis.com/v1beta/models/{SettingsSvc.GeminiModel}:generateContent?key={key}";
            authHeader = "";
            body = """{"contents":[{"parts":[{"text":"hi"}]}],"generationConfig":{"maxOutputTokens":1}}""";
        }

        try
        {
            using var handler = new HttpClientHandler { CheckCertificateRevocationList = false };
            using var http = new HttpClient(handler) { Timeout = TimeSpan.FromSeconds(15) };
            using var req = new HttpRequestMessage(HttpMethod.Post, endpoint);
            req.Content = new StringContent(body, System.Text.Encoding.UTF8, "application/json");

            if (name == "anthropic")
            {
                req.Headers.Add("x-api-key", key);
                req.Headers.Add("anthropic-version", "2023-06-01");
            }
            else if (authHeader == "Bearer")
            {
                req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", key);
            }

            var resp = await http.SendAsync(req);
            _apiStatus[name] = resp.IsSuccessStatusCode ? "ok" : "fail";
        }
        catch
        {
            _apiStatus[name] = "fail";
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadVoices()
    {
        loadingVoices = true;
        StateHasChanged();
        try
        {
            voices = await TtsSvc.ListVoicesAsync();
            if (string.IsNullOrWhiteSpace(SettingsSvc.ElevenLabsVoiceId) && voices.Any())
            {
                var defaultVoice = voices.FirstOrDefault(v =>
                    v.Name.Equals("Oliver Silk", StringComparison.OrdinalIgnoreCase))
                    ?? voices.First();
                SettingsSvc.ElevenLabsVoiceId = defaultVoice.VoiceId;
                SettingsSvc.NarratorVoiceName = defaultVoice.Name;
            }
        }
        finally { loadingVoices = false; }
    }

    private void OnVoiceSelected(ChangeEventArgs e)
    {
        var voiceId = e.Value?.ToString();
        if (!string.IsNullOrEmpty(voiceId))
        {
            SettingsSvc.ElevenLabsVoiceId = voiceId;
            var voice = voices.FirstOrDefault(v => v.VoiceId == voiceId);
            SettingsSvc.NarratorVoiceName = voice?.Name ?? "";
