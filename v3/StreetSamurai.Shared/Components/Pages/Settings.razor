    /// <summary>Pick out a specific backend type from the runtime IAudioStore.
    /// When the runtime is a DualWriteAudioStore the underlying pair already
    /// has both sides ready (container ensured, file handles warm). When it's
    /// a single-provider store we get one side for free; the missing side gets
    /// constructed fresh by RunAudioSyncAsync. Returns null when no match.</summary>
    private T? ResolveStore<T>() where T : class, IAudioStore
    {
        if (RuntimeAudioStore is T direct) return direct;
        if (RuntimeAudioStore is DualWriteAudioStore dual)
        {
            var (primary, secondary) = dual.UnderlyingStores;
            if (primary is T p) return p;
            if (secondary is T s) return s;
        }
        return null;
    }

    /// <summary>One-shot bidirectional reconcile triggered from the Audio
    /// Storage card. Reuses the DI-registered backends when possible so a
    /// click doesn't repeat the ~100 ms container-ensure round-trip the
    /// AzureBlobAudioStore ctor used to do. Same engine the CLI and the
    /// background timer use; just a different trigger. Failures are
    /// surfaced via a toast plus the per-side counts on the card.</summary>
    private async Task RunAudioSyncAsync()
    {
        if (audioSyncRunning) return;
        audioSyncRunning = true;
        StateHasChanged();
        try
        {
            // Pick up cached blob/local clients from the runtime IAudioStore
            // when possible — that's a singleton that already ensured the
            // container exists. Falling back to fresh construction only when
            // the runtime store is pure local OR pure blob and we need the
            // other side. Each round-trip avoided saves ~100 ms per click.
            IAudioStore local = ResolveStore<LocalDiskAudioStore>()
                ?? new LocalDiskAudioStore(Paths, AppLogs.CreateLogger<LocalDiskAudioStore>());
            IAudioStore? blob = ResolveStore<AzureBlobAudioStore>();
            if (blob == null)
            {
                try { blob = new AzureBlobAudioStore(AppConfig, AppLogs.CreateLogger<AzureBlobAudioStore>()); }
                catch (InvalidOperationException ex)
                {
                    Toast.Error("AUDIO-SYNC", $"Azure Blob is not configured: {ex.Message}");
                    return;
                }
            }
            audioSyncLastReport = await AudioReconciler.ReconcileAsync(local, blob);
            if (audioSyncLastReport.Failed > 0)
                Toast.Warning("AUDIO-SYNC", $"Reconcile finished with {audioSyncLastReport.Failed} failure(s) — see card for details.");
            else if (audioSyncLastReport.CopiedAToB + audioSyncLastReport.CopiedBToA + audioSyncLastReport.CreatedOnA + audioSyncLastReport.CreatedOnB > 0)
                Toast.Success("AUDIO-SYNC", $"Synced ↑{audioSyncLastReport.CopiedAToB + audioSyncLastReport.CreatedOnB} ↓{audioSyncLastReport.CopiedBToA + audioSyncLastReport.CreatedOnA} beat(s).");
            else
                Toast.Info("AUDIO-SYNC", $"Already in sync — {audioSyncLastReport.InSync} beat(s) match across local + blob.");
        }
        catch (Exception ex)
        {
            Toast.Error("AUDIO-SYNC-FAIL", ex.Message);
        }
        finally
        {
            audioSyncRunning = false;
            StateHasChanged();
        }
    }

    private async Task ValidateJson()
    {
        validating = true; brokenFiles = []; validationResult = null;
        StateHasChanged();

        await Task.Run(() =>
        {
            var dir = Paths.EngineDataDir;
            int total = 0, errors = 0;
            var broken = new List<string>();

            void Scan(string d)
            {
                foreach (var f in Directory.GetFiles(d, "*.json"))
                {
                    total++;
                    try { System.Text.Json.JsonDocument.Parse(File.ReadAllText(f)).Dispose(); }
                    catch (Exception ex)
                    {
                        errors++;
                        broken.Add(Path.GetRelativePath(dir, f) + ": " + ex.Message[..Math.Min(ex.Message.Length, 120)]);
                    }
                }
                foreach (var sub in Directory.GetDirectories(d)) Scan(sub);
            }

            Scan(dir);
            validationTotal = total;
            _validationErrors = errors;
            brokenFiles = broken;
            validationResult = "done";
        });

        validating = false;
    }

