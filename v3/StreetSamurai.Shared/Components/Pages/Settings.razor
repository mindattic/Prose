@* ── ElevenLabs TTS ────────────────────────────────────── *@
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted d-flex justify-content-between align-items-center">
                <span>ElevenLabs TTS <a href="https://elevenlabs.io/" target="_blank" class="text-muted" style="font-size:0.7rem;"><i class="bi bi-box-arrow-up-right"></i></a></span>
                <span class="badge @(ttsConfigured ? "bg-success" : "bg-secondary")">@(ttsConfigured ? "Connected" : "Offline")</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label text-muted">API Key</label>
                        <div class="input-group"><input type="@KeyType("elevenlabs")" class="form-control bg-dark text-light border-secondary" placeholder="sk_..." @bind="SettingsSvc.ElevenLabsApiKey" @bind:event="onchange" /><button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleKeyVisibility("elevenlabs")'><i class="bi @(visibleKeys.Contains("elevenlabs") ? "bi-eye-slash" : "bi-eye")"></i></button></div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted">Narrator Voice</label>
                        @if (loadingVoices)
                        {
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <div class="spinner-border spinner-border-sm text-danger"></div>
                                <small class="text-muted">Loading voices...</small>
                            </div>
                        }
                        else if (voices.Any())
                        {
                            <select class="form-select bg-dark text-light border-secondary"
                                    value="@SettingsSvc.ElevenLabsVoiceId" @onchange="OnVoiceSelected">
                                @foreach (var v in voices)
                                {
                                    <option value="@v.VoiceId">@v.Name (@v.Category)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="input-group">
                                <input type="text" class="form-control bg-dark text-light border-secondary"
                                       placeholder="Voice ID" @bind="SettingsSvc.ElevenLabsVoiceId" @bind:event="onchange" />
                                @if (ttsConfigured)
                                {
                                    <button class="btn btn-outline-info btn-sm" @onclick="LoadVoices"><i class="bi bi-arrow-repeat"></i></button>
                                }
                            </div>
                        }
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted">Model</label>
                        <select class="form-select bg-dark text-light border-secondary" @bind="SettingsSvc.TtsModel">
                            <option value="eleven_multilingual_v2">Multilingual v2 (Recommended)</option>
                            <option value="eleven_turbo_v2_5">Turbo v2.5</option>
                            <option value="eleven_monolingual_v1">Monolingual v1</option>
                        </select>
                    </div>
                </div>
                <div class="row g-3 mt-2">
                    <div class="col-md-8">
                        <label class="form-label text-muted">Publish output folder</label>
                        <input type="text" class="form-control bg-dark text-light border-secondary"
                               placeholder="Leave blank to use your Downloads folder"
                               @bind="SettingsSvc.PublishOutputDirectory" @bind:event="onchange" />
                        <div class="form-text text-muted">Where Publish drops the combined audio file so it's easy to find. Blank = your Downloads folder. The in-app player keeps its own internal copy.</div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted">Audiobook quality</label>
                        <select class="form-select bg-dark text-light border-secondary" @bind="SettingsSvc.AudiobookFormat">
                            @foreach (var (key, label, _) in StreetSamurai.Core.Services.SettingsService.AudiobookFormats)
                            {
                                <option value="@key">@label</option>
                            }
                        </select>
                        <div class="form-text text-muted">Format/bitrate of the published audiobook file. The narration is always fetched from ElevenLabs at the highest fidelity your tier allows (lossless when available); this controls the final encode you receive.</div>
                    </div>
                </div>
                <div class="row g-3 mt-2">
                    <div class="col-md-3">
                        <label class="form-label text-muted small">Stability: @SettingsSvc.TtsStability.ToString("F2")</label>
                        <input type="range" class="form-range" min="0" max="1" step="0.05" @bind="SettingsSvc.TtsStability" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small">Similarity: @SettingsSvc.TtsSimilarityBoost.ToString("F2")</label>
                        <input type="range" class="form-range" min="0" max="1" step="0.05" @bind="SettingsSvc.TtsSimilarityBoost" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small">Style: @SettingsSvc.TtsStyle.ToString("F2")</label>
                        <input type="range" class="form-range" min="0" max="1" step="0.05" @bind="SettingsSvc.TtsStyle" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        @if (ttsConfigured)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="TestTts" disabled="@testingTts">
                                @if (testingTts) { <span class="spinner-border spinner-border-sm"></span> }
                                else { <i class="bi bi-volume-up"></i> }
                                <div class="btn-lbl">Test Voice</div>
                            </button>
                            @if (ttsTestResult != null)
                            {
                                <small class="ms-2 @(ttsTestSuccess ? "text-success" : "text-warning")">@ttsTestResult</small>
                            }
                        }
                    </div>
                </div>

                @* Tier & credits — what your ElevenLabs plan unlocks + characters remaining. *@
                <div class="row g-3 mt-2">
                    <div class="col-12">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <button class="btn btn-sm btn-outline-info" @onclick="CheckTier" disabled="@(!ttsConfigured || checkingTier)">
                                @if (checkingTier) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                else { <i class="bi bi-clipboard-data me-1"></i> }
                                Check tier &amp; credits
                            </button>
                            @if (tierError != null)
                            {
                                <small class="text-warning">@tierError</small>
                            }
                        </div>

                        @if (subscription != null)
                        {
                            <div class="border border-secondary rounded p-3 mt-2 bg-black">
                                <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                                    <span>Tier: <span class="badge bg-info text-dark text-capitalize">@subscription.Tier</span></span>
                                    @if (!string.IsNullOrWhiteSpace(subscription.Status))
                                    {
                                        <span class="text-muted small text-capitalize">Status: @subscription.Status</span>
                                    }
                                </div>

                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="text-muted">Character credits <span class="text-secondary">(ElevenLabs bills per character, not per token)</span></span>
                                    <span><strong>@subscription.CharactersRemaining.ToString("N0")</strong> remaining of @subscription.CharacterLimit.ToString("N0")</span>
                                </div>
                                <div class="progress bg-secondary" style="height:8px;">
                                    <div class="progress-bar @(subscription.UsedFraction >= 0.9 ? "bg-danger" : subscription.UsedFraction >= 0.75 ? "bg-warning" : "bg-success")"
                                         role="progressbar" style="width:@((subscription.UsedFraction * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                </div>
                                <div class="text-muted small mt-1">
                                    @subscription.CharacterCount.ToString("N0") used
                                    @if (subscription.NextResetUtc is { } reset)
                                    {
                                        <text> · resets @reset.ToLocalTime().ToString("yyyy-MM-dd")</text>
                                    }
                                </div>

                                <hr class="border-secondary my-2" />
                                <div class="small">
                                    <div class="text-muted mb-1">Premium output formats your tier unlocks:</div>
                                    @if (subscription.UnlockedPremiumFormats.Count == 0)
                                    {
                                        <span class="text-muted">Standard formats only (up to <code>mp3_44100_128</code>). Creator unlocks 192 kbps MP3; Pro unlocks lossless PCM.</span>
                                    }
                                    else
                                    {
                                        @foreach (var f in subscription.UnlockedPremiumFormats)
                                        {
                                            <span class="badge bg-success me-1">@f</span>
                                        }
                                        <span class="text-muted ms-1">— plus all standard formats. The audiobook publisher auto-picks the best of these.</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@* ── Voice Profiles & Silence Pacing ───────────────────── *@
<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted">
                Voice Profiles
                <span class="text-secondary small ms-2">— named bundles of voice id + voice_settings. The default profile is used for every beat narration unless the node has its own override.</span>
            </div>
            <div class="card-body">
                <table class="table table-sm table-dark mb-3" style="border-color:#2a2a2a;">
                    <thead>
                        <tr class="text-muted small">
                            <th style="width:1.5rem"></th>
                            <th>Label</th>
                            <th>Voice ID</th>
                            <th class="text-end">Stability</th>
                            <th class="text-end">Similarity</th>
                            <th class="text-end">Style</th>
                            <th style="width:7rem"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (SettingsSvc.VoiceProfiles.Count == 0)
                        {
                            <tr><td colspan="7" class="text-muted small text-center py-2">No saved profiles yet — the narrator-default profile below will be synthesised from the ElevenLabs section's voice settings on first run.</td></tr>
                        }
                        @foreach (var p in SettingsSvc.VoiceProfiles.ToList())
                        {
                            var pid = p.Id;
                            var isDefault = SettingsSvc.DefaultVoiceProfileId == pid;
                            <tr>
                                <td>
                                    <input type="radio" name="default-profile"
                                           checked="@isDefault"
                                           title="Make this the default profile"
                                           @onchange="@(() => { SettingsSvc.DefaultVoiceProfileId = pid; })" />
                                </td>
                                <td><strong>@p.Label</strong> <span class="text-muted small ms-1">@p.Id</span></td>
                                <td><code class="small text-info">@p.VoiceId</code></td>
                                <td class="text-end font-monospace small">@p.Stability.ToString("F2")</td>
                                <td class="text-end font-monospace small">@p.SimilarityBoost.ToString("F2")</td>
                                <td class="text-end font-monospace small">@p.Style.ToString("F2")</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-info py-0 px-2" title="Load into editor" @onclick="@(() => EditVoiceProfile(pid))"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-outline-danger py-0 px-2 ms-1" title="Delete profile" @onclick="@(() => DeleteVoiceProfile(pid))"><i class="bi bi-trash"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label text-muted small">Profile label</label>
                        <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                               placeholder='e.g. "Oliver Silk — gravel"'
                               @bind="newProfile.Label" @bind:event="oninput" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small">ElevenLabs voice</label>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary"
                                @bind="newProfile.VoiceId">
                            @if (voices.Any())
                            {
                                <option value="">— pick a voice —</option>
                                @foreach (var v in voices.OrderBy(v => v.Name))
                                {
                                    <option value="@v.VoiceId">@v.Name</option>
                                }
                            }
                            else
                            {
                                <option value="">(load voices in ElevenLabs section first)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label text-muted small">Stab.</label>
                        <input type="number" min="0" max="1" step="0.05" class="form-control form-control-sm bg-dark text-light border-secondary"
                               @bind="newProfile.Stability" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label text-muted small">Sim.</label>
                        <input type="number" min="0" max="1" step="0.05" class="form-control form-control-sm bg-dark text-light border-secondary"
                               @bind="newProfile.SimilarityBoost" />
                    </div>
                    <div class="col-md-1">
                        <label class="form-label text-muted small">Style</label>
                        <input type="number" min="0" max="1" step="0.05" class="form-control form-control-sm bg-dark text-light border-secondary"
                               @bind="newProfile.Style" />
                    </div>
                    <div class="col-md-3 d-flex gap-2">
