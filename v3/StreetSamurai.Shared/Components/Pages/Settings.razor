<div class="row g-3 mb-3">
    <div class="col-12">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted d-flex justify-content-between align-items-center">
                <span>ElevenLabs TTS <a href="https://elevenlabs.io/" target="_blank" class="text-muted" style="font-size:0.7rem;"><i class="bi bi-box-arrow-up-right"></i></a></span>
                <span class="badge @(ttsConfigured ? "bg-success" : "bg-secondary")">@(ttsConfigured ? "Connected" : "Offline")</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label text-muted">API Key</label>
                        <div class="input-group"><input type="@KeyType("elevenlabs")" class="form-control bg-dark text-light border-secondary" placeholder="sk_..." @bind="SettingsSvc.ElevenLabsApiKey" @bind:event="onchange" /><button class="btn btn-outline-secondary" type="button" @onclick='() => ToggleKeyVisibility("elevenlabs")'><i class="bi @(visibleKeys.Contains("elevenlabs") ? "bi-eye-slash" : "bi-eye")"></i></button></div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted">Narrator Voice</label>
                        @if (loadingVoices)
                        {
                            <div class="d-flex align-items-center gap-2 mt-1">
                                <div class="spinner-border spinner-border-sm text-danger"></div>
                                <small class="text-muted">Loading voices...</small>
                            </div>
                        }
                        else if (voices.Any())
                        {
                            <select class="form-select bg-dark text-light border-secondary"
                                    value="@SettingsSvc.ElevenLabsVoiceId" @onchange="OnVoiceSelected">
                                @foreach (var v in voices)
                                {
                                    <option value="@v.VoiceId">@v.Name (@v.Category)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="input-group">
                                <input type="text" class="form-control bg-dark text-light border-secondary"
                                       placeholder="Voice ID" @bind="SettingsSvc.ElevenLabsVoiceId" @bind:event="onchange" />
                                @if (ttsConfigured)
                                {
                                    <button class="btn btn-outline-info btn-sm" @onclick="LoadVoices"><i class="bi bi-arrow-repeat"></i></button>
                                }
                            </div>
                        }
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted">Model</label>
                        <select class="form-select bg-dark text-light border-secondary" @bind="SettingsSvc.TtsModel">
                            <option value="eleven_v3">v3 (Recommended)</option>
                            <option value="eleven_multilingual_v2">Multilingual v2</option>
                            <option value="eleven_turbo_v2_5">Turbo v2.5</option>
                            <option value="eleven_monolingual_v1">Monolingual v1</option>
                        </select>
                    </div>
                </div>
                <div class="row g-3 mt-2">
                    <div class="col-md-3">
                        <label class="form-label text-muted small">Stability: @SettingsSvc.TtsStability.ToString("F2")</label>
                        <input type="range" class="form-range" min="0" max="1" step="0.05" @bind="SettingsSvc.TtsStability" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small">Similarity: @SettingsSvc.TtsSimilarityBoost.ToString("F2")</label>
                        <input type="range" class="form-range" min="0" max="1" step="0.05" @bind="SettingsSvc.TtsSimilarityBoost" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label text-muted small">Style: @SettingsSvc.TtsStyle.ToString("F2")</label>
                        <input type="range" class="form-range" min="0" max="1" step="0.05" @bind="SettingsSvc.TtsStyle" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        @if (ttsConfigured)
                        {
                            <button class="btn btn-sm btn-outline-danger" @onclick="TestTts" disabled="@testingTts">
                                @if (testingTts) { <span class="spinner-border spinner-border-sm"></span> }
                                else { <i class="bi bi-volume-up"></i> }
                                Test Voice
                            </button>
                            @if (ttsTestResult != null)
                            {
                                <small class="ms-2 @(ttsTestSuccess ? "text-success" : "text-warning")">@ttsTestResult</small>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@code {
    private List<LlmProviderStatus> providerStatus = [];
    private LlmProviderStatus? activeProvider;
    private bool ttsConfigured;
    private List<TtsVoice> voices = [];
    private bool loadingVoices;
    private bool testingTts;
    private string? ttsTestResult;
    private bool ttsTestSuccess;
    private bool confirmReset;
    private bool rebuilding;
    private bool validating;
    private string? validationResult;
    private int validationTotal, _validationErrors;
    private List<string> brokenFiles = [];

    // FTP
    private bool showFtpPassword;
    private bool ftpBusy;
    private string? ftpTestResult, ftpStatus, ftpPublishResult;
    private bool ftpTestSuccess, ftpPublishSuccess;

    // Publish All (export + FTP)
    private bool publishing;
    private string? publishStatus;
    private bool publishSuccess;

    private async Task TestFtp()
    {
        ftpBusy = true; ftpTestResult = null; ftpPublishResult = null; ftpStatus = "Testing connection...";
        await InvokeAsync(StateHasChanged);
        var (ok, msg) = await Task.Run(() => FtpSvc.TestConnectionAsync());
        ftpTestResult = msg; ftpTestSuccess = ok; ftpBusy = false; ftpStatus = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task PublishAll()
    {
        publishing = true; publishSuccess = false; publishStatus = "Exporting...";
        await InvokeAsync(StateHasChanged);

        // Step 1: Export all repos to HTML
        string? exportPath = null;
        try
        {
            var repos = ExportDiscovery.GetAllRepos();
            var totalEntries = repos.Values.Sum(r => r.Count);
            exportPath = await Task.Run(() => HtmlExportSvc.ExportAll(repos, (cur, total) =>
            {
                publishStatus = $"Exporting {cur:N0}/{total:N0} entries...";
                InvokeAsync(StateHasChanged);
            }));
            publishStatus = $"Export complete ({totalEntries:N0} entries). Uploading via FTP...";
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            publishStatus = $"Export failed: {ex.Message}";
            publishing = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        // Step 2: Upload via FTP
        if (!FtpSvc.IsConfigured)
        {
            publishStatus = "Export complete. FTP not configured — set host/username/password in FTP Publishing section below.";
            publishing = false;
            await InvokeAsync(StateHasChanged);
            return;
        }

        try
        {
            var (ok, msg) = await Task.Run(() => FtpSvc.PublishAsync(
                HtmlExportSvc.ExportDir,
                (cur, total, file) =>
                {
                    publishStatus = $"Uploading {cur}/{total}: {file}";
                    InvokeAsync(StateHasChanged);
                }));
            publishSuccess = ok;
            publishStatus = ok ? "Published successfully!" : msg;
        }
        catch (Exception ex)
        {
            publishStatus = $"Upload failed: {ex.Message}";
        }

        publishing = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task PublishToFtp()
    {
        ftpBusy = true; ftpPublishResult = null; ftpStatus = "Preparing upload...";
        await InvokeAsync(StateHasChanged);
        var (ok, msg) = await Task.Run(() => FtpSvc.PublishAsync(
            HtmlExportSvc.ExportDir,
            (cur, total, file) => { ftpStatus = $"Uploading {cur}/{total}: {file}"; InvokeAsync(StateHasChanged); }));
        ftpPublishResult = msg; ftpPublishSuccess = ok; ftpBusy = false; ftpStatus = null;
        await InvokeAsync(StateHasChanged);
    }

    // Fact Discovery
    private bool factRunning;
    private string? factStatus;
    private bool factSuccess;

    private bool describeRunning;
    private string? describeStatus;
    private bool describeSuccess;

    private async Task LaunchFactDiscovery()
    {
        factRunning = true; factStatus = "Launching pipeline..."; factSuccess = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var pipelineDir = Path.Combine(Paths.DataRoot, "v3", "python");
            var scriptPath = Path.Combine(pipelineDir, "run_fact_pipeline.py");

            if (!File.Exists(scriptPath))
            {
                factStatus = "Pipeline not found at " + scriptPath;
                factRunning = false;
                return;
            }

            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "python",
                Arguments = $"\"{scriptPath}\"",
                WorkingDirectory = pipelineDir,
                UseShellExecute = true,
                CreateNoWindow = false
            };
            psi.Environment["PYTHONIOENCODING"] = "utf-8";

            System.Diagnostics.Process.Start(psi);
            factStatus = "Pipeline launched in terminal. Check the window for progress.";
            factSuccess = true;
        }
        catch (Exception ex)
        {
            factStatus = $"Failed to launch: {ex.Message}";
        }

        factRunning = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task LaunchDescribe()
    {
        describeRunning = true; describeStatus = "Launching character portrait generator..."; describeSuccess = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            var pipelineDir = Path.Combine(Paths.DataRoot, "v3", "python");
            var scriptPath = Path.Combine(pipelineDir, "generate_descriptions.py");

            if (!File.Exists(scriptPath))
            {
                describeStatus = "Script not found at " + scriptPath;
                describeRunning = false;
                return;
            }

            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "python",
                Arguments = $"\"{scriptPath}\"",
                WorkingDirectory = pipelineDir,
                UseShellExecute = true,
                CreateNoWindow = false
            };
            psi.Environment["PYTHONIOENCODING"] = "utf-8";

            System.Diagnostics.Process.Start(psi);
            describeStatus = "Generator launched in terminal. Check the window for progress.";
            describeSuccess = true;
        }
        catch (Exception ex)
        {
            describeStatus = $"Failed to launch: {ex.Message}";
        }

        describeRunning = false;
        await InvokeAsync(StateHasChanged);
    }

    private HashSet<string> visibleKeys = new();
    private string KeyType(string field) => visibleKeys.Contains(field) ? "text" : "password";
    private void ToggleKeyVisibility(string field) { if (!visibleKeys.Remove(field)) visibleKeys.Add(field); }

    // Provider connectivity: "none" | "testing" | "ok" | "fail"
    private Dictionary<string, string> _apiStatus = new();

    private RenderFragment StatusBadge(string provider) => builder =>
    {
        var status = _apiStatus.GetValueOrDefault(provider, "none");
        var (css, label) = status switch
        {
            "ok" => ("bg-success", "Connected"),
            "fail" => ("bg-danger", "Offline"),
            "testing" => ("bg-warning text-dark", "Connecting"),
            _ => ("bg-secondary", "Offline"),
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge {css}");
        builder.AddContent(2, label);
        builder.CloseElement();
    };

    protected override async Task OnInitializedAsync()
    {
        providerStatus = await LlmRouter.GetProvidersAsync();
        activeProvider = providerStatus.FirstOrDefault(p => p.IsActive);
        ttsConfigured = await TtsSvc.IsConfiguredAsync();

        if (ttsConfigured)
            await LoadVoices();

        _ = TestAllProviders();
    }

    private (string key, string endpoint, string authHeader, string body) GetTestConfig(string name) => name switch
    {
        "anthropic" => (SettingsSvc.ApiKey, "https://api.anthropic.com/v1/messages",
            "x-api-key", """{"model":"claude-haiku-4-5-20251001","max_tokens":1,"messages":[{"role":"user","content":"hi"}]}"""),
