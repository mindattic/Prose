    private async Task TestAllProviders()
    {
        var names = new[] { "anthropic", "openai", "gemini", "deepseek", "mistral", "grok", "groq", "together", "openrouter", "fireworks", "cohere" };
        await Task.WhenAll(names.Select(n => { var c = GetTestConfig(n); return TestProvider(n, c.key, c.endpoint, c.authHeader, c.body); }));
    }

    private async Task RetestProvider(string name)
    {
        var c = GetTestConfig(name);
        await TestProvider(name, c.key, c.endpoint, c.authHeader, c.body);
    }

    private Task RetestAnthropic() => RetestProvider("anthropic");
    private Task RetestOpenai() => RetestProvider("openai");
    private Task RetestGemini() => RetestProvider("gemini");
    private Task RetestDeepseek() => RetestProvider("deepseek");
    private Task RetestMistral() => RetestProvider("mistral");
    private Task RetestGrok() => RetestProvider("grok");
    private Task RetestGroq() => RetestProvider("groq");
    private Task RetestTogether() => RetestProvider("together");
    private Task RetestOpenrouter() => RetestProvider("openrouter");
    private Task RetestFireworks() => RetestProvider("fireworks");
    private Task RetestCohere() => RetestProvider("cohere");

    private async Task TestProvider(string name, string key, string endpoint, string authHeader, string body)
    {
        if (string.IsNullOrWhiteSpace(key)) { _apiStatus[name] = "none"; await InvokeAsync(StateHasChanged); return; }
        _apiStatus[name] = "testing";
        await InvokeAsync(StateHasChanged);

        if (name == "gemini")
        {
            endpoint = $"https://generativelanguage.googleapis.com/v1beta/models/{SettingsSvc.GeminiModel}:generateContent?key={key}";
            authHeader = "";
            body = """{"contents":[{"parts":[{"text":"hi"}]}],"generationConfig":{"maxOutputTokens":1}}""";
        }

        try
        {
            using var handler = new HttpClientHandler { CheckCertificateRevocationList = false };
            using var http = new HttpClient(handler) { Timeout = TimeSpan.FromSeconds(15) };
            using var req = new HttpRequestMessage(HttpMethod.Post, endpoint);
            req.Content = new StringContent(body, System.Text.Encoding.UTF8, "application/json");

            if (name == "anthropic")
            {
                req.Headers.Add("x-api-key", key);
                req.Headers.Add("anthropic-version", "2023-06-01");
            }
            else if (authHeader == "Bearer")
            {
                req.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", key);
            }

            var resp = await http.SendAsync(req);
            _apiStatus[name] = resp.IsSuccessStatusCode ? "ok" : "fail";
        }
        catch
        {
            _apiStatus[name] = "fail";
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadVoices()
    {
        loadingVoices = true;
        StateHasChanged();
        try
        {
            voices = await TtsSvc.ListVoicesAsync();
            if (string.IsNullOrWhiteSpace(SettingsSvc.ElevenLabsVoiceId) && voices.Any())
            {
                var defaultVoice = voices.FirstOrDefault(v =>
                    v.Name.Equals("Oliver Silk", StringComparison.OrdinalIgnoreCase))
                    ?? voices.First();
                SettingsSvc.ElevenLabsVoiceId = defaultVoice.VoiceId;
                SettingsSvc.NarratorVoiceName = defaultVoice.Name;
            }
        }
        finally { loadingVoices = false; }
    }

    private void OnVoiceSelected(ChangeEventArgs e)
    {
        var voiceId = e.Value?.ToString();
        if (!string.IsNullOrEmpty(voiceId))
        {
            SettingsSvc.ElevenLabsVoiceId = voiceId;
            var voice = voices.FirstOrDefault(v => v.VoiceId == voiceId);
            SettingsSvc.NarratorVoiceName = voice?.Name ?? "";
        }
    }

    private async Task TestTts()
    {
        testingTts = true; ttsTestResult = null;
        try
        {
            var audio = await TtsSvc.SynthesizeAsync("The neon bleeds through cracked concrete. Welcome to the machine.");
            ttsTestSuccess = audio.Length > 0;
            ttsTestResult = ttsTestSuccess ? $"Success ({audio.Length / 1024}KB)" : "Empty response";
        }
        catch (Exception ex) { ttsTestSuccess = false; ttsTestResult = ex.Message; }
        finally { testingTts = false; }
    }

    private void SaveSettings() { _ = SettingsSvc.TtsModel; }


    private async Task DoReset() { SettingsSvc.ResetToDefaults(); confirmReset = false; await TestAllProviders(); }

    private async Task RebuildGraph()
    {
        rebuilding = true; StateHasChanged();
        await Task.Run(() => Graph.Rebuild());
        rebuilding = false;
    }

    private async Task ValidateJson()
    {
        validating = true; brokenFiles = []; validationResult = null;
        StateHasChanged();

        await Task.Run(() =>
        {
            var dir = Paths.EngineDataDir;
            int total = 0, errors = 0;
            var broken = new List<string>();

            void Scan(string d)
            {
                foreach (var f in Directory.GetFiles(d, "*.json"))
                {
                    total++;
                    try { System.Text.Json.JsonDocument.Parse(File.ReadAllText(f)).Dispose(); }
                    catch (Exception ex)
                    {
                        errors++;
                        broken.Add(Path.GetRelativePath(dir, f) + ": " + ex.Message[..Math.Min(ex.Message.Length, 120)]);
                    }
                }
                foreach (var sub in Directory.GetDirectories(d)) Scan(sub);
            }

            Scan(dir);
            validationTotal = total;
            _validationErrors = errors;
            brokenFiles = broken;
            validationResult = "done";
        });

        validating = false;
    }

    private Dictionary<string, List<(string name, string json)>> GetAllReposForExport()
        => ExportDiscovery.GetAllRepos();
