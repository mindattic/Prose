            "Bearer", """{"model":"grok-3-mini","max_tokens":1,"messages":[{"role":"user","content":"hi"}]}"""),
        "groq" => (SettingsSvc.GroqApiKey, "https://api.groq.com/openai/v1/chat/completions",
            "Bearer", """{"model":"llama-3.1-8b-instant","max_tokens":1,"messages":[{"role":"user","content":"hi"}]}"""),
        "together" => (SettingsSvc.TogetherApiKey, "https://api.together.xyz/v1/chat/completions",
            "Bearer", """{"model":"meta-llama/Llama-3.3-70B-Instruct-Turbo","max_tokens":1,"messages":[{"role":"user","content":"hi"}]}"""),
        "openrouter" => (SettingsSvc.OpenRouterApiKey, "https://openrouter.ai/api/v1/chat/completions",
            "Bearer", """{"model":"meta-llama/llama-3.3-70b-instruct","max_tokens":1,"messages":[{"role":"user","content":"hi"}]}"""),
