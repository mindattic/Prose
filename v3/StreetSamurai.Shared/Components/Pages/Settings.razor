@page "/settings"
@inject SettingsService SettingsSvc

<h4 class="text-danger mb-3">Settings</h4>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted">Anthropic API</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label text-muted">API Key</label>
                    <input type="password" class="form-control bg-dark text-light border-secondary"
                           @bind="SettingsSvc.ApiKey" @bind:event="onchange" />
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted">Model</label>
                    <select class="form-select bg-dark text-light border-secondary" @bind="SettingsSvc.Model">
                        <option value="claude-sonnet-4-6">Claude Sonnet 4.6</option>
                        <option value="claude-opus-4-6">Claude Opus 4.6</option>
                        <option value="claude-haiku-4-5-20251001">Claude Haiku 4.5</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted">Max Tokens</label>
                    <input type="number" class="form-control bg-dark text-light border-secondary"
                           @bind="SettingsSvc.MaxTokens" @bind:event="onchange" />
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted">Canon Engine</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label text-muted">Canon Root Path</label>
                    <input type="text" class="form-control bg-dark text-light border-secondary"
                           placeholder="D:\Projects\MindAttic\StreetSamurai"
                           @bind="SettingsSvc.CanonRootPath" @bind:event="onchange" />
                    <small class="text-muted">Path to the StreetSamurai repo containing worldbuilding/</small>
                </div>
            </div>
        </div>

        <div class="card bg-dark text-light border-secondary mt-3">
            <div class="card-header text-muted">Editor</div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label text-muted">Font Size</label>
                    <input type="number" class="form-control bg-dark text-light border-secondary"
                           min="10" max="24"
                           @bind="SettingsSvc.EditorFontSize" @bind:event="onchange" />
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted">Auto-Save Interval (ms)</label>
                    <input type="number" class="form-control bg-dark text-light border-secondary"
                           min="500" max="10000" step="500"
                           @bind="SettingsSvc.AutoSaveIntervalMs" @bind:event="onchange" />
                </div>
            </div>
        </div>

        <div class="card bg-dark text-light border-secondary mt-3">
            <div class="card-header text-muted">ElevenLabs TTS <span class="badge bg-secondary ms-2">Coming Soon</span></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label text-muted">API Key</label>
                    <input type="password" class="form-control bg-dark text-light border-secondary"
                           placeholder="sk_..."
                           @bind="SettingsSvc.ElevenLabsApiKey" @bind:event="onchange" />
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted">Voice ID</label>
                    <input type="text" class="form-control bg-dark text-light border-secondary"
                           placeholder="JBFqnCBsd6RMkjVDRZzb"
                           @bind="SettingsSvc.ElevenLabsVoiceId" @bind:event="onchange" />
                </div>
            </div>
        </div>
    </div>
</div>
