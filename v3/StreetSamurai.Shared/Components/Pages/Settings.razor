    private async Task LaunchLoreTripleExtraction()
    {
        factStatus = "Launching pipeline...";
        await InvokeAsync(StateHasChanged);

        try
        {
            var pipelineDir = Path.Combine(Paths.DataRoot, "scripts", "py");
            var scriptPath = Path.Combine(pipelineDir, "run_fact_pipeline.py");

            if (!File.Exists(scriptPath))
            {
                factStatus = "Pipeline not found at " + scriptPath;
                return;
            }

            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "python",
                Arguments = $"\"{scriptPath}\"",
                WorkingDirectory = pipelineDir,
                UseShellExecute = true,
                CreateNoWindow = false
            };
            psi.Environment["PYTHONIOENCODING"] = "utf-8";

            System.Diagnostics.Process.Start(psi);
            factStatus = "Pipeline launched in terminal. Check the window for progress.";
        }
        catch (Exception ex)
        {
            factStatus = $"Failed to launch: {ex.Message}";
        }

        await InvokeAsync(StateHasChanged);
