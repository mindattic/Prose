@page "/factions"
@inject FactionRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject WorldGraphService Graph

<div class="dict-layout">
    <div class="dict-list">
        <div class="card bg-dark text-light border-secondary mb-2 card-body">
            <FilterBar AllTags="allTags" @bind-Filter="filter" SelectedTags="selectedTags" SelectedTagsChanged="OnTagsChanged" />

        </div>
        <div class="dict-items">
            @foreach (var f in PagedItems)
            {
                <div class="list-item text-light @(editing?.Name == f.Name ? "active" : "")" @onclick="() => Edit(f)">
                    <div class="fw-bold small">@f.Name</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@f.Type</div>
                </div>
            }
        </div>
        <PaginationBar CurrentPage="currentPage" TotalPages="TotalPages" OnPageChanged="p => currentPage = p" />
    </div>

    <div class="dict-editor">
        @if (editing != null)
        {
            <EditViewToggle RepoName="factions" Title="@(isNew ? "New Faction" : editing.Name)" Json="@System.Text.Json.JsonSerializer.Serialize(editing)" HideToggle="@_confirmDelete">
                <HeaderButtons>
                    @if (!_confirmDelete)
                    {
                        <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i><div class="btn-lbl"> Save</div></button>
                        @if (!isNew) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-archive"></i></button> }
                    }
                    else
                    {
                        <span class="small text-muted me-1">Archive Entry?</span>
                        <button class="btn btn-sm btn-danger" @onclick="DoDelete"><div class="btn-lbl">Yes</div></button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false"><div class="btn-lbl">No</div></button>
                    }
                </HeaderButtons>
                <ChildContent>
                    <div class="row g-3 mb-3">
                        <div class="col-4"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Name" /></div>
                        <div class="col-4"><div class="field-label">Motto</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Motto" /></div>
                        <div class="col-4"><div class="field-label">Territory</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Territory" /></div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6"><div class="field-label">Leadership</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Leadership" /></div>
                    </div>
                    <div class="mb-3"><div class="field-label">Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.Description"></textarea></div>
                    <div class="mb-3"><div class="field-label">Ideology</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.Ideology"></textarea></div>
                    <div class="mb-3"><div class="field-label">Narrative Function</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.NarrativeFunction"></textarea></div>
                    <div class="mb-3">
                        <div class="field-label">Known Members</div>
                        @for (int i = 0; i < memberRows.Count; i++)
                        {
                            var idx = i;
                            <div class="d-flex gap-2 mb-1">
                                <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Name" @bind="memberRows[idx].Name" style="flex:2" />
                                <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Role" @bind="memberRows[idx].Role" style="flex:2" />
                                <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Status" @bind="memberRows[idx].Status" style="flex:1" />
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => memberRows.RemoveAt(idx)"><i class="bi bi-x"></i></button>
                            </div>
                        }
                        <button class="btn btn-sm btn-outline-secondary mt-1" @onclick="() => memberRows.Add(new FactionMember())"><i class="bi bi-plus"></i> Add Member</button>
                    </div>
                </ChildContent>
            </EditViewToggle>
        }
        else { <div class="text-muted d-flex align-items-center justify-content-center h-100">Select a faction or create a new one</div> }
    </div>
</div>

@code {
    private List<FactionData> items = [];
    private FactionData? editing;
    private bool isNew, _confirmDelete;
    private string originalName = "";
    private string filter = "";
    private List<FactionMember> memberRows = [];
    private List<(string name, int count)> allTags = [];
    private HashSet<string> selectedTags = [];

    private IEnumerable<FactionData> FilteredItems
    {
        get
        {
            IEnumerable<FactionData> result = items;
            if (!string.IsNullOrWhiteSpace(filter))
                result = result.Where(f => f.Name.Contains(filter, StringComparison.OrdinalIgnoreCase));
            if (selectedTags.Count > 0)
                result = result.Where(f => selectedTags.All(t => f.Tags.Contains(t)));
            return result;
        }
    }
    private int currentPage = 1;
    private const int PageSize = 100;
    private IEnumerable<FactionData> PagedItems { get { var f = FilteredItems.ToList(); var mp = Math.Max(1, (int)Math.Ceiling(f.Count / (double)PageSize)); if (currentPage > mp) currentPage = mp; return f.Skip((currentPage - 1) * PageSize).Take(PageSize); } }
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredItems.Count() / PageSize));

    protected override void OnInitialized() { Repo.Reload(); items = Repo.GetAll(); RebuildTags(); if (Nav.Uri.Contains("new=true")) AddNew(); else { var qid = Nav.Uri.Contains("id=") ? Uri.UnescapeDataString(Nav.Uri.Split(new[]{"id="}, StringSplitOptions.None).Last().Split(new[]{"&"}, StringSplitOptions.None)[0]) : ""; if (!string.IsNullOrEmpty(qid)) { var t = items.FirstOrDefault(e => e.Id == qid); if (t != null) Edit(t); } } }
    private void AddNew() { editing = new FactionData(); isNew = true; _confirmDelete = false; memberRows = []; }
    private void Edit(FactionData f) { _ = JS.InvokeVoidAsync("localStorage.setItem", "ss_sel_factions", f.Id); editing = f; originalName = f.Name; isNew = false; _confirmDelete = false; memberRows = f.KnownMembers.Select(m => new FactionMember { Name = m.Name, Role = m.Role, Status = m.Status, Notes = m.Notes }).ToList(); }
    private void SaveEdit() { if (editing == null || string.IsNullOrWhiteSpace(editing.Name)) return; editing.KnownMembers = memberRows.Where(m => !string.IsNullOrWhiteSpace(m.Name)).ToList(); if (!isNew && originalName != editing.Name) Repo.Delete(originalName); Repo.Save(editing); editing = null; items = Repo.GetAll(); }
    private void DoDelete() { if (editing == null) return; Graph.RemoveNode(editing.Name); Repo.Delete(editing.Name); editing = null; _confirmDelete = false; items = Repo.GetAll(); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("writeInterop.autoResizeAll");
        if (firstRender && editing == null && items.Count > 0 && !Nav.Uri.Contains("new=true") && !Nav.Uri.Contains("id="))
        {
            var lastId = "";
            try { lastId = await JS.InvokeAsync<string>("localStorage.getItem", "ss_sel_factions") ?? ""; } catch { }
            var target = (!string.IsNullOrEmpty(lastId) ? items.FirstOrDefault(x => x.Id == lastId) : null) ?? items.First();
            if (target != null) { Edit(target); StateHasChanged(); }
        }
    }
    private void RebuildTags() { allTags = items.SelectMany(x => x.Tags).GroupBy(t => t).Select(g => (g.Key, g.Count())).OrderBy(t => t.Key).ToList(); }
    private void OnTagsChanged(HashSet<string> tags) { selectedTags = tags; }
    private List<(string name, string json)> GetExportEntries() => items.Select(e => (e.Name, System.Text.Json.JsonSerializer.Serialize(e))).ToList();
}
