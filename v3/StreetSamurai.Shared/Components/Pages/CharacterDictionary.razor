@page "/characters"
@inject CharacterRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject WorldGraphService Graph

<div class="dict-layout">
    <div class="dict-list bg-dark border-end border-secondary">
        <div class="p-2">
            <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                   placeholder="Filter..." @bind="filter" @bind:event="oninput" />
        </div>
        @foreach (var c in FilteredItems)
        {
            <div class="list-item text-light @(editing?.Name == c.Name ? "active" : "")" @onclick="() => Edit(c)">
                <div class="fw-bold small">@c.Name</div>
                <div class="text-muted" style="font-size: 0.7rem;">@c.Role</div>
            </div>
        }
        <div class="p-2">
            <ExportButton Mode="repo" RepoName="Characters" GetRepoEntries="GetExportEntries" />
            <button class="btn btn-sm btn-outline-danger w-100" @onclick="AddNew"><i class="bi bi-plus-lg"></i> New Character</button>
        </div>
    </div>

    <div class="dict-editor">
        @if (editing != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-danger mb-0">@(isNew ? "New Character" : editing.Name)</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i> Save</button>
                    @if (!isNew) { <ExportButton Mode="entry" RepoName="Characters" EntryName="@editing.Name" EntryJson="@System.Text.Json.JsonSerializer.Serialize(editing)" /> }
                    @if (!isNew && !_confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-trash3"></i></button> }
                    @if (_confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete">Confirm</button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false">No</button> }
                </div>
            </div>

            @* ── Identity ─────────────────────────────── *@
            <div class="field-label text-danger">Identity</div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 3; min-width: 180px;"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Name" /></div>
                <div style="flex: 1; min-width: 80px;"><div class="field-label">Gender</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Gender" /></div>
                <div style="flex: 1; min-width: 80px;"><div class="field-label">Pronouns</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Pronouns" /></div>
                <div style="min-width: 55px;"><div class="field-label">Age</div><input type="number" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Age" /></div>
                <div style="flex: 1; min-width: 70px;"><div class="field-label">Status</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Status" /></div>
                <div style="flex: 1; min-width: 100px;"><div class="field-label">Affiliation</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Affiliation" /></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 2; min-width: 200px;"><div class="field-label">Role</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Role" /></div>
                <div style="flex: 2; min-width: 200px;"><div class="field-label">Location</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Location" /></div>
            </div>
            <div class="mb-3"><div class="field-label">Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.Description"></textarea></div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Augmentations</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.Augmentations"></textarea></div>
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Daily Life</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.DailyLife"></textarea></div>
            </div>

            @* ── Narrative ────────────────────────────── *@
            <div class="field-label text-danger mt-3">Narrative</div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Narrative Function</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.NarrativeFunction"></textarea></div>
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Narration Voice</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.NarrationVoice"></textarea></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Vocabulary</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.SpeechPatterns.Vocabulary"></textarea></div>
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Cadence</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.SpeechPatterns.Cadence"></textarea></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Verbal Tics (one per line)</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editVerbalTics"></textarea></div>
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Example Lines (one per line)</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editExampleLines"></textarea></div>
            </div>
            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="usesFacets" @bind="editing.UsesFacets" />
                <label class="form-check-label text-muted small" for="usesFacets">Uses facet tags in narration</label>
            </div>

            @* ── Psychology ───────────────────────────── *@
            <div class="field-label text-danger mt-3">Psychology</div>
            <div class="field-label">Facet Weights</div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="min-width: 70px;"><small class="text-muted">Wound</small><input type="number" step="0.05" min="0" max="1" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editWound" /></div>
                <div style="min-width: 70px;"><small class="text-muted">Ideal</small><input type="number" step="0.05" min="0" max="1" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editIdeal" /></div>
                <div style="min-width: 70px;"><small class="text-muted">Id</small><input type="number" step="0.05" min="0" max="1" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editId" /></div>
                <div style="min-width: 70px;"><small class="text-muted">Shadow</small><input type="number" step="0.05" min="0" max="1" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editShadow" /></div>
                <div style="min-width: 70px;"><small class="text-muted">Mask</small><input type="number" step="0.05" min="0" max="1" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editMask" /></div>
                <div style="min-width: 70px;"><small class="text-muted">Ghost</small><input type="number" step="0.05" min="0" max="1" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editGhost" /></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Core Fears</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editCoreFears"></textarea></div>
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Core Desires</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editCoreDesires"></textarea></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Coping Mechanisms</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editCopingMechanisms"></textarea></div>
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Blind Spots</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editBlindSpots"></textarea></div>
            </div>
            <div class="mb-3"><div class="field-label">Secret</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.Psychology.Secret"></textarea></div>

            @* ── Behavioral ──────────────────────────── *@
            <div class="field-label text-danger mt-3">Behavioral</div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Decision Rules (one per line)</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editDecisionRules"></textarea></div>
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Escalation Ladder (one per line)</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editEscalation"></textarea></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Habits (one per line)</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editHabits"></textarea></div>
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Breaking Points (one per line)</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editBreakingPoints"></textarea></div>
            </div>
            <div class="mb-3"><div class="field-label">Contradictions (one per line)</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editContradictions"></textarea></div>

            @* ── Stress Responses ─────────────────────── *@
            <div class="field-label text-danger mt-3">Stress Responses</div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Low</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editStressLow"></textarea></div>
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Medium</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editStressMed"></textarea></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 200px;"><div class="field-label">High</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editStressHigh"></textarea></div>
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Critical</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editStressCrit"></textarea></div>
            </div>

            @* ── Story ───────────────────────────────── *@
            <div class="field-label text-danger mt-3">Story</div>
            <div class="mb-3"><div class="field-label">Story Hooks (one per line)</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editStoryHooks"></textarea></div>
        }
        else
        {
            <div class="text-muted d-flex align-items-center justify-content-center h-100">Select a character or create a new one</div>
        }
    </div>
</div>

@code {
    private List<CharacterData> items = [];
    private CharacterData? editing;
    private bool isNew, _confirmDelete;
    private string originalName = "";
    private string filter = "";

    // Facet weights
    private double editWound, _editIdeal, _editId, _editShadow, _editMask, _editGhost;

    // List fields edited as newline-separated strings
    private string editCoreFears = "", _editCoreDesires = "", _editCopingMechanisms = "", _editBlindSpots = "";
    private string editVerbalTics = "", _editExampleLines = "";
    private string editDecisionRules = "", _editEscalation = "", _editContradictions = "", _editHabits = "", _editBreakingPoints = "";
    private string editStressLow = "", _editStressMed = "", _editStressHigh = "", _editStressCrit = "";
    private string editStoryHooks = "";

    private IEnumerable<CharacterData> FilteredItems => string.IsNullOrWhiteSpace(filter)
        ? items
        : items.Where(c => c.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || c.Role.Contains(filter, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        Repo.Reload(); items = Repo.GetAll();
        if (Nav.Uri.Contains("new=true")) AddNew();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) =>
        await JS.InvokeVoidAsync("writeInterop.autoResizeAll");

    private void AddNew()
    {
        editing = new CharacterData();
        isNew = true; _confirmDelete = false;
        editWound = 0.5; _editIdeal = 0.5; _editId = 0.5;
        _editShadow = 0.5; _editMask = 0.5; _editGhost = 0.5;
        ClearListFields();
    }

    private void Edit(CharacterData c)
    {
        editing = c; originalName = c.Name; isNew = false; _confirmDelete = false;
        var fw = c.Psychology.FacetWeights;
        editWound = fw.Wound; _editIdeal = fw.Ideal; _editId = fw.Id;
        _editShadow = fw.Shadow; _editMask = fw.Mask; _editGhost = fw.Ghost;

        // Psychology lists
        editCoreFears = string.Join("\n", c.Psychology.CoreFears);
        _editCoreDesires = string.Join("\n", c.Psychology.CoreDesires);
        _editCopingMechanisms = string.Join("\n", c.Psychology.CopingMechanisms);
        _editBlindSpots = string.Join("\n", c.Psychology.BlindSpots);

        // Speech
        editVerbalTics = string.Join("\n", c.SpeechPatterns.VerbalTics);
        _editExampleLines = string.Join("\n", c.SpeechPatterns.ExampleLines);

        // Behavioral
        editDecisionRules = string.Join("\n", c.Behavioral.DecisionRules);
        _editEscalation = string.Join("\n", c.Behavioral.EscalationLadder);
        _editContradictions = string.Join("\n", c.Behavioral.Contradictions);
        _editHabits = string.Join("\n", c.Behavioral.Habits);
        _editBreakingPoints = string.Join("\n", c.Behavioral.BreakingPoints);

        // Stress
        c.Behavioral.StressResponses.TryGetValue("low", out var sl); editStressLow = sl ?? "";
        c.Behavioral.StressResponses.TryGetValue("medium", out var sm); _editStressMed = sm ?? "";
        c.Behavioral.StressResponses.TryGetValue("high", out var sh); _editStressHigh = sh ?? "";
        c.Behavioral.StressResponses.TryGetValue("critical", out var sc); _editStressCrit = sc ?? "";

        // Story
        editStoryHooks = string.Join("\n", c.StoryHooks);
    }

    private void SaveEdit()
    {
        if (editing == null || string.IsNullOrWhiteSpace(editing.Name)) return;

        // Facet weights
        editing.Psychology.FacetWeights.Wound = editWound; editing.Psychology.FacetWeights.Ideal = _editIdeal;
        editing.Psychology.FacetWeights.Id = _editId; editing.Psychology.FacetWeights.Shadow = _editShadow;
        editing.Psychology.FacetWeights.Mask = _editMask; editing.Psychology.FacetWeights.Ghost = _editGhost;

        // Psychology lists
        editing.Psychology.CoreFears = SplitLines(editCoreFears);
        editing.Psychology.CoreDesires = SplitLines(_editCoreDesires);
        editing.Psychology.CopingMechanisms = SplitLines(_editCopingMechanisms);
        editing.Psychology.BlindSpots = SplitLines(_editBlindSpots);

        // Speech
        editing.SpeechPatterns.VerbalTics = SplitLines(editVerbalTics);
        editing.SpeechPatterns.ExampleLines = SplitLines(_editExampleLines);

        // Behavioral
        editing.Behavioral.DecisionRules = SplitLines(editDecisionRules);
        editing.Behavioral.EscalationLadder = SplitLines(_editEscalation);
        editing.Behavioral.Contradictions = SplitLines(_editContradictions);
        editing.Behavioral.Habits = SplitLines(_editHabits);
        editing.Behavioral.BreakingPoints = SplitLines(_editBreakingPoints);
        editing.Behavioral.StressResponses = new Dictionary<string, string>
        {
            ["low"] = editStressLow,
            ["medium"] = _editStressMed,
            ["high"] = _editStressHigh,
            ["critical"] = _editStressCrit,
        };

        // Story
        editing.StoryHooks = SplitLines(editStoryHooks);

        if (!isNew && originalName != editing.Name) Repo.Delete(originalName);
        Repo.Save(editing); editing = null; items = Repo.GetAll();
    }

    private void DoDelete()
    {
        if (editing == null) return;
        Graph.RemoveNode(editing.Name);
        Repo.Delete(editing.Name);
        editing = null; _confirmDelete = false; items = Repo.GetAll();
    }

    private void ClearListFields()
    {
        editCoreFears = _editCoreDesires = _editCopingMechanisms = _editBlindSpots = "";
        editVerbalTics = _editExampleLines = "";
        editDecisionRules = _editEscalation = _editContradictions = _editHabits = _editBreakingPoints = "";
        editStressLow = _editStressMed = _editStressHigh = _editStressCrit = "";
        editStoryHooks = "";
    }

    private static List<string> SplitLines(string text) =>
        (text ?? "").Split('\n', StringSplitOptions.RemoveEmptyEntries).Select(l => l.Trim()).Where(l => l.Length > 0).ToList();
    private List<(string name, string json)> GetExportEntries() => items.Select(e => (e.Name, System.Text.Json.JsonSerializer.Serialize(e))).ToList();
}
