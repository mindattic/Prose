@page "/characters"
@inject CharacterRepository Repo

<div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="text-danger mb-0">Characters</h4>
    <button class="btn btn-sm btn-outline-danger" @onclick="AddNew"><i class="bi bi-plus-lg"></i> New Character</button>
</div>

@if (_editing != null)
{
    <div class="card bg-dark text-light border-danger mb-3">
        <div class="card-header d-flex justify-content-between align-items-center border-secondary">
            <span class="text-danger fw-bold">@(_isNew ? "New Character" : _editing.Name)</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="card-body">
            <div class="row g-2 mb-2">
                <div class="col-md-4">
                    <label class="form-label text-muted small">Name</label>
                    <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Name" />
                </div>
                <div class="col-md-2">
                    <label class="form-label text-muted small">Age</label>
                    <input type="number" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Age" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small">Status</label>
                    <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Status" />
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted small">Affiliation</label>
                    <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Affiliation" />
                </div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-6">
                    <label class="form-label text-muted small">Role</label>
                    <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Role" />
                </div>
                <div class="col-md-6">
                    <label class="form-label text-muted small">Augmentations</label>
                    <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Augmentations" />
                </div>
            </div>
            <div class="mb-2">
                <label class="form-label text-muted small">Description</label>
                <textarea class="form-control form-control-sm bg-dark text-light border-secondary" rows="4" @bind="_editing.Description"></textarea>
            </div>
            <div class="mb-2">
                <label class="form-label text-muted small">Narrative Function</label>
                <textarea class="form-control form-control-sm bg-dark text-light border-secondary" rows="2" @bind="_editing.NarrativeFunction"></textarea>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-2"><label class="form-label text-muted small">Wound</label><input type="number" step="0.05" min="0" max="1" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editWound" /></div>
                <div class="col-md-2"><label class="form-label text-muted small">Ideal</label><input type="number" step="0.05" min="0" max="1" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editIdeal" /></div>
                <div class="col-md-2"><label class="form-label text-muted small">Id</label><input type="number" step="0.05" min="0" max="1" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editId" /></div>
                <div class="col-md-2"><label class="form-label text-muted small">Shadow</label><input type="number" step="0.05" min="0" max="1" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editShadow" /></div>
                <div class="col-md-2"><label class="form-label text-muted small">Mask</label><input type="number" step="0.05" min="0" max="1" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editMask" /></div>
                <div class="col-md-2"><label class="form-label text-muted small">Ghost</label><input type="number" step="0.05" min="0" max="1" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editGhost" /></div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i> Save</button>
                @if (!_isNew)
                {
                    @if (_confirmDelete)
                    {
                        <span class="d-flex align-items-center gap-1">
                            <small class="text-warning">Delete @_editing.Name?</small>
                            <button class="btn btn-sm btn-danger" @onclick="DoDelete">Yes</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false">No</button>
                        </span>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-trash3"></i> Delete</button>
                    }
                }
                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
            </div>
        </div>
    </div>
}

<div class="table-responsive">
    <table class="table table-dark table-hover table-sm">
        <thead>
            <tr><th>Name</th><th>Role</th><th>Status</th><th>Affiliation</th><th>Age</th></tr>
        </thead>
        <tbody>
            @foreach (var c in _items)
            {
                <tr style="cursor: pointer;" @onclick="() => Edit(c)">
                    <td class="fw-bold">@c.Name</td>
                    <td class="text-muted small">@c.Role</td>
                    <td><span class="badge @(c.Status == "active" ? "bg-success" : "bg-secondary")">@c.Status</span></td>
                    <td class="text-muted small">@c.Affiliation</td>
                    <td class="text-muted small">@c.Age</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    private List<CharacterData> _items = [];
    private CharacterData? _editing;
    private bool _isNew;
    private bool _confirmDelete;
    private string _originalName = "";

    // Facet weight edit fields (records are immutable, need mutable proxies)
    private double _editWound, _editIdeal, _editId, _editShadow, _editMask, _editGhost;

    protected override void OnInitialized() => _items = Repo.GetAll();

    private void AddNew()
    {
        _editing = new CharacterData();
        _isNew = true;
        _confirmDelete = false;
        _editWound = 0.5; _editIdeal = 0.5; _editId = 0.5;
        _editShadow = 0.5; _editMask = 0.5; _editGhost = 0.5;
    }

    private void Edit(CharacterData c)
    {
        _editing = c;
        _originalName = c.Name;
        _isNew = false;
        _confirmDelete = false;
        var fw = c.Psychology.FacetWeights;
        _editWound = fw.Wound; _editIdeal = fw.Ideal; _editId = fw.Id;
        _editShadow = fw.Shadow; _editMask = fw.Mask; _editGhost = fw.Ghost;
    }

    private void SaveEdit()
    {
        if (_editing == null || string.IsNullOrWhiteSpace(_editing.Name)) return;

        // Update facet weights
        _editing = _editing with
        {
            Psychology = _editing.Psychology with
            {
                FacetWeights = new FacetWeights
                {
                    Wound = _editWound, Ideal = _editIdeal, Id = _editId,
                    Shadow = _editShadow, Mask = _editMask, Ghost = _editGhost
                }
            }
        };

        // If name changed during edit, delete the old entry
        if (!_isNew && _originalName != _editing.Name)
            Repo.Delete(_originalName);

        Repo.Save(_editing);
        _editing = null;
        _items = Repo.GetAll();
    }

    private void DoDelete()
    {
        if (_editing == null) return;
        Repo.Delete(_editing.Name);
        _editing = null;
        _confirmDelete = false;
        _items = Repo.GetAll();
    }

    private void CancelEdit()
    {
        _editing = null;
        _confirmDelete = false;
        _items = Repo.GetAll(); // Reload to discard in-memory mutations
    }
}
