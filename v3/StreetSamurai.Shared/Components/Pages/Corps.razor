@page "/corps"
@page "/corps/{CorpId}"
@inject CanonService Canon

@if (_selectedCorp != null)
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection">Back</button>
        <h4 class="text-danger mb-0">#@_selectedCorp.Number — @_selectedCorp.Name</h4>
        <a href="graph" class="btn btn-sm btn-outline-info ms-auto" title="View in World Graph">
            <i class="bi bi-diagram-3"></i> Graph
        </a>
    </div>

    <div class="row g-3">
        <div class="col-md-5">
            <div class="card bg-dark text-light border-secondary">
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(_selectedCorp.Sector))
                    {
                        <div class="mb-2"><span class="text-muted">Sector:</span> @_selectedCorp.Sector</div>
                    }
                    @if (!string.IsNullOrEmpty(_selectedCorp.Valuation))
                    {
                        <div class="mb-2"><span class="text-muted">Valuation:</span> @_selectedCorp.Valuation</div>
                    }
                    @if (!string.IsNullOrEmpty(_selectedCorp.Territory))
                    {
                        <div class="mb-2"><span class="text-muted">Territory:</span> @_selectedCorp.Territory</div>
                    }
                    @if (!string.IsNullOrEmpty(_selectedCorp.SecurityForce))
                    {
                        <div class="mb-2"><span class="text-muted">Security:</span> @_selectedCorp.SecurityForce</div>
                    }
                    @if (!string.IsNullOrEmpty(_selectedCorp.KeyDetail))
                    {
                        <div class="mb-2"><span class="text-muted">Key Detail:</span> @_selectedCorp.KeyDetail</div>
                    }
                    <div class="mt-2"><small class="text-muted">Source: @_selectedCorp.SourceFile</small></div>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card bg-dark text-light border-secondary">
                <div class="card-body" style="max-height: 70vh; overflow-y: auto; white-space: pre-wrap; font-size: 0.85rem;">@_selectedCorp.FullText</div>
            </div>
        </div>
    </div>
}
else
{
    <h4 class="text-danger mb-1">Corponations (@_corps.Count)</h4>
    <p class="text-muted mb-3">Sovereign corporate entities — each controls territory, maintains private security forces, and operates beyond nation-state law.</p>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="input-group" style="max-width: 300px;">
            <input type="text" class="form-control bg-dark text-light border-secondary"
                   placeholder="Filter corponations by name or sector..." title="Type to filter the list below"
                   @bind="_filter" @bind:event="oninput" @onkeyup="ApplyFilter" />
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-dark table-hover table-sm">
            <thead>
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>Name</th>
                    <th>Sector</th>
                    <th>Valuation</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _filteredCorps)
                {
                    <tr @onclick="() => SelectCorp(c)" style="cursor: pointer;">
                        <td class="text-muted">@c.Number</td>
                        <td>@c.Name</td>
                        <td class="text-muted small">@Truncate(c.Sector, 40)</td>
                        <td class="text-info small">@Truncate(c.Valuation, 15)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public string? CorpId { get; set; }

    private List<Corponation> _corps = [];
    private List<Corponation> _filteredCorps = [];
    private Corponation? _selectedCorp;
    private string _filter = "";

    protected override void OnInitialized()
    {
        _corps = Canon.ListCorponations();
        _filteredCorps = _corps;

        if (!string.IsNullOrEmpty(CorpId))
            _selectedCorp = Canon.GetCorponation(CorpId);
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_filter))
            _filteredCorps = _corps;
        else
            _filteredCorps = Canon.ListCorponations(_filter);
    }

    private void SelectCorp(Corponation c) => _selectedCorp = c;
    private void ClearSelection() => _selectedCorp = null;

    private static string Truncate(string s, int max) =>
        s.Length > max ? s[..(max - 3)] + "..." : s;
}
