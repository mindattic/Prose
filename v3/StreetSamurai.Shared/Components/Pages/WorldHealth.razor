@page "/world-health"
@inject WorldConsistencyService Checker
@inject SettingsService Settings
@implements IDisposable

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-danger mb-0">World Health</h4>
    <div class="d-flex gap-2 align-items-center">
        @if (Checker.IsRunning)
        {
            @if (Checker.IsPaused)
            {
                <button class="btn btn-sm btn-outline-success" @onclick="Checker.Resume">
                    <i class="bi bi-play-fill"></i> Resume
                </button>
            }
            else
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="Checker.Pause">
                    <i class="bi bi-pause-fill"></i> Pause
                </button>
            }
            <button class="btn btn-sm btn-outline-danger" @onclick="Checker.Cancel">
                <i class="bi bi-stop-fill"></i> Cancel
            </button>
        }
        else
        {
            <button class="btn btn-sm btn-outline-warning" @onclick="StartRun"
                    disabled="@(Checker.IsRunning || string.IsNullOrWhiteSpace(Settings.ApiKey))">
                <i class="bi bi-heart-pulse"></i> Run Check
            </button>
        }
    </div>
</div>

@* Progress bar *@
@if (Checker.IsRunning)
{
    var p = Checker.Progress;
    var pct = p.Total > 0 ? (int)(100.0 * p.Processed / p.Total) : 0;
    var barColor = Checker.IsPaused ? "bg-secondary" : "bg-warning";
    <div class="mb-3 p-3 rounded" style="background:#1c2128;">
        <div class="d-flex justify-content-between small text-muted mb-1">
            <span class="@(Checker.IsPaused ? "text-muted" : "text-warning")">@p.Phase @(p.Current.Length > 0 ? "— " + p.Current : "")</span>
            <span>@p.Processed.ToString("N0") / @p.Total.ToString("N0")</span>
        </div>
        <div class="progress" style="height:3px;">
            <div class="progress-bar @barColor" style="width:@pct%"></div>
        </div>
    </div>
}

@* Phase toggles + summary *@
<div class="row g-2 mb-3">
    <div class="col-auto">
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" id="chkRule" checked="@runRules"
                   @onchange="@(e => runRules = (bool)(e.Value ?? true))" disabled="@Checker.IsRunning" />
            <label class="form-check-label small" for="chkRule">Rule Scan</label>
        </div>
    </div>
    <div class="col-auto">
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" id="chkConflict" checked="@runConflicts"
                   @onchange="@(e => runConflicts = (bool)(e.Value ?? true))" disabled="@Checker.IsRunning" />
            <label class="form-check-label small" for="chkConflict">Entity Conflicts</label>
        </div>
    </div>
    <div class="col-auto">
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="checkbox" id="chkDedup" checked="@runDedup"
                   @onchange="@(e => runDedup = (bool)(e.Value ?? true))" disabled="@Checker.IsRunning" />
            <label class="form-check-label small" for="chkDedup">Deduplication</label>
        </div>
    </div>
    <div class="col-auto ms-auto">
        <span class="badge bg-danger me-1">@Checker.RuleViolations.Count violations</span>
        <span class="badge bg-warning text-dark me-1">@Checker.EntityConflicts.Count conflicts</span>
        <span class="badge bg-secondary">@Checker.Duplicates.Count duplicates</span>
    </div>
</div>

<div class="row g-3">
    @* Rule violations *@
    <div class="col-lg-4">
        <div class="card bg-dark text-light border-secondary h-100">
            <div class="card-header text-muted d-flex justify-content-between align-items-center">
                <span><i class="bi bi-shield-exclamation text-danger"></i> Rule Violations</span>
                <span class="badge bg-danger">@Checker.RuleViolations.Count</span>
            </div>
            <div class="card-body p-0" style="max-height:460px;overflow-y:auto;">
                @if (Checker.RuleViolations.Count == 0)
                {
                    <div class="text-muted text-center py-4 small">
                        <i class="bi bi-check-circle text-success"></i> No violations found
                    </div>
                }
                else
                {
                    @foreach (var v in Checker.RuleViolations)
                    {
                        <div class="p-2 border-bottom border-secondary border-opacity-25">
                            <div class="small fw-bold text-danger">@Path.GetFileNameWithoutExtension(v.FilePath)</div>
                            <div class="small text-warning">@v.Rule</div>
                            <div class="small text-muted fst-italic mt-1" style="font-size:0.75rem;">@v.MatchedText</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @* Entity conflicts *@
    <div class="col-lg-4">
        <div class="card bg-dark text-light border-secondary h-100">
            <div class="card-header text-muted d-flex justify-content-between align-items-center">
                <span><i class="bi bi-exclamation-triangle text-warning"></i> Entity Conflicts</span>
                <span class="badge bg-warning text-dark">@Checker.EntityConflicts.Count</span>
            </div>
            <div class="card-body p-0" style="max-height:460px;overflow-y:auto;">
                @if (Checker.EntityConflicts.Count == 0)
                {
                    <div class="text-muted text-center py-4 small">
                        <i class="bi bi-check-circle text-success"></i> No conflicts found
                    </div>
                }
                else
                {
                    @foreach (var c in Checker.EntityConflicts)
                    {
                        var sevClass = c.Severity == "critical" ? "text-danger" : c.Severity == "moderate" ? "text-warning" : "text-muted";
                        <div class="p-2 border-bottom border-secondary border-opacity-25">
                            <div class="small">
                                <span class="text-info">@c.Entity1</span>
                                <span class="text-muted mx-1">↔</span>
                                <span class="text-info">@c.Entity2</span>
                            </div>
                            <div class="small text-light mt-1">@c.Description</div>
                            <div class="small @sevClass" style="font-size:0.75rem;">@c.Severity.ToUpper()</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    @* Duplicates *@
    <div class="col-lg-4">
        <div class="card bg-dark text-light border-secondary h-100">
            <div class="card-header text-muted d-flex justify-content-between align-items-center">
                <span><i class="bi bi-copy text-secondary"></i> Near-Duplicates</span>
                <div class="d-flex align-items-center gap-2">
                    <span class="small text-muted">≥</span>
                    <input type="range" class="form-range" style="width:60px;" min="70" max="100" step="5"
                           value="@((int)(Checker.DedupThreshold * 100))"
                           @onchange="OnThresholdChanged" />
                    <span class="small text-muted">@((int)(Checker.DedupThreshold * 100))%</span>
                    <span class="badge bg-secondary">@Checker.Duplicates.Count</span>
                </div>
            </div>
            <div class="card-body p-0" style="max-height:460px;overflow-y:auto;">
                @if (Checker.Duplicates.Count == 0)
                {
                    <div class="text-muted text-center py-4 small">
                        <i class="bi bi-check-circle text-success"></i> No duplicates found
                    </div>
                }
                else
                {
                    @foreach (var d in Checker.Duplicates.OrderByDescending(x => x.Score))
                    {
                        var scoreClass = d.Score >= 0.95 ? "text-danger" : d.Score >= 0.90 ? "text-warning" : "text-muted";
                        <div class="p-2 border-bottom border-secondary border-opacity-25">
                            <div class="small fw-bold @scoreClass">@d.Score.ToString("P0") match</div>
                            <div class="small text-info">@d.Name1</div>
                            <div class="small text-muted">@Path.GetFileNameWithoutExtension(d.File1)</div>
                            <div class="small text-secondary mt-1">vs</div>
                            <div class="small text-info">@d.Name2</div>
                            <div class="small text-muted">@Path.GetFileNameWithoutExtension(d.File2)</div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@code {
    private bool runRules     = true;
    private bool runConflicts = true;
    private bool runDedup     = true;

    protected override void OnInitialized()
    {
        Checker.StateChanged += OnStateChanged;
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private async Task StartRun()
    {
        Checker.RunRuleScan      = runRules;
        Checker.RunConflictCheck = runConflicts;
        Checker.RunDedup         = runDedup;
        StateHasChanged();
        _ = Checker.RunAsync();
        await Task.Yield();
    }

    private void OnThresholdChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var val))
            Checker.DedupThreshold = val / 100.0;
    }

    public void Dispose()
    {
        Checker.StateChanged -= OnStateChanged;
        if (Checker.IsRunning && !Checker.IsPaused)
            Checker.Pause();
    }
}
