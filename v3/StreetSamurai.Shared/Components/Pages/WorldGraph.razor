@page "/graph"
@inject WorldGraphService Graph
@inject IJSRuntime JS
@implements IDisposable


<h4 class="text-danger mb-3">World Graph</h4>
<div class="row g-2">
    @* ── Left: Filters + Node List ─────────────────────── *@
    <div class="col-md-3">
        <div class="card bg-dark text-light border-secondary mb-2">
            <div class="card-body py-2">
                <div class="mb-2">
                    <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="filterType" @bind:after="ApplyFilters">
                        <option value="">All types</option>
                        <option value="character">Characters</option>
                        <option value="organization">Corponations</option>
                        <option value="place">Places</option>
                        <option value="faction">Factions</option>
                        <option value="weapon">Weaponry</option>
                        <option value="equipment">Equipment</option>
                        <option value="technology">Technology</option>
                    </select>
                </div>
                <div class="mb-2">
                    <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                           placeholder="Search..." @bind="searchFilter" @bind:event="oninput" @bind:after="ApplyFilters" />
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-sm btn-outline-danger" @onclick="LoadAll" title="Load all nodes into the graph">
                        <i class="bi bi-globe"></i> Load All
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="UnpinAll" title="Unpin all nodes">
                        <i class="bi bi-pin-angle"></i> Unpin All
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="ClearCanvas" title="Clear the canvas">
                        <i class="bi bi-eraser"></i> Clear
                    </button>
                </div>
                <small class="text-muted mt-1" style="font-size: 0.7rem;">
                    <kbd>P</kbd> pin/unpin hovered node &middot; double-click to expand &middot; drag to move
                </small>
            </div>
        </div>

        @* ── Node list (click to add to graph) ─────────── *@
        <div class="card bg-dark text-light border-secondary" style="max-height: calc(100vh - var(--titlebar-offset) - var(--gutter) - 80px); overflow-y: auto;">
            <div class="card-header text-muted py-1 small">Click to explore (@filteredNodes.Count)</div>
            <div class="list-group list-group-flush">
                @foreach (var node in filteredNodes.Take(100))
                {
                    <button class="list-group-item list-group-item-action bg-dark text-light border-secondary py-1 d-flex justify-content-between align-items-center small @(selectedNode?.Id == node.Id ? "active" : "")"
                            @onclick="() => ExploreNode(node)">
                        <span>
                            <span class="badge @GetTypeBadgeClass(node.NodeType) me-1" style="font-size: 0.6rem;">@node.NodeType[..1].ToUpper()</span>
                            @node.Name
                        </span>
                        <span class="badge bg-secondary rounded-pill" style="font-size: 0.6rem;">@GetEdgeCount(node.Id)</span>
                    </button>
                }
            </div>
        </div>
    </div>

    @* ── Center: D3 Force Canvas + Detail ──────────────── *@
    <div class="col-md-9">
        @* ── D3 Canvas ────────────────────────────────────── *@
        <div id="graphCanvas" class="border border-secondary rounded mb-2"
             style="width: 100%; height: calc(100vh - var(--titlebar-offset) - var(--gutter) - 80px); background: #111;"></div>

        @* ── Selected Node Detail + Nearby Linkable Nodes ── *@
        @if (selectedNode != null)
        {
            <div class="row g-2">
                @* ── Node detail (left) ──────────────────────── *@
                <div class="col-md-6">
                    <div class="card bg-dark text-light border-secondary">
                        <div class="card-header d-flex justify-content-between align-items-center py-1">
                            <span>
                                <span class="badge @GetTypeBadgeClass(selectedNode.NodeType) me-1">@selectedNode.NodeType</span>
                                <strong>@selectedNode.Name</strong>
                                @if (selectedNode.Properties.TryGetValue("gender", out var gender) && gender.Length > 0)
                                {
                                    <small class="text-muted ms-2">@gender</small>
                                }
                                @if (selectedNode.Properties.TryGetValue("pronouns", out var pronouns) && pronouns.Length > 0)
                                {
                                    <small class="text-muted">(@pronouns)</small>
                                }
                            </span>
                            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => selectedNode = null"><i class="bi bi-x"></i></button>
                        </div>
                        <div class="card-body py-2 small" style="max-height: 30vh; overflow-y: auto;">
                            @if (selectedNode.Properties.TryGetValue("description", out var desc) && desc.Length > 0)
                            {
                                <div class="text-muted mb-2" style="line-height: 1.4;">@(desc.Length > 500 ? desc[..497] + "..." : desc)</div>
                            }
                            @foreach (var key in new[] { "role", "affiliation", "status", "category", "sector", "manufacturer", "tier_availability", "legality" })
                            {
                                if (selectedNode.Properties.TryGetValue(key, out var val) && val.Length > 0)
                                {
                                    <div><span class="text-info">@key:</span> @val</div>
                                }
                            }
                            @if (nodeEdges.Any())
                            {
                                <div class="mt-2">
                                    <small class="text-muted fw-bold">Connections (@nodeEdges.Count):</small>
                                    @foreach (var edge in nodeEdges.Take(20))
                                    {
                                        var other = edge.Source == selectedNode.Id ? edge.Target : edge.Source;
                                        var otherNode = Graph.GetNode(other);
                                        <div class="d-flex align-items-center gap-1" style="cursor: pointer;" @onclick="() => ExploreById(other)">
                                            <span class="badge @GetRelBadgeClass(edge.RelationType)" style="font-size: 0.65rem;">@edge.RelationType</span>
                                            <span>@(otherNode?.Name ?? other)</span>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* ── Nearby linkable nodes (right) ───────────── *@
                <div class="col-md-6">
                    <div class="card bg-dark text-light border-secondary">
                        <div class="card-header py-1 d-flex justify-content-between align-items-center">
                            <small class="text-muted fw-bold">Nearby — Link to @selectedNode.Name</small>
                            <div class="btn-group btn-group-sm">
                                <button class="btn @(hopDepth == 1 ? "btn-danger" : "btn-outline-secondary") py-0 px-2" @onclick="() => SetHopDepth(1)">1</button>
                                <button class="btn @(hopDepth == 2 ? "btn-danger" : "btn-outline-secondary") py-0 px-2" @onclick="() => SetHopDepth(2)">2</button>
                                <button class="btn @(hopDepth == 3 ? "btn-danger" : "btn-outline-secondary") py-0 px-2" @onclick="() => SetHopDepth(3)">3</button>
                                <small class="text-muted align-self-center ms-1">hops</small>
                            </div>
                        </div>
                        <div class="card-body py-1" style="max-height: 30vh; overflow-y: auto;">
                            @if (!string.IsNullOrEmpty(linkSuccess))
                            {
                                <div class="alert alert-success py-1 small mb-2">@linkSuccess</div>
                            }
                            @foreach (var group in _nearbyNodes.GroupBy(n => n.nodeType))
                            {
                                <div class="mb-1">
                                    <small class="fw-bold" style="color: @GetTypeColorHex(group.Key);">@group.Key</small>
                                    @foreach (var nearby in group)
                                    {
                                        var alreadyLinked = nodeEdges.Any(e =>
                                            (e.Source == selectedNode.Id && e.Target == nearby.id) ||
                                            (e.Target == selectedNode.Id && e.Source == nearby.id));
                                        <div class="d-flex align-items-center gap-1 py-1 border-bottom border-dark">
                                            <span class="badge @GetTypeBadgeClass(nearby.nodeType)" style="font-size: 0.55rem;">@nearby.nodeType[..1].ToUpper()</span>
                                            <span class="small flex-grow-1" style="cursor: pointer;" @onclick="() => ExploreById(nearby.id)">
                                                @nearby.name
                                                <small class="text-muted">(@nearby.hops hop@(nearby.hops > 1 ? "s" : ""))</small>
                                            </span>
                                            @if (alreadyLinked)
                                            {
                                                <span class="badge bg-success" style="font-size: 0.55rem;">linked</span>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-info py-0 px-1" style="font-size: 0.65rem;"
                                                        @onclick="() => StartLink(nearby.id, nearby.name)">
                                                    <i class="bi bi-link-45deg"></i>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @* ── Create Link Form ─────────────────────── *@
                    @if (linkTargetId != null)
                    {
                        <div class="card bg-dark text-light border-info mt-2">
                            <div class="card-header py-1 small text-info fw-bold">
                                Link: @selectedNode.Name → @linkTargetName
                            </div>
                            <div class="card-body py-2">
                                <div class="row g-2 mb-2">
                                    <div class="col-6">
                                        <small class="text-muted">Relationship Type</small>
                                        <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                                               placeholder="e.g. allied_with, wields, located_in"
                                               @bind="linkRelType" />
                                    </div>
                                    <div class="col-6">
                                        <small class="text-muted">Sentiment</small>
                                        <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="linkSentiment">
                                            <option value="neutral">neutral</option>
                                            <option value="positive">positive</option>
                                            <option value="negative">negative</option>
                                            <option value="mixed">mixed</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="mb-2">
                                    <small class="text-muted">Description</small>
                                    <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                                           placeholder="Brief description of the relationship"
                                           @bind="linkDescription" />
                                </div>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-info text-dark" @onclick="CreateLink"
                                            disabled="@string.IsNullOrWhiteSpace(linkRelType)">
                                        <i class="bi bi-link-45deg"></i> Create Link
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => linkTargetId = null">Cancel</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @* ── Scene Context Tester ─────────────────────────── *@
        <div class="card bg-dark text-light border-secondary mt-2">
            <div class="card-header text-muted py-1 d-flex justify-content-between small">
                <span>Scene Context Lookup</span>
                <small>What the LLM sees for a scene</small>
            </div>
            <div class="card-body py-2">
                <div class="input-group input-group-sm">
                    <input type="text" class="form-control bg-dark text-light border-secondary"
                           placeholder="Entity names, comma-separated (e.g. Sable, Kyle, Old Harbor)"
                           @bind="sceneQuery" />
                    <button class="btn btn-outline-danger" @onclick="LookupSceneContext">Lookup</button>
                </div>
                @if (!string.IsNullOrEmpty(sceneContext))
                {
                    <pre class="bg-black text-light p-2 rounded small mt-2" style="max-height: 300px; overflow-y: auto; white-space: pre-wrap; font-size: 0.75rem;">@sceneContext</pre>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<WorldNode> allNodes = [];
    private List<WorldEdge> allEdges = [];
    private List<WorldNode> filteredNodes = [];
    private WorldNode? selectedNode;
    private List<WorldEdge> nodeEdges = [];
    private string filterType = "";
    private string searchFilter = "";
    private string sceneQuery = "";
    private string sceneContext = "";

    // Nearby linkable nodes
    private int hopDepth = 2;
    private List<(string id, string name, string nodeType, int hops)> _nearbyNodes = [];
    private string? linkTargetId;
    private string linkTargetName = "";
    private string linkRelType = "";
    private string linkSentiment = "neutral";
    private string linkDescription = "";
    private string? linkSuccess;

    // Nodes/edges currently rendered in the D3 canvas
    private HashSet<string> canvasNodeIds = new();

    private DotNetObjectReference<WorldGraph>? selfRef;

    protected override void OnInitialized()
    {
        Graph.EnsureLoaded();
        allNodes = Graph.AllNodes();
        allEdges = allNodes.SelectMany(n => Graph.GetAllEdges(n.Id))
            .DistinctBy(e => (e.Source, e.Target, e.RelationType)).ToList();
        ApplyFilters();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
        }
    }

    private void ApplyFilters()
    {
        filteredNodes = allNodes
            .Where(n => string.IsNullOrEmpty(filterType) || n.NodeType == filterType)
            .Where(n => string.IsNullOrEmpty(searchFilter) ||
                        n.Name.Contains(searchFilter, StringComparison.OrdinalIgnoreCase) ||
                        n.Id.Contains(searchFilter, StringComparison.OrdinalIgnoreCase))
            .OrderBy(n => n.Name)
            .ToList();
    }

    // ── D3 Interactions ─────────────────────────────────

    /// <summary>Load all nodes into the D3 canvas at once.</summary>
    private async Task LoadAll()
    {
        canvasNodeIds = new HashSet<string>(allNodes.Select(n => n.Id));
        await RenderD3(allNodes, allEdges);
    }

    /// <summary>Clear the canvas.</summary>
    private async Task ClearCanvas()
    {
        canvasNodeIds.Clear();
        selectedNode = null;
        try { await JS.InvokeVoidAsync("graphInterop.destroy"); } catch { }
        // Also manually clear the DOM container in case destroy didn't reach it
        try { await JS.InvokeVoidAsync("eval", "document.getElementById('graphCanvas').innerHTML = ''"); } catch { }
        StateHasChanged();
    }

    private async Task PopOut() =>
        await JS.InvokeVoidAsync("open", "/graph", "_blank", "width=1200,height=800,menubar=no,toolbar=no");

    /// <summary>Unpin all nodes — let the simulation rearrange everything.</summary>
    private async Task UnpinAll()
    {
        await JS.InvokeVoidAsync("graphInterop.unpinAll");
    }

    /// <summary>Explore a node: add it + 2-hop neighbors to the canvas.</summary>
    private async Task ExploreNode(WorldNode node)
    {
        selectedNode = node;
        nodeEdges = allEdges.Where(e => e.Source == node.Id || e.Target == node.Id).OrderBy(e => e.RelationType).ToList();
        linkTargetId = null;
        linkSuccess = null;
        RefreshNearbyNodes();

        // Get 2-hop neighborhood
        var neighbors = Graph.GetNeighbors(node.Id, 2);
        var nodeIds = new HashSet<string>(neighbors.Select(n => n.Id)) { node.Id };

        if (canvasNodeIds.Count == 0)
        {
            // Fresh canvas — init with this neighborhood
            canvasNodeIds = nodeIds;
            var nodes = nodeIds.Select(id => Graph.GetNode(id)).Where(n => n != null).ToList();
            var edges = allEdges.Where(e => nodeIds.Contains(e.Source) && nodeIds.Contains(e.Target)).ToList();
            await RenderD3(nodes!, edges);
        }
        else
        {
            // Growing canvas — add new nodes/edges
            var newIds = nodeIds.Except(canvasNodeIds).ToHashSet();
            if (newIds.Count > 0)
            {
                canvasNodeIds.UnionWith(newIds);
                var newNodes = newIds.Select(id => Graph.GetNode(id)).Where(n => n != null).ToList();
                var newEdges = allEdges.Where(e =>
                    canvasNodeIds.Contains(e.Source) && canvasNodeIds.Contains(e.Target) &&
                    (newIds.Contains(e.Source) || newIds.Contains(e.Target))).ToList();
                await GrowD3(newNodes!, newEdges);
            }

            await JS.InvokeVoidAsync("graphInterop.highlight", node.Id);
        }
    }

    private async Task ExploreById(string nodeId)
    {
        var node = Graph.GetNode(nodeId);
        if (node != null) await ExploreNode(node);
    }

    private async Task RenderD3(List<WorldNode> nodes, List<WorldEdge> edges)
    {
        if (selfRef == null) return;

        // Build a set of node IDs actually being rendered — edges must only reference these
        var renderedIds = new HashSet<string>(nodes.Select(n => n.Id));

        var jsNodes = nodes.Select(n => new
        {
            id = n.Id,
            name = n.Name,
            nodeType = n.NodeType,
            edgeCount = allEdges.Count(e => e.Source == n.Id || e.Target == n.Id)
        }).ToArray();

        var jsEdges = edges
            .Where(e => renderedIds.Contains(e.Source) && renderedIds.Contains(e.Target))
            .Select(e => new
            {
                source = e.Source,
                target = e.Target,
                relationType = e.RelationType,
                weight = e.Weight,
                sentiment = e.Sentiment,
            }).ToArray();

        await JS.InvokeVoidAsync("graphInterop.init", "graphCanvas", selfRef, jsNodes, jsEdges);
    }

    private async Task GrowD3(List<WorldNode> newNodes, List<WorldEdge> newEdges)
    {
        var jsNodes = newNodes.Select(n => new
        {
            id = n.Id,
            name = n.Name,
            nodeType = n.NodeType,
            edgeCount = allEdges.Count(e => e.Source == n.Id || e.Target == n.Id)
        }).ToArray();

        // Filter edges to only reference nodes that exist on the canvas
        var jsEdges = newEdges
            .Where(e => canvasNodeIds.Contains(e.Source) && canvasNodeIds.Contains(e.Target))
            .Select(e => new
        {
            source = e.Source,
            target = e.Target,
            relationType = e.RelationType,
            weight = e.Weight,
            sentiment = e.Sentiment,
        }).ToArray();

        await JS.InvokeVoidAsync("graphInterop.addData", jsNodes, jsEdges);
    }

    [JSInvokable]
    public void OnNodeClicked(string nodeId)
    {
        var node = Graph.GetNode(nodeId);
        if (node != null)
        {
            selectedNode = node;
            nodeEdges = allEdges.Where(e => e.Source == node.Id || e.Target == node.Id).OrderBy(e => e.RelationType).ToList();
            linkTargetId = null;
            linkSuccess = null;
            RefreshNearbyNodes();
        }
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnNodeExpand(string nodeId)
    {
        var node = Graph.GetNode(nodeId);
        if (node != null) await ExploreNode(node);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnBackgroundClicked()
    {
        selectedNode = null;
        nodeEdges = [];
        StateHasChanged();
    }

    // ── Other Actions ───────────────────────────────────

    private async Task RebuildGraph()
    {
        Graph.Rebuild();
        allNodes = Graph.AllNodes();
        allEdges = allNodes.SelectMany(n => Graph.GetAllEdges(n.Id))
            .DistinctBy(e => (e.Source, e.Target, e.RelationType)).ToList();
        selectedNode = null;
        sceneContext = "";
        canvasNodeIds.Clear();
        ApplyFilters();
        await JS.InvokeVoidAsync("graphInterop.destroy");
    }

    private void LookupSceneContext()
    {
        if (string.IsNullOrWhiteSpace(sceneQuery)) return;
        var names = sceneQuery.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        sceneContext = Graph.GetSceneContext(names);
        if (string.IsNullOrWhiteSpace(sceneContext))
            sceneContext = "(No entities found matching those names)";
    }

    // ── Nearby / Linking ────────────────────────────────

    private void SetHopDepth(int depth)
    {
        hopDepth = depth;
        RefreshNearbyNodes();
    }

    private void RefreshNearbyNodes()
    {
        if (selectedNode == null) { _nearbyNodes = []; return; }

        // BFS with hop tracking
        var visited = new Dictionary<string, int> { [selectedNode.Id] = 0 };
        var frontier = new Queue<(string id, int depth)>();
        frontier.Enqueue((selectedNode.Id, 0));

        while (frontier.Count > 0)
        {
            var (current, d) = frontier.Dequeue();
            if (d >= hopDepth) continue;

            foreach (var edge in Graph.GetAllEdges(current))
            {
                var neighbor = edge.Source == current ? edge.Target : edge.Source;
                if (!visited.ContainsKey(neighbor))
                {
                    visited[neighbor] = d + 1;
                    frontier.Enqueue((neighbor, d + 1));
                }
            }
        }

        visited.Remove(selectedNode.Id);

        _nearbyNodes = visited
            .Select(kv =>
            {
                var n = Graph.GetNode(kv.Key);
                return n != null ? (id: n.Id, name: n.Name, nodeType: n.NodeType, hops: kv.Value) : default;
            })
            .Where(x => x.id != null)
            .OrderBy(x => x.hops)
            .ThenBy(x => x.nodeType)
            .ThenBy(x => x.name)
            .ToList()!;
    }

    private void StartLink(string targetId, string targetName)
    {
        linkTargetId = targetId;
        linkTargetName = targetName;
        linkRelType = "";
        linkSentiment = "neutral";
        linkDescription = "";
        linkSuccess = null;
    }

    private async Task CreateLink()
    {
        if (selectedNode == null || linkTargetId == null || string.IsNullOrWhiteSpace(linkRelType)) return;

        Graph.EvolveRelationship(
            selectedNode.Id, linkTargetId, "manual",
            linkRelType, linkDescription, 1.0, linkSentiment);
        Graph.Save();

        // Refresh
        allEdges = Graph.AllNodes().SelectMany(n => Graph.GetAllEdges(n.Id))
            .DistinctBy(e => (e.Source, e.Target, e.RelationType)).ToList();
        nodeEdges = allEdges.Where(e => e.Source == selectedNode.Id || e.Target == selectedNode.Id)
            .OrderBy(e => e.RelationType).ToList();

        linkSuccess = $"Linked {selectedNode.Name} —[{linkRelType}]→ {linkTargetName}";
        linkTargetId = null;
        RefreshNearbyNodes();

        // Re-render D3 with new edge
        if (canvasNodeIds.Count > 0)
        {
            var nodes = canvasNodeIds.Select(id => Graph.GetNode(id)).Where(n => n != null)
                .Select(n => new { id = n!.Id, name = n.Name, nodeType = n.NodeType, edgeCount = Graph.GetAllEdges(n.Id).Count }).ToArray();
            var edges = allEdges.Where(e => canvasNodeIds.Contains(e.Source) && canvasNodeIds.Contains(e.Target))
                .Select(e => new { source = e.Source, target = e.Target, relationType = e.RelationType, weight = e.Weight, sentiment = e.Sentiment }).ToArray();
            await JS.InvokeVoidAsync("graphInterop.init", "graphCanvas", selfRef, nodes, edges);
        }
    }

    private static string GetTypeColorHex(string type) => type switch
    {
        "character" => "#17a2b8", "organization" => "#ffc107", "place" => "#28a745",
        "faction" => "#6f42c1", "weapon" => "#dc3545", "equipment" => "#0d6efd",
        "technology" => "#0dcaf0", _ => "#6c757d",
    };

    private int GetEdgeCount(string nodeId) =>
        allEdges.Count(e => e.Source == nodeId || e.Target == nodeId);

    private static string GetTypeBadgeClass(string type) => type switch
    {
        "character" => "bg-info",
        "organization" => "bg-warning text-dark",
        "place" => "bg-success",
        "faction" => "bg-purple",
        "weapon" => "bg-danger",
        "equipment" => "bg-primary",
        "technology" => "bg-cyan",
        _ => "bg-secondary",
    };

    private static string GetRelBadgeClass(string relType) => relType?.ToLowerInvariant() switch
    {
        "alliance" or "allied" => "bg-success",
        "rivalry" or "rival" or "enemy" => "bg-danger",
        "kinship" or "family" => "bg-info",
        "mentor" or "mentorship" => "bg-warning text-dark",
        "operates_in" or "located_in" or "frequents" or "adjacent_to" or "controls_territory" => "bg-secondary",
        "employs" or "member_of" or "employed_by" or "affiliated_with" => "bg-primary",
        "manufactured_by" or "developed_by" => "bg-warning text-dark",
        "wields" or "uses" => "bg-info",
        "built_on" or "depends_on" or "enables" => "bg-cyan",
        _ => "bg-dark border border-secondary",
    };

    private static string Truncate(string text, int max) =>
        text.Length > max ? text[..max] + "..." : text;

    public void Dispose()
    {
        _ = JS.InvokeVoidAsync("graphInterop.destroy");
        selfRef?.Dispose();
    }
}
