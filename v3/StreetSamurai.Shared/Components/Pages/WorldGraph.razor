@page "/graph"
@inject WorldGraphService Graph
@inject CanonService Canon

<h4 class="text-danger mb-1">World Graph</h4>
<p class="text-muted mb-3">Relationship network of every entity in the canon — characters, corponations, districts, and factions. Click a node to explore its connections.</p>

<div class="row g-3">
    @* ── Controls ─────────────────────────────────────── *@
    <div class="col-md-3">
        <div class="card bg-dark text-light border-secondary mb-3">
            <div class="card-header text-muted">Filters</div>
            <div class="card-body">
                <div class="mb-2">
                    <label class="form-label text-muted small">Node Type</label>
                    <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="_filterType">
                        <option value="">All</option>
                        <option value="character">Characters</option>
                        <option value="corporation">Corporations</option>
                        <option value="district">Districts</option>
                        <option value="faction">Factions</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label text-muted small">Search</label>
                    <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                           placeholder="Filter nodes..."
                           @bind="_searchFilter" @bind:event="oninput" />
                </div>
                <div class="text-muted small mt-2">
                    @_filteredNodes.Count nodes / @_filteredEdges.Count edges
                </div>
            </div>
        </div>

        @* ── Node List ────────────────────────────────── *@
        <div class="card bg-dark text-light border-secondary" style="max-height: 60vh; overflow-y: auto;">
            <div class="card-header text-muted">Nodes</div>
            <div class="list-group list-group-flush">
                @foreach (var node in _filteredNodes.Take(100))
                {
                    <button class="list-group-item list-group-item-action bg-dark text-light border-secondary d-flex justify-content-between align-items-center @(_selectedNode?.Id == node.Id ? "active" : "")"
                            @onclick="() => SelectNode(node)">
                        <span>
                            <span class="badge @GetTypeBadgeClass(node.NodeType) me-1">@node.NodeType[..1].ToUpper()</span>
                            @node.Name
                        </span>
                        <span class="badge bg-secondary rounded-pill">@GetEdgeCount(node.Id)</span>
                    </button>
                }
            </div>
        </div>
    </div>

    @* ── Graph Canvas / Detail ────────────────────────── *@
    <div class="col-md-9">
        @if (_selectedNode != null)
        {
            <div class="card bg-dark text-light border-secondary mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>
                        <span class="badge @GetTypeBadgeClass(_selectedNode.NodeType) me-2">@_selectedNode.NodeType</span>
                        <strong>@_selectedNode.Name</strong>
                    </span>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _selectedNode = null" title="Close detail view">
                        <i class="bi bi-x"></i> Close
                    </button>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(_nodeContext))
                    {
                        <div class="mb-3" style="white-space: pre-wrap; font-size: 0.9rem;">@_nodeContext</div>
                    }
                </div>
            </div>

            @* ── Relationship Web ────────────────────────── *@
            <div class="card bg-dark text-light border-secondary">
                <div class="card-header text-muted">Connections (@_nodeEdges.Count)</div>
                <div class="card-body">
                    @if (_nodeEdges.Any())
                    {
                        <div class="row g-2">
                            @foreach (var edge in _nodeEdges)
                            {
                                var other = edge.Source == _selectedNode.Id ? edge.Target : edge.Source;
                                var otherNode = Graph.GetNode(other);
                                <div class="col-md-6">
                                    <div class="border border-secondary rounded p-2 d-flex align-items-center gap-2 cursor-pointer"
                                         style="cursor: pointer;"
                                         @onclick="() => NavigateToNode(other)">
                                        <span class="badge @GetRelBadgeClass(edge.RelationType)">@edge.RelationType</span>
                                        <span>@(otherNode?.Name ?? other)</span>
                                        @if (!string.IsNullOrEmpty(edge.Description))
                                        {
                                            <small class="text-muted ms-auto">@Truncate(edge.Description, 40)</small>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <small class="text-muted">No connections found.</small>
                    }
                </div>
            </div>
        }
        else
        {
            @* ── Overview visualization ──────────────────── *@
            <div class="card bg-dark text-light border-secondary">
                <div class="card-header text-muted">Graph Overview</div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        @foreach (var group in _filteredNodes.GroupBy(n => n.NodeType).OrderByDescending(g => g.Count()))
                        {
                            <div class="col-md-3">
                                <div class="border border-secondary rounded p-3 text-center">
                                    <span class="badge @GetTypeBadgeClass(group.Key) mb-2" style="display:inline-block;">@group.Key</span>
                                    <h4>@group.Count()</h4>
                                </div>
                            </div>
                        }
                    </div>

                    @* ── Top connected nodes ──────────────────── *@
                    <h6 class="text-muted mt-3">Most Connected</h6>
                    <div class="row g-2">
                        @foreach (var node in _allNodes.OrderByDescending(n => GetEdgeCount(n.Id)).Take(12))
                        {
                            <div class="col-md-4">
                                <div class="border border-secondary rounded p-2 d-flex align-items-center gap-2"
                                     style="cursor: pointer;" @onclick="() => SelectNode(node)">
                                    <span class="badge @GetTypeBadgeClass(node.NodeType)">@node.NodeType[..1].ToUpper()</span>
                                    <span class="small">@node.Name</span>
                                    <span class="badge bg-danger rounded-pill ms-auto">@GetEdgeCount(node.Id)</span>
                                </div>
                            </div>
                        }
                    </div>

                    @* ── Relationship type distribution ──────── *@
                    <h6 class="text-muted mt-4">Relationship Types</h6>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var group in _allEdges.GroupBy(e => e.RelationType).OrderByDescending(g => g.Count()))
                        {
                            <span class="badge @GetRelBadgeClass(group.Key) fs-6">
                                @group.Key <span class="badge bg-dark">@group.Count()</span>
                            </span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<WorldNode> _allNodes = [];
    private List<WorldEdge> _allEdges = [];
    private List<WorldNode> _filteredNodes = [];
    private List<WorldEdge> _filteredEdges = [];
    private WorldNode? _selectedNode;
    private List<WorldEdge> _nodeEdges = [];
    private string _nodeContext = "";
    private string _filterType = "";
    private string _searchFilter = "";

    protected override void OnInitialized()
    {
        Graph.EnsureLoaded();
        _allNodes = Graph.AllNodes();
        _allEdges = _allNodes.SelectMany(n => Graph.GetAllEdges(n.Id)).DistinctBy(e => (e.Source, e.Target, e.RelationType)).ToList();
        ApplyFilters();
    }

    protected override void OnParametersSet() => ApplyFilters();

    private void ApplyFilters()
    {
        _filteredNodes = _allNodes
            .Where(n => string.IsNullOrEmpty(_filterType) || n.NodeType == _filterType)
            .Where(n => string.IsNullOrEmpty(_searchFilter) ||
                        n.Name.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase) ||
                        n.Id.Contains(_searchFilter, StringComparison.OrdinalIgnoreCase))
            .OrderBy(n => n.Name)
            .ToList();

        _filteredEdges = _allEdges
            .Where(e => _filteredNodes.Any(n => n.Id == e.Source || n.Id == e.Target))
            .ToList();
    }

    private void SelectNode(WorldNode node)
    {
        _selectedNode = node;
        _nodeEdges = _allEdges
            .Where(e => e.Source == node.Id || e.Target == node.Id)
            .OrderBy(e => e.RelationType)
            .ToList();
        _nodeContext = Graph.GetContextForNode(node.Id);
    }

    private void NavigateToNode(string nodeId)
    {
        var node = Graph.GetNode(nodeId);
        if (node != null) SelectNode(node);
    }

    private int GetEdgeCount(string nodeId) =>
        _allEdges.Count(e => e.Source == nodeId || e.Target == nodeId);

    private static string GetTypeBadgeClass(string type) => type switch
    {
        "character" => "bg-info",
        "corporation" => "bg-warning text-dark",
        "district" => "bg-success",
        "faction" => "bg-purple",
        _ => "bg-secondary",
    };

    private static string GetRelBadgeClass(string relType) => relType?.ToLowerInvariant() switch
    {
        "alliance" or "allied" => "bg-success",
        "rivalry" or "rival" or "enemy" => "bg-danger",
        "kinship" or "family" => "bg-info",
        "mentor" or "mentorship" => "bg-warning text-dark",
        "operates_in" or "located_in" or "territory" => "bg-secondary",
        "employs" or "member" or "employed_by" => "bg-primary",
        _ => "bg-dark border border-secondary",
    };

    private static string Truncate(string text, int max) =>
        text.Length > max ? text[..max] + "..." : text;
}
