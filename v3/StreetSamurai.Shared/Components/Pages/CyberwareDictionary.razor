@page "/cyberware"
@using StreetSamurai.Core.Models.Canon
@inject CyberwareRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject WorldGraphService Graph

<div class="dict-layout">
    <div class="dict-list bg-dark border-end border-secondary">
        <div class="p-2">
            <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                   placeholder="Filter..." @bind="_filter" @bind:event="oninput" />
        </div>
        @foreach (var c in FilteredItems)
        {
            <div class="list-item text-light @(_editing?.Name == c.Name ? "active" : "")" @onclick="() => Edit(c)">
                <div class="fw-bold small">@c.Name</div>
                <div class="text-muted" style="font-size: 0.7rem;">@c.BodyLocation — @c.Category</div>
            </div>
        }
        <div class="p-2">
            <button class="btn btn-sm btn-outline-danger w-100" @onclick="AddNew"><i class="bi bi-plus-lg"></i> New Cyberware</button>
        </div>
    </div>

    <div class="dict-editor" style="overflow-y: auto; max-height: calc(100vh - 60px);">
        @if (_editing != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-danger mb-0">@(_isNew ? "New Cyberware" : _editing.Name)</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i> Save</button>
                    @if (!_isNew && !_confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-trash3"></i></button> }
                    @if (_confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete">Confirm</button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false">No</button> }
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 2; min-width: 200px;"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Name" /></div>
                <div style="flex: 1; min-width: 120px;"><div class="field-label">Category</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Category" /></div>
                <div style="flex: 1; min-width: 120px;"><div class="field-label">Body Location</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.BodyLocation" /></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 150px;"><div class="field-label">Manufacturer</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Manufacturer" /></div>
                <div style="flex: 1; min-width: 100px;"><div class="field-label">Tier</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.TierAvailability" /></div>
                <div style="flex: 1; min-width: 100px;"><div class="field-label">Legality</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Legality" /></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 100px;"><div class="field-label">Street Price</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.StreetPrice" /></div>
                <div style="flex: 1; min-width: 100px;"><div class="field-label">Licensed Price</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.LicensedPrice" /></div>
            </div>
            <div class="mb-3"><div class="field-label">Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.Description"></textarea></div>
            <div class="mb-3"><div class="field-label">Specifications</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.Specifications"></textarea></div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Installation Requirements</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.InstallationRequirements"></textarea></div>
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Rejection Risk</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.RejectionRisk"></textarea></div>
            </div>
            <div class="mb-3"><div class="field-label">Maintenance</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.Maintenance"></textarea></div>
            <div class="mb-3"><div class="field-label">Cultural Context</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.CulturalContext"></textarea></div>
        }
        else { <div class="text-muted d-flex align-items-center justify-content-center h-100">Select cyberware or create new</div> }
    </div>
</div>

@code {
    private List<CyberwareData> _items = [];
    private CyberwareData? _editing;
    private bool _isNew, _confirmDelete;
    private string _originalName = "";
    private string _filter = "";

    private IEnumerable<CyberwareData> FilteredItems => string.IsNullOrWhiteSpace(_filter)
        ? _items
        : _items.Where(c => c.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || c.Category.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || c.BodyLocation.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized() { Repo.Reload(); _items = Repo.GetAll(); if (Nav.Uri.Contains("new=true")) AddNew(); }
    private void AddNew() { _editing = new CyberwareData(); _isNew = true; _confirmDelete = false; }
    private void Edit(CyberwareData c) { _editing = c; _originalName = c.Name; _isNew = false; _confirmDelete = false; }
    private void SaveEdit() { if (_editing == null || string.IsNullOrWhiteSpace(_editing.Name)) return; if (!_isNew && _originalName != _editing.Name) Repo.Delete(_originalName); Repo.Save(_editing); _editing = null; _items = Repo.GetAll(); }
    private void DoDelete() { if (_editing == null) return; Graph.RemoveNode(_editing.Name); Repo.Delete(_editing.Name); _editing = null; _confirmDelete = false; _items = Repo.GetAll(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { await JS.InvokeVoidAsync("writeInterop.autoResizeAll"); }
}
