@* ── LLM bottom sheet ───────────────────────────────────────────────────
   Pops up from the bottom of the page when the user clicks the ✨ button
   on any beat. Free-text instruction; previews the LLM's proposed rewrite;
   user picks Apply (replaces beat.Text via Workbench.UpdateBeatTextAsync)
   or Discard. *@
@if (llmSheetBeat != null)
{
    <div class="llm-sheet-backdrop" @onclick="CloseLlmSheet"></div>
    <div class="llm-sheet" @onclick:stopPropagation>
        <div class="llm-sheet-header d-flex justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2 flex-grow-1" style="min-width:0;">
                <i class="bi bi-stars text-primary"></i>
                <strong class="flex-shrink-0">Beat #@llmSheetBeatPosition</strong>
                <code class="llm-sheet-ref text-truncate" title="strand-guid.beat-guid — click the id button to copy">@llmSheetRefText</code>
                <button class="beat-copy-btn @(llmSheetIdCopied ? "copied" : "")"
                        title="Copy strand-guid.beat-guid for CLI (--% --beat @llmSheetRefText)"
                        @onclick="CopyLlmSheetRefAsync">
                    <i class="bi bi-hash"></i>
                    @(llmSheetIdCopied ? " copied" : " id")
                </button>
            </div>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CloseLlmSheet">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="llm-sheet-body">
            <div class="text-muted small mb-1">Current beat text:</div>
            <div class="llm-sheet-beat-text">@llmSheetBeat.Text</div>

            <div class="text-muted small mt-3 mb-1">What should the LLM do with this beat?</div>
            <textarea class="form-control bg-black text-light border-secondary"
                      rows="3"
                      placeholder="e.g. tighten this — drop the second sentence, keep the menace"
                      @bind="llmSheetInstruction"
                      @bind:event="oninput"></textarea>

            <div class="d-flex gap-2 mt-2 align-items-center">
                <button class="btn btn-sm btn-primary" @onclick="RunLlmSheetAsync"
                        disabled="@(llmSheetRunning || string.IsNullOrWhiteSpace(llmSheetInstruction))">
                    @if (llmSheetRunning) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    else { <i class="bi bi-stars me-1"></i> }
                    Run
                </button>
                <span class="text-muted small">⌘/Ctrl+Enter to run · Esc to close</span>
            </div>

            @if (!string.IsNullOrEmpty(llmSheetProposal))
            {
                <div class="text-muted small mt-3 mb-1">Proposed rewrite:</div>
                <div class="llm-sheet-proposal">@llmSheetProposal</div>
                <div class="d-flex gap-2 mt-2 align-items-center">
                    <button class="btn btn-sm btn-success" @onclick="ApplyLlmSheetAsync" disabled="@llmSheetRunning">
                        <i class="bi bi-check-lg me-1"></i>Apply
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="DiscardLlmSheetProposal" disabled="@llmSheetRunning">
                        <i class="bi bi-x-lg me-1"></i>Discard
                    </button>
                </div>
            }
        </div>
    </div>
}

