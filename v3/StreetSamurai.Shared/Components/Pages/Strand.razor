    private async Task OnEditorKeydown(KeyboardEventArgs e, BeatEntity b)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)) await SaveBeatEditAsync(b.Id);
        else if (e.Key == "Escape") RevertDraft(b);
    }

    private async Task SaveBeatEditAsync(Guid beatId)
    {
        if (strand == null || savingBeatId != null) return;
        if (!drafts.TryGetValue(beatId, out var text)) return; // nothing seeded
        draftBase.TryGetValue(beatId, out var baseToken);
        savingBeatId = beatId;
        StateHasChanged();
        try
        {
            await Workbench.UpdateBeatTextAsync(beatId, text, baseToken);
            // The UPDATE is system-versioned, so the prior text is now in
            // Beats_History automatically — nothing to snapshot client-side.
            // Drop this beat's draft so the reload reseeds it from the
            // freshly-saved text + new concurrency token (clean state).
            drafts.Remove(beatId);
            draftBase.Remove(beatId);
            await ReloadBeatsAsync();
            Toast.Success("BEAT-EDIT", "Beat updated; audio invalidated.");
        }
        catch (BeatConflictException conflict)
        {
            // Another tab/MCP-tool wrote in between. Reload so the user sees
            // the current canonical text on the OTHER rows, but keep THIS
            // beat's draft (their unsaved text) and advance its base token to
            // the conflicting version so a re-save applies over it. No silent
            // clobber. SyncDraftsAfterReload preserves a dirty draft, so we
            // just re-point the token here.
            await ReloadBeatsAsync();
            draftBase[beatId] = conflict.CurrentUpdatedAt;
            Toast.Error("BEAT-CONFLICT", "Beat was modified elsewhere. Your edit is kept in the box — re-save to apply it over the latest version.");
        }
        catch (Exception ex) { Toast.Error("BEAT-EDIT-FAIL", ex.Message); }
        finally { savingBeatId = null; await InvokeAsync(StateHasChanged); }
    }

    /// <summary>Refresh the per-beat version counts from the temporal history
    /// so the cycler arrows render the right disabled state, and reset every
    /// cursor to the current version (0). One grouped DB query per (re)load.
    /// Non-fatal — on failure the arrows simply stay disabled.</summary>
    private async Task RefreshHistoryCountsAsync()
    {
        if (strand == null) return;
        try
        {
            var counts = await Workbench.GetBeatVersionCountsAsync(strand.Id);
            historyCounts.Clear();
            historyCursor.Clear();
            foreach (var kv in counts) historyCounts[kv.Key] = kv.Value;
        }
        catch (Exception ex) { Console.Error.WriteLine($"[strand-history] count refresh failed: {ex.Message}"); }
    }

    /// <summary>Step the version cycler for one beat. delta +1 = older, -1 =
    /// newer; cursor 0 is the current/most-recent edit. Pulls the selected
    /// version's prose from the temporal history and loads it into the beat's
    /// draft so the editor previews it — the user then Saves to keep it (which
    /// becomes a new current version) or Reverts to drop back to the live text.
    /// No-op when the move would run past either end.</summary>
    private async Task StepHistoryAsync(Guid beatId, int delta)
    {
        if (!historyCounts.TryGetValue(beatId, out var count) || count == 0) return;
        var cursor = historyCursor.TryGetValue(beatId, out var c) ? c : 0;
        var next = Math.Clamp(cursor + delta, 0, count - 1);
        if (next == cursor) return;
        string? text;
        try { text = await Workbench.GetBeatVersionTextAsync(beatId, next); }
        catch (Exception ex) { Toast.Error("BEAT-HISTORY", ex.Message); return; }
        if (text is null) return; // version vanished (e.g. history trimmed) — leave the editor as-is
        historyCursor[beatId] = next;
        drafts[beatId] = text;
        autoSizePendingBeatId = beatId; // resize + focus the textarea to the loaded version
        await InvokeAsync(StateHasChanged);
    }

    private async Task InsertBeatAsync(Guid? afterBeatId)
