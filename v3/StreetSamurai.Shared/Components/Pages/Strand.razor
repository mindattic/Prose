    private void RequestDeleteAsync(Guid beatId)
    {
        pendingDelete = beatId;
        _ = WireEscapeOnceAsync();
    }
    private void CancelDelete() => pendingDelete = null;

    /// <summary>One-shot Escape-key hook for the open modal. Registers a
    /// keydown listener on document while pendingDelete is set, and
    /// invokes CancelDelete via JS interop when Escape fires. Cheap
    /// alternative to a full Blazor focus-trap component.</summary>
    private async Task WireEscapeOnceAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                (function(){
                  if (window.__ssStrandEscBound) return;
                  window.__ssStrandEscBound = true;
                  document.addEventListener('keydown', function(e){
                    if (e.key === 'Escape') {
                      var btn = document.querySelector('.modal.d-block .modal-footer .btn-outline-secondary');
                      if (btn) btn.click();
                    }
                  });
                })();");
        }
        catch { /* JS interop is best-effort — clicking Cancel still works */ }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (strand == null || pendingDelete == null) return;
        var bid = pendingDelete.Value;
        pendingDelete = null;
        working = true;
        StateHasChanged();
        try
        {
            await Workbench.DeleteBeatAsync(strand.Id, bid);
            await ReloadBeatsAsync();
            Toast.Success("DELETE", "Beat removed.");
        }
        catch (Exception ex) { Toast.Error("DELETE-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task NarrateAsync()
    {
        if (strand == null || working) return;
        working = true;
        StateHasChanged();
        try
        {
            _ = Task.Run(() => Workbench.NarrateAsync(strand!.Id));
            await Task.Delay(250);
            await ReloadBeatsAsync();
            StartPolling();
            Toast.Success("REC", "Narration started.");
        }
        catch (Exception ex) { Toast.Error("REC-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task ReRecordAllAsync()
    {
        if (strand == null || working) return;
        working = true;
        StateHasChanged();
        try
        {
            foreach (var entry in beats)
                await Workbench.InvalidateBeatAudioAsync(entry.Beat.Id);
            _ = Task.Run(() => Workbench.NarrateAsync(strand!.Id));
            await ReloadBeatsAsync();
            StartPolling();
            Toast.Success("RE-REC-ALL", "Re-recording from scratch.");
        }
        catch (Exception ex) { Toast.Error("RE-REC-ALL-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task RerecordOneAsync(Guid beatId)
    {
        if (strand == null || working) return;
        working = true;
        StateHasChanged();
        try
        {
            await Workbench.InvalidateBeatAudioAsync(beatId);
            _ = Task.Run(() => Workbench.NarrateAsync(strand!.Id));
            await ReloadBeatsAsync();
            StartPolling();
            Toast.Success("BEAT-RE-REC", "Re-recording this beat…");
        }
        catch (Exception ex) { Toast.Error("BEAT-RE-REC-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task ExportCombinedAsync()
    {
        if (strand == null || working) return;
        working = true;
        StateHasChanged();
        try
        {
            var path = await Workbench.ExportCombinedAsync(strand.Id);
            await ReloadBeatsAsync();
            if (path == null) Toast.Info("COMBINE", "Nothing to combine yet — record some beats first.");
            else Toast.Success("COMBINE", "Combined audio written.");
        }
        catch (Exception ex) { Toast.Error("COMBINE-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task StopAsync()
    {
        if (strand == null) return;
        if (Workbench.CancelNarration(strand.Id))
        {
            Toast.Info("STOP", "Narration cancelled.");
            await ReloadBeatsAsync();
        }
    }

    private async Task ReloadBeatsAsync()
    {
        if (strand == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var fresh = await db.Strands.AsNoTracking().FirstOrDefaultAsync(s => s.Id == strand.Id);
        if (fresh != null)
        {
            strand.Status = fresh.Status;
            strand.CombinedAudioPath = fresh.CombinedAudioPath;
            strand.CharsNarrated = fresh.CharsNarrated;
        }
        beats = await Workbench.GetOrderedBeatsAsync(strand.Id);
    }

    private static string StatusColor(string status) => StrandWorkbenchService.StatusColor(status);
    private static string StatusLabel(string status) => StrandWorkbenchService.StatusLabel(status);

    private static string FormatDuration(double sec)
    {
        var ts = TimeSpan.FromSeconds(sec);
        return ts.TotalMinutes >= 1 ? $"{(int)ts.TotalMinutes}:{ts.Seconds:D2}" : $"{ts.TotalSeconds:0.0}s";
    }

    public void Dispose() => poll?.Dispose();
}
