@page "/strand/{IdOrSlug}"
@attribute [Authorize(Roles = "Contributor,Administrator")]
@using Microsoft.EntityFrameworkCore
@using StreetSamurai.Core.Data
@using StreetSamurai.Core.Data.Entities
@using StreetSamurai.Core.Services
@using StreetSamurai.Shared.Services
@using StrandEntity = StreetSamurai.Core.Data.Entities.Strand
@using BeatEntity = StreetSamurai.Core.Data.Entities.Beat
@inject IDbContextFactory<StreetSamuraiDbContext> DbFactory
@inject StrandWorkbenchService Workbench
@inject ElevenLabsTtsService Tts
@inject SettingsService Settings
@inject NavigationManager Nav
@inject ToastNotifier Toast
@inject IJSRuntime JS
@inject StreetSamurai.Core.Interfaces.ILlmService Llm
@inject ILogger<Strand> Log
@implements IDisposable

@*
   The unified writer + recorder + listener. One page does everything:
   write, edit, record, add beats (before/after), split, join, re-record,
   delete. /write, /listen, /recordings all funnel here.
*@

<style>
    .strand-shell { max-width: 1040px; }
    .strand-head { position: sticky; top: 0; z-index: 5; background: rgba(15,15,15,0.95); backdrop-filter: blur(6px); border-bottom: 1px solid #2a2a2a; padding: 0.75rem 0; margin-bottom: 1rem; }
    .strand-title { background: transparent; border: none; color: #f8f9fa; font-size: 1.5rem; font-weight: 600; padding: 0; outline: none; }
    .strand-title:focus { box-shadow: none; border-bottom: 2px solid #0dcaf0; }
    .strand-synopsis { background: transparent; border: none; color: #adb5bd; font-size: 0.9rem; resize: none; padding: 0; outline: none; width: 100%; }
    .strand-synopsis:focus { color: #ced4da; }
    .beat-card { background: #161616; border: 1px solid #2a2a2a; border-radius: 8px; padding: 0.65rem 0.9rem; transition: border-color 0.15s ease, box-shadow 0.15s ease; position: relative; }

    /* 3-row layout: header bar (controls), body (prose ↔ textarea), footer
       (gap-after + meta chips). Rows separated by margin only — no borders
       between rows so the card reads as one block. */
    .beat-row-1 { /* spacing handled by .mb-2 on the element */ }
    .beat-row-2 { min-height: 1.55rem; }
    .beat-row-3 { margin-top: 0.5rem; padding-top: 0.4rem; border-top: 1px solid #1f1f1f; }
    /* Row 3 bottom bar: meta chips (left) + gap-after editor (right) in one flex line.
       gap-inline shrinks but won't wrap below the chips unless the card is very narrow. */
    .beat-row-3-bar { gap: 0.5rem; }
    .beat-row-3-bar .beat-meta-chips { margin-top: 0; flex: 1 1 auto; min-width: 0; }
    .beat-row-3-bar .beat-gap-inline { flex: 0 0 auto; }

    /* Inline checkbox replaces the absolute-positioned one. Slightly larger
       hit target so it's easy to click on mobile. */
    .beat-select-box-inline { width: 1rem; height: 1rem; accent-color: #ffc107; cursor: pointer; flex-shrink: 0; }

    /* Format toolbar: tight grouped pill of icon buttons. Disabled state
       dims to ~40% so the writer sees them but doesn't try clicking when
       there's no textarea active. */
    .beat-format-toolbar { display: inline-flex; gap: 0.15rem; margin-left: 0.5rem; padding: 0.1rem 0.25rem; background: rgba(255,255,255,0.02); border: 1px solid #2a2a2a; border-radius: 4px; }
    .beat-format-toolbar .btn { padding: 0.1rem 0.4rem; line-height: 1; font-size: 0.85rem; }
    .beat-format-toolbar .btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .beat-char-count { font-variant-numeric: tabular-nums; }

    /* Tone-tag emoji rendered in the read view. The title attribute holds
       the original bracketed form so a hover reveals the source token. */
    .tone-tag { display: inline-block; padding: 0 0.1em; cursor: help; }
    .tone-tag:hover { filter: brightness(1.15); }

    .beat-card:hover { border-color: #0dcaf0; box-shadow: 0 0 0 1px rgba(13,202,240,0.25); }
    .beat-card.editing { border-color: #0dcaf0; box-shadow: 0 0 0 1px rgba(13,202,240,0.35); }
    .beat-card.selected { border-color: #ffc107; box-shadow: 0 0 0 1px rgba(255,193,7,0.35); }
    .beat-card.resume-here { border-color: #20c997; box-shadow: 0 0 0 1px rgba(32,201,151,0.55), 0 0 22px rgba(32,201,151,0.20); }
    .beat-card.beat-dragging { opacity: 0.5; }
    .beat-card.beat-drop-target { outline: 2px dashed #0dcaf0; outline-offset: 2px; }
    /* Cross-strand drop: highlighted in red so the user sees the drop
       attempt was recognised but rejected (a chapter beat can't be dropped
       on a sibling chapter's beat — reorder is single-strand only). */
    .beat-card.beat-drop-blocked { outline: 2px dashed #dc3545; outline-offset: 2px; cursor: not-allowed; }

    /* Drag handle in the row-1 cluster. Only the handle itself initiates
       a drag — clicking elsewhere in the card still works as before. */
    .beat-drag-handle { cursor: grab; color: #6c757d; padding: 0 0.2rem; user-select: none; }
    .beat-drag-handle:hover { color: #0dcaf0; }
    .beat-drag-handle:active { cursor: grabbing; }
    .resume-banner { background: rgba(32,201,151,0.08); border: 1px solid rgba(32,201,151,0.35); border-radius: 6px; padding: 0.4rem 0.65rem; color: #c8f0e0; font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; }
    .resume-banner .btn { padding: 0.1rem 0.5rem; font-size: 0.75rem; }

    /* Upper-right hover action buttons. Dim at rest (40% opacity) so they don't
       compete with the prose; full opacity when hovering the card, focused
       within it, or when the card is selected/editing. All icon-only with
       Bootstrap btn-outline-* coloring; the .copied state turns the copy-text
       button green via the .btn-outline-secondary.copied override below. */
    .beat-actions { opacity: 0.4; transition: opacity 0.15s ease; }
    .beat-card:hover .beat-actions,
    .beat-card:focus-within .beat-actions,
    .beat-card.selected .beat-actions,
    .beat-card.editing .beat-actions { opacity: 1; }
    .beat-actions .btn { padding: 0.15rem 0.45rem; line-height: 1; }
    .btn-outline-secondary.copied { color: #75b798; border-color: #198754; background: rgba(25,135,84,0.15); }
    .beat-id-chip { color: #0dcaf0; font-variant-numeric: tabular-nums; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.02em; }

    /* Chapter divider: rendered above any beat with IsChapterStart=true.
       Reads the heading from BeatTitle. Visually announces "new division
       of the prose" without nesting. */
    .beat-chapter-divider { display: flex; align-items: center; gap: 0.75rem; margin: 1.5rem 0 0.6rem; }
    .beat-chapter-line { flex: 1; height: 1px; background: linear-gradient(to right, transparent, #d9a030, transparent); }
    .beat-chapter-label { color: #d9a030; font-family: 'Outfit', sans-serif; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.12em; white-space: nowrap; }

    /* Beat-kind renderings — visual variants of .beat-prose driven by
       Beat.Kind. All still click to edit. */
    .beat-prose-book-title { text-align: center; padding: 1.5rem 0; }
    .beat-prose-book-title .book-title-line { font-family: 'Outfit', sans-serif; font-size: 1.6rem; font-weight: 700; letter-spacing: 0.04em; color: #f8f9fa; }
    .beat-prose-book-title .book-title-byline { font-size: 0.9rem; color: #adb5bd; margin-top: 0.4rem; font-style: italic; }
    .beat-prose-dedication { text-align: center; font-style: italic; color: #ced4da; padding: 0.6rem 1.5rem; }
    .beat-prose-quote { border-left: 3px solid #d9a030; padding: 0.5rem 1rem; margin: 0; background: rgba(217,160,48,0.04); }
    .beat-prose-quote .quote-text { font-style: italic; color: #e6edf3; }
    .beat-prose-quote .quote-attribution { font-size: 0.78rem; color: #adb5bd; margin-top: 0.4rem; text-align: right; }

    /* Chapter index — jump-links to every IsChapterStart beat at the top
       of the strand. Replaces the old child-strand sidebar. */
    .chapter-index { border: 1px solid #2a2a2a; border-radius: 6px; padding: 0.6rem 0.9rem; margin-bottom: 1rem; background: #0f0f0f; }
    .chapter-index-head { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #8b949e; margin-bottom: 0.4rem; }
    .chapter-index-list { display: flex; flex-direction: column; gap: 0.15rem; }
    .chapter-index-link { color: #79d2e8; text-decoration: none; font-size: 0.9rem; padding: 0.15rem 0; }
    .chapter-index-link:hover { color: #f8f9fa; text-decoration: underline; }
    .chapter-index-link .ci-pos { color: #6c757d; font-variant-numeric: tabular-nums; margin-right: 0.5rem; font-size: 0.8rem; }
    .beat-gap-inline { display: inline-flex; gap: 0.4rem; align-items: center; font-size: 0.72rem; color: #adb5bd; }
    .beat-gap-inline.custom { color: #ffc107; }
    .beat-gap-input { width: 70px; background: #161616; color: #f8f9fa; border: 1px solid #2a2a2a; padding: 0 0.3rem; font-size: 0.72rem; border-radius: 3px; }
    .beat-gap-input:focus { outline: none; border-color: #0dcaf0; }
    .beat-gap-inline.custom .beat-gap-input { border-color: rgba(255,193,7,0.5); }

    .selection-bar { position: sticky; bottom: 1rem; z-index: 6; background: rgba(15,15,15,0.95); backdrop-filter: blur(6px); border: 1px solid #ffc107; border-radius: 8px; padding: 0.6rem 0.9rem; display: flex; align-items: center; gap: 0.75rem; margin-top: 1rem; box-shadow: 0 -4px 18px rgba(0,0,0,0.35); }
    .selection-bar .count { color: #ffc107; font-weight: 600; font-size: 0.95rem; }
    .selection-bar .hint { color: #6c757d; font-size: 0.75rem; }
    .beat-card.playing { border-color: #20c997; box-shadow: 0 0 0 1px rgba(32,201,151,0.4), 0 0 18px rgba(32,201,151,0.25); }
    .beat-card.stale { border-left: 3px solid #dc3545; }
    .beat-card.recorded { border-left: 3px solid #198754; }

    /* Live Broadcast cursor: the beat currently on air. Pulsing cyan rail so
       the eye can track the cursor and edit the beats just past it. */
    .beat-card.broadcasting-now {
        border-color: #0dcaf0;
        box-shadow: 0 0 0 1px rgba(13,202,240,0.55), 0 0 26px rgba(13,202,240,0.28);
        animation: broadcast-pulse 1.6s ease-in-out infinite;
    }
    @@keyframes broadcast-pulse {
        0%, 100% { box-shadow: 0 0 0 1px rgba(13,202,240,0.55), 0 0 12px rgba(13,202,240,0.18); }
        50%      { box-shadow: 0 0 0 1px rgba(13,202,240,0.75), 0 0 30px rgba(13,202,240,0.35); }
    }

    /* Read / edit must share the exact same box: same font, line-height,
       padding, border, background. Clicking into edit only swaps the
       displayed content (formatted prose ↔ raw text with tags); the
       container itself doesn't move. */
    .beat-prose,
    .beat-textarea {
        display: block;
        width: 100%;
        margin: 0;
        padding: 0;
        border: none;
        background: transparent;
        color: #e9ecef;
        font-family: inherit;
        font-size: 1rem;
        line-height: 1.55;
        white-space: pre-wrap;
        min-height: 1.55rem;
        cursor: text;
    }
    .beat-prose:hover { color: #f8f9fa; }
    .beat-prose-empty { color: #495057; font-style: italic; }
    .beat-textarea {
        resize: none;            /* no drag handle — sizes by row count */
        outline: none;
        overflow: hidden;        /* row count drives height, no scrollbars */
        box-shadow: none;
    }
    /* Focus indicator: the parent .beat-card.editing already turns its
       border cyan, so a textarea-specific focus rule is redundant and
       would risk shifting the box. Just kill the user-agent outline. */
    .beat-textarea:focus { outline: none; }
    /* Edit textarea sizes to content via JS interop (autoSizeTextarea).
       Min-height matches the prose container so very short beats don't
       collapse below readable size. */
    .beat-textarea { min-height: 1.55rem; }
    /* Save/Cancel render INLINE in the same .beat-actions row that holds
       the read-mode copy/llm/mic/delete buttons — conditional swap, so
       they can never overlap. The absolute-positioned .beat-edit-actions
       overlay is gone. */
    .insert-bar { display: flex; align-items: center; gap: 0.5rem; opacity: 0; transition: opacity 0.15s ease; padding: 0.25rem 0; }
    .insert-bar:hover, .insert-bar:focus-within { opacity: 1; }
    .insert-bar-line { flex-grow: 1; height: 1px; background: #2a2a2a; }
    .beat-meta-chips { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-top: 0.35rem; font-size: 0.7rem; }
    .beat-meta-chip { padding: 0.1rem 0.45rem; border-radius: 10px; background: rgba(13,202,240,0.08); color: #79d2e8; cursor: pointer; }
    .beat-meta-chip.unset { color: #495057; background: transparent; border: 1px dashed #2a2a2a; }
    .beat-meta-chip:hover { background: rgba(13,202,240,0.15); }
    .beat-meta-panel { margin-top: 0.6rem; padding: 0.6rem; background: #0d0d0d; border: 1px solid #2a2a2a; border-radius: 6px; }
    .beat-meta-panel label { color: #adb5bd; font-size: 0.75rem; margin-bottom: 0.15rem; }
    .beat-meta-panel select, .beat-meta-panel input { background: #0a0a0a; border: 1px solid #2a2a2a; color: #f8f9fa; font-size: 0.85rem; }
    .insert-bar-btn { background: transparent; border: 1px dashed #3a3a3a; color: #0dcaf0; font-size: 0.75rem; padding: 0.15rem 0.55rem; border-radius: 12px; cursor: pointer; }
    .insert-bar-btn:hover { background: rgba(13,202,240,0.08); border-color: #0dcaf0; }
    .beat-audio { width: 100%; height: 28px; margin-top: 0.5rem; filter: brightness(0.85); }
    .strand-meta-chip { font-size: 0.7rem; padding: 0.2rem 0.5rem; }
</style>

@if (loading)
{
    <div class="container py-4 text-muted">
        <div class="spinner-border spinner-border-sm me-2"></div>Loading strand…
    </div>
}
else if (strand == null)
{
    <div class="container py-4">
        <div class="alert alert-warning">No strand found for <code>@IdOrSlug</code>. <a href="/strands">Back to index</a>.</div>
    </div>
}
else
{
    <div class="container strand-shell py-3">
        @if (ancestors.Count > 0)
        {
            <nav aria-label="strand breadcrumb" class="mb-2">
                <ol class="d-flex flex-wrap gap-1 small text-muted mb-0 ps-0" style="list-style:none;">
                    <li><a href="/strands" class="text-decoration-none text-muted">strands</a></li>
                    @foreach (var a in ancestors)
                    {
                        <li>›</li>
                        <li><a href="@($"/strand/{a.Slug}")" class="text-decoration-none text-info">@a.Title</a><span class="text-muted ms-1">(@a.Kind)</span></li>
                    }
                    <li>›</li>
                    <li><span class="text-light">@strand.Title</span></li>
                </ol>
            </nav>
        }
        <div class="strand-head">
            <div class="d-flex align-items-start gap-3">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <span class="badge bg-secondary strand-meta-chip text-uppercase">@strand.Kind</span>
                        <span class="badge bg-@StatusColor(strand.Status) strand-meta-chip text-uppercase">@StatusLabel(strand.Status)</span>
                        @if (StaleCount > 0)
                        {
                            <span class="badge bg-danger strand-meta-chip">@StaleCount stale</span>
                        }
                        @if (NarratedCount > 0)
                        {
                            <span class="badge bg-success strand-meta-chip">@NarratedCount/@beats.Count narrated</span>
                        }
                        @if (TotalChars > 0)
                        {
                            <span class="text-muted small">@TotalChars.ToString("N0") chars</span>
                        }
                    </div>
                    <input class="strand-title w-100" placeholder="Untitled strand"
                           @bind="strand.Title" @bind:event="oninput" @onblur="SaveStrandHeaderAsync" />
                    <textarea class="strand-synopsis mt-1" rows="1" placeholder="Synopsis (optional)"
                              @bind="strand.Synopsis" @bind:event="oninput" @onblur="SaveStrandHeaderAsync"></textarea>
                </div>
                <div style="min-width:200px;">
                    <label class="form-label small text-muted mb-1">Voice</label>
                    <select class="form-select form-select-sm bg-black text-light border-secondary" @bind="strand.VoiceId" @bind:after="SaveStrandHeaderAsync">
                        @foreach (var v in voices)
                        {
                            <option value="@v.VoiceId">@v.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap mt-2">
                @if (strand.Status is "narrating" or "generating")
                {
                    <button class="btn btn-sm btn-warning" @onclick="StopAsync">
                        <i class="bi bi-stop-circle me-1"></i>Stop narration
                    </button>
                }
                else
                {
                    // Label adapts to what NarrateAsync will actually do.
                    // Stale beats already have null AudioPath, so the same
                    // single button covers "fresh record / continue / fill
                    // gaps / re-record stale" — the old separate stale
                    // button was a no-op duplicate.
                    var recordLabel = NarratedCount == 0
                        ? "Record"
                        : StaleCount > 0
                            ? $"Re-record stale ({StaleCount})"
                            : NarratedCount < beats.Count
                                ? "Continue recording"
                                : "Re-narrate gaps";
                    <button class="btn btn-sm btn-primary" @onclick="NarrateAsync" disabled="@working">
                        @if (working) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        else { <i class="bi bi-mic-fill me-1"></i> }
                        @recordLabel
                    </button>
                    <button class="btn btn-sm btn-outline-warning" @onclick="ReRecordAllAsync" disabled="@working" title="Replaces ALL audio for this strand">
                        <i class="bi bi-arrow-counterclockwise me-1"></i>Re-record all
                    </button>
                }
                <div class="vr"></div>
                <button class="btn btn-sm btn-success" @onclick="ExportCombinedAsync" disabled="@working"
                        title="Publish whatever's recorded so far into one sound file">
                    <i class="bi bi-collection-play me-1"></i>Publish
                </button>
                @if (broadcasting)
                {
                    <button class="btn btn-sm btn-danger" @onclick="StopBroadcastAsync"
                            title="Stop the live broadcast">
                        <i class="bi bi-stop-circle me-1"></i>Stop broadcast
                    </button>
                }
                else
                {
                    <button class="btn btn-sm btn-outline-info" @onclick="StartBroadcastAsync" disabled="@(working || beats.Count == 0)"
                            title="Tell the story live — plays beat-by-beat, buffering a few ahead, so you can edit upcoming beats before the cursor reaches them">
                        <i class="bi bi-broadcast me-1"></i>Live Broadcast
                    </button>
                }
                @if (!string.IsNullOrEmpty(strand.CombinedAudioPath))
                {
                    @if (StaleCount > 0)
                    {
                        <button class="btn btn-sm btn-outline-secondary" disabled title="@($"{StaleCount} beat(s) need re-recording.")">
                            <i class="bi bi-download me-1"></i>Download (incomplete)
                        </button>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-success" href="@CombinedAudioUrl()" download>
                            <i class="bi bi-download me-1"></i>Download
                        </a>
                    }
                }
                <div class="ms-auto">
                    <a href="/strands" class="btn btn-sm btn-link text-muted">
                        <i class="bi bi-arrow-left me-1"></i>All strands
                    </a>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(strand.CombinedAudioPath) && StaleCount == 0)
        {
            <div class="mb-3">
                <audio controls src="@CombinedAudioUrl()" class="w-100" style="height:34px;"></audio>
            </div>
        }

        @* Resume banner: if the listener has a saved LastPlayedBeatId on
           this strand AND that beat still exists, surface a one-click jump
           to where they walked away. Hidden when the resume target is the
           very first beat (no actual progress to resume). *@
        @if (resumeBeatId.HasValue && beats.Any(o => o.Beat.Id == resumeBeatId.Value))
        {
            var resumePos = beats.FindIndex(o => o.Beat.Id == resumeBeatId.Value) + 1;
            @if (resumePos > 1)
            {
                <div class="resume-banner">
                    <i class="bi bi-bookmark-fill text-info"></i>
                    <span>Listened up to Beat #@resumePos.ToString("D3").</span>
                    <button class="btn btn-sm btn-outline-info" @onclick="ScrollToResumeAsync">
                        <i class="bi bi-arrow-down-circle me-1"></i>Jump to it
                    </button>
                    <button class="btn btn-sm btn-link text-muted" @onclick="ClearResumeAsync" title="Forget the saved listening position">
                        Dismiss
                    </button>
                </div>
            }
        }

        @* Nested-strands list removed: a strand is now a single flat list of
           beats, with section divisions marked by Beat.IsChapterStart.

           In its place, render a chapter index — one jump-link per beat
           with IsChapterStart=true. Click jumps to the beat's row via
           anchor scroll. Built from the in-memory beats list so the count
           updates immediately when the user toggles IsChapterStart. *@
        @{
            var chapterStops = beats
                .Select((entry, idx) => (entry.Beat, position: idx + 1))
                .Where(x => x.Beat.IsChapterStart)
                .ToList();
        }
        @if (chapterStops.Count > 1)
        {
            <div class="chapter-index">
                <div class="chapter-index-head">
                    <i class="bi bi-list-ol me-1"></i>@chapterStops.Count chapter(s)
                </div>
                <div class="chapter-index-list">
                    @foreach (var stop in chapterStops)
                    {
                        var label = string.IsNullOrEmpty(stop.Beat.BeatTitle) ? "(untitled chapter)" : stop.Beat.BeatTitle;
                        <a href="@($"#beat-{stop.Beat.Id:N}")" class="chapter-index-link">
                            <span class="ci-pos">#@stop.position</span>@label
                        </a>
                    }
                </div>
            </div>
        }

        @if (beats.Count == 0)
        {
            <div class="card bg-dark border-secondary text-center py-5 text-muted">
                <div class="mb-3">
                    <i class="bi bi-stars" style="font-size: 2rem; opacity: 0.4;"></i>
                </div>
                <div class="mb-1">An empty strand. The first beat starts the story.</div>
                <div class="mt-3">
                    <button class="btn btn-outline-info" @onclick="() => InsertBeatAsync(null)" disabled="@working" data-cy="insert-first">
                        <i class="bi bi-plus-circle me-1"></i>Add the first beat
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column" id="strand-beats-root">
                <div class="insert-bar">
                    <div class="insert-bar-line"></div>
                    <button class="insert-bar-btn" @onclick="() => InsertBeatAsync(null)" disabled="@working" data-cy="insert-top">
                        <i class="bi bi-plus-circle me-1"></i>insert at top
                    </button>
                    <div class="insert-bar-line"></div>
                </div>

                @{ int position = 0; }
                @foreach (var entry in beats)
                {
                    position++;
                    var b = entry.Beat;
                    var isEditing = editingBeatId == b.Id;
                    var bid = b.Id;
                    var isSelected = selectedBeats.Contains(bid);
                    var rowClass = "beat-card mb-1";
                    if (isEditing) rowClass += " editing";
                    else if (isSelected) rowClass += " selected";
                    else if (b.Stale) rowClass += " stale";
                    else if (!string.IsNullOrEmpty(b.AudioPath)) rowClass += " recorded";
                    if (resumeBeatId == bid) rowClass += " resume-here";
                    if (broadcasting && broadcastBeatId == bid) rowClass += " broadcasting-now";
                    var rowPosition = position;
                    var isLastBeat = position == beats.Count;
                    var nextBeat = isLastBeat ? null : beats[position].Beat;
                    var autoGapMs = ComputeAutoGapMs(b, nextBeat);
                    var hasCustomGap = b.GapAfterMs.HasValue;
                    var displayGapMs = b.GapAfterMs ?? autoGapMs;
                    var gapEditorId = $"gap-input-{bid:N}";

                    @if (b.IsChapterStart)
                    {
                        <div class="beat-chapter-divider" data-cy="chapter-divider">
                            <span class="beat-chapter-line"></span>
                            <span class="beat-chapter-label">@(string.IsNullOrEmpty(b.BeatTitle) ? "New section" : b.BeatTitle)</span>
                            <span class="beat-chapter-line"></span>
                        </div>
                    }

                    <div class="@rowClass" id="@($"beat-{bid:N}")" data-cy="beat-row" data-beat-id="@bid" data-strand-id="@entry.StrandId" draggable="true">
                        @* ── Row 1: drag handle · checkbox · Beat # + chips · format toolbar · right-aligned action buttons ── *@
                        <div class="beat-row-1 d-flex align-items-center gap-2 mb-2">
                            <span class="beat-drag-handle" title="Drag to reorder this beat within the strand">
                                <i class="bi bi-grip-vertical"></i>
                            </span>
                            <input type="checkbox" class="beat-select-box-inline"
                                   checked="@isSelected"
                                   title="Select beat for play / batch actions"
                                   @onchange="@(e => ToggleBeatSelection(bid, (bool)(e.Value ?? false)))" />
                            <span class="beat-id-chip" data-cy="beat-id" title="@($"Position {rowPosition} in strand — Beat guid {bid}")">Beat #@rowPosition.ToString("D3")</span>
                            @if (b.Stale)
                            {
                                <span class="badge bg-danger strand-meta-chip" title="Prose edited past the audio. Re-record to repair.">stale</span>
                            }
                            else if (!string.IsNullOrEmpty(b.AudioPath))
                            {
                                <span class="badge bg-success strand-meta-chip">
                                    <i class="bi bi-volume-up-fill me-1"></i>@(b.DurationSec.HasValue ? FormatDuration(b.DurationSec.Value) : "—")
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary strand-meta-chip">unrecorded</span>
                            }
                            @if (!string.IsNullOrEmpty(b.Text))
                            {
                                <span class="text-muted small beat-char-count">@b.Text.Length chars</span>
                            }

                            @* Format toolbar — only does anything while editing. The
                               wrap helper inserts the marker either around the
                               current textarea selection or at the caret. Buttons
                               are disabled until the user clicks into edit mode. *@
                            <div class="beat-format-toolbar" role="toolbar" aria-label="Inline formatting">
                                <button class="btn btn-sm btn-outline-light"
                                        title="Bold (**text**) — wraps current selection in the textarea"
                                        @onclick='() => WrapFormatAsync(bid, "**")'
                                        @onclick:stopPropagation
                                        disabled="@(!isEditing)"
                                        data-cy="beat-fmt-bold">
                                    <i class="bi bi-type-bold"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-light"
                                        title="Italic (*text*)"
                                        @onclick='() => WrapFormatAsync(bid, "*")'
                                        @onclick:stopPropagation
                                        disabled="@(!isEditing)"
                                        data-cy="beat-fmt-italic">
                                    <i class="bi bi-type-italic"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-light"
                                        title="Underline (__text__)"
                                        @onclick='() => WrapFormatAsync(bid, "__")'
                                        @onclick:stopPropagation
                                        disabled="@(!isEditing)"
                                        data-cy="beat-fmt-underline">
                                    <i class="bi bi-type-underline"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-light"
                                        title="Strikethrough (~~text~~)"
                                        @onclick='() => WrapFormatAsync(bid, "~~")'
                                        @onclick:stopPropagation
                                        disabled="@(!isEditing)"
                                        data-cy="beat-fmt-strike">
                                    <i class="bi bi-type-strikethrough"></i>
                                </button>
                            </div>

                            @* Right-aligned action cluster. In edit mode it's Save / Cancel;
                               in read mode it's the regular copy / LLM / mic / delete row.
                               Conditional inline (no absolute floater) so the two states
                               cannot overlap each other regardless of layout. *@
                            <div class="beat-actions d-flex align-items-center gap-1 ms-auto">
                                @if (isEditing)
                                {
                                    <button class="btn btn-sm btn-success"
                                            @onclick="() => SaveBeatEditAsync(bid)"
                                            disabled="@savingEdit"
                                            title="Save (⌘/Ctrl+Enter)"
                                            data-cy="beat-save">
                                        @if (savingEdit) { <span class="spinner-border spinner-border-sm"></span> }
                                        else { <i class="bi bi-check-lg"></i> }
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="CancelBeatEdit"
                                            title="Cancel (Esc)"
                                            data-cy="beat-cancel">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-secondary @(copiedTextBeatId == bid ? "copied" : "")"
                                            title="@(copiedTextBeatId == bid ? "Copied!" : "Copy beat text to clipboard")"
                                            @onclick="() => CopyBeatTextAsync(bid)"
                                            @onclick:stopPropagation
                                            data-cy="beat-copy-text">
                                        <i class="bi @(copiedTextBeatId == bid ? "bi-check-lg" : "bi-clipboard")"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-primary"
                                            title="Ask the LLM to rewrite this beat"
                                            @onclick="() => OpenLlmSheet(b)"
                                            @onclick:stopPropagation
                                            disabled="@working"
                                            data-cy="beat-llm">
                                        <i class="bi bi-stars"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-info"
                                            title="Re-record this beat's audio with ElevenLabs"
                                            @onclick="() => RerecordOneAsync(bid)"
                                            @onclick:stopPropagation
                                            disabled="@working"
                                            data-cy="beat-rerecord">
                                        <i class="bi bi-mic"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            title="Delete this beat (confirmation prompt)"
                                            @onclick="() => RequestDeleteAsync(bid)"
                                            @onclick:stopPropagation
                                            disabled="@working"
                                            data-cy="beat-delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>

                        @* ── Row 2: readonly / textarea toggle. Same box either way.
                           Edit mode reveals the raw markers ([WHISPERING], **bold**);
                           read mode renders them as emoji + HTML formatting. ── *@
                        <div class="beat-row-2">
                            @if (isEditing)
                            {
                                @* No rows attribute — JS autoSizeTextarea sizes height
                                   to content. CSS gives min-height matching the prose
                                   container so cold-start has no jump either. *@
                                <textarea class="beat-textarea" id="@($"beat-{bid:N}-edit")"
                                          @bind="editingText"
                                          @bind:event="oninput"
                                          @onkeyup="@(() => AutoSizeTextareaAsync(bid))"
                                          @onkeydown="@(e => OnEditorKeydown(e, bid))"></textarea>
                            }
                            else
                            {
                                @if (string.IsNullOrEmpty(b.Text))
                                {
                                    <div class="beat-prose beat-prose-empty" @onclick="() => StartBeatEdit(b)" data-cy="beat-prose">
                                        (empty beat — click to write)
                                    </div>
                                }
                                else
                                {
                                    @* Render the beat body per its Kind. Beat.Text passes through
                                       BeatFormatter so **bold** / *italic* / __underline__ / ~~strike~~
                                       and ElevenLabs tone tags ([WHISPERING] → 🤫 etc.) render in
                                       the read view. The textarea in edit mode shows raw markers. *@
                                    var renderedHtml = (MarkupString)BeatFormatter.RenderInline(b.Text);
                                    switch ((b.Kind ?? "prose").ToLowerInvariant())
                                    {
                                        case "book-title":
                                            <div class="beat-prose beat-prose-book-title" @onclick="() => StartBeatEdit(b)" data-cy="beat-prose">
                                                <div class="book-title-line">@renderedHtml</div>
                                                @if (!string.IsNullOrEmpty(b.BeatTitle))
                                                {
                                                    <div class="book-title-byline">@b.BeatTitle</div>
                                                }
                                            </div>
                                            break;
                                        case "dedication":
                                            <div class="beat-prose beat-prose-dedication" @onclick="() => StartBeatEdit(b)" data-cy="beat-prose">@renderedHtml</div>
                                            break;
                                        case "quote":
                                            <blockquote class="beat-prose beat-prose-quote" @onclick="() => StartBeatEdit(b)" data-cy="beat-prose">
                                                <div class="quote-text">@renderedHtml</div>
                                                @if (!string.IsNullOrEmpty(b.BeatTitle))
                                                {
                                                    <footer class="quote-attribution">— @b.BeatTitle</footer>
                                                }
                                            </blockquote>
                                            break;
                                        default:
                                            <div class="beat-prose" @onclick="() => StartBeatEdit(b)" data-cy="beat-prose">@renderedHtml</div>
                                            break;
                                    }
                                }
                            }
                        </div>

                        @* ── Row 3: footer band. Audio (if recorded), then a single
                           flex row with meta chips (left) + gap-after editor
                           (right). The meta-panel (when open) stacks below. ── *@
                        <div class="beat-row-3">
                            @if (!string.IsNullOrEmpty(b.AudioPath))
                            {
                                <audio controls preload="none" class="beat-audio"
                                       src="@($"/api/strands/{strand.Id}/beat/{b.Id}/audio")"></audio>
                            }
                            <div class="beat-row-3-bar d-flex justify-content-between align-items-center flex-wrap">
                        <div class="beat-meta-chips">
                            @{
                                var tone  = b.EmotionalTone;
                                var pace  = b.PaceHint;
                                var facet = b.FacetTag;
                                var btitle = b.BeatTitle;
                            }
                            @if (!string.IsNullOrEmpty(btitle))
                            {
                                <span class="beat-meta-chip" @onclick="() => ToggleMeta(bid)" title="Beat title — short label only, not narrated.">📑 @btitle</span>
                            }
                            <span class="beat-meta-chip @(string.IsNullOrEmpty(tone) ? "unset" : "")"
                                  @onclick="() => ToggleMeta(bid)"
                                  title="Emotional tone — maps to an ElevenLabs inline audio tag on v3 voices (e.g. [whispering], [shouting]).">
                                @(string.IsNullOrEmpty(tone) ? "tone: —" : $"🎭 {tone}")
                            </span>
                            <span class="beat-meta-chip @(string.IsNullOrEmpty(pace) ? "unset" : "")"
                                  @onclick="() => ToggleMeta(bid)"
                                  title="Pace hint — biases narration stability (clipped/staccato → faster, languorous → slower).">
                                @(string.IsNullOrEmpty(pace) ? "pace: —" : $"⏱ {pace}")
                            </span>
                            <span class="beat-meta-chip @(string.IsNullOrEmpty(facet) ? "unset" : "")"
                                  @onclick="() => ToggleMeta(bid)"
                                  title="Character facet — Kyle's psychological mode for this beat (WOUND/SHADOW/MASK/IDEAL). Used as a fallback narration cue when tone is blank.">
                                @(string.IsNullOrEmpty(facet) ? "facet: —" : $"🎭 {facet}")
                            </span>
                            <span class="beat-meta-chip" @onclick="() => ToggleMeta(bid)" data-cy="beat-meta-toggle">
                                @(metaOpenBeatId == bid ? "▲ details" : "▾ details")
                            </span>
                        </div>

                            @* Gap-after editor — only shown when there's a next beat.
                               Lives inside .beat-row-3-bar so it sits on the same flex
                               row as the meta chips, right-aligned by justify-content. *@
                            @if (!isLastBeat)
                            {
                                <div class="beat-gap-inline @(hasCustomGap ? "custom" : "")" title="@(hasCustomGap ? $"Custom gap: {displayGapMs}ms (auto would be {autoGapMs}ms)" : $"Auto gap: {autoGapMs}ms — type to override")">
                                    <span class="text-muted small">gap after</span>
                                    <input type="number" min="0" max="6000" step="50"
                                           value="@displayGapMs"
                                           id="@gapEditorId"
                                           class="beat-gap-input"
                                           @onkeydown="@(e => OnGapEditorKeydown(e, bid, gapEditorId))" />
                                    <span class="text-muted small">ms @(hasCustomGap ? "(custom)" : "(auto)")</span>
                                    <button class="btn btn-sm btn-link p-0 text-info" title="Save (Enter)" @onclick="@(() => SaveGapAfterFromInputAsync(bid, gapEditorId))">✓</button>
                                    @if (hasCustomGap)
                                    {
                                        <button class="btn btn-sm btn-link p-0 text-warning" title="Reset to auto" @onclick="@(() => ResetGapAfterAsync(bid))">↺</button>
                                    }
                                </div>
                            }
                            </div> @* /beat-row-3-bar *@

                        @if (metaOpenBeatId == bid)
                        {
                            <div class="beat-meta-panel">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label>Beat title (label only — not narrated)</label>
                                        <input class="form-control form-control-sm" @bind="metaForm.BeatTitle" placeholder="e.g. The threshold" />
                                    </div>
                                    <div class="col-md-6">
                                        <label>Synopsis (one line — fed to LLM regenerations)</label>
                                        <input class="form-control form-control-sm" @bind="metaForm.Synopsis" placeholder="What is this beat doing?" />
                                    </div>
                                    <div class="col-md-4">
                                        <label>Emotional tone → audio tag</label>
                                        <select class="form-select form-select-sm" @bind="metaForm.EmotionalTone" data-cy="beat-meta-tone">
                                            <option value="">(none)</option>
                                            <option value="quiet">quiet → [whispering]</option>
                                            <option value="tender">tender → [softly]</option>
                                            <option value="sad">sad → [melancholy]</option>
                                            <option value="afraid">afraid → [afraid]</option>
                                            <option value="tense">tense → [tense]</option>
                                            <option value="wry">wry → [sarcastic]</option>
                                            <option value="curious">curious → [curious]</option>
                                            <option value="excited">excited → [excited]</option>
                                            <option value="happy">happy → [cheerful]</option>
                                            <option value="angry">angry → [angry]</option>
                                            <option value="violent">violent → [shouting]</option>
                                            <option value="mysterious">mysterious → [mysterious]</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Pace hint</label>
                                        <select class="form-select form-select-sm" @bind="metaForm.PaceHint">
                                            <option value="">(none)</option>
                                            <option value="flowing">flowing</option>
                                            <option value="clipped">clipped</option>
                                            <option value="staccato">staccato</option>
                                            <option value="languorous">languorous</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Character facet</label>
                                        <select class="form-select form-select-sm" @bind="metaForm.FacetTag">
                                            <option value="">(none)</option>
                                            <option value="WOUND">WOUND → [somber]</option>
                                            <option value="SHADOW">SHADOW → [menacing]</option>
                                            <option value="MASK">MASK → [deadpan]</option>
                                            <option value="IDEAL">IDEAL → [resolute]</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Structure role</label>
                                        <input class="form-control form-control-sm" @bind="metaForm.StructureRole" placeholder="inciting-incident, rising-action, climax…" />
                                    </div>
                                    <div class="col-md-4">
                                        <label>Act</label>
                                        <input type="number" class="form-control form-control-sm" min="0" max="5" @bind="metaForm.Act" />
                                    </div>
                                    <div class="col-md-4">
                                        <label>Scene type</label>
                                        <select class="form-select form-select-sm" @bind="metaForm.SceneType">
                                            <option value="scene">scene</option>
                                            <option value="summary">summary</option>
                                            <option value="transition">transition</option>
                                            <option value="interstitial">interstitial</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Beat kind</label>
                                        <select class="form-select form-select-sm" @bind="metaForm.Kind">
                                            <option value="prose">prose (default)</option>
                                            <option value="book-title">book-title (Text=title, BeatTitle=author)</option>
                                            <option value="dedication">dedication (centered italic)</option>
                                            <option value="quote">quote (Text=quote, BeatTitle=attribution)</option>
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="@($"beat-{bid:N}-chapstart")"
                                                   @bind="metaForm.IsChapterStart" />
                                            <label class="form-check-label" for="@($"beat-{bid:N}-chapstart")">
                                                This beat starts a new chapter / section
                                                <span class="text-muted small ms-1">— uses Beat title above as the heading; renders a divider. Orthogonal to Beat kind (a quote that opens a chapter is an epigraph).</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 mt-2 align-items-center">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveMetaAsync(bid)" data-cy="beat-meta-save">
                                        <i class="bi bi-check-lg me-1"></i>Save details
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelMeta">Close</button>
                                    <span class="text-muted small ms-auto">These steer narration tone on next re-record. Audio stays valid until you re-record.</span>
                                </div>
                            </div>
                        }
                        </div> @* /beat-row-3 *@
                    </div>

                    <div class="insert-bar">
                        <div class="insert-bar-line"></div>
                        <button class="insert-bar-btn" @onclick="() => InsertBeatAsync(bid)" disabled="@working" data-cy="insert-after">
                            <i class="bi bi-plus-circle me-1"></i>insert beat
                        </button>
                        <div class="insert-bar-line"></div>
                    </div>
                } @* end foreach *@

                @if (selectedBeats.Count > 0)
                {
                    <div class="selection-bar" data-cy="selection-bar">
                        <span class="count" data-cy="selection-count">@selectedBeats.Count selected</span>
                        @if (isPlayingSequence)
                        {
                            <button class="btn btn-sm btn-danger" title="Stop playback"
                                    @onclick="StopPlayingAsync" data-cy="stop-playing">
                                <i class="bi bi-stop-fill me-1"></i>Stop
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-warning" title="Play selected beats in order with the gaps between them"
                                    @onclick="PlaySelectedAsync" data-cy="play-selected">
                                <i class="bi bi-play-fill me-1"></i>Play selected
                            </button>
                        }
                        <button class="btn btn-sm btn-outline-warning" @onclick="ClearSelection" data-cy="clear-selection">
                            <i class="bi bi-x-lg me-1"></i>Clear
                        </button>
                        <span class="ms-auto hint">Voice from active profile · pauses honour per-gap overrides · Esc to clear</span>
                    </div>
                }
            </div>
        }
    </div>
}

@if (pendingDelete != null)
{
    @* Click backdrop → cancel. Click inside the dialog stops propagation
       so the modal stays open. Escape handler attached at top of body via
       JS interop — see EnsureEscapeHook(). *@
    <div class="modal d-block" style="background:rgba(0,0,0,0.6);" tabindex="-1"
         @onclick="CancelDelete">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation>
            <div class="modal-content bg-dark border-danger">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete this beat?</h5>
                </div>
                <div class="modal-body text-light small">
                    The beat will be removed from this strand. If no other strand references it, the beat itself (text + audio) is deleted.
                </div>
                <div class="modal-footer border-secondary">
                    <button class="btn btn-outline-secondary" @onclick="CancelDelete">Cancel <span class="text-muted ms-1">(Esc)</span></button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteAsync" data-cy="confirm-delete">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@* ── LLM bottom sheet ───────────────────────────────────────────────────
   Pops up from the bottom of the page when the user clicks the ✨ button
   on any beat. Free-text instruction; previews the LLM's proposed rewrite;
   user picks Apply (replaces beat.Text via Workbench.UpdateBeatTextAsync)
   or Discard. *@
@if (llmSheetBeat != null)
{
    <div class="llm-sheet-backdrop" @onclick="CloseLlmSheet"></div>
    <div class="llm-sheet" @onclick:stopPropagation>
        <div class="llm-sheet-header d-flex justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2 flex-grow-1" style="min-width:0;">
                <i class="bi bi-stars text-primary"></i>
                <strong class="flex-shrink-0">Beat #@llmSheetBeatPosition</strong>
                <code class="llm-sheet-ref text-truncate" title="strand-guid.beat-guid — click the id button to copy">@llmSheetRefText</code>
                <button class="beat-copy-btn @(llmSheetIdCopied ? "copied" : "")"
                        title="Copy strand-guid.beat-guid for CLI (--% --beat @llmSheetRefText)"
                        @onclick="CopyLlmSheetRefAsync">
                    <i class="bi bi-hash"></i>
                    @(llmSheetIdCopied ? " copied" : " id")
                </button>
            </div>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CloseLlmSheet">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="llm-sheet-body">
            <div class="text-muted small mb-1">Current beat text:</div>
            <div class="llm-sheet-beat-text">@llmSheetBeat.Text</div>

            <div class="text-muted small mt-3 mb-1">What should the LLM do with this beat?</div>
            <textarea class="form-control bg-black text-light border-secondary"
                      rows="3"
                      placeholder="e.g. tighten this — drop the second sentence, keep the menace"
                      @bind="llmSheetInstruction"
                      @bind:event="oninput"></textarea>

            <div class="d-flex gap-2 mt-2 align-items-center">
                <button class="btn btn-sm btn-primary" @onclick="RunLlmSheetAsync"
                        disabled="@(llmSheetRunning || string.IsNullOrWhiteSpace(llmSheetInstruction))">
                    @if (llmSheetRunning) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    else { <i class="bi bi-stars me-1"></i> }
                    Run
                </button>
                <span class="text-muted small">⌘/Ctrl+Enter to run · Esc to close</span>
            </div>

            @if (!string.IsNullOrEmpty(llmSheetProposal))
            {
                <div class="text-muted small mt-3 mb-1">Proposed rewrite:</div>
                <div class="llm-sheet-proposal">@llmSheetProposal</div>
                <div class="d-flex gap-2 mt-2 align-items-center">
                    <button class="btn btn-sm btn-success" @onclick="ApplyLlmSheetAsync" disabled="@llmSheetRunning">
                        <i class="bi bi-check-lg me-1"></i>Apply
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="DiscardLlmSheetProposal" disabled="@llmSheetRunning">
                        <i class="bi bi-x-lg me-1"></i>Discard
                    </button>
                </div>
            }
        </div>
    </div>
}

<style>
    .llm-sheet-backdrop { position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 1080; }
    .llm-sheet {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 1090;
        background: #0f0f0f; border-top: 1px solid #2a2a2a;
        box-shadow: 0 -8px 24px rgba(0,0,0,0.5);
        max-height: 70vh; overflow-y: auto;
        animation: llm-sheet-rise 0.18s ease-out;
    }
    @@keyframes llm-sheet-rise { from { transform: translateY(100%); } to { transform: translateY(0); } }
    .llm-sheet-header { padding: 0.75rem 1rem; border-bottom: 1px solid #2a2a2a; color: #f8f9fa; }
    .llm-sheet-ref { font-size: 0.72rem; color: #79d2e8; background: rgba(13,202,240,0.06); border: 1px solid rgba(13,202,240,0.25); padding: 0.15rem 0.4rem; border-radius: 3px; }
    .llm-sheet-body { padding: 0.75rem 1rem 1.25rem; max-width: 920px; margin: 0 auto; }
    .llm-sheet-beat-text { background: #161616; border: 1px solid #2a2a2a; border-radius: 4px; padding: 0.6rem 0.8rem; color: #ced4da; font-size: 0.88rem; white-space: pre-wrap; }
    .llm-sheet-proposal { background: rgba(13,202,240,0.06); border: 1px solid rgba(13,202,240,0.35); border-radius: 4px; padding: 0.6rem 0.8rem; color: #e6edf3; font-size: 0.88rem; white-space: pre-wrap; }
</style>

@code {
    [Parameter] public string IdOrSlug { get; set; } = "";

    private StrandEntity? strand;
    /// <summary>UpdatedAt of the strand row at the moment LoadAsync ran.
    /// Passed back into SaveStrandHeaderAsync as an optimistic-concurrency
    /// check — if the row moved underneath us (another tab, an MCP tool),
    /// the save aborts with a toast instead of silently clobbering the
    /// other write.</summary>
    private DateTime? strandLoadedUpdatedAt;
    private List<StrandWorkbenchService.OrderedBeat> beats = new();
    /// <summary>Ancestors of the current strand, root first. Empty if this is
    /// a top-level strand. Used for the breadcrumb at the page header.</summary>
    private List<StrandEntity> ancestors = new();
    /// <summary>Direct children of the current strand. A book strand shows
    /// its chapter children here so the user can navigate down without
    /// going back to /strands.</summary>
    private List<StrandEntity> children = new();
    private bool loading = true;
    private bool working;
    private bool savingEdit;
    private Guid? editingBeatId;
    private string editingText = "";
    /// <summary>UpdatedAt captured when the user entered edit mode. Passed
    /// back on save so the workbench can detect "another tab/MCP-tool wrote
    /// in between" and surface a conflict toast instead of clobbering.</summary>
    private DateTime? editingOriginalUpdatedAt;

    /// <summary>When set, the beat-details metadata panel is open for this beat.</summary>
    private Guid? metaOpenBeatId;
    /// <summary>Working copy of the meta panel form. Re-populated from the
    /// beat each time the panel opens; not persisted until Save.</summary>
    private MetaForm metaForm = new();
    private Guid? pendingDelete;
    private System.Threading.Timer? poll;
    private string? lastIdOrSlug;

    /// <summary>Per-beat "just copied to clipboard" flash state. The copy-text
    /// button toggles to a check icon for ~1.4s after a successful copy.</summary>
    private Guid? copiedTextBeatId;

    /// <summary>Multi-select set. Beats appearing here render with the
    /// .selected class and surface a "Play selected" action bar that
    /// streams them in order with the calculated inter-beat silence.</summary>
    private HashSet<Guid> selectedBeats = new();

    /// <summary>True while a multi-beat play sequence is running. Swaps
    /// the selection bar's Play button for a Stop button.</summary>
    private bool isPlayingSequence;

    // ── Live Broadcast state ─────────────────────────────────────────────
    /// <summary>True while a live broadcast is airing. The render loop keeps
    /// <see cref="BroadcastBufferAhead"/> beats voiced ahead of the cursor;
    /// beats further out stay un-rendered so edits to them are picked up for
    /// free when the cursor arrives.</summary>
    private bool broadcasting;
    /// <summary>The beat currently playing (the "cursor"). Highlighted in the
    /// list and auto-scrolled into view.</summary>
    private Guid? broadcastBeatId;
    private CancellationTokenSource? broadcastCts;
    /// <summary>How many beats to keep voiced ahead of the cursor. Capped low
    /// on purpose: rendering outpaces playback ~10:1, so a small buffer keeps
    /// distant beats un-rendered (and thus editable) until just before air.</summary>
    private const int BroadcastBufferAhead = 3;

    // ── LLM bottom-sheet state ───────────────────────────────────────────
    /// <summary>When non-null, the bottom sheet is open with this beat as
    /// context. Cleared on close.</summary>
    private BeatEntity? llmSheetBeat;
    private int llmSheetBeatPosition;
    private string llmSheetInstruction = "";
    private string llmSheetProposal = "";
    private bool llmSheetRunning;
    private bool llmSheetIdCopied;
    /// <summary>Stable strand.beat reference printed in the sheet header
    /// and used as the CLI handle ("strand-guid.beat-guid"). Built when
    /// the sheet opens so it's always populated alongside the beat.</summary>
    private string llmSheetRefText = "";

    private string defaultVoiceId = "";
    private List<TtsVoice> voices = new();

    /// <summary>Last beat the listener was playing, surfaced as a "resume here"
    /// banner + a green highlight ring on the row. Backed by
    /// Strand.LastPlayedBeatId; written by OnBeatStarted as the JS player
    /// advances.</summary>
    private Guid? resumeBeatId;

    /// <summary>Token returned by streetsamurai.installPageEscape — handed
    /// back to uninstallPageEscape on Dispose so the keydown listener does
    /// not leak across page navigation.</summary>
    private string? escapeToken;

    /// <summary>Stable .NET-to-JS callback shim. JS holds this for play
    /// progress AND drag-drop callbacks. Disposed in Dispose so the GC can
    /// collect the page after navigation.</summary>
    private DotNetObjectReference<Strand>? selfRef;

    /// <summary>True once JS has been told about the beat-row container.
    /// Drag handlers attach once and are idempotent on the JS side.</summary>
    private bool dragHandlersAttached;

    private int StaleCount    => beats.Count(b => b.Beat.Stale);
    private int NarratedCount => beats.Count(b => !string.IsNullOrEmpty(b.Beat.AudioPath));
    private int TotalChars    => beats.Sum(b => b.Beat.Text?.Length ?? 0);

    protected override async Task OnInitializedAsync()
    {
        defaultVoiceId = Settings.ElevenLabsVoiceId ?? "";
        try
        {
            voices = (await Tts.ListVoicesAsync()).OrderBy(v => v.Name).ToList();
            if (!string.IsNullOrEmpty(defaultVoiceId) && !voices.Any(v => v.VoiceId == defaultVoiceId))
                voices.Insert(0, new TtsVoice { VoiceId = defaultVoiceId, Name = "(saved default)" });
        }
        catch
        {
            voices = new() { new TtsVoice { VoiceId = defaultVoiceId, Name = "Default" } };
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (lastIdOrSlug == IdOrSlug) return;
        lastIdOrSlug = IdOrSlug;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Per-instance Escape handler — registers via JS interop and
            // returns a token we hand back on Dispose. Replaces the old
            // window-flag eval hook that leaked across page navigation.
            try { escapeToken = await JS.InvokeAsync<string>("streetsamurai.installPageEscape"); }
            catch { /* JS not loaded yet — selection-bar Esc just won't fire */ }
        }
        // Wire drag-and-drop reorder handlers as soon as the beats container
        // exists. Idempotent on the JS side; the C# guard avoids the extra
        // interop hop on every re-render.
        if (!dragHandlersAttached && strand != null && beats.Count > 0)
        {
            try
            {
                selfRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("streetsamurai.attachBeatDragHandlers", "strand-beats-root", selfRef);
                dragHandlersAttached = true;
            }
            catch { /* JS load race — try again next render */ }
        }
        // If a beat just entered edit mode, size its textarea to match the
        // content height. Subsequent typing keeps it sized via @oninput on
        // the textarea itself.
        if (autoSizePendingBeatId is { } b)
        {
            autoSizePendingBeatId = null;
            await AutoSizeTextareaAsync(b);
            // Move focus to the textarea via a typed helper. Runs on the
            // circuit thread (no Task.Run, no eval, no hard delay race
            // against the render).
            try { await JS.InvokeVoidAsync("streetsamurai.focusElement", $"beat-{b:N}-edit"); }
            catch { /* JS not loaded yet — focus just won't move; non-fatal */ }
        }
    }

    /// <summary>The beat id whose textarea was just revealed and needs an
    /// initial autosize once the DOM has settled. Set by StartBeatEdit;
    /// cleared by OnAfterRenderAsync after the JS interop call.</summary>
    private Guid? autoSizePendingBeatId;

    /// <summary>Tell the textarea for this beat to shrink/grow its height
    /// to match its content. Called on every input + once when edit mode
    /// opens. JS interop is wrapped in try/catch so we don't bubble up
    /// when the script hasn't loaded yet (cold-start race).</summary>
    private async Task AutoSizeTextareaAsync(Guid beatId)
    {
        var elementId = $"beat-{beatId:N}-edit";
        try { await JS.InvokeVoidAsync("streetsamurai.autoSizeTextarea", elementId); }
        catch { /* JS not yet loaded — initial autosize will fire on first input instead */ }
    }

    private async Task LoadAsync()
    {
        loading = true;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (Guid.TryParse(IdOrSlug, out var guid))
                strand = await db.Strands.FirstOrDefaultAsync(s => s.Id == guid);
            if (strand == null)
                strand = await db.Strands.FirstOrDefaultAsync(s => s.Slug == IdOrSlug);

            if (strand != null)
            {
                strandLoadedUpdatedAt = strand.UpdatedAt;
                if (string.IsNullOrEmpty(strand.VoiceId)) strand.VoiceId = defaultVoiceId;
                beats = await Workbench.GetOrderedBeatsAsync(strand.Id);

                // Surface the saved listening position so the user can jump back
                // to where they walked away. Cleared from the banner if the beat
                // no longer exists (deleted between sessions).
                resumeBeatId = strand.LastPlayedBeatId;

                // Walk ancestors (root first) and load direct children.
                ancestors = await LoadAncestorsAsync(db, strand.ParentStrandId);
                children = await db.Strands.AsNoTracking()
                    .Where(s => s.ParentStrandId == strand.Id)
                    .OrderBy(s => s.SortKey)
                    .ToListAsync();

                if (strand.Status is "narrating" or "generating")
                    StartPolling();
            }
        }
        catch (Exception ex)
        {
            // Surface load failure (cycle in a corrupted parent chain,
            // transient DB blip) instead of stranding the user on a
            // perpetual spinner. strand stays null → the "No strand found"
            // alert renders.
            Toast.Error("STRAND-LOAD-FAIL", ex.Message);
            Console.Error.WriteLine($"[strand-load] {IdOrSlug}: {ex}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private static async Task<List<StrandEntity>> LoadAncestorsAsync(StreetSamuraiDbContext db, Guid? parentId)
    {
        var chain = new List<StrandEntity>();
        var visited = new HashSet<Guid>();
        var current = parentId;
        // Same cycle guard the workbench uses for beat traversal — a
        // corrupted parent loop shouldn't hang the page.
        while (current is { } id && visited.Add(id))
        {
            var p = await db.Strands.AsNoTracking().FirstOrDefaultAsync(s => s.Id == id);
            if (p == null) break;
            chain.Insert(0, p);
            current = p.ParentStrandId;
        }
        return chain;
    }

    private void StartPolling()
    {
        poll?.Dispose();
        poll = new System.Threading.Timer(async _ =>
        {
            // Defensive try/catch: a transient DB disconnect on the timer
            // thread used to crash silently in unobserved-exception land
            // and the UI would freeze on "narrating" forever. Now we log
            // and keep ticking — the next interval gets a fresh attempt.
            try
            {
                if (strand == null) return;
                await using var db = await DbFactory.CreateDbContextAsync();
                var fresh = await db.Strands.AsNoTracking().FirstOrDefaultAsync(s => s.Id == strand.Id);
                if (fresh == null) return;
                strand.Status = fresh.Status;
                strand.CombinedAudioPath = fresh.CombinedAudioPath;
                strand.CharsNarrated = fresh.CharsNarrated;
                beats = await Workbench.GetOrderedBeatsAsync(strand.Id);
                await InvokeAsync(StateHasChanged);
                if (strand.Status is "ready" or "failed" or "stopped")
                {
                    poll?.Dispose();
                    poll = null;
                }
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[strand-poll] tick failed for {strand?.Id}: {ex.Message}");
            }
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(3));
    }

    private async Task SaveStrandHeaderAsync()
    {
        if (strand == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var s = await db.Strands.FirstOrDefaultAsync(x => x.Id == strand.Id);
        if (s == null) return;
        // Optimistic concurrency: refuse to write if the strand's UpdatedAt
        // moved between LoadAsync and now (another tab / MCP tool wrote in
        // between). Without this check, the last-saver silently wins and
        // the first-saver's edit vanishes with no signal.
        if (strandLoadedUpdatedAt is { } expected
            && Math.Abs((s.UpdatedAt - expected).TotalMilliseconds) > 1)
        {
            Toast.Error("STRAND-CONFLICT", "Another change landed since you opened the page — reload and re-apply.");
            return;
        }
        s.Title = strand.Title;
        s.Synopsis = strand.Synopsis;
        s.VoiceId = strand.VoiceId;
        s.UpdatedAt = DateTime.UtcNow;
        await db.SaveChangesAsync();
        strandLoadedUpdatedAt = s.UpdatedAt;
    }

    private void StartBeatEdit(BeatEntity b)
    {
        editingBeatId = b.Id;
        editingText = b.Text ?? "";
        editingOriginalUpdatedAt = b.UpdatedAt;
        // Flag so OnAfterRenderAsync sizes the new textarea to content
        // height AND focuses it once the DOM exists. The focus call used
        // to ride a Task.Run + Task.Delay(50) + JS eval() — racy with
        // OnAfterRenderAsync and CSP-hostile — now both happen together
        // on the circuit at the right moment.
        autoSizePendingBeatId = b.Id;
    }

    private void CancelBeatEdit()
    {
        editingBeatId = null;
        editingText = "";
        editingOriginalUpdatedAt = null;
    }

    private void ToggleMeta(Guid beatId)
    {
        if (metaOpenBeatId == beatId)
        {
            metaOpenBeatId = null;
            return;
        }
        var beat = beats.FirstOrDefault(b => b.Beat.Id == beatId)?.Beat;
        if (beat == null) return;
        metaForm = new MetaForm
        {
            BeatTitle      = beat.BeatTitle ?? "",
            Synopsis       = beat.Synopsis ?? "",
            EmotionalTone  = beat.EmotionalTone ?? "",
            PaceHint       = beat.PaceHint ?? "",
            FacetTag       = beat.FacetTag ?? "",
            StructureRole  = beat.StructureRole ?? "",
            Act            = beat.Act,
            SceneType      = string.IsNullOrEmpty(beat.SceneType) ? "scene" : beat.SceneType,
            IsChapterStart = beat.IsChapterStart,
            Kind           = string.IsNullOrEmpty(beat.Kind) ? "prose" : beat.Kind,
        };
        metaOpenBeatId = beatId;
    }

    private void CancelMeta() => metaOpenBeatId = null;

    private async Task SaveMetaAsync(Guid beatId)
    {
        if (working) return;
        working = true;
        StateHasChanged();
        try
        {
            await Workbench.UpdateBeatMetadataAsync(beatId, new StrandWorkbenchService.BeatMetadataUpdate(
                BeatTitle:      metaForm.BeatTitle,
                Synopsis:       metaForm.Synopsis,
                EmotionalTone:  metaForm.EmotionalTone,
                PaceHint:       metaForm.PaceHint,
                FacetTag:       metaForm.FacetTag,
                StructureRole:  metaForm.StructureRole,
                Act:            metaForm.Act,
                SceneType:      metaForm.SceneType,
                IsChapterStart: metaForm.IsChapterStart,
                Kind:           metaForm.Kind));
            await ReloadBeatsAsync();
            metaOpenBeatId = null;
            Toast.Success("BEAT-META", "Beat details saved. Re-record this beat to apply the new tone.");
        }
        catch (Exception ex) { Toast.Error("BEAT-META-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    /// <summary>Local working copy of the meta editor's bound values. Kept
    /// separate from the beat row so cancel / close discards pending
    /// changes without touching the DB.</summary>
    private class MetaForm
    {
        public string BeatTitle { get; set; } = "";
        public string Synopsis { get; set; } = "";
        public string EmotionalTone { get; set; } = "";
        public string PaceHint { get; set; } = "";
        public string FacetTag { get; set; } = "";
        public string StructureRole { get; set; } = "";
        public int Act { get; set; }
        public string SceneType { get; set; } = "scene";
        public bool IsChapterStart { get; set; }
        public string Kind { get; set; } = "prose";
    }

    private async Task OnEditorKeydown(KeyboardEventArgs e, Guid beatId)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)) await SaveBeatEditAsync(beatId);
        else if (e.Key == "Escape") CancelBeatEdit();
    }

    private async Task SaveBeatEditAsync(Guid beatId)
    {
        if (strand == null || savingEdit) return;
        savingEdit = true;
        StateHasChanged();
        try
        {
            await Workbench.UpdateBeatTextAsync(beatId, editingText, editingOriginalUpdatedAt);
            await ReloadBeatsAsync();
            editingBeatId = null;
            editingText = "";
            editingOriginalUpdatedAt = null;
            Toast.Success("BEAT-EDIT", "Beat updated; audio invalidated.");
        }
        catch (BeatConflictException conflict)
        {
            // Surface a clear "another tab edited this" choice. Reloads the
            // beats so the user sees the current canonical text, and keeps
            // their edited text in the textarea so they can copy what they
            // wanted to keep before re-applying. No silent clobber.
            await ReloadBeatsAsync();
            editingOriginalUpdatedAt = conflict.CurrentUpdatedAt;
            Toast.Error("BEAT-CONFLICT", "Beat was modified elsewhere. The latest text is shown — review and re-save to apply your change over it.");
        }
        catch (Exception ex) { Toast.Error("BEAT-EDIT-FAIL", ex.Message); }
        finally { savingEdit = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task InsertBeatAsync(Guid? afterBeatId)
    {
        if (strand == null || working) return;
        working = true;
        StateHasChanged();
        try
        {
            var newBeat = await Workbench.InsertBeatAsync(strand.Id, afterBeatId, "");
            await ReloadBeatsAsync();
            StartBeatEdit(newBeat);
            Toast.Success("INSERT", afterBeatId == null ? "Beat inserted at top." : "Beat inserted.");
        }
        catch (Exception ex) { Toast.Error("INSERT-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    // Split / Join were removed from the writer surface — the user does that
    // manipulation manually (paste a new beat in, delete the old one). The
    // SplitBeatAsync / JoinBeatWithPreviousAsync methods are still on the
    // workbench service and the StrandTools MCP layer for programmatic
    // callers (LLM clients, CLI scripts). See Strand.razor history before
    // 2026-05-23 for the UI wrappers if they need to come back.


    private void RequestDeleteAsync(Guid beatId)
    {
        // Escape handler is installed once on first render via
        // streetsamurai.installPageEscape and torn down in Dispose. No
        // per-modal re-wiring required.
        pendingDelete = beatId;
    }
    private void CancelDelete() => pendingDelete = null;

    private async Task ConfirmDeleteAsync()
    {
        if (strand == null || pendingDelete == null) return;
        var bid = pendingDelete.Value;
        pendingDelete = null;
        working = true;
        StateHasChanged();
        try
        {
            await Workbench.DeleteBeatAsync(strand.Id, bid);
            await ReloadBeatsAsync();
            Toast.Success("DELETE", "Beat removed.");
        }
        catch (Exception ex) { Toast.Error("DELETE-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task NarrateAsync()
    {
        if (strand == null || working) return;
        working = true;
        StateHasChanged();
        try
        {
            FireNarrationInBackground(strand.Id);
            await Task.Delay(250);
            await ReloadBeatsAsync();
            StartPolling();
            Toast.Success("REC", "Narration started.");
        }
        catch (Exception ex) { Toast.Error("REC-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task ReRecordAllAsync()
    {
        if (strand == null || working) return;
        working = true;
        StateHasChanged();
        try
        {
            foreach (var entry in beats)
                await Workbench.InvalidateBeatAudioAsync(entry.Beat.Id);
            FireNarrationInBackground(strand.Id);
            await ReloadBeatsAsync();
            StartPolling();
            Toast.Success("RE-REC-ALL", "Re-recording from scratch.");
        }
        catch (Exception ex) { Toast.Error("RE-REC-ALL-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task RerecordOneAsync(Guid beatId)
    {
        if (strand == null || working) return;
        working = true;
        StateHasChanged();
        try
        {
            await Workbench.InvalidateBeatAudioAsync(beatId);
            FireNarrationInBackground(strand.Id);
            await ReloadBeatsAsync();
            StartPolling();
            Toast.Success("BEAT-RE-REC", "Re-recording this beat…");
        }
        catch (Exception ex) { Toast.Error("BEAT-RE-REC-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    // Outer try/catch on the fire-and-forget Task. NarrateAsync also has a
    // top-level catch that flips the strand status to "failed" before
    // re-throwing nothing — this is the belt-and-braces log if anything
    // escapes that boundary so the unobserved-task channel doesn't swallow
    // it silently.
    private void FireNarrationInBackground(Guid strandId)
    {
        _ = Task.Run(async () =>
        {
            try { await Workbench.NarrateAsync(strandId); }
            catch (Exception ex)
            {
                Log.LogError(ex, "Background narration crashed for strand {S}", strandId);
            }
        });
    }

    /// <summary>Copy this beat's prose to the system clipboard so the user can
    /// paste it into a chat / CLI / external editor. Flashes the chip green
    /// for ~1.4s as visual confirmation.</summary>
    private async Task CopyBeatTextAsync(Guid beatId)
    {
        var beat = beats.FirstOrDefault(o => o.Beat.Id == beatId)?.Beat;
        if (beat == null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", beat.Text ?? "");
            copiedTextBeatId = beatId;
            StateHasChanged();
            _ = Task.Run(async () =>
            {
                await Task.Delay(1400);
                if (copiedTextBeatId == beatId)
                {
                    copiedTextBeatId = null;
                    await InvokeAsync(StateHasChanged);
                }
            });
        }
        catch (Exception ex) { Toast.Error("COPY-FAIL", ex.Message); }
    }

    // The standalone "copy id" button on the beat-actions row was removed
    // in the 2026-05-23 redesign. The strand-guid.beat-guid handle is now
    // copied from the LLM bottom sheet's header via CopyLlmSheetRefAsync.

    // ── Multi-select + Play selected ─────────────────────────────────────

    private void ToggleBeatSelection(Guid beatId, bool isChecked)
    {
        if (isChecked) selectedBeats.Add(beatId);
        else selectedBeats.Remove(beatId);
        StateHasChanged();
    }

    private void ClearSelection()
    {
        selectedBeats.Clear();
        StateHasChanged();
    }

    /// <summary>Stream the selected beats in reading order with the
    /// computed inter-beat silence between them. The browser plays them
    /// sequentially via a JS helper that chains HTMLAudioElement playback
    /// with setTimeout pauses. Voice consistency is automatic — every
    /// beat's audio was rendered under the active VoiceProfile already.</summary>
    private async Task PlaySelectedAsync()
    {
        if (selectedBeats.Count == 0 || strand == null) return;

        // Walk beats in reading order so the selection always plays in
        // narrative sequence, regardless of the order the user clicked.
        var selectedInOrder = beats.Where(o => selectedBeats.Contains(o.Beat.Id)).ToList();
        if (selectedInOrder.Count == 0) return;

        var withAudio = selectedInOrder.Where(o => !string.IsNullOrEmpty(o.Beat.AudioPath)).ToList();
        if (withAudio.Count == 0)
        {
            Toast.Warning("PLAY-EMPTY", "None of the selected beats have audio yet. Record them first.");
            return;
        }
        if (withAudio.Count < selectedInOrder.Count)
            Toast.Info("PLAY-PARTIAL", $"{selectedInOrder.Count - withAudio.Count} selected beat(s) skipped — no audio recorded yet.");

        // Build the play list: alternating audioUrl + pauseMs entries.
        // The last pause is 0 (playback ends after final beat). Each entry
        // also carries beatId so the JS player can fire OnBeatStarted back
        // into Blazor for the resume-from-here marker.
        var items = new List<object>();
        for (int i = 0; i < withAudio.Count; i++)
        {
            var b = withAudio[i].Beat;
            var pauseMs = 0;
            if (i < withAudio.Count - 1)
            {
                var next = withAudio[i + 1].Beat;
                pauseMs = b.GapAfterMs ?? ComputeAutoGapMs(b, next);
            }
            items.Add(new
            {
                audioUrl = $"/api/strands/{strand.Id}/beat/{b.Id}/audio",
                pauseMs,
                beatId   = b.Id.ToString(),
            });
        }

        try
        {
            isPlayingSequence = true;
            StateHasChanged();
            selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("streetsamurai.playBeatsInSequence", (object)items, selfRef);
        }
        catch (Exception ex) { Toast.Error("PLAY-FAIL", ex.Message); }
        finally
        {
            isPlayingSequence = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Interrupt the currently-running play sequence. The JS helper
    /// pauses any active audio element and clears the pending silence
    /// timeout; the foreground PlaySelectedAsync task unwinds in its
    /// finally block.</summary>
    private async Task StopPlayingAsync()
    {
        try { await JS.InvokeVoidAsync("streetsamurai.stopSequence"); }
        catch (Exception ex) { Toast.Error("STOP-FAIL", ex.Message); }
    }

    // ── Live Broadcast ────────────────────────────────────────────────────
    // Tell the story live: play beat-by-beat while a look-ahead buffer renders
    // a few beats ahead of the cursor. Beats beyond the buffer stay un-rendered,
    // so editing one before the cursor reaches it is voiced fresh on arrival —
    // active listening for active writing.

    /// <summary>In-flight per-beat render tasks, keyed by beat id, so the main
    /// loop and the look-ahead warm-up never double-render (and double-bill)
    /// the same beat. Completed entries are replaced on the next request, which
    /// is how an edited (stale) beat gets re-voiced.</summary>
    private readonly Dictionary<Guid, Task<bool>> broadcastRenders = new();

    private Task<bool> EnsureBeatRenderedAsync(Guid beatId, CancellationToken ct)
    {
        lock (broadcastRenders)
        {
            if (broadcastRenders.TryGetValue(beatId, out var existing) && !existing.IsCompleted)
                return existing;
            var t = RenderOneBeatAsync(beatId, ct);
            broadcastRenders[beatId] = t;
            return t;
        }
    }

    private async Task<bool> RenderOneBeatAsync(Guid beatId, CancellationToken ct)
    {
        if (strand == null) return false;
        var ok = await Workbench.NarrateBeatAsync(strand.Id, beatId, force: false, ct);
        if (ok)
        {
            // Refresh the in-memory beat's audio fields so the cache-bust URL
            // points at the freshly-written bytes (re-render after an edit).
            await using var db = await DbFactory.CreateDbContextAsync(ct);
            var fresh = await db.Beats.AsNoTracking().FirstOrDefaultAsync(b => b.Id == beatId, ct);
            var local = beats.FirstOrDefault(o => o.Beat.Id == beatId)?.Beat;
            if (fresh != null && local != null)
            {
                local.AudioPath  = fresh.AudioPath;
                local.Stale      = fresh.Stale;
                local.NarratedAt = fresh.NarratedAt;
                local.DurationSec = fresh.DurationSec;
                local.TextHash   = fresh.TextHash;
            }
        }
        return ok;
    }

    private async Task StartBroadcastAsync()
    {
        if (strand == null || broadcasting || beats.Count == 0) return;

        // Don't let the selection player and the broadcast fight over audio.
        if (isPlayingSequence)
        {
            try { await JS.InvokeVoidAsync("streetsamurai.stopSequence"); } catch { }
            isPlayingSequence = false;
        }

        broadcasting = true;
        broadcastCts = new CancellationTokenSource();
        var ct = broadcastCts.Token;
        selfRef ??= DotNetObjectReference.Create(this);
        lock (broadcastRenders) broadcastRenders.Clear();
        StateHasChanged();

        try
        {
            for (int i = 0; i < beats.Count; i++)
            {
                ct.ThrowIfCancellationRequested();
                if (i >= beats.Count) break; // list may have shrunk mid-air

                var current = beats[i].Beat;
                broadcastBeatId = current.Id;
                await InvokeAsync(StateHasChanged);
                try { await JS.InvokeVoidAsync("streetsamurai.scrollBeatIntoView", current.Id.ToString()); } catch { }

                // Voice THIS beat for its current text (re-renders if it was
                // edited while we waited). Usually already warm from look-ahead.
                var ok = await EnsureBeatRenderedAsync(current.Id, ct);

                // Warm the look-ahead window in the background so rendering
                // overlaps with playback rather than stalling at each seam.
                for (int j = i + 1; j <= i + BroadcastBufferAhead && j < beats.Count; j++)
                    _ = EnsureBeatRenderedAsync(beats[j].Beat.Id, ct);

                if (!ok)
                {
                    Toast.Warning("BROADCAST-SKIP", $"Beat #{i + 1} couldn't be voiced — skipping it.");
                    continue;
                }

                // Play the beat and await its end. stopClip resolves the promise
                // on cancel so this await unwinds and the loop sees the token.
                try { await JS.InvokeVoidAsync("streetsamurai.playClip", BeatAudioUrl(current)); }
                catch { /* clip error — keep the broadcast moving */ }

                ct.ThrowIfCancellationRequested();

                if (i < beats.Count - 1)
                {
                    var gap = current.GapAfterMs ?? ComputeAutoGapMs(current, beats[i + 1].Beat);
                    if (gap > 0) await Task.Delay(gap, ct);
                }
            }
            if (!ct.IsCancellationRequested)
                Toast.Success("BROADCAST", "Broadcast reached the end of the strand.");
        }
        catch (OperationCanceledException) { /* user hit Stop */ }
        catch (Exception ex) { Toast.Error("BROADCAST-FAIL", ex.Message); }
        finally
        {
            broadcasting = false;
            broadcastBeatId = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StopBroadcastAsync()
    {
        try { broadcastCts?.Cancel(); } catch { }
        try { await JS.InvokeVoidAsync("streetsamurai.stopClip"); } catch { }
    }

    private string BeatAudioUrl(BeatEntity b)
    {
        // Cache-bust on NarratedAt so a re-recorded beat isn't served stale.
        var bust = (b.NarratedAt ?? b.UpdatedAt).Ticks;
        return $"/api/strands/{strand!.Id}/beat/{b.Id}/audio?v={bust}";
    }

    // ── Gap-after-beat editor ─────────────────────────────────────────────
    // Each beat owns the silence that follows it (Beat.GapAfterMs). Null =
    // use the computed default; a value (incl. 0) is an explicit override.

    /// <summary>Auto-computed ms the server-side engine would use as the gap
    /// after <paramref name="above"/>, before <paramref name="below"/>.</summary>
    private int ComputeAutoGapMs(BeatEntity above, BeatEntity? below)
        => StrandWorkbenchService.ComputeTrailingSilenceMs(above, below, Settings);

    private void OnGapEditorKeydown(KeyboardEventArgs e, Guid beatId, string editorId)
    {
        if (e.Key == "Enter") { _ = SaveGapAfterFromInputAsync(beatId, editorId); }
    }

    private async Task SaveGapAfterFromInputAsync(Guid beatId, string editorId)
    {
        try
        {
            var raw = await JS.InvokeAsync<string>("streetsamurai.readInput", editorId);
            if (!int.TryParse(raw, out var ms)) return;
            ms = Math.Clamp(ms, 0, 6000);
            await Workbench.SetGapAfterAsync(beatId, ms);
            // Reflect in the in-memory list so the chip updates without a full reload.
            var entry = beats.FirstOrDefault(x => x.Beat.Id == beatId);
            if (entry != null) entry.Beat.GapAfterMs = ms;
            Toast.Success("GAP", $"Gap after this beat → {ms} ms.");
            StateHasChanged();
        }
        catch (Exception ex) { Toast.Error("GAP-FAIL", ex.Message); }
    }

    /// <summary>Wrap the current textarea selection in the given markdown
    /// marker via JS interop. The wrap helper also dispatches an 'input'
    /// event so Blazor's @bind picks up the new value without waiting for
    /// blur. Buttons are disabled outside edit mode, so this is a no-op
    /// when the textarea isn't present.</summary>
    private async Task WrapFormatAsync(Guid beatId, string marker)
    {
        var elementId = $"beat-{beatId:N}-edit";
        try { await JS.InvokeVoidAsync("streetsamurai.wrapSelection", elementId, marker); }
        catch (Exception ex) { Toast.Error("FORMAT-FAIL", ex.Message); }
    }

    private async Task ResetGapAfterAsync(Guid beatId)
    {
        try
        {
            await Workbench.ClearGapAfterAsync(beatId);
            var entry = beats.FirstOrDefault(x => x.Beat.Id == beatId);
            if (entry != null) { entry.Beat.GapAfterMs = null; entry.Beat.GapAfterAudioPath = null; }
            Toast.Info("GAP-RESET", "Reset to auto pause.");
            StateHasChanged();
        }
        catch (Exception ex) { Toast.Error("GAP-RESET-FAIL", ex.Message); }
    }

    // ── LLM bottom sheet ──────────────────────────────────────────────────
    // Free-text instruction → calls ILlmService.GenerateAsync with the beat
    // text + neighbour context → previews the proposal → user picks Apply
    // (replaces beat.Text) or Discard.

    private void OpenLlmSheet(BeatEntity b)
    {
        llmSheetBeat = b;
        llmSheetBeatPosition = beats.FindIndex(x => x.Beat.Id == b.Id) + 1;
        llmSheetRefText = strand != null ? $"{strand.Id}.{b.Id}" : b.Id.ToString();
        llmSheetInstruction = "";
        llmSheetProposal = "";
        llmSheetRunning = false;
        llmSheetIdCopied = false;
    }

    private void CloseLlmSheet()
    {
        llmSheetBeat = null;
        llmSheetInstruction = "";
        llmSheetProposal = "";
        llmSheetRefText = "";
        llmSheetIdCopied = false;
    }

    private async Task CopyLlmSheetRefAsync()
    {
        if (string.IsNullOrEmpty(llmSheetRefText)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", llmSheetRefText);
            llmSheetIdCopied = true;
            StateHasChanged();
            await Task.Delay(1200);
            llmSheetIdCopied = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { Toast.Error("COPY-FAIL", ex.Message); }
    }

    private void DiscardLlmSheetProposal()
    {
        llmSheetProposal = "";
    }

    private async Task RunLlmSheetAsync()
    {
        if (llmSheetBeat == null || string.IsNullOrWhiteSpace(llmSheetInstruction) || llmSheetRunning) return;
        llmSheetRunning = true;
        llmSheetProposal = "";
        StateHasChanged();
        try
        {
            var system = "You are an assistant rewriting a single beat of prose for a noir/cyberpunk narrative. " +
                         "Return ONLY the rewritten beat text — no preamble, no commentary, no quotes around it. " +
                         "Preserve the beat's voice and tense unless the instruction says otherwise.";
            var strandTitle = strand?.Title ?? "(unknown strand)";
            var user =
                $"STRAND: {strandTitle}\n" +
                $"REFERENCE: {llmSheetRefText}    (CLI handle: strand-guid.beat-guid)\n" +
                $"POSITION: Beat #{llmSheetBeatPosition} in this strand\n\n" +
                $"INSTRUCTION:\n{llmSheetInstruction.Trim()}\n\n" +
                $"CURRENT BEAT TEXT:\n{llmSheetBeat.Text}";
            var raw = await Llm.GenerateAsync(system, user, temperature: 0.7, maxTokens: 1500);
            llmSheetProposal = (raw ?? "").Trim();
            if (string.IsNullOrEmpty(llmSheetProposal))
                Toast.Info("LLM", "Empty response — try a different instruction.");
        }
        catch (Exception ex)
        {
            Toast.Error("LLM-FAIL", ex.Message);
        }
        finally
        {
            llmSheetRunning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyLlmSheetAsync()
    {
        if (llmSheetBeat == null || string.IsNullOrEmpty(llmSheetProposal)) return;
        var beatId = llmSheetBeat.Id;
        try
        {
            await Workbench.UpdateBeatTextAsync(beatId, llmSheetProposal, expectedUpdatedAt: llmSheetBeat.UpdatedAt);
            llmSheetBeat.Text = llmSheetProposal;
            llmSheetBeat.UpdatedAt = DateTime.UtcNow;
            Toast.Success("LLM", "Beat rewritten — audio invalidated; re-record to refresh.");
            CloseLlmSheet();
            await ReloadBeatsAsync();
        }
        catch (Exception ex)
        {
            Toast.Error("LLM-APPLY-FAIL", ex.Message);
        }
    }

    private async Task ExportCombinedAsync()
    {
        if (strand == null || working) return;
        working = true;
        StateHasChanged();
        try
        {
            var path = await Workbench.ExportCombinedAsync(strand.Id);
            await ReloadBeatsAsync();
            if (path == null) Toast.Info("PUBLISH", "Nothing to publish yet — record every beat first.");
            else Toast.Success("PUBLISH", "Published — single sound file written. Use Download to save it.");
        }
        catch (Exception ex) { Toast.Error("PUBLISH-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task StopAsync()
    {
        if (strand == null) return;
        if (Workbench.CancelNarration(strand.Id))
        {
            Toast.Info("STOP", "Narration cancelled.");
            await ReloadBeatsAsync();
        }
    }

    private async Task ReloadBeatsAsync()
    {
        if (strand == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var fresh = await db.Strands.AsNoTracking().FirstOrDefaultAsync(s => s.Id == strand.Id);
        if (fresh != null)
        {
            strand.Status = fresh.Status;
            strand.CombinedAudioPath = fresh.CombinedAudioPath;
            strand.CharsNarrated = fresh.CharsNarrated;
        }
        beats = await Workbench.GetOrderedBeatsAsync(strand.Id);
    }

    /// <summary>Build the combined-audio URL with a cache-bust query string.
    /// Without the bust, re-stitching a strand writes new bytes to the same
    /// URL — browsers serve the stale cached version until the page is
    /// hard-reloaded. AudioCompletedAt ticks change on every successful
    /// re-narrate, so appending them invalidates the browser cache cleanly.</summary>
    private string CombinedAudioUrl()
    {
        if (strand == null) return "";
        var bust = strand.AudioCompletedAt?.Ticks.ToString() ?? strand.UpdatedAt.Ticks.ToString();
        return $"/api/strands/{strand.Id}/strand.wav?v={bust}";
    }

    private static string StatusColor(string status) => StrandWorkbenchService.StatusColor(status);
    private static string StatusLabel(string status) => StrandWorkbenchService.StatusLabel(status);

    private static string FormatDuration(double sec)
    {
        var ts = TimeSpan.FromSeconds(sec);
        return ts.TotalMinutes >= 1 ? $"{(int)ts.TotalMinutes}:{ts.Seconds:D2}" : $"{ts.TotalSeconds:0.0}s";
    }

    /// <summary>Called from JS as each beat in a play-selected sequence
    /// begins. Persists Strand.LastPlayedBeatId so the resume banner shows
    /// up next time the strand loads. Fire-and-forget; failures don't
    /// interrupt playback.
    ///
    /// Coalesced: a fast playback of 50 beats would otherwise trigger 50
    /// UPDATEs against Strands. We compare against the in-memory
    /// <c>resumeBeatId</c> first so duplicate "still on the same beat"
    /// callbacks (paused/resumed without advancing, double-fire from the
    /// audio element's events) are a no-op.</summary>
    [JSInvokable]
    public async Task OnBeatStarted(string beatIdString)
    {
        if (strand == null || !Guid.TryParse(beatIdString, out var bid)) return;
        // Already recorded — skip the round-trip. resumeBeatId tracks the
        // in-memory equivalent of Strands.LastPlayedBeatId so a stable read
        // means a stable write too.
        if (resumeBeatId == bid) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.Strands.FirstOrDefaultAsync(s => s.Id == strand.Id);
            if (row == null) return;
            row.LastPlayedBeatId = bid;
            row.LastPlayedSec    = 0; // resume granularity is per-beat for now
            row.UpdatedAt        = DateTime.UtcNow;
            await db.SaveChangesAsync();
            resumeBeatId = bid;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { Console.Error.WriteLine($"[strand-resume] save failed: {ex.Message}"); }
    }

    /// <summary>Called from JS when the user attempted to drop a beat onto
    /// a row in a different strand. Re-parenting across strands isn't
    /// supported by MoveBeatAsync today — surface a clear toast instead of
    /// the silent no-op the user would otherwise see.</summary>
    [JSInvokable]
    public Task OnCrossStrandDropRejected()
    {
        Toast.Warning("MOVE", "Cross-strand reorder isn't supported yet — drag only works within one strand.");
        return Task.CompletedTask;
    }

    /// <summary>Called from JS when the user drops a beat row onto another.
    /// Routes through Workbench.MoveBeatAsync which only mutates the
    /// fractional SortKey — audio stays valid.</summary>
    [JSInvokable]
    public async Task OnBeatDropped(string draggedIdString, string targetIdString)
    {
        if (strand == null) return;
        if (!Guid.TryParse(draggedIdString, out var dragged) || !Guid.TryParse(targetIdString, out var target)) return;
        if (dragged == target) return;
        try
        {
            // Drop-target semantics: the dragged beat lands AFTER the row
            // it was dropped on. Dropping onto the first row therefore moves
            // the beat to position 2; use "insert at top" affordance for
            // position 1 (drag onto self is rejected by the workbench).
            await Workbench.MoveBeatAsync(strand.Id, dragged, target);
            await ReloadBeatsAsync();
            await InvokeAsync(StateHasChanged);
            Toast.Success("MOVE", "Beat reordered.");
        }
        catch (Exception ex) { Toast.Error("MOVE-FAIL", ex.Message); }
    }

    /// <summary>Scroll to the saved resume beat. Smooth-scroll via JS; the
    /// row's .resume-here class gives the visual landing point.</summary>
    private async Task ScrollToResumeAsync()
    {
        if (!resumeBeatId.HasValue) return;
        try { await JS.InvokeVoidAsync("streetsamurai.scrollBeatIntoView", resumeBeatId.Value.ToString()); }
        catch { /* JS race — banner stays visible, user can click again */ }
    }

    /// <summary>Forget the saved listening position. Updates the strand row
    /// AND the in-memory resume marker so the banner disappears immediately.</summary>
    private async Task ClearResumeAsync()
    {
        if (strand == null) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.Strands.FirstOrDefaultAsync(s => s.Id == strand.Id);
            if (row != null)
            {
                row.LastPlayedBeatId = null;
                row.LastPlayedSec    = null;
                row.UpdatedAt        = DateTime.UtcNow;
                await db.SaveChangesAsync();
            }
            resumeBeatId = null;
            StateHasChanged();
        }
        catch (Exception ex) { Toast.Error("RESUME-CLEAR-FAIL", ex.Message); }
    }

    public void Dispose()
    {
        poll?.Dispose();
        // Stop any live broadcast so its render/play loop doesn't keep running
        // after the user navigates away.
        try { broadcastCts?.Cancel(); } catch { }
        broadcastCts?.Dispose();
        // Best-effort JS teardown — page is unloading, so a fire-and-forget
        // is fine. Don't await; the framework expects Dispose to be sync.
        if (!string.IsNullOrEmpty(escapeToken))
        {
            try { _ = JS.InvokeVoidAsync("streetsamurai.uninstallPageEscape", escapeToken); }
            catch { /* circuit may already be torn down */ }
        }
        try { _ = JS.InvokeVoidAsync("streetsamurai.stopClip"); } catch { /* circuit may be gone */ }
        selfRef?.Dispose();
    }
}
