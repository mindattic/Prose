@page "/strand/{IdOrSlug}"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@using Microsoft.EntityFrameworkCore
@using StreetSamurai.Core.Data
@using StreetSamurai.Core.Data.Entities
@using StreetSamurai.Core.Services
@using StreetSamurai.Shared.Services
@using StrandEntity = StreetSamurai.Core.Data.Entities.Strand
@using BeatEntity = StreetSamurai.Core.Data.Entities.Beat
@using MindAttic.Legion
@inject IDbContextFactory<StreetSamuraiDbContext> DbFactory
@inject StrandWorkbenchService Workbench
@inject ElevenLabsTtsService Tts
@inject SettingsService Settings
@inject NavigationManager Nav
@inject ToastNotifier Toast
@inject IJSRuntime JS
@inject StreetSamurai.Core.Interfaces.ILlmService Llm
@inject ILogger<Strand> Log
@inject DocxExportService Docx
@inject ManuscriptExportService Manuscript
@implements IDisposable

@*
   The unified writer + recorder + listener. One page does everything:
   write, edit, record, add beats (before/after), split, join, re-record,
   delete. /write, /listen, /recordings all funnel here.
*@

<style>
    .strand-shell { max-width: 1040px; }
    .strand-head { position: sticky; top: 0; z-index: 5; background: rgba(15,15,15,0.95); backdrop-filter: blur(6px); border-bottom: 1px solid #2a2a2a; padding: 0.75rem 0; margin-bottom: 1rem; }
    .strand-title { background: transparent; border: none; color: #f8f9fa; font-size: 1.5rem; font-weight: 600; padding: 0; outline: none; }
    .strand-title:focus { box-shadow: none; border-bottom: 2px solid #0dcaf0; }
    .strand-synopsis { background: transparent; border: none; color: #adb5bd; font-size: 0.9rem; resize: none; padding: 0; outline: none; width: 100%; }
    .strand-synopsis:focus { color: #ced4da; }
    .beat-card { background: #161616; border: 1px solid #2a2a2a; border-radius: 8px; padding: 0.65rem 0.9rem; transition: border-color 0.15s ease, box-shadow 0.15s ease; position: relative; }

    /* 3-row layout: header bar (controls), body (prose ↔ textarea), footer
       (gap-after + meta chips). Rows separated by margin only — no borders
       between rows so the card reads as one block. */
    .beat-row-1 { /* spacing handled by .mb-2 on the element */ }
    .beat-row-2 { min-height: 1.55rem; }
    .beat-row-3 { margin-top: 0.5rem; padding-top: 0.4rem; border-top: 1px solid #1f1f1f; }
    /* Row 3 bottom bar: meta chips (left) + gap-after editor (right) in one flex line.
       gap-inline shrinks but won't wrap below the chips unless the card is very narrow. */
    .beat-row-3-bar { gap: 0.5rem; }
    .beat-row-3-bar .beat-meta-chips { margin-top: 0; flex: 1 1 auto; min-width: 0; }
    .beat-row-3-bar .beat-gap-inline { flex: 0 0 auto; }

    /* Inline checkbox replaces the absolute-positioned one. Slightly larger
       hit target so it's easy to click on mobile. */
    .beat-select-box-inline { width: 1rem; height: 1rem; accent-color: #ffc107; cursor: pointer; flex-shrink: 0; }

    /* Format toolbar: tight grouped pill of icon buttons. Disabled state
       dims to ~40% so the writer sees them but doesn't try clicking when
       there's no textarea active. */
    .beat-format-toolbar { display: inline-flex; gap: 0.15rem; margin-left: 0.5rem; padding: 0.1rem 0.25rem; background: rgba(255,255,255,0.02); border: 1px solid #2a2a2a; border-radius: 4px; }
    .beat-format-toolbar .btn { padding: 0.1rem 0.4rem; line-height: 1; font-size: 0.85rem; }
    .beat-format-toolbar .btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .beat-char-count { font-variant-numeric: tabular-nums; }

    /* Tone-tag emoji rendered in the read view. The title attribute holds
       the original bracketed form so a hover reveals the source token. */
    .tone-tag { display: inline-block; padding: 0 0.1em; cursor: help; }
    .tone-tag:hover { filter: brightness(1.15); }

    .beat-card:hover { border-color: #0dcaf0; box-shadow: 0 0 0 1px rgba(13,202,240,0.25); }
    .beat-card.editing { border-color: #0dcaf0; box-shadow: 0 0 0 1px rgba(13,202,240,0.35); }
    .beat-card.selected { border-color: #ffc107; box-shadow: 0 0 0 1px rgba(255,193,7,0.35); }
    .beat-card.resume-here { border-color: #20c997; box-shadow: 0 0 0 1px rgba(32,201,151,0.55), 0 0 22px rgba(32,201,151,0.20); }
    .beat-card.beat-dragging { opacity: 0.5; }
    .beat-card.beat-drop-target { outline: 2px dashed #0dcaf0; outline-offset: 2px; }
    /* Cross-strand drop: highlighted in red so the user sees the drop
       attempt was recognised but rejected (a chapter beat can't be dropped
       on a sibling chapter's beat — reorder is single-strand only). */
    .beat-card.beat-drop-blocked { outline: 2px dashed #dc3545; outline-offset: 2px; cursor: not-allowed; }

    /* Drag handle in the row-1 cluster. Only the handle itself initiates
       a drag — clicking elsewhere in the card still works as before. */
    .beat-drag-handle { cursor: grab; color: #6c757d; padding: 0 0.2rem; user-select: none; }
    .beat-drag-handle:hover { color: #0dcaf0; }
    .beat-drag-handle:active { cursor: grabbing; }
    .resume-banner { background: rgba(32,201,151,0.08); border: 1px solid rgba(32,201,151,0.35); border-radius: 6px; padding: 0.4rem 0.65rem; color: #c8f0e0; font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; }
    .resume-banner .btn { padding: 0.1rem 0.5rem; font-size: 0.75rem; }

    /* Upper-right hover action buttons. Dim at rest (40% opacity) so they don't
       compete with the prose; full opacity when hovering the card, focused
       within it, or when the card is selected/editing. All icon-only with
       Bootstrap btn-outline-* coloring; the .copied state turns the copy-text
       button green via the .btn-outline-secondary.copied override below. */
    .beat-actions { opacity: 0.4; transition: opacity 0.15s ease; }
    .beat-card:hover .beat-actions,
    .beat-card:focus-within .beat-actions,
    .beat-card.selected .beat-actions,
    .beat-card.editing .beat-actions { opacity: 1; }
    .beat-actions .btn { padding: 0.15rem 0.45rem; line-height: 1; }
    /* Thin divider grouping Save/Revert (left) apart from copy/LLM/mic/delete. */
    .beat-action-sep { width: 1px; align-self: stretch; margin: 0.1rem 0.15rem; background: #2a2a2a; }
    /* Copy-guid icon buttons (next to Beat # and the strand title). Muted until hover. */
    .beat-guid-copy, .strand-guid-copy { color: #6c757d; border: none; background: none; line-height: 1; }
    .beat-guid-copy:hover, .strand-guid-copy:hover { color: #0dcaf0; }
    .btn-outline-secondary.copied { color: #75b798; border-color: #198754; background: rgba(25,135,84,0.15); }
    .beat-id-chip { color: #0dcaf0; font-variant-numeric: tabular-nums; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.02em; }

    /* Chapter divider: rendered above any beat with IsChapterStart=true.
       Reads the heading from BeatTitle. Visually announces "new division
       of the prose" without nesting. */
    .beat-chapter-divider { display: flex; align-items: center; gap: 0.75rem; margin: 1.5rem 0 0.6rem; }
    .beat-chapter-line { flex: 1; height: 1px; background: linear-gradient(to right, transparent, #d9a030, transparent); }
    .beat-chapter-label { color: #d9a030; font-family: 'Outfit', sans-serif; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.12em; white-space: nowrap; }

    /* Beat-kind renderings — visual variants of .beat-prose driven by
       Beat.Kind. All still click to edit. */
    .beat-prose-book-title { text-align: center; padding: 1.5rem 0; }
    .beat-prose-book-title .book-title-line { font-family: 'Outfit', sans-serif; font-size: 1.6rem; font-weight: 700; letter-spacing: 0.04em; color: #f8f9fa; }
    .beat-prose-book-title .book-title-byline { font-size: 0.9rem; color: #adb5bd; margin-top: 0.4rem; font-style: italic; }
    .beat-prose-dedication { text-align: center; font-style: italic; color: #ced4da; padding: 0.6rem 1.5rem; }
    .beat-prose-quote { border-left: 3px solid #d9a030; padding: 0.5rem 1rem; margin: 0; background: rgba(217,160,48,0.04); }
    .beat-prose-quote .quote-text { font-style: italic; color: #e6edf3; }
    .beat-prose-quote .quote-attribution { font-size: 0.78rem; color: #adb5bd; margin-top: 0.4rem; text-align: right; }

    /* Chapter index — jump-links to every IsChapterStart beat at the top
       of the strand. Replaces the old child-strand sidebar. */
    .chapter-index { border: 1px solid #2a2a2a; border-radius: 6px; padding: 0.6rem 0.9rem; margin-bottom: 1rem; background: #0f0f0f; }
    .chapter-index-head { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #8b949e; margin-bottom: 0.4rem; }
    .chapter-index-list { display: flex; flex-direction: column; gap: 0.15rem; }
    .chapter-index-link { color: #79d2e8; text-decoration: none; font-size: 0.9rem; padding: 0.15rem 0; }
    .chapter-index-link:hover { color: #f8f9fa; text-decoration: underline; }
    .chapter-index-link .ci-pos { color: #6c757d; font-variant-numeric: tabular-nums; margin-right: 0.5rem; font-size: 0.8rem; }
    .beat-gap-inline { display: inline-flex; gap: 0.4rem; align-items: center; font-size: 0.72rem; color: #adb5bd; }
    .beat-gap-inline.custom { color: #ffc107; }
    .beat-gap-input { width: 70px; background: #161616; color: #f8f9fa; border: 1px solid #2a2a2a; padding: 0 0.3rem; font-size: 0.72rem; border-radius: 3px; }
    .beat-gap-input:focus { outline: none; border-color: #0dcaf0; }
    .beat-gap-inline.custom .beat-gap-input { border-color: rgba(255,193,7,0.5); }

    .selection-bar { position: sticky; bottom: 1rem; z-index: 6; background: rgba(15,15,15,0.95); backdrop-filter: blur(6px); border: 1px solid #ffc107; border-radius: 8px; padding: 0.6rem 0.9rem; display: flex; align-items: center; gap: 0.75rem; margin-top: 1rem; box-shadow: 0 -4px 18px rgba(0,0,0,0.35); }
    .selection-bar .count { color: #ffc107; font-weight: 600; font-size: 0.95rem; }
    .selection-bar .hint { color: #6c757d; font-size: 0.75rem; }
    .beat-card.playing { border-color: #20c997; box-shadow: 0 0 0 1px rgba(32,201,151,0.4), 0 0 18px rgba(32,201,151,0.25); }
    .beat-card.stale { border-left: 3px solid #dc3545; }
    .beat-card.recorded { border-left: 3px solid #198754; }

    /* Live Broadcast cursor: the beat currently on air. Pulsing cyan rail so
       the eye can track the cursor and edit the beats just past it. */
    .beat-card.broadcasting-now {
        border-color: #0dcaf0;
        box-shadow: 0 0 0 1px rgba(13,202,240,0.55), 0 0 26px rgba(13,202,240,0.28);
        animation: broadcast-pulse 1.6s ease-in-out infinite;
    }
    @@keyframes broadcast-pulse {
        0%, 100% { box-shadow: 0 0 0 1px rgba(13,202,240,0.55), 0 0 12px rgba(13,202,240,0.18); }
        50%      { box-shadow: 0 0 0 1px rgba(13,202,240,0.75), 0 0 30px rgba(13,202,240,0.35); }
    }

    /* Publish ring-loader overlay: full-viewport scrim with a clockwise-filling
       cyan ring and the percentage in the middle (capped at 99% while working). */
    .publish-overlay {
        position: fixed; inset: 0; z-index: 1080;
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem;
        background: rgba(0,0,0,0.72); backdrop-filter: blur(3px);
    }
    .publish-ring-wrap { position: relative; width: 180px; height: 180px; }
    /* rotate -90deg so the bar starts at 12 o'clock and fills clockwise */
    .publish-ring { width: 180px; height: 180px; transform: rotate(-90deg); }
    .publish-ring-track { fill: none; stroke: rgba(255,255,255,0.12); stroke-width: 8; }
    .publish-ring-bar {
        fill: none; stroke: #0dcaf0; stroke-width: 8; stroke-linecap: round;
        transition: stroke-dashoffset 0.2s linear;
        filter: drop-shadow(0 0 6px rgba(13,202,240,0.5));
    }
    .publish-ring-center {
        position: absolute; inset: 0;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        color: #fff;
    }
    .publish-pct { font-size: 2.4rem; font-weight: 700; line-height: 1; }
    .publish-pct span { font-size: 1.1rem; opacity: 0.7; margin-left: 2px; }
    .publish-stage { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; opacity: 0.7; margin-top: 0.3rem; }
    .publish-detail { color: #cdd6dd; font-size: 0.9rem; text-align: center; }
    .publish-detail .publish-count { color: #6ee7b7; margin-left: 0.5rem; font-variant-numeric: tabular-nums; }

    /* Read / edit must share the exact same box: same font, line-height,
       padding, border, background. Clicking into edit only swaps the
       displayed content (formatted prose ↔ raw text with tags); the
       container itself doesn't move. */
    .beat-prose,
    .beat-textarea {
        display: block;
        width: 100%;
        margin: 0;
        padding: 0;
        border: none;
        background: transparent;
        color: #e9ecef;
        font-family: inherit;
        font-size: 1rem;
        line-height: 1.55;
        white-space: pre-wrap;
        min-height: 1.55rem;
        cursor: text;
    }
    .beat-prose:hover { color: #f8f9fa; }
    .beat-prose-empty { color: #495057; font-style: italic; }
    .beat-textarea {
        resize: none;            /* no drag handle — sizes by row count */
        outline: none;
        overflow: hidden;        /* row count drives height, no scrollbars */
        box-shadow: none;
    }
    /* Focus indicator: the parent .beat-card.editing already turns its
       border cyan, so a textarea-specific focus rule is redundant and
       would risk shifting the box. Just kill the user-agent outline. */
    .beat-textarea:focus { outline: none; }
    /* Edit textarea sizes to content via JS interop (autoSizeTextarea).
       Min-height matches the prose container so very short beats don't
       collapse below readable size. */
    .beat-textarea { min-height: 1.55rem; }
    /* Save/Cancel render INLINE in the same .beat-actions row that holds
       the read-mode copy/llm/mic/delete buttons — conditional swap, so
       they can never overlap. The absolute-positioned .beat-edit-actions
       overlay is gone. */
    .insert-bar { display: flex; align-items: center; gap: 0.5rem; opacity: 0; transition: opacity 0.15s ease; padding: 0.25rem 0; }
    .insert-bar:hover, .insert-bar:focus-within { opacity: 1; }
    .insert-bar-line { flex-grow: 1; height: 1px; background: #2a2a2a; }
    .beat-meta-chips { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-top: 0.35rem; font-size: 0.7rem; }
    .beat-meta-chip { padding: 0.1rem 0.45rem; border-radius: 10px; background: rgba(13,202,240,0.08); color: #79d2e8; cursor: pointer; }
    .beat-meta-chip.unset { color: #495057; background: transparent; border: 1px dashed #2a2a2a; }
    .beat-meta-chip:hover { background: rgba(13,202,240,0.15); }
    .beat-meta-panel { margin-top: 0.6rem; padding: 0.6rem; background: #0d0d0d; border: 1px solid #2a2a2a; border-radius: 6px; }
    .beat-meta-panel label { color: #adb5bd; font-size: 0.75rem; margin-bottom: 0.15rem; }
    .beat-meta-panel select, .beat-meta-panel input { background: #0a0a0a; border: 1px solid #2a2a2a; color: #f8f9fa; font-size: 0.85rem; }
    .insert-bar-btn { background: transparent; border: 1px dashed #3a3a3a; color: #0dcaf0; font-size: 0.75rem; padding: 0.15rem 0.55rem; border-radius: 12px; cursor: pointer; }
    .insert-bar-btn:hover { background: rgba(13,202,240,0.08); border-color: #0dcaf0; }
    .beat-audio { width: 100%; height: 28px; margin-top: 0.5rem; filter: brightness(0.85); }
    .strand-meta-chip { font-size: 0.7rem; padding: 0.2rem 0.5rem; }
    /* Per-beat version cycler — two arrows that scrub the editor back and
       forth through the beat's system-versioned history. When a past (non-
       current) version is showing, the cluster glows so it's clear the editor
       is previewing history, not the live text. */
    .beat-history-nav.cycling .btn { border-color: #0dcaf0; color: #0dcaf0; }
</style>

@if (loading)
{
    <div class="container py-4 text-muted">
        <div class="spinner-border spinner-border-sm me-2"></div>Loading strand…
    </div>
}
else if (strand == null)
{
    <div class="container py-4">
        <div class="alert alert-warning">No strand found for <code>@IdOrSlug</code>. <a href="/strands">Back to index</a>.</div>
    </div>
}
else
{
    <div class="container strand-shell py-3">
        @if (ancestors.Count > 0)
        {
            <nav aria-label="strand breadcrumb" class="mb-2">
                <ol class="d-flex flex-wrap gap-1 small text-muted mb-0 ps-0" style="list-style:none;">
                    <li><a href="/strands" class="text-decoration-none text-muted">strands</a></li>
                    @foreach (var a in ancestors)
                    {
                        <li>›</li>
                        <li><a href="@($"/strand/{a.Slug}")" class="text-decoration-none text-info">@a.Title</a><span class="text-muted ms-1">(@a.Kind)</span></li>
                    }
                    <li>›</li>
                    <li><span class="text-light">@strand.Title</span></li>
                </ol>
            </nav>
        }
        <div class="strand-head">
            <div class="d-flex align-items-start gap-3">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <span class="badge bg-secondary strand-meta-chip text-uppercase">@strand.Kind</span>
                        <span class="badge bg-@StatusColor(strand.Status) strand-meta-chip text-uppercase">@StatusLabel(strand.Status)</span>
                        @if (strand.Score.HasValue)
                        {
                            <span class="badge bg-@ScorePctColor(strand.Score.Value) strand-meta-chip"
                                  style="cursor:pointer" title="Reader score (latest run) — click for full reviews"
                                  @onclick="OpenStrandReviewsAsync">
                                <i class="bi bi-star-half me-1"></i>@strand.Score.Value.ToString("0")%
                            </span>
                        }
                        @if (TotalChars > 0)
                        {
                            <span class="text-muted small">@TotalChars.ToString("N0") chars</span>
                        }
                    </div>
                    <input class="strand-title w-100" placeholder="Untitled strand"
                           @bind="strand.Title" @bind:event="oninput" @onblur="SaveStrandHeaderAsync" />
                    @* Full GUID — a stable handle for this strand (CLI, conversation). *@
                    <div class="text-muted small mt-1 d-flex align-items-center gap-1">
                        ID: <code class="strand-id-chip" title="Strand id">@strand.Id</code>
                        <button class="btn btn-sm strand-guid-copy p-0" title="Copy strand id to clipboard"
                                @onclick='() => CopyGuidAsync(strand.Id, "Strand id")'>
                            <i class="bi @(copiedGuid == strand.Id ? "bi-check-lg" : "bi-clipboard")"></i>
                        </button>
                    </div>
                    <textarea class="strand-synopsis mt-1" rows="5" placeholder="Synopsis (optional)"
                              style="width:100%; resize:none; overflow-y:auto;"
                              @bind="strand.Synopsis" @bind:event="oninput" @onblur="SaveStrandHeaderAsync"></textarea>
                </div>
                <div style="min-width:200px;">
                    <label class="form-label small text-muted mb-1">Voice</label>
                    <div class="d-flex gap-1">
                        <select class="form-select form-select-sm bg-black text-light border-secondary" @bind="strand.VoiceId" @bind:after="SaveStrandHeaderAsync">
                            @foreach (var v in voices)
                            {
                                <option value="@v.VoiceId">@v.Name</option>
                            }
                        </select>
                        <button class="btn btn-sm btn-outline-info" type="button" @onclick="() => showVoiceStudio = !showVoiceStudio"
                                title="Open the Voice Studio — pick any v2/v3 voice, turn its dials, audition Beat 001, save it as a profile">
                            <i class="bi bi-sliders"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap mt-2 align-items-center">
                <div class="dropdown">
                    <button class="btn btn-sm btn-success dropdown-toggle" type="button" data-bs-toggle="dropdown"
                            disabled="@(publishing || exportBusy)"
                            title="Export this strand to your Downloads — audiobook, Word, PDF, Markdown, or plain text">
                        @if (publishing || exportBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        else { <i class="bi bi-download me-1"></i> }
                        Export
                    </button>
                    <ul class="dropdown-menu dropdown-menu-dark">
                        <li><h6 class="dropdown-header">Audio</h6></li>
                        <li><button class="dropdown-item" @onclick="PublishAudiobookAsync"
                                    title="Render the whole strand as one continuous narration (one pass — no per-beat voice drift)">
                            <i class="bi bi-headphones me-2"></i>Audiobook (.mp3)</button></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">Manuscript</h6></li>
                        <li><button class="dropdown-item" @onclick="PublishDocxAsync"
                                    title="KDP-ready Word .docx">
                            <i class="bi bi-file-earmark-word me-2"></i>Word Document (.docx)</button></li>
                        <li><button class="dropdown-item" @onclick="PublishPdfAsync"
                                    title="KDP-style PDF">
                            <i class="bi bi-file-pdf me-2"></i>PDF (.pdf)</button></li>
                        <li><button class="dropdown-item" @onclick="PublishMarkdownAsync"
                                    title="Markdown with chapter headings">
                            <i class="bi bi-markdown me-2"></i>Markdown (.md)</button></li>
                        <li><button class="dropdown-item" @onclick="PublishTextAsync"
                                    title="Plain text">
                            <i class="bi bi-file-text me-2"></i>Plain Text (.txt)</button></li>
                    </ul>
                </div>
                <div class="ms-auto">
                    <a href="/strands" class="btn btn-sm btn-link text-muted">
                        <i class="bi bi-arrow-left me-1"></i>All strands
                    </a>
                </div>
            </div>

            @if (showVoiceStudio)
            {
                <div class="border border-secondary rounded p-3 mt-2 bg-black">
                    <div class="d-flex align-items-center mb-2">
                        <i class="bi bi-sliders text-info me-2"></i>
                        <span class="fw-semibold">Voice Studio</span>
                        <span class="text-muted small ms-2">— pick a voice + model, turn the dials, audition a sample line, then pin it to this strand or save it as a reusable profile.</span>
                        <button class="btn btn-sm btn-link text-muted ms-auto p-0" @onclick="() => showVoiceStudio = false"><i class="bi bi-x-lg"></i></button>
                    </div>

                    @* Pick the voice first; everything below adapts to it. The
                       model list is filtered to what THIS voice supports, and only
                       the dials that apply to the chosen model's engine are shown —
                       no v2/v3 tab to get lost in. *@
                    <div class="row g-3 mb-2">
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Voice</label>
                            <select class="form-select form-select-sm bg-black text-light border-secondary"
                                    title="The ElevenLabs voice that narrates this strand. Voices tagged (v3✓) can also use the newer, more expressive v3 engine."
                                    @bind="editorProfile.VoiceId" @bind:after="OnStudioVoiceChanged">
                                <option value="">— pick a voice —</option>
                                @foreach (var v in voices)
                                {
                                    <option value="@v.VoiceId">@v.Name@(v.SupportsV3 ? "  (v3✓)" : "")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-muted mb-1">Engine &amp; model</label>
                            <select class="form-select form-select-sm bg-black text-light border-secondary"
                                    title="Which ElevenLabs model renders this voice. v3 = newest and most expressive, driven by inline emotion tags set per beat. v2 = classic, tuned with continuous stability/similarity/style dials. Only models this voice supports are listed."
                                    @bind="editorProfile.Model" @bind:after="OnStudioModelChanged">
                                @foreach (var m in CompatibleModels())
                                {
                                    <option value="@m.ModelId">@m.Name @(m.IsV3 ? "· v3" : "· v2")</option>
                                }
                            </select>
                        </div>
                    </div>

                    @if (IsV3Model(editorProfile.Model))
                    {
                        @* v3: discrete stability presets + inline tags. Similarity
                           and style do nothing on v3, so they are not shown. *@
                        <div class="row g-3 align-items-end">
                            <div class="col-md-8">
                                <label class="form-label small text-muted mb-1">Stability</label>
                                <div class="btn-group d-flex" role="group"
                                     title="v3 accepts only three stability settings. Robust = most consistent across the whole strand (fights v3 accent drift); Natural = balanced; Creative = most expressive but more variable take-to-take.">
                                    @foreach (var preset in V3Presets)
                                    {
                                        <button type="button"
                                                class="btn btn-sm @(Math.Abs(editorProfile.Stability - preset.Value) < 0.01 ? "btn-info" : "btn-outline-info")"
                                                @onclick="() => editorProfile.Stability = preset.Value">@preset.Name</button>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check" title="Boosts how closely the output resembles the original speaker. Safe to leave on.">
                                    <input class="form-check-input" type="checkbox" id="vsSpeakerBoost" @bind="editorProfile.UseSpeakerBoost" />
                                    <label class="form-check-label small text-muted" for="vsSpeakerBoost">Speaker boost</label>
                                </div>
                            </div>
                        </div>
                        <div class="form-text text-muted small mt-1">
                            v3 expresses emotion through inline audio tags (e.g. <code>[whispering]</code>) set per beat in the beat details — it ignores the similarity &amp; style dials, so they are hidden here.
                        </div>
                    }
                    else
                    {
                        @* v2: continuous dials. *@
                        <div class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label small text-muted mb-1" title="How consistent the delivery is take-to-take. Higher = steadier and more uniform; lower = more expressive but more variable.">Stability: @editorProfile.Stability.ToString("F2")</label>
                                <input type="range" class="form-range" min="0" max="1" step="0.05" @bind="editorProfile.Stability" @bind:event="oninput" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small text-muted mb-1" title="How closely the output hews to the original voice's timbre. Higher = more faithful to the source voice.">Similarity: @editorProfile.SimilarityBoost.ToString("F2")</label>
                                <input type="range" class="form-range" min="0" max="1" step="0.05" @bind="editorProfile.SimilarityBoost" @bind:event="oninput" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small text-muted mb-1" title="Style exaggeration. Higher pushes the voice's characteristic delivery; 0 is neutral and most stable.">Style: @editorProfile.Style.ToString("F2")</label>
                                <input type="range" class="form-range" min="0" max="1" step="0.05" @bind="editorProfile.Style" @bind:event="oninput" />
                            </div>
                            <div class="col-md-3">
                                <div class="form-check" title="Boosts how closely the output resembles the original speaker. Safe to leave on.">
                                    <input class="form-check-input" type="checkbox" id="vsSpeakerBoostV2" @bind="editorProfile.UseSpeakerBoost" />
                                    <label class="form-check-label small text-muted" for="vsSpeakerBoostV2">Speaker boost</label>
                                </div>
                            </div>
                        </div>
                    }

                    @if (Settings.VoiceProfiles.Count > 0)
                    {
                        <div class="mt-3" style="max-width:360px;">
                            <label class="form-label small text-muted mb-1">Load a saved profile into the editor</label>
                            <select class="form-select form-select-sm bg-black text-light border-secondary"
                                    @onchange="e => LoadProfileIntoEditor(e.Value?.ToString() ?? string.Empty)">
                                <option value="">— @Settings.VoiceProfiles.Count saved profiles —</option>
                                @foreach (var p in Settings.VoiceProfiles)
                                {
                                    <option value="@p.Id">@p.Label</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="d-flex gap-2 flex-wrap align-items-end mt-3">
                        <button class="btn btn-sm btn-info" @onclick="AuditionVoiceAsync" disabled="@(auditioning || string.IsNullOrWhiteSpace(editorProfile.VoiceId))"
                                title='Speak "The quick brown fox jumped over the lazy dog." with these dials and play it — nothing is saved'>
                            @if (auditioning) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            else { <i class="bi bi-play-fill me-1"></i> }
                            Audition voice
                        </button>
                        <button class="btn btn-sm btn-outline-success" @onclick="ApplyVoiceToStrandAsync" disabled="@string.IsNullOrWhiteSpace(editorProfile.VoiceId)"
                                title="Pin these dials to THIS strand — the next record/publish uses them">
                            <i class="bi bi-pin-angle me-1"></i>Apply to this strand
                        </button>
                        <div class="d-flex gap-1 align-items-end">
                            <div>
                                <label class="form-label small text-muted mb-1">New profile name</label>
                                <input class="form-control form-control-sm bg-black text-light border-secondary" style="min-width:200px;"
                                       placeholder="e.g. Oliver Silk — gravelly v3" @bind="newProfileLabel" />
                            </div>
                            <button class="btn btn-sm btn-outline-success" @onclick="SaveAsNewProfile"
                                    disabled="@(string.IsNullOrWhiteSpace(editorProfile.VoiceId) || string.IsNullOrWhiteSpace(newProfileLabel))"
                                    title="Save these dials as a new profile (never overwrites an existing one)">
                                <i class="bi bi-save me-1"></i>Save as profile
                            </button>
                        </div>
                        <button class="btn btn-sm btn-outline-light ms-auto" @onclick="ImportAllVoicesAsync" disabled="@importingVoices"
                                title="Create baseline v2 + v3 profiles for every ElevenLabs voice so they're always in your list">
                            @if (importingVoices) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            else { <i class="bi bi-cloud-download me-1"></i> }
                            Import all voices
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(auditionAudioUrl))
                    {
                        <div class="mt-3">
                            <label class="form-label small text-muted mb-1">Audition — “The quick brown fox jumped over the lazy dog.”</label>
                            <audio controls autoplay src="@auditionAudioUrl" class="w-100" style="height:34px;"></audio>
                        </div>
                    }
                </div>
            }
        </div>

        @if (publishing)
        {
            <div class="publish-overlay" data-cy="publish-overlay">
                <div class="publish-ring-wrap">
                    <svg class="publish-ring" viewBox="0 0 120 120" aria-hidden="true">
                        <circle class="publish-ring-track" cx="60" cy="60" r="54"></circle>
                        <circle class="publish-ring-bar" cx="60" cy="60" r="54"
                                style="stroke-dasharray:@PublishRingDash;stroke-dashoffset:@PublishRingOff;"></circle>
                    </svg>
                    <div class="publish-ring-center">
                        <div class="publish-pct">@PublishPercent<span>%</span></div>
                        <div class="publish-stage">Publishing</div>
                    </div>
                </div>
                <div class="publish-detail">
                    @if (!string.IsNullOrEmpty(publishLabel)) { <span>@publishLabel</span> }
                    else { <span>Stitching audio…</span> }
                    @if (publishTotal > 0) { <span class="publish-count">@publishCurrent / @publishTotal</span> }
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(strand.CombinedAudioPath))
        {
            <div class="mb-3">
                <audio controls src="@CombinedAudioUrl()" class="w-100" style="height:34px;"></audio>
            </div>
        }

        @* Resume banner: if the listener has a saved LastPlayedBeatId on
           this strand AND that beat still exists, surface a one-click jump
           to where they walked away. Hidden when the resume target is the
           very first beat (no actual progress to resume). *@
        @if (resumeBeatId.HasValue && beats.Any(o => o.Beat.Id == resumeBeatId.Value))
        {
            var resumePos = beats.FindIndex(o => o.Beat.Id == resumeBeatId.Value) + 1;
            @if (resumePos > 1)
            {
                <div class="resume-banner">
                    <i class="bi bi-bookmark-fill text-info"></i>
                    <span>Listened up to Beat #@resumePos.ToString("D3").</span>
                    <button class="btn btn-sm btn-outline-info" @onclick="ScrollToResumeAsync">
                        <i class="bi bi-arrow-down-circle me-1"></i>Jump to it
                    </button>
                    <button class="btn btn-sm btn-link text-muted" @onclick="ClearResumeAsync" title="Forget the saved listening position">
                        Dismiss
                    </button>
                </div>
            }
        }

        @* Nested-strands list removed: a strand is now a single flat list of
           beats, with section divisions marked by Beat.IsChapterStart.

           In its place, render a chapter index — one jump-link per beat
           with IsChapterStart=true. Click jumps to the beat's row via
           anchor scroll. Built from the in-memory beats list so the count
           updates immediately when the user toggles IsChapterStart. *@
        @{
            var chapterStops = beats
                .Select((entry, idx) => (entry.Beat, position: idx + 1))
                .Where(x => x.Beat.IsChapterStart)
                .ToList();
        }
        @if (chapterStops.Count > 1)
        {
            <div class="chapter-index">
                <div class="chapter-index-head">
                    <i class="bi bi-list-ol me-1"></i>@chapterStops.Count chapter(s)
                </div>
                <div class="chapter-index-list">
                    @foreach (var stop in chapterStops)
                    {
                        var label = string.IsNullOrEmpty(stop.Beat.BeatTitle) ? "(untitled chapter)" : stop.Beat.BeatTitle;
                        <a href="@($"#beat-{stop.Beat.Id:N}")" class="chapter-index-link">
                            <span class="ci-pos">#@stop.position</span>@label
                        </a>
                    }
                </div>
            </div>
        }

        @if (beats.Count == 0)
        {
            <div class="card bg-dark border-secondary text-center py-5 text-muted">
                <div class="mb-3">
                    <i class="bi bi-stars" style="font-size: 2rem; opacity: 0.4;"></i>
                </div>
                <div class="mb-1">An empty strand. The first beat starts the story.</div>
                <div class="mt-3">
                    <button class="btn btn-outline-info" @onclick="() => InsertBeatAsync(null)" disabled="@working" data-cy="insert-first">
                        <i class="bi bi-plus-circle me-1"></i>Add the first beat
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column" id="strand-beats-root">
                <div class="insert-bar">
                    <div class="insert-bar-line"></div>
                    <button class="insert-bar-btn" @onclick="() => InsertBeatAsync(null)" disabled="@working" data-cy="insert-top">
                        <i class="bi bi-plus-circle me-1"></i>insert at top
                    </button>
                    <div class="insert-bar-line"></div>
                </div>

                @{ int position = 0; }
                @foreach (var entry in beats)
                {
                    position++;
                    var b = entry.Beat;
                    var bid = b.Id;
                    // Every beat is always an editable textarea (no read-only
                    // rendered view). "editing" here means the draft has
                    // unsaved changes — it lights the card border + keeps the
                    // action buttons visible until the user saves or reverts.
                    var isDirty = IsDirty(b);
                    var rowClass = "beat-card mb-1";
                    if (isDirty) rowClass += " editing";
                    if (resumeBeatId == bid) rowClass += " resume-here";
                    var rowPosition = position;
                    var isLastBeat = position == beats.Count;
                    var nextBeat = isLastBeat ? null : beats[position].Beat;
                    var autoGapMs = ComputeAutoGapMs(b, nextBeat);
                    var hasCustomGap = b.GapAfterMs.HasValue;
                    var displayGapMs = b.GapAfterMs ?? autoGapMs;
                    var gapEditorId = $"gap-input-{bid:N}";

                    // Version cycler (system-versioned history). Cursor 0 = current
                    // edit; higher = further back. Newer arrow (▶) is dead at the
                    // current version; older arrow (◀) is dead at the oldest.
                    var histCount = historyCounts.TryGetValue(bid, out var hc) ? hc : 0;
                    var histCursor = historyCursor.TryGetValue(bid, out var hcur) ? hcur : 0;
                    var histOlderDisabled = histCount <= 1 || histCursor >= histCount - 1;
                    var histNewerDisabled = histCount == 0 || histCursor <= 0;
                    var histCycling = histCount > 0 && histCursor > 0;

                    @if (b.IsChapterStart)
                    {
                        <div class="beat-chapter-divider" data-cy="chapter-divider">
                            <span class="beat-chapter-line"></span>
                            <span class="beat-chapter-label">@(string.IsNullOrEmpty(b.BeatTitle) ? "New section" : b.BeatTitle)</span>
                            <span class="beat-chapter-line"></span>
                        </div>
                    }

                    @* draggable is NOT set here — the row is non-draggable by
                       default. strand-interop arms draggable="true" only while
                       the pointer went down on .beat-drag-handle, so a drag
                       started anywhere else on the card (prose, textarea,
                       buttons) does nothing instead of reordering beats. *@
                    <div class="@rowClass" id="@($"beat-{bid:N}")" data-cy="beat-row" data-beat-id="@bid" data-strand-id="@entry.StrandId">
                        @* ── Row 1: drag handle · checkbox · Beat # + chips · format toolbar · right-aligned action buttons ── *@
                        <div class="beat-row-1 d-flex align-items-center gap-2 mb-2">
                            <span class="beat-drag-handle" title="Drag to reorder this beat within the strand">
                                <i class="bi bi-grip-vertical"></i>
                            </span>
                            <span class="beat-id-chip" data-cy="beat-id" title="@($"Position {rowPosition} in strand — Beat guid {bid}")">Beat #@rowPosition.ToString("D3")</span>
                            <button class="btn btn-sm beat-guid-copy p-0" title="@($"Copy beat id {bid}")"
                                    @onclick='() => CopyGuidAsync(bid, "Beat id")' @onclick:stopPropagation>
                                <i class="bi @(copiedGuid == bid ? "bi-check-lg" : "bi-hash")"></i>
                            </button>
                            @if (b.Score.HasValue)
                            {
                                <span class="badge bg-@ScorePctColor(b.Score.Value) strand-meta-chip"
                                      style="cursor:pointer" title="Beat reader score (latest run) — click for this beat's reviews"
                                      @onclick="() => OpenBeatReviewsAsync(rowPosition, b)" @onclick:stopPropagation>
                                    @b.Score.Value.ToString("0")%
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(b.Text))
                            {
                                <span class="text-muted small beat-char-count">@b.Text.Length chars</span>
                            }

                            @* Format toolbar. Every beat is an editable textarea,
                               so the buttons are always live — the wrap helper
                               inserts the marker around the current selection in
                               this beat's textarea (or at the caret). *@
                            <div class="beat-format-toolbar" role="toolbar" aria-label="Inline formatting">
                                <button class="btn btn-sm btn-outline-light"
                                        title="Bold (**text**) — wraps current selection in the textarea"
                                        @onclick='() => WrapFormatAsync(bid, "**")'
                                        @onclick:stopPropagation
                                        data-cy="beat-fmt-bold">
                                    <i class="bi bi-type-bold"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-light"
                                        title="Italic (*text*)"
                                        @onclick='() => WrapFormatAsync(bid, "*")'
                                        @onclick:stopPropagation
                                        data-cy="beat-fmt-italic">
                                    <i class="bi bi-type-italic"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-light"
                                        title="Underline (__text__)"
                                        @onclick='() => WrapFormatAsync(bid, "__")'
                                        @onclick:stopPropagation
                                        data-cy="beat-fmt-underline">
                                    <i class="bi bi-type-underline"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-light"
                                        title="Strikethrough (~~text~~)"
                                        @onclick='() => WrapFormatAsync(bid, "~~")'
                                        @onclick:stopPropagation
                                        data-cy="beat-fmt-strike">
                                    <i class="bi bi-type-strikethrough"></i>
                                </button>
                            </div>

                            @* Right-aligned action cluster. Every beat is always
                               editable, so Save (✓) / Revert (✗) sit permanently to
                               the LEFT of the copy / LLM / mic / delete row. Save and
                               Revert disable themselves when the draft is clean, so
                               they're only live when there's an unsaved change. *@
                            <div class="beat-actions d-flex align-items-center gap-1 ms-auto">
                                <button class="btn btn-sm btn-success"
                                        @onclick="() => SaveBeatEditAsync(bid)"
                                        @onclick:stopPropagation
                                        disabled="@(savingBeatId == bid || !isDirty)"
                                        title="Save (⌘/Ctrl+Enter)"
                                        data-cy="beat-save">
                                    @if (savingBeatId == bid) { <span class="spinner-border spinner-border-sm"></span> }
                                    else { <i class="bi bi-check-lg"></i> }
                                </button>
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => RevertDraft(b)"
                                        @onclick:stopPropagation
                                        disabled="@(!isDirty)"
                                        title="Revert unsaved changes (Esc)"
                                        data-cy="beat-cancel">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                                <span class="beat-action-sep"></span>
                                @* Version cycler — two arrows that scrub this beat's
                                   editor back/forward through its system-versioned
                                   history (Beats_History). ◀ older, ▶ newer; ▶ is
                                   disabled on the current version. Land on the one you
                                   want, then Save to keep it (a new current version). *@
                                <span class="beat-history-nav d-flex align-items-center @(histCycling ? "cycling" : "")">
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => StepHistoryAsync(bid, +1)"
                                            @onclick:stopPropagation
                                            disabled="@histOlderDisabled"
                                            title="@(histCount > 0 ? $"Older edit ({histCursor + 1}/{histCount})" : "No earlier versions yet")"
                                            data-cy="beat-history-older">
                                        <i class="bi bi-chevron-left"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary"
                                            @onclick="() => StepHistoryAsync(bid, -1)"
                                            @onclick:stopPropagation
                                            disabled="@histNewerDisabled"
                                            title="@(histCount > 0 ? $"Newer edit ({histCursor + 1}/{histCount})" : "No earlier versions yet")"
                                            data-cy="beat-history-newer">
                                        <i class="bi bi-chevron-right"></i>
                                    </button>
                                </span>
                                <span class="beat-action-sep"></span>
                                <button class="btn btn-sm btn-outline-secondary @(copiedTextBeatId == bid ? "copied" : "")"
                                            title="@(copiedTextBeatId == bid ? "Copied!" : "Copy beat text to clipboard")"
                                            @onclick="() => CopyBeatTextAsync(bid)"
                                            @onclick:stopPropagation
                                            data-cy="beat-copy-text">
                                        <i class="bi @(copiedTextBeatId == bid ? "bi-check-lg" : "bi-clipboard")"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-primary"
                                            title="Ask the LLM to rewrite this beat"
                                            @onclick="() => OpenLlmSheet(b)"
                                            @onclick:stopPropagation
                                            disabled="@working"
                                            data-cy="beat-llm">
                                        <i class="bi bi-stars"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger"
                                            title="Delete this beat (confirmation prompt)"
                                            @onclick="() => RequestDeleteAsync(bid)"
                                            @onclick:stopPropagation
                                            disabled="@working"
                                            data-cy="beat-delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                            </div>
                        </div>

                        @* ── Row 2: the beat body. Always an editable textarea —
                           there is no separate read-only rendered view. It shows
                           the raw markers ([WHISPERING], **bold**) the same way the
                           old edit mode did. @bind:get/@bind:set route through the
                           per-beat draft dictionary so each beat is independently
                           editable; Save commits, Revert restores. No rows attribute
                           — JS autoSizeTextarea sizes height to content; CSS
                           min-height matches the old prose box so short beats don't
                           collapse. ── *@
                        <div class="beat-row-2">
                            <textarea class="beat-textarea" id="@($"beat-{bid:N}-edit")"
                                      placeholder="(empty beat — write here)"
                                      @bind:get="DraftFor(b)"
                                      @bind:set="@(v => OnDraftSet(bid, v))"
                                      @bind:event="oninput"
                                      @onkeyup="@(() => AutoSizeTextareaAsync(bid))"
                                      @onkeydown="@(e => OnEditorKeydown(e, b))"></textarea>
                        </div>

                        @* ── Row 3: footer band. Audio (if recorded), then a single
                           flex row with meta chips (left) + gap-after editor
                           (right). The meta-panel (when open) stacks below. ── *@
                        <div class="beat-row-3">
                            <div class="beat-row-3-bar d-flex justify-content-between align-items-center flex-wrap">
                        <div class="beat-meta-chips">
                            @{
                                var tone  = b.EmotionalTone;
                                var pace  = b.PaceHint;
                                var btitle = b.BeatTitle;
                            }
                            @if (!string.IsNullOrEmpty(btitle))
                            {
                                <span class="beat-meta-chip" @onclick="() => ToggleMeta(bid)" title="Beat title — short label only, not narrated.">📑 @btitle</span>
                            }
                            <span class="beat-meta-chip @(string.IsNullOrEmpty(tone) ? "unset" : "")"
                                  @onclick="() => ToggleMeta(bid)"
                                  title="Emotional tone — maps to an ElevenLabs inline audio tag on v3 voices (e.g. [whispering], [shouting]).">
                                @(string.IsNullOrEmpty(tone) ? "tone: —" : $"🎭 {tone}")
                            </span>
                            <span class="beat-meta-chip @(string.IsNullOrEmpty(pace) ? "unset" : "")"
                                  @onclick="() => ToggleMeta(bid)"
                                  title="Pace hint — biases narration stability (clipped/staccato → faster, languorous → slower).">
                                @(string.IsNullOrEmpty(pace) ? "pace: —" : $"⏱ {pace}")
                            </span>
                            <span class="beat-meta-chip" @onclick="() => ToggleMeta(bid)" data-cy="beat-meta-toggle">
                                @(metaOpenBeatId == bid ? "▲ details" : "▾ details")
                            </span>
                        </div>

                            @* Gap-after editor — only shown when there's a next beat.
                               Lives inside .beat-row-3-bar so it sits on the same flex
                               row as the meta chips, right-aligned by justify-content. *@
                            @if (!isLastBeat)
                            {
                                <div class="beat-gap-inline @(hasCustomGap ? "custom" : "")" title="@(hasCustomGap ? $"Custom gap: {displayGapMs}ms (auto would be {autoGapMs}ms)" : $"Auto gap: {autoGapMs}ms — type to override")">
                                    <span class="text-muted small">gap after</span>
                                    <input type="number" min="0" max="6000" step="50"
                                           value="@displayGapMs"
                                           id="@gapEditorId"
                                           class="beat-gap-input"
                                           @onkeydown="@(e => OnGapEditorKeydown(e, bid, gapEditorId))" />
                                    <span class="text-muted small">ms @(hasCustomGap ? "(custom)" : "(auto)")</span>
                                    <button class="btn btn-sm btn-link p-0 text-info" title="Save (Enter)" @onclick="@(() => SaveGapAfterFromInputAsync(bid, gapEditorId))">✓</button>
                                    @if (hasCustomGap)
                                    {
                                        <button class="btn btn-sm btn-link p-0 text-warning" title="Reset to auto" @onclick="@(() => ResetGapAfterAsync(bid))">↺</button>
                                    }
                                </div>
                            }
                            </div> @* /beat-row-3-bar *@

                        @if (metaOpenBeatId == bid)
                        {
                            <div class="beat-meta-panel">
                                <div class="row g-2">
                                    <div class="col-md-6">
                                        <label>Beat title (label only — not narrated)</label>
                                        <input class="form-control form-control-sm" @bind="metaForm.BeatTitle" placeholder="e.g. The threshold" />
                                    </div>
                                    <div class="col-md-6">
                                        <label>Synopsis (one line — fed to LLM regenerations)</label>
                                        <input class="form-control form-control-sm" @bind="metaForm.Synopsis" placeholder="What is this beat doing?" />
                                    </div>
                                    <div class="col-md-4">
                                        <label>Emotional tone → audio tag</label>
                                        <select class="form-select form-select-sm" @bind="metaForm.EmotionalTone" data-cy="beat-meta-tone">
                                            <option value="">(none)</option>
                                            <option value="quiet">quiet → [whispering]</option>
                                            <option value="tender">tender → [softly]</option>
                                            <option value="sad">sad → [melancholy]</option>
                                            <option value="afraid">afraid → [afraid]</option>
                                            <option value="tense">tense → [tense]</option>
                                            <option value="wry">wry → [sarcastic]</option>
                                            <option value="curious">curious → [curious]</option>
                                            <option value="excited">excited → [excited]</option>
                                            <option value="happy">happy → [cheerful]</option>
                                            <option value="angry">angry → [angry]</option>
                                            <option value="violent">violent → [shouting]</option>
                                            <option value="mysterious">mysterious → [mysterious]</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Pace hint</label>
                                        <select class="form-select form-select-sm" @bind="metaForm.PaceHint">
                                            <option value="">(none)</option>
                                            <option value="flowing">flowing</option>
                                            <option value="clipped">clipped</option>
                                            <option value="staccato">staccato</option>
                                            <option value="languorous">languorous</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Structure role</label>
                                        <input class="form-control form-control-sm" @bind="metaForm.StructureRole" placeholder="inciting-incident, rising-action, climax…" />
                                    </div>
                                    <div class="col-md-4">
                                        <label>Act</label>
                                        <input type="number" class="form-control form-control-sm" min="0" max="5" @bind="metaForm.Act" />
                                    </div>
                                    <div class="col-md-4">
                                        <label>Scene type</label>
                                        <select class="form-select form-select-sm" @bind="metaForm.SceneType">
                                            <option value="scene">scene</option>
                                            <option value="summary">summary</option>
                                            <option value="transition">transition</option>
                                            <option value="interstitial">interstitial</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label>Beat kind</label>
                                        <select class="form-select form-select-sm" @bind="metaForm.Kind">
                                            <option value="prose">prose (default)</option>
                                            <option value="book-title">book-title (Text=title, BeatTitle=author)</option>
                                            <option value="dedication">dedication (centered italic)</option>
                                            <option value="quote">quote (Text=quote, BeatTitle=attribution)</option>
                                        </select>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" id="@($"beat-{bid:N}-chapstart")"
                                                   @bind="metaForm.IsChapterStart" />
                                            <label class="form-check-label" for="@($"beat-{bid:N}-chapstart")">
                                                This beat starts a new chapter / section
                                                <span class="text-muted small ms-1">— uses Beat title above as the heading; renders a divider. Orthogonal to Beat kind (a quote that opens a chapter is an epigraph).</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="d-flex gap-2 mt-2 align-items-center">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveMetaAsync(bid)" data-cy="beat-meta-save">
                                        <i class="bi bi-check-lg me-1"></i>Save details
                                    </button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelMeta">Close</button>
                                    <span class="text-muted small ms-auto">These steer narration tone on next re-record. Audio stays valid until you re-record.</span>
                                </div>
                            </div>
                        }
                        </div> @* /beat-row-3 *@
                    </div>

                    <div class="insert-bar">
                        <div class="insert-bar-line"></div>
                        <button class="insert-bar-btn" @onclick="() => InsertBeatAsync(bid)" disabled="@working" data-cy="insert-after">
                            <i class="bi bi-plus-circle me-1"></i>insert beat
                        </button>
                        <div class="insert-bar-line"></div>
                    </div>
                } @* end foreach *@

            </div>
        }
    </div>
}

@if (pendingDelete != null)
{
    @* Click backdrop → cancel. Click inside the dialog stops propagation
       so the modal stays open. Escape handler attached at top of body via
       JS interop — see EnsureEscapeHook(). *@
    <div class="modal d-block" style="background:rgba(0,0,0,0.6);" tabindex="-1"
         @onclick="CancelDelete">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation>
            <div class="modal-content bg-dark border-danger">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete this beat?</h5>
                </div>
                <div class="modal-body text-light small">
                    The beat will be removed from this strand. If no other strand references it, the beat itself (text + audio) is deleted.
                </div>
                <div class="modal-footer border-secondary">
                    <button class="btn btn-outline-secondary" @onclick="CancelDelete">Cancel <span class="text-muted ms-1">(Esc)</span></button>
                    <button class="btn btn-danger" @onclick="ConfirmDeleteAsync" data-cy="confirm-delete">Delete</button>
                </div>
