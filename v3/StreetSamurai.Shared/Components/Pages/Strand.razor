    /// <summary>Copy this beat's prose to the system clipboard so the user can
    /// paste it into a chat / CLI / external editor. Flashes the chip green
    /// for ~1.4s as visual confirmation.</summary>
    private async Task CopyBeatTextAsync(Guid beatId)
    {
        var beat = beats.FirstOrDefault(o => o.Beat.Id == beatId)?.Beat;
        if (beat == null) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", beat.Text ?? "");
            copiedTextBeatId = beatId;
            StateHasChanged();
            _ = Task.Run(async () =>
            {
                await Task.Delay(1400);
                if (copiedTextBeatId == beatId)
                {
                    copiedTextBeatId = null;
                    await InvokeAsync(StateHasChanged);
                }
            });
        }
        catch (Exception ex) { Toast.Error("COPY-FAIL", ex.Message); }
    }

