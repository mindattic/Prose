@page "/generate"
@inject SceneGenerationService SceneGen
@inject CanonService Canon
@inject FacetService FacetSvc
@inject WorldGraphService Graph
@inject StoryService StorySvc
@inject NavigationManager Nav
@inject ElevenLabsTtsService TtsSvc
@implements IDisposable

<h4 class="text-danger mb-1">Generate Scene</h4>
<p class="text-muted mb-3">Multi-beat scene generator. Each beat selects a lead facet, pulls world context, and writes prose. Facets rotate to prevent repetition.</p>

@if (!_generating && _generatedScene == null)
{
    @* ── Setup Panel ────────────────────────────────────── *@
    <div class="row g-3">
        <div class="col-md-8">
            <div class="card bg-dark text-light border-secondary">
                <div class="card-header text-muted">Scene Setup</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label text-muted">Scene Goal</label>
                        <textarea class="form-control bg-dark text-light border-secondary" rows="3"
                                  placeholder="e.g. Kyle confronts the street doc about the neural implant that's been broadcasting to a dead corp's servers..."
                                  title="What should happen — the engine generates beats toward this goal"
                                  @bind="_goal"></textarea>
                        <small class="text-muted">Describe the dramatic arc. The engine generates beats toward this goal.</small>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Location</label>
                            <select class="form-select bg-dark text-light border-secondary" @bind="_location" title="District from canon — provides atmosphere and sensory context to the AI">
                                <option value="">-- Select District --</option>
                                @foreach (var d in _districts)
                                {
                                    <option value="@d.Name">@d.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Beats</label>
                            <input type="range" class="form-range" min="3" max="8" @bind="_numBeats" title="Number of narrative beats — each gets a lead facet and 2-4 paragraphs" />
                            <small class="text-muted">@_numBeats beats — each is 2-4 paragraphs with its own lead facet</small>
                        </div>
                    </div>
                    <div class="mb-3 mt-3">
                        <label class="form-label text-muted">Characters</label>
                        <input type="text" class="form-control bg-dark text-light border-secondary"
                               placeholder="Kyle, Sable, Pixel..."
                               title="Comma-separated names — must match character YAML files. Facet weights are blended from their profiles."
                               @bind="_characterInput" />
                        <small class="text-muted">Comma-separated. Their facet weights drive which psychological voice leads each beat.</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted">Themes / Beat Goals (optional)</label>
                        <textarea class="form-control bg-dark text-light border-secondary" rows="3"
                                  placeholder="e.g.&#10;tension builds through small talk&#10;the betrayal is revealed&#10;violent confrontation"
                                  title="One per line — each maps to a specific beat. Leave empty and the engine decides."
                                  @bind="_themesInput"></textarea>
                        <small class="text-muted">One per line. Each maps to a beat. Leave empty and the engine chooses its own arc.</small>
                    </div>
                    <button class="btn btn-danger" @onclick="StartGeneration" disabled="@string.IsNullOrWhiteSpace(_goal)">
                        Generate Scene
                    </button>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-dark text-light border-secondary">
                <div class="card-header text-muted">Loaded Facets</div>
                <div class="card-body">
                    @foreach (var (name, facet) in _facets)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <FacetBadge Name="@name" />
                            <small class="text-muted">@facet.Domain</small>
                        </div>
                    }
                    @if (!_facets.Any())
                    {
                        <small class="text-muted">No facets loaded. Check Canon Root Path in Settings.</small>
                    }
                </div>
            </div>
        </div>
    </div>
}
else if (_generating)
{
    @* ── Generation Progress ────────────────────────────── *@
    <div class="card bg-dark text-light border-secondary mb-3">
        <div class="card-header text-muted d-flex justify-content-between align-items-center">
            <span>Generating... Beat @_currentBeat / @_numBeats</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelGeneration">Cancel</button>
        </div>
        <div class="card-body">
            @* Facet rotation bar *@
            <div class="d-flex gap-1 mb-3">
                @foreach (var beat in _completedBeats)
                {
                    <FacetBadge Name="@beat.LeadFacet" />
                }
                @if (_generating)
                {
                    <div class="spinner-border spinner-border-sm text-danger" role="status"></div>
                }
            </div>

            @foreach (var beat in _completedBeats)
            {
                <div class="mb-3 border-start border-2 ps-3" style="border-color: @GetFacetColor(beat.LeadFacet) !important;">
                    <div class="d-flex gap-2 mb-1">
                        <FacetBadge Name="@beat.LeadFacet" />
                        @foreach (var sf in beat.SupportingFacets)
                        {
                            <small class="text-muted">+@sf</small>
                        }
                    </div>
                    <div style="white-space: pre-wrap; font-family: Georgia, serif; line-height: 1.7;">@beat.Text</div>
                </div>
            }
        </div>
    </div>
}
else if (_generatedScene != null)
{
    @* ── Completed Scene ────────────────────────────────── *@
    <div class="d-flex gap-2 mb-3">
        <button class="btn btn-sm btn-outline-success" @onclick="SaveAsStory">Save as Story</button>
        @if (_ttsAvailable)
        {
            <button class="btn btn-sm btn-outline-danger" @onclick="NarrateScene" disabled="@_narrating">
                @if (_narrating) { <span class="spinner-border spinner-border-sm"></span> <span>Narrating...</span> }
                else { <i class="bi bi-volume-up"></i> <span>Narrate</span> }
            </button>
        }
        <button class="btn btn-sm btn-outline-secondary" @onclick="Reset">New Scene</button>
    </div>

    <AudioPlayer @ref="_audioPlayer" Visible="_showAudioPlayer" OnDismissed="() => _showAudioPlayer = false" CssClass="mb-3" />

    <div class="d-flex gap-1 mb-3">
        @foreach (var beat in _generatedScene.Beats)
        {
            <FacetBadge Name="@beat.LeadFacet" />
        }
    </div>

    @foreach (var beat in _generatedScene.Beats)
    {
        <div class="mb-3 border-start border-2 ps-3" style="border-color: @GetFacetColor(beat.LeadFacet) !important;">
            <div class="d-flex gap-2 mb-1">
                <FacetBadge Name="@beat.LeadFacet" />
                @foreach (var sf in beat.SupportingFacets)
                {
                    <small class="text-muted">+@sf</small>
                }
            </div>
            <div style="white-space: pre-wrap; font-family: Georgia, serif; line-height: 1.7;">@beat.Text</div>
        </div>
    }
}

@code {
    private string _goal = "";
    private string _location = "";
    private string _characterInput = "Kyle";
    private string _themesInput = "";
    private int _numBeats = 5;
    private bool _generating;
    private int _currentBeat;
    private List<GeneratedBeat> _completedBeats = [];
    private GeneratedScene? _generatedScene;
    private CancellationTokenSource? _cts;

    private List<District> _districts = [];
    private Dictionary<string, FacetDefinition> _facets = [];
    private bool _ttsAvailable;
    private bool _narrating;
    private bool _showAudioPlayer;
    private AudioPlayer? _audioPlayer;

    protected override async Task OnInitializedAsync()
    {
        _districts = Canon.ListDistricts();
        _facets = FacetSvc.LoadAllFacets();
        Graph.EnsureLoaded();
        _ttsAvailable = await TtsSvc.IsConfiguredAsync();

        SceneGen.OnBeatProgress += OnProgress;
        SceneGen.OnBeatCompleted += OnBeatDone;
    }

    private async Task StartGeneration()
    {
        _generating = true;
        _completedBeats = [];
        _generatedScene = null;
        _cts = new CancellationTokenSource();

        var characters = _characterInput.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        var themes = _themesInput.Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();

        var request = new SceneRequest
        {
            Goal = _goal,
            Location = _location,
            Characters = characters,
            Themes = themes,
            NumBeats = _numBeats,
        };

        // Load real character weights from canon, blend if multiple characters
        var weights = LoadBlendedWeights(characters);

        try
        {
            _generatedScene = await SceneGen.GenerateSceneAsync(request, weights, _cts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _completedBeats.Add(new GeneratedBeat { Text = $"Error: {ex.Message}", LeadFacet = "wound" });
        }
        finally
        {
            _generating = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelGeneration()
    {
        _cts?.Cancel();
        _generating = false;
    }

    private async void OnProgress(BeatGenerationProgress progress)
    {
        _currentBeat = progress.BeatIndex;
        await InvokeAsync(StateHasChanged);
    }

    private async void OnBeatDone(GeneratedBeat beat)
    {
        _completedBeats.Add(beat);
        await InvokeAsync(StateHasChanged);
    }

    private void SaveAsStory()
    {
        if (_generatedScene == null) return;
        var story = new Story
        {
            Title = _goal.Length > 50 ? _goal[..50] + "..." : _goal,
            CanonStatus = "draft",
            Location = _location,
            Characters = _characterInput.Split(',', StringSplitOptions.TrimEntries).ToList(),
            MarkdownContent = $"# {_goal}\n\n{_generatedScene.FullText}",
        };
        StorySvc.SaveStory(story);
        Nav.NavigateTo($"/editor/{story.Id}");
    }

    private void Reset()
    {
        _generatedScene = null;
        _completedBeats = [];
        _generating = false;
        _showAudioPlayer = false;
    }

    private async Task NarrateScene()
    {
        if (_generatedScene == null || _narrating) return;
        _narrating = true;
        _showAudioPlayer = true;
        _audioPlayer?.SetLoading(true);

        try
        {
            var audio = await TtsSvc.SynthesizeAsync(_generatedScene.FullText);
            if (_audioPlayer != null)
                await _audioPlayer.LoadAudioAsync(audio);
        }
        catch (Exception ex)
        {
            _audioPlayer?.SetError(ex.Message);
        }
        finally
        {
            _narrating = false;
        }
    }

    private FacetState LoadBlendedWeights(List<string> characters)
    {
        var allWeights = new List<FacetState>();
        var allChars = Canon.ListCharacters();

        foreach (var name in characters)
        {
            var match = allChars.FirstOrDefault(c =>
                c.Name.Equals(name, StringComparison.OrdinalIgnoreCase));
            if (match?.Facets != null && (match.Facets.Wound > 0 || match.Facets.Ideal > 0))
                allWeights.Add(match.Facets);
        }

        if (allWeights.Count == 0)
            return new FacetState { Wound = 0.5, Ideal = 0.5, Id = 0.5, Shadow = 0.5, Mask = 0.5, Ghost = 0.5 };

        // Blend by averaging all character weights — ensemble cast
        return new FacetState
        {
            Wound = allWeights.Average(w => w.Wound),
            Ideal = allWeights.Average(w => w.Ideal),
            Id = allWeights.Average(w => w.Id),
            Shadow = allWeights.Average(w => w.Shadow),
            Mask = allWeights.Average(w => w.Mask),
            Ghost = allWeights.Average(w => w.Ghost),
        };
    }

    private static string GetFacetColor(string facet) => facet.ToLowerInvariant() switch
    {
        "wound" => "#dc3545",
        "ideal" => "#198754",
        "id" => "#ffc107",
        "shadow" => "#6f42c1",
        "mask" => "#0dcaf0",
        "ghost" => "#6c757d",
        _ => "#adb5bd",
    };

    public void Dispose()
    {
        SceneGen.OnBeatProgress -= OnProgress;
        SceneGen.OnBeatCompleted -= OnBeatDone;
        _cts?.Dispose();
    }
}
