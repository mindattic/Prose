@page "/talk"
@page "/talk/{BookId}"
@page "/talk/{BookId}/{ChapterId}"
@attribute [Authorize(Roles = "Contributor,Administrator")]
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@using StreetSamurai.Core.Services
@inject ConversationalWriterService Talker
@inject IBookRepository Books
@inject IChapterRepository Chapters
@inject WorldStateService World
@inject NavigationManager Nav

<div class="talk-shell">
    <div class="talk-header">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-chat-square-text-fill text-info"></i>
            <span class="text-light fw-bold">You, Me, and the Page</span>
            @if (book != null)
            {
                <span class="text-muted small">·</span>
                <a href="@($"/books/{book.Id}/chapters")" class="text-muted small text-decoration-none">@book.Title</a>
            }
            @if (chapter != null)
            {
                <span class="text-muted small">·</span>
                <span class="text-info small">Ch @(chapter.Number?.ToString() ?? "?") · @chapter.Title</span>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            @* Apply panel — opens when an assistant reply is being inserted into the page. *@
@if (applyPanelOpen)
{
    <div class="apply-overlay" @onclick="CloseApply">
        <div class="apply-panel" @onclick:stopPropagation="true">
            <div class="apply-header">
                <span class="text-info fw-bold"><i class="bi bi-arrow-right-square me-1"></i>Apply to the page</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseApply"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="apply-body">
                <div class="row g-2 mb-2">
                    <div class="col-md-6">
                        <label class="small text-muted">Insert position</label>
                        <select class="form-select form-select-sm bg-dark text-light border-secondary"
                                value="@applyInsertIndex" @onchange="OnInsertIndexChanged">
                            <option value="0">At the very top</option>
                            @for (int i = 0; i < pageParagraphs.Count; i++)
                            {
                                <option value="@(i + 1)">After paragraph @(i + 1)</option>
                            }
                            <option value="-1">At the end</option>
                        </select>
                    </div>
                    <div class="col-md-6 d-flex align-items-end gap-2">
                        <button class="btn btn-sm btn-success" @onclick="ConfirmApply"><i class="bi bi-check2"></i> Confirm</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="CloseApply">Cancel</button>
                    </div>
                </div>
                <div class="apply-preview">
                    @for (int i = 0; i < previewParagraphs.Count; i++)
                    {
                        var para = previewParagraphs[i];
                        <div class="@(para.IsNew ? "apply-para apply-para-new" : "apply-para")">
                            <div class="apply-para-num">@(i + 1)</div>
                            <div class="apply-para-text">@para.Text</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (resolvedEntities.Count > 0)
            {
                <span class="small text-muted">In dossier scope:</span>
                @foreach (var e in resolvedEntities.Take(6))
                {
                    <span class="badge bg-dark border border-secondary text-info">@e</span>
                }
                @if (resolvedEntities.Count > 6)
                {
                    <span class="small text-muted">+@(resolvedEntities.Count - 6) more</span>
                }
            }
            <select class="form-select form-select-sm bg-dark text-light border-secondary"
                    style="width:auto;" value="@(book?.Id ?? "")"
                    @onchange="OnBookChanged">
                <option value="">— pick a book —</option>
                @foreach (var b in allBooks)
                {
                    <option value="@b.Id">@b.Title</option>
                }
            </select>
            @if (book != null)
            {
                <select class="form-select form-select-sm bg-dark text-light border-secondary"
                        style="width:auto;" value="@(chapter?.Id ?? "")"
                        @onchange="OnChapterChanged">
                    <option value="">— new chapter —</option>
                    @foreach (var c in bookChapters)
                    {
                        <option value="@c.Id">Ch @(c.Number?.ToString() ?? "?") · @c.Title</option>
                    }
                </select>
            }
            <button class="btn btn-sm btn-outline-info" @onclick="SaveChapter" disabled="@(chapter == null || !pageDirty)">
                <i class="bi bi-floppy"></i> Save
            </button>
        </div>
    </div>

    <div class="talk-body">
        @* ── Chat ── *@
        <div class="talk-chat">
            <div class="talk-stream" id="talkStream">
                @if (history.Count == 0)
                {
                    <div class="talk-empty text-muted small">
                        Tell me what you want to do with this chapter. I have the dossiers for every character it mentions.
                        Examples:
                        <ul>
                            <li>"Sasha walks into Auntie Hoa's. Draft the opening — she's nervous about the strop."</li>
                            <li>"What would Kyle do here that's in voice but surprises Sable?"</li>
                            <li>"Show me three ways this scene could end."</li>
                        </ul>
                    </div>
                }
                @foreach (var m in history)
                {
                    <div class="talk-msg @($"talk-msg-{m.Role}")">
                        <div class="talk-role">
                            <i class="bi @(m.Role == "user" ? "bi-person-fill" : "bi-cpu") me-1"></i>@m.Role
                        </div>
                        <div class="talk-content">
                            <WikiText Text="@m.Content" />
                        </div>
                        @if (m.Role == "assistant" && m == history[^1])
                        {
                            <div class="talk-actions">
                                <button class="btn btn-sm btn-outline-success" @onclick="() => OpenApply(m.Content)" disabled="@(chapter == null)">
                                    <i class="bi bi-arrow-right-square"></i> Apply…
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => CopyToClipboard(m.Content)">
                                    <i class="bi bi-clipboard"></i> Copy
                                </button>
                            </div>
                        }
                    </div>
                }
                @if (working)
                {
                    <div class="talk-msg talk-msg-assistant">
                        <div class="talk-role"><i class="bi bi-cpu me-1"></i>assistant</div>
                        <div class="talk-content"><span class="spinner-border spinner-border-sm"></span> thinking…</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger small">@error</div>
                }
            </div>
            <div class="talk-input">
                <textarea class="form-control bg-dark text-light border-secondary"
                          rows="3"
                          placeholder="@(chapter == null ? "Pick a book and chapter, then tell me what you want." : "Talk to me about this chapter…")"
                          @bind="pendingMessage"
                          @bind:event="oninput"
                          @onkeydown="OnInputKey"
                          disabled="@working"></textarea>
                <button class="btn btn-primary" @onclick="Send" disabled="@(working || string.IsNullOrWhiteSpace(pendingMessage))">
                    @(working ? "…" : "Send")
                </button>
            </div>
        </div>

        @* ── The Page ── *@
        <div class="talk-page">
            @if (chapter == null)
            {
                <div class="text-muted small p-3">
                    Pick a book and chapter to see the page. Or talk to me about premise and we'll draft a new chapter.
                </div>
            }
            else
            {
                <input class="form-control form-control-sm bg-dark text-light border-secondary mb-2"
                       placeholder="Chapter title"
                       @bind="pageTitle" @bind:event="oninput"
                       @bind:after="MarkPageDirty" />
                <textarea class="form-control bg-dark text-light border-secondary talk-page-body"
                          @bind="pagePlain" @bind:event="oninput"
                          @bind:after="MarkPageDirty"></textarea>
            }
        </div>
    </div>
</div>

<style>
    .talk-shell { display:flex; flex-direction:column; height: calc(100vh - 56px); }
    .talk-header { display:flex; justify-content:space-between; align-items:center; padding:8px 12px; border-bottom:1px solid #444; gap:8px; flex-wrap:wrap; }
    .talk-body { display:grid; grid-template-columns: minmax(360px, 1fr) minmax(420px, 1.2fr); flex:1; min-height:0; }
    .talk-chat { display:flex; flex-direction:column; border-right:1px solid #444; min-height:0; }
    .talk-stream { flex:1; overflow-y:auto; padding:12px; display:flex; flex-direction:column; gap:10px; }
    .talk-input { display:flex; gap:6px; padding:8px; border-top:1px solid #444; }
    .talk-input textarea { resize:vertical; }
    .talk-msg { padding:8px 10px; border-radius:6px; }
    .talk-msg-user { background:#1c2a3a; align-self:flex-end; max-width:80%; }
    .talk-msg-assistant { background:#1f1f24; max-width:90%; border:1px solid #2a2a32; }
    .talk-role { font-size:.7rem; color:#8aa; text-transform:uppercase; letter-spacing:.05em; margin-bottom:2px; }
    .talk-content { white-space:pre-wrap; color:#e6e6e6; }
    .talk-actions { display:flex; gap:6px; margin-top:6px; }
    .talk-empty ul { margin-bottom:0; padding-left:1.2rem; }
    .talk-page { display:flex; flex-direction:column; padding:12px; min-height:0; }
    .talk-page-body { flex:1; resize:none; font-family: Georgia, serif; line-height:1.55; min-height: 0; }

    .apply-overlay { position:fixed; inset:0; background:rgba(0,0,0,.7); z-index:1080; display:flex; align-items:center; justify-content:center; padding:16px; }
    .apply-panel { background:#1a1d23; border:1px solid #2a2a32; border-radius:6px; max-width:880px; width:100%; max-height:85vh; display:flex; flex-direction:column; }
    .apply-header { display:flex; justify-content:space-between; align-items:center; padding:10px 12px; border-bottom:1px solid #2a2a32; }
    .apply-body { padding:12px; overflow-y:auto; }
    .apply-preview { background:#11141a; border:1px solid #2a2a32; border-radius:4px; padding:10px; font-family:Georgia, serif; line-height:1.55; max-height:50vh; overflow-y:auto; }
    .apply-para { display:flex; gap:10px; margin-bottom:8px; }
    .apply-para-num { color:#666; font-size:.7rem; min-width:24px; padding-top:3px; font-family:monospace; }
    .apply-para-text { flex:1; }
    .apply-para-new { background:#1f3320; padding:6px 8px; border-left:3px solid #6c6; border-radius:3px; }
</style>

@code {
    [Parameter] public string? BookId { get; set; }
    [Parameter] public string? ChapterId { get; set; }

    private List<Book> allBooks = new();
    private List<Chapter> bookChapters = new();
    private Book? book;
    private Chapter? chapter;

    private string pageTitle = "";
    private string pagePlain = "";
    private bool pageDirty;

    private string pendingMessage = "";
    private string error = "";
    private bool working;
    private List<TalkMessage> history = new();
    private List<string> resolvedEntities = new();

    protected override void OnParametersSet()
    {
        allBooks = Books.ListBooks();

        if (!string.IsNullOrEmpty(BookId))
        {
            book = Books.LoadBook(BookId);
            bookChapters = book == null
                ? new()
                : book.ChapterIds
                    .Select(Chapters.LoadChapter)
                    .Where(c => c != null)
                    .Cast<Chapter>()
                    .OrderBy(c => c.Number ?? int.MaxValue)
                    .ToList();
        }
        else { book = null; bookChapters = new(); }

        if (!string.IsNullOrEmpty(ChapterId))
        {
            chapter = Chapters.LoadChapter(ChapterId);
            if (chapter != null)
            {
                pageTitle = chapter.Title;
                pagePlain = chapter.PlainText;
                pageDirty = false;
            }
        }
        else { chapter = null; pageTitle = ""; pagePlain = ""; pageDirty = false; }
    }

    private void OnBookChanged(ChangeEventArgs e)
    {
        var newId = e.Value?.ToString() ?? "";
        Nav.NavigateTo(string.IsNullOrEmpty(newId) ? "/talk" : $"/talk/{newId}");
    }

    private void OnChapterChanged(ChangeEventArgs e)
    {
        var newId = e.Value?.ToString() ?? "";
        if (book == null) return;
        Nav.NavigateTo(string.IsNullOrEmpty(newId) ? $"/talk/{book.Id}" : $"/talk/{book.Id}/{newId}");
    }

    private async Task OnInputKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey) { await Send(); }
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(pendingMessage) || working) return;
        var msg = pendingMessage.Trim();
        pendingMessage = "";
        history.Add(new TalkMessage("user", msg));
        working = true;
        error = "";
        StateHasChanged();

        try
        {
            var turn = new TalkTurn(
                BookId:        book?.Id,
                ChapterId:     chapter?.Id,
                ChapterNumber: chapter?.Number,
                ChapterTitle:  pageTitle,
                ChapterPlain:  pagePlain,
                UserMessage:   msg,
                History:       history.SkipLast(1).ToList());

            resolvedEntities = Talker.ResolveMentionsForUi(turn).ToList();

            var assistantMsg = new TalkMessage("assistant", "");
            history.Add(assistantMsg);
            var sb = new System.Text.StringBuilder();
            await foreach (var piece in Talker.TalkStreamAsync(turn))
            {
                sb.Append(piece);
                history[^1] = new TalkMessage("assistant", sb.ToString());
                StateHasChanged();
                await Task.Yield();
            }
        }
        catch (Exception ex) { error = ex.Message; }
        finally { working = false; StateHasChanged(); }
    }

    // ── Apply panel state ────────────────────────────────────────────────────
    private bool applyPanelOpen;
    private string pendingApplyText = "";
    private int applyInsertIndex = -1; // -1 = end, 0 = top, N = after paragraph N
    private List<string> pageParagraphs = new();
    private List<PreviewParagraph> previewParagraphs = new();

    private record PreviewParagraph(string Text, bool IsNew);

    private void OpenApply(string text)
    {
        if (chapter == null) return;
        pendingApplyText = text;
        pageParagraphs = SplitParagraphs(pagePlain);
        applyInsertIndex = -1; // default: end
        RebuildPreview();
        applyPanelOpen = true;
    }

    private void CloseApply()
    {
        applyPanelOpen = false;
        pendingApplyText = "";
        previewParagraphs.Clear();
    }

    private void OnInsertIndexChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString() ?? "-1", out var idx)) applyInsertIndex = idx;
        RebuildPreview();
    }

    private void RebuildPreview()
    {
        var newPara = pendingApplyText.Trim();
        previewParagraphs = new List<PreviewParagraph>();
        if (applyInsertIndex == 0)
        {
            previewParagraphs.Add(new PreviewParagraph(newPara, true));
            foreach (var p in pageParagraphs) previewParagraphs.Add(new PreviewParagraph(p, false));
        }
        else if (applyInsertIndex < 0 || applyInsertIndex >= pageParagraphs.Count + 1)
        {
            foreach (var p in pageParagraphs) previewParagraphs.Add(new PreviewParagraph(p, false));
            previewParagraphs.Add(new PreviewParagraph(newPara, true));
        }
        else
        {
            for (int i = 0; i < pageParagraphs.Count; i++)
            {
                previewParagraphs.Add(new PreviewParagraph(pageParagraphs[i], false));
                if (i + 1 == applyInsertIndex) previewParagraphs.Add(new PreviewParagraph(newPara, true));
            }
        }
    }

    private void ConfirmApply()
    {
        if (string.IsNullOrEmpty(pendingApplyText)) { CloseApply(); return; }
        var rebuilt = previewParagraphs.Select(p => p.Text);
        pagePlain = string.Join("\n\n", rebuilt);
        pageDirty = true;
        CloseApply();
    }

    private static List<string> SplitParagraphs(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return new();
        return s.Split(new[] { "\n\n", "\r\n\r\n" }, StringSplitOptions.RemoveEmptyEntries)
                .Select(p => p.Trim())
                .Where(p => p.Length > 0)
                .ToList();
    }

    private async Task CopyToClipboard(string text)
    {
        await Task.Yield();
        // Browsers expose navigator.clipboard via JSInterop in upstream code; here we just no-op
        // to keep the page self-contained. The text is selectable in the chat for manual copy.
    }

    private void MarkPageDirty() => pageDirty = true;

    private void SaveChapter()
    {
        if (chapter == null) return;
        chapter.Title = string.IsNullOrWhiteSpace(pageTitle) ? "Untitled" : pageTitle.Trim();
        // Plain → simple HTML preserves paragraph breaks without forcing a rich editor.
        chapter.Html = string.Join("\n", pagePlain.Split('\n').Select(line =>
            string.IsNullOrWhiteSpace(line) ? "<p></p>" : $"<p>{System.Net.WebUtility.HtmlEncode(line)}</p>"));
        Chapters.SaveChapter(chapter);
        // Drop dossier caches so the next conversational turn sees the new prose.
        World.InvalidateAll();
        pageDirty = false;
    }
}
