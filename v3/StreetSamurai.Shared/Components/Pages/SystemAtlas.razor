@page "/atlas"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@inject SemanticIndexService SemIdx
@inject WorldGraphService Graph
@inject LastPromptStore Prompts

<div class="atlas-wrapper">
    <h3 class="text-danger mb-2"><i class="bi bi-book-half me-2"></i>System Atlas</h3>
    <p class="text-muted">
        How the writing engine fits together. The application takes the world (canon entities, world data,
        graph, map) and uses it to compose books — but the relationship runs both directions: prose written
        in a chapter can be promoted back to canon, and canon edits propagate forward into the books that
        depend on them.
    </p>

    @* ── The flow ─────────────────────────────────────────── *@
    <div class="atlas-section">
        <h5 class="text-info"><i class="bi bi-signpost-2 me-2"></i>The Flow</h5>
        <div class="atlas-flow">
            <div class="atlas-step">
                <div class="atlas-step-num">1</div>
                <strong>Bookshelf</strong>
                <code>/books</code>
                <p>Create a new book. Title, tagline, premise, arc target, protagonist(s). Lands directly on the outline editor.</p>
            </div>
            <div class="atlas-step">
                <div class="atlas-step-num">2</div>
                <strong>Outline</strong>
                <code>/books/{id}/outline</code>
                <p>The plot spine every chapter shares. Set chapter count (or absorb existing chapters), fill what matters, click <em>Fill Blanks</em> for the LLM to write the rest. Edit any detail and the system proposes adjustments to neighbor chapters — before for setup, after for consequence. Approve to lock.</p>
            </div>
            <div class="atlas-step">
                <div class="atlas-step-num">3</div>
                <strong>Write</strong>
                <code>/write/{bookId}</code>
                <p>Once the outline is approved, write prose chapter-by-chapter. The Beats panel proposes next-beat blurbs (10 expert personas at HIGH tier), ranks them with a 100-persona chaos↔order panel at LOW tier, and expands the chosen blurb into prose with continuity from prior beats. Drift detection (OOC voice + outline-vs-prose) writes to the findings sidebar.</p>
            </div>
            <div class="atlas-step">
                <div class="atlas-step-num">4</div>
                <strong>Editor</strong>
                <code>/stories/write/{id}</code>
                <p>Per-chapter editor with prev/next nav, beat tools, refinement, validation. The chapter holds beats, not just rendered HTML — beats persist so individual ones can be regenerated without rewriting the chapter.</p>
            </div>
            <div class="atlas-step">
                <div class="atlas-step-num">5</div>
                <strong>Review</strong>
                <span class="text-muted small">(button on chapters page)</span>
                <p>Multi-LLM Quorum reads every chapter together. Surfaces continuity gaps, dropped motifs, missing status carry-through, anaphoric callback opportunities. Each finding has Apply (uniqueness-checked text replacement) or Dismiss.</p>
            </div>
            <div class="atlas-step">
                <div class="atlas-step-num">6</div>
                <strong>Publish</strong>
                <span class="text-muted small">(dropdown on chapters page)</span>
                <p>EPUB (Calibre-ready → AZW3/MOBI/Kindle), standalone HTML (browser/PDF), or Markdown (diff/version-control).</p>
            </div>
        </div>
    </div>

    @* ── Bidirectional canon ↔ story ──────────────────── *@
    <div class="atlas-section">
        <h5 class="text-info"><i class="bi bi-arrow-left-right me-2"></i>Canon ↔ Story</h5>
        <div class="atlas-bidirectional">
            <div class="atlas-bid-col">
                <strong class="text-warning">Canon → Story</strong>
                <ul class="small">
                    <li>Director pulls character SpeechPatterns, psychology, behavioral fields into every beat prompt — POV character's voice shapes the prose</li>
                    <li>WorldGraph + Places + Factions feed BuildPhysicalContext / BuildCanonFacts</li>
                    <li>Literary rules (prohibitions, POV voice rules, register permissions) constrain output</li>
                    <li>Motif inventory threads recurring objects/phrases across chapters</li>
                </ul>
            </div>
            <div class="atlas-bid-col">
                <strong class="text-warning">Story → Canon</strong>
                <ul class="small">
                    <li>ContinuityExtractionService surfaces new (entity, predicate, object) claims from chapter prose AND entity records, flags contradictions, and applies the agreed value back to entity files</li>
                    <li>EntityExtractionService finds new named entities in chapters</li>
                    <li>Co-Writer drawer can propose canon edits during writing — challenges conflicts, lets user override and propagates</li>
                    <li>WorldGraph auto-rebuilds on detected canon-data drift (file mtime newer than graph)</li>
                </ul>
            </div>
        </div>
    </div>

    @* ── Hierarchy ─────────────────────────────────────── *@
    <div class="atlas-section">
        <h5 class="text-info"><i class="bi bi-diagram-3 me-2"></i>Content Hierarchy</h5>
        <pre class="atlas-tree">
Series              — multiple books that share continuity
└── Book            — premise / arc / theme; published unit; has BookOutline
    ├── BookOutline — shared plot spine; status: Draft → InReview → Approved
    │   ├── Premise / ArcTarget / Theme / Structure
    │   ├── Chapters[] — outline entries (synopsis, key beats, threads)
    │   └── Threads[] — book-level promises (planted_in / pays_off_in)
    └── Chapter     — the unit of generation (was StoryProject)
        ├── BookId / Number — cross-references
        ├── Synopsis / Html (rendered prose)
        └── Beats[] — persistent ChapterBeat (index, title, text, structure_role)</pre>
    </div>

    @* ── Subsystems ────────────────────────────────────── *@
    <div class="atlas-section">
        <h5 class="text-info"><i class="bi bi-grid-3x3-gap me-2"></i>Subsystems</h5>
        <div class="atlas-grid">
            @foreach (var s in subsystems)
            {
                <div class="atlas-card">
                    <div class="atlas-card-name">@s.Name</div>
                    <div class="atlas-card-role">@s.Role</div>
                    <div class="atlas-card-desc">@s.Description</div>
                    @if (!string.IsNullOrEmpty(s.SourcePath))
                    {
                        <code class="atlas-card-path">@s.SourcePath</code>
                    }
                </div>
            }
        </div>
    </div>

    @* ── LLM strategy ──────────────────────────────────── *@
    <div class="atlas-section">
        <h5 class="text-info"><i class="bi bi-robot me-2"></i>LLM Strategy</h5>
        <ul class="small">
            <li><strong>Single source for multi-LLM:</strong> <code>MindAttic.Legion.LlmVotingService</code>. No homebrew voting code in the project.</li>
            <li><strong>Quorum.Plurality</strong> for review pipelines (every voter contributes; aggregation by voter agreement).</li>
            <li><strong>Single-LLM creative</strong> for outline generation (multi-voter merge homogenizes; one voice produces tighter outlines).</li>
            <li><strong>Heuristic + LLM:</strong> WritingQualityService runs deterministic checks first (cheap), Quorum runs after (judgment). Findings merge into one report.</li>
            <li><strong>Co-Writer:</strong> single-LLM dialog with full book + canon context. Challenges conflicts; user-overridable; propagation handled by downstream services.</li>
        </ul>
    </div>

    @* ── CLI parity ────────────────────────────────────── *@
    <div class="atlas-section">
        <h5 class="text-info"><i class="bi bi-terminal me-2"></i>CLI</h5>
        <p class="small text-muted">Every book operation works headless. <code>dotnet run --project StreetSamurai.Blazor -- --book ...</code></p>
        <pre class="atlas-cli small">
--rebuild-graph                                       Rebuild world graph from canon
--write-story surpriseme [--protagonist NAME]         Generate one chapter
--write-story guideme --protagonist NAME --synopsis "..." [--beats N] [--format md|html] [-o file]
--refine-story &lt;projectId&gt; [-o notes.json]         Analyze a completed story
--book list                                           Every book + chapter count
--book new --title "..." [--tagline "..."] [--premise "..."] [--arc "..."] [--protagonist NAME]...
--book show &lt;id&gt;                                  Print book json
--book chapters &lt;id&gt;                              Print ordered chapter list
--book absorb &lt;id&gt; --chapter &lt;chapterId&gt;       Move a loose chapter into this book
--book review &lt;id&gt;                                Run multi-LLM review
--book apply &lt;id&gt; &lt;findingId&gt;                  Apply a review finding
--book export &lt;id&gt; [--format epub|html|md]        Export
--book delete &lt;id&gt;                                Archive</pre>
    </div>

    @* ── Routes ────────────────────────────────────────── *@
    <div class="atlas-section">
        <h5 class="text-info"><i class="bi bi-signpost me-2"></i>Routes</h5>
        <table class="table table-dark table-sm">
            <tr><td><code>/</code></td><td>Home tiles — Writing section dominant</td></tr>
            <tr><td><code>/books</code></td><td>Bookshelf</td></tr>
            <tr><td><code>/books/{id}</code></td><td>Redirects to /write/{id}</td></tr>
            <tr><td><code>/books/{id}/outline</code></td><td>Outline editor (autopilot, sticky TOC, propagation)</td></tr>
            <tr><td><code>/books/{id}/motifs</code></td><td>Motif management (registered + auto-detect proposals)</td></tr>
            <tr><td><code>/books/{id}/continuity-extract</code></td><td>Run continuity extraction across every chapter</td></tr>
            <tr><td><code>/write/{bookId}</code></td><td>Chapter editor — Chapters/Beats/Outline sidebar, findings sidebar, drift checks</td></tr>
            <tr><td><code>/write/{bookId}/{chapterId}</code></td><td>Editor focused on one chapter</td></tr>
            <tr><td><code>/publish/{bookId}</code></td><td>EPUB / HTML / Markdown export</td></tr>
            <tr><td><code>/publish/{bookId}/audio</code></td><td>TTS audiobook export</td></tr>
            <tr><td><code>/settings/ai</code></td><td>AI panel config (action voter counts + tiers, expert personas)</td></tr>
            <tr><td><code>/series</code></td><td>Series shelf</td></tr>
            <tr><td><code>/atlas</code></td><td>This page</td></tr>
        </table>
    </div>

    @* ── Storage ───────────────────────────────────────── *@
    <div class="atlas-section">
        <h5 class="text-info"><i class="bi bi-hdd me-2"></i>Storage</h5>
        <pre class="atlas-tree">
engine/data/
├── books/
│   ├── {bookId}.json              — book record
│   ├── {bookId}.outline.json      — book outline (shared plot)
│   ├── {bookId}.review.json       — last book review report
│   └── {bookId}.motifs.json       — motif inventory
├── series/
│   └── {seriesId}.json
├── chapters/                      — one folder per chapter
│   └── {chapterId}/
│       ├── chapter.json           — Chapter (HTML + Beats + BookId + Number)
│       ├── checkpoint.json        — generation state
│       ├── outline.json           — per-chapter outline
│       ├── events.json            — event log
│       └── knowledge.json         — knowledge map
├── people/                        — character canon
├── places/ factions/ CorpoNations/ subsidiaries/ ...
├── graph/world_graph.json         — auto-rebuilds on canon drift
└── exports/                       — EPUB / HTML / Markdown outputs</pre>
    </div>

    @* ── Semantic Index Diagnostics ────────────────────── *@
    <div class="atlas-section">
        <h5 class="text-info"><i class="bi bi-radar me-2"></i>Semantic Index</h5>
        <p class="text-muted small">
            TF-IDF over every world graph node. <code>NarrativeSessionContext.ScanTextSemantic</code> queries this to pull
            thematically related entities into chapter prompts. If the index is cold or empty,
            generation prompts won't see relevance-gated canon.
        </p>
        <div class="atlas-stat-row">
            <div class="atlas-stat"><div class="atlas-stat-num">@SemIdx.IndexedCount</div><div class="atlas-stat-lbl">indexed nodes</div></div>
            <div class="atlas-stat"><div class="atlas-stat-num">@(SemIdx.IsBuilt ? "built" : "cold")</div><div class="atlas-stat-lbl">state</div></div>
            <div class="atlas-stat"><div class="atlas-stat-num">@Graph.AllNodes().Count()</div><div class="atlas-stat-lbl">graph nodes</div></div>
            <button class="btn btn-sm btn-outline-secondary align-self-start" @onclick="RebuildIdx">
                <i class="bi bi-arrow-clockwise me-1"></i>Rebuild
            </button>
        </div>
        <div class="d-flex gap-2 mt-3">
            <input class="form-control form-control-sm bg-black text-light border-secondary"
                   placeholder="Try: corporate betrayal, brick-wall notebook, samurai code, the noodle shop forgives"
                   @bind="searchQuery" @bind:event="oninput" @onkeydown="OnSearchKey" />
            <button class="btn btn-sm btn-info" @onclick="RunSearch" disabled="@string.IsNullOrWhiteSpace(searchQuery)">
                <i class="bi bi-search me-1"></i>Search
            </button>
        </div>
        @if (searchResults.Count > 0)
        {
            <div class="atlas-results mt-2">
                @foreach (var (id, score, name, type) in searchResults)
                {
                    <div class="atlas-result">
                        <div class="d-flex align-items-baseline gap-2">
                            <span class="text-info fw-bold">@name</span>
                            <span class="text-muted small">@type</span>
                            <span class="ms-auto text-warning small">@score.ToString("0.000")</span>
                            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => ToggleTerms(id)" title="Top distinctive terms">
                                <i class="bi bi-tag"></i>
                            </button>
                        </div>
                        @if (expandedTerms == id)
                        {
                            <div class="atlas-terms">
                                @foreach (var (term, w) in SemIdx.GetTopTerms(id, 12))
                                {
                                    <span class="atlas-term">@term <span class="text-muted">(@w.ToString("0.00"))</span></span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else if (searchTried)
        {
            <div class="text-muted small mt-2">No hits above noise threshold.</div>
        }
    </div>

    @* ── Last LLM Prompts ──────────────────────────────── *@
    <div class="atlas-section">
        <div class="d-flex align-items-center mb-1">
            <h5 class="text-info mb-0 flex-grow-1"><i class="bi bi-chat-square-text me-2"></i>Last LLM Prompts</h5>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => { Prompts.Clear(); StateHasChanged(); }" disabled="@(Prompts.Snapshot().Count == 0)">
                <i class="bi bi-trash me-1"></i>Clear
            </button>
        </div>
        <p class="text-muted small">
            The last @Prompts.Capacity prompts dispatched through <code>LlmRouter</code>.
            Read the system+user payload to verify whether entity context is filtered by relevance or dumped wholesale.
        </p>
        @{ var snapshot = Prompts.Snapshot(); }
        @if (snapshot.Count == 0)
        {
            <div class="text-muted small">No prompts captured yet. Generate a chapter beat or run a review to populate.</div>
        }
        else
        {
            <div class="atlas-prompts">
                @for (int i = 0; i < snapshot.Count; i++)
                {
                    var p = snapshot[i];
                    var idx = i;
                    <div class="atlas-prompt">
                        <div class="d-flex align-items-baseline gap-2 atlas-prompt-head" @onclick="() => ToggleExpand(idx)">
                            <span class="text-warning small">@p.At.ToString("HH:mm:ss")</span>
                            <span class="text-info small">@p.Provider/@p.Model</span>
                            <span class="text-muted small">temp @p.Temperature.ToString("0.0") · max @p.MaxTokens</span>
                            <span class="text-muted small">sys @p.System.Length · usr @p.User.Length chars</span>
                            @if (p.ElapsedMs.HasValue)
                            {
                                <span class="text-muted small">@p.ElapsedMs ms</span>
                            }
                            <i class="bi @(expandedPrompt == idx ? "bi-chevron-down" : "bi-chevron-right") ms-auto"></i>
                        </div>
                        @if (expandedPrompt == idx)
                        {
                            <div class="atlas-prompt-body">
                                <div class="atlas-prompt-label">SYSTEM</div>
                                <pre class="atlas-prompt-text">@p.System</pre>
                                <div class="atlas-prompt-label">USER</div>
                                <pre class="atlas-prompt-text">@p.User</pre>
                                @if (!string.IsNullOrEmpty(p.Response))
                                {
                                    <div class="atlas-prompt-label">RESPONSE</div>
                                    <pre class="atlas-prompt-text">@p.Response</pre>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .atlas-wrapper { max-width: 1100px; }
    .atlas-section { margin: 28px 0; }
    .atlas-section h5 { margin-bottom: 14px; padding-bottom: 8px; border-bottom: 1px solid #2a2a2a; }
    .atlas-flow { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px; }
    .atlas-step {
        background: #0a0a0a;
        border: 1px solid #2a2a2a;
        border-left: 3px solid #c00;
        padding: 12px 14px;
        position: relative;
    }
    .atlas-step-num {
        position: absolute;
        top: -10px; left: -10px;
        width: 24px; height: 24px;
        background: #c00;
        color: #000;
        font-weight: bold;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
    }
    .atlas-step strong { color: #ff8888; }
    .atlas-step code { color: #888; font-size: 0.8rem; display: block; margin: 4px 0; }
    .atlas-step p { font-size: 0.85rem; color: #ccc; margin: 6px 0 0; line-height: 1.4; }

    .atlas-bidirectional { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .atlas-bid-col { background: #0a0a0a; border: 1px solid #2a2a2a; padding: 12px 14px; }
    .atlas-bid-col ul { margin: 8px 0 0; padding-left: 20px; color: #ccc; }
    .atlas-bid-col li { margin-bottom: 6px; }

    .atlas-tree { background: #0a0a0a; border: 1px solid #2a2a2a; padding: 14px; font-size: 0.85rem; color: #ccc; line-height: 1.5; }
    .atlas-cli { background: #0a0a0a; border: 1px solid #2a2a2a; padding: 14px; color: #ccc; }

    .atlas-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 10px; }
    .atlas-card { background: #0a0a0a; border: 1px solid #2a2a2a; border-top: 2px solid #0dcaf0; padding: 10px 12px; font-size: 0.85rem; }
    .atlas-card-name { color: #0dcaf0; font-weight: bold; margin-bottom: 2px; }
    .atlas-card-role { color: #888; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 6px; }
    .atlas-card-desc { color: #ccc; margin-bottom: 8px; line-height: 1.4; }
    .atlas-card-path { color: #666; font-size: 0.7rem; }

    .atlas-stat-row { display: flex; gap: 12px; align-items: center; }
    .atlas-stat { background: #0a0a0a; border: 1px solid #2a2a2a; padding: 8px 14px; min-width: 110px; text-align: center; }
    .atlas-stat-num { color: #0dcaf0; font-size: 1.4rem; font-weight: bold; line-height: 1.1; }
    .atlas-stat-lbl { color: #888; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; }
    .atlas-results { background: #0a0a0a; border: 1px solid #2a2a2a; padding: 8px 12px; }
    .atlas-result { padding: 6px 0; border-bottom: 1px solid #1a1a1a; }
    .atlas-result:last-child { border-bottom: none; }
    .atlas-terms { margin-top: 6px; display: flex; flex-wrap: wrap; gap: 6px; }
    .atlas-term { background: #1a1a1a; border: 1px solid #2a2a2a; padding: 2px 8px; font-size: 0.75rem; color: #ccc; }

    .atlas-prompts { display: flex; flex-direction: column; gap: 6px; }
    .atlas-prompt { background: #0a0a0a; border: 1px solid #2a2a2a; }
    .atlas-prompt-head { padding: 8px 12px; cursor: pointer; }
    .atlas-prompt-head:hover { background: #141414; }
    .atlas-prompt-body { padding: 10px 12px; border-top: 1px solid #1a1a1a; }
    .atlas-prompt-label { color: #c00; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; margin-top: 6px; margin-bottom: 4px; }
    .atlas-prompt-text { background: #060606; border: 1px solid #1a1a1a; padding: 8px 10px; color: #ccc; font-size: 0.78rem; white-space: pre-wrap; max-height: 320px; overflow-y: auto; margin: 0; }
</style>

@code {
    private string searchQuery = "";
    private bool searchTried;
    private List<(string id, double score, string name, string type)> searchResults = [];
    private string? expandedTerms;
    private int? expandedPrompt;

    private void RunSearch()
    {
        searchTried = true;
        searchResults.Clear();
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        foreach (var (id, score) in SemIdx.Search(searchQuery, 12))
        {
            var node = Graph.GetNode(id);
            if (node == null) continue;
            searchResults.Add((id, score, node.Name, node.NodeType));
        }
    }

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") RunSearch();
    }

    private void ToggleTerms(string id) => expandedTerms = expandedTerms == id ? null : id;

    private void ToggleExpand(int idx) => expandedPrompt = expandedPrompt == idx ? null : idx;

    private void RebuildIdx()
    {
        SemIdx.RebuildIndex();
        searchResults.Clear();
        searchTried = false;
    }

    private record Subsystem(string Name, string Role, string Description, string SourcePath);

    private readonly List<Subsystem> subsystems =
    [
        new("BookOutlineService", "Plot Spine",
            "Shared book-level outline. Autosyncs to chapter list. Generates with Surprise+Guide combined. Reconsiders neighbor chapters when one is edited. Gates prose generation behind Approval.",
            "Core/Services/BookOutlineService.cs"),
        new("BookReviewService", "Multi-LLM Quorum Review",
            "Reads all chapters together. Surfaces continuity / motif / status / anaphora / first-line / paragraph-service / tension / voice-cadence findings. Apply-edit with uniqueness check.",
            "Core/Services/BookReviewService.cs"),
        new("WritingQualityService", "Heuristic Checks",
            "Pre-LLM deterministic pass: first-line audit, tension delta, paragraph-serves, voice fingerprint Jaccard. Cheap, complementary to Quorum.",
            "Core/Services/WritingQualityService.cs"),
        new("MotifService", "Recurring Threads",
            "Per-book motif inventory. Auto-proposes candidates from chapter prose (italicized recurring phrases, capitalized named objects). User confirms before planting.",
            "Core/Services/MotifService.cs"),
        new("BookExportService", "Publishable Output",
            "Builds Calibre-ready EPUB (mimetype-first, OPF spine, TOC), standalone HTML, or Markdown. Drops in engine/exports/ — drag into Calibre for Kindle conversion.",
            "Core/Services/BookExportService.cs"),
        new("CoWriterService", "Collaborative Dialog",
            "Always-on chat with full book + canon context. Challenges conflicts (\"this contradicts X — override or revise?\"). Proposes outline / chapter / canon edits as confirmable actions.",
            "Core/Services/CoWriterService.cs"),
        new("StoryDirectorService", "Beat Generator",
            "Per-chapter prose generation. Pulls outline context, POV voice rubric, character canon, world graph, motif inventory. Wired to LlmVotingService for review-quality checks.",
            "Core/Services/StoryDirectorService.cs"),
        new("WorldGraphService", "Entity Network",
            "QuikGraph in-memory. Append-mode for runtime relationship adds. EnsureFresh detects canon-file drift via mtime and auto-rebuilds. Persisted to engine/data/graph/world_graph.json.",
            "Core/Services/WorldGraphService.cs"),
        new("LlmVotingService", "Multi-LLM Backbone",
            "Sourced from MindAttic.Legion (singular project for multi-LLM). VoteAsync + ScoreAsync with Quorum thresholds. No homebrew voting in the project.",
            "MindAttic.Legion/Services/LlmVotingService.cs"),
        new("ContinuityService + ContinuityExtractionService + ContinuityApplyService", "Unified Truth Loop",
            "One SQLite store of atomic (entity, predicate, object) claims. Extraction reads chapter prose AND entity records via Legion Quorum; contradictions flagged automatically; resolution flow picks a winner; ContinuityApplyService uses Legion.DecideAsync to write the agreed value back to the entity file (the source of truth).",
            "Core/Services/ContinuityService.cs"),
        new("ContinuityValidatorService", "Hard-Break Detection",
            "Catches injuries that vanish, characters teleporting, timeline contradictions. Runs as part of review.",
            "Core/Services/ContinuityValidatorService.cs"),
        new("StoryQualityService", "Scored Quality Rubric",
            "Multi-dimensional scoring (voice, moral complexity, pacing, character authenticity, world specificity, cliché avoidance, dialogue). Failure patterns feed back into future prompts.",
            "Core/Services/StoryQualityService.cs"),
