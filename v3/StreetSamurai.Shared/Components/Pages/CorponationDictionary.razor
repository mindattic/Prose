@page "/corps"
@inject CorponationRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject WorldGraphService Graph

<div class="dict-layout">
    <div class="dict-list bg-dark border-end border-secondary">
        @foreach (var c in _items)
        {
            <div class="list-item text-light @(_editing?.Name == c.Name ? "active" : "")" @onclick="() => Edit(c)">
                <div class="fw-bold small">@c.Name</div>
                <div class="text-muted" style="font-size: 0.7rem;">@c.Sector</div>
            </div>
        }
        <div class="p-2">
            <button class="btn btn-sm btn-outline-danger w-100" @onclick="AddNew"><i class="bi bi-plus-lg"></i> New Corponation</button>
        </div>
    </div>

    <div class="dict-editor">
        @if (_editing != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-danger mb-0">@(_isNew ? "New Corponation" : _editing.Name)</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i> Save</button>
                    @if (!_isNew && !_confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-trash3"></i></button> }
                    @if (_confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete">Confirm</button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false">No</button> }
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-4"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Name" /></div>
                <div class="col-4"><div class="field-label">Sector</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Sector" /></div>
                <div class="col-4"><div class="field-label">Valuation</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Valuation" /></div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-4"><div class="field-label">Full Legal Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.FullLegalName" /></div>
                <div class="col-4"><div class="field-label">Sovereign Territory</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.SovereignTerritory" /></div>
                <div class="col-4"><div class="field-label">Security Force</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.SecurityForce" /></div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-4"><div class="field-label">Stock Designation</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.StockDesignation" /></div>
                <div class="col-4"><div class="field-label">Revenue</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Revenue" /></div>
                <div class="col-4"><div class="field-label">Employees</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Employees" /></div>
            </div>

            <div class="mb-3"><div class="field-label">Key Detail</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.KeyDetail"></textarea></div>
            <div class="mb-3"><div class="field-label">Founding Story</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.FoundingStory"></textarea></div>
            <div class="mb-3"><div class="field-label">Relationship to Big 20</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.RelationshipToBig20"></textarea></div>
            <div class="mb-3"><div class="field-label">Full Text</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.FullText"></textarea></div>
        }
        else { <div class="text-muted d-flex align-items-center justify-content-center h-100">Select a corponation or create a new one</div> }
    </div>
</div>

@code {
    private List<CorponationData> _items = [];
    private CorponationData? _editing;
    private bool _isNew, _confirmDelete;
    private string _originalName = "";
    protected override void OnInitialized() { Repo.Reload(); _items = Repo.GetAll(); if (Nav.Uri.Contains("new=true")) AddNew(); }
    private void AddNew() { _editing = new CorponationData(); _isNew = true; _confirmDelete = false; }
    private void Edit(CorponationData c) { _editing = c; _originalName = c.Name; _isNew = false; _confirmDelete = false; }
    private void SaveEdit() { if (_editing == null || string.IsNullOrWhiteSpace(_editing.Name)) return; if (!_isNew && _originalName != _editing.Name) Repo.Delete(_originalName); Repo.Save(_editing); _editing = null; _items = Repo.GetAll(); }
    private void DoDelete() { if (_editing == null) return; Graph.RemoveNode(_editing.Name); Repo.Delete(_editing.Name); _editing = null; _confirmDelete = false; _items = Repo.GetAll(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { await JS.InvokeVoidAsync("writeInterop.autoResizeAll"); }
}
