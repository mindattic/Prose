@page "/corps"
@inject CorponationRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject WorldGraphService Graph

<div class="dict-layout">
    <div class="dict-list">
        <div class="card bg-dark text-light border-secondary mb-2 card-body">
            <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary mb-2"
                   placeholder="Filter..." @bind="filter" @bind:event="oninput" />
            <div class="d-flex gap-2">
            <ExportButton Mode="repo" ExtraStyle="flex:1;" RepoName="Corponations" GetRepoEntries="GetExportEntries" />
            <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="AddNew"><i class="bi bi-plus-lg"></i> New</button>
            </div>
        </div>
        <div class="dict-items">
            @foreach (var c in FilteredItems)
            {
                <div class="list-item text-light @(editing?.Name == c.Name ? "active" : "")" @onclick="() => Edit(c)">
                    <div class="fw-bold small">@c.Name</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@c.Sector</div>
                </div>
            }
        </div>
    </div>

    <div class="dict-editor">
        @if (editing != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-danger mb-0">@(isNew ? "New Corponation" : editing.Name)</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i> Save</button>
                    @if (!isNew) { <ExportButton Mode="entry" RepoName="Corponations" EntryName="@editing.Name" EntryJson="@System.Text.Json.JsonSerializer.Serialize(editing)" /> }
                    @if (!isNew && !_confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-trash3"></i></button> }
                    @if (_confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete">Confirm</button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false">No</button> }
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-4"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Name" /></div>
                <div class="col-4"><div class="field-label">Sector</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Sector" /></div>
                <div class="col-4"><div class="field-label">Valuation</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Valuation" /></div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-4"><div class="field-label">Full Legal Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.FullLegalName" /></div>
                <div class="col-4"><div class="field-label">Sovereign Territory</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.SovereignTerritory" /></div>
                <div class="col-4"><div class="field-label">Security Force</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.SecurityForce" /></div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-4"><div class="field-label">Stock Designation</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.StockDesignation" /></div>
                <div class="col-4"><div class="field-label">Revenue</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Revenue" /></div>
                <div class="col-4"><div class="field-label">Employees</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Employees" /></div>
            </div>

            <div class="mb-3"><div class="field-label">Key Detail</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.KeyDetail"></textarea></div>
            <div class="mb-3"><div class="field-label">Founding Story</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.FoundingStory"></textarea></div>
            <div class="mb-3"><div class="field-label">Relationship to Big 20</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.RelationshipToBig20"></textarea></div>
            <div class="mb-3"><div class="field-label">Full Text</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.FullText"></textarea></div>
        }
        else { <div class="text-muted d-flex align-items-center justify-content-center h-100">Select a corponation or create a new one</div> }
    </div>
</div>

@code {
    private List<CorponationData> items = [];
    private CorponationData? editing;
    private bool isNew, _confirmDelete;
    private string originalName = "";
    private string filter = "";

    private IEnumerable<CorponationData> FilteredItems => string.IsNullOrWhiteSpace(filter)
        ? items
        : items.Where(c => c.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || c.Sector.Contains(filter, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized() { Repo.Reload(); items = Repo.GetAll(); if (Nav.Uri.Contains("new=true")) AddNew(); }
    private void AddNew() { editing = new CorponationData(); isNew = true; _confirmDelete = false; }
    private void Edit(CorponationData c) { editing = c; originalName = c.Name; isNew = false; _confirmDelete = false; }
    private void SaveEdit() { if (editing == null || string.IsNullOrWhiteSpace(editing.Name)) return; if (!isNew && originalName != editing.Name) Repo.Delete(originalName); Repo.Save(editing); editing = null; items = Repo.GetAll(); }
    private void DoDelete() { if (editing == null) return; Graph.RemoveNode(editing.Name); Repo.Delete(editing.Name); editing = null; _confirmDelete = false; items = Repo.GetAll(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { await JS.InvokeVoidAsync("writeInterop.autoResizeAll"); }
    private List<(string name, string json)> GetExportEntries() => items.Select(e => (e.Name, System.Text.Json.JsonSerializer.Serialize(e))).ToList();
}
