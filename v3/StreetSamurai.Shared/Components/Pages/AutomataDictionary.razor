@page "/automata"
@inject AutomatonRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject WorldGraphService Graph

<div class="dict-layout">
    <div class="dict-list">
        <div class="card bg-dark text-light border-secondary mb-2 card-body">
            <FilterBar AllTags="allTags" @bind-Filter="filter" SelectedTags="selectedTags" SelectedTagsChanged="OnTagsChanged" />

        </div>
        <div class="dict-items">
            @foreach (var a in SortedItems)
            {
                <div class="list-item text-light @(editing?.Name == a.Name ? "active" : "")" @onclick="() => Edit(a)">
                    <div class="fw-bold small">@a.Name</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@a.Classification</div>
                </div>
            }
        </div>
    </div>

    <div class="dict-editor">
        @if (editing != null)
        {
            <EditViewToggle RepoName="automata" Title="@(isNew ? "New Automaton" : editing.Name)" Json="@System.Text.Json.JsonSerializer.Serialize(editing)" HideToggle="@_confirmDelete" Rating="@(editing?.Rating ?? 0)" RatingChanged="OnRatingChanged">
                <HeaderButtons>
                    @if (!_confirmDelete)
                    {
                        <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i><div class="btn-lbl"> Save</div></button>
                        @if (!isNew) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-archive"></i></button> }
                    }
                    else
                    {
                        <span class="small text-muted me-1">Archive Entry?</span>
                        <button class="btn btn-sm btn-danger" @onclick="DoDelete"><div class="btn-lbl">Yes</div></button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false"><div class="btn-lbl">No</div></button>
                    }
                </HeaderButtons>
                <ChildContent>
                    <div class="row g-3 mb-3">
                        <div class="col-3"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Name" /></div>
                        <div class="col-3"><div class="field-label">Classification</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Classification" /></div>
                        <div class="col-3"><div class="field-label">Manufacturer</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Manufacturer" /></div>
                        <div class="col-3"><div class="field-label">Tier Availability</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.TierAvailability" /></div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-3"><div class="field-label">Legality</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Legality" /></div>
                        <div class="col-3"><div class="field-label">Autonomy Level</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.AutonomyLevel" /></div>
                        <div class="col-3"><div class="field-label">Dimensions</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Dimensions" /></div>
                        <div class="col-3"><div class="field-label">Weight</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Weight" /></div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-4"><div class="field-label">Power Source</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.PowerSource" /></div>
                        <div class="col-4"><div class="field-label">Locomotion</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Locomotion" /></div>
                        <div class="col-4"><div class="field-label">Aliases (comma-sep)</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_aliasInput" /></div>
                    </div>
                    <div class="mb-3"><div class="field-label">Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.Description"></textarea></div>
                    <div class="mb-3"><div class="field-label">Countermeasures</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.Countermeasures"></textarea></div>
                    <div class="mb-3"><div class="field-label">Cultural Context</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.CulturalContext"></textarea></div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <div style="flex: 1; min-width: 200px;"><div class="field-label">Armament (one per line)</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editArmament"></textarea></div>
                        <div style="flex: 1; min-width: 200px;"><div class="field-label">Sensors (one per line)</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editSensors"></textarea></div>
                    </div>
                    <div class="mb-3"><div class="field-label">Known Deployments (one per line)</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editKnownDeployments"></textarea></div>
                    <div class="mb-3"><div class="field-label">Story Hooks (one per line)</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editStoryHooks"></textarea></div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <div style="flex: 1; min-width: 200px;"><div class="field-label">Image Prompt</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.MidjourneyPrompt"></textarea></div>
                        <div style="flex: 1; min-width: 200px;"><div class="field-label">DALL-E 3 Prompt</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.Dalle3Prompt"></textarea></div>
                    </div>
                </ChildContent>
            </EditViewToggle>
        }
        else { <div class="text-muted d-flex align-items-center justify-content-center h-100">Select an automaton or create a new one</div> }
    </div>
</div>

@code {
    private List<AutomatonData> items = [];
    private AutomatonData? editing;
    private bool isNew, _confirmDelete;
    private string originalName = "", _aliasInput = "";
    private string filter = "";
    private List<(string name, int count)> allTags = [];
    private HashSet<string> selectedTags = [];
    private string editArmament = "", editSensors = "", editKnownDeployments = "", editStoryHooks = "";

    private List<AutomatonData> FilteredItems
    {
        get
        {
            IEnumerable<AutomatonData> result = items;
            if (!string.IsNullOrWhiteSpace(filter))
                result = result.Where(a => a.Name.Contains(filter, StringComparison.OrdinalIgnoreCase));
            if (selectedTags.Count > 0)
                result = result.Where(a => selectedTags.All(t => a.Tags.Contains(t)));
            return result.ToList();
        }
    }
    private List<AutomatonData> SortedItems => FilteredItems.OrderBy(x => x.Name).ToList();

    protected override void OnInitialized() { Repo.Reload(); items = Repo.GetAll(); RebuildTags(); if (Nav.Uri.Contains("new=true")) AddNew(); else { var qid = Nav.Uri.Contains("id=") ? Uri.UnescapeDataString(Nav.Uri.Split(new[]{"id="}, StringSplitOptions.None).Last().Split(new[]{"&"}, StringSplitOptions.None)[0]) : ""; if (!string.IsNullOrEmpty(qid)) { var t = items.FirstOrDefault(e => e.Id == qid); if (t != null) Edit(t); } } }
    private void RebuildTags() { allTags = items.SelectMany(x => x.Tags).GroupBy(t => t).Select(g => (g.Key, g.Count())).OrderBy(t => t.Key).ToList(); }
    private void OnTagsChanged(HashSet<string> tags) { selectedTags = tags; }
    private void AddNew() { editing = new AutomatonData(); isNew = true; _confirmDelete = false; _aliasInput = ""; editArmament = ""; editSensors = ""; editKnownDeployments = ""; editStoryHooks = ""; }
    private void Edit(AutomatonData a) { _ = JS.InvokeVoidAsync("localStorage.setItem", "ss_sel_automata", a.Id); editing = a; originalName = a.Name; isNew = false; _confirmDelete = false; _aliasInput = string.Join(", ", a.Aliases); editArmament = string.Join("\n", a.Armament); editSensors = string.Join("\n", a.Sensors); editKnownDeployments = string.Join("\n", a.KnownDeployments); editStoryHooks = string.Join("\n", a.StoryHooks); if (!Nav.Uri.Contains("id=" + a.Id)) Nav.NavigateTo(Nav.Uri.Split('?')[0] + "?id=" + a.Id, forceLoad: false); }
    private void SaveEdit()
    {
        if (editing == null || string.IsNullOrWhiteSpace(editing.Name)) return;
        editing.Aliases = _aliasInput.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        editing.Armament = editArmament.Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        editing.Sensors = editSensors.Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        editing.KnownDeployments = editKnownDeployments.Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        editing.StoryHooks = editStoryHooks.Split('\n', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        if (!isNew && originalName != editing.Name) Repo.Delete(originalName);
        Repo.Save(editing); editing = null; items = Repo.GetAll();
    }
    private void DoDelete() { if (editing == null) return; Graph.RemoveNode(editing.Name); Repo.Delete(editing.Name); editing = null; _confirmDelete = false; items = Repo.GetAll(); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("writeInterop.autoResizeAll");
        if (firstRender && editing == null && items.Count > 0 && !Nav.Uri.Contains("new=true") && !Nav.Uri.Contains("id="))
        {
            var lastId = "";
            try { lastId = await JS.InvokeAsync<string>("localStorage.getItem", "ss_sel_automata") ?? ""; } catch { }
            var target = (!string.IsNullOrEmpty(lastId) ? items.FirstOrDefault(x => x.Id == lastId) : null) ?? items.First();
            if (target != null) { Edit(target); StateHasChanged(); }
        }
    }
    private List<(string name, string json)> GetExportEntries() => items.Select(e => (e.Name, System.Text.Json.JsonSerializer.Serialize(e))).ToList();
    private void OnRatingChanged(double value) { if (editing == null) return; editing.Rating = value; Repo.Save(editing); }
}