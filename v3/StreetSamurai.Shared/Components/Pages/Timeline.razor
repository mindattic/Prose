@page "/timeline"
@attribute [Authorize]
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using StreetSamurai.Core.Data
@using StreetSamurai.Core.Data.Entities
@using StreetSamurai.Core.Interfaces
@using StreetSamurai.Core.Services
@inject WorldClockService Clock
@inject WorldStateLedger Ledger
@inject LocationContradictionService ContradictionScan
@inject IBookRepository Books
@inject IChapterRepository Chapters
@inject IDbContextFactory<StreetSamuraiDbContext> Db
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0"><i class="bi bi-clock-history text-info me-2"></i>Story Timeline</h4>
            <div class="text-muted small">
                vis-timeline · drag the <span class="text-danger">NOW</span> marker · double-click empty axis to snap · ctrl-scroll to zoom · click a dot to inspect
            </div>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">Story-time now:</span>
            <input type="datetime-local" step="1"
                   class="form-control form-control-sm bg-dark text-light border-secondary"
                   style="width: 220px;"
                   value="@FormatLocal(currentNow)"
                   @onchange="OnNowInputChanged" />
            <button class="btn btn-sm btn-outline-info" @onclick="OnZoomToFit">
                <i class="bi bi-arrows-fullscreen"></i> fit
            </button>
            <button class="btn btn-sm btn-outline-info" @onclick="RescanContradictions">
                <i class="bi bi-search me-1"></i>scan contradictions
            </button>
        </div>
    </div>

    @if (events.Count == 0)
    {
        <div class="alert alert-secondary">
            No timeline events yet. Set <code>Chapter.InWorldDate</code> or
            <code>ChapterBeat.InWorldDate</code> on at least one chapter,
            or run <code>ss --repair --backfill-dates</code> to seed them via LLM.
        </div>
    }

    <div id="story-timeline" class="story-timeline-canvas"></div>

    <div class="row g-3 mt-2">
        <div class="col-md-12 mb-2">
            <div class="card bg-dark border-secondary">
                <div class="card-header small text-muted d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-person-badge me-1"></i>Per-entity snapshot at @FormatLocal(snapshotAt)</span>
                    <div class="d-flex align-items-center gap-2">
                        <input class="form-control form-control-sm bg-dark text-light border-secondary"
                               style="width: 220px;"
                               placeholder="character name…"
                               @bind="entityPickerName"
                               @bind:event="oninput"
                               @onkeyup="OnEntityPickerKey" />
                        <button class="btn btn-sm btn-outline-info" @onclick="OnPickEntity">
                            <i class="bi bi-search"></i>
                        </button>
                        @if (selectedEntityName != null)
                        {
                            <span class="text-muted small">→ @selectedEntityName</span>
                        }
                    </div>
                </div>
                <div class="card-body p-2 small" style="max-height: 220px; overflow-y: auto;">
                    @if (selectedEntityId == null)
                    {
                        <div class="text-muted">
                            Type a character / entity name and press Enter to see every aspect's most-recent value as of the cursor.
                            Each row is the latest <code>EntityStateEvent</code> at-or-before <code>@FormatLocal(snapshotAt)</code>.
                        </div>
                    }
                    else if (entitySnapshot.Count == 0)
                    {
                        <div class="text-muted">
                            No state-ledger events for @selectedEntityName at this instant. The ledger fills as
                            chapters are saved (BeatStateExtractor) or via <code>ss --repair --extract-state</code>.
                        </div>
                    }
                    else
                    {
                        <div class="row g-2">
                            @foreach (var kv in entitySnapshot.OrderBy(p => p.Key))
                            {
                                <div class="col-md-4">
                                    <div class="border border-secondary rounded p-2 bg-black bg-opacity-25">
                                        <div class="text-info small">@kv.Key</div>
                                        <div>
                                            <span class="badge @VerbBadge(kv.Value.Verb) me-1">@kv.Value.Verb</span>
                                            <span>@(kv.Value.NewValue ?? kv.Value.Delta?.ToString() ?? "—")</span>
                                        </div>
                                        <div class="text-muted" style="font-size:.65rem;">@FormatLocal(kv.Value.AtStoryTime)</div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card bg-dark border-secondary">
                <div class="card-header small text-muted d-flex justify-content-between">
                    <span><i class="bi bi-cone-striped me-1"></i>World state at @FormatLocal(snapshotAt)</span>
                    <span>@worldEventsAtPoint.Count event(s) within ±6h</span>
                </div>
                <div class="card-body p-2 small" style="max-height: 320px; overflow-y: auto;">
                    @if (worldEventsAtPoint.Count == 0)
                    {
                        <div class="text-muted">
                            No state-ledger events near this instant. As chapters are saved,
                            <code>BeatStateExtractor</code> populates the ledger automatically;
                            run <code>ss --repair --extract-state</code> to backfill.
                        </div>
                    }
                    else
                    {
                        @foreach (var ev in worldEventsAtPoint)
                        {
                            <div class="mb-2 pb-2 border-bottom border-secondary">
                                <div>
                                    <span class="badge @VerbBadge(ev.Verb) me-2">@ev.Verb</span>
                                    <strong>@(entityNameById.TryGetValue(ev.EntityId, out var nm) ? nm : ev.EntityId.ToString("N").Substring(0, 8))</strong>
                                    <span class="text-muted"> · </span>
                                    <code>@ev.AspectKey</code>
                                </div>
                                <div class="text-muted small">
                                    @if (!string.IsNullOrEmpty(ev.OldValue)) { <span><span class="text-secondary">@ev.OldValue</span> → </span> }
                                    <span class="text-info">@(ev.NewValue ?? (ev.Delta?.ToString() ?? ""))</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(ev.Snippet))
                                {
                                    <div class="text-muted small fst-italic">"@ev.Snippet"</div>
                                }
                                <div class="text-muted small">@FormatLocal(ev.AtStoryTime)</div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card bg-dark border-secondary">
                <div class="card-header small text-muted d-flex justify-content-between">
                    <span><i class="bi bi-exclamation-triangle text-warning me-1"></i>Cross-book contradictions</span>
                    @if (contradictionScan != null)
                    {
                        <span>@contradictionScan.Conflicts.Count flagged</span>
                    }
                </div>
                <div class="card-body p-2 small" style="max-height: 320px; overflow-y: auto;">
                    @if (contradictionScan == null)
                    {
                        <div class="text-muted">Click "scan contradictions" to run the detector.</div>
                    }
                    else if (contradictionScan.Conflicts.Count == 0)
                    {
                        <div class="text-muted">@contradictionScan.StatusNote</div>
                    }
                    else
                    {
                        @foreach (var c in contradictionScan.Conflicts.Take(20))
                        {
                            <div class="mb-2 pb-2 border-bottom border-secondary">
                                <div><strong>@c.CharacterName</strong></div>
                                <div class="text-muted">@c.PlaceA <span class="text-danger">→</span> @c.PlaceB in @c.Delta.TotalMinutes.ToString("F0") min</div>
                                <div class="text-muted small">@FormatLocal(c.AtA) → @FormatLocal(c.AtB)</div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/vis-timeline@7.7.3/standalone/umd/vis-timeline-graph2d.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vis-timeline@7.7.3/styles/vis-timeline-graph2d.min.css" />
<script src="js/timeline-vis.js"></script>

<style>
    .story-timeline-canvas {
        height: 360px; min-height: 320px;
        background: #0e1014; border: 1px solid #2a2a32; border-radius: 4px;
    }
    /* vis-timeline overrides for dark theme */
    .story-timeline-canvas .vis-timeline { background: #0e1014; color: #ddd; border-color: #2a2a32; }
    .story-timeline-canvas .vis-panel.vis-center,
    .story-timeline-canvas .vis-panel.vis-left,
    .story-timeline-canvas .vis-panel.vis-right,
    .story-timeline-canvas .vis-panel.vis-top,
    .story-timeline-canvas .vis-panel.vis-bottom { border-color: #2a2a32; }
    .story-timeline-canvas .vis-time-axis .vis-text { color: #888; }
    .story-timeline-canvas .vis-time-axis .vis-grid.vis-minor { border-color: #1d2027; }
    .story-timeline-canvas .vis-time-axis .vis-grid.vis-major { border-color: #2a2e37; }
    .story-timeline-canvas .vis-labelset .vis-label { color: #888; border-color: #2a2a32; background: #16181d; }
    .story-timeline-canvas .vis-item.vis-selected { box-shadow: 0 0 0 2px #ffe59a; }
    .story-timeline-canvas .vis-custom-time { background-color: #f33 !important; }
    .story-timeline-canvas .vis-custom-time-marker { color: #f55; }
</style>

@code {
    private record TimelineEvent(string Id, string Type, string Title, DateTime At, string Route, string? Subtitle);

    private DateTime currentNow;
    private DateTime snapshotAt;
    private List<TimelineEvent> events = new();
    private LocationContradictionService.ScanResult? contradictionScan;
    private List<EntityStateEvent> worldEventsAtPoint = new();
    private Dictionary<Guid, string> entityNameById = new();
    private DotNetObjectReference<Timeline>? selfRef;

    // Per-entity drill-in state
    private string entityPickerName = "";
    private Guid?  selectedEntityId;
    private string? selectedEntityName;
    private Dictionary<string, EntityStateEvent> entitySnapshot = new();

    protected override async Task OnInitializedAsync()
    {
        currentNow = Clock.GetNow();
        snapshotAt = currentNow;
        await LoadEventsAsync();
        await LoadEventsNearNowAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
            var json = JsonSerializer.Serialize(events, new JsonSerializerOptions
            {
                PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
            });
            await JS.InvokeVoidAsync("streetSamuraiTimeline.init",
                "story-timeline", json, currentNow.ToString("o"), selfRef);
        }
    }

    private async Task LoadEventsAsync()
    {
        await using var db = await Db.CreateDbContextAsync();

        var chapterRows = await (
            from c in db.Chapters.AsNoTracking()
            join e in db.Entities.AsNoTracking() on c.Id equals e.Id
            where e.IsActive && c.InWorldDate != null
            select new { c.Id, c.Title, At = c.InWorldDate!.Value, c.BookId }).ToListAsync();

        var beatRows = await (
            from b in db.ChapterBeats.AsNoTracking()
            where b.InWorldDate != null
            select new { b.BeatGuid, b.ChapterId, b.Title, At = b.InWorldDate!.Value }).ToListAsync();

        var bookFirstDate = chapterRows
            .Where(c => c.BookId.HasValue)
            .GroupBy(c => c.BookId!.Value)
            .ToDictionary(g => g.Key, g => g.Min(c => c.At));

        var bookTitles = await (
            from b in db.Books.AsNoTracking()
            join e in db.Entities.AsNoTracking() on b.Id equals e.Id
            where e.IsActive
            select new { b.Id, b.Title }).ToListAsync();

        events = new();
        foreach (var b in bookTitles)
            if (bookFirstDate.TryGetValue(b.Id, out var at))
                events.Add(new(b.Id.ToString("N"), "book", b.Title, at, $"/books/{b.Id:N}", null));
        foreach (var c in chapterRows)
            events.Add(new(c.Id.ToString("N"), "chapter", c.Title, c.At,
                c.BookId.HasValue ? $"/write/{c.BookId:N}/{c.Id:N}" : $"/write//{c.Id:N}", null));
        foreach (var b in beatRows)
            events.Add(new(b.BeatGuid.ToString("N"), "beat", b.Title, b.At,
                $"/write//{b.ChapterId:N}", null));

        // Inject EntityStateEvents in the same time window as the chapter/beat
        // items so the timeline shows authored events alongside extracted
        // state. Compute the window from a flat list of dates to avoid
        // anonymous-type concat issues.
        if (chapterRows.Any() || beatRows.Any())
        {
            var allDates = chapterRows.Select(c => c.At)
                .Concat(beatRows.Select(b => b.At))
                .ToList();
            var fromT = allDates.Min().AddDays(-1);
            var toT   = allDates.Max().AddDays(1);
            var ledgerRows = await db.EntityStateEvents.AsNoTracking()
                .Where(e => e.AtStoryTime >= fromT && e.AtStoryTime <= toT)
                .OrderBy(e => e.AtStoryTime)
                .Take(500)
                .ToListAsync();
            foreach (var l in ledgerRows)
            {
                events.Add(new(
                    Id:       $"ev-{l.Id}",
                    Type:     "ledger",
                    Title:    $"{l.Verb} {l.AspectKey}",
                    At:       l.AtStoryTime,
                    Route:    $"/entity/{l.EntityId:N}",
                    Subtitle: l.Snippet ?? l.NewValue));
            }
        }

        events = events.OrderBy(e => e.At).ToList();
    }

    private async Task LoadEventsNearNowAsync()
    {
        await using var db = await Db.CreateDbContextAsync();
        var window = TimeSpan.FromHours(6);
        worldEventsAtPoint = await db.EntityStateEvents.AsNoTracking()
            .Where(e => e.AtStoryTime >= snapshotAt - window && e.AtStoryTime <= snapshotAt + window)
            .OrderBy(e => e.AtStoryTime)
            .Take(120)
            .ToListAsync();
        var ids = worldEventsAtPoint.Select(e => e.EntityId).Distinct().ToList();
        entityNameById = await db.Entities.AsNoTracking()
            .Where(e => ids.Contains(e.Id))
            .ToDictionaryAsync(e => e.Id, e => e.Name);
    }

    /// <summary>Called from JS when the user drags or double-clicks the NOW marker.</summary>
    [JSInvokable]
    public async Task OnNowDragged(string isoTime)
    {
        if (!DateTime.TryParse(isoTime, null,
                System.Globalization.DateTimeStyles.RoundtripKind | System.Globalization.DateTimeStyles.AdjustToUniversal,
                out var when))
            return;
        currentNow = DateTime.SpecifyKind(when, DateTimeKind.Utc);
        snapshotAt = currentNow;
        Clock.SetNow(currentNow);
        await LoadEventsNearNowAsync();
        await ReloadEntitySnapshotAsync();
        StateHasChanged();
    }

    /// <summary>Called from JS when the user clicks an item dot. Single-click =
    /// inspect (move snapshot cursor); double-click = activate (navigate).</summary>
    [JSInvokable]
    public async Task OnEventSelected(string eventId, string isoStart)
    {
        if (DateTime.TryParse(isoStart, null,
                System.Globalization.DateTimeStyles.RoundtripKind | System.Globalization.DateTimeStyles.AdjustToUniversal,
                out var when))
        {
            snapshotAt = DateTime.SpecifyKind(when, DateTimeKind.Utc);
            await LoadEventsNearNowAsync();
            await ReloadEntitySnapshotAsync();
            StateHasChanged();
        }
    }

    /// <summary>Called from JS on double-click of an item — navigates to its route.</summary>
    [JSInvokable]
    public Task OnEventActivated(string route)
    {
        if (!string.IsNullOrWhiteSpace(route))
            Nav.NavigateTo(route);
        return Task.CompletedTask;
    }

    private async Task OnNowInputChanged(ChangeEventArgs e)
    {
        if (!DateTime.TryParse(e.Value?.ToString(), out var parsed)) return;
        currentNow = DateTime.SpecifyKind(parsed, DateTimeKind.Utc);
        snapshotAt = currentNow;
        Clock.SetNow(currentNow);
        await LoadEventsNearNowAsync();
        await JS.InvokeVoidAsync("streetSamuraiTimeline.setNow", currentNow.ToString("o"));
    }

    private async Task RescanContradictions()
    {
        contradictionScan = await ContradictionScan.ScanAsync();
    }

    private async Task OnPickEntity()
    {
        if (string.IsNullOrWhiteSpace(entityPickerName)) return;
        await using var db = await Db.CreateDbContextAsync();
        var slug = WorldGraphService.Slugify(entityPickerName);
        var hit = await db.Entities.AsNoTracking()
            .Where(e => e.IsActive
                && (e.Name == entityPickerName || e.Slug == slug
                    || e.Name.StartsWith(entityPickerName)))
            .OrderBy(e => e.Name.Length)
            .FirstOrDefaultAsync();
        if (hit == null) { selectedEntityId = null; selectedEntityName = "(not found)"; entitySnapshot.Clear(); return; }
        selectedEntityId   = hit.Id;
        selectedEntityName = hit.Name;
        await ReloadEntitySnapshotAsync();
    }

    private async Task OnEntityPickerKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await OnPickEntity();
    }

    private async Task ReloadEntitySnapshotAsync()
    {
        if (selectedEntityId == null) { entitySnapshot.Clear(); return; }
        entitySnapshot = await Ledger.SnapshotAsync(selectedEntityId.Value, snapshotAt);
    }

    private async Task OnZoomToFit() =>
        await JS.InvokeVoidAsync("streetSamuraiTimeline.zoomToFit");

    private static string FormatLocal(DateTime utc) =>
        utc.ToLocalTime().ToString("yyyy-MM-ddTHH:mm:ss");

    private static string VerbBadge(string verb) => verb.ToLowerInvariant() switch
    {
        "set"    => "bg-info",
        "inc"    => "bg-success",
        "dec"    => "bg-warning text-dark",
        "enter"  => "bg-primary",
        "leave"  => "bg-secondary",
        "add"    => "bg-success",
        "remove" => "bg-danger",
        _        => "bg-secondary",
    };

    public void Dispose() => selfRef?.Dispose();
}
