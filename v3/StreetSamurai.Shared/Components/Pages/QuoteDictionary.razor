@page "/quotes"
@using StreetSamurai.Core.Models.Canon
@inject QuoteRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="dict-layout">
    <div class="dict-list">
        <div class="card bg-dark text-light border-secondary mb-2 card-body">
            <FilterBar AllTags="allTags" @bind-Filter="filter" SelectedTags="selectedTags" SelectedTagsChanged="OnTagsChanged" />

        </div>
        <div class="dict-items">
            @foreach (var q in SortedItems)
            {
                <div class="list-item text-light @(editing?.Quote == q.Quote ? "active" : "")" @onclick="() => Edit(q)">
                    <div class="fw-bold small">@(q.Quote.Length > 50 ? q.Quote[..50] + "..." : q.Quote)</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@q.Category</div>
                </div>
            }
        </div>
    </div>

    <div class="dict-editor">
        @if (editing != null)
        {
            <EditViewToggle RepoName="quotes" Title="@(isNew ? "New Quote" : "Quote")" Json="@System.Text.Json.JsonSerializer.Serialize(editing)">
                <HeaderButtons>
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i><div class="btn-lbl"> Save</div></button>
                    @if (!isNew && !confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmDelete = true"><i class="bi bi-archive"></i></button> }
                    @if (confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete"><div class="btn-lbl">Confirm</div></button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirmDelete = false"><div class="btn-lbl">No</div></button> }
                </HeaderButtons>
                <ChildContent>
                    <div class="mb-3"><div class="field-label">Quote</div><textarea class="form-control bg-dark text-light border-secondary" rows="3" @bind="editing.Quote"></textarea></div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <div style="flex: 1; min-width: 200px;"><div class="field-label">Attribution</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Who said it (blank for anonymous)" @bind="editing.Attribution" /></div>
                        <div style="flex: 1; min-width: 200px;"><div class="field-label">Source</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="Book, film, in-world origin..." @bind="editing.Source" /></div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <div style="flex: 1; min-width: 150px;"><div class="field-label">Category</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="wisdom, warning, insult, proverb..." @bind="editing.Category" /></div>
                        <div style="flex: 0 0 auto;" class="d-flex align-items-end gap-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @bind="editing.InWorld" id="inWorldCheck" />
                                <label class="form-check-label text-muted small" for="inWorldCheck">In-world (said by GLMZ character)</label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3"><div class="field-label">Context</div><textarea class="form-control bg-dark text-light border-secondary" rows="2" placeholder="When/why this was said..." @bind="editing.Context"></textarea></div>
                    @if (!string.IsNullOrWhiteSpace(editing.Quote))
                    {
                        <div class="card bg-black border-secondary mt-3">
                            <div class="card-body">
                                <blockquote class="mb-1 fst-italic" style="font-size: 1.1rem; color: var(--bs-light);">@editing.Quote</blockquote>
                                @if (!string.IsNullOrWhiteSpace(editing.Attribution))
                                {
                                    <small class="text-muted">— @editing.Attribution</small>
                                }
                            </div>
                        </div>
                    }
                </ChildContent>
            </EditViewToggle>
        }
        else
        {
            <div class="text-center text-muted py-5"><i class="bi bi-quote" style="font-size:3rem;"></i><p class="mt-2">Select a quote or add a new one.</p></div>
        }
    </div>
</div>

@code {
    private List<QuoteData> items = [];
    private QuoteData? editing;
    private string originalQuote = "";
    private string filter = "";
    private List<(string name, int count)> allTags = [];
    private HashSet<string> selectedTags = [];
    private bool isNew, confirmDelete;

    private List<QuoteData> FilteredItems
    {
        get
        {
            IEnumerable<QuoteData> result = items;
            if (!string.IsNullOrWhiteSpace(filter))
                result = result.Where(q => q.Quote.Contains(filter, StringComparison.OrdinalIgnoreCase));
            if (selectedTags.Count > 0)
                result = result.Where(q => selectedTags.All(t => q.Tags.Contains(t)));
            return result.ToList();
        }
    }
    private List<QuoteData> SortedItems => FilteredItems.OrderBy(x => x.Quote).ToList();

    protected override void OnInitialized() { Repo.Reload(); items = Repo.GetAll(); RebuildTags(); if (Nav.Uri.Contains("new=true")) AddNew(); else { var qid = Nav.Uri.Contains("id=") ? Uri.UnescapeDataString(Nav.Uri.Split(new[]{"id="}, StringSplitOptions.None).Last().Split(new[]{"&"}, StringSplitOptions.None)[0]) : ""; if (!string.IsNullOrEmpty(qid)) { var t = items.FirstOrDefault(e => e.Id == qid); if (t != null) Edit(t); } if (editing == null) { var first = items.FirstOrDefault(); if (first != null) Edit(first); } } }
    private void AddNew() { editing = new QuoteData(); isNew = true; confirmDelete = false; }
    private void Edit(QuoteData q) { _ = JS.InvokeVoidAsync("localStorage.setItem", "ss_sel_quotes", q.Id); editing = q; originalQuote = q.Quote; isNew = false; confirmDelete = false; if (!Nav.Uri.Contains("id=" + q.Id)) Nav.NavigateTo(Nav.Uri.Split('?')[0] + "?id=" + q.Id, forceLoad: false); }
    private void SaveEdit()
    {
        if (editing == null || string.IsNullOrWhiteSpace(editing.Quote)) return;
        if (!isNew && originalQuote != editing.Quote) Repo.Delete(originalQuote);
        Repo.Save(editing);
        editing = null;
        items = Repo.GetAll();
    }
    private void DoDelete() { if (editing != null) { Repo.Delete(editing.Quote); editing = null; items = Repo.GetAll(); confirmDelete = false; } }
    private void RebuildTags() { allTags = items.SelectMany(x => x.Tags).GroupBy(t => t).Select(g => (g.Key, g.Count())).OrderBy(t => t.Key).ToList(); }
    private void OnTagsChanged(HashSet<string> tags) { selectedTags = tags; }
    private List<(string name, string json)> GetExportEntries() => items.Select(e => (e.Quote.Length > 40 ? e.Quote[..40] : e.Quote, System.Text.Json.JsonSerializer.Serialize(e))).ToList();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("writeInterop.autoResizeAll");
        if (firstRender && !Nav.Uri.Contains("new=true") && !Nav.Uri.Contains("id=") && items.Count > 0)
        {
            var lastId = "";
            try { lastId = await JS.InvokeAsync<string>("localStorage.getItem", "ss_sel_quotes") ?? ""; } catch { }
            if (!string.IsNullOrEmpty(lastId))
            {
                var target = items.FirstOrDefault(x => x.Id == lastId);
                if (target != null) { Edit(target); StateHasChanged(); }
            }
        }
    }

}
