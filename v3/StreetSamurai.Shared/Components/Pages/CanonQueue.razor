@page "/queue"
@inject CanonQueueService QueueSvc
@inject TextAnalysisService Analysis
@inject ILlmService Llm

<h4 class="text-danger mb-1">Canon Queue</h4>
<p class="text-muted mb-3">Review pipeline for new canon entries. Validate against worldbuilding with the LLM, then approve or reject.</p>

<div class="btn-group btn-group-sm mb-3">
    <button class="btn @(_tab == "pending" ? "btn-danger" : "btn-outline-secondary")" @onclick='() => _tab = "pending"'>
        Pending (@_pending.Count)
    </button>
    <button class="btn @(_tab == "promoted" ? "btn-danger" : "btn-outline-secondary")" @onclick='() => _tab = "promoted"'>
        Promoted (@_promoted.Count)
    </button>
    <button class="btn @(_tab == "rejected" ? "btn-danger" : "btn-outline-secondary")" @onclick='() => _tab = "rejected"'>
        Rejected (@_rejected.Count)
    </button>
</div>

@{
    var entries = _tab switch
    {
        "promoted" => _promoted,
        "rejected" => _rejected,
        _ => _pending,
    };
}

@if (entries.Any())
{
    @foreach (var entry in entries)
    {
        <div class="card bg-dark text-light border-secondary mb-2">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold">@entry.Name</span>
                        <span class="badge bg-secondary ms-2">@entry.Type</span>
                        <CanonStatusBadge Status="@entry.Status" />
                    </div>
                    <small class="text-muted">@entry.Submitted.ToString("yyyy-MM-dd")</small>
                </div>
                @if (!string.IsNullOrEmpty(entry.Context))
                {
                    <div class="small text-muted mt-1">@Truncate(entry.Context, 200)</div>
                }
                @if (!string.IsNullOrEmpty(entry.SourceScene))
                {
                    <small class="text-info">Source: @entry.SourceScene</small>
                }

                @if (_tab == "pending")
                {
                    <div class="mt-2 d-flex gap-2 flex-wrap">
                        <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                               placeholder="Notes..." @bind="_notes" style="max-width: 300px;" />
                        <button class="btn btn-sm btn-outline-success" @onclick="() => Promote(entry)">Approve</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Reject(entry)">Reject</button>
                        @if (_llmReady)
                        {
                            <button class="btn btn-sm btn-outline-info" @onclick="() => ValidateWithLlm(entry)"
                                    disabled="@(_validating == entry.FilePath)"
                                    title="Run an LLM lore-check against the worldbuilding canon to detect contradictions">
                                @if (_validating == entry.FilePath)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                }
                                else
                                {
                                    <i class="bi bi-robot"></i>
                                }
                                Validate with AI
                            </button>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(entry.Notes))
                {
                    <div class="small text-muted mt-1"><em>@entry.Notes</em></div>
                }
                @if (_validationResults.TryGetValue(entry.FilePath, out var result))
                {
                    <div class="mt-2 p-2 border rounded @(result.StartsWith("PASS") ? "border-success" : "border-warning")"
                         style="white-space: pre-wrap; font-size: 0.8rem;">
                        @result
                    </div>
                }
            </div>
        </div>
    }
}
else
{
    <p class="text-muted">No @_tab entries.</p>
}

@code {
    private string _tab = "pending";
    private string _notes = "";
    private List<CanonQueueEntry> _pending = [];
    private List<CanonQueueEntry> _promoted = [];
    private List<CanonQueueEntry> _rejected = [];
    private bool _llmReady;
    private string? _validating;
    private Dictionary<string, string> _validationResults = new();

    protected override async Task OnInitializedAsync()
    {
        Refresh();
        _llmReady = await Llm.IsConfiguredAsync();
    }

    private void Refresh()
    {
        _pending = QueueSvc.ListByStatus("pending");
        _promoted = QueueSvc.ListByStatus("promoted");
        _rejected = QueueSvc.ListByStatus("rejected");
    }

    private void Promote(CanonQueueEntry entry)
    {
        QueueSvc.Promote(entry.FilePath, _notes);
        _notes = "";
        Refresh();
    }

    private void Reject(CanonQueueEntry entry)
    {
        QueueSvc.Reject(entry.FilePath, _notes);
        _notes = "";
        Refresh();
    }

    private async Task ValidateWithLlm(CanonQueueEntry entry)
    {
        _validating = entry.FilePath;
        try
        {
            var text = entry.Context ?? entry.Name;
            var result = await Analysis.LoreCheckAsync(text, text);
            _validationResults[entry.FilePath] = result;
        }
        catch (Exception ex)
        {
            _validationResults[entry.FilePath] = $"Error: {ex.Message}";
        }
        finally
        {
            _validating = null;
        }
    }

    private static string Truncate(string s, int max) =>
        s.Length > max ? s[..(max - 3)] + "..." : s;
}
