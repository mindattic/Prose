@page "/listen"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@using Microsoft.EntityFrameworkCore
@using StreetSamurai.Core.Data
@using StreetSamurai.Core.Data.Entities
@using StreetSamurai.Core.Services
@using StreetSamurai.Shared.Services
@inject IDbContextFactory<StreetSamuraiDbContext> DbFactory
@inject EpisodeGeneratorService Generator
@inject EpisodeAudioService Audio
@inject ElevenLabsTtsService Tts
@inject SettingsService Settings
@inject ToastNotifier Toast
@inject IJSRuntime JS
@inject NavigationManager NavMgr
@implements IDisposable

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="text-danger mb-0"><i class="bi bi-headphones me-2"></i>Tonight's Adventure</h4>
            <div class="text-muted small">Press start. Kyle goes to work. You go to sleep.</div>
        </div>
        <a href="/inbox" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-inboxes me-1"></i>Inbox
        </a>
    </div>

    @if (currentEpisode == null)
    {
        <div class="card bg-dark border-secondary text-center p-5 mb-4">
            <div class="row justify-content-center mb-3">
                <div class="col-md-6">
                    <label class="form-label small text-muted mb-1 text-start d-block">Narrator voice</label>
                    <select class="form-select bg-black text-light border-secondary"
                            @bind="selectedVoiceId" disabled="@(voices.Count == 0)">
                        @if (voices.Count == 0)
                        {
                            <option value="@defaultVoiceId">Loading voices…</option>
                        }
                        else
                        {
                            @foreach (var v in voices)
                            {
                                <option value="@v.VoiceId">@v.Name @(v.VoiceId == defaultVoiceId ? "(default)" : "")</option>
                            }
                        }
                    </select>
                </div>
            </div>
            <div>
                <button class="btn btn-danger btn-lg px-5 py-3" @onclick="StartAsync" disabled="@working">
                    @if (working)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                        <span>Generating…</span>
                    }
                    else
                    {
                        <i class="bi bi-play-circle-fill me-2"></i>
                        <span>Start Adventure</span>
                    }
                </button>
            </div>
            <div class="text-muted small mt-3">
                Generation runs first, then narration. The first paragraph's audio starts playing as soon as it's ready.
                Each beat is saved as a lossless 16-bit / 44.1 kHz WAV at <code>engine/episodes/{slug}/audio/</code>.
            </div>
        </div>

        @if (recent.Count > 0)
        {
            <h6 class="text-muted text-uppercase small mb-2">Resume or continue</h6>
            @foreach (var ep in recent)
            {
                <div class="card bg-dark @(ep.Status == "failed" ? "border-danger" : "border-secondary") mb-2">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="flex-grow-1 me-3">
                                <div class="text-info">@ep.Title</div>
                                <div class="text-muted small">
                                    @ep.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                    @if (ep.LastPlayedBeatIndex.HasValue)
                                    {
                                        <span class="ms-2">· paused at beat @(ep.LastPlayedBeatIndex + 1)</span>
                                    }
                                    @if (ep.ParentEpisodeId.HasValue)
                                    {
                                        <span class="ms-2 badge bg-secondary">continued</span>
                                    }
                                    @if (ep.Status == "failed")
                                    {
                                        <span class="ms-2 badge bg-danger">failed</span>
                                    }
                                </div>
                                @if (ep.Status == "failed" && !string.IsNullOrEmpty(ep.Error))
                                {
                                    <div class="text-danger small mt-1"><i class="bi bi-exclamation-triangle me-1"></i>@ep.Error</div>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                @if (ep.Status == "failed")
                                {
                                    <button class="btn btn-sm btn-outline-warning" @onclick="() => RetryAsync(ep.Id)" disabled="@working">
                                        <i class="bi bi-arrow-clockwise me-1"></i>Retry
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-info" @onclick="() => ResumeAsync(ep.Id)">
                                        <i class="bi bi-play-fill me-1"></i>Resume
                                    </button>
                                    <button class="btn btn-sm btn-outline-success" @onclick="() => ContinueAsync(ep.Id)" disabled="@working">
                                        <i class="bi bi-arrow-right-circle me-1"></i>Continue
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
    else
    {
        <div class="card bg-dark border-info mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <div>
                        <h5 class="text-info mb-1">@currentEpisode.Title</h5>
                        <div class="text-muted small">@currentEpisode.Seed</div>
                    </div>
                    <span class="badge bg-secondary text-uppercase">@currentEpisode.Status</span>
                </div>
                <div class="text-muted small mb-2">
                    Beats narrated: @NarratedBeatCount / @currentEpisode.Beats.Count
                    @if (currentEpisode.CharsNarrated > 0)
                    {
                        <span class="ms-3">Characters narrated: @currentEpisode.CharsNarrated.ToString("N0")</span>
                    }
                    @if (CurrentEpisodeStaleCount > 0)
                    {
                        <span class="text-danger ms-3" title="The prose was edited past these beats' audio; they're skipped in playback. Re-record from the writer panel to repair.">
                            <i class="bi bi-exclamation-triangle me-1"></i>@CurrentEpisodeStaleCount stale (skipped)
                        </span>
                    }
                </div>

                @* hidden HTML5 audio element — controls are custom *@
                <audio id="ep-audio"
                       @key="@($"ep-{currentEpisode.Id}-{currentBeatIndex}")"
                       src="@CurrentAudioUrl"
                       @onended="OnBeatEnded"
                       preload="auto"
                       style="display:none;">
                </audio>

                @* dual-progress bar: TTS-rendered fill + playhead *@
                <div class="position-relative mb-2 user-select-none"
                     style="height:18px; background:#222; border-radius:9px; overflow:hidden; cursor:pointer;"
                     @onclick="OnTrackClick">
                    @* light pre-fill = how far the script extends (total estimate) *@
                    <div class="position-absolute top-0 start-0 h-100"
                         style="width:100%; background:linear-gradient(90deg, #2a2a2a, #303030);"></div>
                    @* mid fill = how far TTS has rendered *@
                    <div class="position-absolute top-0 start-0 h-100"
                         style="width:@(NarratedPct.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))%; background:rgba(13,202,240,0.30);"></div>
                    @* solid fill = playhead position *@
                    <div class="position-absolute top-0 start-0 h-100"
                         style="width:@(PlayheadPct.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))%; background:#dc3545;"></div>
                </div>

                <div class="d-flex justify-content-between align-items-center small mb-2">
                    <span class="text-light">@FormatTime(virtualPlayheadSec)</span>
                    <span class="text-muted">@FormatTime(narratedTotalSec) narrated · @FormatTime(totalEstimateSec) est.</span>
                </div>

                <div class="d-flex justify-content-center gap-2">
                    <button class="btn btn-outline-secondary" @onclick="Back10" title="Back 10 seconds">
                        <i class="bi bi-skip-backward-fill"></i>
                        <span class="ms-1">10s</span>
                    </button>
                    <button class="btn btn-danger px-4" @onclick="TogglePlay" title="Play / pause">
                        @if (isPlaying)
                        {
                            <i class="bi bi-pause-fill fs-4"></i>
                        }
                        else
                        {
                            <i class="bi bi-play-fill fs-4"></i>
                        }
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="Fwd10" title="Forward 10 seconds">
                        <span class="me-1">10s</span>
                        <i class="bi bi-skip-forward-fill"></i>
                    </button>
                    @if (currentEpisode.Status == "narrating" || currentEpisode.Status == "generating")
                    {
                        <button class="btn btn-outline-warning" @onclick="StopNarrationAsync" title="Stop narration to save ElevenLabs credits">
                            <i class="bi bi-stop-circle me-1"></i>Stop
                        </button>
                    }
                </div>

                @* Artifact downloads — appear as soon as each file exists *@
                <div class="d-flex justify-content-center gap-2 mt-3 small">
                    @if (!string.IsNullOrEmpty(currentEpisode.ScriptMarkdownPath))
                    {
                        <a class="text-info text-decoration-none"
                           href="/api/episodes/@currentEpisode.Id/script.md" download>
                            <i class="bi bi-markdown me-1"></i>script.md
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(currentEpisode.ScriptPdfPath))
                    {
                        <a class="text-info text-decoration-none"
                           href="/api/episodes/@currentEpisode.Id/script.pdf" download>
                            <i class="bi bi-filetype-pdf me-1"></i>script.pdf
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(currentEpisode.CombinedAudioPath))
                    {
                        <a class="text-info text-decoration-none"
                           href="/api/episodes/@currentEpisode.Id/episode.wav" download>
                            <i class="bi bi-file-earmark-music me-1"></i>episode.wav
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="card bg-dark border-secondary">
            <div class="card-body">
                <h6 class="text-muted text-uppercase small mb-3">
                    Transcript
                    <span class="text-muted ms-2" style="text-transform:none;">click any paragraph to edit · re-record invalidates that beat's audio</span>
                </h6>
                @foreach (var beat in currentEpisode.Beats.OrderBy(b => b.SortKey))
                {
                    var beatIdx = beat.Index;
                    var isEditing = editingBeatIndex == beatIdx;
                    var isCurrent = beatIdx == currentBeatIndex;
                    <div class="mb-3 p-2 rounded @(isCurrent ? "border border-info" : "")"
                         style="@(isCurrent ? "background:rgba(13,202,240,0.06);" : "")">
                        @if (isEditing)
                        {
                            <textarea class="form-control bg-black text-light border-secondary mb-2"
                                      rows="@Math.Max(2, beat.Text.Length / 90 + 1)"
                                      @bind="editingBeatText"></textarea>
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-success" @onclick="() => SaveBeatEditAsync(beatIdx)" disabled="@savingEdit">
                                    <i class="bi bi-check-lg me-1"></i>Save (invalidates audio)
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelBeatEdit">
                                    Cancel
                                </button>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <p class="@(isCurrent ? "fw-bold text-info mb-0" : "text-light mb-0") flex-grow-1"
                                   style="cursor:text;" @onclick="() => StartBeatEdit(beat)">
                                    @beat.Text
                                </p>
                                <div class="d-flex flex-column gap-1">
                                    <button class="btn btn-sm btn-outline-secondary py-0 px-1" title="Edit text"
                                            @onclick="() => StartBeatEdit(beat)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    @if (!string.IsNullOrEmpty(beat.AudioPath))
                                    {
                                        <button class="btn btn-sm btn-outline-warning py-0 px-1" title="Re-record this beat"
                                                @onclick="() => RerecordBeatAsync(beatIdx)" disabled="@working">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                            @if (beat.WasCorrected && string.IsNullOrEmpty(beat.AudioPath))
                            {
                                <div class="text-warning small mt-1">
                                    <i class="bi bi-exclamation-triangle me-1"></i>edited — waiting on re-narration
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>

        <div class="text-center mt-3">
            <button class="btn btn-outline-secondary btn-sm" @onclick="Reset">
                <i class="bi bi-arrow-left me-1"></i>Back to start
            </button>
        </div>
    }
</div>

@code {
    private bool working;
    private Episode? currentEpisode;
    private int currentBeatIndex = 0;
    private System.Threading.Timer? poll;
    private System.Threading.Timer? tick;

    private bool isPlaying = false;
    private double currentTimeInBeat = 0;     // seconds, from JS audio.currentTime
    private double virtualPlayheadSec = 0;    // sum of completed beats + currentTimeInBeat
    private double totalEstimateSec = 0;      // sum over all beats: actual when known, estimate otherwise
    private double narratedTotalSec = 0;      // sum over beats that have AudioPath

    private const double EstimateCharsPerSec = 15.0;
    private const string AudioElementId = "ep-audio";

    private double PlayheadPct =>
        totalEstimateSec <= 0 ? 0 : Math.Clamp(virtualPlayheadSec / totalEstimateSec * 100.0, 0, 100);
    private double NarratedPct =>
        totalEstimateSec <= 0 ? 0 : Math.Clamp(narratedTotalSec / totalEstimateSec * 100.0, 0, 100);

    private int NarratedBeatCount =>
        currentEpisode?.Beats.Count(b => !string.IsNullOrEmpty(b.AudioPath)) ?? 0;

    /// <summary>Beats whose audio was invalidated by a writer-side prose edit
    /// past the recording. Playback skips them because AudioPath is null;
    /// surface a small warning in the header so the listener knows the audio
    /// has holes corresponding to those paragraphs.</summary>
    private int CurrentEpisodeStaleCount =>
        currentEpisode?.Beats?.Count(b => b.Stale) ?? 0;

    private string defaultVoiceId = "";
    private string selectedVoiceId = "";
    private List<TtsVoice> voices = new();
    private List<Episode> recent = new();

    // Per-beat inline editing state
    private int? editingBeatIndex;
    private string editingBeatText = "";
    private bool savingEdit;

    protected override async Task OnInitializedAsync()
    {
        // Unified cutover: /listen funnels to /strands; /listen?episode={id}
        // funnels to /strand/{id} since Episode.Id was reused as Strand.Id
        // during the migration.
        var uriEarly = NavMgr.ToAbsoluteUri(NavMgr.Uri);
        var qEarly = uriEarly.Query;
        if (!string.IsNullOrEmpty(qEarly))
        {
            var m = System.Text.RegularExpressions.Regex.Match(qEarly, @"episode=([0-9a-fA-F-]+)");
            if (m.Success)
            {
                NavMgr.NavigateTo($"/strand/{m.Groups[1].Value}", replace: true);
                return;
            }
        }
        NavMgr.NavigateTo("/strands", replace: true);
        return;

#pragma warning disable CS0162
        defaultVoiceId  = Settings.ElevenLabsVoiceId ?? "";
        selectedVoiceId = defaultVoiceId;
        try
        {
            voices = await Tts.ListVoicesAsync();
            // Ensure the default voice is in the list, even if the account roster
            // changed since the setting was saved.
            if (!string.IsNullOrEmpty(defaultVoiceId) && !voices.Any(v => v.VoiceId == defaultVoiceId))
                voices.Insert(0, new TtsVoice { VoiceId = defaultVoiceId, Name = "(saved default)" });
            voices = voices.OrderBy(v => v.Name).ToList();
        }
        catch
        {
            // List failed (offline, bad key). Leave the picker with the default voice only.
            voices = new() { new TtsVoice { VoiceId = defaultVoiceId, Name = "Default voice" } };
        }
        await LoadRecentAsync();

        // Deep-link: /listen?episode={guid} jumps straight into resume mode.
        var uri = NavMgr.ToAbsoluteUri(NavMgr.Uri);
        var q = uri.Query;
        if (!string.IsNullOrEmpty(q))
        {
            var match = System.Text.RegularExpressions.Regex.Match(q, @"[?&]episode=([^&]+)");
            if (match.Success && Guid.TryParse(System.Uri.UnescapeDataString(match.Groups[1].Value), out var deepLinkId))
            {
                await ResumeAsync(deepLinkId);
            }
        }

        StateHasChanged();
#pragma warning restore CS0162
    }

    private async Task LoadRecentAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        recent = await db.Episodes
            .Where(e => e.Status == "ready" || e.Status == "narrating" || e.Status == "failed")
            .OrderByDescending(e => e.StartedAt)
            .Take(10)
            .AsNoTracking()
            .ToListAsync();
    }

    private string CurrentAudioUrl =>
        currentEpisode == null ? ""
            : $"/api/episodes/{currentEpisode.Id}/audio/{currentBeatIndex}";

    private async Task StartAsync()
    {
        if (working) return;
        working = true;
        StateHasChanged();
        try
        {
            // Generation is synchronous — the LLM call. Narration is fire-and-forget
            // background, so the page can start playing the first beat as soon as
            // its mp3 lands.
            var voice = string.IsNullOrEmpty(selectedVoiceId) ? null : selectedVoiceId;
            var id = await Task.Run(() => Generator.GenerateAsync(voice));
            _ = Task.Run(() => Audio.NarrateAsync(id));

            await LoadEpisodeAsync(id);
            StartPolling();
            Toast.Success("EPISODE-START", $"Episode generated ({id.ToString("N")[..8]}…). Narration starting.");
        }
        catch (Exception ex)
        {
            Toast.Error("EPISODE-FAIL", $"Failed to start: {ex.Message}");
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadEpisodeAsync(Guid id)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        currentEpisode = await db.Episodes
            .Include(e => e.Beats)
            .AsNoTracking()
            .FirstOrDefaultAsync(e => e.Id == id);
        RecomputeTimeline();
    }

    /// <summary>Resume a previously-played episode at its saved position.</summary>
    private async Task ResumeAsync(Guid id)
    {
        await LoadEpisodeAsync(id);
        if (currentEpisode == null) return;

        currentBeatIndex   = currentEpisode.LastPlayedBeatIndex ?? 0;
        currentTimeInBeat  = currentEpisode.LastPlayedSec ?? 0;
        RecomputeTimeline();
        StartPolling();
        await InvokeAsync(StateHasChanged);

        // After the audio element renders with the resumed src, seek into the beat.
        await Task.Delay(180);
        try
        {
            await JS.InvokeVoidAsync("episodePlayer.seek", AudioElementId, currentTimeInBeat);
            await JS.InvokeVoidAsync("episodePlayer.play", AudioElementId);
        }
        catch { /* element not ready yet — tick will catch up */ }
    }

    private void StartBeatEdit(EpisodeBeat beat)
    {
        editingBeatIndex = beat.Index;
        editingBeatText  = beat.Text;
    }

    private void CancelBeatEdit()
    {
        editingBeatIndex = null;
        editingBeatText  = "";
    }

    /// <summary>Save the edited text for a beat. Invalidates its audio so the
    /// user can re-record with the new wording.</summary>
    private async Task SaveBeatEditAsync(int beatIdx)
    {
        if (currentEpisode == null || savingEdit) return;
        savingEdit = true;
        StateHasChanged();
        try
        {
            await Audio.UpdateBeatTextAsync(currentEpisode.Id, beatIdx, editingBeatText);
            await LoadEpisodeAsync(currentEpisode.Id);
            editingBeatIndex = null;
            editingBeatText  = "";
            Toast.Success("BEAT-EDIT-OK", $"Beat {beatIdx + 1} updated. Click ↻ to re-record.");
        }
        catch (Exception ex)
        {
            Toast.Error("BEAT-EDIT-FAIL", $"Save failed: {ex.Message}");
        }
        finally
        {
            savingEdit = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Discard a beat's audio file and trigger a single-beat re-narration.</summary>
    private async Task RerecordBeatAsync(int beatIdx)
    {
        if (currentEpisode == null || working) return;
        working = true;
        StateHasChanged();
        try
        {
            await Audio.InvalidateBeatAudioAsync(currentEpisode.Id, beatIdx);
            // NarrateAsync skips beats whose AudioPath is set, so the now-null
            // beat will be re-rendered while the rest are left alone.
            _ = Task.Run(() => Audio.NarrateAsync(currentEpisode.Id));
            await LoadEpisodeAsync(currentEpisode.Id);
            StartPolling();
            Toast.Success("BEAT-RERECORD", $"Re-recording beat {beatIdx + 1}…");
        }
        catch (Exception ex)
        {
            Toast.Error("BEAT-RERECORD-FAIL", $"Re-record failed: {ex.Message}");
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Cancel in-flight narration to save credits.</summary>
    private async Task StopNarrationAsync()
    {
        if (currentEpisode == null) return;
        var cancelled = Audio.CancelNarration(currentEpisode.Id);
        if (cancelled)
        {
            Toast.Info("NARRATION-STOP", "Narration cancelled. Already-narrated beats remain.");
            await LoadEpisodeAsync(currentEpisode.Id);
        }
        else
        {
            Toast.Warning("NARRATION-STOP", "No active narration to cancel.");
        }
    }

    /// <summary>Retry a failed episode. If beats already exist, narration resumes
    /// from the first unrendered beat. If generation died with zero beats, the
    /// row is treated as garbage and a fresh adventure replaces it.</summary>
    private async Task RetryAsync(Guid id)
    {
        if (working) return;
        working = true;
        StateHasChanged();
        try
        {
            // Check beat count to decide which side of the pipeline failed.
            int beatCount;
            await using (var db = await DbFactory.CreateDbContextAsync())
            {
                beatCount = await db.EpisodeBeats.CountAsync(b => b.EpisodeId == id);
            }

            if (beatCount == 0)
            {
                // Generation never produced any beats — there's nothing to salvage.
                // Start a fresh episode and toast the user about it.
                Toast.Info("EPISODE-RETRY", "Previous episode had no beats; starting a fresh adventure.");
                await StartAsync();
                return;
            }

            // Narration died mid-stream. Re-run NarrateAsync — it skips beats with
            // AudioPath set and resumes at the first unrendered one.
            _ = Task.Run(() => Audio.RetryAsync(id));
            await LoadEpisodeAsync(id);
            StartPolling();
            Toast.Success("EPISODE-RETRY", $"Resuming narration on episode ({id.ToString("N")[..8]}…).");
        }
        catch (Exception ex)
        {
            Toast.Error("EPISODE-RETRY-FAIL", $"Retry failed: {ex.Message}");
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Generate a new episode that continues from an existing one.</summary>
    private async Task ContinueAsync(Guid parentId)
    {
        if (working) return;
        working = true;
        StateHasChanged();
        try
        {
            var voice = string.IsNullOrEmpty(selectedVoiceId) ? null : selectedVoiceId;
            var id = await Task.Run(() => Generator.ContinueAsync(parentId, voice));
            _ = Task.Run(() => Audio.NarrateAsync(id));

            await LoadEpisodeAsync(id);
            StartPolling();
            Toast.Success("EPISODE-CONTINUE", $"Continuation generated ({id.ToString("N")[..8]}…). Narration starting.");
        }
        catch (Exception ex)
        {
            Toast.Error("EPISODE-FAIL", $"Continue failed: {ex.Message}");
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    /// <summary>Persist the current playback position so Resume can pick it up.</summary>
    private async Task SavePositionAsync()
    {
        if (currentEpisode == null) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.Episodes.FirstOrDefaultAsync(e => e.Id == currentEpisode.Id);
            if (row == null) return;
            row.LastPlayedBeatIndex = currentBeatIndex;
            row.LastPlayedSec       = currentTimeInBeat;
            await db.SaveChangesAsync();
        }
        catch { /* non-critical — next save will retry */ }
    }

    private void StartPolling()
    {
        poll?.Dispose();
        poll = new System.Threading.Timer(async _ =>
        {
            if (currentEpisode == null) return;
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var fresh = await db.Episodes
                    .Include(e => e.Beats)
                    .AsNoTracking()
                    .FirstOrDefaultAsync(e => e.Id == currentEpisode.Id);
                if (fresh != null)
                {
                    currentEpisode = fresh;
                    RecomputeTimeline();
                    await InvokeAsync(StateHasChanged);
                    if (fresh.Status == "ready" || fresh.Status == "failed")
                    {
                        poll?.Dispose();
                        poll = null;
                    }
                }
            }
            catch { /* swallow — next tick will retry */ }
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(3));

        // playhead-update tick: poll the audio element's currentTime ~3x/sec
        // and refresh the playhead. Cheap interop call.
        tick?.Dispose();
        tick = new System.Threading.Timer(async _ =>
        {
            try
            {
                var t = await JS.InvokeAsync<double>("episodePlayer.getCurrentTime", AudioElementId);
                var playing = await JS.InvokeAsync<bool>("episodePlayer.isPlaying", AudioElementId);
                if (Math.Abs(t - currentTimeInBeat) > 0.05 || playing != isPlaying)
                {
                    currentTimeInBeat = t;
                    isPlaying = playing;
                    RecomputeTimeline();
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch { /* element gone / page disposed */ }
        }, null, TimeSpan.FromMilliseconds(400), TimeSpan.FromMilliseconds(330));
    }

    /// <summary>Compute totalEstimateSec, narratedTotalSec, and virtualPlayheadSec
    /// from the current episode + current beat index + currentTimeInBeat.</summary>
    private void RecomputeTimeline()
    {
        totalEstimateSec = 0;
        narratedTotalSec = 0;
        virtualPlayheadSec = 0;
        if (currentEpisode == null) return;

        var ordered = currentEpisode.Beats.OrderBy(b => b.SortKey).ToList();
        for (int i = 0; i < ordered.Count; i++)
        {
            var beat = ordered[i];
            double dur = beat.DurationSec
                ?? Math.Max(1.0, beat.Text.Length / EstimateCharsPerSec);
            totalEstimateSec += dur;

            if (!string.IsNullOrEmpty(beat.AudioPath) && beat.DurationSec.HasValue)
                narratedTotalSec += beat.DurationSec.Value;

            if (i < currentBeatIndex)
            {
                virtualPlayheadSec += beat.DurationSec ?? dur;
            }
            else if (i == currentBeatIndex)
            {
                virtualPlayheadSec += Math.Min(currentTimeInBeat, beat.DurationSec ?? dur);
            }
        }
    }

    private async Task TogglePlay()
    {
        if (currentEpisode == null) return;
        var nowPlaying = await JS.InvokeAsync<bool>("episodePlayer.toggle", AudioElementId);
        isPlaying = nowPlaying;
    }

    private async Task Back10()
    {
        if (currentEpisode == null) return;
        await SeekVirtualAsync(Math.Max(0, virtualPlayheadSec - 10));
    }

    private async Task Fwd10()
    {
        if (currentEpisode == null) return;
        // Only seek into already-rendered audio. Forward past the rendered region
        // is a no-op (you can't scrub into audio that doesn't exist yet).
        var cap = narratedTotalSec > 0 ? narratedTotalSec : virtualPlayheadSec;
        await SeekVirtualAsync(Math.Min(cap, virtualPlayheadSec + 10));
    }

    private async Task OnTrackClick(MouseEventArgs e)
    {
        if (currentEpisode == null || totalEstimateSec <= 0) return;
        // The track is roughly the width of the card body. The OffsetX is the
        // click position within the bar; the bar's clientWidth isn't on the
        // event, so we use a fixed approximation: page width fraction.
        // Browsers send OffsetX relative to the clicked element, which IS the
        // bar — so we just need the bar's width. We approximate via JS.
        var widthPx = await JS.InvokeAsync<double>("eval", new object[] { "document.querySelector('.position-relative[style*=\"cursor:pointer\"]').clientWidth" });
        if (widthPx <= 0) widthPx = 1;
        var fraction = Math.Clamp(e.OffsetX / widthPx, 0.0, 1.0);
        var targetVirtual = fraction * totalEstimateSec;
        // Don't allow seeking past the narrated region.
        if (narratedTotalSec > 0 && targetVirtual > narratedTotalSec)
            targetVirtual = narratedTotalSec;
        await SeekVirtualAsync(targetVirtual);
    }

    /// <summary>Translate a virtual-timeline position into (beatIndex, secondsIntoBeat)
    /// and tell the audio element to load+seek there.</summary>
    private async Task SeekVirtualAsync(double targetVirtualSec)
    {
        if (currentEpisode == null) return;
        var ordered = currentEpisode.Beats.OrderBy(b => b.SortKey).ToList();

        double acc = 0;
        int targetBeat = 0;
        double targetIntoBeat = 0;

        for (int i = 0; i < ordered.Count; i++)
        {
            var beat = ordered[i];
            double dur = beat.DurationSec
                ?? Math.Max(1.0, beat.Text.Length / EstimateCharsPerSec);

            if (acc + dur >= targetVirtualSec)
            {
                targetBeat = i;
                targetIntoBeat = Math.Max(0, targetVirtualSec - acc);
                break;
            }
            acc += dur;
            targetBeat = i + 1;
            targetIntoBeat = 0;
        }

        // Only jump to a beat that has audio rendered. If we'd land in an
        // unrendered beat, stop at the last rendered one.
        if (targetBeat >= ordered.Count || string.IsNullOrEmpty(ordered[targetBeat].AudioPath))
        {
            var lastReady = ordered.LastOrDefault(b => !string.IsNullOrEmpty(b.AudioPath));
            if (lastReady == null) return;
            targetBeat = lastReady.Index;
            targetIntoBeat = lastReady.DurationSec ?? 0;
        }

        if (targetBeat != currentBeatIndex)
        {
            currentBeatIndex = targetBeat;
            currentTimeInBeat = targetIntoBeat;
            // The @key change forces the audio element to reload the new src;
            // after render we set currentTime via JS.
            await InvokeAsync(StateHasChanged);
            await Task.Delay(120);
            await JS.InvokeVoidAsync("episodePlayer.seek", AudioElementId, targetIntoBeat);
            if (isPlaying) await JS.InvokeVoidAsync("episodePlayer.play", AudioElementId);
        }
        else
        {
            await JS.InvokeVoidAsync("episodePlayer.seek", AudioElementId, targetIntoBeat);
            currentTimeInBeat = targetIntoBeat;
        }
        RecomputeTimeline();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnBeatEnded()
    {
        if (currentEpisode == null) return;

        var nextIndex = currentBeatIndex + 1;
        var nextBeat = currentEpisode.Beats.FirstOrDefault(b => b.Index == nextIndex);

        if (nextBeat != null && !string.IsNullOrEmpty(nextBeat.AudioPath))
        {
            currentBeatIndex = nextIndex;
            currentTimeInBeat = 0;
            isPlaying = true;
            RecomputeTimeline();
            await SavePositionAsync();
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            // End of rendered audio. If status==ready, episode is complete; otherwise
            // wait for the poll timer to refresh.
            isPlaying = false;
            if (currentEpisode.Status == "ready" &&
                !currentEpisode.Beats.Any(b => b.Index > currentBeatIndex))
            {
                await SavePositionAsync();
                Toast.Success("EPISODE-END", "Episode complete. Score it in /inbox.");
            }
        }
    }

    private static string FormatTime(double sec)
    {
        if (sec < 0 || double.IsNaN(sec) || double.IsInfinity(sec)) sec = 0;
        var t = TimeSpan.FromSeconds(sec);
        return t.TotalHours >= 1
            ? $"{(int)t.TotalHours}:{t.Minutes:D2}:{t.Seconds:D2}"
            : $"{t.Minutes}:{t.Seconds:D2}";
    }

    private async Task Reset()
    {
        await SavePositionAsync();
        poll?.Dispose();
        tick?.Dispose();
        poll = null;
        tick = null;
        currentEpisode = null;
        currentBeatIndex = 0;
        currentTimeInBeat = 0;
        virtualPlayheadSec = 0;
        totalEstimateSec = 0;
        narratedTotalSec = 0;
        isPlaying = false;
        await LoadRecentAsync();
    }

    public void Dispose()
    {
        // Fire-and-forget the position save; the page is going away.
        _ = SavePositionAsync();
        poll?.Dispose();
        tick?.Dispose();
    }
}
