@page "/profile"
@page "/account"
@inject ProfileService ProfileSvc
@inject IWriteAccessProvider Access
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject PasswordPolicyDescriptor Policy

<div class="d-flex flex-column gap-4">

    @* ── Avatar ───────────────────────────────────── *@
    <div class="d-flex gap-4 align-items-start flex-wrap">
        <div class="d-flex flex-column align-items-center gap-2">
            @if (!string.IsNullOrEmpty(savedAvatar))
            {
                <img src="@savedAvatar" class="profile-avatar-lg" alt="@Access.CurrentUserName" />
            }
            else
            {
                <div class="profile-avatar-empty-lg"><i class="bi bi-person-fill"></i></div>
            }
            <span class="text-muted small">@Access.CurrentUserName</span>
        </div>

        <div class="d-flex flex-column gap-3" style="min-width: 240px; max-width: 360px;">
            <div>
                <div class="field-label mb-1">Choose Image</div>
                <InputFile OnChange="OnFileSelected" accept="image/*"
                           class="form-control form-control-sm bg-dark text-light border-secondary" />
            </div>

            @if (showPreview)
            {
                <div>
                    <div class="field-label mb-1">Preview — center-cropped to square</div>
                    <canvas id="profile-preview" class="profile-canvas-preview"></canvas>
                </div>
                <button class="btn btn-sm btn-danger" @onclick="Capture">
                    <i class="bi bi-camera"></i><div class="btn-lbl"> Snapshot</div>
                </button>
            }

            @if (capturedDataUrl != null)
            {
                <div class="d-flex align-items-center gap-3">
                    <div>
                        <div class="field-label mb-1">64×64</div>
                        <img src="@capturedDataUrl" class="profile-avatar-lg" alt="Captured" />
                    </div>
                </div>
                <button class="btn btn-sm btn-success" @onclick="Save">
                    <i class="bi bi-floppy"></i><div class="btn-lbl"> Save Profile Picture</div>
                </button>
            }

            @if (!string.IsNullOrEmpty(avatarStatus))
            {
                <div class="text-muted small">@avatarStatus</div>
            }
        </div>
    </div>

    @* ── Change Password ──────────────────────────── *@
    <div class="card bg-dark text-light border-secondary" style="max-width: 420px;">
        <div class="card-header text-muted">Change Password</div>
        <div class="card-body d-flex flex-column gap-3">
            @if (passwordChanged)
            {
                <div class="alert alert-success py-2 small mb-0">
                    <i class="bi bi-check-circle-fill"></i> Password changed successfully.
                </div>
            }
            @* Presentation-only form; the MindAttic.Authentication endpoint
               (/_ma-auth/change-password) owns the change with current-password
               verification, then redirects to /account?changed=1 on success. *@
            <MaChangePassword Error="@passwordError" />
            <div class="text-muted" style="font-size: 0.72rem; line-height: 1.6;">
                @foreach (var req in Policy.Requirements)
                {
                    <div><i class="bi bi-dot"></i> @req</div>
                }
            </div>
        </div>
    </div>

</div>

@code {
    // ── Avatar ──────────────────────────────────────
    private string? savedAvatar;
    private string? capturedDataUrl;
    private string? pendingDataUrl;
    private bool showPreview;
    private string avatarStatus = "";

    // ── Password change status (driven by the /_ma-auth redirect query) ──
    private bool passwordChanged;
    private bool passwordError;

    protected override void OnInitialized()
    {
        savedAvatar = ProfileSvc.GetAvatar(Access.CurrentUserName ?? "");
        var query = new Uri(Nav.Uri).Query;
        passwordChanged = query.Contains("changed=1");
        passwordError = query.Contains("error=1");
    }

    // ── Avatar ──────────────────────────────────────

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingDataUrl != null)
        {
            var url = pendingDataUrl;
            pendingDataUrl = null;
            try { await JS.InvokeVoidAsync("profileInterop.loadPreview", url, "profile-preview"); }
            catch { }
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        try
        {
            using var ms = new MemoryStream();
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            await stream.CopyToAsync(ms);
            var mime = string.IsNullOrEmpty(file.ContentType) ? "image/png" : file.ContentType;
            pendingDataUrl = $"data:{mime};base64,{Convert.ToBase64String(ms.ToArray())}";
            capturedDataUrl = null;
            showPreview = true;
            avatarStatus = "";
        }
        catch (Exception ex)
        {
            avatarStatus = $"Could not load image: {ex.Message}";
        }
    }

    private async Task Capture()
    {
        try
        {
            capturedDataUrl = await JS.InvokeAsync<string>("profileInterop.capture", "profile-preview");
            avatarStatus = "";
        }
        catch (Exception ex)
        {
            avatarStatus = $"Snapshot failed: {ex.Message}";
        }
    }

    private void Save()
    {
        if (capturedDataUrl == null) return;
        ProfileSvc.SaveAvatar(Access.CurrentUserName ?? "", capturedDataUrl);
        savedAvatar = capturedDataUrl;
        capturedDataUrl = null;
        showPreview = false;
        avatarStatus = "Profile picture saved.";
    }
}
