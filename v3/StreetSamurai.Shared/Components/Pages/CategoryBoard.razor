@page "/board/{slug}"

<div class="cyberspace-sl-fine"    aria-hidden="true"></div>
<div class="cyberspace-sl-coarse"  aria-hidden="true"></div>
<div class="console-bg-host" aria-hidden="true"></div>

@inject CharacterRepository CharRepo
@inject ArchetypeRepository ArchetypeRepo
@inject CorponationRepository CorpRepo
@inject SubsidiaryRepository SubsidiaryRepo
@inject FactionRepository FactionRepo
@inject WeaponryRepository WeaponRepo
@inject AmmunitionRepository AmmoRepo
@inject CyberwareRepository CyberRepo
@inject EquipmentRepository EquipRepo
@inject ApparelRepository ApparelRepo
@inject GenemodRepository GenemodRepo
@inject PharmaceuticalRepository PharmaRepo
@inject DistrictRepository DistrictRepo
@inject TransportationRepository TransportRepo
@inject MaterialRepository MaterialRepo
@inject TechnologyRepository TechRepo
@inject AutomatonRepository AutomatonRepo
@inject WorldbuildingDocRepository DocRepo
@inject QuoteRepository QuoteRepo
@inject VocabularyRepository VocabRepo
@inject NewsRepository NewsRepo
@inject EntertainmentRepository EntertainmentRepo
@inject ConsumerGoodRepository GoodsRepo
@inject LabSpecimenRepository LabSpecimenRepo
@inject FlyoverEntityRepository FlyoverRepo
@inject PsionicRepository PsionicRepo
@inject IWriteAccessProvider Access


@if (tiles.Count == 0)
{
    <div class="text-muted">Unknown category.</div>
}
else
{
    <div class="board-grid">
        @foreach (var tile in tiles.Where(t => t.AlwaysShow || t.Count > 0))
        {
            <a href="@tile.Href" class="board-tile" title="@tile.Tooltip">
                <i class="bi @tile.Icon board-tile-icon"></i>
                <div class="board-tile-name">@tile.Name</div>
                @if (tile.Count > 0)
                {
                    <span class="board-tile-count">@tile.Count</span>
                }
            </a>
        }
    </div>
}

@code {
    [Parameter] public string? Slug { get; set; }

    record BoardTile(string Icon, string Href, string Name, int Count, bool AlwaysShow = false, string Tooltip = "");

    string title = "";
    List<BoardTile> tiles = [];

    protected override void OnParametersSet()
    {
        title = Slug?.ToLower() switch
        {
            "characters"     => "Characters",
            "organizations"  => "Organizations",
            "gear"           => "Gear",
            "world"          => "World",
            "culture"        => "Culture",
            "tools"          => "Tools",
            "visualizations" => "Visualizations",
            _                => Slug ?? "Board"
        };

        tiles = title switch
        {
            "Characters" =>
            [
                new("bi-people",              "/characters",      "People",          CharRepo.Count(), false, "All sentient characters — human, AI, E.L.F. (Emergent Lifeform), and synthetic — with full psychology, speech patterns, behavioral rules, cyberware, and timelines. Browse and edit by species."),
                new("bi-person-bounding-box", "/archetypes",      "Archetypes",      ArchetypeRepo.Count(), false, "Reusable character archetype templates with trait weights — seed for new character generation."),
            ],
            "Organizations" =>
            [
                new("bi-building",            "/corps",           "Corponations",    CorpRepo.Count(), false, "Corporate nation-states that replaced governments. Own territory, field armies, write laws within their zones."),
                new("bi-diagram-3",           "/subsidiaries",    "Subsidiaries",    SubsidiaryRepo.Count(), false, "Subsidiary corps under corponations. Smaller scope — often a single product line, region, or service."),
                new("bi-shield-exclamation",  "/factions",        "Factions",        FactionRepo.Count(), false, "Non-corporate organizations: gangs, syndicates, cults, freelancer collectives, political movements."),
            ],
            "Gear" =>
            [
                new("bi-crosshair",           "/weaponry",        "Weaponry",        WeaponRepo.Count(), false, "Weapons with tactical use, manufacturer, tier, and cultural context. Described by what they do to flesh, not by model number."),
                new("bi-bullseye",            "/ammunition",      "Ammunition",      AmmoRepo.Count(), false, "Ammo types and effects — specialty rounds, hand-fit slugs, suppression loads."),
                new("bi-motherboard",         "/cyberware",       "Cyberware",       CyberRepo.Count(), false, "Augmentations with body location, manufacturer, tier, condition (functional / damaged / destroyed)."),
                new("bi-shield-shaded",       "/equipment",       "Equipment",       EquipRepo.Count(), false, "Gear, tools, and field equipment that aren't weapons or apparel."),
                new("bi-handbag",             "/apparel",         "Apparel",         ApparelRepo.Count(), false, "Clothing — tier-coded fashion that signals affiliation, status, and intent."),
                new("bi-virus",               "/genemods",        "Genemods",        GenemodRepo.Count(), false, "Genetic modifications with effects, side effects, and accessibility tier."),
                new("bi-capsule",             "/pharmaceuticals", "Pharmaceuticals", PharmaRepo.Count(), false, "Drugs both legal and illegal: stimulants, suppressants, augment-control meds, recreational use."),
                new("bi-lightbulb",           "/psionics",        "Psionics",        PsionicRepo.Count(), false, "Documented psionic abilities — telepathy, precog, kinesis. Rare, expensive to host, and never quite reliable."),
            ],
            "World" =>
            [
                new("bi-geo-alt",             "/places",          "Places",          DistrictRepo.Count(), false, "Districts, buildings, landmarks. Atmosphere (sights / sounds / smells / feel), demographics, dangers, exits."),
                new("bi-truck",               "/transportation",  "Transportation",  TransportRepo.Count(), false, "Vehicles + the Pulse — magnetic vacuum tube transit at Mach 6. Chicago is the world hub."),
                new("bi-gem",                 "/materials",       "Materials",       MaterialRepo.Count(), false, "Construction materials and their properties: ferrocement, smart polymers, carbon weave, etc."),
                new("bi-cpu",                 "/technology",      "Technology",      TechRepo.Count(), false, "Tech concepts and systems: BCI, NeoCortex, ballistic precognition, the network layer."),
                new("bi-robot",               "/automata",        "Automata",        AutomatonRepo.Count(), false, "Autonomous machines — NOT synthetic life. Iowan Behemoths, security drones, factory units."),
                new("bi-eyedropper",          "/specimens",       "Lab Specimens",   LabSpecimenRepo.Count(), false, "Captured / cataloged biological samples studied in corp labs and academic facilities. The strange biology of the post-Collapse world."),
                new("bi-bug",                 "/wasteland",       "Wasteland",       FlyoverRepo.Count(), false, "Flyover entities — the wildlife (and worse) that survives outside the corridor. Mutated fauna, drift-zone creatures, undocumented species."),
                new("bi-book",                "/rules",           "World Rules",     0, true, "Hard prose constraints (literary_rules.json) injected into every generation call as NON-NEGOTIABLE."),
            ],
            "Culture" =>
            [
                new("bi-file-earmark-text",   "/documents",       "Documents",       DocRepo.Count(), false, "Long-form worldbuilding lore: history, sociology, politics, deep-canon essays."),
                new("bi-quote",               "/quotes",          "Quotes",          QuoteRepo.Count(), false, "In-world quotations attributed to characters, documents, or sources."),
                new("bi-chat-quote",          "/vocabulary",      "Vocabulary",      VocabRepo.Count(), false, "GLMZ-specific terminology: street slang, corporate jargon, technical terms."),
                new("bi-newspaper",           "/news",            "News Archive",    NewsRepo.Count(), false, "Period news articles and headlines from the GLMZ media ecosystem."),
                new("bi-film",                "/entertainment",   "Entertainment",   EntertainmentRepo.Count(), false, "Films, books, music, and games that exist in-world — pop culture characters reference."),
                new("bi-basket",              "/goods",           "Consumer Goods",  GoodsRepo.Count(), false, "Branded products characters consume: Libation Corp drinks, branded foods, household items."),
            ],
            "Tools" => BuildToolsTiles(),
            "Visualizations" =>
            [
                new("bi-diagram-3",           "/graph",           "World Graph",     0, true, "2D D3 force-directed view of every entity and relationship. Pan, zoom, click any node to drill in."),
                new("bi-bounding-box",        "/graph-3d",        "World Graph 3D",  0, true, "Three-dimensional rendering of the same graph. Spatial clustering reveals tight subgraphs the 2D view smushes flat."),
                new("bi-map-fill",            "/map",             "Map",             0, true, "Geographic layout of GLMZ districts and exits. Zork-style directional travel between places."),
                new("bi-tree-fill",           "/heritage",        "Heritage",        0, true, "Ethnic / genetic ancestry heatmap of the cast — visualizes the Ubiquitous Diaspora."),
            ],
            _ => []
        };
    }

    private List<BoardTile> BuildToolsTiles()
    {
        var list = new List<BoardTile>
        {
            new("bi-speedometer2",    "/dashboard", "Dashboard",     0, true, "Live overview: entity counts across all repositories, world-graph size, story counts, configured-service status. Your at-a-glance health check."),
            new("bi-chat-dots",       "/ask",       "Ask",           0, true, "Ask questions in natural language against the live JSON + chapter prose. Reindexes on save so answers always reflect the current truth on disk."),
            new("bi-book-half",       "/atlas",     "Atlas",         0, true, "System-wide directory of every entity type, service, and architectural component. The whole codebase + canon expressed as a hierarchy."),
        };
        if (Access.IsAdministrator)
        {
            list.Add(new("bi-diagram-3",   "/architecture", "Architecture", 0, true, "Live scan of every service, CLI verb, MCP tool, Razor page, and script. Surfaces duplicate / overlapping names so you can spot dead utilities at a glance."));
        }
        if (Access.IsContributor)
        {
            list.Add(new("bi-book",            "/books",        "Bookshelf",     0, true, "Every book in the project. Pick one to drill into chapters, outline, motifs, review, and continuity."));
            list.Add(new("bi-collection",      "/series",       "Series",        0, true, "Group books into multi-book arcs. Stub for now; future home for series-level outlines and continuity."));
            list.Add(new("bi-database-check",  "/continuity",   "Continuity",    0, true, "Unified atomic-claim store. Extracts (entity, predicate, object) triples from chapter prose AND entity records via Legion Quorum, surfaces contradictions automatically, lets you resolve A / B / custom, and applies the agreed value back to the entity record (Legion picks the field)."));
        }
        return list;
    }
}
