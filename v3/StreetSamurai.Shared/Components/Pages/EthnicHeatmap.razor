@page "/heritage"
@inject CharacterRepository CharRepo
@inject IJSRuntime JS

<h4 class="text-danger mb-1">Genetic Ancestry Heatmap</h4>
<p class="text-muted mb-3">23andMe-style genetic ancestry across @totalCharacters people in the GLMZ. Based on demographic projections for a 2226 megacity. Click a region to drill down into sub-groups.</p>

<div class="row g-3 mb-3">
    <div class="col-auto">
        <span class="badge bg-secondary">@totalCharacters people</span>
        <span class="badge bg-secondary">@uniqueGroups ancestry groups</span>
        <span class="badge bg-danger">Weighted by genetic percentage per person</span>
    </div>
</div>

<div id="heritage-treemap" style="width:100%; min-height:500px; background:#161b22; border-radius:8px; border:1px solid #30363d;"></div>

@if (heritageData.Count > 0)
{
    <div class="mt-3">
        <h6 class="text-muted">Heritage Groups</h6>
        <table class="table table-sm table-dark">
            <thead><tr><th>Heritage</th><th class="text-end">References</th><th class="text-end">%</th><th>Bar</th></tr></thead>
            <tbody>
                @foreach (var h in heritageData)
                {
                    <tr>
                        <td class="text-light">@h.name</td>
                        <td class="text-end text-muted">@h.value</td>
                        <td class="text-end text-muted">@h.pct%</td>
                        <td style="width:200px;">
                            <div style="background:#dc3545; height:12px; border-radius:3px; width:@(h.value * 100 / heritageData[0].value)%"></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<HeritageEntry> heritageData = [];
    private int totalCharacters;
    private int totalReferences;
    private int uniqueGroups;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ParseHeritages();
            var hierarchy = BuildHierarchy();
            StateHasChanged();
            await Task.Delay(100);
            await JS.InvokeVoidAsync("heritageTreemap.render", "heritage-treemap", hierarchy);
        }
    }

    private void ParseHeritages()
    {
        var weightedCounts = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);
        var characters = CharRepo.GetAll();
        totalCharacters = characters.Count;

        foreach (var c in characters)
        {
            var ancestry = c.GeneticAncestry;
            if (ancestry == null || ancestry.Count == 0) continue;

            // Each character contributes their percentages (so 40% African = 0.4 weight)
            foreach (var (group, pct) in ancestry)
            {
                if (pct <= 0) continue;
                weightedCounts[group] = weightedCounts.GetValueOrDefault(group) + pct;
            }
        }

        // Convert weighted counts to display values (average percentage across population)
        var totalWeight = weightedCounts.Values.Sum();
        uniqueGroups = weightedCounts.Count;
        totalReferences = (int)totalWeight;

        heritageData = weightedCounts
            .OrderByDescending(kv => kv.Value)
            .Select(kv => new HeritageEntry
            {
                name = kv.Key,
                value = (int)Math.Round(kv.Value),
                pct = totalWeight > 0 ? (kv.Value * 100.0 / totalWeight).ToString("F1") : "0"
            })
            .ToList();
    }


    // Map specific ancestry groups to their parent region for drill-down
    private static readonly Dictionary<string, string> GroupToRegion = new(StringComparer.OrdinalIgnoreCase)
    {
        // East Asian
        ["Chinese"] = "East Asian",
        ["Korean"] = "East Asian",
        ["Japanese"] = "East Asian",
        // Southeast Asian
        ["Vietnamese"] = "Southeast Asian",
        ["Filipino"] = "Southeast Asian",
        ["Indonesian"] = "Southeast Asian",
        ["Laotian"] = "Southeast Asian",
        ["Cambodian"] = "Southeast Asian",
        ["Thai"] = "Southeast Asian",
        // These map to themselves (already top-level regions)
        ["Sub-Saharan African"] = "Sub-Saharan African",
        ["Hispanic/Latin American"] = "Hispanic/Latin American",
        ["South Asian"] = "South Asian",
        ["Northern European"] = "Northern European",
        ["Eastern European"] = "Eastern European",
        ["Middle Eastern"] = "Middle Eastern",
        ["Pacific Islander"] = "Pacific Islander",
        ["Indigenous American"] = "Indigenous American",
        ["Central Asian"] = "Central Asian",
        ["North African"] = "North African",
    };

    private List<RegionEntry> BuildHierarchy()
    {
        // Group the flat heritageData into regions with drill-down sub-groups
        var regionMap = new Dictionary<string, List<HeritageEntry>>();

        foreach (var entry in heritageData)
        {
            var region = GroupToRegion.GetValueOrDefault(entry.name, entry.name);
            if (!regionMap.ContainsKey(region))
                regionMap[region] = [];
            regionMap[region].Add(entry);
        }

        var totalWeight = heritageData.Sum(e => e.value);

        return regionMap
            .Select(kv => new RegionEntry
            {
                name = kv.Key,
                value = kv.Value.Sum(e => e.value),
                pct = totalWeight > 0 ? (kv.Value.Sum(e => e.value) * 100.0 / totalWeight).ToString("F1") : "0",
                subGroups = kv.Value.Count > 1 ? kv.Value : []
            })
            .OrderByDescending(r => r.value)
            .ToList();
    }

    private record HeritageEntry
    {
        public string name { get; init; } = "";
        public int value { get; init; }
        public string pct { get; init; } = "0";
    }

    private record RegionEntry
    {
        public string name { get; init; } = "";
        public int value { get; init; }
        public string pct { get; init; } = "0";
        public List<HeritageEntry> subGroups { get; init; } = [];
    }
}
