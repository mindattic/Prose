@page "/heritage"
@inject CharacterRepository CharRepo
@inject IJSRuntime JS

<h4 class="text-danger mb-1">Genetic Ancestry Heatmap</h4>
<p class="text-muted mb-3">23andMe-style genetic ancestry across @totalCharacters characters in the GLMZ. Based on demographic projections for a 2226 megacity. Independent of surname heritage.</p>

<div class="row g-3 mb-3">
    <div class="col-auto">
        <span class="badge bg-secondary">@totalCharacters characters</span>
        <span class="badge bg-secondary">@uniqueGroups ancestry groups</span>
        <span class="badge bg-danger">Weighted by genetic percentage per character</span>
    </div>
</div>

<div id="heritage-treemap" style="width:100%; min-height:500px; background:#161b22; border-radius:8px; border:1px solid #30363d;"></div>

@if (heritageData.Count > 0)
{
    <div class="mt-3">
        <h6 class="text-muted">Top 30 Heritage Groups</h6>
        <table class="table table-sm table-dark">
            <thead><tr><th>Heritage</th><th class="text-end">References</th><th class="text-end">%</th><th>Bar</th></tr></thead>
            <tbody>
                @foreach (var h in heritageData.Take(30))
                {
                    <tr>
                        <td class="text-light">@h.name</td>
                        <td class="text-end text-muted">@h.value</td>
                        <td class="text-end text-muted">@h.pct%</td>
                        <td style="width:200px;">
                            <div style="background:#dc3545; height:12px; border-radius:3px; width:@(h.value * 100 / heritageData[0].value)%"></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<HeritageEntry> heritageData = [];
    private int totalCharacters;
    private int totalReferences;
    private int uniqueGroups;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ParseHeritages();
            StateHasChanged();
            await Task.Delay(100);
            await JS.InvokeVoidAsync("heritageTreemap.render", "heritage-treemap", heritageData);
        }
    }

    private void ParseHeritages()
    {
        var weightedCounts = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);
        var characters = CharRepo.GetAll();
        totalCharacters = characters.Count;

        foreach (var c in characters)
        {
            var ancestry = c.GeneticAncestry;
            if (ancestry == null || ancestry.Count == 0) continue;

            // Each character contributes their percentages (so 40% African = 0.4 weight)
            foreach (var (group, pct) in ancestry)
            {
                if (pct <= 0) continue;
                weightedCounts[group] = weightedCounts.GetValueOrDefault(group) + pct;
            }
        }

        // Convert weighted counts to display values (average percentage across population)
        var totalWeight = weightedCounts.Values.Sum();
        uniqueGroups = weightedCounts.Count;
        totalReferences = (int)totalWeight;

        heritageData = weightedCounts
            .OrderByDescending(kv => kv.Value)
            .Select(kv => new HeritageEntry
            {
                name = kv.Key,
                value = (int)Math.Round(kv.Value),
                pct = totalWeight > 0 ? (kv.Value * 100.0 / totalWeight).ToString("F1") : "0"
            })
            .ToList();
    }

    private static List<string> ExtractGroups(string heritage)
    {
        // Heritage strings look like:
        // "West African / Eastern European (Polish)"
        // "Somali / Russian / Polynesian (Tuvaluan)"
        // "West African (Yoruba) / French-Québécois / Polish"
        // "Angolan / Mongolian"
        // Split on " / " first, then extract sub-groups from parentheses

        var results = new List<string>();
        var parts = heritage.Split(new[] { " / ", " and " }, StringSplitOptions.RemoveEmptyEntries);

        foreach (var part in parts)
        {
            var trimmed = part.Trim();

            // Strip stuff like "(derived from surname blend)" or "(diaspora blend)"
            if (trimmed.Contains("derived from") || trimmed.Contains("surname") || trimmed.Contains("diaspora blend"))
            {
                var cleanIdx = trimmed.IndexOf('(');
                if (cleanIdx > 0) trimmed = trimmed[..cleanIdx].Trim();
            }

            // "West African (Yoruba)" → only "Yoruba" (specific wins over broad)
            // "Eastern European (Polish)" → only "Polish"
            // "West African" (no specifics) → "West African"
            var parenOpen = trimmed.IndexOf('(');
            var parenClose = trimmed.IndexOf(')');
            if (parenOpen > 0 && parenClose > parenOpen)
            {
                var broad = trimmed[..parenOpen].Trim();
                var specific = trimmed[(parenOpen + 1)..parenClose].Trim();

                // Extract specific sub-groups — these replace the broad label
                var specifics = specific.Split(new[] { '/', ',' }, StringSplitOptions.RemoveEmptyEntries)
                    .Select(s => s.Trim())
                    .Where(s => s.Length > 2)
                    .ToList();

                if (specifics.Count > 0)
                {
                    // Use specific groups only — don't also add the broad region
                    results.AddRange(specifics);
                }
                else
                {
                    // No valid specifics, fall back to broad
                    if (broad.Length > 2) results.Add(broad);
                }
            }
            else
            {
                // Hyphenated like "French-Québécois" → split
                if (trimmed.Contains('-') && !trimmed.Contains("Anglo-"))
                {
                    foreach (var h in trimmed.Split('-'))
                    {
                        var hh = h.Trim();
                        if (hh.Length > 2) results.Add(hh);
                    }
                }
                else if (trimmed.Length > 2)
                {
                    results.Add(trimmed);
                }
            }
        }

        return results;
    }

    // Broad labels that the LLM used as lazy defaults — redistribute to specifics
    private static readonly Dictionary<string, string[]> BroadToSpecific = new()
    {
        ["West African"] = ["Yoruba", "Igbo", "Ghanaian", "Nigerian", "Senegalese", "Malian", "Guinean", "Akan"],
        ["East African"] = ["Ethiopian", "Kenyan", "Somali", "Tanzanian", "Ugandan"],
        ["Scandinavian"] = ["Swedish", "Norwegian", "Danish", "Finnish", "Icelandic"],
        ["Eastern European"] = ["Polish", "Russian", "Czech", "Hungarian", "Romanian", "Ukrainian", "Serbian", "Croatian"],
        ["South Asian"] = ["Indian", "Pakistani", "Bangladeshi", "Sri Lankan", "Nepali"],
        ["Southeast Asian"] = ["Filipino", "Vietnamese", "Thai", "Indonesian", "Malaysian"],
        ["Latin American"] = ["Mexican", "Brazilian", "Colombian", "Peruvian", "Chilean", "Argentine"],
        ["Central Asian"] = ["Kazakh", "Uzbek", "Kyrgyz", "Mongolian"],
    };

    private static string NormalizeGroup(string group)
    {
        var g = group.Trim().Trim(',', '.', ';');
        if (g.Length <= 2) return "";

        return g switch
        {
            "Québécois" => "French",
            "Anglo" => "British",
            "Slavic" => "Eastern European",
            "Bantu" => "Central African",
            _ => g
        };
    }

    /// <summary>
    /// When a broad label like "West African" has no specifics, pick a random specific
    /// group from the known set — distributes the blob into realistic sub-groups.
    /// Uses a deterministic hash so the same character always gets the same assignment.
    /// </summary>
    private static string RedistributeBroad(string group, string characterName)
    {
        if (BroadToSpecific.TryGetValue(group, out var specifics))
        {
            var hash = Math.Abs(characterName.GetHashCode());
            return specifics[hash % specifics.Length];
        }
        return group;
    }

    private record HeritageEntry
    {
        public string name { get; init; } = "";
        public int value { get; init; }
        public string pct { get; init; } = "0";
    }
}
