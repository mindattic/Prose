@page "/oracle"
@inject WorldOracleService Oracle
@implements IDisposable

<h4 class="text-danger mb-1">World Oracle</h4>
<p class="text-muted small mb-3">Ask factual questions about the GLMZ world. Answers are grounded strictly in documented canon — if it's not in the data, the oracle says so.</p>

<div class="row g-3">

    @* ── Input ─────────────────────────────────────────── *@
    <div class="col-12">
        <div class="card bg-dark border-secondary">
            <div class="card-body">
                <textarea class="form-control bg-dark text-light border-secondary mb-2"
                          rows="2"
                          placeholder="Does the barber have any documented relatives? Who runs the Central Ledger district? What gear does Sable carry?"
                          @bind="question"
                          @onkeydown="HandleKey"
                          disabled="@loading" />
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-danger btn-sm" @onclick="Ask" disabled="@(loading || string.IsNullOrWhiteSpace(question))">
                        @if (loading)
                        {
                            <span class="spinner-border spinner-border-sm me-1" />
                            <span>Consulting canon…</span>
                        }
                        else
                        {
                            <i class="bi bi-search me-1"></i>
                            <span>Ask Oracle</span>
                        }
                    </button>
                    @if (history.Count > 0)
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="ClearHistory">Clear history</button>
                    }
                </div>
            </div>
        </div>
    </div>

    @* ── Answers ────────────────────────────────────────── *@
    @foreach (var entry in history)
    {
        <div class="col-12">
            <div class="card bg-dark border-@(entry.IsDocumented ? "secondary" : "warning")">
                <div class="card-body">

                    @* Question *@
                    <div class="text-muted small mb-2">
                        <i class="bi bi-question-circle me-1"></i>@entry.Question
                    </div>

                    @* Answer *@
                    @if (!entry.IsDocumented)
                    {
                        <div class="d-flex align-items-start gap-2 mb-2">
                            <span class="badge bg-warning text-dark flex-shrink-0 mt-1">NOT DOCUMENTED</span>
                            <span class="text-warning">@entry.Answer</span>
                        </div>
                    }
                    else
                    {
                        <p class="mb-2">@entry.Answer</p>
                    }

                    @* Undocumented claims *@
                    @if (entry.UndocumentedClaims.Count > 0)
                    {
                        <div class="mb-2">
                            <span class="text-warning small fw-bold">Missing from canon:</span>
                            <ul class="mb-0 mt-1">
                                @foreach (var claim in entry.UndocumentedClaims)
                                {
                                    <li class="text-warning small">@claim</li>
                                }
                            </ul>
                        </div>
                    }

                    @* Sources *@
                    @if (entry.Sources.Count > 0)
                    {
                        <div class="mt-2 pt-2 border-top border-secondary">
                            <span class="text-muted small me-2">Sources consulted:</span>
                            @foreach (var src in entry.Sources)
                            {
                                <a href="/@RouteFor(src.EntityType)/@src.EntityId"
                                   class="badge bg-secondary text-decoration-none me-1 mb-1"
                                   title="relevance @(src.RelevanceScore.ToString("P0"))">
                                    @src.EntityName
                                    <span class="text-muted ms-1">(@src.EntityType)</span>
                                </a>
                            }
                        </div>
                    }

                    <div class="text-muted" style="font-size:0.7rem;">@entry.AskedAt.ToLocalTime().ToString("HH:mm:ss")</div>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private string question = "";
    private bool loading;
    private readonly List<OracleAnswer> history = [];
    private CancellationTokenSource cts = new();

    private async Task Ask()
    {
        if (string.IsNullOrWhiteSpace(question) || loading) return;
        loading = true;
        var q = question.Trim();
        question = "";
        StateHasChanged();
        try
        {
            var answer = await Oracle.AskAsync(q, cts.Token);
            history.Insert(0, answer);
        }
        catch (OperationCanceledException) { }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && e.CtrlKey)
            await Ask();
    }

    private void ClearHistory() => history.Clear();

    private static string RouteFor(string entityType) => entityType switch
    {
        "character"   => "characters",
        "place"       => "places",
        "faction"     => "factions",
        "corponation" => "corps",
        "synthetic"   => "synthetics",
        "weapon"      => "weaponry",
        "contract"    => "contracts",
        _             => "search"
    };

    public void Dispose() => cts.Cancel();
}
