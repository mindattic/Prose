@page "/transportation"
@using StreetSamurai.Core.Models.Canon
@inject TransportationRepository Repo
@inject NavigationManager Nav

<div class="dict-layout">
    <div class="dict-list">
        <div class="card bg-dark text-light border-secondary mb-2 card-body">
            <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary mb-2"
                   placeholder="Filter..." @bind="filter" @bind:event="oninput" />
            <div class="d-flex gap-2">
            <ExportButton Mode="repo" ExtraStyle="flex:1;" RepoName="Transportation" GetRepoEntries="GetExportEntries" />
            <button class="btn btn-sm btn-outline-danger flex-fill" @onclick="AddNew"><i class="bi bi-plus-lg"></i> New</button>
            </div>
        </div>
        <div class="dict-items">
            @foreach (var t in FilteredItems)
            {
                <div class="list-item text-light @(editing?.Name == t.Name ? "active" : "")" @onclick="() => Edit(t)">
                    <div class="fw-bold small">@t.Name</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@t.Category — @t.Manufacturer</div>
                </div>
            }
        </div>
    </div>

    <div class="dict-editor">
        @if (editing != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-danger mb-0">@(isNew ? "New Vehicle" : editing.Name)</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i> Save</button>
                    @if (!isNew) { <ExportButton Mode="entry" RepoName="Transportation" EntryName="@editing.Name" EntryJson="@System.Text.Json.JsonSerializer.Serialize(editing)" /> }
                    @if (!isNew && !_confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-trash3"></i></button> }
                    @if (_confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete">Confirm</button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false">No</button> }
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 2; min-width: 200px;"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Name" /></div>
                <div style="flex: 1; min-width: 120px;"><div class="field-label">Category</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Category" /></div>
                <div style="flex: 1; min-width: 120px;"><div class="field-label">Manufacturer</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Manufacturer" /></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 120px;"><div class="field-label">Propulsion</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Propulsion" /></div>
                <div style="flex: 1; min-width: 100px;"><div class="field-label">Speed</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Speed" /></div>
                <div style="flex: 1; min-width: 100px;"><div class="field-label">Range</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Range" /></div>
                <div style="flex: 1; min-width: 100px;"><div class="field-label">Capacity</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Capacity" /></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 100px;"><div class="field-label">Tier</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.TierAvailability" /></div>
                <div style="flex: 1; min-width: 120px;"><div class="field-label">Cost</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Cost" /></div>
                <div style="flex: 1; min-width: 120px;"><div class="field-label">Autonomy</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Autonomy" /></div>
                <div style="flex: 1; min-width: 120px;"><div class="field-label">Armament</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Armament" /></div>
            </div>
            <div class="mb-3"><div class="field-label">Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="4" @bind="editing.Description"></textarea></div>
            <div class="mb-3"><div class="field-label">Common Usage</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="2" @bind="editing.CommonUsage"></textarea></div>
        }
        else
        {
            <div class="text-center text-muted py-5"><i class="bi bi-truck" style="font-size:3rem;"></i><p class="mt-2">Select a vehicle or create a new one.</p></div>
        }
    </div>
</div>

@code {
    private List<TransportationData> items = [];
    private TransportationData? editing;
    private string originalName = "";
    private string filter = "";
    private bool isNew, _confirmDelete;

    private IEnumerable<TransportationData> FilteredItems => string.IsNullOrWhiteSpace(filter)
        ? items : items.Where(t => t.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || t.Category.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || t.Manufacturer.Contains(filter, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized() { Repo.Reload(); items = Repo.GetAll(); if (Nav.Uri.Contains("new=true")) AddNew(); }
    private void AddNew() { editing = new TransportationData(); isNew = true; _confirmDelete = false; }
    private void Edit(TransportationData t) { editing = t; originalName = t.Name; isNew = false; _confirmDelete = false; }
    private void SaveEdit() { if (editing == null || string.IsNullOrWhiteSpace(editing.Name)) return; if (!isNew && originalName != editing.Name) Repo.Delete(originalName); Repo.Save(editing); editing = null; items = Repo.GetAll(); }
    private void DoDelete() { if (editing != null) { Repo.Delete(editing.Name); editing = null; items = Repo.GetAll(); _confirmDelete = false; } }
    private List<(string name, string json)> GetExportEntries() => items.Select(e => (e.Name, System.Text.Json.JsonSerializer.Serialize(e))).ToList();
}
