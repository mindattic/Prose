@page "/documents"
@inject WorldbuildingDocRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="dict-layout">
    <div class="dict-list bg-dark border-end border-secondary">
        @foreach (var d in _items)
        {
            <div class="list-item text-light @(_editing?.FileName == d.FileName ? "active" : "")" @onclick="() => Edit(d)">
                <div class="fw-bold small">@d.Title</div>
                <div class="text-muted" style="font-size: 0.7rem;">@d.Category</div>
            </div>
        }
    </div>

    <div class="dict-editor">
        @if (_editing != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-danger mb-0">@(_isNew ? "New Document" : _editing.Title)</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i> Save</button>
                    @if (!_isNew && !_confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-trash3"></i></button> }
                    @if (_confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete">Confirm</button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false">No</button> }
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-4"><div class="field-label">Title</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Title" /></div>
                <div class="col-4"><div class="field-label">Category</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Category" /></div>
                <div class="col-4"><div class="field-label">File Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.FileName" /></div>
            </div>

            <div class="mb-3"><div class="field-label">Body</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" style="font-family: Georgia, serif; line-height: 1.7;" @bind="_editing.Body"></textarea></div>
        }
        else { <div class="text-muted d-flex align-items-center justify-content-center h-100">Select a document or create a new one</div> }
    </div>
</div>

@code {
    private List<WorldbuildingDocument> _items = [];
    private WorldbuildingDocument? _editing;
    private bool _isNew, _confirmDelete;
    private string _originalName = "";
    protected override void OnInitialized() { Repo.Reload(); _items = Repo.GetAll(); if (Nav.Uri.Contains("new=true")) AddNew(); }
    private void AddNew() { _editing = new WorldbuildingDocument(); _isNew = true; _confirmDelete = false; }
    private void Edit(WorldbuildingDocument d) { _editing = d; _originalName = d.FileName; _isNew = false; _confirmDelete = false; }
    private void SaveEdit() { if (_editing == null || string.IsNullOrWhiteSpace(_editing.FileName)) return; if (!_isNew && _originalName != _editing.FileName) Repo.Delete(_originalName); Repo.Save(_editing); _editing = null; _items = Repo.GetAll(); }
    private void DoDelete() { if (_editing == null) return; Repo.Delete(_editing.FileName); _editing = null; _confirmDelete = false; _items = Repo.GetAll(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { await JS.InvokeVoidAsync("writeInterop.autoResizeAll"); }
}
