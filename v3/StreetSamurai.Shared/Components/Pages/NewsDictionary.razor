@page "/news"
@using StreetSamurai.Core.Models.Canon
@inject NewsRepository Repo
@inject NavigationManager Nav

<h4 class="text-danger mb-3">News</h4>
<div class="dict-layout">
    <div class="dict-list">
        <div class="card bg-dark text-light border-secondary mb-2 card-body">
            <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary mb-2"
                   placeholder="Filter..." @bind="filter" @bind:event="oninput" />
            <div class="mb-2">
                <TagFilter AllTags="allTags" SelectedTags="selectedTags" SelectedTagsChanged="OnTagsChanged" />
            </div>
            <div class="d-flex gap-2">
            <ExportButton Mode="repo" ExtraStyle="width:calc(50% - 5px);" RepoName="News" GetRepoEntries="GetExportEntries" />
            <button class="btn btn-sm btn-outline-danger" style="width:calc(50% - 5px)" @onclick="AddNew"><i class="bi bi-plus-lg"></i> New</button>
            </div>
        </div>
        <div class="dict-items">
            @foreach (var n in FilteredItems)
            {
                <div class="list-item text-light @(editing?.Headline == n.Headline ? "active" : "")" @onclick="() => Edit(n)">
                    <div class="fw-bold small">@n.Headline</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@n.Category</div>
                </div>
            }
        </div>
    </div>
    <div class="dict-editor">
        @if (editing != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-danger mb-0">@(isNew ? "New Report" : editing.Headline)</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i> Save</button>
                    @if (!isNew) { <ExportButton Mode="entry" RepoName="News" EntryName="@editing.Headline" EntryJson="@System.Text.Json.JsonSerializer.Serialize(editing)" /> }
                    @if (!isNew && !confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmDelete = true"><i class="bi bi-archive"></i></button> }
                    @if (confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete">Confirm</button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirmDelete = false">No</button> }
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 2; min-width: 200px;"><div class="field-label">Headline</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Headline" /></div>
                <div style="flex: 1; min-width: 100px;"><div class="field-label">Date</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" placeholder="2185-03-14" @bind="editing.Date" /></div>
                <div style="flex: 1; min-width: 100px;"><div class="field-label">Category</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Category" /></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 150px;"><div class="field-label">Source</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Source" /></div>
                <div style="flex: 1; min-width: 150px;"><div class="field-label">Reporter</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Reporter" /></div>
                <div style="flex: 1; min-width: 100px;"><div class="field-label">Casualties</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Casualties" /></div>
            </div>
            <div class="mb-3"><div class="field-label">Body</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="6" @bind="editing.Body"></textarea></div>
            <div class="mb-3"><div class="field-label">Aftermath</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="2" @bind="editing.Aftermath"></textarea></div>
            <div class="mb-3"><div class="field-label">Runner Relevance</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="2" placeholder="Why this event matters to the freelance economy..." @bind="editing.RunnerRelevance"></textarea></div>
        }
            @if (editing != null) { <TagPills Tags="editing.Tags" ActiveTags="selectedTags" OnTagClick="OnTagPillClick" /> }
        else
        {
            <div class="text-center text-muted py-5"><i class="bi bi-newspaper" style="font-size:3rem;"></i><p class="mt-2">Select a news report or create a new one.</p></div>
        }
    </div>
</div>

@code {
    private List<NewsData> items = [];
    private NewsData? editing;
    private string originalHeadline = "", filter = "";
    private List<(string name, int count)> allTags = [];
    private HashSet<string> selectedTags = [];
    private bool isNew, confirmDelete;
    private IEnumerable<NewsData> FilteredItems
    {
        get
        {
            IEnumerable<NewsData> result = items;
            if (!string.IsNullOrWhiteSpace(filter))
                result = result.Where(n => n.Headline.Contains(filter, StringComparison.OrdinalIgnoreCase));
            if (selectedTags.Count > 0)
                result = result.Where(n => selectedTags.All(t => n.Tags.Contains(t)));
            return result;
        }
    }
    protected override void OnInitialized() { Repo.Reload(); items = Repo.GetAll(); RebuildTags(); if (Nav.Uri.Contains("new=true")) AddNew(); }
    private void AddNew() { editing = new NewsData(); isNew = true; confirmDelete = false; }
    private void Edit(NewsData n) { editing = n; originalHeadline = n.Headline; isNew = false; confirmDelete = false; }
    private void SaveEdit() { if (editing == null || string.IsNullOrWhiteSpace(editing.Headline)) return; if (!isNew && originalHeadline != editing.Headline) Repo.Delete(originalHeadline); Repo.Save(editing); editing = null; items = Repo.GetAll(); }
    private void DoDelete() { if (editing != null) { Repo.Delete(editing.Headline); editing = null; items = Repo.GetAll(); confirmDelete = false; } }
    private List<(string name, string json)> GetExportEntries() => items.Select(e => (e.Headline, System.Text.Json.JsonSerializer.Serialize(e))).ToList();
    private void OnTagPillClick(string tag) { if (selectedTags.Contains(tag)) selectedTags.Remove(tag); else selectedTags.Add(tag); StateHasChanged(); }
    private void RebuildTags() { allTags = items.SelectMany(x => x.Tags).GroupBy(t => t).Select(g => (g.Key, g.Count())).OrderBy(t => t.Key).ToList(); }
    private void OnTagsChanged(HashSet<string> tags) { selectedTags = tags; }
}
