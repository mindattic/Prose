@page "/settings/ai"
@attribute [Authorize(Roles = "Contributor,Administrator")]
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Services
@using StreetSamurai.Shared.Services
@inject ActionConfigService ActionCfg
@inject ExpertPersonaService Personas
@inject ToastNotifier Toast
@inject NavigationManager Nav

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="mb-0 text-danger"><i class="bi bi-cpu me-2"></i>AI Panels</h4>
        <a href="/settings" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Settings
        </a>
    </div>

    <p class="text-muted small">
        Per-action voter count + model tier. Writing actions are tier-locked HIGH so settings can't
        accidentally degrade the prose readers actually see; voting / selection actions stay adjustable.
    </p>

    @if (actions == null)
    {
        <div class="text-muted">Loading…</div>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-dark table-sm table-bordered align-middle">
                <thead>
                    <tr>
                        <th style="width: 24%">Action</th>
                        <th style="width: 36%">Description</th>
                        <th style="width: 14%">Voters</th>
                        <th style="width: 16%">Tier</th>
                        <th style="width: 10%"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in actions)
                    {
                        <tr>
                            <td>
                                <div class="text-info fw-semibold">@a.Action</div>
                                <div class="text-muted small">@a.Label</div>
                            </td>
                            <td class="small text-muted">
                                @a.Description
                                @if (a.LockTier)
                                {
                                    <span class="badge bg-warning text-dark ms-1" title="Tier-locked at HIGH or above — settings can't downgrade.">
                                        <i class="bi bi-lock-fill"></i> locked
                                    </span>
                                }
                            </td>
                            <td>
                                <input type="number" min="1" max="500" class="form-control form-control-sm bg-black text-light border-secondary"
                                       @bind="a.VoterCount" />
                            </td>
                            <td>
                                <select class="form-select form-select-sm bg-black text-light border-secondary"
                                        @bind="a.Tier" disabled="@a.LockTier">
                                    <option value="Low">Low (haiku-class)</option>
                                    <option value="Medium">Medium (sonnet-class)</option>
                                    <option value="High">High (opus-class)</option>
                                    <option value="Higher">Higher (long-context / reasoning)</option>
                                    <option value="Highest">Highest (flagship)</option>
                                </select>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-info" @onclick="() => SaveAction(a)">
                                    <i class="bi bi-check-lg" /> Save
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* ── Expert Personas ─────────────────────────────────────── *@
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h5 class="text-info mb-0"><i class="bi bi-people-fill me-2"></i>Expert Personas</h5>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-warning"
                    disabled="@(selectedPersonaIds.Count < 2 || combining)"
                    @onclick="CombineSelected"
                    title="Fuse 2-3 selected personas into a single persona that applies all their lenses at once">
                @if (combining)
                {
                    <span class="spinner-border spinner-border-sm me-1" />
                    <span>Combining…</span>
                }
                else
                {
                    <i class="bi bi-link-45deg me-1" />
                    <span>Combine (@selectedPersonaIds.Count)</span>
                }
            </button>
            <button class="btn btn-sm btn-outline-info"
                    @onclick="OpenGenerateModal"
                    title="Generate a new expert persona for a specific scene type">
                <i class="bi bi-stars me-1" />Generate from scene
            </button>
            <button class="btn btn-sm btn-outline-success" @onclick="AddPersona">
                <i class="bi bi-plus-lg me-1" />New persona
            </button>
        </div>
    </div>

    @if (generateOpen)
    {
        <div class="modal-backdrop fade show" style="z-index:1050;"></div>
        <div class="modal fade show d-block" tabindex="-1" style="z-index:1055;" @onclick="CloseGenerateModal">
            <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content bg-dark text-light border-info">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title text-info"><i class="bi bi-stars me-2"></i>Generate persona from scene</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="CloseGenerateModal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-2">
                            Describe the scene type the existing table doesn't cover well. The LLM
                            will invent a relevant expert persona, persist it, and you'll see it
                            in the list. Keep it short — a paragraph is plenty.
                        </p>
                        <textarea class="form-control bg-black text-light border-secondary"
                                  rows="5" placeholder="A cyber-priest performing last rites in a hospital corridor while two corp medics argue over whether to revive the patient…"
                                  @bind="generateScene"></textarea>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button class="btn btn-sm btn-secondary" @onclick="CloseGenerateModal">Cancel</button>
                        <button class="btn btn-sm btn-info" @onclick="GenerateFromScene"
                                disabled="@(string.IsNullOrWhiteSpace(generateScene) || generating)">
                            @if (generating)
                            {
                                <span class="spinner-border spinner-border-sm me-1" />
                                <span>Generating…</span>
                            }
                            else
                            {
                                <i class="bi bi-stars me-1" />
                                <span>Generate</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    <p class="text-muted small">
        Reusable expert lenses for the beat-writer panel. The selector picks the top-N pertinent
        personas per scene, so growing the table improves coverage rather than slowing the call.
    </p>

    @if (personas == null)
    {
        <div class="text-muted">Loading…</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-sm table-bordered align-middle">
                <thead>
                    <tr>
                        <th style="width: 4%"></th>
                        <th style="width: 16%">Name</th>
                        <th style="width: 48%">Lens</th>
                        <th style="width: 22%">Tags</th>
                        <th style="width: 10%"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in personas)
                    {
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" class="form-check-input"
                                       checked="@selectedPersonaIds.Contains(p.Id)"
                                       @onchange="@(e => ToggleSelection(p.Id, (bool)(e.Value ?? false)))" />
                            </td>
                            <td>
                                <input class="form-control form-control-sm bg-black text-light border-secondary"
                                       @bind="p.Name" />
                                @if (p.Seeded)
                                {
                                    <div class="text-muted small mt-1"><i class="bi bi-bookmark-star me-1" />seeded</div>
                                }
                            </td>
                            <td>
                                <textarea class="form-control form-control-sm bg-black text-light border-secondary"
                                          rows="3" @bind="p.Lens"></textarea>
                            </td>
                            <td>
                                <input class="form-control form-control-sm bg-black text-light border-secondary"
                                       placeholder="comma, separated, tags"
                                       value="@string.Join(", ", p.Tags)"
                                       @onchange="@(e => p.Tags = ParseTags((string?)e.Value))" />
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <button class="btn btn-sm btn-outline-info" @onclick="() => SavePersona(p)" title="Save">
                                        <i class="bi bi-check-lg" />
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePersona(p)" title="Delete">
                                        <i class="bi bi-trash" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<ActionConfig>?  actions;
    private List<ExpertPersona>? personas;

    // Combine: tracks which personas the user has checked. Combine fuses
    // exactly 2-3 — the button is disabled below 2 and ignores past 3.
    private HashSet<string> selectedPersonaIds = new();
    private bool combining;

    // Generate-from-scene modal state.
    private bool generateOpen;
    private string generateScene = "";
    private bool generating;

    protected override void OnInitialized()
    {
        Reload();
    }

    private void Reload()
    {
        try
        {
            actions  = ActionCfg.ListAll().OrderBy(a => a.Action).ToList();
            personas = Personas.ListAll().OrderBy(p => p.Name).ToList();
        }
        catch (Exception ex)
        {
            Toast.Error("AI-PANELS-LOAD", $"Couldn't load AI panel config: {ex.Message}");
        }
    }

    private void SaveAction(ActionConfig a)
    {
        try
        {
            ActionCfg.Save(a);
            Toast.Success("AI-PANELS-SAVE", $"Saved {a.Action}: {a.VoterCount} voters at {a.Tier} tier.");
        }
        catch (Exception ex)
        {
            Toast.Error("AI-PANELS-SAVE-FAIL", $"Couldn't save {a.Action}: {ex.Message}");
        }
    }

    private void AddPersona()
    {
        var p = new ExpertPersona { Name = "New Expert", Lens = "You're an expert in …", Tags = new() };
        try
        {
            Personas.Save(p);
            Toast.Success("PERSONA-ADD", $"Added {p.Name}.");
            Reload();
        }
        catch (Exception ex)
        {
            Toast.Error("PERSONA-ADD-FAIL", $"Couldn't add persona: {ex.Message}");
        }
    }

    private void SavePersona(ExpertPersona p)
    {
        try
        {
            Personas.Save(p);
            Toast.Success("PERSONA-SAVE", $"Saved {p.Name}.");
        }
        catch (Exception ex)
        {
            Toast.Error("PERSONA-SAVE-FAIL", $"Couldn't save {p.Name}: {ex.Message}");
        }
    }

    private void DeletePersona(ExpertPersona p)
    {
        try
        {
            Personas.Delete(p.Id);
            Toast.Info("PERSONA-DELETE", $"Deleted {p.Name}.");
            Reload();
        }
        catch (Exception ex)
        {
            Toast.Error("PERSONA-DELETE-FAIL", $"Couldn't delete {p.Name}: {ex.Message}");
        }
    }

    private static List<string> ParseTags(string? raw) =>
        string.IsNullOrWhiteSpace(raw)
            ? new List<string>()
            : raw.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();

    private void ToggleSelection(string id, bool selected)
    {
        if (selected) selectedPersonaIds.Add(id);
        else selectedPersonaIds.Remove(id);
    }

    private void CombineSelected()
    {
        if (selectedPersonaIds.Count < 2 || combining) return;
        combining = true;
        try
        {
            var ids = selectedPersonaIds.Take(3).ToList(); // cap at 3 — Combine docs say 2-3
            var fused = Personas.Combine(ids);
            Toast.Success("PERSONA-COMBINE", $"Fused {ids.Count} personas into '{fused.Name}'.");
            selectedPersonaIds.Clear();
            Reload();
        }
        catch (Exception ex)
        {
            Toast.Error("PERSONA-COMBINE-FAIL", $"Couldn't combine personas: {ex.Message}");
        }
        finally
        {
            combining = false;
        }
    }

    private void OpenGenerateModal()
    {
        generateScene = "";
        generateOpen = true;
    }

    private void CloseGenerateModal()
    {
        generateOpen = false;
        generating = false;
    }

    private async Task GenerateFromScene()
    {
        if (string.IsNullOrWhiteSpace(generateScene) || generating) return;
        generating = true;
        StateHasChanged();
        try
        {
            var p = await Personas.GenerateForSceneAsync(generateScene);
            if (p == null)
            {
                Toast.Warning("PERSONA-GEN-EMPTY", "LLM returned nothing usable. Try a richer scene description or check API keys.");
                return;
            }
            Toast.Success("PERSONA-GEN-OK", $"Generated persona: {p.Name}");
            generateOpen = false;
            Reload();
        }
        catch (Exception ex)
        {
            Toast.Error("PERSONA-GEN-FAIL", $"Couldn't generate persona: {ex.Message}");
        }
        finally
        {
            generating = false;
            StateHasChanged();
        }
    }
}
