@page "/publish/{BookId}"
@attribute [Authorize(Roles = "Contributor,Administrator")]
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@using StreetSamurai.Core.Services
@using StreetSamurai.Shared.Services
@inject IBookRepository Books
@inject BookExportService ExportSvc
@inject ToastNotifier Toast
@inject NavigationManager Nav

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="small text-muted mb-1">
                <a href="/books" class="text-muted text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Bookshelf
                </a>
            </div>
            <h4 class="text-danger mb-0"><i class="bi bi-cloud-download me-2"></i>Publish</h4>
            @if (book != null)
            {
                <div class="text-muted small">@book.Title</div>
            }
        </div>
        @if (book != null)
        {
            <div class="d-flex gap-2 align-items-center">
                <a href="@($"/write/{book.Id}")" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-pencil-square me-1"></i>Write
                </a>
                <a href="@($"/books/{book.Id}/motifs")" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-tags me-1"></i>Motifs
                </a>
                <a href="@($"/publish/{book.Id}/audio")" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-mic me-1"></i>Recording
                </a>
            </div>
        }
    </div>

    @if (book == null)
    {
        <div class="alert alert-danger">Book not found. <a href="/books">Back to bookshelf</a></div>
    }
    else
    {
        <p class="text-muted">Pick a format. Files land in <code>engine/exports/</code>.</p>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card bg-dark border-secondary h-100">
                    <div class="card-body">
                        <h5 class="text-info"><i class="bi bi-book me-2"></i>EPUB</h5>
                        <p class="text-muted small">For Calibre → Kindle / AZW3 / MOBI conversion. Universal e-reader format.</p>
                        <button class="btn btn-outline-info" @onclick='() => Export("epub")' disabled="@working">
                            <i class="bi bi-download me-1"></i>Build EPUB
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-dark border-secondary h-100">
                    <div class="card-body">
                        <h5 class="text-info"><i class="bi bi-filetype-html me-2"></i>HTML</h5>
                        <p class="text-muted small">Standalone single-file HTML. Opens in any browser, prints to PDF cleanly.</p>
                        <button class="btn btn-outline-info" @onclick='() => Export("html")' disabled="@working">
                            <i class="bi bi-download me-1"></i>Build HTML
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-dark border-secondary h-100">
                    <div class="card-body">
                        <h5 class="text-info"><i class="bi bi-markdown me-2"></i>Markdown</h5>
                        <p class="text-muted small">Single Markdown file — useful for editorial review and plain-text pipelines.</p>
                        <button class="btn btn-outline-info" @onclick='() => Export("md")' disabled="@working">
                            <i class="bi bi-download me-1"></i>Build Markdown
                        </button>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(lastResult))
        {
            <div class="alert alert-success mt-3 small"><i class="bi bi-check-circle me-1"></i>@lastResult</div>
        }
    }
</div>

@code {
    [Parameter] public string BookId { get; set; } = "";

    private Book? book;
    private bool working;
    private string lastResult = "";

    protected override void OnInitialized()
    {
        try { book = Books.LoadBook(BookId); }
        catch (Exception ex) { Toast.Error("PUBLISH-LOAD", $"Couldn't load book: {ex.Message}"); }
    }

    private async Task Export(string format)
    {
        if (book == null || working) return;
        working = true;
        lastResult = "";
        StateHasChanged();
        try
        {
            string path = format switch
            {
                "html" => ExportSvc.ExportHtml(book.Id),
                "md"   => ExportSvc.ExportMarkdown(book.Id),
                _      => ExportSvc.ExportEpub(book.Id),
            };
            lastResult = $"Exported: {path}";
            Toast.Success("PUBLISH-OK", $"Built {format.ToUpperInvariant()}: {path}");
        }
        catch (Exception ex)
        {
            Toast.Error("PUBLISH-FAIL", $"{format.ToUpperInvariant()} export failed: {ex.Message}");
        }
        finally
        {
            working = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
