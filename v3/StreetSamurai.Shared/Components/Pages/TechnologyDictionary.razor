@page "/technology"
@inject TechnologyRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject WorldGraphService Graph

<div class="dict-layout">
    <div class="dict-list bg-dark border-end border-secondary">
        @foreach (var t in _items)
        {
            <div class="list-item text-light @(_editing?.Name == t.Name ? "active" : "")" @onclick="() => Edit(t)">
                <div class="fw-bold small">@t.Name</div>
                <div class="text-muted" style="font-size: 0.7rem;">@t.Subcategory</div>
            </div>
        }
        <div class="p-2">
            <button class="btn btn-sm btn-outline-danger w-100" @onclick="AddNew"><i class="bi bi-plus-lg"></i> New Technology</button>
        </div>
    </div>

    <div class="dict-editor">
        @if (_editing != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-danger mb-0">@(_isNew ? "New Technology" : _editing.Name)</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i> Save</button>
                    @if (!_isNew && !_confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-trash3"></i></button> }
                    @if (_confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete">Confirm</button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false">No</button> }
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-4"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Name" /></div>
                <div class="col-4"><div class="field-label">Subcategory</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Subcategory" /></div>
                <div class="col-4"><div class="field-label">Tier Availability</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.TierAvailability" /></div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-6"><div class="field-label">Developers (comma-sep)</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_devInput" /></div>
                <div class="col-6"><div class="field-label">Base Technologies (comma-sep)</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_baseTechInput" /></div>
            </div>

            <div class="mb-3"><div class="field-label">Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.Description"></textarea></div>
            <div class="mb-3"><div class="field-label">Social Impact</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.SocialImpact"></textarea></div>
        }
        else { <div class="text-muted d-flex align-items-center justify-content-center h-100">Select a technology or create a new one</div> }
    </div>
</div>

@code {
    private List<TechnologyData> _items = [];
    private TechnologyData? _editing;
    private bool _isNew, _confirmDelete;
    private string _originalName = "";
    private string _devInput = "", _baseTechInput = "";
    protected override void OnInitialized() { Repo.Reload(); _items = Repo.GetAll(); if (Nav.Uri.Contains("new=true")) AddNew(); }
    private void AddNew() { _editing = new TechnologyData(); _isNew = true; _confirmDelete = false; _devInput = ""; _baseTechInput = ""; }
    private void Edit(TechnologyData t) { _editing = t; _originalName = t.Name; _isNew = false; _confirmDelete = false; _devInput = string.Join(", ", t.Developers); _baseTechInput = string.Join(", ", t.BaseTechnologies); }
    private void SaveEdit()
    {
        if (_editing == null || string.IsNullOrWhiteSpace(_editing.Name)) return;
        _editing.Developers = _devInput.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        _editing.BaseTechnologies = _baseTechInput.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        if (!_isNew && _originalName != _editing.Name) Repo.Delete(_originalName);
        Repo.Save(_editing); _editing = null; _items = Repo.GetAll();
    }
    private void DoDelete() { if (_editing == null) return; Graph.RemoveNode(_editing.Name); Repo.Delete(_editing.Name); _editing = null; _confirmDelete = false; _items = Repo.GetAll(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { await JS.InvokeVoidAsync("writeInterop.autoResizeAll"); }
}
