@page "/technology"
@inject TechnologyRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject WorldGraphService Graph

<div class="dict-layout">
    <div class="dict-list">
        <div class="card bg-dark text-light border-secondary mb-2 card-body">
            <FilterBar AllTags="allTags" @bind-Filter="filter" SelectedTags="selectedTags" SelectedTagsChanged="OnTagsChanged" />

        </div>
        <div class="dict-items">
            @foreach (var t in SortedItems)
            {
                <div class="list-item text-light @(editing?.Name == t.Name ? "active" : "")" @onclick="() => Edit(t)">
                    <div class="fw-bold small">@t.Name</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@t.Subcategory</div>
                </div>
            }
        </div>
    </div>

    <div class="dict-editor">
        @if (editing != null)
        {
            <EditViewToggle RepoName="technology" Title="@(isNew ? "New Technology" : editing.Name)" Json="@System.Text.Json.JsonSerializer.Serialize(editing)" HideToggle="@_confirmDelete">
                <HeaderButtons>
                    @if (!_confirmDelete)
                    {
                        <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i><div class="btn-lbl"> Save</div></button>
                        @if (!isNew) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-archive"></i></button> }
                    }
                    else
                    {
                        <span class="small text-muted me-1">Archive Entry?</span>
                        <button class="btn btn-sm btn-danger" @onclick="DoDelete"><div class="btn-lbl">Yes</div></button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false"><div class="btn-lbl">No</div></button>
                    }
                </HeaderButtons>
                <ChildContent>
                    <div class="row g-3 mb-3">
                        <div class="col-4"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Name" /></div>
                        <div class="col-4"><div class="field-label">Subcategory</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Subcategory" /></div>
                        <div class="col-4"><div class="field-label">Tier Availability</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.TierAvailability" /></div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6"><div class="field-label">Developers (comma-sep)</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="devInput" /></div>
                        <div class="col-6"><div class="field-label">Base Technologies (comma-sep)</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_baseTechInput" /></div>
                    </div>
                    <div class="mb-3"><div class="field-label">Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.Description"></textarea></div>
                    <div class="mb-3"><div class="field-label">Social Impact</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.SocialImpact"></textarea></div>
                </ChildContent>
            </EditViewToggle>
        }
        else { <div class="text-muted d-flex align-items-center justify-content-center h-100">Select a technology or create a new one</div> }
    </div>
</div>

@code {
    private List<TechnologyData> items = [];
    private TechnologyData? editing;
    private bool isNew, _confirmDelete;
    private string originalName = "";
    private string devInput = "", _baseTechInput = "";
    private string filter = "";
    private List<(string name, int count)> allTags = [];
    private HashSet<string> selectedTags = [];

    private List<TechnologyData> FilteredItems
    {
        get
        {
            IEnumerable<TechnologyData> result = items;
            if (!string.IsNullOrWhiteSpace(filter))
                result = result.Where(t => t.Name.Contains(filter, StringComparison.OrdinalIgnoreCase));
            if (selectedTags.Count > 0)
                result = result.Where(t => selectedTags.All(tag => t.Tags.Contains(tag)));
            return result.ToList();
        }
    }
    private List<TechnologyData> SortedItems => FilteredItems.OrderBy(x => x.Name).ToList();

    protected override void OnInitialized() { Repo.Reload(); items = Repo.GetAll(); RebuildTags(); if (Nav.Uri.Contains("new=true")) AddNew(); else { var qid = Nav.Uri.Contains("id=") ? Uri.UnescapeDataString(Nav.Uri.Split(new[]{"id="}, StringSplitOptions.None).Last().Split(new[]{"&"}, StringSplitOptions.None)[0]) : ""; if (!string.IsNullOrEmpty(qid)) { var t = items.FirstOrDefault(e => e.Id == qid); if (t != null) Edit(t); } } }
    private void AddNew() { editing = new TechnologyData(); isNew = true; _confirmDelete = false; devInput = ""; _baseTechInput = ""; }
    private void Edit(TechnologyData t) { _ = JS.InvokeVoidAsync("localStorage.setItem", "ss_sel_technology", t.Id); editing = t; originalName = t.Name; isNew = false; _confirmDelete = false; devInput = string.Join(", ", t.Developers); _baseTechInput = string.Join(", ", t.BaseTechnologies); if (!Nav.Uri.Contains("id=" + t.Id)) Nav.NavigateTo(Nav.Uri.Split('?')[0] + "?id=" + t.Id, forceLoad: false); }
    private void SaveEdit()
    {
        if (editing == null || string.IsNullOrWhiteSpace(editing.Name)) return;
        editing.Developers = devInput.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        editing.BaseTechnologies = _baseTechInput.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        if (!isNew && originalName != editing.Name) Repo.Delete(originalName);
        Repo.Save(editing); editing = null; items = Repo.GetAll();
    }
    private void DoDelete() { if (editing == null) return; Graph.RemoveNode(editing.Name); Repo.Delete(editing.Name); editing = null; _confirmDelete = false; items = Repo.GetAll(); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("writeInterop.autoResizeAll");
        if (firstRender && editing == null && items.Count > 0 && !Nav.Uri.Contains("new=true") && !Nav.Uri.Contains("id="))
        {
            var lastId = "";
            try { lastId = await JS.InvokeAsync<string>("localStorage.getItem", "ss_sel_technology") ?? ""; } catch { }
            var target = (!string.IsNullOrEmpty(lastId) ? items.FirstOrDefault(x => x.Id == lastId) : null) ?? items.First();
            if (target != null) { Edit(target); StateHasChanged(); }
        }
    }
    private List<(string name, string json)> GetExportEntries() => items.Select(e => (e.Name, System.Text.Json.JsonSerializer.Serialize(e))).ToList();
    private void RebuildTags() { allTags = items.SelectMany(x => x.Tags).GroupBy(t => t).Select(g => (g.Key, g.Count())).OrderBy(t => t.Key).ToList(); }
    private void OnTagsChanged(HashSet<string> tags) { selectedTags = tags; }
}
