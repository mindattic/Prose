@page "/map"
@inject SettingsService Settings
@inject IJSRuntime JS
@inject DistrictRepository PlaceRepo
@inject WorldbuildingDocRepository DocRepo

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-danger mb-0">Map — GLMZ</h4>
    <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-sm @(layerStates["districts"] ? "btn-secondary" : "btn-outline-secondary")" @onclick="@(() => ToggleLayer("districts"))">
            <i class="bi bi-layers"></i><div class="btn-lbl"> Districts</div>
        </button>
        <button class="btn btn-sm @(layerStates["pulse"] ? "btn-secondary" : "btn-outline-secondary")"
                style="@(layerStates["pulse"] ? "border-color:#F0A830;color:#F0A830" : "")"
                @onclick="@(() => ToggleLayer("pulse"))">
            <div class="btn-lbl">Pulse</div>
        </button>
        <button class="btn btn-sm @(layerStates["aeroplexes"] ? "btn-secondary" : "btn-outline-secondary")"
                style="@(layerStates["aeroplexes"] ? "border-color:#8CA0FF;color:#8CA0FF" : "")"
                @onclick="@(() => ToggleLayer("aeroplexes"))">
            <div class="btn-lbl">Aeroplexes</div>
        </button>
        <button class="btn btn-sm @(layerStates["underwater"] ? "btn-secondary" : "btn-outline-secondary")"
                style="@(layerStates["underwater"] ? "border-color:#1888D8;color:#1888D8" : "")"
                @onclick="@(() => ToggleLayer("underwater"))">
            <div class="btn-lbl">Underwater</div>
        </button>
        <button class="btn btn-sm @(layerStates["wave"] ? "btn-secondary" : "btn-outline-secondary")"
                style="@(layerStates["wave"] ? "border-color:#8Ab8D0;color:#8Ab8D0" : "")"
                @onclick="@(() => ToggleLayer("wave"))">
            <div class="btn-lbl">Wave</div>
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="ZoomToChicago" title="Zoom to Chicago">
            <i class="bi bi-geo-alt"></i>
        </button>
        @foreach (var cat in categories)
        {
            var key = cat.key;
            <button class="btn btn-sm @(layerStates.GetValueOrDefault(key) ? "btn-secondary" : "btn-outline-secondary")"
                    style="@(layerStates.GetValueOrDefault(key) ? $"border-color:{cat.color};color:{cat.color}" : "")"
                    @onclick="() => ToggleLayer(key)">
                <div class="btn-lbl">@cat.label</div> <span class="badge bg-dark" style="font-size:0.65rem;">@cat.count</span>
            </button>
        }
        <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleTheme">
            <i class="bi @(darkMode ? "bi-sun" : "bi-moon")"></i>
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Settings.GoogleMapsApiKey))
{
    <div id="meridian-map" style="width: 100%; height: calc(100vh - 130px); border-radius: 6px; border: 1px solid #30363d;"></div>
}
else
{
    <div class="d-flex align-items-center justify-content-center text-muted" style="height: calc(100vh - 130px); border: 1px solid #30363d; border-radius: 6px;">
        <div class="text-center">
            <i class="bi bi-map" style="font-size: 3rem;"></i>
            <p class="mt-2">Add a Google Maps API key in Settings to enable the map.</p>
        </div>
    </div>
}

@code {
    private bool mapLoaded;
    private bool darkMode => Settings.MapMode == "dark";
    private Dictionary<string, bool> layerStates = new()
    {
        ["districts"] = true,
        ["pulse"] = true,
        ["aeroplexes"] = true,
        ["underwater"] = true,
        ["wave"] = true,
        ["colony"] = true,
        ["corporate"] = true,
        ["medical"] = true,
        ["nightlife"] = true,
        ["market"] = true,
        ["anomaly"] = true,
        ["industrial"] = true,
        ["community"] = true,
        ["security"] = true,
        ["underworld"] = true,
        ["behemoth"] = true,
        ["food"] = true,
        ["default"] = true
    };

    private List<(string key, string label, string color, int count)> categories = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrWhiteSpace(Settings.GoogleMapsApiKey) && !mapLoaded)
        {
            mapLoaded = true;
            await JS.InvokeVoidAsync("meridianMap.init", "meridian-map", Settings.GoogleMapsApiKey);
            if (Settings.MapMode == "light")
                await JS.InvokeVoidAsync("meridianMap.setTheme", "light");
            await Task.Delay(500);
            await LoadPlaces();
        }
    }

    private async Task LoadPlaces()
    {
        var places = PlaceRepo.GetAll()
            .Where(p => p.Coordinates.Lat != 0 && p.Coordinates.Lng != 0)
            .Select(p => new {
                id = p.Id,
                name = p.Name,
                lat = p.Coordinates.Lat,
                lng = p.Coordinates.Lng,
                cat = CategorizePlace(p.Tags),
                desc = TruncateDesc(p.Description)
            })
            .ToList();

        // Count per category for badges
        var counts = places.GroupBy(p => p.cat).ToDictionary(g => g.Key, g => g.Count());
        categories = new List<(string, string, string, int)>
        {
            ("colony", "Colonies", "#3fb950", counts.GetValueOrDefault("colony")),
            ("behemoth", "Behemoths", "#f0883e", counts.GetValueOrDefault("behemoth")),
            ("anomaly", "Anomalies", "#dc3545", counts.GetValueOrDefault("anomaly")),
            ("corporate", "Corporate", "#e6edf3", counts.GetValueOrDefault("corporate")),
            ("nightlife", "Nightlife", "#d2a8ff", counts.GetValueOrDefault("nightlife")),
            ("food", "Food", "#f0883e", counts.GetValueOrDefault("food")),
            ("market", "Markets", "#f0883e", counts.GetValueOrDefault("market")),
            ("medical", "Medical", "#f778ba", counts.GetValueOrDefault("medical")),
            ("industrial", "Industrial", "#8b949e", counts.GetValueOrDefault("industrial")),
            ("community", "Community", "#3fb950", counts.GetValueOrDefault("community")),
            ("security", "Security", "#58a6ff", counts.GetValueOrDefault("security")),
            ("underworld", "Underworld", "#6e40c9", counts.GetValueOrDefault("underworld")),
            ("default", "Other", "#58a6ff", counts.GetValueOrDefault("default"))
        };
        categories = categories.Where(c => c.Item4 > 0).ToList();

        await JS.InvokeVoidAsync("meridianMap.loadPlaces", places);

        // Load overlay polygons from documents that have a map_polygon field
        var polygons = DocRepo.GetAll()
            .Where(d => d.ExtraData != null && d.ExtraData.ContainsKey("map_polygon"))
            .Select(d => d.ExtraData!["map_polygon"])
            .ToList();

        if (polygons.Count > 0)
            await JS.InvokeVoidAsync("meridianMap.loadOverlayPolygons", polygons);

        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleLayer(string layer)
    {
        layerStates[layer] = !layerStates.GetValueOrDefault(layer, true);
        switch (layer)
        {
            case "districts":   await JS.InvokeVoidAsync("meridianMap.toggleDistricts"); break;
            case "pulse":       await JS.InvokeVoidAsync("meridianMap.togglePulse"); break;
            case "aeroplexes":  await JS.InvokeVoidAsync("meridianMap.toggleAeroplexes"); break;
            case "underwater":  await JS.InvokeVoidAsync("meridianMap.toggleUnderwaterFeatures"); break;
            case "wave":        await JS.InvokeVoidAsync("meridianMap.toggleWave"); break;
            default:            await JS.InvokeVoidAsync("meridianMap.toggleCategory", layer); break;
        }
    }

    private async Task ZoomToChicago()
    {
        await JS.InvokeVoidAsync("meridianMap.zoomToChicago");
    }

    private async Task ToggleTheme()
    {
        Settings.MapMode = darkMode ? "light" : "dark";
        await JS.InvokeVoidAsync("meridianMap.setTheme", Settings.MapMode);
    }

    private static string CategorizePlace(List<string> tags)
    {
        if (tags == null) return "default";
        var t = new HashSet<string>(tags.Select(x => x.ToLowerInvariant()));
        if (t.Contains("floating_colony") || t.Contains("maritime") || t.Contains("freeport")) return "colony";
        if (t.Contains("behemoth") || t.Contains("iowan_behemoth") || t.Contains("sighting")) return "behemoth";
        if (t.Contains("anomaly") || t.Contains("inexplicable") || t.Contains("new_weird") || t.Contains("lost_block") || t.Contains("spatial_anomaly")) return "anomaly";
        if (t.Contains("corporate") || t.Contains("corponation")) return "corporate";
        if (t.Contains("medical") || t.Contains("clinic") || t.Contains("hospital")) return "medical";
        if (t.Contains("bar") || t.Contains("nightlife") || t.Contains("club")) return "nightlife";
        if (t.Contains("restaurant") || t.Contains("cafe") || t.Contains("pub") || t.Contains("street_vendor")) return "food";
        if (t.Contains("market") || t.Contains("shop")) return "market";
        if (t.Contains("industrial") || t.Contains("factory") || t.Contains("warehouse")) return "industrial";
        if (t.Contains("shelter") || t.Contains("refugee") || t.Contains("community")) return "community";
        if (t.Contains("surveillance") || t.Contains("security") || t.Contains("corpsec")) return "security";
        if (t.Contains("underworld") || t.Contains("tunnel") || t.Contains("underground")) return "underworld";
        return "default";
    }

    private static string TruncateDesc(string desc)
    {
        if (string.IsNullOrWhiteSpace(desc)) return "";
        var dot = desc.IndexOf(". ");
        if (dot > 0 && dot < 200) return desc[..(dot + 1)];
        return desc.Length <= 200 ? desc : desc[..200] + "...";
    }
}
