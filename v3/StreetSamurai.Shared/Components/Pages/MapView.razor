@page "/map"
@inject SettingsService Settings
@inject IJSRuntime JS

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-danger mb-0">Map — Meridian 88</h4>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleDistricts">
            <i class="bi bi-layers"></i> Districts
        </button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Settings.GoogleMapsApiKey))
{
    <div id="meridian-map" style="width: 100%; height: calc(100vh - 120px); border-radius: 6px; border: 1px solid #30363d;"></div>
}
else
{
    <div class="d-flex align-items-center justify-content-center text-muted" style="height: calc(100vh - 120px); border: 1px solid #30363d; border-radius: 6px;">
        <div class="text-center">
            <i class="bi bi-map" style="font-size: 3rem;"></i>
            <p class="mt-2">Add a Google Maps API key in Settings to enable the map.</p>
        </div>
    </div>
}

@code {
    private bool mapLoaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrWhiteSpace(Settings.GoogleMapsApiKey) && !mapLoaded)
        {
            mapLoaded = true;
            await JS.InvokeVoidAsync("meridianMap.init", "meridian-map", Settings.GoogleMapsApiKey);
        }
    }

    private async Task ToggleDistricts()
    {
        await JS.InvokeVoidAsync("meridianMap.toggleDistricts");
    }
}
