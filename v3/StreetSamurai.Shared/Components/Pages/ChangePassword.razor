@page "/change-password"
@attribute [Authorize]
@inject AuthService Auth
@inject UserRepository UserRepo
@inject IWriteAccessProvider Access
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider

<div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="card bg-dark text-light border-secondary" style="width: 400px;">
        <div class="card-header text-danger fw-bold">
            <i class="bi bi-shield-exclamation"></i> Change Password Required
        </div>
        <div class="card-body">
            @if (Access.CurrentUserRole == "Anonymous")
            {
                <p class="text-muted">You must be logged in to change your password.</p>
                <a href="/login" class="btn btn-outline-danger btn-sm">Login</a>
            }
            else
            {
                <p class="text-muted small mb-3">Your password must be changed before you can continue.</p>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger py-2 small">@errorMessage</div>
                }
                @if (success)
                {
                    <div class="alert alert-success py-2 small">Password changed. Redirecting...</div>
                }

                @if (!mustChangePassword)
                {
                    <div class="mb-3">
                        <label class="form-label small text-muted">Current Password</label>
                        <input type="password" class="form-control form-control-sm bg-dark text-light border-secondary"
                               @bind="currentPassword" />
                    </div>
                }
                <div class="mb-3">
                    <label class="form-label small text-muted">New Password (min @AuthService.MinPasswordLength characters)</label>
                    <input type="password" class="form-control form-control-sm bg-dark text-light border-secondary"
                           @bind="newPassword" />
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Confirm New Password</label>
                    <input type="password" class="form-control form-control-sm bg-dark text-light border-secondary"
                           @bind="confirmPassword" />
                </div>
                <button class="btn btn-danger btn-sm w-100" @onclick="Submit" disabled="@success">Change Password</button>
            }
        </div>
    </div>
</div>

@code {
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string errorMessage = "";
    private bool success;
    private bool mustChangePassword;

    protected override async Task OnInitializedAsync()
    {
        // Check if the current user has MustChangePassword set
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst("UserId")?.Value;
        if (!string.IsNullOrEmpty(userId))
        {
            var user = UserRepo.GetById(userId);
            mustChangePassword = user?.MustChangePassword ?? false;
        }
    }

    private async Task Submit()
    {
        errorMessage = "";
        if (newPassword != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        try
        {
            // Resolve user by the authenticated UserId claim — not by display name,
            // which is ambiguous and could allow changing another user's password.
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = authState.User.FindFirst("UserId")?.Value;
            if (string.IsNullOrEmpty(userId))
            {
                errorMessage = "Session expired. Please log in again.";
                return;
            }

            var user = UserRepo.GetById(userId);
            if (user == null) { errorMessage = "User not found."; return; }

            // MustChangePassword users are forced here after login — they just proved
            // their identity with the current password. Everyone else must verify.
            if (mustChangePassword)
                Auth.ChangePassword(user.Id, newPassword);
            else
                Auth.ChangePasswordWithVerification(user.Id, currentPassword, newPassword);

            success = true;
            await Task.Delay(1500);
            Nav.NavigateTo("/", forceLoad: true); // Force reload to pick up new cookie
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
    }
}
