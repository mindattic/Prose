@page "/factions"
@inject CanonService Canon
@inject WorldGraphService Graph

@if (_selectedYaml != null)
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection">Back</button>
        <h4 class="text-danger mb-0">@_selectedFaction?.Name</h4>
        <a href="graph" class="btn btn-sm btn-outline-info ms-auto" title="View relationships in World Graph"><i class="bi bi-diagram-3"></i> Graph</a>
    </div>

    <div class="row g-3">
        <div class="col-md-5">
            <div class="card bg-dark text-light border-secondary">
                <div class="card-header text-muted">Profile</div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(_selectedFaction?.Description))
                    {
                        <p class="small">@_selectedFaction.Description</p>
                    }
                    @if (!string.IsNullOrEmpty(_selectedFaction?.Ideology))
                    {
                        <div class="mb-2"><span class="text-muted">Ideology:</span> @_selectedFaction.Ideology</div>
                    }
                    @if (!string.IsNullOrEmpty(_selectedFaction?.Territory))
                    {
                        <div class="mb-2"><span class="text-muted">Territory:</span> @_selectedFaction.Territory</div>
                    }
                    @if (!string.IsNullOrEmpty(_selectedFaction?.Leadership))
                    {
                        <div class="mb-2"><span class="text-muted">Leadership:</span> @_selectedFaction.Leadership</div>
                    }
                </div>
            </div>

            @if (_relationships.Any())
            {
                <div class="card bg-dark text-light border-secondary mt-3">
                    <div class="card-header text-muted">Relationships</div>
                    <div class="card-body">
                        @foreach (var edge in _relationships)
                        {
                            var other = edge.Source == _nodeId ? edge.Target : edge.Source;
                            var otherNode = Graph.GetNode(other);
                            <div class="border-bottom border-secondary py-1 small">
                                <span class="text-info">@(otherNode?.Name ?? other)</span>
                                <span class="text-muted ms-1">(@edge.RelationType)</span>
                                @if (!string.IsNullOrEmpty(edge.Description))
                                {
                                    <div class="text-muted ms-2">@Truncate(edge.Description, 120)</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="col-md-7">
            <div class="card bg-dark text-light border-secondary">
                <div class="card-header text-muted">Raw YAML</div>
                <div class="card-body" style="max-height: 70vh; overflow-y: auto;">
                    <pre style="white-space: pre-wrap; font-size: 0.8rem; color: #ddd;">@_selectedYaml</pre>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <h4 class="text-danger mb-1">Factions (@_factions.Count)</h4>
    <p class="text-muted mb-3">Underground movements, resistance cells, and political machines operating outside corporate sovereignty.</p>

    <div class="row g-3">
        @foreach (var f in _factions)
        {
            <div class="col-md-6">
                <div class="card bg-dark text-light border-secondary h-100" style="cursor: pointer;"
                     @onclick="() => Select(f)">
                    <div class="card-body">
                        <h6 class="text-info">@f.Name</h6>
                        @if (!string.IsNullOrEmpty(f.Description))
                        {
                            <p class="small text-muted mb-0">@Truncate(f.Description, 200)</p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Faction> _factions = [];
    private Faction? _selectedFaction;
    private string? _selectedYaml;
    private string _nodeId = "";
    private List<WorldEdge> _relationships = [];

    protected override void OnInitialized()
    {
        _factions = Canon.ListFactions();
        Graph.EnsureLoaded();
    }

    private void Select(Faction f)
    {
        _selectedFaction = f;
        _selectedYaml = Canon.ReadFactionJson(f.Name);
        _nodeId = WorldGraphService.Slugify(f.Name);
        _relationships = Graph.GetAllEdges(_nodeId);
    }

    private void ClearSelection()
    {
        _selectedFaction = null;
        _selectedYaml = null;
        _relationships = [];
    }

    private static string Truncate(string s, int max) =>
        s.Length > max ? s[..(max - 3)] + "..." : s;
}
