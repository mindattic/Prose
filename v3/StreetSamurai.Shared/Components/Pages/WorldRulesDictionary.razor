@page "/rules"
@inject StoryBibleRepository StoryBibleRepo
@inject LiteraryRulesRepository LitRulesRepo
@inject MotifRepository MotifRepo

<h4 class="text-danger mb-3">World Rules</h4>

@* ── Story Bible ──────────────────────────────────────── *@
<div class="card bg-dark text-light border-secondary mb-3">
    <div class="card-header d-flex justify-content-between align-items-center border-secondary">
        <span class="text-danger fw-bold">Story Bible</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => editBible = !editBible">
            <i class="bi @(editBible ? "bi-x" : "bi-pencil")"></i>
        </button>
    </div>
    <div class="card-body">
        @if (editBible)
        {
            <div class="row g-2 mb-2">
                <div class="col-md-4"><label class="form-label text-muted small">Title</label><input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="bible.Title" /></div>
                <div class="col-md-4"><label class="form-label text-muted small">Genre</label><input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="bible.Genre" /></div>
                <div class="col-md-4"><label class="form-label text-muted small">Tone</label><input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="bible.Tone" /></div>
            </div>
            <div class="row g-2 mb-2">
                <div class="col-md-6"><label class="form-label text-muted small">Core Theme</label><input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="bible.CoreTheme" /></div>
                <div class="col-md-6"><label class="form-label text-muted small">Core Hook</label><input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="bible.CoreHook" /></div>
            </div>
            <div class="mb-2"><label class="form-label text-muted small">Setting</label><textarea class="form-control form-control-sm bg-dark text-light border-secondary" rows="2" @bind="bible.Setting"></textarea></div>
            <div class="mb-2"><label class="form-label text-muted small">Protagonist</label><input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="bible.Protagonist" /></div>
            <div class="mb-2"><label class="form-label text-muted small">Arc</label><textarea class="form-control form-control-sm bg-dark text-light border-secondary" rows="2" @bind="bible.Arc"></textarea></div>
            <button class="btn btn-sm btn-success" @onclick="SaveBible"><i class="bi bi-floppy"></i> Save</button>
        }
        else
        {
            <div class="small">
                @if (bible.Title.Length > 0) { <div><strong>Title:</strong> @bible.Title</div> }
                @if (bible.Genre.Length > 0) { <div><strong>Genre:</strong> @bible.Genre</div> }
                @if (bible.Tone.Length > 0) { <div><strong>Tone:</strong> @bible.Tone</div> }
                @if (bible.CoreTheme.Length > 0) { <div><strong>Core Theme:</strong> @bible.CoreTheme</div> }
                @if (bible.CoreHook.Length > 0) { <div><strong>Core Hook:</strong> @bible.CoreHook</div> }
                @if (bible.Setting.Length > 0) { <div><strong>Setting:</strong> @bible.Setting</div> }
                @if (bible.Protagonist.Length > 0) { <div><strong>Protagonist:</strong> @bible.Protagonist</div> }
                @if (bible.Arc.Length > 0) { <div><strong>Arc:</strong> @bible.Arc</div> }
            </div>
        }
    </div>
</div>

@* ── Literary Rules ───────────────────────────────────── *@
<div class="card bg-dark text-light border-secondary mb-3">
    <div class="card-header d-flex justify-content-between align-items-center border-secondary">
        <span class="text-danger fw-bold">Literary Rules</span>
        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _editRules = !_editRules">
            <i class="bi @(_editRules ? "bi-x" : "bi-pencil")"></i>
        </button>
    </div>
    <div class="card-body">
        @if (_editRules)
        {
            <div class="mb-2"><label class="form-label text-muted small">Sentence Max Words</label><input type="number" class="form-control form-control-sm bg-dark text-light border-secondary" style="max-width:100px;" @bind="rules.SentenceMaxWords" /></div>
            <div class="mb-2"><label class="form-label text-muted small">POV</label><input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="rulesPov" /></div>
            <div class="mb-2"><label class="form-label text-muted small">Pace</label><input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_rulesPace" /></div>
            <div class="mb-2"><label class="form-label text-muted small">Ending</label><input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_rulesEnding" /></div>
            <button class="btn btn-sm btn-success" @onclick="SaveRules"><i class="bi bi-floppy"></i> Save</button>
        }
        else
        {
            <div class="small">
                <div><strong>Max words/sentence:</strong> @rules.SentenceMaxWords</div>
                @if (rules.Prohibitions.Any()) { <div><strong>Prohibitions:</strong> @string.Join("; ", rules.Prohibitions)</div> }
                @if (rules.Structural.Pov.Length > 0) { <div><strong>POV:</strong> @rules.Structural.Pov</div> }
                @if (rules.Structural.Pace.Length > 0) { <div><strong>Pace:</strong> @rules.Structural.Pace</div> }
            </div>
        }
    </div>
</div>

@* ── Motifs ───────────────────────────────────────────── *@
<div class="card bg-dark text-light border-secondary mb-3">
    <div class="card-header d-flex justify-content-between align-items-center border-secondary">
        <span class="text-danger fw-bold">Motifs</span>
        <button class="btn btn-sm btn-outline-danger" @onclick="AddMotif"><i class="bi bi-plus-lg"></i></button>
    </div>
    <div class="card-body">
        <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary mb-2"
               placeholder="Filter..." @bind="filter" @bind:event="oninput" />
        @if (editingMotif != null)
        {
            <div class="row g-2 mb-2">
                <div class="col-md-4"><label class="form-label text-muted small">Name</label><input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editingMotif.Name" /></div>
                <div class="col-md-8"><label class="form-label text-muted small">Description</label><input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editingMotif.Description" /></div>
            </div>
            <div class="d-flex gap-2 mb-2">
                <button class="btn btn-sm btn-success" @onclick="SaveMotif"><i class="bi bi-floppy"></i> Save</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => editingMotif = null">Cancel</button>
            </div>
        }
        @foreach (var m in FilteredMotifs)
        {
            <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                <div>
                    <span class="fw-bold small">@m.Name</span>
                    <span class="text-muted small ms-2">@m.Description</span>
                </div>
                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => EditMotif(m)"><i class="bi bi-pencil"></i></button>
                    <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => DeleteMotif(m)"><i class="bi bi-trash3"></i></button>
                </div>
            </div>
        }
        @if (!FilteredMotifs.Any() && editingMotif == null)
        {
            <small class="text-muted">No motifs defined yet.</small>
        }
    </div>
</div>

@code {
    private StoryBibleData bible = new();
    private LiteraryRulesData rules = new();
    private List<MotifData> motifs = [];
    private bool editBible, _editRules;
    private string filter = "";

    private IEnumerable<MotifData> FilteredMotifs => string.IsNullOrWhiteSpace(filter)
        ? motifs
        : motifs.Where(m => m.Name.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || m.Description.Contains(filter, StringComparison.OrdinalIgnoreCase));
    private MotifData? editingMotif;
    private string motifOriginalName = "";

    // Mutable proxies for record sub-objects
    private string rulesPov = "", _rulesPace = "", _rulesEnding = "";

    protected override void OnInitialized()
    {
        bible = StoryBibleRepo.Get();
        rules = LitRulesRepo.Get();
        motifs = MotifRepo.GetAll();
        rulesPov = rules.Structural.Pov;
        _rulesPace = rules.Structural.Pace;
        _rulesEnding = rules.Structural.Ending;
    }

    private void SaveBible() { StoryBibleRepo.Save(bible); editBible = false; }

    private void SaveRules()
    {
        rules.Structural.Pov = rulesPov;
        rules.Structural.Pace = _rulesPace;
        rules.Structural.Ending = _rulesEnding;
        LitRulesRepo.Save(rules);
        _editRules = false;
    }

    private void AddMotif() { editingMotif = new MotifData(); motifOriginalName = ""; }
    private void EditMotif(MotifData m) { editingMotif = m; motifOriginalName = m.Name; }

    private void SaveMotif()
    {
        if (editingMotif == null || string.IsNullOrWhiteSpace(editingMotif.Name)) return;
        if (motifOriginalName.Length > 0 && motifOriginalName != editingMotif.Name)
            MotifRepo.Delete(motifOriginalName);
        MotifRepo.Save(editingMotif);
        editingMotif = null;
        motifs = MotifRepo.GetAll();
    }

    private void DeleteMotif(MotifData m)
    {
        MotifRepo.Delete(m.Name);
        motifs = MotifRepo.GetAll();
    }
}
