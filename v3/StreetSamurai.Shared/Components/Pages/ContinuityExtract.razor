@page "/books/{BookId}/continuity-extract"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@using StreetSamurai.Core.Services
@using StreetSamurai.Shared.Services
@inject IBookRepository BookRepo
@inject ToastNotifier Toast
@inject NavigationManager Nav

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <div class="small text-muted mb-1">
                <a href="/books" class="text-muted text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Bookshelf
                </a>
            </div>
            <h4 class="text-danger mb-0"><i class="bi bi-search me-2"></i>Continuity Extract</h4>
            @if (book != null)
            {
                <div class="text-muted small">@book.Title</div>
            }
        </div>
        @if (book != null)
        {
            <div class="d-flex gap-2 align-items-center">
                <a href="@($"/write/{book.Id}")" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-pencil-square me-1"></i>Write
                </a>
                <a href="/continuity" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-list-check me-1"></i>Inbox
                </a>
            </div>
        }
    </div>

    @if (book == null)
    {
        <div class="alert alert-danger">Book not found. <a href="/books">Back to bookshelf</a></div>
    }
    else
    {
        <p class="text-muted small">
            Scans every chapter in this book and extracts atomic (entity, predicate, object)
            continuity claims. Confirmed claims become canon; conflicting claims surface in the
            Continuity inbox at <a href="/continuity" class="text-info">/continuity</a> for resolution.
            Runs <code>node tools/extract-facts.js</code> behind the scenes — node must be on PATH.
        </p>

        <div class="card bg-dark border-secondary">
            <div class="card-body">
                <h5 class="text-info"><i class="bi bi-search me-2"></i>Extract continuity facts</h5>
                <p class="text-muted small">
                    Runs the full LLM extraction pipeline across every chapter. Cost scales with the book's
                    word count — for a typical chapter, expect a couple of cents per voter. Result:
                    new claims persisted, confirmations counted, contradictions flagged.
                </p>
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-info" @onclick="ExtractAsync" disabled="@working">
                        @if (working)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                            <span>Running…</span>
                        }
                        else
                        {
                            <i class="bi bi-search me-1"></i>
                            <span>Extract from every chapter</span>
                        }
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(status))
                {
                    var alertClass = status.StartsWith("error", StringComparison.OrdinalIgnoreCase)
                        ? "alert-danger"
                        : status.Contains("contradict", StringComparison.OrdinalIgnoreCase)
                            ? "alert-warning"
                            : "alert-success";
                    <div class="alert @alertClass mt-3 small mb-0">@status</div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string BookId { get; set; } = "";

    private Book? book;
    private bool working;
    private string status = "";

    protected override void OnInitialized()
    {
        try { book = BookRepo.LoadBook(BookId); }
        catch (Exception ex) { Toast.Error("CONTINUITY-LOAD", $"Couldn't load book: {ex.Message}"); }
    }

    private async Task ExtractAsync()
    {
        if (book == null || working) return;
        working = true;
        status = "Running continuity extraction across every chapter…";
        StateHasChanged();
        try
        {
            var psi = new System.Diagnostics.ProcessStartInfo
            {
                FileName = "node",
                UseShellExecute = false,
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                CreateNoWindow = true,
            };
            psi.ArgumentList.Add(System.IO.Path.GetFullPath(System.IO.Path.Combine("tools", "extract-facts.js")));
            psi.ArgumentList.Add(book.Id);
            psi.ArgumentList.Add("--mode");
            psi.ArgumentList.Add("book");
            psi.ArgumentList.Add("--max-tokens");
            psi.ArgumentList.Add("4096");

            using var proc = System.Diagnostics.Process.Start(psi);
            if (proc == null)
            {
                status = "error: node failed to start (is node on PATH?)";
                Toast.Error("CONTINUITY-NODE-FAIL", status);
                return;
            }
            var stdoutTask = proc.StandardOutput.ReadToEndAsync();
            await proc.WaitForExitAsync();
            var stdout = await stdoutTask;
            try
            {
                using var doc = System.Text.Json.JsonDocument.Parse(stdout);
                var totals = doc.RootElement.GetProperty("totals");
                var n = totals.GetProperty("new").GetInt32();
                var c = totals.GetProperty("confirmed").GetInt32();
                var x = totals.GetProperty("contradicted").GetInt32();
                status = $"{n} new · {c} confirmed · {x} contradiction(s) — see /continuity for resolution.";
                if (x > 0) Toast.Warning("CONTINUITY-CONTRADICTIONS", $"{x} contradiction(s) — review at /continuity.");
                else Toast.Success("CONTINUITY-OK", $"Extracted {n} new + {c} confirmed.");
            }
            catch
            {
                status = "extraction returned non-JSON — check logs";
                Toast.Error("CONTINUITY-PARSE-FAIL", status);
            }
        }
        catch (Exception ex)
        {
            status = "error: " + ex.Message;
            Toast.Error("CONTINUITY-EXTRACT-FAIL", ex.Message);
        }
        finally
        {
            working = false;
            StateHasChanged();
        }
    }
}
