@page "/places"
@page "/districts"
@using StreetSamurai.Core.Models.Canon
@inject DistrictRepository Repo
@inject SettingsService Settings
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject WorldGraphService Graph

<div class="dict-layout">
    <div class="dict-list bg-dark border-end border-secondary">
        <div class="p-2">
            <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                   placeholder="Filter places..." @bind="_filter" @bind:event="oninput" />
        </div>
        @foreach (var d in FilteredItems)
        {
            <div class="list-item text-light @(_editing?.Name == d.Name ? "active" : "")" @onclick="() => Edit(d)">
                <div class="fw-bold small">@d.Name</div>
                @if (d.Coordinates.Lat != 0)
                {
                    <div class="text-muted" style="font-size: 0.6rem;">@d.Coordinates.Lat.ToString("F3"), @d.Coordinates.Lng.ToString("F3")</div>
                }
            </div>
        }
        <div class="p-2">
            <button class="btn btn-sm btn-outline-danger w-100" @onclick="AddNew"><i class="bi bi-plus-lg"></i> New Place</button>
        </div>
    </div>

    <div class="dict-editor">
        @if (_editing != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-danger mb-0">@(_isNew ? "New Place" : _editing.Name)</h5>
                <div class="d-flex gap-2">
                    @if (_editing.Coordinates.Lat != 0)
                    {
                        <a href="@MapUrl(_editing.Coordinates.Lat, _editing.Coordinates.Lng, _editing.Name)" target="_blank"
                           class="btn btn-sm btn-outline-info" title="View on map">
                            <i class="bi bi-geo-alt"></i> Map
                        </a>
                    }
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i> Save</button>
                    @if (!_isNew && !_confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-trash3"></i></button> }
                    @if (_confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete">Confirm</button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false">No</button> }
                </div>
            </div>

            @* ── Map Embed ───────────────────────────────── *@
            @if (_editing.Coordinates.Lat != 0 && !string.IsNullOrWhiteSpace(Settings.MapApiKey))
            {
                <div class="mb-3 rounded overflow-hidden border border-secondary" style="height: 250px;">
                    <div id="here-map" style="width: 100%; height: 100%;"></div>
                </div>
            }
            else if (_editing.Coordinates.Lat != 0)
            {
                <div class="mb-3 rounded overflow-hidden border border-secondary bg-black d-flex align-items-center justify-content-center" style="height: 200px;">
                    <div class="text-center">
                        <i class="bi bi-geo-alt text-danger" style="font-size: 2rem;"></i>
                        <div class="text-muted small mt-1">@_editing.Coordinates.Lat.ToString("F4"), @_editing.Coordinates.Lng.ToString("F4")</div>
                        <a href="@MapUrl(_editing.Coordinates.Lat, _editing.Coordinates.Lng, _editing.Name)" target="_blank" class="btn btn-sm btn-outline-info mt-2">
                            <i class="bi bi-box-arrow-up-right"></i> Open in HERE
                        </a>
                    </div>
                </div>
            }

            <div class="row g-3 mb-3">
                <div class="col-4"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Name" /></div>
                <div class="col-4"><div class="field-label">Demographics</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Demographics" /></div>
                <div class="col-4"><div class="field-label">Economy</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Economy" /></div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-6">
                    <div class="field-label">Latitude</div>
                    <input type="number" step="0.0001" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Coordinates.Lat" />
                </div>
                <div class="col-6">
                    <div class="field-label">Longitude</div>
                    <input type="number" step="0.0001" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Coordinates.Lng" />
                </div>
            </div>

            <div class="mb-3"><div class="field-label">Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.Description"></textarea></div>
            <div class="mb-3"><div class="field-label">Power Structure</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.PowerStructure"></textarea></div>

            <div class="field-label mb-1">Atmosphere</div>
            <div class="mb-3"><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.Atmosphere.Feel"></textarea></div>
        }
        else { <div class="text-muted d-flex align-items-center justify-content-center h-100">Select a place or create a new one</div> }
    </div>
</div>

@code {
    private List<DistrictData> _items = [];
    private DistrictData? _editing;
    private bool _isNew, _confirmDelete;
    private string _originalName = "";
    private string _filter = "";

    private IEnumerable<DistrictData> FilteredItems => string.IsNullOrWhiteSpace(_filter)
        ? _items
        : _items.Where(d => d.Name.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || d.Aliases.Any(a => a.Contains(_filter, StringComparison.OrdinalIgnoreCase)));

    protected override void OnInitialized() { Repo.Reload(); _items = Repo.GetAll(); if (Nav.Uri.Contains("new=true")) AddNew(); }
    private void AddNew() { _editing = new DistrictData(); _isNew = true; _confirmDelete = false; }
    private void Edit(DistrictData d) { _editing = d; _originalName = d.Name; _isNew = false; _confirmDelete = false; }
    private void SaveEdit() { if (_editing == null || string.IsNullOrWhiteSpace(_editing.Name)) return; if (!_isNew && _originalName != _editing.Name) Repo.Delete(_originalName); Repo.Save(_editing); _editing = null; _items = Repo.GetAll(); }
    private void DoDelete() { if (_editing == null) return; Graph.RemoveNode(_editing.Name); Repo.Delete(_editing.Name); _editing = null; _confirmDelete = false; _items = Repo.GetAll(); }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("writeInterop.autoResizeAll");
        if (_editing != null && _editing.Coordinates.Lat != 0 && !string.IsNullOrWhiteSpace(Settings.MapApiKey))
        {
            try { await JS.InvokeVoidAsync("hereMap.show", "here-map", Settings.MapAppId, Settings.MapApiKey,
                _editing.Coordinates.Lat, _editing.Coordinates.Lng, _editing.Name); }
            catch { /* HERE Maps JS not loaded — graceful fallback to static display */ }
        }
    }

    private string MapUrl(double lat, double lng, string name) =>
        $"https://wego.here.com/?map={lat},{lng},14,normal&x=ep";
}
