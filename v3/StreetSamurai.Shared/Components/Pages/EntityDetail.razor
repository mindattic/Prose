    private FactionData? faction;
    private CorponationData? corponation;
    private TechnologyData? technology;
    private WeaponryData? weapon;
    private EquipmentData? equipment;
    private CyberwareData? cyberware;
    private VocabularyEntry? vocabEntry;
    private AmmunitionData? ammo;
    private ApparelData? apparel;
    private GenemodData? genemod;
    private PharmaceuticalData? pharma;
    private MaterialData? material;
    private TransportationData? transport;
    private AutomatonData? automaton;
    private ArchetypeData? archetype;
    private SubsidiaryData? subsidiary;
    private EntertainmentData? entertainment;
    private ConsumerGoodData? consumerGood;
    private QuoteData? quote;
    private NewsData? news;
    private ContractData? contract;
    private WorldbuildingDocument? document;
    private bool notFound;
    private string resolvedName = "";
    private List<CanonSearchResult> referencedBy = [];

    protected override void OnParametersSet()
    {
        character = null; synthetic = null; place = null; faction = null;
        corponation = null; technology = null; weapon = null; equipment = null;
        cyberware = null; vocabEntry = null;
        ammo = null; apparel = null; genemod = null; pharma = null; material = null;
        transport = null; automaton = null; archetype = null; subsidiary = null;
        entertainment = null; consumerGood = null; quote = null; news = null;
        contract = null; document = null;
        notFound = false; resolvedName = ""; referencedBy = [];

        if (string.IsNullOrWhiteSpace(EntityId)) { notFound = true; return; }

        ResolveEntity();

        if (!notFound && resolvedName.Length >= 4)
            referencedBy = GlobalSearch.Search(resolvedName, 1, 15)
                .Where(r => r.Id != EntityId)
                .ToList();
    }

    private void ResolveEntity()
    {
        character   = CharRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (character != null) { resolvedName = character.Name; return; }
        synthetic   = SynthRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (synthetic != null) { resolvedName = synthetic.Name; return; }
        place       = PlaceRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (place != null) { resolvedName = place.Name; return; }
        faction     = FactionRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (faction != null) { resolvedName = faction.Name; return; }
        corponation = CorpRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (corponation != null) { resolvedName = corponation.Name; return; }
        technology  = TechRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (technology != null) { resolvedName = technology.Name; return; }
        weapon      = WeaponRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (weapon != null) { resolvedName = weapon.Name; return; }
        equipment   = EquipRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (equipment != null) { resolvedName = equipment.Name; return; }
        cyberware   = CyberRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (cyberware != null) { resolvedName = cyberware.Name; return; }
        vocabEntry  = VocabRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (vocabEntry != null) { resolvedName = vocabEntry.Term; return; }
        ammo        = AmmoRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (ammo != null) { resolvedName = ammo.Name; return; }
        apparel     = ApparelRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (apparel != null) { resolvedName = apparel.Name; return; }
        genemod     = GenemodRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (genemod != null) { resolvedName = genemod.Name; return; }
        pharma      = PharmaRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (pharma != null) { resolvedName = pharma.Name; return; }
        material    = MaterialRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (material != null) { resolvedName = material.Name; return; }
        transport   = TransportRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (transport != null) { resolvedName = transport.Name; return; }
        automaton   = AutomatonRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (automaton != null) { resolvedName = automaton.Name; return; }
        archetype   = ArchetypeRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (archetype != null) { resolvedName = archetype.Name; return; }
        subsidiary  = SubsidiaryRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (subsidiary != null) { resolvedName = subsidiary.Name; return; }
        entertainment = EntertainRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (entertainment != null) { resolvedName = entertainment.Name; return; }
        consumerGood = ConsumerRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (consumerGood != null) { resolvedName = consumerGood.Name; return; }
        quote       = QuoteRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (quote != null) { resolvedName = quote.Attribution; return; }
        news        = NewsRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (news != null) { resolvedName = news.Headline; return; }
        contract    = ContractRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (contract != null) { resolvedName = contract.Codename; return; }
        document    = DocRepo.GetAll().FirstOrDefault(e => e.Id == EntityId);
        if (document != null) { resolvedName = document.Title; return; }

        notFound = true;
    }
}
