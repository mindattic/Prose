    // ── Tab content for non-character entities (place / corp / faction) ───
    // Loaded on demand from the world graph + EF when the matching entity resolves.
    // Reuses RelatedRowsList.RelatedRow so the component can render directly.
    private List<RelatedRowsList.RelatedRow> subPlaces      = [];
    private List<RelatedRowsList.RelatedRow> inhabitants    = [];
    private List<RelatedRowsList.RelatedRow> placeEvents    = [];
    private List<RelatedRowsList.RelatedRow> corpSubs       = [];
    private List<RelatedRowsList.RelatedRow> corpPersonnel  = [];
    private List<RelatedRowsList.RelatedRow> corpOps        = [];
    private List<RelatedRowsList.RelatedRow> factionMembers = [];
    private List<RelatedRowsList.RelatedRow> factionOps     = [];

    // Trip a tab neon-flicker on the next render (set when the entity changes)
    private bool _flickerOnRender;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_flickerOnRender)
        {
            _flickerOnRender = false;
            // ~50% of entity loads trigger the urban-decay neon flicker on a few tabs
            if (Random.Shared.NextDouble() < 0.50)
            {
                try { await JS.InvokeVoidAsync("cyberspaceEntityFlickerTabs"); }
                catch { /* JS not loaded yet — silent */ }
            }
        }
        if (firstRender)
        {
            try
            {
                // Resume the last tab the user was on for this entity, but only if
                // the URL didn't specify one — explicit ?tab= wins.
                if (string.IsNullOrEmpty(TabParam))
                {
                    var savedTab = await JS.InvokeAsync<string?>("ssState.get", $"entity:{EntityId}:tab");
                    if (!string.IsNullOrWhiteSpace(savedTab) && ValidTabs.Contains(savedTab) && savedTab != "record")
                    {
                        Nav.NavigateTo($"/entity/{EntityId}?tab={savedTab}{(AsOf.HasValue ? $"&asOf={AsOf}" : "")}", replace: true);
                        return;
                    }
                }
                await JS.InvokeVoidAsync("ssState.installAutoScroll", $"entity:{EntityId}:scroll");
                await JS.InvokeVoidAsync("ssState.restoreScroll",     $"entity:{EntityId}:scroll");
            }
            catch { }
        }
    }

    protected override void OnParametersSet()
    {
        character = null; synthetic = null; place = null; faction = null;
        corponation = null; technology = null; weapon = null; equipment = null;
        cyberware = null; vocabEntry = null;
        ammo = null; apparel = null; genemod = null; pharma = null; material = null;
        transport = null; automaton = null; archetype = null; subsidiary = null;
        entertainment = null; consumerGood = null; quote = null; news = null;
        contract = null; document = null;
        notFound = false; resolvedName = ""; resolvedId = ""; resolvedMidjourneyPrompt = ""; resolvedDalle3Prompt = ""; referencedBy = [];
        primaryImage = null;
        // Navigating to a different entity discards any pending edits — prevents stale Save dispatch
        editMode = false; editBackupJson = null; editError = "";
        // Mark the next render for the cyberpunk neon-flicker pass on tabs
        _flickerOnRender = true;

        if (string.IsNullOrWhiteSpace(EntityId)) { notFound = true; return; }

        ResolveEntity();
        primaryImage = Media.GetPrimaryImage(resolvedId);

        if (!notFound && resolvedName.Length >= 4)
            referencedBy = GlobalSearch.Search(resolvedName, 1, 15)
                .Where(r => r.Id != resolvedId)
                .ToList();

        LoadEntityTabs();
    }

    /// <summary>
    /// Populate tab contents for places / corponations / factions. Each pulls
    /// related entities via the WorldGraph (which is already SQL-backed). Cheap:
    /// graph reads are in-memory after EnsureLoaded.
    /// </summary>
    private void LoadEntityTabs()
    {
        subPlaces.Clear(); inhabitants.Clear(); placeEvents.Clear();
        corpSubs.Clear();  corpPersonnel.Clear(); corpOps.Clear();
        factionMembers.Clear(); factionOps.Clear();

        if (place != null)
        {
            // Sub-places: places whose description mentions this place by name.
            foreach (var p in PlaceRepo.GetAll())
            {
                if (p.Id == place.Id) continue;
                if ((p.Description ?? "").Contains(place.Name, StringComparison.OrdinalIgnoreCase))
                    subPlaces.Add(new(p.Id, p.Name, "", "place"));
            }
            // Inhabitants: characters whose territory / residence / affiliation mentions this place.
            foreach (var c in CharRepo.GetAll())
            {
                var hay = $"{c.Territory?.HomeTurf} {c.Belongings?.Residence} {c.Affiliation}";
                if (hay.Contains(place.Name, StringComparison.OrdinalIgnoreCase))
                    inhabitants.Add(new(c.Id, c.Name, c.Role ?? "", "character"));
            }
            // Events: chapters whose synopsis or title references this place.
            foreach (var ch in Chapters.ListChapters())
            {
                var hay = $"{ch.Title} {ch.Synopsis}";
                if (hay.Contains(place.Name, StringComparison.OrdinalIgnoreCase))
                    placeEvents.Add(new(ch.Id, ch.Title, $"Ch{ch.Number?.ToString() ?? "?"}", "chapter"));
            }
        }
        else if (corponation != null)
        {
            foreach (var s in SubsidiaryRepo.GetAll())
                if ((s.ParentCorponation ?? "").Equals(corponation.Name, StringComparison.OrdinalIgnoreCase))
                    corpSubs.Add(new(s.Id, s.Name, s.LineOfBusiness ?? "", "subsidiary"));
            foreach (var c in CharRepo.GetAll())
                if ((c.Affiliation ?? "").Contains(corponation.Name, StringComparison.OrdinalIgnoreCase))
                    corpPersonnel.Add(new(c.Id, c.Name, c.Role ?? "", "character"));
            foreach (var ct in ContractRepo.GetAll())
                if ((ct.Client ?? "").Contains(corponation.Name, StringComparison.OrdinalIgnoreCase))
                    corpOps.Add(new(ct.Id, ct.Codename, ct.Description ?? "", "contract"));
        }
        else if (faction != null)
        {
            foreach (var c in CharRepo.GetAll())
                if ((c.Affiliation ?? "").Contains(faction.Name, StringComparison.OrdinalIgnoreCase))
                    factionMembers.Add(new(c.Id, c.Name, c.Role ?? "", "character"));
            foreach (var ct in ContractRepo.GetAll())
                if ((ct.Client ?? "").Contains(faction.Name, StringComparison.OrdinalIgnoreCase))
                    factionOps.Add(new(ct.Id, ct.Codename, ct.Description ?? "", "contract"));
        }
    }

    private static string TabIcon(string type) => type switch
    {
        "character"  => "bi-person",
        "place"      => "bi-geo-alt",
        "subsidiary" => "bi-diagram-3",
        "contract"   => "bi-file-earmark-text",
        "chapter"    => "bi-book",
        _            => "bi-link-45deg",
    };

    private void ResolveEntity()
    {
        // Each lookup tries GUID first, then name-slug — so both
        // /entity/019d6143a648787696880f6d38d70075 and /entity/kyle-ellen-corbin-vasik work.
        character   = CharRepo.GetById(EntityId)    ?? CharRepo.GetBySlug(EntityId);
        if (character != null)    { resolvedId = character.Id;    resolvedName = character.Name;    resolvedMidjourneyPrompt = character.MidjourneyPrompt; resolvedDalle3Prompt = character.Dalle3Prompt; return; }
        synthetic   = SynthRepo.GetById(EntityId)   ?? SynthRepo.GetBySlug(EntityId);
        if (synthetic != null)    { resolvedId = synthetic.Id;    resolvedName = synthetic.Name;    return; }
        place       = PlaceRepo.GetById(EntityId)   ?? PlaceRepo.GetBySlug(EntityId);
        if (place != null)        { resolvedId = place.Id;        resolvedName = place.Name;        return; }
        faction     = FactionRepo.GetById(EntityId) ?? FactionRepo.GetBySlug(EntityId);
        if (faction != null)      { resolvedId = faction.Id;      resolvedName = faction.Name;      return; }
        corponation = CorpRepo.GetById(EntityId)    ?? CorpRepo.GetBySlug(EntityId);
        if (corponation != null)  { resolvedId = corponation.Id;  resolvedName = corponation.Name;  return; }
        technology  = TechRepo.GetById(EntityId)    ?? TechRepo.GetBySlug(EntityId);
        if (technology != null)   { resolvedId = technology.Id;   resolvedName = technology.Name;   return; }
        weapon      = WeaponRepo.GetById(EntityId)  ?? WeaponRepo.GetBySlug(EntityId);
        if (weapon != null)       { resolvedId = weapon.Id;       resolvedName = weapon.Name;       return; }
        equipment   = EquipRepo.GetById(EntityId)   ?? EquipRepo.GetBySlug(EntityId);
        if (equipment != null)    { resolvedId = equipment.Id;    resolvedName = equipment.Name;    return; }
        cyberware   = CyberRepo.GetById(EntityId)   ?? CyberRepo.GetBySlug(EntityId);
        if (cyberware != null)    { resolvedId = cyberware.Id;    resolvedName = cyberware.Name;    return; }
        vocabEntry  = VocabRepo.GetById(EntityId)   ?? VocabRepo.GetBySlug(EntityId);
        if (vocabEntry != null)   { resolvedId = vocabEntry.Id;   resolvedName = vocabEntry.Term;   return; }
        ammo        = AmmoRepo.GetById(EntityId)    ?? AmmoRepo.GetBySlug(EntityId);
        if (ammo != null)         { resolvedId = ammo.Id;         resolvedName = ammo.Name;         return; }
        apparel     = ApparelRepo.GetById(EntityId) ?? ApparelRepo.GetBySlug(EntityId);
        if (apparel != null)      { resolvedId = apparel.Id;      resolvedName = apparel.Name;      return; }
        genemod     = GenemodRepo.GetById(EntityId) ?? GenemodRepo.GetBySlug(EntityId);
        if (genemod != null)      { resolvedId = genemod.Id;      resolvedName = genemod.Name;      return; }
        pharma      = PharmaRepo.GetById(EntityId)  ?? PharmaRepo.GetBySlug(EntityId);
        if (pharma != null)       { resolvedId = pharma.Id;       resolvedName = pharma.Name;       return; }
        material    = MaterialRepo.GetById(EntityId) ?? MaterialRepo.GetBySlug(EntityId);
        if (material != null)     { resolvedId = material.Id;     resolvedName = material.Name;     return; }
        transport   = TransportRepo.GetById(EntityId) ?? TransportRepo.GetBySlug(EntityId);
        if (transport != null)    { resolvedId = transport.Id;    resolvedName = transport.Name;    return; }
        automaton   = AutomatonRepo.GetById(EntityId) ?? AutomatonRepo.GetBySlug(EntityId);
        if (automaton != null)    { resolvedId = automaton.Id;    resolvedName = automaton.Name;    return; }
        archetype   = ArchetypeRepo.GetById(EntityId) ?? ArchetypeRepo.GetBySlug(EntityId);
        if (archetype != null)    { resolvedId = archetype.Id;    resolvedName = archetype.Name;    return; }
        subsidiary  = SubsidiaryRepo.GetById(EntityId) ?? SubsidiaryRepo.GetBySlug(EntityId);
        if (subsidiary != null)   { resolvedId = subsidiary.Id;   resolvedName = subsidiary.Name;   return; }
        entertainment = EntertainRepo.GetById(EntityId) ?? EntertainRepo.GetBySlug(EntityId);
        if (entertainment != null){ resolvedId = entertainment.Id; resolvedName = entertainment.Name; return; }
        consumerGood = ConsumerRepo.GetById(EntityId) ?? ConsumerRepo.GetBySlug(EntityId);
        if (consumerGood != null) { resolvedId = consumerGood.Id; resolvedName = consumerGood.Name; return; }
        quote       = QuoteRepo.GetById(EntityId)   ?? QuoteRepo.GetBySlug(EntityId);
        if (quote != null)        { resolvedId = quote.Id;        resolvedName = quote.Attribution; return; }
        news        = NewsRepo.GetById(EntityId)    ?? NewsRepo.GetBySlug(EntityId);
        if (news != null)         { resolvedId = news.Id;         resolvedName = news.Headline;     return; }
        contract    = ContractRepo.GetById(EntityId) ?? ContractRepo.GetBySlug(EntityId);
        if (contract != null)     { resolvedId = contract.Id;     resolvedName = contract.Codename; return; }
        document    = DocRepo.GetById(EntityId)     ?? DocRepo.GetBySlug(EntityId);
        if (document != null)     { resolvedId = document.Id;     resolvedName = document.Title;    return; }

        notFound = true;
    }
