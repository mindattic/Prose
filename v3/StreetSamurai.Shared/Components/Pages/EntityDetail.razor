else if (place != null)
{
    <EntityDetailHeader Name="@place.Name" Type="place" TypeLabel="Place"
                        Subtitle="@(place.Tags.FirstOrDefault() ?? "")" BackRoute="/places"
                        Tags="@place.Tags" />
    <div class="entity-detail-body">
        @if (!string.IsNullOrWhiteSpace(place.Description))
        {
            <div class="entity-section">
                <div class="entity-section-label">Description</div>
                <XrefText Text="@place.Description" Paragraphs="true" />
            </div>
        }
        @if (place.Coordinates.Lat != 0 || place.Coordinates.Lng != 0)
        {
            <div class="entity-section">
                <div class="entity-section-label">Location</div>
                <GeoMap Lat="@place.Coordinates.Lat" Lng="@place.Coordinates.Lng" Title="@place.Name" />
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(place.Atmosphere?.Feel))
        {
            <div class="entity-section">
                <div class="entity-section-label">Feel</div>
                <em class="text-muted"><XrefText Text="@place.Atmosphere.Feel" /></em>
            </div>
        }
        <div class="entity-meta-row">
            @if (!string.IsNullOrWhiteSpace(place.Demographics))
            {
                <div class="entity-meta-item" style="flex:2"><span class="entity-meta-label">Demographics</span> @place.Demographics</div>
            }
            @if (!string.IsNullOrWhiteSpace(place.PowerStructure))
            {
                <div class="entity-meta-item" style="flex:2"><span class="entity-meta-label">Power</span> <XrefText Text="@place.PowerStructure" /></div>
            }
        </div>
        @if (place.Dangers.Any())
        {
            <div class="entity-section">
                <div class="entity-section-label">Dangers</div>
                <ul class="entity-list">
                    @foreach (var d in place.Dangers) { <li><XrefText Text="@d" /></li> }
                </ul>
            </div>
        }
        @if (place.Opportunities.Any())
        {
            <div class="entity-section">
                <div class="entity-section-label">Opportunities</div>
                <ul class="entity-list">
                    @foreach (var o in place.Opportunities) { <li><XrefText Text="@o" /></li> }
                </ul>
            </div>
        }
        @if (place.FrequentedBy.Any())
        {
            <div class="entity-section">
                <div class="entity-section-label">Frequented By</div>
                <div class="xref-chips">
                    @foreach (var name in place.FrequentedBy)
                    {
                        var e = Xref.Resolve(name);
                        @if (e != null) {
                            <a href="/entity/@e.Id" class="xref-chip xref-@e.Type">@name</a>
                        } else {
                            <span class="xref-chip xref-unknown">@name</span>
                        }
                    }
                </div>
            </div>
        }
        @if (place.NotableLocations.Any())
        {
            <div class="entity-section">
                <div class="entity-section-label">Notable Locations</div>
                @foreach (var loc in place.NotableLocations)
                {
                    <div class="entity-notable-loc">
                        <div class="fw-bold small">@loc.Name</div>
                        @if (!string.IsNullOrWhiteSpace(loc.Description))
                        {
                            <div class="text-muted"><XrefText Text="@loc.Description" /></div>
                        }
                    </div>
                }
            </div>
        }
        @if (place.StoryHooks.Any())
        {
            <div class="entity-section">
                <div class="entity-section-label">Story Hooks</div>
                <ul class="entity-list">
                    @foreach (var h in place.StoryHooks) { <li><XrefText Text="@h" /></li> }
                </ul>
            </div>
        }
    </div>
}
