</style>

@code {
    [Parameter] public string EntityId { get; set; } = "";

    [SupplyParameterFromQuery(Name = "tab")] public string? TabParam { get; set; }
    [SupplyParameterFromQuery(Name = "asOf")] public int? AsOf { get; set; }

    /// <summary>
    /// Active view tab. Defaults to "record"; honored from ?tab=record|dossier|relationships|cyberware|knowledge|conditions|belongings|timeline.
    /// </summary>
    private static readonly string[] ValidTabs = {
        "record", "dossier", "relationships", "cyberware",
        "knowledge", "conditions", "belongings", "timeline", "family"
    };
    private string CurrentTab =>
        ValidTabs.FirstOrDefault(t => string.Equals(TabParam, t, StringComparison.OrdinalIgnoreCase))
        ?? "record";

    private void SwitchTab(string tab)
    {
        var query = tab == "record"
            ? ""
            : $"?tab={tab}{(AsOf.HasValue ? $"&asOf={AsOf}" : "")}";
        Nav.NavigateTo($"/entity/{EntityId}{query}");
        editMode = false; // any tab switch exits edit mode
        _ = PersistTabAsync(tab);
    }

    /// <summary>Persist the current tab so the next /entity/{id} entry resumes here.</summary>
    private async Task PersistTabAsync(string tab)
    {
        try { await JS.InvokeVoidAsync("ssState.set", $"entity:{EntityId}:tab", tab); }
        catch { }
    }

    /// <summary>
    /// On first render, if no ?tab= was in the URL but a saved tab exists for
    /// this entity, hop to it. Also installs scrollY persistence keyed per entity.
    /// </summary>

    // ── Edit mode (admin-only) ──
    // One global Edit/Save/Cancel works across every entity type and every tab.
    // Backup is a JSON snapshot of whichever typed entity field is loaded; Cancel rehydrates it.
    private bool editMode;
    private string? editBackupJson;
    private string editError = "";

    private RenderFragment GlobalEditControls() =>
        @<text>
            @if (!notFound && Access.IsAdministrator)
            {
                @if (!editMode)
                {
                    <button class="btn btn-sm btn-outline-warning ms-2" @onclick="StartEdit"><i class="bi bi-pencil me-1"></i>Edit</button>
                }
                else
                {
                    <span class="d-flex gap-2 ms-2">
                        <button class="btn btn-sm btn-success" @onclick="SaveAll"><i class="bi bi-check2 me-1"></i>Save All</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                    </span>
                }
            }
        </text>;

    private void StartEdit()
    {
        editBackupJson = SerializeLoadedEntity();
        if (editBackupJson == null) return; // nothing loaded
        editMode = true;
        editError = "";
    }

    private void CancelEdit()
    {
        if (!string.IsNullOrEmpty(editBackupJson)) RestoreLoadedEntity(editBackupJson);
        editBackupJson = null;
        editMode = false;
        editError = "";
    }

    /// <summary>
    /// Persist whichever typed entity is currently loaded. Each entity type lives in its own
    /// EF-backed table; the dispatcher routes to the correct repo. Sub-tab data on Character
    /// (Relationships, CyberwareInventory, Knowledge, etc.) lives on the CharacterData object
    /// itself, so saving the parent persists every tab in one shot.
    /// </summary>
    private void SaveAll()
    {
        try
        {
            if      (character     != null) CharRepo.Save(character);
            else if (synthetic     != null) SynthRepo.Save(synthetic);
            else if (place         != null) PlaceRepo.Save(place);
            else if (faction       != null) FactionRepo.Save(faction);
            else if (corponation   != null) CorpRepo.Save(corponation);
            else if (technology    != null) TechRepo.Save(technology);
            else if (weapon        != null) WeaponRepo.Save(weapon);
            else if (equipment     != null) EquipRepo.Save(equipment);
            else if (cyberware     != null) CyberRepo.Save(cyberware);
            else if (vocabEntry    != null) VocabRepo.Save(vocabEntry);
            else if (ammo          != null) AmmoRepo.Save(ammo);
            else if (apparel       != null) ApparelRepo.Save(apparel);
            else if (genemod       != null) GenemodRepo.Save(genemod);
            else if (pharma        != null) PharmaRepo.Save(pharma);
            else if (material      != null) MaterialRepo.Save(material);
            else if (transport     != null) TransportRepo.Save(transport);
            else if (automaton     != null) AutomatonRepo.Save(automaton);
            else if (archetype     != null) ArchetypeRepo.Save(archetype);
            else if (subsidiary    != null) SubsidiaryRepo.Save(subsidiary);
            else if (entertainment != null) EntertainRepo.Save(entertainment);
            else if (consumerGood  != null) ConsumerRepo.Save(consumerGood);
            else if (quote         != null) QuoteRepo.Save(quote);
            else if (news          != null) NewsRepo.Save(news);
            else if (contract      != null) ContractRepo.Save(contract);
            else if (document      != null) DocRepo.Save(document);

            editMode = false;
            editBackupJson = null;
            editError = "";
            Toast.Success("EDIT-001", $"Saved {resolvedName}");
        }
        catch (Exception ex)
        {
            editError = ex.Message;
            Toast.Error("EDIT-002", $"Save failed: {ex.Message}");
        }
    }

    private string? SerializeLoadedEntity()
    {
        var opts = new System.Text.Json.JsonSerializerOptions { WriteIndented = false };
        if (character     != null) return System.Text.Json.JsonSerializer.Serialize(character, opts);
        if (synthetic     != null) return System.Text.Json.JsonSerializer.Serialize(synthetic, opts);
        if (place         != null) return System.Text.Json.JsonSerializer.Serialize(place, opts);
        if (faction       != null) return System.Text.Json.JsonSerializer.Serialize(faction, opts);
        if (corponation   != null) return System.Text.Json.JsonSerializer.Serialize(corponation, opts);
        if (technology    != null) return System.Text.Json.JsonSerializer.Serialize(technology, opts);
        if (weapon        != null) return System.Text.Json.JsonSerializer.Serialize(weapon, opts);
        if (equipment     != null) return System.Text.Json.JsonSerializer.Serialize(equipment, opts);
        if (cyberware     != null) return System.Text.Json.JsonSerializer.Serialize(cyberware, opts);
        if (vocabEntry    != null) return System.Text.Json.JsonSerializer.Serialize(vocabEntry, opts);
        if (ammo          != null) return System.Text.Json.JsonSerializer.Serialize(ammo, opts);
        if (apparel       != null) return System.Text.Json.JsonSerializer.Serialize(apparel, opts);
        if (genemod       != null) return System.Text.Json.JsonSerializer.Serialize(genemod, opts);
        if (pharma        != null) return System.Text.Json.JsonSerializer.Serialize(pharma, opts);
        if (material      != null) return System.Text.Json.JsonSerializer.Serialize(material, opts);
        if (transport     != null) return System.Text.Json.JsonSerializer.Serialize(transport, opts);
        if (automaton     != null) return System.Text.Json.JsonSerializer.Serialize(automaton, opts);
        if (archetype     != null) return System.Text.Json.JsonSerializer.Serialize(archetype, opts);
        if (subsidiary    != null) return System.Text.Json.JsonSerializer.Serialize(subsidiary, opts);
        if (entertainment != null) return System.Text.Json.JsonSerializer.Serialize(entertainment, opts);
        if (consumerGood  != null) return System.Text.Json.JsonSerializer.Serialize(consumerGood, opts);
        if (quote         != null) return System.Text.Json.JsonSerializer.Serialize(quote, opts);
        if (news          != null) return System.Text.Json.JsonSerializer.Serialize(news, opts);
        if (contract      != null) return System.Text.Json.JsonSerializer.Serialize(contract, opts);
        if (document      != null) return System.Text.Json.JsonSerializer.Serialize(document, opts);
        return null;
    }

    private void RestoreLoadedEntity(string json)
    {
        try
        {
            if      (character     != null) character     = System.Text.Json.JsonSerializer.Deserialize<CharacterData>(json);
            else if (synthetic     != null) synthetic     = System.Text.Json.JsonSerializer.Deserialize<SyntheticLifeData>(json);
            else if (place         != null) place         = System.Text.Json.JsonSerializer.Deserialize<DistrictData>(json);
            else if (faction       != null) faction       = System.Text.Json.JsonSerializer.Deserialize<FactionData>(json);
            else if (corponation   != null) corponation   = System.Text.Json.JsonSerializer.Deserialize<CorponationData>(json);
            else if (technology    != null) technology    = System.Text.Json.JsonSerializer.Deserialize<TechnologyData>(json);
            else if (weapon        != null) weapon        = System.Text.Json.JsonSerializer.Deserialize<WeaponryData>(json);
            else if (equipment     != null) equipment     = System.Text.Json.JsonSerializer.Deserialize<EquipmentData>(json);
            else if (cyberware     != null) cyberware     = System.Text.Json.JsonSerializer.Deserialize<CyberwareData>(json);
            else if (vocabEntry    != null) vocabEntry    = System.Text.Json.JsonSerializer.Deserialize<VocabularyData>(json);
            else if (ammo          != null) ammo          = System.Text.Json.JsonSerializer.Deserialize<AmmunitionData>(json);
            else if (apparel       != null) apparel       = System.Text.Json.JsonSerializer.Deserialize<ApparelData>(json);
            else if (genemod       != null) genemod       = System.Text.Json.JsonSerializer.Deserialize<GenemodData>(json);
            else if (pharma        != null) pharma        = System.Text.Json.JsonSerializer.Deserialize<PharmaceuticalData>(json);
            else if (material      != null) material      = System.Text.Json.JsonSerializer.Deserialize<MaterialData>(json);
            else if (transport     != null) transport     = System.Text.Json.JsonSerializer.Deserialize<TransportationData>(json);
            else if (automaton     != null) automaton     = System.Text.Json.JsonSerializer.Deserialize<AutomatonData>(json);
            else if (archetype     != null) archetype     = System.Text.Json.JsonSerializer.Deserialize<ArchetypeData>(json);
            else if (subsidiary    != null) subsidiary    = System.Text.Json.JsonSerializer.Deserialize<SubsidiaryData>(json);
            else if (entertainment != null) entertainment = System.Text.Json.JsonSerializer.Deserialize<EntertainmentData>(json);
            else if (consumerGood  != null) consumerGood  = System.Text.Json.JsonSerializer.Deserialize<ConsumerGoodData>(json);
            else if (quote         != null) quote         = System.Text.Json.JsonSerializer.Deserialize<QuoteData>(json);
            else if (news          != null) news          = System.Text.Json.JsonSerializer.Deserialize<NewsData>(json);
            else if (contract      != null) contract      = System.Text.Json.JsonSerializer.Deserialize<ContractData>(json);
            else if (document      != null) document      = System.Text.Json.JsonSerializer.Deserialize<WorldbuildingDocument>(json);
        }
        catch { /* if deserialization fails, leave entity as-edited */ }
    }

    // ── Export JSON ──
    private bool exporting;
    private string exportMode = "";   // "shallow" | "deep" — drives which spinner shows
    private string? exportStatus;
    private bool exportSuccess;

    private Task ExportEntityJson() => DoExport(deep: false);
    private Task ExportEntityDeep() => DoExport(deep: true);

    private async Task DoExport(bool deep)
    {
        if (string.IsNullOrWhiteSpace(resolvedId)) return;
        if (!Guid.TryParse(resolvedId, out var id) &&
            !(resolvedId.Length == 32 && Guid.TryParseExact(resolvedId, "N", out id)))
        {
            exportStatus = "Bad entity id."; exportSuccess = false;
            return;
        }
        exporting = true; exportMode = deep ? "deep" : "shallow"; exportStatus = null;
        StateHasChanged();
        try
        {
            var result = deep
                ? await CanonExport.ExportEntityDeepAsync(id)
                : await CanonExport.ExportEntityAsync(id);
            exportSuccess = true;
            exportStatus = deep
                ? $"Saved {result.EntryCount} record(s) to {result.Path}"
                : $"Saved to {result.Path}";
            Toast.Success("EXPORT-001", $"Entity {resolvedName} → {result.Path}");
        }
        catch (Exception ex)
        {
            exportSuccess = false;
            exportStatus = ex.Message;
            Toast.Error("EXPORT-002", $"{resolvedName}: {ex.Message}");
        }
        finally
        {
            exporting = false;
            exportMode = "";
            StateHasChanged();
        }
    }

