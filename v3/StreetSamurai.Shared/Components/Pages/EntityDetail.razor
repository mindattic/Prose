@page "/entity/{EntityId}"
@using StreetSamurai.Core.Services
@using StreetSamurai.Core.Interfaces
@inject IWriteAccessProvider Access
@inject CharacterRepository CharRepo
@inject SyntheticLifeRepository SynthRepo
@inject DistrictRepository PlaceRepo
@inject FactionRepository FactionRepo
@inject CorponationRepository CorpRepo
@inject TechnologyRepository TechRepo
@inject WeaponryRepository WeaponRepo
@inject EquipmentRepository EquipRepo
@inject CyberwareRepository CyberRepo
@inject VocabularyRepository VocabRepo
@inject XrefService Xref
@inject GlobalSearchService GlobalSearch
@inject NavigationManager Nav
@inject AmmunitionRepository AmmoRepo
@inject ApparelRepository ApparelRepo
@inject GenemodRepository GenemodRepo
@inject PharmaceuticalRepository PharmaRepo
@inject MaterialRepository MaterialRepo
@inject TransportationRepository TransportRepo
@inject AutomatonRepository AutomatonRepo
@inject ArchetypeRepository ArchetypeRepo
@inject SubsidiaryRepository SubsidiaryRepo
@inject EntertainmentRepository EntertainRepo
@inject ConsumerGoodRepository ConsumerRepo
@inject QuoteRepository QuoteRepo
@inject NewsRepository NewsRepo
@inject ContractRepository ContractRepo
@inject WorldbuildingDocRepository DocRepo
@inject MediaService Media
@inject DallEService Dalle
@inject IChapterRepository Chapters
@inject CanonExportService CanonExport
@inject ToastNotifier Toast
@inject IJSRuntime JS

<div class="entity-detail-page">

@if (notFound)
{
    <div class="text-muted p-4">Entity not found: <code>@EntityId</code></div>
}
else if (character != null)
{
    @* Character gets one tab per connected child table + Dossier last. Global Edit/Save/Cancel sits at the right. *@
    <div class="d-flex justify-content-between align-items-center mb-2">
        <ul class="nav nav-tabs small entity-tabs flex-grow-1">
            <li class="nav-item"><a class="nav-link @(CurrentTab == "record"        ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("record")'><i class="bi bi-card-text me-1"></i>Record</a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "relationships" ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("relationships")'><i class="bi bi-people me-1"></i>Relationships <span class="badge bg-secondary">@character.Relationships.Count</span></a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "cyberware"     ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("cyberware")'><i class="bi bi-cpu me-1"></i>Cyberware <span class="badge bg-secondary">@character.CyberwareInventory.Count</span></a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "knowledge"     ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("knowledge")'><i class="bi bi-lightbulb me-1"></i>Knowledge <span class="badge bg-secondary">@character.Knowledge.Count</span></a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "conditions"    ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("conditions")'><i class="bi bi-bandaid me-1"></i>Conditions <span class="badge bg-secondary">@character.Conditions.Count</span></a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "belongings"    ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("belongings")'><i class="bi bi-bag me-1"></i>Belongings</a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "timeline"      ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("timeline")'><i class="bi bi-clock-history me-1"></i>Timeline <span class="badge bg-secondary">@character.Timeline.Count</span></a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "family"        ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("family")'><i class="bi bi-people me-1"></i>Family</a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "dossier"       ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("dossier")'><i class="bi bi-file-earmark-text me-1"></i>Dossier</a></li>
        </ul>
        @GlobalEditControls()
    </div>
}
else if (place != null)
{
    @* Place: Record / Sub-Places / Inhabitants / Events / Dossier. *@
    <div class="d-flex justify-content-between align-items-center mb-2">
        <ul class="nav nav-tabs small entity-tabs flex-grow-1">
            <li class="nav-item"><a class="nav-link @(CurrentTab == "record"      ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("record")'><i class="bi bi-card-text me-1"></i>Record</a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "subplaces"   ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("subplaces")'><i class="bi bi-diagram-3 me-1"></i>Sub-Places <span class="badge bg-secondary">@subPlaces.Count</span></a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "inhabitants" ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("inhabitants")'><i class="bi bi-people me-1"></i>Inhabitants <span class="badge bg-secondary">@inhabitants.Count</span></a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "events"      ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("events")'><i class="bi bi-calendar-event me-1"></i>Events <span class="badge bg-secondary">@placeEvents.Count</span></a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "dossier"     ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("dossier")'><i class="bi bi-file-earmark-text me-1"></i>Dossier</a></li>
        </ul>
        @GlobalEditControls()
    </div>
}
else if (corponation != null)
{
    @* Corponation: Record / Subsidiaries / Personnel / Operations / Dossier. *@
    <div class="d-flex justify-content-between align-items-center mb-2">
        <ul class="nav nav-tabs small entity-tabs flex-grow-1">
            <li class="nav-item"><a class="nav-link @(CurrentTab == "record"        ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("record")'><i class="bi bi-card-text me-1"></i>Record</a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "subsidiaries"  ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("subsidiaries")'><i class="bi bi-diagram-3 me-1"></i>Subsidiaries <span class="badge bg-secondary">@corpSubs.Count</span></a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "personnel"     ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("personnel")'><i class="bi bi-person-badge me-1"></i>Personnel <span class="badge bg-secondary">@corpPersonnel.Count</span></a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "operations"    ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("operations")'><i class="bi bi-briefcase me-1"></i>Operations <span class="badge bg-secondary">@corpOps.Count</span></a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "dossier"       ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("dossier")'><i class="bi bi-file-earmark-text me-1"></i>Dossier</a></li>
        </ul>
        @GlobalEditControls()
    </div>
}
else if (faction != null)
{
    @* Faction: Record / Members / Operations / Dossier. *@
    <div class="d-flex justify-content-between align-items-center mb-2">
        <ul class="nav nav-tabs small entity-tabs flex-grow-1">
            <li class="nav-item"><a class="nav-link @(CurrentTab == "record"     ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("record")'><i class="bi bi-card-text me-1"></i>Record</a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "members"    ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("members")'><i class="bi bi-person-badge me-1"></i>Members <span class="badge bg-secondary">@factionMembers.Count</span></a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "operations" ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("operations")'><i class="bi bi-briefcase me-1"></i>Operations <span class="badge bg-secondary">@factionOps.Count</span></a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "dossier"    ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("dossier")'><i class="bi bi-file-earmark-text me-1"></i>Dossier</a></li>
        </ul>
        @GlobalEditControls()
    </div>
}
else
{
    @* All other entity types keep the simpler Record/Dossier pair. *@
    <div class="d-flex justify-content-between align-items-center mb-2">
        <ul class="nav nav-tabs small entity-tabs flex-grow-1">
            <li class="nav-item"><a class="nav-link @(CurrentTab == "record"  ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("record")'><i class="bi bi-card-text me-1"></i>Record</a></li>
            <li class="nav-item"><a class="nav-link @(CurrentTab == "dossier" ? "active" : "")" href="javascript:void(0)" @onclick='() => SwitchTab("dossier")'><i class="bi bi-file-earmark-text me-1"></i>Dossier</a></li>
        </ul>
        @GlobalEditControls()
    </div>
}

@if (!notFound && CurrentTab == "dossier")
{
    <DossierPanel EntityId="@(string.IsNullOrEmpty(resolvedId) ? EntityId : resolvedId)" AsOf="@AsOf" />
    @if (!string.IsNullOrEmpty(resolvedName))
    {
        <SemanticEdgeSuggestions Name="@resolvedName" />
    }
}

@if (!notFound && CurrentTab == "family" && character != null && !string.IsNullOrEmpty(resolvedId))
{
    <FamilyTreeView EntityId="@resolvedId" SubjectName="@resolvedName" />
    <FamilyPanel    EntityId="@resolvedId" />
}

@* ── Place tab bodies ── *@
@if (place != null && CurrentTab == "subplaces")     { <RelatedRowsList Title="Sub-Places"  Rows="subPlaces" /> }
@if (place != null && CurrentTab == "inhabitants")   { <RelatedRowsList Title="Inhabitants" Rows="inhabitants" /> }
@if (place != null && CurrentTab == "events")        { <RelatedRowsList Title="Events"      Rows="placeEvents" /> }

@* ── Corponation tab bodies ── *@
@if (corponation != null && CurrentTab == "subsidiaries") { <RelatedRowsList Title="Subsidiaries" Rows="corpSubs" /> }
@if (corponation != null && CurrentTab == "personnel")    { <RelatedRowsList Title="Personnel"    Rows="corpPersonnel" /> }
@if (corponation != null && CurrentTab == "operations")   { <RelatedRowsList Title="Operations"   Rows="corpOps" /> }

@* ── Faction tab bodies ── *@
@if (faction != null && CurrentTab == "members")      { <RelatedRowsList Title="Members"    Rows="factionMembers" /> }
@if (faction != null && CurrentTab == "operations")   { <RelatedRowsList Title="Operations" Rows="factionOps" /> }

@* ── Character child-collection tabs ── *@
@if (CurrentTab == "relationships" && character != null)
{
    <EntityDetailHeader Name="@character.Name" Type="character" TypeLabel="Character — Relationships" Subtitle="@($"{character.Relationships.Count} known")" BackRoute="/characters" Tags="@character.Tags" />
    <div class="entity-detail-body">
        @if (character.Relationships.Count == 0) { <div class="text-muted small">No relationships recorded.</div> }
        @foreach (var r in character.Relationships)
        {
            <div class="card bg-dark border-secondary mb-2">
                <div class="card-body p-2 small">
                    <div><strong><XrefText Text="@r.Name" /></strong> <span class="text-muted">— @r.Type</span> @if (!string.IsNullOrWhiteSpace(r.Status) && r.Status != "active") { <span class="badge bg-info">@r.Status</span> }</div>
                    @if (!string.IsNullOrWhiteSpace(r.Description))   { <div class="text-muted mt-1"><XrefText Text="@r.Description" /></div> }
                    @if (!string.IsNullOrWhiteSpace(r.EmotionalCore)) { <div class="text-muted mt-1"><em>core:</em> @r.EmotionalCore</div> }
                    @if (!string.IsNullOrWhiteSpace(r.StoryTension))  { <div class="text-muted mt-1"><em>tension:</em> @r.StoryTension</div> }
                </div>
            </div>
        }
    </div>
}

@if (CurrentTab == "cyberware" && character != null)
{
    <EntityDetailHeader Name="@character.Name" Type="character" TypeLabel="Character — Cyberware" Subtitle="@($"{character.CyberwareInventory.Count} installed")" BackRoute="/characters" Tags="@character.Tags" />
    <div class="entity-detail-body">
        @if (character.CyberwareInventory.Count == 0) { <div class="text-muted small">No installed cyberware.</div> }
        @foreach (var c in character.CyberwareInventory)
        {
            <div class="card bg-dark border-secondary mb-2">
                <div class="card-body p-2 small">
                    <div><strong>@c.Name</strong> @if (!string.IsNullOrEmpty(c.BodyLocation)) { <span class="text-muted">@@@c.BodyLocation</span> } @if (!string.IsNullOrEmpty(c.Manufacturer)) { <span class="text-muted">— @c.Manufacturer</span> }</div>
                    @if (!string.IsNullOrEmpty(c.Tier))         { <div><em>tier:</em> @c.Tier</div> }
                    @if (!string.IsNullOrEmpty(c.Condition))    { <div><em>condition:</em> @c.Condition</div> }
                    @if (!string.IsNullOrEmpty(c.InstalledDate)){ <div><em>installed:</em> @c.InstalledDate</div> }
                    @if (!string.IsNullOrEmpty(c.Description))  { <div class="text-muted mt-1">@c.Description</div> }
                </div>
            </div>
        }
    </div>
}

@if (CurrentTab == "knowledge" && character != null)
{
    <EntityDetailHeader Name="@character.Name" Type="character" TypeLabel="Character — Knowledge" Subtitle="@($"{character.Knowledge.Count} known facts")" BackRoute="/characters" Tags="@character.Tags" />
    <div class="entity-detail-body">
        @if (character.Knowledge.Count == 0) { <div class="text-muted small">No knowledge claims recorded.</div> }
        @foreach (var k in character.Knowledge)
        {
            <div class="card bg-dark border-secondary mb-2">
                <div class="card-body p-2 small">
                    <div><strong>@k.Topic</strong> @if (k.LearnedChapter.HasValue) { <span class="badge bg-secondary">Ch @k.LearnedChapter</span> }</div>
                    @if (!string.IsNullOrEmpty(k.Summary))       { <div class="text-muted mt-1">@k.Summary</div> }
                    @if (!string.IsNullOrEmpty(k.SourceSnippet)) { <div class="text-muted mt-1"><em>"@k.SourceSnippet"</em></div> }
                </div>
            </div>
        }
    </div>
}

@if (CurrentTab == "conditions" && character != null)
{
    <EntityDetailHeader Name="@character.Name" Type="character" TypeLabel="Character — Conditions" Subtitle="@($"{character.Conditions.Count} active")" BackRoute="/characters" Tags="@character.Tags" />
    <div class="entity-detail-body">
        @if (character.Conditions.Count == 0) { <div class="text-muted small">No conditions recorded.</div> }
        @foreach (var c in character.Conditions)
        {
            <div class="card bg-dark border-secondary mb-2">
                <div class="card-body p-2 small">
                    <div><span class="badge bg-warning text-dark">@c.Kind</span> <strong>@c.Name</strong> @if (!string.IsNullOrEmpty(c.Severity)) { <span class="text-muted">— @c.Severity</span> }</div>
                    @if (!string.IsNullOrEmpty(c.Notes))    { <div class="text-muted mt-1">@c.Notes</div> }
                    @if (c.SinceChapter.HasValue || c.UntilChapter.HasValue)
                    {
                        <div class="text-muted mt-1">
                            @if (c.SinceChapter.HasValue) { <text>since Ch @c.SinceChapter</text> }
                            @if (c.UntilChapter.HasValue) { <text> until Ch @c.UntilChapter</text> }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@if (CurrentTab == "belongings" && character != null)
{
    <EntityDetailHeader Name="@character.Name" Type="character" TypeLabel="Character — Belongings" Subtitle="What they carry / own / use" BackRoute="/characters" Tags="@character.Tags" />
    <div class="entity-detail-body">
        @{ var b = character.Belongings; }
        <div class="row g-2 small">
            @if (!string.IsNullOrEmpty(b.PrimaryWeapon))   { <div class="col-md-6"><span class="text-muted">primary weapon:</span> <XrefText Text="@b.PrimaryWeapon" /></div> }
            @if (!string.IsNullOrEmpty(b.SecondaryWeapon)) { <div class="col-md-6"><span class="text-muted">secondary weapon:</span> <XrefText Text="@b.SecondaryWeapon" /></div> }
            @if (!string.IsNullOrEmpty(b.Armor))           { <div class="col-md-6"><span class="text-muted">armor:</span> <XrefText Text="@b.Armor" /></div> }
            @if (!string.IsNullOrEmpty(b.Vehicle))         { <div class="col-md-6"><span class="text-muted">vehicle:</span> <XrefText Text="@b.Vehicle" /></div> }
            @if (!string.IsNullOrEmpty(b.Residence))       { <div class="col-md-6"><span class="text-muted">residence:</span> <XrefText Text="@b.Residence" /></div> }
            @if (!string.IsNullOrEmpty(b.ClothingStyle))   { <div class="col-md-6"><span class="text-muted">clothing:</span> @b.ClothingStyle</div> }
            @if (!string.IsNullOrEmpty(b.FavoriteDrink))   { <div class="col-md-6"><span class="text-muted">drinks:</span> <XrefText Text="@b.FavoriteDrink" /></div> }
            @if (!string.IsNullOrEmpty(b.FavoriteFood))    { <div class="col-md-6"><span class="text-muted">eats:</span> <XrefText Text="@b.FavoriteFood" /></div> }
            @if (!string.IsNullOrEmpty(b.Stimulant))       { <div class="col-md-6"><span class="text-muted">stimulant:</span> <XrefText Text="@b.Stimulant" /></div> }
            @if (!string.IsNullOrEmpty(b.CommDevice))      { <div class="col-md-6"><span class="text-muted">comm:</span> <XrefText Text="@b.CommDevice" /></div> }
        </div>
        @if (b.SignatureGear.Count > 0)
        {
            <div class="mt-3"><div class="entity-section-label">Signature Gear</div>
                <ul>@foreach (var g in b.SignatureGear) { <li><XrefText Text="@g" /></li> }</ul>
            </div>
        }
        @if (b.Pharmaceuticals.Count > 0)
        {
            <div class="mt-3"><div class="entity-section-label">Pharmaceuticals</div>
                <ul>@foreach (var p in b.Pharmaceuticals) { <li><XrefText Text="@p" /></li> }</ul>
            </div>
        }
    </div>
}

@if (CurrentTab == "timeline" && character != null)
{
    <EntityDetailHeader Name="@character.Name" Type="character" TypeLabel="Character — Timeline" Subtitle="@($"{character.Timeline.Count} events")" BackRoute="/characters" Tags="@character.Tags" />
    <div class="entity-detail-body">
        @if (character.Timeline.Count == 0) { <div class="text-muted small">No timeline events recorded.</div> }
        @foreach (var t in character.Timeline.OrderBy(x => x.Date))
        {
            <div class="card bg-dark border-secondary mb-2">
                <div class="card-body p-2 small">
                    <div><span class="badge bg-info">@t.Date</span> @t.Event</div>
                    @if (!string.IsNullOrEmpty(t.Consequences)) { <div class="text-muted mt-1"><em>consequences:</em> @t.Consequences</div> }
                    @if (!string.IsNullOrEmpty(t.StatusChange)) { <div class="text-muted mt-1"><em>status change:</em> @t.StatusChange</div> }
                    @if (t.BodyChanges.Count > 0) { <div class="text-muted mt-1"><em>body:</em> @string.Join(", ", t.BodyChanges)</div> }
                </div>
            </div>
        }
    </div>
}

@if (!notFound && CurrentTab == "record" && character != null)
{
    <EntityDetailHeader Name="@character.Name" Type="character" TypeLabel="Character"
                        Subtitle="@character.Role" BackRoute="/characters"
                        Tags="@character.Tags" />
    @if (editMode && !string.IsNullOrEmpty(editError))
    {
        <div class="alert alert-danger small">Save failed: @editError</div>
    }
    <div class="entity-detail-body">
        @if (editMode)
        {
            @* ── Edit mode: every top-level Character field is a form input. ── *@
            <div class="row g-2 mb-3 small">
                <div class="col-md-6"><label class="text-muted">Name</label>
                    <input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="character.Name" /></div>
                <div class="col-md-6"><label class="text-muted">Role</label>
                    <input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="character.Role" /></div>
                <div class="col-md-3"><label class="text-muted">Species</label>
                    <input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="character.Species" /></div>
                <div class="col-md-3"><label class="text-muted">Gender</label>
                    <input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="character.Gender" /></div>
                <div class="col-md-3"><label class="text-muted">Pronouns</label>
                    <input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="character.Pronouns" /></div>
                <div class="col-md-3"><label class="text-muted">Age</label>
                    <input type="number" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="character.Age" /></div>
                <div class="col-md-4"><label class="text-muted">Status</label>
                    <input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="character.Status" /></div>
                <div class="col-md-8"><label class="text-muted">Location</label>
                    <input class="form-control form-control-sm bg-dark text-light border-secondary" @bind="character.Location" /></div>
                <div class="col-12"><label class="text-muted">Affiliation</label>
                    <textarea class="form-control form-control-sm bg-dark text-light border-secondary" rows="2" @bind="character.Affiliation"></textarea></div>
                <div class="col-12"><label class="text-muted">Description</label>
                    <textarea class="form-control form-control-sm bg-dark text-light border-secondary" rows="6" @bind="character.Description"></textarea></div>
                <div class="col-12"><label class="text-muted">Augmentations</label>
                    <textarea class="form-control form-control-sm bg-dark text-light border-secondary" rows="3" @bind="character.Augmentations"></textarea></div>
                <div class="col-12"><label class="text-muted">Narrative Function</label>
                    <textarea class="form-control form-control-sm bg-dark text-light border-secondary" rows="3" @bind="character.NarrativeFunction"></textarea></div>
                <div class="col-12"><label class="text-muted">Narration Voice</label>
                    <textarea class="form-control form-control-sm bg-dark text-light border-secondary" rows="3" @bind="character.NarrationVoice"></textarea></div>
                <div class="col-12"><label class="text-muted">Daily Life</label>
                    <textarea class="form-control form-control-sm bg-dark text-light border-secondary" rows="3" @bind="character.DailyLife"></textarea></div>
                <div class="col-12"><label class="text-muted">Tags (comma-separated)</label>
                    <input class="form-control form-control-sm bg-dark text-light border-secondary"
                           value="@string.Join(", ", character.Tags)"
                           @onchange="@((ChangeEventArgs e) => character.Tags = (e.Value?.ToString() ?? "").Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList())" /></div>
            </div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(character.Description))
            {
                <div class="entity-section">
                    <div class="entity-section-label">Description</div>
                    @if (primaryImage != null)
                    {
                        <div class="entity-desc-with-portrait">
                            <div><XrefText Text="@character.Description" Paragraphs="true" /></div>
                            <img src="/api/media/@primaryImage" class="entity-portrait" alt="@character.Name" />
                        </div>
                    }
                    else
                    {
                        <XrefText Text="@character.Description" Paragraphs="true" />
                    }
                </div>
            }
            <div class="entity-meta-row">
                @if (!string.IsNullOrWhiteSpace(character.Location))
                {
                    <div class="entity-meta-item"><span class="entity-meta-label">Location</span> <XrefText Text="@character.Location" /></div>
                }
                @if (character.Age > 0)
                {
                    <div class="entity-meta-item"><span class="entity-meta-label">Age</span> @character.Age</div>
                }
                @if (!string.IsNullOrWhiteSpace(character.Status))
                {
                    <div class="entity-meta-item"><span class="entity-meta-label">Status</span> @character.Status</div>
                }
