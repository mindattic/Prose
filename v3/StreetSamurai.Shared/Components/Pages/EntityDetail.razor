        <button class="btn btn-sm btn-outline-info" @onclick="ExportEntityJson" disabled="@exporting"
                title="Save this entity's canonical JSON to your Downloads folder">
            @if (exporting && exportMode == "shallow") { <span class="spinner-border spinner-border-sm me-1"></span> }
            else { <i class="bi bi-download me-1"></i> }
            <span>Export JSON</span>
        </button>
        <button class="btn btn-sm btn-outline-warning" @onclick="ExportEntityDeep" disabled="@exporting"
                title="Save this entity plus every cross-repo record it names (weapons, vehicles, factions, …) as a zip">
            @if (exporting && exportMode == "deep") { <span class="spinner-border spinner-border-sm me-1"></span> }
            else { <i class="bi bi-file-zip me-1"></i> }
            <span>Export + refs</span>
        </button>
        @if (!string.IsNullOrEmpty(exportStatus))
        {
            <small class="@(exportSuccess ? "text-success" : "text-danger")">@exportStatus</small>
        }
    </div>
}

