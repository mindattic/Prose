<div class="entity-detail-page">

@if (notFound)
{
    <div class="text-muted p-4">Entity not found: <code>@EntityId</code></div>
}
else if (character != null)
{
    <EntityDetailHeader Name="@character.Name" Type="character" TypeLabel="Character"
                        Subtitle="@character.Role" BackRoute="/characters"
                        Tags="@character.Tags" />
    <div class="entity-detail-body">
        @if (!string.IsNullOrWhiteSpace(character.Description))
        {
            <div class="entity-section">
                <div class="entity-section-label">Description</div>
                <XrefText Text="@character.Description" Paragraphs="true" />
            </div>
        }
        <div class="entity-meta-row">
            @if (!string.IsNullOrWhiteSpace(character.Location))
            {
                <div class="entity-meta-item"><span class="entity-meta-label">Location</span> <XrefText Text="@character.Location" /></div>
            }
            @if (character.Age > 0)
            {
                <div class="entity-meta-item"><span class="entity-meta-label">Age</span> @character.Age</div>
            }
            @if (!string.IsNullOrWhiteSpace(character.Status))
            {
                <div class="entity-meta-item"><span class="entity-meta-label">Status</span> @character.Status</div>
            }
            @if (!string.IsNullOrWhiteSpace(character.Affiliation))
            {
                <div class="entity-meta-item"><span class="entity-meta-label">Affiliation</span> <XrefText Text="@character.Affiliation" /></div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(character.Augmentations))
        {
            <div class="entity-section">
                <div class="entity-section-label">Augmentations</div>
                <XrefText Text="@character.Augmentations" />
            </div>
        }
        @if (character.Relationships.Any())
        {
            <div class="entity-section">
                <div class="entity-section-label">Relationships</div>
                @foreach (var r in character.Relationships)
                {
                    <div class="entity-relationship">
                        <span class="entity-rel-name"><XrefText Text="@r.Name" /></span>
                        <span class="entity-rel-type text-muted">@r.Type</span>
                        @if (!string.IsNullOrWhiteSpace(r.Description))
                        {
                            <div class="entity-rel-desc text-muted"><XrefText Text="@r.Description" /></div>
                        }
                    </div>
                }
            </div>
        }
        @if (character.StoryHooks.Any())
        {
            <div class="entity-section">
                <div class="entity-section-label">Story Hooks</div>
                <ul class="entity-list">
                    @foreach (var h in character.StoryHooks)
                    {
                        <li><XrefText Text="@h" /></li>
                    }
                </ul>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(character.NarrativeFunction))
        {
            <div class="entity-section">
                <div class="entity-section-label">Narrative Function</div>
                <XrefText Text="@character.NarrativeFunction" Paragraphs="true" />
            </div>
        }
    </div>
}
