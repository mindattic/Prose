@page "/characters"
@inject CanonService Canon
@inject WorldGraphService Graph

@if (_selectedYaml != null)
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection">Back</button>
        <h4 class="text-danger mb-0">@_selectedChar?.Name</h4>
        <a href="graph" class="btn btn-sm btn-outline-info ms-auto" title="View in World Graph">
            <i class="bi bi-diagram-3"></i> Graph
        </a>
        <a href="character-editor/@_selectedChar?.Name" class="btn btn-sm btn-outline-warning" title="Edit character">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a href="generate" class="btn btn-sm btn-outline-danger" title="Generate scene with this character">
            <i class="bi bi-lightning"></i> Generate
        </a>
    </div>

    <div class="row g-3">
        <div class="col-md-5">
            <div class="card bg-dark text-light border-secondary">
                <div class="card-header text-muted">Profile</div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(_selectedChar?.Status))
                    {
                        <div class="mb-2"><span class="text-muted">Status:</span> @_selectedChar.Status</div>
                    }
                    @if (!string.IsNullOrEmpty(_selectedChar?.Affiliation))
                    {
                        <div class="mb-2"><span class="text-muted">Affiliation:</span> @_selectedChar.Affiliation</div>
                    }
                    @if (!string.IsNullOrEmpty(_selectedChar?.Augmentation))
                    {
                        <div class="mb-2"><span class="text-muted">Augmentation:</span> @_selectedChar.Augmentation</div>
                    }
                    @if (!string.IsNullOrEmpty(_selectedChar?.Occupation))
                    {
                        <div class="mb-2"><span class="text-muted">Occupation:</span> @_selectedChar.Occupation</div>
                    }
                </div>
            </div>

            @if (HasFacetWeights())
            {
                <div class="card bg-dark text-light border-secondary mt-3">
                    <div class="card-header text-muted">Facet Weights</div>
                    <div class="card-body">
                        <FacetWeightChart Weights="@_selectedChar!.Facets" />
                    </div>
                </div>
            }

            @if (_relationships.Any())
            {
                <div class="card bg-dark text-light border-secondary mt-3">
                    <div class="card-header text-muted">Relationships (@_relationships.Count)</div>
                    <div class="card-body">
                        @foreach (var edge in _relationships)
                        {
                            var other = edge.Source == _nodeId ? edge.Target : edge.Source;
                            var otherNode = Graph.GetNode(other);
                            <div class="border-bottom border-secondary py-1 small">
                                <span class="text-info">@(otherNode?.Name ?? other)</span>
                                <span class="text-muted ms-1">(@edge.RelationType)</span>
                                @if (!string.IsNullOrEmpty(edge.Description))
                                {
                                    <div class="text-muted ms-2">@Truncate(edge.Description, 100)</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="col-md-7">
            <div class="card bg-dark text-light border-secondary">
                <div class="card-header text-muted d-flex justify-content-between">
                    <span>Raw YAML</span>
                    <small class="text-muted">@_selectedChar?.SourceFile</small>
                </div>
                <div class="card-body" style="max-height: 70vh; overflow-y: auto;">
                    <pre style="white-space: pre-wrap; font-size: 0.8rem; color: #ddd;">@_selectedYaml</pre>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <h4 class="text-danger mb-1">Characters (@_characters.Count)</h4>
    <p class="text-muted mb-3">Character profiles loaded from YAML. Each has facet weights, relationships, and voice notes that drive the story engine.</p>

    <div class="table-responsive">
        <table class="table table-dark table-hover table-sm">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Status</th>
                    <th>Affiliation</th>
                    <th>Source</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _characters)
                {
                    <tr @onclick="() => Select(c)" style="cursor: pointer;">
                        <td class="fw-bold">@c.Name</td>
                        <td class="text-muted small">@c.Status</td>
                        <td class="text-muted small">@Truncate(c.Affiliation, 40)</td>
                        <td class="text-muted small">@c.SourceFile</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Character> _characters = [];
    private Character? _selectedChar;
    private string? _selectedYaml;
    private string _nodeId = "";
    private List<WorldEdge> _relationships = [];

    protected override void OnInitialized()
    {
        _characters = Canon.ListCharacters();
        Graph.EnsureLoaded();
    }

    private void Select(Character c)
    {
        _selectedChar = c;
        _selectedYaml = Canon.ReadCharacterJson(c.Name);
        _nodeId = WorldGraphService.Slugify(c.Name);
        _relationships = Graph.GetAllEdges(_nodeId);
    }

    private void ClearSelection()
    {
        _selectedChar = null;
        _selectedYaml = null;
        _relationships = [];
    }

    private bool HasFacetWeights() =>
        _selectedChar?.Facets != null &&
        (_selectedChar.Facets.Wound > 0 || _selectedChar.Facets.Ideal > 0);

    private static string Truncate(string s, int max) =>
        s.Length > max ? s[..(max - 3)] + "..." : s;
}
