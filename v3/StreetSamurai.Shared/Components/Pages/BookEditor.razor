@page "/books/{BookId}"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@inject NavigationManager Nav

@code {
    [Parameter] public string BookId { get; set; } = "";

    protected override void OnInitialized()
    {
        // The /books/{id}/chapters route was retired in favor of opening the
        // book directly in /write — chapters are already listed in the Write
        // editor's left sidebar. Redirect old bookmarks so they still land.
        Nav.NavigateTo($"/write/{BookId}", replace: true);
    }
}
