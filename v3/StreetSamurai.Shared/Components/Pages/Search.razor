@page "/search"
@inject LoreService Canon

<h4 class="text-danger mb-1">Search Canon</h4>
<p class="text-muted mb-3">Full-text search across all worldbuilding documents — markdown, YAML, everything in the canon vault.</p>

<div class="input-group mb-4" style="max-width: 600px;">
    <input type="text" class="form-control bg-dark text-light border-secondary"
           placeholder="Search across all worldbuilding files..."
           title="Searches all markdown and YAML files in the worldbuilding directory. Press Enter to search."
           @bind="query" @bind:event="oninput"
           @onkeydown="HandleKey" />
    <button class="btn btn-outline-danger" @onclick="DoSearch">Search</button>
</div>

@if (results.Any())
{
    <p class="text-muted small">@results.Count results for "@query"</p>

    @foreach (var r in results)
    {
        <div class="card bg-dark text-light border-secondary mb-2">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between">
                    <span class="text-info small">@r.FileName:@r.LineNumber</span>
                    @if (!string.IsNullOrEmpty(r.Heading))
                    {
                        <span class="text-muted small">@r.Heading</span>
                    }
                </div>
                <pre class="mb-0 mt-1 small" style="white-space: pre-wrap; color: #ccc;">@r.Context</pre>
            </div>
        </div>
    }
}
else if (searched)
{
    <p class="text-muted">No results found.</p>
}

@code {
    private string query = "";
    private List<SearchResult> results = [];
    private bool searched;

    private void DoSearch()
    {
        if (!string.IsNullOrWhiteSpace(query))
        {
            results = Canon.Search(query, 20);
            searched = true;
        }
    }

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") DoSearch();
    }
}
