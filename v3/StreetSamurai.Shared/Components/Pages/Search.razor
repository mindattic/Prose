@page "/search"
@inject GlobalSearchService SearchSvc
@inject NavigationManager Nav

@{
    var heading = !string.IsNullOrWhiteSpace(activeTag)
        ? $"Tag: {activeTag}"
        : !string.IsNullOrWhiteSpace(activeQuery)
            ? $"Results for \"{activeQuery}\""
            : "Search";
}

<div class="d-flex align-items-baseline gap-3 mb-3">
    <h4 class="text-danger mb-0">@heading</h4>
    @if (totalCount > 0)
    {
        <span class="text-muted small">@totalCount result@(totalCount != 1 ? "s" : "")</span>
    }
    @if (loadingTier2)
    {
        <span class="text-muted small">loading more…</span>
    }
</div>

@if (results.Count > 0)
{
    <div class="search-results">
        @for (int i = 0; i < results.Count; i++)
        {
            var r = results[i];
            @if (i == tier1Count && tier2Count > 0)
            {
                <div class="search-tier-divider text-muted small text-center my-2">— description matches —</div>
            }
            <a href="@r.Route" class="search-result-card text-decoration-none d-block mb-2">
                <div class="card bg-dark text-light border-secondary">
                    <div class="card-body py-2 px-3">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge @TypeBadge(r.Type)">@r.Type</span>
                            <span class="fw-bold text-light">@r.Name</span>
                            @if (!string.IsNullOrWhiteSpace(r.Subtitle))
                            {
                                <span class="text-muted small">— @r.Subtitle</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(r.Snippet))
                        {
                            <div class="text-muted small search-snippet">@r.Snippet</div>
                        }
                        @if (r.Tags.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-1 mt-1">
                                @foreach (var tag in r.Tags.Take(6))
                                {
                                    var t = tag;
                                    <a href="/search?tag=@Uri.EscapeDataString(t)"
                                       class="search-tag-pill text-decoration-none"
                                       @onclick:stopPropagation="true">@t</a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </a>
        }
    </div>
}
else if (searched && !loadingTier2)
{
    <p class="text-muted">No results found.</p>
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "tag")] public string? Tag { get; set; }

    private string activeQuery = "";
    private string activeTag = "";
    private List<CanonSearchResult> results = [];
    private int totalCount;
    private int tier1Count;
    private int tier2Count;
    private bool searched;
    private bool loadingTier2;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Tag))
        {
            activeTag = Tag;
            activeQuery = "";
            DoTagSearch();
        }
        else if (!string.IsNullOrWhiteSpace(Q))
        {
            activeQuery = Q;
            activeTag = "";
            _ = RunSearchTiered();
        }
        else
        {
            results = [];
            searched = false;
            tier1Count = 0;
            tier2Count = 0;
        }
    }

    private async Task RunSearchTiered()
    {
        searched = true;
        loadingTier2 = false;
        var (t1, t2) = SearchSvc.SearchTiered(activeQuery);
        tier1Count = t1.Count;
        tier2Count = t2.Count;
        totalCount = t1.Count + t2.Count;
        results = t1;
        StateHasChanged();

        if (t2.Count > 0)
        {
            loadingTier2 = true;
            StateHasChanged();
            await Task.Delay(80);
            results = [..t1, ..t2];
            loadingTier2 = false;
            StateHasChanged();
        }
    }

    private void DoTagSearch()
    {
        totalCount = SearchSvc.SearchByTagCount(activeTag);
        results = SearchSvc.SearchByTag(activeTag, 1, 100);
        tier1Count = results.Count;
        tier2Count = 0;
        searched = true;
        loadingTier2 = false;
    }

    private static string TypeBadge(string type) => Constants.TypeBadge.For(type);
}
