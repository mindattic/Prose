    // ── Audio ──

    private async Task ReadSelected()
    {
        _showContextMenu = false;
        if (_narrating) return;
        try
        {
            var surfaceId = _viewMode == "editor" ? "story-surface" : "story-surface-raw";
            var sel = await JS.InvokeAsync<SelectionInfo>("writeInterop.getSelection", surfaceId);
            if (sel != null && !string.IsNullOrWhiteSpace(sel.Text))
                await NarrateText(sel.Text);
        }
        catch { }
    }

    private async Task ReadAll()
    {
        _showContextMenu = false;
        if (_narrating || !_hasExistingText) return;
        await NarrateText(_storyText);
    }

    private async Task NarrateText(string text)
    {
        _narrating = true;
        _audioPlayer?.SetLoading(true);
        StateHasChanged();
        try
        {
            // Convert custom tags to ElevenLabs-compatible format
            var ttsText = ConvertTagsForTts(text);

            byte[] audio;
            if (_ttsEngine == "elevenlabs" && await TtsSvc.IsConfiguredAsync())
                audio = await TtsSvc.SynthesizeAsync(ttsText);
            else
                audio = await DraftTts.SynthesizeAsync(ttsText);
            if (_audioPlayer != null) await _audioPlayer.LoadAudioAsync(audio);
        }
        catch (Exception ex) { _audioPlayer?.SetError(ex.Message); }
        finally { _narrating = false; }
    }

    // ── Entity extraction ──

    private async Task RunExtractionAsync()
    {
        if (_extracting || !_hasExistingText) return;
        _extracting = true;
        _graphStatus = "Scanning for entities...";
        await InvokeAsync(StateHasChanged);
        try
        {
            var storyPoint = $"story:{_project.Id}";
            var (entities, relationships) = await EntityExtract.ExtractAndMergeAsync(_storyText, _project.Id, storyPoint);
            _lastExtractedText = _storyText;

            // Auto-detect characters
            var session = new NarrativeSessionContext(Graph);
            session.ScanText(_storyText);
            var detected = session.GetSnapshot().PrimaryEntities
                .Where(e => e.NodeType == "character" && _storyText.Contains(e.Name, StringComparison.OrdinalIgnoreCase))
                .Select(e => e.Name);
            foreach (var name in detected)
                if (!_project.Characters.Contains(name, StringComparer.OrdinalIgnoreCase))
                    _project.Characters.Add(name);

            _graphStatus = entities > 0 || relationships > 0
                ? $"Graph: +{entities} entities, +{relationships} relationships"
                : "Graph up to date";
        }
        catch (Exception ex) { _graphStatus = $"Extraction failed: {ex.Message}"; }
        finally
        {
            _extracting = false;
            await InvokeAsync(StateHasChanged);
            _ = Task.Delay(5000).ContinueWith(_ => InvokeAsync(() => { _graphStatus = null; StateHasChanged(); }));
        }
    }

    // ── Cleanup ──

    public void Dispose()
    {
        if (_dirty) { _project.Html = _richHtml; Repo.SaveProject(_project); }
        _saveTimer?.Dispose();
        _editorRef?.Dispose();
        _miniGraphRef?.Dispose();
    }

    // ── Helpers ──

    private static string GetTypeBadgeClass(string type) => type switch
    {
        "character" => "bg-info", "organization" => "bg-warning text-dark", "place" => "bg-success",
        "faction" => "bg-purple", "weapon" => "bg-danger", "equipment" => "bg-primary",
        "technology" => "bg-cyan", _ => "bg-secondary",
    };

    private static string GetTypeColor(string type) => type switch
    {
        "character" => "#17a2b8", "organization" => "#ffc107", "place" => "#28a745",
        "faction" => "#6f42c1", "weapon" => "#dc3545", "equipment" => "#0d6efd",
        "technology" => "#0dcaf0", _ => "#6c757d",
    };

    /// <summary>
    /// Convert custom {pause:N}, {emotion:X} tags to ElevenLabs-compatible format.
    /// ElevenLabs v3 understands [whispers], [sighs], [long pause], [short pause],
    /// ellipses for pauses, and CAPITALS for emphasis.
    /// </summary>
    // Tags ElevenLabs v3 reliably interprets as vocal directions (not read aloud)
    private static readonly HashSet<string> SafeTtsTags = new(StringComparer.OrdinalIgnoreCase)
    {
        "whispers", "sighs", "laughs", "laughs harder", "chuckles",
        "clears throat", "exhales", "exhales sharply", "inhales deeply",
        "short pause", "long pause", "snorts", "gulps",
    };

    private static string ConvertTagsForTts(string text)
    {
        // Strip HTML tags
        text = System.Text.RegularExpressions.Regex.Replace(text, "<[^>]+>", " ");

        // Convert legacy {brace} tags to [bracket] equivalents
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\{pause:\d+\}", "[long pause]");
        text = text.Replace("{emotion:whisper}", "[whispers]");
        text = text.Replace("{emotion:sad}", "[sighs]");
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\{[a-z]+:[^}]+\}", "");

        // Only keep [bracket] tags that ElevenLabs actually understands — strip all others
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\[([^\]]+)\]", match =>
        {
            var tag = match.Groups[1].Value.Trim();
            return SafeTtsTags.Contains(tag) ? match.Value : "";
        });

        // Clean up
        text = System.Text.RegularExpressions.Regex.Replace(text, @"  +", " ");
        return text.Trim();
    }

