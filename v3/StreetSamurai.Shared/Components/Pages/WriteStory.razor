@page "/write"
@page "/write/{ProjectId}"
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@inject StoryStarterService Starter
@inject IStoryBlockRepository Repo
@inject NavigationManager Nav
@inject ElevenLabsTtsService TtsSvc
@inject WindowsTtsService DraftTts
@inject EntityExtractionService EntityExtract
@inject ILlmService Llm
@inject DatabaseService CanonDb
@inject WorldGraphService Graph
@inject IPathProvider Paths
@inject ValidationService Validator
@inject MarkdownService Markdown
@inject ExportService Export
@inject IJSRuntime JS
@implements IDisposable

@* ── Title + Save ─────────────────────────────────────── *@
<div class="d-flex align-items-center gap-2 mb-2" style="height: 32px;">
    <input type="text" class="form-control form-control-sm bg-dark text-danger border-secondary fw-bold fst-italic flex-grow-1"
           style="font-family: Georgia, serif; font-size: 1rem; height: 32px;"
           placeholder="Untitled"
           @bind="_project.Title"
           @bind:after="Save" />
    <button class="btn btn-sm btn-danger text-nowrap" style="height: 32px;" @onclick="ForceSave">
        <i class="bi bi-floppy"></i> Save
    </button>
</div>

@* ── Ask Modal ───────────────────────────────────────── *@
@if (_showAskModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="() => _showAskModal = false">
        <div class="card bg-dark text-light border-info" style="width: 650px; max-height: 85vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-info fw-bold"><i class="bi bi-chat-dots"></i> Ask</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showAskModal = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <select class="form-select form-select-sm bg-dark text-light border-secondary" style="width: auto;" @bind="_askScope">
                        <option value="story">This Story</option>
                        <option value="series">All Stories (Series)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <textarea class="form-control bg-dark text-light border-secondary" rows="3"
                              placeholder="Ask a question about the world, characters, story..."
                              @bind="_commandText" @onkeydown="HandleAskKeyDown"
                              style="font-family: Georgia, serif;"></textarea>
                </div>
                @if (_busy)
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="spinner-border spinner-border-sm text-info"></div>
                        <small class="text-muted">@_statusMessage</small>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_commandResult))
                {
                    <div class="mb-3 bg-black rounded p-3 small" style="white-space: pre-wrap; max-height: 400px; overflow-y: auto;">@_commandResult</div>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CloseAsk">Close</button>
                }
                else if (!_busy)
                {
                    <button class="btn btn-sm btn-info text-dark" @onclick="ExecuteAsk"><i class="bi bi-send"></i> Ask</button>
                }
            </div>
        </div>
    </div>
}

@* ── Write Modal ─────────────────────────────────────── *@
@if (_showWriteModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="() => _showWriteModal = false">
        <div class="card bg-dark text-light border-danger" style="width: 650px; max-height: 85vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-danger fw-bold"><i class="bi bi-pen"></i> Write</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showWriteModal = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <textarea class="form-control bg-dark text-light border-secondary" rows="3"
                              placeholder="What should happen next? Describe the scene, direction, or premise..."
                              @bind="_writeText" @onkeydown="HandleWriteKeyDown"
                              style="font-family: Georgia, serif;"></textarea>
                </div>
                @if (_busy)
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="spinner-border spinner-border-sm text-danger"></div>
                        <small class="text-muted">@_statusMessage</small>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_writeResult))
                {
                    <div class="mb-3">
                        <textarea class="form-control bg-dark text-light border-secondary" rows="8"
                                  style="font-family: Georgia, serif; font-size: 14px; line-height: 1.7;"
                                  @bind="_writeResult"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-success" @onclick="ApplyWrite"><i class="bi bi-check-lg"></i> Insert</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick='() => _writeResult = ""'>Clear</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showWriteModal = false">Dismiss</button>
                    </div>
                }
                else if (!_busy)
                {
                    <button class="btn btn-sm btn-danger" @onclick="DoWrite"><i class="bi bi-pen"></i> Generate</button>
                }
            </div>
        </div>
    </div>
}

@* ── Formatting Toolbar ────────────────────────────────── *@
@if (_viewMode == "editor")
{
<div class="d-flex gap-1 mb-1 align-items-center" style="overflow-x: auto; white-space: nowrap; padding-top: 3px; padding-bottom: 3px;">
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatBlock("h1")' title="Heading 1" style="font-weight: bold;">H1</button>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatBlock("h2")' title="Heading 2" style="font-weight: bold;">H2</button>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatBlock("h3")' title="Heading 3" style="font-weight: bold;">H3</button>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatBlock("p")' title="Paragraph">P</button>
    <span class="text-secondary mx-1">|</span>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatInline("bold")' title="Bold"><i class="bi bi-type-bold"></i></button>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatInline("italic")' title="Italic"><i class="bi bi-type-italic"></i></button>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatInline("underline")' title="Underline"><i class="bi bi-type-underline"></i></button>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatInline("strikethrough")' title="Strikethrough"><i class="bi bi-type-strikethrough"></i></button>
    <span class="text-secondary mx-1">|</span>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatList("unordered")' title="Bullet list"><i class="bi bi-list-ul"></i></button>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatList("ordered")' title="Numbered list"><i class="bi bi-list-ol"></i></button>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatBlock("blockquote")' title="Quote"><i class="bi bi-quote"></i></button>
    <button class="btn btn-outline-secondary tb" @onclick="InsertHorizontalRule" title="Scene break"><i class="bi bi-dash-lg"></i></button>
    <button class="btn btn-outline-secondary tb" @onclick="() => _showImageInsert = !_showImageInsert" title="Insert image"><i class="bi bi-image"></i></button>
    <span class="text-secondary mx-1">|</span>
    <button class="btn @(_showSceneSidebar ? "btn-outline-danger" : "btn-outline-secondary") tb" @onclick="() => _showSceneSidebar = !_showSceneSidebar" title="Scene sidebar"><i class="bi bi-diagram-3"></i></button>
    <div class="dropdown d-inline-block">
        <button class="btn btn-outline-secondary tb dropdown-toggle" type="button" data-bs-toggle="dropdown" title="Export">
            <i class="bi bi-download"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-dark">
            <li><button class="dropdown-item" @onclick="ExportAsTxt"><i class="bi bi-file-text me-2"></i>Plain Text (.txt)</button></li>
            <li><button class="dropdown-item" @onclick="ExportAsMd"><i class="bi bi-markdown me-2"></i>Markdown (.md)</button></li>
            <li><button class="dropdown-item" @onclick="ExportAsPdf"><i class="bi bi-file-pdf me-2"></i>PDF (Print)</button></li>
            <li><hr class="dropdown-divider"></li>
            <li><button class="dropdown-item @(_narrating || !_ttsAvailable ? "disabled" : "")" @onclick="ExportAsMp3"><i class="bi bi-file-music me-2"></i>MP3 (Narration)</button></li>
            <li><button class="dropdown-item @(_narrating || !_ttsAvailable ? "disabled" : "")" @onclick="ExportAsOgg"><i class="bi bi-file-music me-2"></i>OGG (Narration)</button></li>
        </ul>
    </div>
</div>
}

<div class="row g-2">
    <div class="@(_showSceneSidebar ? "col-md-8" : "col-12")">
        @if (_viewMode == "editor")
        {
            <div id="story-surface" class="form-control bg-dark text-light border-secondary rich-editor"
                 contenteditable="true" style="min-height: calc(100vh - 300px); overflow-y: scroll; overflow-x: hidden;"
                 @onclick="() => { _showContextMenu = false; _showImageInsert = false; }"></div>
        }

        @* ── Image Insert Panel ────────────────────────── *@
        @* ── Image Insert Modal ─────────────────────── *@
        @if (_showImageInsert)
        {
            <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
                 style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="() => _showImageInsert = false">
                <div class="card bg-dark text-light border-secondary" style="width: 500px;" @onclick:stopPropagation="true">
                    <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                        <span class="text-muted fw-bold"><i class="bi bi-image"></i> Insert Image</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showImageInsert = false"><i class="bi bi-x-lg"></i></button>
                    </div>
                    <div class="card-body">
                        <textarea class="form-control form-control-sm bg-dark text-light border-secondary mb-2"
                                  placeholder="Paste base64 image data (data:image/png;base64,... or raw base64)"
                                  @bind="_imageBase64" style="font-family: monospace; font-size: 0.7rem; min-height: 80px;"></textarea>
                        <div class="d-flex gap-2 align-items-center mb-2">
                            <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                                   placeholder="Alt text (optional)" @bind="_imageAlt" />
                            <button class="btn btn-sm btn-info text-dark text-nowrap" @onclick="DoInsertImage"
                                    disabled="@string.IsNullOrWhiteSpace(_imageBase64)">
                                <i class="bi bi-image"></i> Insert
                            </button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_imageBase64))
                        {
                            <div class="text-center">
                                <img src="@NormalizeImageSrc(_imageBase64)" alt="@_imageAlt" style="max-width: 100%; max-height: 250px; border-radius: 4px;" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @* ── Right-click context menu ──────────────────── *@
        @if (_showContextMenu)
        {
            <div class="position-fixed bg-dark border border-secondary rounded shadow-lg py-1"
                 style="z-index: 1070; top: @(_ctxMenuTop)px; left: @(_ctxMenuLeft)px; min-width: 160px;">
                <button class="btn btn-sm btn-dark text-light d-block w-100 text-start px-3 py-1" @onclick="ReadSelected" disabled="@(_narrating || !_hasSelection)">
                    <i class="bi bi-volume-up text-info me-2"></i>Read Selected
                </button>
                <button class="btn btn-sm btn-dark text-light d-block w-100 text-start px-3 py-1" @onclick="ReadAll" disabled="@_narrating">
                    <i class="bi bi-megaphone text-info me-2"></i>Read All
                </button>
            </div>
        }
        else if (_viewMode == "preview")
        {
            @if (string.IsNullOrWhiteSpace(_printHtml))
            {
                <div class="text-muted d-flex align-items-center justify-content-center" style="min-height: 40vh;">
                    Nothing to preview — write something first.
                </div>
            }
            else
            {
                <div class="bg-white text-dark p-4 rounded" style="min-height: 60vh; font-family: Georgia, serif; font-size: 16px; line-height: 2; max-width: 700px; margin: 0 auto;">
                    @((MarkupString)_printHtml)
                </div>
            }
        }

        @* ── ElevenLabs Tag Bar (always visible) ───── *@
        <div class="bg-dark border border-secondary rounded mt-1 d-flex align-items-center gap-1 px-3 py-1 flex-wrap" style="font-size: 0.75rem;">
            <small class="text-muted fw-bold me-1">TTS Tags</small>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[short pause]")'>short pause</button>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[long pause]")'>long pause</button>
            <span class="text-secondary mx-1">|</span>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[whispers]")'>whispers</button>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[sighs]")'>sighs</button>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[laughs]")'>laughs</button>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[chuckles]")'>chuckles</button>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[clears throat]")'>clears throat</button>
            <span class="text-secondary mx-1">|</span>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[exhales]")'>exhales</button>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[exhales sharply]")'>sharp exhale</button>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[inhales deeply]")'>deep inhale</button>
        </div>

        @* ── Audio Player ──────────────────────────── *@
        <AudioPlayer @ref="_audioPlayer"
                     Visible="true"
                     OnDismissed="() => {}"
                     OnInsertTag="InsertTag"
                     OnReadSelected="ReadSelected"
                     OnReadAll="ReadAll"
                     HasSelection="_hasSelection"
                     Engine="@_ttsEngine"
                     EngineChanged="e => _ttsEngine = e"
                     ShowTagInserter="false"
                     CssClass="mt-1 rounded border border-secondary" />

        @* ── Bottom bar: view toggle left, Ask/Write right ── *@
        <div class="d-flex align-items-center mt-1">
            <div class="btn-group">
                <button class="btn btn-sm @(_viewMode == "editor" ? "btn-danger" : "btn-outline-secondary")" style="width: 100px;" @onclick='() => SwitchViewMode("editor")'><i class="bi bi-brush"></i> Editor</button>
                <button class="btn btn-sm @(_viewMode == "preview" ? "btn-danger" : "btn-outline-secondary")" style="width: 100px;" @onclick='() => SwitchViewMode("preview")'><i class="bi bi-printer"></i> Preview</button>
            </div>
            <div class="ms-auto d-flex gap-2">
                <button class="btn btn-sm btn-outline-info" @onclick="() => _showAskModal = true" disabled="@_busy">
                    <i class="bi bi-chat-dots"></i> Ask
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => _showWriteModal = true" disabled="@_busy">
                    <i class="bi bi-pen"></i> Write
                </button>
            </div>
        </div>
    </div>

    @if (_showSceneSidebar)
    {
        <div class="col-md-4">
            @* ── Validation Warnings ──────────────────── *@
            @if (_validationIssues.Count > 0)
            {
                <div class="card bg-dark text-light border-warning mb-2">
                    <div class="card-header py-1 text-warning small fw-bold">
                        <i class="bi bi-exclamation-triangle"></i> Canon Issues (@_validationIssues.Count)
                    </div>
                    <div class="card-body py-2 small">
                        @foreach (var issue in _validationIssues)
                        {
                            <div class="d-flex align-items-start gap-1 mb-1">
                                <i class="bi bi-exclamation-circle text-warning" style="margin-top: 2px;"></i>
                                <span>@issue</span>
                            </div>
                        }
                        <button class="btn btn-sm btn-outline-warning mt-1" @onclick="() => _validationIssues.Clear()">Dismiss</button>
                    </div>
                </div>
            }

            @* ── Live Outline ──────────────────────────── *@
            <div class="card bg-dark text-light border-secondary mb-2">
                <div class="card-header py-1 d-flex justify-content-between align-items-center">
                    <small class="text-muted fw-bold">Outline</small>
                    <button class="btn btn-sm btn-outline-info py-0 px-1" @onclick="RefreshOutline" title="Rebuild outline from text">
                        <i class="bi bi-arrow-repeat" style="font-size: 0.7rem;"></i>
                    </button>
                </div>
                <div class="card-body py-1" style="max-height: 40vh; overflow-y: auto;">
                    @if (_outlineSections.Count == 0)
                    {
                        <small class="text-muted">Write some text, then refresh.</small>
                    }
                    @foreach (var sec in _outlineSections)
                    {
                        <div class="mb-2">
                            <div class="fw-bold small text-danger" style="cursor: pointer;" @onclick="() => ScrollToSection(sec.index)">
                                @sec.title
                            </div>
                            @if (sec.characters.Count > 0)
                            {
                                <div class="ms-2">
                                    @foreach (var ch in sec.characters)
                                    {
                                        <span class="badge bg-info me-1 mb-1" style="font-size: 0.6rem; cursor: pointer;" @onclick="() => ShowEntityDetail(ch.id)">@ch.name</span>
                                    }
                                </div>
                            }
                            @if (sec.locations.Count > 0)
                            {
                                <div class="ms-2">
                                    @foreach (var loc in sec.locations)
                                    {
                                        <span class="badge bg-success me-1 mb-1" style="font-size: 0.6rem; cursor: pointer;" @onclick="() => ShowEntityDetail(loc.id)">@loc.name</span>
                                    }
                                </div>
                            }
                            @if (sec.items.Count > 0)
                            {
                                <div class="ms-2">
                                    @foreach (var item in sec.items)
                                    {
                                        <span class="badge @GetTypeBadgeClass(item.nodeType) me-1 mb-1" style="font-size: 0.6rem; cursor: pointer;" @onclick="() => ShowEntityDetail(item.id)">@item.name</span>
                                    }
                                </div>
                            }
                            <small class="text-muted ms-2">@sec.wordCount words</small>
                        </div>
                    }
                    @if (_sceneEntities.Count > 0)
                    {
                        <hr class="border-secondary my-2">
                        <small class="text-muted fw-bold">All Entities (@_sceneEntities.Count)</small>
                        @foreach (var group in _sceneEntities.GroupBy(e => e.nodeType))
                        {
                            <div class="mb-1">
                                <small class="fw-bold" style="color: @GetTypeColor(group.Key);">@group.Key</small>
                                @foreach (var ent in group)
                                {
                                    <span class="badge @GetTypeBadgeClass(group.Key) me-1" style="font-size: 0.55rem; cursor: pointer;" @onclick="() => ShowEntityDetail(ent.id)">@ent.name</span>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            @* ── Entity Detail ─────────────────────────── *@
            @if (_detailNode != null)
            {
                <div class="card bg-dark text-light border-info mb-2">
                    <div class="card-header py-1 d-flex justify-content-between align-items-center">
                        <span>
                            <span class="badge @GetTypeBadgeClass(_detailNode.NodeType) me-1">@_detailNode.NodeType</span>
                            <strong>@_detailNode.Name</strong>
                        </span>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick="() => _detailNode = null"><i class="bi bi-x"></i></button>
                    </div>
                    <div class="card-body py-2 small" style="max-height: 30vh; overflow-y: auto; line-height: 1.4;">
                        @foreach (var key in new[] { "gender", "pronouns", "role", "status", "age", "affiliation", "location", "category", "manufacturer" })
                        {
                            if (_detailNode.Properties.TryGetValue(key, out var val) && val.Length > 0)
                            {
                                <div><span class="text-info">@key:</span> @val</div>
                            }
                        }
                        @if (_detailNode.Properties.TryGetValue("description", out var ddesc) && ddesc.Length > 0)
                        {
                            <div class="text-muted mt-1">@(ddesc.Length > 300 ? ddesc[..297] + "..." : ddesc)</div>
                        }
                        @{ var detailEdges = Graph.GetAllEdges(_detailNode.Id); }
                        @if (detailEdges.Count > 0)
                        {
                            <div class="mt-1"><small class="text-muted fw-bold">Relationships:</small></div>
                            @foreach (var edge in detailEdges.Take(10))
                            {
                                var other = edge.Source == _detailNode.Id ? edge.Target : edge.Source;
                                var otherNode = Graph.GetNode(other);
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge bg-dark border border-secondary" style="font-size: 0.6rem;">@edge.RelationType</span>
                                    <span>@(otherNode?.Name ?? other)</span>
                                </div>
                            }
                        }
                        @if (_detailNode.History.Count > 0)
                        {
                            <div class="mt-1 text-warning"><small class="fw-bold">Timeline:</small></div>
                            @foreach (var h in _detailNode.History.OrderBy(x => x.StoryPoint))
                            {
                                <div>[@h.StoryPoint] @h.Property: @h.OldValue → @h.NewValue</div>
                            }
                        }
                    </div>
                </div>
            }

            @* ── Mini Scene Graph ──────────────────────── *@
            <div class="card bg-dark text-light border-secondary">
                <div class="card-header py-1 d-flex justify-content-between align-items-center">
                    <small class="text-muted fw-bold">Scene Graph</small>
                    <button class="btn btn-sm btn-outline-danger py-0 px-1" @onclick="RenderMiniGraph" title="Render">
                        <i class="bi bi-play" style="font-size: 0.7rem;"></i>
                    </button>
                </div>
                <div id="miniGraphCanvas" style="width: 100%; height: 25vh; background: #111; border-radius: 0 0 4px 4px;"></div>
            </div>
        </div>
    }
</div>

@if (_error != null)
{
    <div class="alert alert-warning mt-2 py-1 small">@_error</div>
}

@if (_graphStatus != null)
{
    <div class="d-flex align-items-center gap-2 mt-1">
        @if (_extracting) { <div class="spinner-border spinner-border-sm text-info" style="width: 0.8rem; height: 0.8rem;"></div> }
        else { <i class="bi bi-diagram-3 text-info" style="font-size: 0.75rem;"></i> }
        <small class="text-muted" style="font-size: 0.7rem;">@_graphStatus</small>
    </div>
}

@code {
    [Parameter] public string? ProjectId { get; set; }

    // ── Core state ──
    private StoryProject _project = new();
    private string _storyText = "";
    private int _wordCount;
    private bool _saved;
    private string? _error;
    private bool _busy;
    private string _statusMessage = "";

    // ── Audio ──
    private bool _ttsAvailable;
    private bool _narrating;
    private bool _hasSelection;
    private AudioPlayer? _audioPlayer;
    private string _ttsEngine = "elevenlabs"; // "elevenlabs" or "windows"


    // ── Bottom dock ──
    private bool _showTagBar;

    // ── Image insert ──
    private bool _showImageInsert;
