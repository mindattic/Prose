    private async Task GenerateMoreAlts()
    {
        generatingAlts = true;
        StateHasChanged();
        try
        {
            var system = $"""
                You are rewriting a passage from a neo-noir story. Generate 5 alternative
                phrasings that preserve the meaning but offer different voice, rhythm, or angle.
                Each should feel like a different author's take on the same moment.

                Story context (surrounding text):
                {storyText[..Math.Min(2000, storyText.Length)]}

                Return ONLY a JSON array of 5 strings. Nothing else.
                """;

            var response = await Llm.GenerateAsync(system, $"Rewrite this: {altOriginalText}", 0.8, 1024);
            try
            {
                var json = response.Trim();
                if (json.StartsWith("```")) json = json[(json.IndexOf('\n') + 1)..];
                if (json.EndsWith("```")) json = json[..^3];
                var newAlts = System.Text.Json.JsonSerializer.Deserialize<List<string>>(json.Trim()) ?? [];
                suggestedAlts.AddRange(newAlts);
            }
            catch { }

            // Vote on all alternatives
            if (suggestedAlts.Count > 0)
            {
                altScores = await Validator.VoteOnFixesAsync(
                    altOriginalText, "", suggestedAlts, "rewrite alternative");
            }
        }
        catch { }
        finally { generatingAlts = false; }
    }

    private async Task ApplyAlternative(string altText)
    {
        richHtml = richHtml.Replace(altOriginalText, altText);
        storyText = storyText.Replace(altOriginalText, altText);
        await JS.InvokeVoidAsync("writeInterop.richEditor.setHtml", "story-surface", richHtml);
        Save();
        showAlternativesModal = false;
    }

    // ── Cleanup ──

    public void Dispose()
    {
        if (dirty) { project.Html = richHtml; Repo.SaveProject(project); }
        saveTimer?.Dispose();
        editorRef?.Dispose();
        miniGraphRef?.Dispose();
    }

