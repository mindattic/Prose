        // Replace story text with the chosen alternative
        richHtml = richHtml.Replace(issue.StoryText, altText);
        storyText = storyText.Replace(issue.StoryText, altText);
        await JS.InvokeVoidAsync("writeInterop.richEditor.setHtml", "story-surface", richHtml);
        Save();
        validationResults.RemoveAt(idx);
        SaveValidationState();
    }

