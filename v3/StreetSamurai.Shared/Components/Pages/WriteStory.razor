    /// <summary>
    /// Convert custom {pause:N}, {emotion:X} tags to ElevenLabs-compatible format.
    /// ElevenLabs v3 understands [whispers], [sighs], [long pause], [short pause],
    /// ellipses for pauses, and CAPITALS for emphasis.
    /// </summary>
    // Tags ElevenLabs v3 reliably interprets as vocal directions (not read aloud)
    private static readonly HashSet<string> SafeTtsTags = new(StringComparer.OrdinalIgnoreCase)
    {
        "whispers", "sighs", "laughs", "laughs harder", "chuckles",
        "clears throat", "exhales", "exhales sharply", "inhales deeply",
        "short pause", "long pause", "snorts", "gulps",
    };

    private static string ConvertTagsForTts(string text)
    {
        // Strip HTML tags
        text = System.Text.RegularExpressions.Regex.Replace(text, "<[^>]+>", " ");

        // Convert legacy {brace} tags to [bracket] equivalents
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\{pause:\d+\}", "[long pause]");
        text = text.Replace("{emotion:whisper}", "[whispers]");
        text = text.Replace("{emotion:sad}", "[sighs]");
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\{[a-z]+:[^}]+\}", "");

        // Only keep [bracket] tags that ElevenLabs actually understands — strip all others
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\[([^\]]+)\]", match =>
        {
            var tag = match.Groups[1].Value.Trim();
            return SafeTtsTags.Contains(tag) ? match.Value : "";
        });

        // Clean up
        text = System.Text.RegularExpressions.Regex.Replace(text, @"  +", " ");
        return text.Trim();
    }

