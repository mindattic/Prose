    private void RefreshOutline()
    {
        if (string.IsNullOrWhiteSpace(_storyText))
        {
            _outlineSections = [];
            _sceneEntities = [];
            return;
        }

        // Split document on scene breaks (====== or <hr>)
        var sections = _storyText.Split(["======"], StringSplitOptions.None)
            .Select(s => s.Trim())
            .Where(s => s.Length > 0)
            .ToList();

        _outlineSections = [];

        for (int i = 0; i < sections.Count; i++)
        {
            var sectionText = sections[i];
            var title = $"Section {i + 1}";
            var wordCount = sectionText.Split((char[])[' ', '\n', '\r', '\t'], StringSplitOptions.RemoveEmptyEntries).Length;

            // Detect entities in this section
            var session = new NarrativeSessionContext(Graph);
            session.ScanText(sectionText);
            var snapshot = session.GetSnapshot();
            var textLower = sectionText.ToLowerInvariant();

            var chars = snapshot.PrimaryEntities
                .Where(e => e.NodeType == "character" && textLower.Contains(e.Name.ToLowerInvariant()))
                .Select(e => (id: Graph.ResolveId(e.Name) ?? "", name: e.Name))
                .DistinctBy(e => e.name).ToList();

            var locs = snapshot.PrimaryEntities
                .Where(e => e.NodeType == "place" && textLower.Contains(e.Name.ToLowerInvariant()))
                .Select(e => (id: Graph.ResolveId(e.Name) ?? "", name: e.Name))
                .DistinctBy(e => e.name).ToList();

            var items = snapshot.PrimaryEntities
                .Where(e => e.NodeType is "weapon" or "equipment" or "technology" && textLower.Contains(e.Name.ToLowerInvariant()))
                .Select(e => (id: Graph.ResolveId(e.Name) ?? "", name: e.Name, nodeType: e.NodeType))
                .DistinctBy(e => e.name).ToList();

            _outlineSections.Add(new OutlineSection(i, title, wordCount, chars, locs, items));
        }

        // Also refresh the flat entity list
        RefreshSceneEntities();

        // Validation
        _validationIssues = Validator.ValidateQuick(_storyText)
            .Select(iss => $"[{iss.Category}] {iss.EntityName}: {iss.Description}").ToList();
    }

    private async Task ScrollToSection(int sectionIndex)
    {
        // In rich mode, scroll to the Nth chapter break in the contenteditable
        // In raw mode, scroll to the Nth ====== delimiter
        // For now, a simple approach: focus the editor and scroll to approximate position
        await FocusEditorEnd(); // TODO: precise section scrolling via JS interop
    }

    private void RefreshSceneEntities()
    {
        if (string.IsNullOrWhiteSpace(_storyText)) return;
        var session = new NarrativeSessionContext(Graph);
        session.ScanText(_storyText);
        var snapshot = session.GetSnapshot();
        var textLower = _storyText.ToLowerInvariant();

        _sceneEntities = snapshot.PrimaryEntities
            .Where(e => textLower.Contains(e.Name.ToLowerInvariant()))
            .Select(e => (id: Graph.ResolveId(e.Name) ?? "", name: e.Name, nodeType: e.NodeType))
            .DistinctBy(e => e.name)
            .OrderBy(e => e.nodeType).ThenBy(e => e.name)
            .ToList();

        _validationIssues = Validator.ValidateQuick(_storyText)
            .Select(i => $"[{i.Category}] {i.EntityName}: {i.Description}").ToList();
    }

    private async Task RenderMiniGraph()
    {
        RefreshSceneEntities();
        if (_sceneEntities.Count == 0) return;
        _miniGraphRef?.Dispose();
        _miniGraphRef = DotNetObjectReference.Create(this);

        var ids = _sceneEntities.Select(e => e.id).Where(id => !string.IsNullOrEmpty(id)).ToHashSet();
        var expanded = new HashSet<string>(ids);
        foreach (var id in ids)
            foreach (var n in Graph.GetNeighbors(id, 1))
                expanded.Add(n.Id);

        var nodes = expanded.Select(id => Graph.GetNode(id)).Where(n => n != null)
            .Select(n => new { id = n!.Id, name = n.Name, nodeType = n.NodeType, edgeCount = Graph.GetAllEdges(n.Id).Count }).ToArray();
        var edges = expanded.SelectMany(id => Graph.GetAllEdges(id))
            .Where(e => expanded.Contains(e.Source) && expanded.Contains(e.Target))
            .DistinctBy(e => (e.Source, e.Target, e.RelationType))
            .Select(e => new { source = e.Source, target = e.Target, relationType = e.RelationType, weight = e.Weight, sentiment = e.Sentiment }).ToArray();

        await JS.InvokeVoidAsync("graphInterop.init", "miniGraphCanvas", _miniGraphRef, nodes, edges);
    }

