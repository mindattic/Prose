@page "/write"
@page "/write/{ProjectId}"
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@inject StoryStarterService Starter
@inject CanonService Canon
@inject IStoryBlockRepository Repo
@inject NavigationManager Nav
@inject ElevenLabsTtsService TtsSvc
@inject WindowsTtsService DraftTts
@inject TtsEnhancementService TtsEnhance
@inject EntityExtractionService EntityExtract
@inject ILlmService Llm
@inject CanonDatabaseService CanonDb
@inject WorldGraphService Graph
@inject ICanonPathProvider Paths
@inject CharacterRepository CharRepo
@inject CanonValidationService Validator
@inject IJSRuntime JS
@implements IDisposable

@* ── Toolbar ──────────────────────────────────────────── *@
<div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
    <input type="text" class="form-control bg-dark text-danger border-0 fw-bold fst-italic flex-grow-1"
           style="font-family: Georgia, serif; font-size: 1.4rem; max-width: 400px;"
           placeholder="Untitled"
           @bind="_project.Title"
           @bind:after="Save" />

    <button class="btn btn-sm @(_saved ? "btn-outline-secondary" : "btn-success")" @onclick="ForceSave" title="Save now">
        <i class="bi bi-floppy"></i> @(_saved ? "Saved" : "Save")
    </button>

    <small class="text-muted">@_wordCount words</small>

    <div class="ms-auto d-flex gap-1">
        @if (_ttsAvailable)
        {
            <button class="btn btn-sm btn-outline-secondary" @onclick="SmartNarrate" disabled="@_narrating" title="Narrate selection or chapter">
                <i class="bi bi-volume-up"></i>
            </button>
        }
        <button class="btn btn-sm btn-outline-secondary" @onclick="ExportStory" title="Export story as .txt file">
            <i class="bi bi-download"></i>
        </button>
        <button class="btn btn-sm btn-outline-danger" @onclick="NewStory" title="New story">
            <i class="bi bi-plus-lg"></i>
        </button>
    </div>
</div>

@* ── Command Bar ──────────────────────────────────────── *@
<div class="d-flex gap-2 mb-2 align-items-center">
    <button class="btn btn-sm btn-danger" @onclick="() => _showCommand = true" disabled="@(_generating || _syncing)">
        @if (_generating || _syncing) { <span class="spinner-border spinner-border-sm"></span> }
        else { <i class="bi bi-terminal"></i> }
        Command
    </button>
    <button class="btn btn-sm btn-outline-danger" @onclick="ContinueStory" disabled="@_generating" title="Continue the story">
        <i class="bi bi-pen"></i> Continue
    </button>
    <button class="btn btn-sm btn-outline-secondary" @onclick="ShowOutline" title="Story outline">
        <i class="bi bi-list-ol"></i> Outline
    </button>
    <button class="btn btn-sm btn-outline-secondary" @onclick="ShowSynopsisModal" title="Chapter synopsis">
        <i class="bi bi-card-text"></i> Synopsis
    </button>
</div>

@* ── Unified Command Modal ────────────────────────────── *@
@if (_showCommand)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="() => _showCommand = false">
        <div class="card bg-dark text-light border-danger" style="width: 650px; max-height: 85vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-danger fw-bold"><i class="bi bi-terminal"></i> Command</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showCommand = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                <div class="row g-2 mb-3">
                    <div class="col-md-5">
                        <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="_commandMode">
                            <option value="assist">Write — generate or direct content</option>
                            <option value="continue">Continue — extend the story</option>
                            <option value="rewrite">Rewrite — rewrite selected text</option>
                            <option value="sync">Synchronize — find and fix issues</option>
                            <option value="ask">Ask — question about the world</option>
                            <option value="synopsis">Synopsis — generate chapter summary</option>
                            <option value="outline">Outline — full story breakdown</option>
                        </select>
                    </div>
                    <div class="col-md-7">
                        <small class="text-muted">@CommandDescription</small>
                    </div>
                </div>

                @if (_commandMode is "assist" or "continue" or "rewrite" or "ask")
                {
                    <div class="mb-3">
                        <textarea class="form-control bg-dark text-light border-secondary"
                                  rows="3"
                                  placeholder="@CommandPlaceholder"
                                  @bind="_commandText"
                                  @onkeydown="HandleCommandKeyDown"
                                  style="font-family: Georgia, serif;"></textarea>
                    </div>
                }

                @if (_commandBusy)
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="spinner-border spinner-border-sm text-danger"></div>
                        <small class="text-muted">@_statusMessage</small>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_commandResult))
                {
                    <div class="mb-3">
                        <label class="form-label text-muted small">Result:</label>
                        <textarea class="form-control bg-dark text-light border-secondary"
                                  rows="8"
                                  style="font-family: Georgia, serif; font-size: 14px; line-height: 1.7;"
                                  @bind="_commandResult"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-success" @onclick="ApplyCommand">
                            <i class="bi bi-check-lg"></i> Apply
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick='() => _commandResult = ""'>Clear</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showCommand = false">Dismiss</button>
                    </div>
                }
                else if (!_commandBusy)
                {
                    <button class="btn btn-sm btn-danger" @onclick="ExecuteCommand">
                        <i class="bi bi-play-fill"></i> Execute
                    </button>
                }
            </div>
        </div>
    </div>
}

@* ── Synopsis Modal ────────────────────────────────────── *@
@if (_showSynopsisModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="() => _showSynopsisModal = false">
        <div class="card bg-dark text-light border-secondary" style="width: 650px; max-height: 80vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-light fw-bold"><i class="bi bi-card-text"></i> Chapter @_activeChapter Synopsis</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showSynopsisModal = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                @if (_synopsizing)
                {
                    <div class="d-flex align-items-center gap-2">
                        <div class="spinner-border spinner-border-sm text-light"></div>
                        <small class="text-muted">Generating synopsis + beats...</small>
                    </div>
                }
                else if (CurrentChapter != null && !string.IsNullOrWhiteSpace(CurrentChapter.Synopsis))
                {
                    <div class="d-flex gap-2 mb-2">
                        <button class="btn btn-sm btn-outline-info" @onclick="GenerateSynopsis" disabled="@_synopsizing">
                            <i class="bi bi-arrow-repeat"></i> Update
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showSynopsisModal = false">Close</button>
                    </div>
                    <div class="mb-2">
                        <small class="text-info fw-bold">Synopsis</small>
                        <div class="text-muted small" style="line-height: 1.5;">@CurrentChapter.Synopsis</div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(CurrentChapter.Beats))
                    {
                        <div>
                            <small class="text-success fw-bold">Key Beats</small>
                            <div class="text-muted small" style="line-height: 1.5; white-space: pre-wrap;">@CurrentChapter.Beats</div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small">No synopsis for this chapter yet.</p>
                    <button class="btn btn-sm btn-info text-dark" @onclick="GenerateSynopsis" disabled="@(string.IsNullOrWhiteSpace(_storyText))">
                        <i class="bi bi-card-text"></i> Generate Synopsis
                    </button>
                }
            </div>
        </div>
    </div>
}

@* ── Outline Modal ────────────────────────────────────── *@
@if (_showOutline)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="() => _showOutline = false">
        <div class="card bg-dark text-light border-secondary" style="width: 700px; max-height: 85vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-light fw-bold"><i class="bi bi-list-ol"></i> Story Outline</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showOutline = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                @if (_outlining)
                {
                    <div class="d-flex align-items-center gap-2">
                        <div class="spinner-border spinner-border-sm text-light"></div>
                        <small class="text-muted">Reading all chapters and building outline...</small>
                    </div>
                }
                else if (!string.IsNullOrEmpty(_outlineText))
                {
                    <div class="d-flex gap-2 mb-2">
                        <button class="btn btn-sm btn-outline-info" @onclick="UpdateOutline" disabled="@_outlining">
                            <i class="bi bi-arrow-repeat"></i> Update
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showOutline = false">Close</button>
                    </div>
                    <div style="font-family: monospace; font-size: 13px; line-height: 1.6; white-space: pre-wrap;">@_outlineText</div>
                }
                else
                {
                    <p class="text-muted small">No outline yet.</p>
                    <button class="btn btn-sm btn-info text-dark" @onclick="UpdateOutline">
                        <i class="bi bi-list-ol"></i> Generate Outline
                    </button>
                }
            </div>
        </div>
    </div>
}

@* ── GhostWriter Suggestions Modal ─────────────────────── *@
@if (_showGhostWriter)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="() => _showGhostWriter = false">
        <div class="card bg-dark text-light border-warning" style="width: 700px; max-height: 85vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-warning fw-bold"><i class="bi bi-eye"></i> GhostWriter — Chapter @_ghostChapterNum</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showGhostWriter = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(_ghostIssues))
                {
                    <div class="mb-2">
                        <label class="form-label text-muted small">Issues found — edit to remove items you disagree with:</label>
                        <textarea class="form-control bg-dark text-light border-secondary"
                                  rows="10"
                                  style="font-family: monospace; font-size: 13px; line-height: 1.5;"
                                  @bind="_ghostIssues"></textarea>
                    </div>

                    @if (_ghostApplying)
                    {
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="spinner-border spinner-border-sm text-warning"></div>
                            <small class="text-muted">Applying fixes...</small>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_ghostPreview))
                    {
                        <div class="mb-2">
                            <label class="form-label text-muted small">Fixed text (preview):</label>
                            <textarea class="form-control bg-dark text-light border-secondary"
                                      rows="10"
                                      style="font-family: Georgia, serif; font-size: 14px; line-height: 1.7;"
                                      @bind="_ghostPreview"></textarea>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-success" @onclick="ApplyGhostFixes">
                                <i class="bi bi-check-lg"></i> Apply
                            </button>
                            <button class="btn btn-outline-warning" @onclick="RunGhostFixes" disabled="@_ghostApplying">
                                <i class="bi bi-arrow-repeat"></i> Regenerate
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="DismissGhost">Dismiss</button>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex gap-2">
                            <button class="btn btn-warning text-dark" @onclick="RunGhostFixes" disabled="@_ghostApplying">
                                <i class="bi bi-wrench"></i> Apply Fixes
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="DismissGhost">Dismiss All</button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@* ── Chapter Tabs ─────────────────────────────────────── *@
<div class="d-flex gap-1 mb-2 flex-wrap align-items-center">
    @foreach (var ch in _project.Chapters.OrderBy(c => c.Number))
    {
        <button class="btn btn-sm @(_activeChapter == ch.Number ? "btn-danger" : "btn-outline-secondary")"
                @onclick="() => SwitchChapter(ch.Number)">
            @if (!string.IsNullOrWhiteSpace(ch.Synopsis))
            {
                <i class="bi bi-check-circle-fill text-success me-1" style="font-size: 0.6rem;"></i>
            }
            @if (HasGhostWriterSuggestions(ch.Number))
            {
                <button class="btn btn-sm p-0 border-0" @onclick="() => ShowGhostWriterSuggestions(ch.Number)" @onclick:stopPropagation="true"
                        title="GhostWriter found issues">
                    <i class="bi bi-eye-fill text-warning ms-1" style="font-size: 0.6rem;"></i>
                </button>
            }
            @(string.IsNullOrWhiteSpace(ch.Title) ? $"Ch {ch.Number}" : ch.Title)
        </button>
    }
    <button class="btn btn-sm btn-outline-secondary" @onclick="InsertChapterBefore" title="Insert chapter before current">
        <i class="bi bi-chevron-left"></i>
    </button>
    <button class="btn btn-sm btn-outline-danger" @onclick="ShowNewChapterDialog" title="New chapter">
        <i class="bi bi-plus-lg"></i>
    </button>
</div>

@* ── New Chapter Dialog ───────────────────────────────── *@
@if (_showNewChapterDialog)
{
    <div class="card bg-dark text-light border-secondary mb-2">
        <div class="card-body py-2">
            @if (_creatingChapter)
            {
                <div class="d-flex align-items-center gap-2">
                    <div class="spinner-border spinner-border-sm text-danger"></div>
                    <small class="text-muted">Creating chapter (generating synopsis for current chapter)...</small>
                </div>
            }
            else
            {
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-sm btn-outline-danger" @onclick='() => CreateNewChapter("continue")'>
                        <i class="bi bi-arrow-right"></i> Continue Story
                    </button>
                    @if (!_showPerspectiveInput)
                    {
                        <button class="btn btn-sm btn-outline-info" @onclick="() => _showPerspectiveInput = true">
                            <i class="bi bi-person-badge"></i> Switch Perspective
                        </button>
                    }
                    else
                    {
                        <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                               style="max-width: 200px;" placeholder="Character name..."
                               @bind="_newChapterPerspective" />
                        <button class="btn btn-sm btn-info text-dark" @onclick='() => CreateNewChapter("perspective")'
                                disabled="@string.IsNullOrWhiteSpace(_newChapterPerspective)">Go</button>
                    }
                    <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => _showNewChapterDialog = false">Cancel</button>
                </div>
            }
        </div>
    </div>
}

@* ── Chapter title + context ──────────────────────────── *@
@if (CurrentChapter != null)
{
    <div class="d-flex align-items-center gap-2 mb-2">
        <input type="text" class="form-control form-control-sm bg-dark text-light border-0 fw-bold"
               style="max-width: 300px;" value="@CurrentChapter.Title" @onchange="OnChapterTitleChanged" />
        @if (!string.IsNullOrWhiteSpace(CurrentChapter.Perspective))
        {
            <span class="badge bg-info text-dark"><i class="bi bi-person-badge"></i> @CurrentChapter.Perspective</span>
        }
    </div>
}

@* ── Context synopsis (collapsed by default) ─────────── *@
@if (!string.IsNullOrWhiteSpace(_project.StorySynopsis) || CurrentChapter?.Synopsis != null)
{
    <div class="mb-2">
        <a href="javascript:void(0)" class="text-muted small text-decoration-none"
           @onclick="() => _showSynopsis = !_showSynopsis">
            <i class="bi @(_showSynopsis ? "bi-chevron-up" : "bi-chevron-down")"></i> Context
        </a>
        @if (_showSynopsis)
        {
            <div class="card bg-dark border-secondary mt-1">
                <div class="card-body py-2 small text-muted" style="line-height: 1.4;">
                    @if (!string.IsNullOrWhiteSpace(_project.StorySynopsis))
                    {
                        <div class="mb-1"><span class="text-info fw-bold">Story Overview:</span> @_project.StorySynopsis</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_project.PlotArc))
                    {
                        <div class="mb-1"><span class="text-warning fw-bold">Plot Arc:</span> <span style="white-space: pre-wrap;">@_project.PlotArc</span></div>
                    }
                    @if (CurrentChapter?.Synopsis != null)
                    {
                        <div class="mb-1"><span class="text-success fw-bold">Chapter @_activeChapter Synopsis:</span> @CurrentChapter.Synopsis</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(CurrentChapter?.Beats))
                    {
                        <div><span class="text-danger fw-bold">Beats:</span> <span style="white-space: pre-wrap;">@CurrentChapter.Beats</span></div>
                    }
                </div>
            </div>
        }
    </div>
}

@* ── View Mode Tabs ──────────────────────────────────── *@
<div class="d-flex gap-1 mb-1 view-tabs">
    <button class="btn btn-sm @(_viewMode == "rich" ? "btn-outline-danger active" : "btn-outline-secondary")"
            @onclick='() => SwitchViewMode("rich")'>
        <i class="bi bi-brush"></i> Rich
    </button>
    <button class="btn btn-sm @(_viewMode == "raw" ? "btn-outline-danger active" : "btn-outline-secondary")"
            @onclick='() => SwitchViewMode("raw")'>
        <i class="bi bi-file-text"></i> Raw
    </button>
    @if (_viewMode == "rich")
    {
        <button class="btn btn-sm btn-outline-info ms-2" @onclick="AutoLinkEntities" title="Highlight entity names from the world graph">
            <i class="bi bi-link-45deg"></i> Link Entities
        </button>
    }
    <button class="btn btn-sm @(_showSceneSidebar ? "btn-outline-danger" : "btn-outline-secondary") ms-auto"
            @onclick="() => _showSceneSidebar = !_showSceneSidebar" title="Scene graph sidebar">
        <i class="bi bi-diagram-3"></i>
    </button>
</div>

@* ── Editor + Scene Sidebar ───────────────────────────── *@
<div class="row g-2">
    <div class="@(_showSceneSidebar ? "col-md-8" : "col-12")">
        @* ── Writing surface ──────────────────────────────── *@
        @if (_viewMode == "rich")
        {
            <div id="story-surface" class="form-control bg-dark text-light border-secondary rich-editor"
                 contenteditable="true"
                 style="resize: vertical;"></div>
        }
        else
        {
            <textarea id="story-surface-raw" class="form-control bg-dark text-light border-secondary"
                      style="font-family: 'Cascadia Code', 'Fira Code', monospace; font-size: 14px; line-height: 1.6; min-height: 60vh; resize: vertical;"
                      @bind="_storyText"
                      @bind:event="oninput"
                      @bind:after="OnTextChanged"></textarea>
        }
    </div>

    @if (_showSceneSidebar)
    {
        <div class="col-md-4">
            @* ── Validation Warnings ──────────────────────── *@
            @if (_validationIssues.Count > 0)
            {
                <div class="card bg-dark text-light border-warning mb-2">
                    <div class="card-header py-1 text-warning small fw-bold">
                        <i class="bi bi-exclamation-triangle"></i> Canon Issues (@_validationIssues.Count)
                    </div>
                    <div class="card-body py-2 small">
                        @foreach (var issue in _validationIssues)
                        {
                            <div class="d-flex align-items-start gap-1 mb-1">
                                <i class="bi bi-exclamation-circle text-warning" style="margin-top: 2px;"></i>
                                <span>@issue</span>
                            </div>
                        }
                        <button class="btn btn-sm btn-outline-warning mt-1" @onclick="ClearValidationIssues">Dismiss</button>
                    </div>
                </div>
            }

            @* ── Scene Entities ────────────────────────────── *@
            <div class="card bg-dark text-light border-secondary mb-2">
                <div class="card-header py-1 d-flex justify-content-between align-items-center">
                    <small class="text-muted fw-bold">Scene Entities</small>
                    <button class="btn btn-sm btn-outline-info py-0 px-1" @onclick="RefreshSceneEntities" title="Scan text for entities">
                        <i class="bi bi-arrow-repeat" style="font-size: 0.7rem;"></i>
                    </button>
                </div>
                <div class="card-body py-1" style="max-height: 30vh; overflow-y: auto;">
                    @if (_sceneCharacters.Count == 0 && _sceneLocations.Count == 0 && _sceneItems.Count == 0)
                    {
                        <small class="text-muted">Write or generate text, then scan to see entities.</small>
                    }
                    @if (_sceneCharacters.Count > 0)
                    {
                        <div class="mb-1">
                            <small class="text-info fw-bold">Characters</small>
                            @foreach (var c in _sceneCharacters)
                            {
                                <div class="d-flex align-items-center gap-1 small" style="cursor: pointer;" @onclick="() => ShowEntityPopover(c.id)">
                                    <span class="badge bg-info" style="font-size: 0.55rem;">C</span>
                                    <span>@c.name</span>
                                    @if (c.detail.Length > 0)
                                    {
                                        <small class="text-muted">— @c.detail</small>
                                    }
                                </div>
                            }
                        </div>
                    }
                    @if (_sceneLocations.Count > 0)
                    {
                        <div class="mb-1">
                            <small class="text-success fw-bold">Locations</small>
                            @foreach (var l in _sceneLocations)
                            {
                                <div class="d-flex align-items-center gap-1 small" style="cursor: pointer;" @onclick="() => ShowEntityPopover(l.id)">
                                    <span class="badge bg-success" style="font-size: 0.55rem;">P</span>
                                    <span>@l.name</span>
                                </div>
                            }
                        </div>
                    }
                    @if (_sceneItems.Count > 0)
                    {
                        <div class="mb-1">
                            <small class="text-danger fw-bold">Weapons/Equipment/Tech</small>
                            @foreach (var item in _sceneItems)
                            {
                                <div class="d-flex align-items-center gap-1 small" style="cursor: pointer;" @onclick="() => ShowEntityPopover(item.id)">
                                    <span class="badge @GetTypeBadgeClass(item.nodeType)" style="font-size: 0.55rem;">@item.nodeType[..1].ToUpper()</span>
                                    <span>@item.name</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @* ── Mini Scene Graph ──────────────────────────── *@
            <div class="card bg-dark text-light border-secondary">
                <div class="card-header py-1 d-flex justify-content-between align-items-center">
                    <small class="text-muted fw-bold">Scene Graph</small>
                    <button class="btn btn-sm btn-outline-danger py-0 px-1" @onclick="RenderMiniGraph" title="Render scene graph">
                        <i class="bi bi-play" style="font-size: 0.7rem;"></i>
                    </button>
                </div>
                <div id="miniGraphCanvas" style="width: 100%; height: 30vh; background: #111; border-radius: 0 0 4px 4px;"></div>
            </div>

            @* ── Entity Popover (in sidebar) ─────────────── *@
            @if (_showEntityPopover && _popoverNode != null)
            {
                <div class="card bg-dark text-light border-info mt-2">
                    <div class="card-header py-1 d-flex justify-content-between align-items-center">
                        <span>
                            <span class="badge @GetTypeBadgeClass(_popoverNode.NodeType) me-1">@_popoverNode.NodeType</span>
                            <strong>@_popoverNode.Name</strong>
                        </span>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick="() => _showEntityPopover = false"><i class="bi bi-x"></i></button>
                    </div>
                    <div class="card-body py-2 small" style="max-height: 25vh; overflow-y: auto; line-height: 1.4;">
                        @foreach (var key in new[] { "gender", "pronouns", "role", "status", "age", "affiliation", "location", "category", "manufacturer" })
                        {
                            if (_popoverNode.Properties.TryGetValue(key, out var val) && val.Length > 0)
                            {
                                <div><span class="text-info">@key:</span> @val</div>
                            }
                        }
                        @if (_popoverNode.Properties.TryGetValue("description", out var pdesc) && pdesc.Length > 0)
                        {
                            <div class="text-muted mt-1">@(pdesc.Length > 300 ? pdesc[..297] + "..." : pdesc)</div>
                        }
                        @{
                            var popoverEdges = Graph.GetAllEdges(_popoverNode.Id);
                            if (popoverEdges.Count > 0)
                            {
                                <div class="mt-1">
                                    <small class="text-muted fw-bold">Relationships:</small>
                                    @foreach (var edge in popoverEdges.Take(8))
                                    {
                                        var other = edge.Source == _popoverNode.Id ? edge.Target : edge.Source;
                                        var otherNode = Graph.GetNode(other);
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="badge bg-dark border border-secondary" style="font-size: 0.6rem;">@edge.RelationType</span>
                                            <span>@(otherNode?.Name ?? other)</span>
                                        </div>
                                    }
                                </div>
                            }
                        }
                        @if (_popoverNode.History.Count > 0)
                        {
                            <div class="mt-1 text-warning">
                                <small class="fw-bold">Timeline:</small>
                                @foreach (var h in _popoverNode.History.OrderBy(x => x.StoryPoint))
                                {
                                    <div>[@h.StoryPoint] @h.Property: @h.OldValue → @h.NewValue</div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ── Audio Player ─────────────────────────────────────── *@
<AudioPlayer @ref="_audioPlayer" Visible="_showAudioPlayer" OnDismissed="() => _showAudioPlayer = false" CssClass="mt-2" />

@if (_error != null)
{
    <div class="alert alert-warning mt-2 py-1 small">@_error</div>
}

@if (_graphStatus != null)
{
    <div class="d-flex align-items-center gap-2 mt-1">
        @if (_extracting)
        {
            <div class="spinner-border spinner-border-sm text-info" style="width: 0.8rem; height: 0.8rem;"></div>
        }
        else
        {
            <i class="bi bi-diagram-3 text-info" style="font-size: 0.75rem;"></i>
        }
        <small class="text-muted" style="font-size: 0.7rem;">@_graphStatus</small>
    </div>
}

@* ── Synchronize Modal ────────────────────────────────── *@
@if (_showSync)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="CloseSync">
        <div class="card bg-dark text-light border-info" style="width: 700px; max-height: 85vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-info fw-bold"><i class="bi bi-tools"></i> Synchronize</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseSync"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                @if (_syncing)
                {
                    <div class="d-flex align-items-center gap-2">
                        <div class="spinner-border spinner-border-sm text-info"></div>
                        <small class="text-muted">@_syncStatus</small>
                    </div>
                }
                else if (!string.IsNullOrEmpty(_syncIssues))
                {
                    <div class="mb-2">
                        <label class="form-label text-muted small">Issues found — edit to remove or add items, then Apply All to fix them:</label>
                        <textarea class="form-control bg-dark text-light border-secondary"
                                  rows="12"
                                  style="font-family: monospace; font-size: 13px; line-height: 1.5;"
                                  @bind="_syncIssues"></textarea>
                    </div>

                    @if (!string.IsNullOrEmpty(_syncPreview))
                    {
                        <div class="mb-2">
                            <label class="form-label text-muted small">Synchronized text (preview):</label>
                            <textarea class="form-control bg-dark text-light border-secondary"
                                      rows="10"
                                      style="font-family: Georgia, serif; font-size: 14px; line-height: 1.7;"
                                      @bind="_syncPreview"></textarea>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-success" @onclick="ApplySync">
                                <i class="bi bi-check-lg"></i> Apply
                            </button>
                            <button class="btn btn-outline-info" @onclick="RunSyncFixes" disabled="@_syncing">
                                <i class="bi bi-arrow-repeat"></i> Regenerate
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="CloseSync">Dismiss</button>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex gap-2">
                            <button class="btn btn-info text-dark" @onclick="RunSyncFixes" disabled="@_syncing">
                                <i class="bi bi-wrench"></i> Apply All Fixes
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="CloseSync">Dismiss</button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? ProjectId { get; set; }

    // ── Core state ──
    private StoryProject _project = new();
    private string _storyText = "";
    private int _wordCount;
    private bool _saved;
    private string? _error;
    private bool _generating => _commandBusy;
    private string _statusMessage = "";

    // ── Audio ──
    private bool _ttsAvailable;
    private bool _narrating;
    private bool _showAudioPlayer;
    private AudioPlayer? _audioPlayer;

    // ── Entity extraction ──
    private bool _extracting;
    private string? _graphStatus;
    private string _lastExtractedText = "";

    // ── Synchronize ──
    private bool _syncing;
    private bool _showSync;
    private string _syncIssues = "";
    private string _syncPreview = "";
    private string _syncStatus = "";

    // ── Chapters ──
    private int _activeChapter = 1;
    private bool _synopsizing;
    private bool _showSynopsisModal;
    private bool _outlining;

    // ── Unified Command ──
    private bool _showCommand;
    private string _commandMode = "assist";
    private string _commandText = "";
    private string _commandResult = "";
    private bool _commandBusy;

    // ── GhostWriter ──
    private bool _showGhostWriter;
    private int _ghostChapterNum;
    private string _ghostIssues = "";
    private string _ghostPreview = "";
    private bool _ghostApplying;
    private bool _showOutline;
    private string _outlineText = "";
    private bool _showSynopsis = true;
    private StoryChapter? CurrentChapter => _project.Chapters.FirstOrDefault(c => c.Number == _activeChapter);
    private bool _showNewChapterDialog;
    private bool _showPerspectiveInput;
    private bool _creatingChapter;
    private string _newChapterPerspective = "";

    // ── Rewrite tracking (for Command modal rewrite) ──
    private int _rewriteStart;
    private int _rewriteEnd;

    // ── Rich editor ──
    private string _viewMode = "rich";
    private string _richHtml = "";
    private DotNetObjectReference<WriteStory>? _editorRef;
    private bool _richEditorInitialized;

    // ── Entity popover ──
    private bool _showEntityPopover;
    private WorldNode? _popoverNode;

    // ── Scene sidebar ──
    private bool _showSceneSidebar;
    private List<(string id, string name, string detail)> _sceneCharacters = [];
    private List<(string id, string name)> _sceneLocations = [];
    private List<(string id, string name, string nodeType)> _sceneItems = [];
    private List<string> _validationIssues = [];
    private DotNetObjectReference<WriteStory>? _miniGraphRef;

    // ── Auto-save timer ──
    private System.Threading.Timer? _saveTimer;
    private bool _dirty;

    private bool _hasExistingText => !string.IsNullOrWhiteSpace(_storyText);

    private string CommandDescription => _commandMode switch
    {
        "assist" => "Direct the AI to write, expand, or modify content",
        "continue" => "Continue the story from where it left off",
        "rewrite" => "Rewrite the selected/highlighted text",
        "sync" => "Validate against the world graph — find contradictions with canon",
        "ask" => "Query the world graph — look up any entity, relationship, or fact",
        "synopsis" => "Generate a synopsis of the current chapter",
        "outline" => "Generate a full story outline with continuity checks",
        _ => ""
    };

    private string CommandPlaceholder => _commandMode switch
    {
        "assist" => "What should happen? e.g. 'Kyle enters the building and finds it empty'",
        "continue" => "Optional direction, or leave blank to auto-continue",
        "rewrite" => "Direction for rewrite, e.g. 'make it more tense' or leave blank for polish",
        "ask" => "Who is Sable? What's her relationship to Kyle? What weapons does he carry?",
        _ => ""
    };

    // ── Lifecycle ──

    protected override async Task OnInitializedAsync()
    {
        _ttsAvailable = await TtsSvc.IsConfiguredAsync();
        if (!string.IsNullOrEmpty(ProjectId))
        {
            var loaded = Repo.LoadProject(ProjectId);
            if (loaded != null) _project = loaded;
        }

        _project.EnsureChapters();
        _activeChapter = _project.Chapters.First().Number;
        _storyText = CurrentChapter?.Text ?? "";
        UpdateWordCount();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || (!_richEditorInitialized && _viewMode == "rich"))
        {
            await InitRichEditor();
        }
    }

    private async Task InitRichEditor()
    {
        if (_viewMode != "rich") return;
        _editorRef?.Dispose();
        _editorRef = DotNetObjectReference.Create(this);
        // Convert plain text to HTML paragraphs
        _richHtml = TextToHtml(_storyText);
        await JS.InvokeVoidAsync("writeInterop.richEditor.init", "story-surface", _editorRef, _richHtml);
        _richEditorInitialized = true;

        // Build entity index for auto-linking
        var allNodes = Graph.AllNodes();
        var entities = allNodes
            .Where(n => n.Name.Length >= 3)
            .Select(n => new { name = n.Name, id = n.Id, nodeType = n.NodeType })
            .ToArray();
        await JS.InvokeVoidAsync("writeInterop.richEditor.buildEntityIndex", (object)entities);
    }

    [JSInvokable]
    public void OnRichContentChanged(string html, string plainText)
    {
        _richHtml = html;
        _storyText = plainText;
        _dirty = true;
        _saved = false;
        UpdateWordCount();

        _saveTimer?.Dispose();
        _saveTimer = new System.Threading.Timer(_ =>
        {
            if (_dirty) InvokeAsync(Save);
        }, null, 2000, Timeout.Infinite);
    }

    [JSInvokable]
    public void OnEntityClicked(string entityId)
    {
        ShowEntityPopover(entityId);
        if (!_showSceneSidebar) _showSceneSidebar = true;
        StateHasChanged();
    }

    private async Task AutoLinkEntities()
    {
        await JS.InvokeVoidAsync("writeInterop.richEditor.highlightEntities", "story-surface");
    }

    private async Task SwitchViewMode(string mode)
    {
        if (mode == _viewMode) return;

        if (_viewMode == "rich" && mode == "raw")
        {
            // Sync rich → raw: get plain text from contenteditable
            _storyText = await JS.InvokeAsync<string>("writeInterop.richEditor.stripToPlainText", "story-surface");
            _richEditorInitialized = false;
        }

        _viewMode = mode;
        StateHasChanged();

        if (mode == "rich")
        {
            // Need to wait for the DOM to render the contenteditable div
            await Task.Delay(50);
            await InitRichEditor();
        }
    }

    private static string TextToHtml(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        // Convert plain text paragraphs to <p> tags
        var paragraphs = text.Split(["\n\n", "\r\n\r\n"], StringSplitOptions.RemoveEmptyEntries);
        return string.Join("", paragraphs.Select(p =>
            $"<p>{System.Net.WebUtility.HtmlEncode(p.Trim()).Replace("\n", "<br>")}</p>"));
    }

    /// <summary>Set the editor content in whichever mode is active.</summary>
    private async Task SetEditorText(string text)
    {
        _storyText = text;
        if (_viewMode == "rich")
        {
            _richHtml = TextToHtml(text);
            await JS.InvokeVoidAsync("writeInterop.richEditor.setHtml", "story-surface", _richHtml);
        }
        else
        {
            await JS.InvokeVoidAsync("writeInterop.setText", "story-surface-raw", text);
        }
    }

    /// <summary>Append text to the editor in whichever mode is active.</summary>
    private async Task AppendEditorText(string text)
    {
        if (_viewMode == "rich")
        {
            var html = TextToHtml(text);
            await JS.InvokeVoidAsync("writeInterop.richEditor.appendHtml", "story-surface", html);
            _storyText = await JS.InvokeAsync<string>("writeInterop.richEditor.getPlainText", "story-surface");
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(_storyText)) _storyText += "\n\n";
            _storyText += text;
            await JS.InvokeVoidAsync("writeInterop.setText", "story-surface-raw", _storyText);
        }
    }

    /// <summary>Focus the end of the editor.</summary>
    private async Task FocusEditorEnd()
    {
        var surfaceId = _viewMode == "rich" ? "story-surface" : "story-surface-raw";
        await JS.InvokeVoidAsync("writeInterop.focusEnd", surfaceId);
    }

    // ── Scene Sidebar ──────────────────────────────────

    private void ShowEntityPopover(string entityId)
    {
        var node = Graph.GetNode(entityId);
        if (node == null) return;
        _popoverNode = node;
        _showEntityPopover = true;
    }

    private void RefreshSceneEntities()
    {
        if (string.IsNullOrWhiteSpace(_storyText)) return;

        var session = new NarrativeSessionContext(Graph);
        session.ScanText(_storyText);
        var snapshot = session.GetSnapshot();
        var textLower = _storyText.ToLowerInvariant();

        // Filter to entities actually mentioned in text
        _sceneCharacters = snapshot.PrimaryEntities
            .Concat(snapshot.SecondaryEntities)
            .Where(e => e.NodeType == "character" && textLower.Contains(e.Name.ToLowerInvariant()))
            .Select(e =>
            {
                var node = Graph.GetNode(Graph.ResolveId(e.Name) ?? "");
                var detail = node?.Properties.GetValueOrDefault("role", "") ?? "";
                return (id: Graph.ResolveId(e.Name) ?? "", name: e.Name, detail);
            })
            .DistinctBy(e => e.name)
            .ToList();

        _sceneLocations = snapshot.PrimaryEntities
            .Concat(snapshot.SecondaryEntities)
            .Where(e => e.NodeType == "place" && textLower.Contains(e.Name.ToLowerInvariant()))
            .Select(e => (id: Graph.ResolveId(e.Name) ?? "", name: e.Name))
            .DistinctBy(e => e.name)
            .ToList();

        _sceneItems = snapshot.PrimaryEntities
            .Concat(snapshot.SecondaryEntities)
            .Where(e => e.NodeType is "weapon" or "equipment" or "technology" && textLower.Contains(e.Name.ToLowerInvariant()))
            .Select(e => (id: Graph.ResolveId(e.Name) ?? "", name: e.Name, nodeType: e.NodeType))
            .DistinctBy(e => e.name)
            .ToList();

        // Run quick validation
        var issues = Validator.ValidateQuick(_storyText);
        _validationIssues = issues.Select(i => $"[{i.Category}] {i.EntityName}: {i.Description}").ToList();
    }

    private async Task RenderMiniGraph()
    {
        RefreshSceneEntities();
        if (_sceneCharacters.Count == 0 && _sceneLocations.Count == 0) return;

        _miniGraphRef?.Dispose();
        _miniGraphRef = DotNetObjectReference.Create(this);

        // Collect all entity IDs from the scene
        var entityIds = _sceneCharacters.Select(c => c.id)
            .Concat(_sceneLocations.Select(l => l.id))
            .Concat(_sceneItems.Select(i => i.id))
            .Where(id => !string.IsNullOrEmpty(id))
            .ToHashSet();

        // Add 1-hop neighbors for context
        var expanded = new HashSet<string>(entityIds);
        foreach (var id in entityIds)
        {
            foreach (var neighbor in Graph.GetNeighbors(id, 1))
                expanded.Add(neighbor.Id);
        }

        var nodes = expanded
            .Select(id => Graph.GetNode(id))
            .Where(n => n != null)
            .Select(n => new
            {
                id = n!.Id,
                name = n.Name,
                nodeType = n.NodeType,
                edgeCount = Graph.GetAllEdges(n.Id).Count
            })
            .ToArray();

        var allEdges = expanded
            .SelectMany(id => Graph.GetAllEdges(id))
            .Where(e => expanded.Contains(e.Source) && expanded.Contains(e.Target))
            .DistinctBy(e => (e.Source, e.Target, e.RelationType))
            .Select(e => new
            {
                source = e.Source,
                target = e.Target,
                relationType = e.RelationType,
                weight = e.Weight,
                sentiment = e.Sentiment,
            })
            .ToArray();

        await JS.InvokeVoidAsync("graphInterop.init", "miniGraphCanvas", _miniGraphRef, nodes, allEdges);
    }

    private void ClearValidationIssues() => _validationIssues.Clear();

    /// <summary>
    /// After text is generated and inserted, auto-link entities and refresh the scene sidebar.
    /// </summary>
    private async Task PostGenerationHook()
    {
        if (_viewMode == "rich")
            await AutoLinkEntities();
        if (_showSceneSidebar)
            RefreshSceneEntities();
        _ = RunExtractionAsync();
    }

    private static string GetTypeBadgeClass(string type) => type switch
    {
        "character" => "bg-info",
        "organization" => "bg-warning text-dark",
        "place" => "bg-success",
        "faction" => "bg-purple",
        "weapon" => "bg-danger",
        "equipment" => "bg-primary",
        "technology" => "bg-cyan",
        _ => "bg-secondary",
    };

    // ── Unified Command Execution ──

    private async Task ExecuteCommand()
    {
        if (_commandBusy) return;
        _commandBusy = true;
        _commandResult = "";
        StateHasChanged();

        try
        {
            switch (_commandMode)
            {
                case "assist":
                    _statusMessage = "Generating...";
                    StateHasChanged();
                    await ExecuteAssistCommand();
                    break;

                case "continue":
                    _showCommand = false;
                    StateHasChanged();
                    await ContinueStory();
                    break;

                case "rewrite":
                    _statusMessage = "Rewriting selection...";
                    StateHasChanged();
                    await ExecuteRewriteCommand();
                    break;

                case "sync":
                    _statusMessage = "Validating against world graph...";
                    StateHasChanged();
                    await ExecuteSyncCommand();
                    break;

                case "ask":
                    _statusMessage = "Querying world graph...";
                    StateHasChanged();
                    await ExecuteAskCommand();
                    break;

                case "synopsis":
                    _showCommand = false;
                    StateHasChanged();
                    await GenerateSynopsis();
                    _showSynopsisModal = true;
                    break;

                case "outline":
                    _showCommand = false;
                    StateHasChanged();
                    ShowOutline();
                    await UpdateOutline();
                    break;
            }
        }
        catch (Exception ex)
        {
            _commandResult = $"Error: {ex.Message}";
        }
        finally
        {
            _commandBusy = false;
            _statusMessage = "";
        }
    }

    private async Task ExecuteAssistCommand()
    {
        if (string.IsNullOrWhiteSpace(_commandText)) return;

        var priorContext = _project.GetPriorContext(_activeChapter);
        if (!_hasExistingText && string.IsNullOrWhiteSpace(priorContext))
        {
            var request = new StoryStarterRequest
            {
                Premise = _commandText,
                Characters = _project.Characters,
            };
            var opening = await Starter.GenerateOpeningAsync(request);
            _commandResult = opening.Text;
            if (_project.Title is "Untitled" or "")
                _project.Title = opening.Title;
        }
        else
        {
            var paragraphs = new List<string>();
            if (!string.IsNullOrWhiteSpace(priorContext))
                paragraphs.Add($"[PRIOR CHAPTERS SUMMARY]\n{priorContext}\n[CURRENT CHAPTER]");
            if (!string.IsNullOrWhiteSpace(_storyText))
                paragraphs.AddRange(_storyText.Split(["\n\n", "\r\n\r\n"], StringSplitOptions.RemoveEmptyEntries)
                    .Select(p => p.Trim()).Where(p => p.Length > 0));
            _commandResult = await Starter.ContinueAsync(paragraphs, _commandText,
                null, null, _project.Characters);
        }
    }

    private async Task ExecuteRewriteCommand()
    {
        try
        {
            var sel = await JS.InvokeAsync<SelectionInfo>("writeInterop.getSelection", "story-surface");
            if (sel == null || string.IsNullOrWhiteSpace(sel.Text))
            {
                _commandResult = "Select text in the editor first, then execute Rewrite.";
                return;
            }
            _rewriteStart = sel.Start;
            _rewriteEnd = sel.End;
            _commandResult = await Starter.RewriteAsync(sel.Text,
                string.IsNullOrWhiteSpace(_commandText) ? null : _commandText,
                null, null, _project.Characters);
        }
        catch (Exception ex) { _commandResult = $"Could not read selection: {ex.Message}"; }
    }

    /// <summary>
    /// Validate story text against the world graph. Scans the text for entity mentions,
    /// pulls their canonical facts from the graph, and asks the LLM to find contradictions.
    /// This is graph-powered validation — not ad-hoc context building.
    /// </summary>
    private async Task ExecuteSyncCommand()
    {
        // Build a session context from the story text — auto-detect every entity mentioned
        var session = new NarrativeSessionContext(Graph);
        session.ScanText(_storyText);
        var worldContext = session.BuildContext();

        var rulesContext = CanonDb.GetLiteraryRulesPrompt();

        var system = $"""
            You are a story editor validating cyberpunk fiction against its world database.
            The WORLD CONTEXT below is the canonical truth from the world graph.
            Find every place where the story contradicts these facts.

            WORLD CONTEXT (canonical — this is what is TRUE):
            {worldContext}

            LITERARY RULES:
            {rulesContext}

            List EVERY issue as a numbered item. Categories:
            - CANON: contradicts established character/world details (wrong gender, wrong affiliation, dead character alive, etc.)
            - PLOT: logic gap, unexplained jump, dangling thread
            - VOICE: character doesn't sound like themselves
            - PACING: section drags or rushes
            - PROSE: clumsy phrasing, cliche, weak imagery

            Format: 1. [CATEGORY] "quoted problem" — what to fix
            If clean, say "No issues found."
            """;
        _commandResult = await Llm.GenerateAsync(system, _storyText, 0.3, 4096);
    }

    /// <summary>
    /// Answer questions by querying the world graph, not by stuffing all chapter text
    /// into a prompt. The graph knows entities, relationships, and canon facts.
    /// Story synopses provide narrative context without burning the full text budget.
    /// </summary>
    private async Task ExecuteAskCommand()
    {
        if (string.IsNullOrWhiteSpace(_commandText)) return;

        // Build graph context from the question — scan for entity names
        var session = new NarrativeSessionContext(Graph);
        session.ScanText(_commandText);
        // Also load entities from the current chapter for context
        if (!string.IsNullOrWhiteSpace(_storyText))
            session.ScanText(_storyText);
        var worldContext = session.BuildContext();

        // Use synopses for narrative context (not full chapter text)
        var synopses = string.Join("\n",
            _project.Chapters.Where(c => !string.IsNullOrWhiteSpace(c.Synopsis))
                .OrderBy(c => c.Number)
                .Select(c => $"Ch{c.Number} ({c.Title}): {c.Synopsis}"));

        var system = $"""
            Answer using the world graph data and story synopses below. Do not invent facts.

            WORLD GRAPH (canonical entity data):
            {worldContext}

            STORY SYNOPSES:
            {synopses}

            STORY OUTLINE:
            {_project.Outline}

            Answer directly and concisely. If the answer is not in the provided data, say so.
            """;
        _commandResult = await Llm.GenerateAsync(system, _commandText, 0.3, 2048);
    }

    private async Task ApplyCommand()
    {
        if (string.IsNullOrEmpty(_commandResult)) return;

        if (_commandMode == "rewrite" && _rewriteStart >= 0)
        {
            var newValue = await JS.InvokeAsync<string>("writeInterop.replaceRange",
                "story-surface", _rewriteStart, _rewriteEnd, _commandResult);
            _storyText = newValue;
        }
        else if (_commandMode is "assist" or "continue")
        {
            await AppendEditorText(_commandResult);
        }
        else if (_commandMode == "sync")
        {
            _syncIssues = _commandResult;
            _showCommand = false;
            _showSync = true;
            _commandResult = "";
            return;
        }

        UpdateWordCount();
        Save();
        _commandResult = "";
        _showCommand = false;
        _ = PostGenerationHook();
        await FocusEditorEnd();
    }

    private async Task HandleCommandKeyDown(KeyboardEventArgs e)
    {
        if (e is { Key: "Enter", CtrlKey: true }) await ExecuteCommand();
    }

    // ── Direct Continue (no modal) ──

    private async Task ContinueStory()
    {
        if (_commandBusy) return;

        var priorContext = _project.GetPriorContext(_activeChapter);
        if (string.IsNullOrWhiteSpace(_storyText) && string.IsNullOrWhiteSpace(priorContext))
        {
            _error = "Nothing to continue from — use Command > Write to start.";
            return;
        }

        _commandBusy = true;
        _error = null;
        _statusMessage = "Continuing the story...";
        StateHasChanged();

        try
        {
            var paragraphs = new List<string>();
            if (!string.IsNullOrWhiteSpace(priorContext))
                paragraphs.Add($"[PRIOR CHAPTERS SUMMARY]\n{priorContext}\n[CURRENT CHAPTER]");

            if (!string.IsNullOrWhiteSpace(_storyText))
            {
                paragraphs.AddRange(_storyText
                    .Split(["\n\n", "\r\n\r\n"], StringSplitOptions.RemoveEmptyEntries)
                    .Select(p => p.Trim()).Where(p => p.Length > 0));
            }

            // Build direction with POV narration voice
            var povChar = CurrentChapter?.Perspective;
            var narrationVoice = "";
            if (!string.IsNullOrWhiteSpace(povChar))
            {
                var charData = CharRepo.GetByName(povChar);
                if (charData != null && !string.IsNullOrWhiteSpace(charData.NarrationVoice))
                    narrationVoice = $"\n\nNARRATION VOICE ({charData.Name}):\n{charData.NarrationVoice}" +
                        (charData.UsesFacets ? "" : "\nDo NOT use facet tags like [WOUND], [IDEAL], etc. This character does not use them.");
            }

            var direction = string.IsNullOrWhiteSpace(_storyText)
                ? $"Begin this new chapter. Continue from where the previous chapter left off.{narrationVoice}"
                : $"continue{narrationVoice}";

            var text = await Starter.ContinueAsync(
                paragraphs, direction, null, null, _project.Characters);

            if (string.IsNullOrWhiteSpace(_storyText))
                await SetEditorText(text);
            else
                await AppendEditorText(text);
            UpdateWordCount();
            Save();
            _ = PostGenerationHook();
            await FocusEditorEnd();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _commandBusy = false;
            _statusMessage = "";
        }
    }

    // ── Text changes ──

    private void OnTextChanged()
    {
        UpdateWordCount();
        _dirty = true;
        _saved = false;

        _saveTimer?.Dispose();
        _saveTimer = new System.Threading.Timer(_ =>
        {
            if (_dirty) InvokeAsync(Save);
        }, null, 2000, Timeout.Infinite);
    }

    private void UpdateWordCount()
    {
        _wordCount = string.IsNullOrWhiteSpace(_storyText)
            ? 0
            : _storyText.Split((char[])[' ', '\n', '\r', '\t'], StringSplitOptions.RemoveEmptyEntries).Length;
    }

    // ── Persistence ──

    private void Save()
    {
        SyncChapter();
        _project.SyncBlocksFromChapters();
        Repo.SaveProject(_project);
        _saved = true;
        _dirty = false;
        InvokeAsync(StateHasChanged);
    }

    private void ForceSave()
    {
        Save();
        StateHasChanged();
        if (!string.IsNullOrWhiteSpace(_storyText) && _storyText != _lastExtractedText)
            _ = RunExtractionAsync();
    }

    private void SyncChapter()
    {
        var ch = CurrentChapter;
        if (ch != null)
        {
            ch.Text = _storyText;
            ch.Modified = DateTime.UtcNow;
        }
        _project.Modified = DateTime.UtcNow;
    }

    // ── Chapter management ──

    private async Task SwitchChapter(int number)
    {
        // Sync current chapter — pull from rich editor if active
        if (_viewMode == "rich" && _richEditorInitialized)
            _storyText = await JS.InvokeAsync<string>("writeInterop.richEditor.getPlainText", "story-surface");
        SyncChapter();
        Save();

        _activeChapter = number;
        _storyText = CurrentChapter?.Text ?? "";
        UpdateWordCount();

        // Re-init the editor with the new chapter content
        if (_viewMode == "rich")
        {
            _richEditorInitialized = false;
            StateHasChanged();
            await Task.Delay(50);
            await InitRichEditor();
        }
    }

    private void InsertChapterBefore()
    {
        SyncChapter();
        var insertAt = _activeChapter;
        foreach (var ch in _project.Chapters.Where(c => c.Number >= insertAt).OrderByDescending(c => c.Number))
            ch.Number++;
        var newChapter = new StoryChapter { Number = insertAt, Title = insertAt == 1 ? "Prologue" : $"Chapter {insertAt}" };
        _project.Chapters.Add(newChapter);
        _activeChapter = insertAt;
        _storyText = "";
        UpdateWordCount();
        Save();
    }

    private void ShowNewChapterDialog()
    {
        _showNewChapterDialog = true;
        _showPerspectiveInput = false;
        _newChapterPerspective = "";
        _creatingChapter = false;
    }

    private async Task CreateNewChapter(string mode)
    {
        _creatingChapter = true;
        StateHasChanged();

        try
        {
            SyncChapter();

            // Auto-generate synopsis + beats for current chapter if missing
            var currentCh = CurrentChapter;
            if (currentCh != null && string.IsNullOrWhiteSpace(currentCh.Synopsis) && !string.IsNullOrWhiteSpace(currentCh.Text))
            {
                var synSystem = """
                    Create a tight, factual synopsis of this chapter. Capture ALL key events,
                    character actions, revelations, emotional beats, and unresolved threads.
                    Name every character. Note every location. 1-2 dense paragraphs.
                    """;
                var priorCtx = _project.GetPriorContext(_activeChapter);
                var synUser = string.IsNullOrWhiteSpace(priorCtx)
                    ? currentCh.Text
                    : $"PREVIOUS CHAPTERS:\n{priorCtx}\n\nCURRENT CHAPTER:\n{currentCh.Text}";

                currentCh.Synopsis = (await Llm.GenerateAsync(synSystem, synUser, 0.2, 2048)).Trim();

                var beatsSystem = """
                    List the 3-6 major plot beats from this chapter as bullet points.
                    Each beat: "- [what happened]". Focus on decisions, revelations, conflicts, turning points.
                    """;
                currentCh.Beats = (await Llm.GenerateAsync(beatsSystem, currentCh.Text, 0.2, 1024)).Trim();
            }

            var nextNum = _project.Chapters.Max(c => c.Number) + 1;
            var perspective = mode == "perspective" ? _newChapterPerspective : "";
            var title = mode == "perspective"
                ? $"Chapter {nextNum} — {_newChapterPerspective}"
                : $"Chapter {nextNum}";

            var newChapter = new StoryChapter { Number = nextNum, Title = title, Perspective = perspective };
            _project.Chapters.Add(newChapter);
            Save();

            _activeChapter = nextNum;
            _storyText = "";
            UpdateWordCount();
            _showNewChapterDialog = false;
            _showPerspectiveInput = false;
        }
        catch (Exception ex)
        {
            _error = $"Failed to create chapter: {ex.Message}";
        }
        finally
        {
            _creatingChapter = false;
        }
    }

    private void OnChapterTitleChanged(ChangeEventArgs e)
    {
        var ch = CurrentChapter;
        if (ch != null)
        {
            ch.Title = e.Value?.ToString() ?? "";
            Save();
        }
    }

    private void ShowSynopsisModal() => _showSynopsisModal = true;

    private async Task GenerateSynopsis()
    {
        if (string.IsNullOrWhiteSpace(_storyText) || _synopsizing) return;
        _synopsizing = true;
        _statusMessage = "Generating chapter synopsis + beats...";
        StateHasChanged();

        try
        {
            var priorContext = _project.GetPriorContext(_activeChapter);
            var contextLine = string.IsNullOrWhiteSpace(priorContext)
                ? ""
                : $"PREVIOUS CHAPTERS CONTEXT:\n{priorContext}\n\n";

            var synSystem = """
                You are a story editor creating a tight, factual synopsis of a chapter.
                Capture ALL key events, character actions, revelations, emotional beats,
                and unresolved threads. Be precise and complete. No opinions —
                just what happened, in order. 1-2 dense paragraphs.
                """;
            var synopsis = await Llm.GenerateAsync(synSystem,
                $"{contextLine}CHAPTER TEXT:\n{_storyText}", 0.2, 2048);

            _statusMessage = "Extracting key beats...";
            StateHasChanged();
            var beatsSystem = """
                List the 3-6 major plot beats from this chapter as bullet points.
                Each beat should be one line: "- [what happened]"
                Focus on: character decisions, revelations, conflicts, turning points.
                No filler. No opinions. Just the beats.
                """;
            var beats = await Llm.GenerateAsync(beatsSystem, _storyText, 0.2, 1024);

            var ch = CurrentChapter;
            if (ch != null)
            {
                ch.Synopsis = synopsis.Trim();
                ch.Beats = beats.Trim();
                Save();
            }

            // Update story-level synopsis if we have 2+ chapters with synopses
            var chaptersWithSynopsis = _project.Chapters.Count(c => !string.IsNullOrWhiteSpace(c.Synopsis));
            if (chaptersWithSynopsis >= 2)
            {
                _statusMessage = "Updating story overview...";
                StateHasChanged();

                var allSynopses = string.Join("\n\n",
                    _project.Chapters.OrderBy(c => c.Number)
                        .Where(c => !string.IsNullOrWhiteSpace(c.Synopsis))
                        .Select(c => $"Chapter {c.Number} ({c.Title}): {c.Synopsis}"));

                var storySystem = """
                    Synthesize these chapter synopses into ONE story-level overview.
                    2-3 paragraphs covering: premise, major events so far, current state
                    of the main characters, and unresolved threads.
                    """;
                _project.StorySynopsis = (await Llm.GenerateAsync(storySystem, allSynopses, 0.2, 2048)).Trim();

                var arcSystem = """
                    Based on these chapter synopses, describe the plot arc so far in 3-5 bullet points.
                    Format: "- [turning point or major shift]"
                    """;
                _project.PlotArc = (await Llm.GenerateAsync(arcSystem, allSynopses, 0.2, 1024)).Trim();
                Save();
            }
        }
        catch (Exception ex) { _error = $"Synopsis failed: {ex.Message}"; }
        finally { _synopsizing = false; _statusMessage = ""; }
    }

    private void ShowOutline()
    {
        _outlineText = _project.Outline;
        _showOutline = true;
    }

    private async Task UpdateOutline()
    {
        if (_outlining) return;
        _outlining = true;
        _outlineText = "";
        SyncChapter();
        StateHasChanged();

        try
        {
            var chapterSummaries = new List<string>();
            foreach (var ch in _project.Chapters.OrderBy(c => c.Number))
            {
                var perspective = string.IsNullOrWhiteSpace(ch.Perspective) ? "" : $" [POV: {ch.Perspective}]";
                var textPreview = string.IsNullOrWhiteSpace(ch.Text) ? "(empty)" : ch.Text;
                chapterSummaries.Add($"=== CHAPTER {ch.Number}: {ch.Title}{perspective} ===\n{textPreview}");
            }

            var system = """
                You are a story editor creating a structured outline of a cyberpunk novel.
                For each chapter: number, title, POV, 3-5 key events, characters, locations, unresolved threads.

                After all chapters:
                CONTINUITY CHECK: Flag contradictions, dropped threads, voice inconsistencies. Quote text.
                STORY ARC STATUS: Where is the story now? What needs to happen? What threads are ready?
                Be specific. This is a working document, not praise.
                """;

            _outlineText = await Llm.GenerateAsync(system, string.Join("\n\n", chapterSummaries), 0.2, 8192);
            _project.Outline = _outlineText;
            Save();
        }
        catch (Exception ex) { _outlineText = $"Outline failed: {ex.Message}"; }
        finally { _outlining = false; }
    }

    // ── Project management ──

    private void LoadProject(string id)
    {
        if (!string.IsNullOrWhiteSpace(_storyText)) Save();
        var loaded = Repo.LoadProject(id);
        if (loaded == null) return;
        _project = loaded;
        _project.EnsureChapters();
        _activeChapter = _project.Chapters.First().Number;
        _storyText = CurrentChapter?.Text ?? "";
        _error = null;
        UpdateWordCount();
        Nav.NavigateTo($"/write/{id}", replace: true);
    }

    private async Task ExportStory()
    {
        SyncChapter();
        var lines = new List<string> { $"# {_project.Title}", "" };
        foreach (var ch in _project.Chapters.OrderBy(c => c.Number))
        {
            if (!string.IsNullOrWhiteSpace(ch.Text))
            {
                lines.Add($"## {ch.Title}");
                lines.Add("");
                lines.Add(ch.Text);
                lines.Add("");
            }
        }
        var filename = _project.Title.Replace(" ", "_").Replace("\"", "").Replace("'", "") + ".txt";
        await JS.InvokeVoidAsync("writeInterop.downloadText", filename, string.Join("\n", lines));
    }

    private void NewStory()
    {
        if (!string.IsNullOrWhiteSpace(_storyText)) Save();
        _project = new StoryProject();
        _project.EnsureChapters();
        _activeChapter = 1;
        _storyText = "";
        _error = null;
        _saved = false;
        _wordCount = 0;
        Nav.NavigateTo("/write", replace: true);
    }

    // ── Audio ──

    private async Task SmartNarrate()
    {
        if (_narrating || string.IsNullOrWhiteSpace(_storyText)) return;

        try
        {
            var sel = await JS.InvokeAsync<SelectionInfo>("writeInterop.getSelection", "story-surface");
            if (sel != null && !string.IsNullOrWhiteSpace(sel.Text))
            {
                await NarrateText(sel.Text);
                return;
            }
        }
        catch { }

        await NarrateText(_storyText);
    }

    private async Task NarrateText(string text)
    {
        _narrating = true;
        _showAudioPlayer = true;
        _error = null;
        _audioPlayer?.SetLoading(true);
        StateHasChanged();

        try
        {
            _statusMessage = "Synthesizing narration...";
            StateHasChanged();

            byte[] audio;
            if (await TtsSvc.IsConfiguredAsync())
                audio = await TtsSvc.SynthesizeAsync(text);
            else
                audio = await DraftTts.SynthesizeAsync(text);

            if (_audioPlayer != null)
                await _audioPlayer.LoadAudioAsync(audio);
        }
        catch (Exception ex) { _audioPlayer?.SetError(ex.Message); }
        finally { _narrating = false; _statusMessage = ""; }
    }

    // ── Synchronize ──

    private async Task StartSync()
    {
        if (string.IsNullOrWhiteSpace(_storyText) || _syncing) return;
        _syncing = true;
        _showSync = true;
        _syncIssues = "";
        _syncPreview = "";
        _syncStatus = "Validating against world graph...";
        StateHasChanged();

        try
        {
            var session = new NarrativeSessionContext(Graph);
            session.ScanText(_storyText);
            var worldContext = session.BuildContext();
            var rulesContext = CanonDb.GetLiteraryRulesPrompt();

            var system = $"""
                You are a story editor validating cyberpunk fiction against its world database.
                The WORLD CONTEXT below is canonical truth from the world graph.

                WORLD CONTEXT:
                {worldContext}

                LITERARY RULES:
                {rulesContext}

                List EVERY issue as a numbered item. Categories: CANON, PLOT, VOICE, PACING, PROSE.
                Format: 1. [CATEGORY] "quoted problem" — what to fix
                If clean, say "No issues found."
                """;

            _syncIssues = await Llm.GenerateAsync(system, _storyText, 0.3, 4096);
        }
        catch (Exception ex) { _syncIssues = $"Analysis failed: {ex.Message}"; }
        finally { _syncing = false; _syncStatus = ""; }
    }

    private async Task RunSyncFixes()
    {
        if (string.IsNullOrWhiteSpace(_syncIssues) || _syncing) return;
        _syncing = true;
        _syncPreview = "";
        _syncStatus = "Applying fixes...";
        StateHasChanged();

        try
        {
            var system = """
                You are a literary editor fixing specific issues in cyberpunk fiction.
                Apply EVERY fix in the list. Do NOT change anything not listed.
                Preserve voice, structure, and meaning. Return the COMPLETE corrected text only.
                """;

            _syncPreview = await Llm.GenerateAsync(system,
                $"ISSUES TO FIX:\n{_syncIssues}\n\nORIGINAL TEXT:\n{_storyText}", 0.3, 8192);
        }
        catch (Exception ex) { _error = $"Synchronize failed: {ex.Message}"; }
        finally { _syncing = false; _syncStatus = ""; }
    }

    private async Task ApplySync()
    {
        if (string.IsNullOrEmpty(_syncPreview)) return;
        await SetEditorText(_syncPreview);
        UpdateWordCount();
        Save();
        CloseSync();
    }

    private void CloseSync()
    {
        _showSync = false;
        _syncIssues = "";
        _syncPreview = "";
    }

    // ── Entity Extraction ──

    private async Task RunExtractionAsync()
    {
        if (_extracting || string.IsNullOrWhiteSpace(_storyText)) return;
        _extracting = true;
        _graphStatus = "Scanning story for entities...";
        await InvokeAsync(StateHasChanged);

        try
        {
            var storyPoint = $"chapter:{_activeChapter}";
            var (entities, relationships) = await EntityExtract.ExtractAndMergeAsync(
                _storyText, _project.Id, storyPoint);
            _lastExtractedText = _storyText;

            // Auto-detect characters from extraction and update chapter/project
            await UpdateCharactersFromGraph();

            _graphStatus = entities > 0 || relationships > 0
                ? $"Graph updated: +{entities} entities, +{relationships} relationships"
                : "Graph up to date";
        }
        catch (Exception ex) { _graphStatus = $"Extraction failed: {ex.Message}"; }
        finally
        {
            _extracting = false;
            await InvokeAsync(StateHasChanged);
            _ = Task.Delay(5000).ContinueWith(_ =>
                InvokeAsync(() => { _graphStatus = null; StateHasChanged(); }));
        }
    }

    /// <summary>
    /// After entity extraction, scan the current chapter text against the graph
    /// to auto-detect which characters and locations appear. Updates both the
    /// chapter-level and project-level character lists.
    /// </summary>
    private Task UpdateCharactersFromGraph()
    {
        var ch = CurrentChapter;
        if (ch == null || string.IsNullOrWhiteSpace(_storyText)) return Task.CompletedTask;

        var session = new NarrativeSessionContext(Graph);
        session.ScanText(_storyText);
        var snapshot = session.GetSnapshot();

        // Update chapter characters/locations from what was detected
        var characters = snapshot.PrimaryEntities
            .Concat(snapshot.SecondaryEntities)
            .Where(e => e.NodeType == "character")
            .Select(e => e.Name)
            .Distinct()
            .ToList();

        var locations = snapshot.PrimaryEntities
            .Concat(snapshot.SecondaryEntities)
            .Where(e => e.NodeType == "place")
            .Select(e => e.Name)
            .Distinct()
            .ToList();

        // Only keep characters that are actually mentioned in the text (not just neighbors)
        var textLower = _storyText.ToLowerInvariant();
        ch.Characters = characters.Where(name => textLower.Contains(name.ToLowerInvariant())).ToList();
        ch.Locations = locations.Where(name => textLower.Contains(name.ToLowerInvariant())).ToList();

        // Update project-level character list with any new discoveries
        foreach (var name in ch.Characters)
        {
            if (!_project.Characters.Contains(name, StringComparer.OrdinalIgnoreCase))
                _project.Characters.Add(name);
        }

        return Task.CompletedTask;
    }

    // ── GhostWriter ──

    private bool HasGhostWriterSuggestions(int chapterNumber)
    {
        var filepath = Path.Combine(Paths.CanonRoot, "ghostwriter", $"{_project.Id}_ch{chapterNumber}.json");
        return File.Exists(filepath);
    }

    private void ShowGhostWriterSuggestions(int chapterNumber)
    {
        var filepath = Path.Combine(Paths.CanonRoot, "ghostwriter", $"{_project.Id}_ch{chapterNumber}.json");
        if (!File.Exists(filepath)) return;

        try
        {
            var json = File.ReadAllText(filepath);
            var doc = System.Text.Json.JsonDocument.Parse(json);
            _ghostIssues = doc.RootElement.GetProperty("Issues").GetString() ?? "";
            _ghostChapterNum = chapterNumber;
            _ghostPreview = "";
            _ghostApplying = false;
            _showGhostWriter = true;
        }
        catch { }
    }

    private async Task RunGhostFixes()
    {
        if (string.IsNullOrWhiteSpace(_ghostIssues) || _ghostApplying) return;
        _ghostApplying = true;
        _ghostPreview = "";
        StateHasChanged();

        try
        {
            var chapter = _project.Chapters.FirstOrDefault(c => c.Number == _ghostChapterNum);
            if (chapter == null || string.IsNullOrWhiteSpace(chapter.Text)) return;

            var system = """
                You are a literary editor fixing specific issues in cyberpunk fiction.
                Apply EVERY fix in the list. Do NOT change anything not listed.
                Preserve voice, structure, and meaning. Return the COMPLETE corrected text only.
                """;

            _ghostPreview = await Llm.GenerateAsync(system,
                $"ISSUES TO FIX:\n{_ghostIssues}\n\nORIGINAL TEXT:\n{chapter.Text}", 0.3, 8192);
        }
        catch (Exception ex) { _error = $"GhostWriter fix failed: {ex.Message}"; }
        finally { _ghostApplying = false; }
    }

    private async Task ApplyGhostFixes()
    {
        if (string.IsNullOrEmpty(_ghostPreview)) return;
        var chapter = _project.Chapters.FirstOrDefault(c => c.Number == _ghostChapterNum);
        if (chapter == null) return;

        chapter.Text = _ghostPreview;
        chapter.Modified = DateTime.UtcNow;

        if (_ghostChapterNum == _activeChapter)
        {
            await SetEditorText(_ghostPreview);
            UpdateWordCount();
        }

        Save();
        DismissGhost();
    }

    private void DismissGhost()
    {
        var filepath = Path.Combine(Paths.CanonRoot, "ghostwriter", $"{_project.Id}_ch{_ghostChapterNum}.json");
        if (File.Exists(filepath)) File.Delete(filepath);
        _showGhostWriter = false;
        _ghostIssues = "";
        _ghostPreview = "";
    }

    // ── Cleanup ──

    public void Dispose()
    {
        if (_dirty)
        {
            SyncChapter();
            _project.SyncBlocksFromChapters();
            Repo.SaveProject(_project);
        }
        _saveTimer?.Dispose();
        _editorRef?.Dispose();
        _miniGraphRef?.Dispose();
    }

