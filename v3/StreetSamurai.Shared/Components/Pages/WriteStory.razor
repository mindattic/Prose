    private async Task RunValidation()
    {
        showValidateModal = true;
        validating = true;
        validateProgress = "Preparing...";
        validateCompleted = 0;
        validateTotal = 0;
        validationResults.Clear();
        StateHasChanged();

        void OnProgress(string message, int completed, int total)
        {
            validateProgress = message;
            validateCompleted = completed;
            validateTotal = total;
            InvokeAsync(StateHasChanged);
        }

        Validator.OnValidationProgress += OnProgress;
        try
        {
            var session = new NarrativeSessionContext(Graph);
            session.ScanText(storyText);
            var worldContext = session.BuildContext();
            validationResults = await Validator.ValidateDeepAsync(storyText, worldContext);
            SaveValidationState();
        }
        catch (Exception ex) { error = $"Validation failed: {ex.Message}"; }
        finally
        {
            Validator.OnValidationProgress -= OnProgress;
            validating = false;
        }
    }

    private async Task ResolveKeepCanon(int idx)
    {
        if (idx < 0 || idx >= validationResults.Count) return;
        var issue = validationResults[idx];
        if (string.IsNullOrEmpty(issue.StoryText) || string.IsNullOrEmpty(issue.CanonTruth)) return;

        // Replace the contradicting text in the editor with the canon truth
        richHtml = richHtml.Replace(issue.StoryText, issue.CanonTruth);
        storyText = storyText.Replace(issue.StoryText, issue.CanonTruth);
        await JS.InvokeVoidAsync("writeInterop.richEditor.setHtml", "story-surface", richHtml);
        Save();
        validationResults.RemoveAt(idx);
        SaveValidationState();
    }


    private void ResolveUpdateCanon(int idx, string canonFix)
    {
        if (idx < 0 || idx >= validationResults.Count) return;
        var issue = validationResults[idx];
        if (string.IsNullOrEmpty(issue.EntityName)) return;

        // Find the entity in the graph and update its canon truth
        var node = Graph.AllNodes()
            .FirstOrDefault(n => n.Name.Equals(issue.EntityName, StringComparison.OrdinalIgnoreCase));
        if (node != null)
        {
            // Update the relevant property — canon_truth stores what was wrong, canon_fix stores the correction
            node.Properties["canon_override"] = canonFix;
            // Also update description if the canon truth was from the description
            if (node.Properties.TryGetValue("description", out var desc) &&
                desc.Contains(issue.CanonTruth, StringComparison.OrdinalIgnoreCase))
            {
                node.Properties["description"] = desc.Replace(issue.CanonTruth, canonFix);
            }
            Graph.Save();
        }

        validationResults.RemoveAt(idx);
        SaveValidationState();
    }

    private async Task ResolveWithAlternative(int idx, string altText)
    {
        if (idx < 0 || idx >= validationResults.Count) return;
