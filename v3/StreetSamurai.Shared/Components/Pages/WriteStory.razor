@page "/write"
@page "/write/{ProjectId}"
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@inject StoryStarterService Starter
@inject CanonService Canon
@inject IStoryBlockRepository Repo
@inject NavigationManager Nav
@inject ElevenLabsTtsService TtsSvc
@inject TtsEnhancementService TtsEnhance
@inject EntityExtractionService EntityExtract
@inject IJSRuntime JS
@implements IDisposable

@* ── Toolbar ──────────────────────────────────────────── *@
<div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
    <div class="input-group" style="max-width: 140px;">
        <span class="input-group-text bg-dark text-muted border-secondary" style="font-size: 0.7rem;">PREFIX</span>
        <input type="text" class="form-control form-control-sm bg-dark text-warning border-secondary fw-bold text-uppercase"
               style="max-width: 70px; font-family: monospace;"
               maxlength="6"
               value="@_project.Prefix"
               @onchange="OnPrefixChanged" />
    </div>
    <input type="text" class="form-control bg-dark text-danger border-0 fw-bold fst-italic flex-grow-1"
           style="font-family: Georgia, serif; font-size: 1.4rem; max-width: 400px;"
           placeholder="Untitled"
           @bind="_project.Title"
           @bind:after="Save" />

    <button class="btn btn-sm @(_saved ? "btn-outline-secondary" : "btn-success")" @onclick="ForceSave" title="Save now">
        <i class="bi bi-floppy"></i> @(_saved ? "Saved" : "Save")
    </button>

    @if (_prefixError != null)
    {
        <span class="badge bg-danger">@_prefixError</span>
    }
    <small class="text-muted">@_wordCount words</small>

    <div class="ms-auto d-flex gap-1">
        <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleProjectList" title="Your stories">
            <i class="bi bi-folder2-open"></i>
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="NewStory" title="New story">
            <i class="bi bi-plus-lg"></i>
        </button>
    </div>
</div>

@* ── Action Bar ───────────────────────────────────────── *@
<div class="d-flex gap-2 mb-2 flex-wrap">
    <button class="btn btn-sm btn-danger" @onclick="OpenAssist" disabled="@_generating" title="Open AI Assist to generate or continue content">
        <i class="bi bi-stars"></i> AI Assist
    </button>
    <button class="btn btn-sm btn-outline-danger" @onclick="ContinueStory" disabled="@(_generating || string.IsNullOrWhiteSpace(_storyText))" title="Continue the story from where it left off">
        <i class="bi bi-pen"></i> Continue
    </button>
    <button class="btn btn-sm btn-outline-warning" @onclick="RewriteSelection" disabled="@_generating" title="Rewrite highlighted text — select a passage first">
        <i class="bi bi-arrow-repeat"></i> Rewrite Selection
    </button>
    @if (_ttsAvailable)
    {
        <button class="btn btn-sm btn-outline-danger" @onclick="NarrateAll" disabled="@(_generating || _narrating || string.IsNullOrWhiteSpace(_storyText))" title="Narrate the full story">
            @if (_narrating) { <span class="spinner-border spinner-border-sm"></span> }
            else { <i class="bi bi-volume-up"></i> }
            Narrate
        </button>
        <button class="btn btn-sm btn-outline-secondary" @onclick="NarrateSelection" disabled="@(_generating || _narrating)" title="Narrate only the highlighted text">
            <i class="bi bi-megaphone"></i> Narrate Selection
        </button>
    }
</div>

@* ── Project List (collapsible) ───────────────────────── *@
@if (_showProjectList)
{
    <div class="card bg-dark border-secondary mb-2">
        <div class="card-header text-muted d-flex justify-content-between py-1">
            <small>Your Stories</small>
            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => _showProjectList = false">
                <i class="bi bi-x"></i>
            </button>
        </div>
        <div class="card-body p-0" style="max-height: 200px; overflow-y: auto;">
            @if (_projects.Count == 0)
            {
                <p class="text-muted p-2 mb-0 small">No stories yet.</p>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var p in _projects)
                    {
                        <button class="list-group-item list-group-item-action bg-dark text-light border-secondary py-1 d-flex justify-content-between"
                                @onclick="() => LoadProject(p.Id)">
                            <div>
                                <code class="text-warning me-1" style="font-size: 0.7rem;">@p.Prefix</code>
                                <span class="fst-italic small">@p.Title</span>
                            </div>
                            <small class="text-muted">@p.Modified.ToString("MMM dd HH:mm")</small>
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}

@* ── Generating Indicator ─────────────────────────────── *@
@if (_generating)
{
    <div class="d-flex align-items-center gap-2 mb-2">
        <div class="spinner-border spinner-border-sm text-danger"></div>
        <small class="text-muted">@_statusMessage</small>
    </div>
}

@* ── Writing Surface ──────────────────────────────────── *@
<textarea id="story-surface"
          class="form-control bg-dark text-light border-secondary w-100"
          style="font-family: Georgia, 'Times New Roman', serif; font-size: 16px; line-height: 1.8; resize: none; min-height: calc(100vh - 260px); color: #ddd !important;"
          placeholder="Start writing, paste in content, or click AI Assist to generate..."
          @bind="_storyText"
          @bind:event="oninput"
          @bind:after="OnTextChanged"></textarea>

@* ── Right-Click Context Menu ──────────────────────────── *@
@if (_showContextMenu)
{
    <div class="story-context-menu position-fixed bg-dark border border-secondary rounded shadow-lg py-1"
         style="top: @(_menuTop)px; left: @(_menuLeft)px; z-index: 1060; min-width: 180px;">
        <button class="dropdown-item text-light d-flex align-items-center gap-2 px-3 py-2" @onclick="ContextRewrite">
            <i class="bi bi-arrow-repeat text-warning"></i> <span>Rewrite</span>
        </button>
        <div class="dropdown-divider border-secondary my-1"></div>
        @if (_ttsAvailable)
        {
            <button class="dropdown-item text-light d-flex align-items-center gap-2 px-3 py-2" @onclick="ContextNarrate" disabled="@_narrating">
                <i class="bi bi-volume-up text-danger"></i> <span>Narrate Selection</span>
            </button>
            <button class="dropdown-item text-light d-flex align-items-center gap-2 px-3 py-2" @onclick="ContextNarrateAll" disabled="@_narrating">
                <i class="bi bi-megaphone text-danger"></i> <span>Narrate All</span>
            </button>
            <div class="dropdown-divider border-secondary my-1"></div>
        }
        <button class="dropdown-item text-light d-flex align-items-center gap-2 px-3 py-2" @onclick="ContextContinue" disabled="@_generating">
            <i class="bi bi-pen text-danger"></i> <span>Continue Story</span>
        </button>
    </div>
}

@* ── Audio Player ─────────────────────────────────────── *@
<AudioPlayer @ref="_audioPlayer" Visible="_showAudioPlayer" OnDismissed="() => _showAudioPlayer = false" CssClass="mt-2" />

@if (_error != null)
{
    <div class="alert alert-warning mt-2 py-1 small">@_error</div>
}

@if (_graphStatus != null)
{
    <div class="d-flex align-items-center gap-2 mt-1">
        @if (_extracting)
        {
            <div class="spinner-border spinner-border-sm text-info" style="width: 0.8rem; height: 0.8rem;"></div>
        }
        else
        {
            <i class="bi bi-diagram-3 text-info" style="font-size: 0.75rem;"></i>
        }
        <small class="text-muted" style="font-size: 0.7rem;">@_graphStatus</small>
    </div>
}

@* ── AI Assist Modal ──────────────────────────────────── *@
@if (_showAssist)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="CloseAssist">
        <div class="card bg-dark text-light border-danger" style="width: 600px; max-height: 80vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-danger fw-bold"><i class="bi bi-stars"></i> AI Assist</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseAssist"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label text-muted small">What should happen next?</label>
                    <textarea class="form-control bg-dark text-light border-secondary"
                              rows="3"
                              placeholder="@(_hasExistingText ? "Give the engine a direction — 'continue', 'Kyle enters the building', or describe a full scene..." : "A premise to start from — who, where, what's happening...")"
                              @bind="_assistPrompt"
                              @onkeydown="HandleAssistKeyDown"
                              style="font-family: Georgia, serif;"></textarea>
                </div>

                @* Options *@
                <div class="mb-3">
                    <a href="javascript:void(0)" class="text-muted small text-decoration-none" @onclick="() => _showAssistOptions = !_showAssistOptions">
                        <i class="bi @(_showAssistOptions ? "bi-chevron-up" : "bi-chevron-down")"></i> Options
                    </a>
                </div>
                @if (_showAssistOptions)
                {
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Mood</label>
                            <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="_project.Mood">
                                <option value="">-- Engine decides --</option>
                                <option value="desperate and claustrophobic">Desperate</option>
                                <option value="slow burn dread">Slow burn dread</option>
                                <option value="electric and kinetic">Electric</option>
                                <option value="melancholic and beautiful">Melancholic</option>
                                <option value="paranoid and fractured">Paranoid</option>
                                <option value="tender amid violence">Tender amid violence</option>
                                <option value="dark humor and irony">Dark humor</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Location</label>
                            <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="_project.Location">
                                <option value="">-- Anywhere --</option>
                                @foreach (var d in _districts)
                                {
                                    <option value="@d.Name">@d.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Characters</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                                   placeholder="Kyle, Sable..."
                                   @bind="_charactersInput" />
                        </div>
                    </div>
                }

                @* Mode selection *@
                <div class="mb-3 d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="modeAppend" value="append"
                               checked="@(_assistMode == "append")" @onchange='() => _assistMode = "append"' />
                        <label class="form-check-label text-muted small" for="modeAppend">Append to end</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="modeInsert" value="insert"
                               checked="@(_assistMode == "insert")" @onchange='() => _assistMode = "insert"' />
                        <label class="form-check-label text-muted small" for="modeInsert">Insert at cursor</label>
                    </div>
                </div>

                @if (_assistGenerating)
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="spinner-border spinner-border-sm text-danger"></div>
                        <small class="text-muted">@_statusMessage</small>
                    </div>
                }

                @if (string.IsNullOrEmpty(_assistPreview))
                {
                    <button class="btn btn-danger" @onclick="AssistGenerate"
                            disabled="@(string.IsNullOrWhiteSpace(_assistPrompt) || _assistGenerating)">
                        <i class="bi bi-pen"></i> Generate
                    </button>
                    @if (!_hasExistingText)
                    {
                        <button class="btn btn-outline-danger ms-2" @onclick="AssistSurprise" disabled="@_assistGenerating">
                            <i class="bi bi-shuffle"></i> Surprise Me
                        </button>
                    }
                }
                else
                {
                    @* Preview *@
                    <div class="mb-3">
                        <label class="form-label text-muted small">Preview (edit before inserting)</label>
                        <textarea class="form-control bg-dark text-light border-secondary"
                                  rows="8"
                                  style="font-family: Georgia, serif; font-size: 15px; line-height: 1.7;"
                                  @bind="_assistPreview"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-success" @onclick="AssistInsert">
                            <i class="bi bi-box-arrow-in-down"></i> Insert
                        </button>
                        <button class="btn btn-outline-danger" @onclick="AssistGenerate" disabled="@_assistGenerating">
                            <i class="bi bi-arrow-repeat"></i> Regenerate
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="AssistDiscard">Discard</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ── Rewrite Modal ────────────────────────────────────── *@
@if (_showRewrite)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="CloseRewrite">
        <div class="card bg-dark text-light border-warning" style="width: 600px; max-height: 80vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-warning fw-bold"><i class="bi bi-arrow-repeat"></i> Rewrite Selection</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseRewrite"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label text-muted small">Selected passage:</label>
                    <div class="bg-black rounded p-2 small" style="font-family: Georgia, serif; line-height: 1.6; max-height: 120px; overflow-y: auto; color: #999;">
                        @_rewriteOriginal
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted small">Direction (optional)</label>
                    <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                           placeholder="e.g. 'make it more tense', 'add sensory detail', or leave blank for a straight polish"
                           @bind="_rewriteDirection" />
                </div>

                @if (_rewriteGenerating)
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="spinner-border spinner-border-sm text-warning"></div>
                        <small class="text-muted">Rewriting...</small>
                    </div>
                }

                @if (string.IsNullOrEmpty(_rewritePreview))
                {
                    <button class="btn btn-warning text-dark" @onclick="DoRewrite" disabled="@_rewriteGenerating">
                        <i class="bi bi-arrow-repeat"></i> Rewrite
                    </button>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label text-muted small">Rewritten (edit before applying)</label>
                        <textarea class="form-control bg-dark text-light border-secondary"
                                  rows="6"
                                  style="font-family: Georgia, serif; font-size: 15px; line-height: 1.7;"
                                  @bind="_rewritePreview"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-success" @onclick="ApplyRewrite">
                            <i class="bi bi-check-lg"></i> Apply
                        </button>
                        <button class="btn btn-outline-warning" @onclick="DoRewrite" disabled="@_rewriteGenerating">
                            <i class="bi bi-arrow-repeat"></i> Regenerate
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="CloseRewrite">Discard</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? ProjectId { get; set; }

    // ── Core state ──
    private StoryProject _project = new();
    private string _storyText = "";
    private string _charactersInput = "";
    private int _wordCount;
    private bool _saved;
    private string? _prefixError;
    private string? _error;
    private bool _generating => _assistGenerating || _rewriteGenerating;
    private string _statusMessage = "";

    // ── Project list ──
    private bool _showProjectList;
    private List<StoryProject> _projects = [];
    private List<District> _districts = [];

    // ── AI Assist ──
    private bool _showAssist;
    private bool _showAssistOptions;
    private string _assistPrompt = "";
    private string _assistMode = "append";
    private string _assistPreview = "";
    private bool _assistGenerating;
    private string? _assistTitle;
    private int _cursorPosition;

    // ── Rewrite ──
    private bool _showRewrite;
    private string _rewriteOriginal = "";
    private string _rewriteDirection = "";
    private string _rewritePreview = "";
    private bool _rewriteGenerating;
    private int _rewriteStart;
    private int _rewriteEnd;

    // ── Audio ──
    private bool _ttsAvailable;
    private bool _narrating;
    private bool _showAudioPlayer;
    private AudioPlayer? _audioPlayer;

    // ── Entity extraction ──
    private bool _extracting;
    private string? _graphStatus;
    private string _lastExtractedText = "";

    // ── Context menu ──
    private bool _showContextMenu;
    private double _menuTop;
    private double _menuLeft;
    private DotNetObjectReference<WriteStory>? _dotNetRef;

    // ── Auto-save timer ──
    private System.Threading.Timer? _saveTimer;
    private bool _dirty;

    private bool _hasExistingText => !string.IsNullOrWhiteSpace(_storyText);

    protected override async Task OnInitializedAsync()
    {
        _districts = Canon.ListDistricts();
        _ttsAvailable = await TtsSvc.IsConfiguredAsync();
        _projects = Repo.ListProjects();

        if (!string.IsNullOrEmpty(ProjectId))
        {
            var loaded = Repo.LoadProject(ProjectId);
            if (loaded != null)
            {
                _project = loaded;
                _storyText = loaded.FullText;
                _charactersInput = string.Join(", ", _project.Characters);
            }
        }

        UpdateWordCount();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("writeInterop.watchRightClick", "story-surface", _dotNetRef);
            if (!string.IsNullOrEmpty(_storyText))
                await JS.InvokeVoidAsync("writeInterop.focusEnd", "story-surface");
        }
    }

    [JSInvokable]
    public void OnContextMenu(double top, double left)
    {
        _menuTop = top;
        _menuLeft = left;
        _showContextMenu = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnDismissContextMenu()
    {
        if (_showContextMenu)
        {
            _showContextMenu = false;
            StateHasChanged();
        }
    }

    private async Task ContextRewrite()
    {
        _showContextMenu = false;
        await RewriteSelection();
    }

    private async Task ContextNarrate()
    {
        _showContextMenu = false;
        await NarrateSelection();
    }

    private async Task ContextNarrateAll()
    {
        _showContextMenu = false;
        await NarrateAll();
    }

    private async Task ContextContinue()
    {
        _showContextMenu = false;
        await ContinueStory();
    }

    // ── Text changes ──

    private void OnTextChanged()
    {
        UpdateWordCount();
        _dirty = true;
        _saved = false;

        // Debounce: save 2 seconds after last keystroke
        _saveTimer?.Dispose();
        _saveTimer = new System.Threading.Timer(_ =>
        {
            if (_dirty) InvokeAsync(Save);
        }, null, 2000, Timeout.Infinite);
    }

    private void UpdateWordCount()
    {
        _wordCount = string.IsNullOrWhiteSpace(_storyText)
            ? 0
            : _storyText.Split((char[])[' ', '\n', '\r', '\t'], StringSplitOptions.RemoveEmptyEntries).Length;
    }

    // ── Persistence ──

    private void Save()
    {
        SyncCharacters();
        SyncBlocks();
        Repo.SaveProject(_project);
        _saved = true;
        _dirty = false;
        InvokeAsync(StateHasChanged);
    }

    private void ForceSave()
    {
        Save();
        StateHasChanged();
        // Run entity extraction in the background after explicit save
        if (!string.IsNullOrWhiteSpace(_storyText) && _storyText != _lastExtractedText)
            _ = RunExtractionAsync();
    }

    private void SyncBlocks()
    {
        // Rebuild blocks from the textarea text
        _project.Blocks.Clear();
        if (!string.IsNullOrWhiteSpace(_storyText))
            _project.AddBlocksFromText(_storyText);
        _project.Modified = DateTime.UtcNow;
    }

    private void SyncCharacters()
    {
        _project.Characters = _charactersInput
            .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .ToList();
    }

    // ── Prefix ──

    private void OnPrefixChanged(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        var newPrefix = StoryProject.SanitizePrefix(raw);
        _prefixError = null;

        if (string.IsNullOrEmpty(newPrefix))
        {
            _prefixError = "Prefix required";
            return;
        }
        if (newPrefix == _project.Prefix) return;
        if (Repo.PrefixExists(newPrefix, _project.Id))
        {
            _prefixError = $"{newPrefix} already in use";
            return;
        }

        if (Repo.LoadProject(_project.Id) != null)
            _project = Repo.RenamePrefix(_project.Id, newPrefix);
        else
            _project.RenamePrefix(newPrefix);

        _saved = false;
    }

    // ── Project management ──

    private void ToggleProjectList()
    {
        _projects = Repo.ListProjects();
        _showProjectList = !_showProjectList;
    }

    private void LoadProject(string id)
    {
        var loaded = Repo.LoadProject(id);
        if (loaded == null) return;

        _project = loaded;
        _storyText = loaded.FullText;
        _charactersInput = string.Join(", ", _project.Characters);
        _error = null;
        _prefixError = null;
        _showProjectList = false;
        UpdateWordCount();
        Nav.NavigateTo($"/write/{id}", replace: true);
    }

    private void NewStory()
    {
        _project = new StoryProject();
        _storyText = "";
        _charactersInput = "";
        _error = null;
        _prefixError = null;
        _saved = false;
        _wordCount = 0;
        Nav.NavigateTo("/write", replace: true);
    }

    // ── AI Assist ──

    private async Task OpenAssist()
    {
        _assistPreview = "";
        _assistPrompt = "";
        _assistTitle = null;
        _showAssist = true;

        // Capture cursor position for "insert at cursor" mode
        try
        {
            _cursorPosition = await JS.InvokeAsync<int>("writeInterop.getCursorPosition", "story-surface");
        }
        catch { _cursorPosition = _storyText.Length; }
    }

    private void CloseAssist()
    {
        _showAssist = false;
        _assistPreview = "";
    }

    private void AssistDiscard()
    {
        _assistPreview = "";
        _assistTitle = null;
    }

    private async Task AssistGenerate()
    {
        if (string.IsNullOrWhiteSpace(_assistPrompt)) return;
        _assistGenerating = true;
        _assistPreview = "";
        _error = null;
        SyncCharacters();
        StateHasChanged();

        try
        {
            if (!_hasExistingText)
            {
                _statusMessage = "Writing the opening...";
                StateHasChanged();

                var request = new StoryStarterRequest
                {
                    Premise = _assistPrompt,
                    Mood = string.IsNullOrEmpty(_project.Mood) ? null : _project.Mood,
                    Location = string.IsNullOrEmpty(_project.Location) ? null : _project.Location,
                    Characters = _project.Characters,
                };

                var opening = await Starter.GenerateOpeningAsync(request);
                _assistPreview = opening.Text;
                _assistTitle = opening.Title;
            }
            else
            {
                _statusMessage = "Continuing the story...";
                StateHasChanged();

                var paragraphs = _storyText
                    .Split(["\n\n", "\r\n\r\n"], StringSplitOptions.RemoveEmptyEntries)
                    .Select(p => p.Trim()).Where(p => p.Length > 0).ToList();

                var text = await Starter.ContinueAsync(
                    paragraphs, _assistPrompt,
                    string.IsNullOrEmpty(_project.Mood) ? null : _project.Mood,
                    string.IsNullOrEmpty(_project.Location) ? null : _project.Location,
                    _project.Characters);

                _assistPreview = text;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _assistGenerating = false;
            _statusMessage = "";
        }
    }

    private async Task AssistSurprise()
    {
        _assistGenerating = true;
        _assistPreview = "";
        _statusMessage = "Rolling dice against the canon...";
        StateHasChanged();

        try
        {
            var opening = await Starter.GenerateRandomAsync();
            _assistPreview = opening.Text;
            _assistTitle = opening.Title;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _assistGenerating = false;
            _statusMessage = "";
        }
    }

    private async Task AssistInsert()
    {
        if (string.IsNullOrEmpty(_assistPreview)) return;

        // Set title if this is a new story
        if (_assistTitle != null && _project.Title is "Untitled" or "")
            _project.Title = _assistTitle;

        if (_assistMode == "insert" && _cursorPosition < _storyText.Length)
        {
            // Insert at cursor position
            var separator = _cursorPosition > 0 && _storyText[_cursorPosition - 1] != '\n' ? "\n\n" : "";
            var newValue = await JS.InvokeAsync<string>("writeInterop.insertText",
                "story-surface", _cursorPosition, separator + _assistPreview);
            _storyText = newValue;
        }
        else
        {
            // Append
            if (!string.IsNullOrWhiteSpace(_storyText))
                _storyText += "\n\n";
            _storyText += _assistPreview;
            await JS.InvokeVoidAsync("writeInterop.setText", "story-surface", _storyText);
        }

        UpdateWordCount();
        _showAssist = false;
        _assistPreview = "";
        _assistTitle = null;
        Save();
        _ = RunExtractionAsync();

        await JS.InvokeVoidAsync("writeInterop.focusEnd", "story-surface");
    }

    private async Task HandleAssistKeyDown(KeyboardEventArgs e)
    {
        if (e is { Key: "Enter", CtrlKey: true })
            await AssistGenerate();
    }

    // ── Direct Continue (no modal) ──

    private async Task ContinueStory()
    {
        if (string.IsNullOrWhiteSpace(_storyText) || _generating) return;
        _assistGenerating = true;
        _error = null;
        _statusMessage = "Continuing the story...";
        SyncCharacters();
        StateHasChanged();

        try
        {
            var paragraphs = _storyText
                .Split(["\n\n", "\r\n\r\n"], StringSplitOptions.RemoveEmptyEntries)
                .Select(p => p.Trim()).Where(p => p.Length > 0).ToList();

            var text = await Starter.ContinueAsync(
                paragraphs, "continue",
                string.IsNullOrEmpty(_project.Mood) ? null : _project.Mood,
                string.IsNullOrEmpty(_project.Location) ? null : _project.Location,
                _project.Characters);

            _storyText += "\n\n" + text;
            await JS.InvokeVoidAsync("writeInterop.setText", "story-surface", _storyText);
            UpdateWordCount();
            Save();
            _ = RunExtractionAsync();
            await JS.InvokeVoidAsync("writeInterop.focusEnd", "story-surface");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _assistGenerating = false;
            _statusMessage = "";
        }
    }

    // ── Rewrite Selection ──

    private async Task RewriteSelection()
    {
        try
        {
            var sel = await JS.InvokeAsync<SelectionInfo>("writeInterop.getSelection", "story-surface");
            if (sel == null || string.IsNullOrWhiteSpace(sel.Text))
            {
                _error = "Select some text first, then click Rewrite Selection.";
                return;
            }

            _rewriteOriginal = sel.Text;
            _rewriteStart = sel.Start;
            _rewriteEnd = sel.End;
            _rewriteDirection = "";
            _rewritePreview = "";
            _showRewrite = true;
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"Could not read selection: {ex.Message}";
        }
    }

    private void CloseRewrite()
    {
        _showRewrite = false;
        _rewritePreview = "";
    }

    private async Task DoRewrite()
    {
        _rewriteGenerating = true;
        _rewritePreview = "";
        SyncCharacters();
        StateHasChanged();

        try
        {
            var result = await Starter.RewriteAsync(
                _rewriteOriginal,
                string.IsNullOrWhiteSpace(_rewriteDirection) ? null : _rewriteDirection,
                string.IsNullOrEmpty(_project.Mood) ? null : _project.Mood,
                string.IsNullOrEmpty(_project.Location) ? null : _project.Location,
                _project.Characters);

            _rewritePreview = result.Trim();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _rewriteGenerating = false;
        }
    }

    private async Task ApplyRewrite()
    {
        if (string.IsNullOrEmpty(_rewritePreview)) return;

        var newValue = await JS.InvokeAsync<string>("writeInterop.replaceRange",
            "story-surface", _rewriteStart, _rewriteEnd, _rewritePreview);
        _storyText = newValue;

        UpdateWordCount();
        _showRewrite = false;
        _rewritePreview = "";
        Save();
    }

    // ── Audio ──

    private async Task NarrateAll()
    {
        if (string.IsNullOrWhiteSpace(_storyText) || _narrating) return;
        await NarrateText(_storyText);
    }

    private async Task NarrateSelection()
    {
        if (_narrating) return;
        try
        {
            var sel = await JS.InvokeAsync<SelectionInfo>("writeInterop.getSelection", "story-surface");
            if (sel == null || string.IsNullOrWhiteSpace(sel.Text))
            {
                _error = "Select some text first, then click Narrate Selection.";
                return;
            }
            await NarrateText(sel.Text);
        }
        catch (Exception ex)
        {
            _error = $"Could not read selection: {ex.Message}";
        }
    }

    private async Task NarrateText(string text)
    {
        _narrating = true;
        _showAudioPlayer = true;
        _error = null;
        _audioPlayer?.SetLoading(true);
        StateHasChanged();

        try
        {
            // Enhance with ElevenLabs audio tags for expressive narration
            _statusMessage = "Enhancing text for narration...";
            StateHasChanged();
            var enhanced = await TtsEnhance.EnhanceForNarrationAsync(text);

            _statusMessage = "Synthesizing with Oliver Silk...";
            StateHasChanged();
            var audio = await TtsSvc.SynthesizeAsync(enhanced);
            if (_audioPlayer != null)
                await _audioPlayer.LoadAudioAsync(audio);
        }
        catch (Exception ex)
        {
            _audioPlayer?.SetError(ex.Message);
        }
        finally
        {
            _narrating = false;
            _statusMessage = "";
        }
    }

    // ── Entity Extraction ──

    private async Task RunExtractionAsync()
    {
        if (_extracting || string.IsNullOrWhiteSpace(_storyText)) return;
        _extracting = true;
        _graphStatus = "Scanning story for entities...";
        await InvokeAsync(StateHasChanged);

        try
        {
            var (entities, relationships) = await EntityExtract.ExtractAndMergeAsync(_storyText, _project.Id);
            _lastExtractedText = _storyText;

            if (entities > 0 || relationships > 0)
                _graphStatus = $"Graph updated: +{entities} entities, +{relationships} relationships";
            else
                _graphStatus = "Graph up to date";
        }
        catch (Exception ex)
        {
            _graphStatus = $"Extraction failed: {ex.Message}";
        }
        finally
        {
            _extracting = false;
            await InvokeAsync(StateHasChanged);

            // Clear status after 5 seconds
            _ = Task.Delay(5000).ContinueWith(_ =>
                InvokeAsync(() => { _graphStatus = null; StateHasChanged(); }));
        }
    }

    // ── Cleanup ──

    public void Dispose()
    {
        // Final save if dirty
        if (_dirty)
        {
            SyncCharacters();
            SyncBlocks();
            Repo.SaveProject(_project);
        }
        _saveTimer?.Dispose();
        try { JS.InvokeVoidAsync("writeInterop.unwatchRightClick", "story-surface"); } catch { }
        _dotNetRef?.Dispose();
    }

    // ── JS Interop types ──

    private record SelectionInfo(int Start, int End, string Text);
}
