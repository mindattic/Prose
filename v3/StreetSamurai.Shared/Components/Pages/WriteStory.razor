@page "/write"
@page "/write/{ProjectId}"
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@inject StoryStarterService Starter
@inject CanonService Canon
@inject IStoryBlockRepository Repo
@inject NavigationManager Nav
@inject ElevenLabsTtsService TtsSvc
@inject WindowsTtsService DraftTts
@inject TtsEnhancementService TtsEnhance
@inject EntityExtractionService EntityExtract
@inject ILlmService Llm
@inject CanonDatabaseService CanonDb
@inject IJSRuntime JS
@implements IDisposable

@* ── Toolbar ──────────────────────────────────────────── *@
<div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
    <input type="text" class="form-control bg-dark text-danger border-0 fw-bold fst-italic flex-grow-1"
           style="font-family: Georgia, serif; font-size: 1.4rem; max-width: 400px;"
           placeholder="Untitled"
           @bind="_project.Title"
           @bind:after="Save" />

    <button class="btn btn-sm @(_saved ? "btn-outline-secondary" : "btn-success")" @onclick="ForceSave" title="Save now">
        <i class="bi bi-floppy"></i> @(_saved ? "Saved" : "Save")
    </button>

    <small class="text-muted">@_wordCount words</small>

    <div class="ms-auto">
        <button class="btn btn-sm btn-outline-danger" @onclick="NewStory" title="New story">
            <i class="bi bi-plus-lg"></i> New Story
        </button>
    </div>
</div>

@* ── Action Bar ───────────────────────────────────────── *@
<div class="d-flex gap-2 mb-2 flex-wrap">
    <button class="btn btn-sm btn-danger" @onclick="OpenAssist" disabled="@_generating" title="Open AI Assist to generate or continue content">
        <i class="bi bi-stars"></i> AI Assist
    </button>
    <button class="btn btn-sm btn-outline-danger" @onclick="ContinueStory" disabled="@(_generating || string.IsNullOrWhiteSpace(_storyText))" title="Continue the story from where it left off">
        <i class="bi bi-pen"></i> Continue
    </button>
    <button class="btn btn-sm btn-outline-warning" @onclick="RewriteSelection" disabled="@_generating" title="Rewrite highlighted text — select a passage first">
        <i class="bi bi-arrow-repeat"></i> Rewrite Selection
    </button>
    @if (_confirmNarrateAll)
    {
        <span class="d-flex align-items-center gap-1">
            <small class="text-warning">Narrate entire chapter (@_wordCount words)?</small>
            <button class="btn btn-sm btn-danger" @onclick="DoNarrateAll">Yes</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmNarrateAll = false">No</button>
        </span>
    }
    else if (_confirmProfessional)
    {
        <span class="d-flex align-items-center gap-1">
            <small class="text-warning">Use ElevenLabs (costs credits)?</small>
            <button class="btn btn-sm btn-danger" @onclick="ConfirmProfessionalNarrate">Yes</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmProfessional = false">No</button>
        </span>
    }
    else
    {
        <button class="btn btn-sm btn-outline-danger" @onclick="SmartNarrate" disabled="@(_generating || _narrating || string.IsNullOrWhiteSpace(_storyText))" title="Draft narrate (free) — select text or narrate all">
            @if (_narrating) { <span class="spinner-border spinner-border-sm"></span> }
            else { <i class="bi bi-volume-up"></i> }
            Narrate
        </button>
        @if (_ttsAvailable)
        {
            <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmProfessional = true" disabled="@(_generating || _narrating || string.IsNullOrWhiteSpace(_storyText))" title="Professional narration with Oliver Silk (ElevenLabs — costs credits)">
                <i class="bi bi-star-fill"></i> Pro
            </button>
        }
    }
    <button class="btn btn-sm btn-outline-info" @onclick="StartSync" disabled="@(_generating || _syncing || string.IsNullOrWhiteSpace(_storyText))" title="Find and fix narrative issues, contradictions, pacing problems">
        @if (_syncing) { <span class="spinner-border spinner-border-sm"></span> }
        else { <i class="bi bi-tools"></i> }
        Synchronize
    </button>
    <button class="btn btn-sm btn-outline-secondary" @onclick="GenerateSynopsis" disabled="@(_generating || _synopsizing || string.IsNullOrWhiteSpace(_storyText))" title="Generate a tight synopsis of this chapter for continuity">
        @if (_synopsizing) { <span class="spinner-border spinner-border-sm"></span> }
        else { <i class="bi bi-card-text"></i> }
        Synopsis
    </button>
    <button class="btn btn-sm btn-outline-secondary" @onclick="GenerateOutline" disabled="@(_generating || _outlining)" title="Generate a chapter-by-chapter outline of the entire story">
        @if (_outlining) { <span class="spinner-border spinner-border-sm"></span> }
        else { <i class="bi bi-list-ol"></i> }
        Outline
    </button>
</div>

@* ── Outline Modal ────────────────────────────────────── *@
@if (_showOutline)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="() => _showOutline = false">
        <div class="card bg-dark text-light border-secondary" style="width: 700px; max-height: 85vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-light fw-bold"><i class="bi bi-list-ol"></i> Story Outline</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showOutline = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                @if (_outlining)
                {
                    <div class="d-flex align-items-center gap-2">
                        <div class="spinner-border spinner-border-sm text-light"></div>
                        <small class="text-muted">Reading all chapters and building outline...</small>
                    </div>
                }
                else if (!string.IsNullOrEmpty(_outlineText))
                {
                    <div style="font-family: monospace; font-size: 13px; line-height: 1.6; white-space: pre-wrap;">@_outlineText</div>
                }
            </div>
        </div>
    </div>
}

@* ── Chapter Tabs ─────────────────────────────────────── *@
<div class="d-flex align-items-center gap-1 mb-2">
    @foreach (var ch in _project.Chapters.OrderBy(c => c.Number))
    {
        <button class="btn btn-sm @(ch.Number == _activeChapter ? "btn-danger" : "btn-outline-secondary")"
                @onclick="() => SwitchChapter(ch.Number)">
            @(string.IsNullOrWhiteSpace(ch.Title) ? $"Ch {ch.Number}" : ch.Title)
            @if (!string.IsNullOrWhiteSpace(ch.Synopsis))
            {
                <i class="bi bi-check-circle-fill text-success ms-1" style="font-size: 0.6rem;" title="Synopsis generated"></i>
            }
        </button>
    }
    <button class="btn btn-sm btn-outline-danger" @onclick="ShowNewChapterDialog" title="Add new chapter">
        <i class="bi bi-plus-lg"></i>
    </button>
    @if (_project.Chapters.Count > 0)
    {
        <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary ms-2"
               style="max-width: 200px; font-size: 0.8rem;"
               placeholder="Chapter title..."
               value="@CurrentChapter?.Title"
               @onchange="OnChapterTitleChanged" />
    }
</div>

@* ── New Chapter Dialog ───────────────────────────────── *@
@if (_showNewChapterDialog)
{
    <div class="card bg-dark text-light border-danger mb-2">
        <div class="card-body py-2 px-3">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="text-danger fw-bold small">New Chapter</span>
                @if (_creatingChapter)
                {
                    <div class="spinner-border spinner-border-sm text-danger"></div>
                    <small class="text-muted">Generating synopsis and preparing chapter...</small>
                }
            </div>
            @if (!_creatingChapter)
            {
                <div class="mb-2">
                    <small class="text-muted">How should the next chapter begin?</small>
                </div>
                <div class="d-flex gap-2 mb-2">
                    <button class="btn btn-sm btn-outline-danger" @onclick='() => CreateNewChapter("continue")'>
                        <i class="bi bi-arrow-right"></i> Continue Story
                    </button>
                    <button class="btn btn-sm btn-outline-info" @onclick='() => _showPerspectiveInput = true'>
                        <i class="bi bi-people"></i> Switch Perspective
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showNewChapterDialog = false">Cancel</button>
                </div>
                @if (_showPerspectiveInput)
                {
                    <div class="d-flex gap-2 align-items-center">
                        <small class="text-muted">Whose perspective?</small>
                        <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                               style="max-width: 200px;"
                               placeholder="Character name..."
                               @bind="_newChapterPerspective" />
                        <button class="btn btn-sm btn-info text-dark" @onclick='() => CreateNewChapter("perspective")' disabled="@string.IsNullOrWhiteSpace(_newChapterPerspective)">
                            Go
                        </button>
                    </div>
                }
            }
        </div>
    </div>
}

@* ── Synopsis Display ──────────────────────────────────── *@
@if (CurrentChapter != null && (!string.IsNullOrWhiteSpace(CurrentChapter.Synopsis) || !string.IsNullOrWhiteSpace(_project.StorySynopsis)))
{
    <div class="card bg-dark border-secondary mb-2" style="font-size: 0.8rem;">
        <div class="card-body py-2 px-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <small class="text-info fw-bold">Context</small>
                <button class="btn btn-sm btn-outline-secondary py-0 px-1" style="font-size: 0.65rem;" @onclick="() => _showSynopsis = !_showSynopsis">
                    @(_showSynopsis ? "hide" : "show")
                </button>
            </div>
            @if (_showSynopsis)
            {
                @if (!string.IsNullOrWhiteSpace(_project.StorySynopsis))
                {
                    <div class="mb-2">
                        <small class="text-danger fw-bold">Story Overview</small>
                        <div class="text-muted small" style="line-height: 1.4;">@_project.StorySynopsis</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(_project.PlotArc))
                {
                    <div class="mb-2">
                        <small class="text-warning fw-bold">Plot Arc</small>
                        <div class="text-muted small" style="line-height: 1.4; white-space: pre-wrap;">@_project.PlotArc</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(CurrentChapter.Synopsis))
                {
                    <div class="mb-2">
                        <small class="text-info fw-bold">Chapter Synopsis</small>
                        <div class="text-muted small" style="line-height: 1.4;">@CurrentChapter.Synopsis</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(CurrentChapter.Beats))
                {
                    <div>
                        <small class="text-success fw-bold">Key Beats</small>
                        <div class="text-muted small" style="line-height: 1.4; white-space: pre-wrap;">@CurrentChapter.Beats</div>
                    </div>
                }
            }
        </div>
    </div>
}

@* ── Generating Indicator ─────────────────────────────── *@
@if (_generating)
{
    <div class="d-flex align-items-center gap-2 mb-2">
        <div class="spinner-border spinner-border-sm text-danger"></div>
        <small class="text-muted">@_statusMessage</small>
    </div>
}

@* ── Writing Surface ──────────────────────────────────── *@
<textarea id="story-surface"
          class="form-control bg-dark text-light border-secondary w-100"
          style="font-family: Georgia, 'Times New Roman', serif; font-size: 16px; line-height: 1.8; resize: none; min-height: calc(100vh - 260px); color: #ddd !important;"
          placeholder="Start writing, paste in content, or click AI Assist to generate..."
          @bind="_storyText"
          @bind:event="oninput"
          @bind:after="OnTextChanged"></textarea>

@* ── Right-Click Context Menu ──────────────────────────── *@
@if (_showContextMenu)
{
    <div class="story-context-menu position-fixed bg-dark border border-secondary rounded shadow-lg py-1"
         style="top: @(_menuTop)px; left: @(_menuLeft)px; z-index: 1060; min-width: 180px;">
        <button class="dropdown-item text-light d-flex align-items-center gap-2 px-3 py-2" @onclick="ContextRewrite">
            <i class="bi bi-arrow-repeat text-warning"></i> <span>Rewrite</span>
        </button>
        @if (_ttsAvailable)
        {
            <div class="dropdown-divider border-secondary my-1"></div>
            <button class="dropdown-item text-light d-flex align-items-center gap-2 px-3 py-2" @onclick="ContextNarrate" disabled="@_narrating">
                <i class="bi bi-volume-up text-danger"></i> <span>Narrate</span>
            </button>
        }
        <div class="dropdown-divider border-secondary my-1"></div>
        <button class="dropdown-item text-light d-flex align-items-center gap-2 px-3 py-2" @onclick="ContextContinue" disabled="@_generating">
            <i class="bi bi-pen text-danger"></i> <span>Continue Story</span>
        </button>
    </div>
}

@* ── Audio Player ─────────────────────────────────────── *@
<AudioPlayer @ref="_audioPlayer" Visible="_showAudioPlayer" OnDismissed="() => _showAudioPlayer = false" CssClass="mt-2" />

@if (_error != null)
{
    <div class="alert alert-warning mt-2 py-1 small">@_error</div>
}

@if (_graphStatus != null)
{
    <div class="d-flex align-items-center gap-2 mt-1">
        @if (_extracting)
        {
            <div class="spinner-border spinner-border-sm text-info" style="width: 0.8rem; height: 0.8rem;"></div>
        }
        else
        {
            <i class="bi bi-diagram-3 text-info" style="font-size: 0.75rem;"></i>
        }
        <small class="text-muted" style="font-size: 0.7rem;">@_graphStatus</small>
    </div>
}

@* ── AI Assist Modal ──────────────────────────────────── *@
@if (_showAssist)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="CloseAssist">
        <div class="card bg-dark text-light border-danger" style="width: 600px; max-height: 80vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-danger fw-bold"><i class="bi bi-stars"></i> AI Assist</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseAssist"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label text-muted small">What should happen next?</label>
                    <textarea class="form-control bg-dark text-light border-secondary"
                              rows="3"
                              placeholder="@(_hasExistingText ? "Give the engine a direction — 'continue', 'Kyle enters the building', or describe a full scene..." : "A premise to start from — who, where, what's happening...")"
                              @bind="_assistPrompt"
                              @onkeydown="HandleAssistKeyDown"
                              style="font-family: Georgia, serif;"></textarea>
                </div>

                @* Options *@
                <div class="mb-3">
                    <a href="javascript:void(0)" class="text-muted small text-decoration-none" @onclick="() => _showAssistOptions = !_showAssistOptions">
                        <i class="bi @(_showAssistOptions ? "bi-chevron-up" : "bi-chevron-down")"></i> Options
                    </a>
                </div>
                @if (_showAssistOptions)
                {
                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Mood</label>
                            <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="_project.Mood">
                                <option value="">-- Engine decides --</option>
                                <option value="desperate and claustrophobic">Desperate</option>
                                <option value="slow burn dread">Slow burn dread</option>
                                <option value="electric and kinetic">Electric</option>
                                <option value="melancholic and beautiful">Melancholic</option>
                                <option value="paranoid and fractured">Paranoid</option>
                                <option value="tender amid violence">Tender amid violence</option>
                                <option value="dark humor and irony">Dark humor</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Location</label>
                            <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="_project.Location">
                                <option value="">-- Anywhere --</option>
                                @foreach (var d in _districts)
                                {
                                    <option value="@d.Name">@d.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted small">Characters</label>
                            <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                                   placeholder="Kyle, Sable..."
                                   @bind="_charactersInput" />
                        </div>
                    </div>
                }

                @* Mode selection *@
                <div class="mb-3 d-flex gap-3">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="modeAppend" value="append"
                               checked="@(_assistMode == "append")" @onchange='() => _assistMode = "append"' />
                        <label class="form-check-label text-muted small" for="modeAppend">Append to end</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="modeInsert" value="insert"
                               checked="@(_assistMode == "insert")" @onchange='() => _assistMode = "insert"' />
                        <label class="form-check-label text-muted small" for="modeInsert">Insert at cursor</label>
                    </div>
                </div>

                @if (_assistGenerating)
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="spinner-border spinner-border-sm text-danger"></div>
                        <small class="text-muted">@_statusMessage</small>
                    </div>
                }

                @if (string.IsNullOrEmpty(_assistPreview))
                {
                    <button class="btn btn-danger" @onclick="AssistGenerate"
                            disabled="@(string.IsNullOrWhiteSpace(_assistPrompt) || _assistGenerating)">
                        <i class="bi bi-pen"></i> Generate
                    </button>
                    @if (!_hasExistingText)
                    {
                        <button class="btn btn-outline-danger ms-2" @onclick="AssistSurprise" disabled="@_assistGenerating">
                            <i class="bi bi-shuffle"></i> Surprise Me
                        </button>
                    }
                }
                else
                {
                    @* Preview *@
                    <div class="mb-3">
                        <label class="form-label text-muted small">Preview (edit before inserting)</label>
                        <textarea class="form-control bg-dark text-light border-secondary"
                                  rows="8"
                                  style="font-family: Georgia, serif; font-size: 15px; line-height: 1.7;"
                                  @bind="_assistPreview"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-success" @onclick="AssistInsert">
                            <i class="bi bi-box-arrow-in-down"></i> Insert
                        </button>
                        <button class="btn btn-outline-danger" @onclick="AssistGenerate" disabled="@_assistGenerating">
                            <i class="bi bi-arrow-repeat"></i> Regenerate
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="AssistDiscard">Discard</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ── Rewrite Modal ────────────────────────────────────── *@
@if (_showRewrite)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="CloseRewrite">
        <div class="card bg-dark text-light border-warning" style="width: 600px; max-height: 80vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-warning fw-bold"><i class="bi bi-arrow-repeat"></i> Rewrite Selection</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseRewrite"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label text-muted small">Selected passage:</label>
                    <div class="bg-black rounded p-2 small" style="font-family: Georgia, serif; line-height: 1.6; max-height: 120px; overflow-y: auto; color: #999;">
                        @_rewriteOriginal
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted small">Direction (optional)</label>
                    <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                           placeholder="e.g. 'make it more tense', 'add sensory detail', or leave blank for a straight polish"
                           @bind="_rewriteDirection" />
                </div>

                @if (_rewriteGenerating)
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="spinner-border spinner-border-sm text-warning"></div>
                        <small class="text-muted">Rewriting...</small>
                    </div>
                }

                @if (string.IsNullOrEmpty(_rewritePreview))
                {
                    <button class="btn btn-warning text-dark" @onclick="DoRewrite" disabled="@_rewriteGenerating">
                        <i class="bi bi-arrow-repeat"></i> Rewrite
                    </button>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label text-muted small">Rewritten (edit before applying)</label>
                        <textarea class="form-control bg-dark text-light border-secondary"
                                  rows="6"
                                  style="font-family: Georgia, serif; font-size: 15px; line-height: 1.7;"
                                  @bind="_rewritePreview"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-success" @onclick="ApplyRewrite">
                            <i class="bi bi-check-lg"></i> Apply
                        </button>
                        <button class="btn btn-outline-warning" @onclick="DoRewrite" disabled="@_rewriteGenerating">
                            <i class="bi bi-arrow-repeat"></i> Regenerate
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="CloseRewrite">Discard</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

@* ── Synchronize Modal ────────────────────────────────────── *@
@if (_showSync)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="CloseSync">
        <div class="card bg-dark text-light border-info" style="width: 700px; max-height: 85vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-info fw-bold"><i class="bi bi-tools"></i> Synchronize</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CloseSync"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                @if (_syncing)
                {
                    <div class="d-flex align-items-center gap-2">
                        <div class="spinner-border spinner-border-sm text-info"></div>
                        <small class="text-muted">@_syncStatus</small>
                    </div>
                }
                else if (!string.IsNullOrEmpty(_syncIssues))
                {
                    <div class="mb-2">
                        <label class="form-label text-muted small">Issues found — edit to remove or add items, then Apply All to fix them:</label>
                        <textarea class="form-control bg-dark text-light border-secondary"
                                  rows="12"
                                  style="font-family: monospace; font-size: 13px; line-height: 1.5;"
                                  @bind="_syncIssues"></textarea>
                    </div>

                    @if (!string.IsNullOrEmpty(_syncPreview))
                    {
                        <div class="mb-2">
                            <label class="form-label text-muted small">Synchronizeed text (preview):</label>
                            <textarea class="form-control bg-dark text-light border-secondary"
                                      rows="10"
                                      style="font-family: Georgia, serif; font-size: 14px; line-height: 1.7;"
                                      @bind="_syncPreview"></textarea>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-success" @onclick="ApplySync">
                                <i class="bi bi-check-lg"></i> Apply
                            </button>
                            <button class="btn btn-outline-info" @onclick="RunSyncFixes" disabled="@_syncing">
                                <i class="bi bi-arrow-repeat"></i> Regenerate
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="CloseSync">Dismiss</button>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex gap-2">
                            <button class="btn btn-info text-dark" @onclick="RunSyncFixes" disabled="@_syncing">
                                <i class="bi bi-wrench"></i> Apply All Fixes
                            </button>
                            <button class="btn btn-outline-secondary" @onclick="CloseSync">Dismiss</button>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string? ProjectId { get; set; }

    // ── Core state ──
    private StoryProject _project = new();
