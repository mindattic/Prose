    // ── Entity extraction ──

    private async Task RunExtractionAsync()
    {
        if (extracting || !hasExistingText) return;
        extracting = true;
        graphStatus = "Scanning for entities...";
        await InvokeAsync(StateHasChanged);
        try
        {
            var storyPoint = $"story:{project.Id}";
            var (entities, relationships) = await EntityExtract.ExtractAndMergeAsync(storyText, project.Id, storyPoint);
            lastExtractedText = storyText;

            // Auto-detect characters
            var session = new NarrativeSessionContext(Graph);
            session.ScanText(storyText);
            var detected = session.GetSnapshot().PrimaryEntities
                .Where(e => e.NodeType == "character" && storyText.Contains(e.Name, StringComparison.OrdinalIgnoreCase))
                .Select(e => e.Name);
            foreach (var name in detected)
                if (!project.Characters.Contains(name, StringComparer.OrdinalIgnoreCase))
                    project.Characters.Add(name);

            graphStatus = entities > 0 || relationships > 0
                ? $"Graph: +{entities} entities, +{relationships} relationships"
                : "Graph up to date";
        }
        catch (Exception ex) { graphStatus = $"Extraction failed: {ex.Message}"; }
        finally
        {
            extracting = false;
            await InvokeAsync(StateHasChanged);
            _ = Task.Delay(5000).ContinueWith(_ => InvokeAsync(() => { graphStatus = null; StateHasChanged(); }));
        }
    }

