    private void RefreshSceneEntities()
    {
        if (string.IsNullOrWhiteSpace(storyText)) return;
        var session = new NarrativeSessionContext(Graph);
        session.ScanText(storyText);
        var snapshot = session.GetSnapshot();
        var textLower = storyText.ToLowerInvariant();

        _sceneEntities = snapshot.PrimaryEntities
            .Where(e => textLower.Contains(e.Name.ToLowerInvariant()))
            .Select(e => (id: Graph.ResolveId(e.Name) ?? "", name: e.Name, nodeType: e.NodeType))
            .DistinctBy(e => e.name)
            .OrderBy(e => e.nodeType).ThenBy(e => e.name)
            .ToList();

        validationIssues = Validator.ValidateQuick(storyText)
            .Select(i => $"[{i.Category}] {i.EntityName}: {i.Description}").ToList();
    }

    private async Task RenderMiniGraph()
    {
        RefreshSceneEntities();
        if (_sceneEntities.Count == 0) return;
        miniGraphRef?.Dispose();
        miniGraphRef = DotNetObjectReference.Create(this);

        var ids = _sceneEntities.Select(e => e.id).Where(id => !string.IsNullOrEmpty(id)).ToHashSet();
        var expanded = new HashSet<string>(ids);
        foreach (var id in ids)
            foreach (var n in Graph.GetNeighbors(id, 1))
                expanded.Add(n.Id);

        var nodes = expanded.Select(id => Graph.GetNode(id)).Where(n => n != null)
            .Select(n => new { id = n!.Id, name = n.Name, nodeType = n.NodeType, edgeCount = Graph.GetAllEdges(n.Id).Count }).ToArray();
        var edges = expanded.SelectMany(id => Graph.GetAllEdges(id))
            .Where(e => expanded.Contains(e.Source) && expanded.Contains(e.Target))
            .DistinctBy(e => (e.Source, e.Target, e.RelationType))
            .Select(e => new { source = e.Source, target = e.Target, relationType = e.RelationType, weight = e.Weight, sentiment = e.Sentiment }).ToArray();

        await JS.InvokeVoidAsync("graphInterop.init", "miniGraphCanvas", miniGraphRef, nodes, edges);
    }

