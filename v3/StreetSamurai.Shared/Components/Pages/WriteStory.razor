    private bool _hasExistingText => !string.IsNullOrWhiteSpace(_storyText);

    protected override async Task OnInitializedAsync()
    {
        _districts = Canon.ListDistricts();
        _ttsAvailable = await TtsSvc.IsConfiguredAsync();
        if (!string.IsNullOrEmpty(ProjectId))
        {
            var loaded = Repo.LoadProject(ProjectId);
            if (loaded != null)
            {
                _project = loaded;
                _charactersInput = string.Join(", ", _project.Characters);
            }
        }

        _project.EnsureChapters();
        _activeChapter = _project.Chapters.First().Number;
        _storyText = CurrentChapter?.Text ?? "";
        UpdateWordCount();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("writeInterop.watchRightClick", "story-surface", _dotNetRef);
            if (!string.IsNullOrEmpty(_storyText))
                await JS.InvokeVoidAsync("writeInterop.focusEnd", "story-surface");
        }
    }

    [JSInvokable]
    public void OnContextMenu(double top, double left)
    {
        _menuTop = top;
        _menuLeft = left;
        _showContextMenu = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnDismissContextMenu()
    {
        if (_showContextMenu)
        {
            _showContextMenu = false;
            StateHasChanged();
        }
    }

    private async Task ContextRewrite()
    {
        _showContextMenu = false;
        await RewriteSelection();
    }

    private async Task ContextNarrate()
    {
        _showContextMenu = false;
        await SmartNarrate();
    }

    private async Task ContextContinue()
    {
        _showContextMenu = false;
        await ContinueStory();
    }

    // ── Text changes ──

    private void OnTextChanged()
    {
        UpdateWordCount();
        _dirty = true;
        _saved = false;

        // Debounce: save 2 seconds after last keystroke
        _saveTimer?.Dispose();
        _saveTimer = new System.Threading.Timer(_ =>
        {
            if (_dirty) InvokeAsync(Save);
        }, null, 2000, Timeout.Infinite);
    }

    private void UpdateWordCount()
    {
        _wordCount = string.IsNullOrWhiteSpace(_storyText)
            ? 0
            : _storyText.Split((char[])[' ', '\n', '\r', '\t'], StringSplitOptions.RemoveEmptyEntries).Length;
    }

    // ── Persistence ──

    private void Save()
    {
        SyncCharacters();
        SyncChapter();
        _project.SyncBlocksFromChapters();
        Repo.SaveProject(_project);
        _saved = true;
        _dirty = false;
        InvokeAsync(StateHasChanged);
    }

    private void ForceSave()
    {
        Save();
        StateHasChanged();
        if (!string.IsNullOrWhiteSpace(_storyText) && _storyText != _lastExtractedText)
            _ = RunExtractionAsync();
    }

    private void SyncChapter()
    {
        var ch = CurrentChapter;
        if (ch != null)
        {
            ch.Text = _storyText;
            ch.Modified = DateTime.UtcNow;
        }
        _project.Modified = DateTime.UtcNow;
    }

    // ── Chapter management ──

    private void SwitchChapter(int number)
    {
        SyncChapter();
        Save();
        _activeChapter = number;
        _storyText = CurrentChapter?.Text ?? "";
        UpdateWordCount();
    }

    private void ShowNewChapterDialog()
    {
        _showNewChapterDialog = true;
        _showPerspectiveInput = false;
        _newChapterPerspective = "";
        _creatingChapter = false;
    }

    private async Task CreateNewChapter(string mode)
    {
        _creatingChapter = true;
        StateHasChanged();

        try
        {
            // Save current chapter
            SyncChapter();

            // Auto-generate synopsis + beats of the current chapter if missing
            var currentCh = CurrentChapter;
            if (currentCh != null && string.IsNullOrWhiteSpace(currentCh.Synopsis) && !string.IsNullOrWhiteSpace(currentCh.Text))
            {
                var synSystem = """
                    Create a tight, factual synopsis of this chapter. Capture ALL key events,
                    character actions, revelations, emotional beats, and unresolved threads.
                    Name every character. Note every location. 1-2 dense paragraphs.
                    """;
                var priorCtx = _project.GetPriorContext(_activeChapter);
                var synUser = string.IsNullOrWhiteSpace(priorCtx)
                    ? currentCh.Text
                    : $"PREVIOUS CHAPTERS:\n{priorCtx}\n\nCURRENT CHAPTER:\n{currentCh.Text}";

                currentCh.Synopsis = (await Llm.GenerateAsync(synSystem, synUser, 0.2, 2048)).Trim();

                var beatsSystem = """
                    List the 3-6 major plot beats from this chapter as bullet points.
                    Each beat: "- [what happened]". Focus on decisions, revelations, conflicts, turning points.
                    """;
                currentCh.Beats = (await Llm.GenerateAsync(beatsSystem, currentCh.Text, 0.2, 1024)).Trim();
            }

            // Create the new chapter
            var nextNum = _project.Chapters.Max(c => c.Number) + 1;
            var perspective = mode == "perspective" ? _newChapterPerspective : "";
            var title = mode == "perspective"
                ? $"Chapter {nextNum} — {_newChapterPerspective}"
                : $"Chapter {nextNum}";

            var newChapter = new StoryChapter { Number = nextNum, Title = title, Perspective = perspective };
            _project.Chapters.Add(newChapter);
            Save();

            // Switch to the new chapter
            _activeChapter = nextNum;
            _storyText = "";
            UpdateWordCount();

            _showNewChapterDialog = false;
            _showPerspectiveInput = false;
        }
        catch (Exception ex)
        {
            _error = $"Failed to create chapter: {ex.Message}";
        }
        finally
        {
            _creatingChapter = false;
        }
    }

    private void OnChapterTitleChanged(ChangeEventArgs e)
    {
        var ch = CurrentChapter;
        if (ch != null)
        {
            ch.Title = e.Value?.ToString() ?? "";
            Save();
        }
    }

    private async Task GenerateSynopsis()
    {
        if (string.IsNullOrWhiteSpace(_storyText) || _synopsizing) return;
        _synopsizing = true;
        _statusMessage = "Generating chapter synopsis + beats...";
        StateHasChanged();

        try
        {
            var priorContext = _project.GetPriorContext(_activeChapter);
            var contextLine = string.IsNullOrWhiteSpace(priorContext)
                ? ""
                : $"PREVIOUS CHAPTERS CONTEXT:\n{priorContext}\n\n";

            // Generate chapter synopsis
            var synSystem = """
                You are a story editor creating a tight, factual synopsis of a chapter.
                Capture ALL key events, character actions, revelations, emotional beats,
                and unresolved threads. Be precise and complete. No opinions —
                just what happened, in order. 1-2 dense paragraphs.
                """;
            var synopsis = await Llm.GenerateAsync(synSystem,
                $"{contextLine}CHAPTER TEXT:\n{_storyText}", 0.2, 2048);

            // Generate key beats (bullet points)
            _statusMessage = "Extracting key beats...";
            StateHasChanged();
            var beatsSystem = """
                List the 3-6 major plot beats from this chapter as bullet points.
                Each beat should be one line: "- [what happened]"
                Focus on: character decisions, revelations, conflicts, turning points.
                No filler. No opinions. Just the beats.
                """;
            var beats = await Llm.GenerateAsync(beatsSystem, _storyText, 0.2, 1024);

            var ch = CurrentChapter;
            if (ch != null)
            {
                ch.Synopsis = synopsis.Trim();
                ch.Beats = beats.Trim();
                Save();
            }

            // Update story-level synopsis if we have 2+ chapters with synopses
            var chaptersWithSynopsis = _project.Chapters.Count(c => !string.IsNullOrWhiteSpace(c.Synopsis));
            if (chaptersWithSynopsis >= 2)
            {
                _statusMessage = "Updating story overview...";
                StateHasChanged();

                var allSynopses = string.Join("\n\n",
                    _project.Chapters.OrderBy(c => c.Number)
                        .Where(c => !string.IsNullOrWhiteSpace(c.Synopsis))
                        .Select(c => $"Chapter {c.Number} ({c.Title}): {c.Synopsis}"));

                var storySystem = """
                    Synthesize these chapter synopses into ONE story-level overview.
                    2-3 paragraphs covering: premise, major events so far, current state
                    of the main characters, and unresolved threads. This is the 30,000-foot
                    view — someone reading this should understand the whole story without
                    reading any chapters.
                    """;
                _project.StorySynopsis = (await Llm.GenerateAsync(storySystem, allSynopses, 0.2, 2048)).Trim();

                var arcSystem = """
                    Based on these chapter synopses, describe the plot arc so far in 3-5 bullet points.
                    Format: "- [turning point or major shift]"
                    Focus on the trajectory: where did it start, what changed, where is it heading?
                    """;
                _project.PlotArc = (await Llm.GenerateAsync(arcSystem, allSynopses, 0.2, 1024)).Trim();
                Save();
            }
        }
        catch (Exception ex)
        {
            _error = $"Synopsis failed: {ex.Message}";
        }
        finally
        {
            _synopsizing = false;
            _statusMessage = "";
        }
    }

    private async Task GenerateOutline()
    {
        if (_outlining) return;
        _outlining = true;
        _showOutline = true;
        _outlineText = "";
        SyncChapter();
        StateHasChanged();

        try
        {
            // Feed ALL chapter text into the outline generator
            var chapterSummaries = new List<string>();
            foreach (var ch in _project.Chapters.OrderBy(c => c.Number))
            {
                var perspective = string.IsNullOrWhiteSpace(ch.Perspective) ? "" : $" [POV: {ch.Perspective}]";
                var textPreview = string.IsNullOrWhiteSpace(ch.Text) ? "(empty)" : ch.Text;
                chapterSummaries.Add($"=== CHAPTER {ch.Number}: {ch.Title}{perspective} ===\n{textPreview}");
            }

            var allText = string.Join("\n\n", chapterSummaries);

            var system = """
                You are a story editor creating a structured outline of a cyberpunk novel.
                Read ALL chapters and produce a chapter-by-chapter outline that shows:

                For each chapter:
                - Chapter number and title
                - POV character (if applicable)
                - 3-5 bullet points of key events IN ORDER
                - Characters who appear
                - Locations used
                - Unresolved threads left hanging

                After all chapters, add:
                CONTINUITY CHECK:
                - Flag any contradictions between chapters (character in two places, timeline issues, etc.)
                - Flag any dropped threads (something set up in an earlier chapter that's never addressed)
                - Flag any character voice inconsistencies

                STORY ARC STATUS:
                - Where is the story right now in its arc?
                - What needs to happen next?
                - What threads are ready to be resolved?

                Be specific. Quote text when flagging issues. This is a working document, not praise.
                """;

            _outlineText = await Llm.GenerateAsync(system, allText, 0.2, 8192);
        }
        catch (Exception ex)
        {
            _outlineText = $"Outline failed: {ex.Message}";
        }
        finally
        {
            _outlining = false;
        }
    }

    private void SyncCharacters()
    {
        _project.Characters = _charactersInput
            .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .ToList();
    }

    // ── Project management ──

    private void LoadProject(string id)
    {
        if (!string.IsNullOrWhiteSpace(_storyText)) Save();

        var loaded = Repo.LoadProject(id);
        if (loaded == null) return;

        _project = loaded;
        _project.EnsureChapters();
        _activeChapter = _project.Chapters.First().Number;
        _storyText = CurrentChapter?.Text ?? "";
        _charactersInput = string.Join(", ", _project.Characters);
        _error = null;
        UpdateWordCount();
        Nav.NavigateTo($"/write/{id}", replace: true);
    }

    private void NewStory()
    {
        if (!string.IsNullOrWhiteSpace(_storyText)) Save();

        _project = new StoryProject();
        _project.EnsureChapters();
        _activeChapter = 1;
        _storyText = "";
        _charactersInput = "";
        _error = null;
        _saved = false;
        _wordCount = 0;
        Nav.NavigateTo("/write", replace: true);
    }

    // ── AI Assist ──

    private async Task OpenAssist()
    {
        _assistPreview = "";
        _assistPrompt = "";
        _assistTitle = null;
        _showAssist = true;

        // Capture cursor position for "insert at cursor" mode
        try
        {
            _cursorPosition = await JS.InvokeAsync<int>("writeInterop.getCursorPosition", "story-surface");
        }
        catch { _cursorPosition = _storyText.Length; }
    }

    private void CloseAssist()
    {
        _showAssist = false;
        _assistPreview = "";
    }

    private void AssistDiscard()
    {
        _assistPreview = "";
        _assistTitle = null;
    }

    private async Task AssistGenerate()
    {
        if (string.IsNullOrWhiteSpace(_assistPrompt)) return;
        _assistGenerating = true;
        _assistPreview = "";
        _error = null;
        SyncCharacters();
        StateHasChanged();

        try
        {
            if (!_hasExistingText)
            {
                _statusMessage = "Writing the opening...";
                StateHasChanged();

                var request = new StoryStarterRequest
                {
                    Premise = _assistPrompt,
                    Mood = string.IsNullOrEmpty(_project.Mood) ? null : _project.Mood,
                    Location = string.IsNullOrEmpty(_project.Location) ? null : _project.Location,
                    Characters = _project.Characters,
                };

                var opening = await Starter.GenerateOpeningAsync(request);
                _assistPreview = opening.Text;
                _assistTitle = opening.Title;
            }
            else
            {
                _statusMessage = "Continuing the story...";
                StateHasChanged();

                var paragraphs = _storyText
                    .Split(["\n\n", "\r\n\r\n"], StringSplitOptions.RemoveEmptyEntries)
                    .Select(p => p.Trim()).Where(p => p.Length > 0).ToList();

                var text = await Starter.ContinueAsync(
                    paragraphs, _assistPrompt,
                    string.IsNullOrEmpty(_project.Mood) ? null : _project.Mood,
                    string.IsNullOrEmpty(_project.Location) ? null : _project.Location,
                    _project.Characters);

                _assistPreview = text;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _assistGenerating = false;
            _statusMessage = "";
        }
    }

    private async Task AssistSurprise()
    {
        _assistGenerating = true;
        _assistPreview = "";
        _statusMessage = "Rolling dice against the canon...";
        StateHasChanged();

        try
        {
            var opening = await Starter.GenerateRandomAsync();
            _assistPreview = opening.Text;
            _assistTitle = opening.Title;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _assistGenerating = false;
            _statusMessage = "";
        }
    }

    private async Task AssistInsert()
    {
        if (string.IsNullOrEmpty(_assistPreview)) return;

        // Set title if this is a new story
        if (_assistTitle != null && _project.Title is "Untitled" or "")
            _project.Title = _assistTitle;

        if (_assistMode == "insert" && _cursorPosition < _storyText.Length)
        {
            // Insert at cursor position
            var separator = _cursorPosition > 0 && _storyText[_cursorPosition - 1] != '\n' ? "\n\n" : "";
            var newValue = await JS.InvokeAsync<string>("writeInterop.insertText",
                "story-surface", _cursorPosition, separator + _assistPreview);
            _storyText = newValue;
        }
        else
        {
            // Append
            if (!string.IsNullOrWhiteSpace(_storyText))
                _storyText += "\n\n";
            _storyText += _assistPreview;
            await JS.InvokeVoidAsync("writeInterop.setText", "story-surface", _storyText);
        }

        UpdateWordCount();
        _showAssist = false;
        _assistPreview = "";
        _assistTitle = null;
        Save();
        _ = RunExtractionAsync();

        await JS.InvokeVoidAsync("writeInterop.focusEnd", "story-surface");
    }

    private async Task HandleAssistKeyDown(KeyboardEventArgs e)
    {
        if (e is { Key: "Enter", CtrlKey: true })
            await AssistGenerate();
    }

    // ── Direct Continue (no modal) ──

    private async Task ContinueStory()
    {
        if (string.IsNullOrWhiteSpace(_storyText) || _generating) return;
        _assistGenerating = true;
        _error = null;
        _statusMessage = "Continuing the story...";
        SyncCharacters();
        StateHasChanged();

        try
        {
            // Build context: prior chapter synopses + current chapter text
            var priorContext = _project.GetPriorContext(_activeChapter);
            var paragraphs = new List<string>();
            if (!string.IsNullOrWhiteSpace(priorContext))
                paragraphs.Add($"[PRIOR CHAPTERS SUMMARY]\n{priorContext}\n[CURRENT CHAPTER]");

            paragraphs.AddRange(_storyText
                .Split(["\n\n", "\r\n\r\n"], StringSplitOptions.RemoveEmptyEntries)
                .Select(p => p.Trim()).Where(p => p.Length > 0));

            var text = await Starter.ContinueAsync(
                paragraphs, "continue",
                string.IsNullOrEmpty(_project.Mood) ? null : _project.Mood,
                string.IsNullOrEmpty(_project.Location) ? null : _project.Location,
                _project.Characters);

            _storyText += "\n\n" + text;
            await JS.InvokeVoidAsync("writeInterop.setText", "story-surface", _storyText);
            UpdateWordCount();
            Save();
            _ = RunExtractionAsync();
            await JS.InvokeVoidAsync("writeInterop.focusEnd", "story-surface");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _assistGenerating = false;
            _statusMessage = "";
        }
    }

    // ── Rewrite Selection ──

    private async Task RewriteSelection()
    {
        try
        {
            var sel = await JS.InvokeAsync<SelectionInfo>("writeInterop.getSelection", "story-surface");
            if (sel == null || string.IsNullOrWhiteSpace(sel.Text))
            {
                _error = "Select some text first, then click Rewrite Selection.";
                return;
            }

            _rewriteOriginal = sel.Text;
            _rewriteStart = sel.Start;
            _rewriteEnd = sel.End;
            _rewriteDirection = "";
            _rewritePreview = "";
            _showRewrite = true;
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"Could not read selection: {ex.Message}";
        }
    }

    private void CloseRewrite()
    {
        _showRewrite = false;
        _rewritePreview = "";
    }

    private async Task DoRewrite()
    {
        _rewriteGenerating = true;
        _rewritePreview = "";
        SyncCharacters();
        StateHasChanged();

        try
        {
            var result = await Starter.RewriteAsync(
                _rewriteOriginal,
                string.IsNullOrWhiteSpace(_rewriteDirection) ? null : _rewriteDirection,
                string.IsNullOrEmpty(_project.Mood) ? null : _project.Mood,
                string.IsNullOrEmpty(_project.Location) ? null : _project.Location,
                _project.Characters);

            _rewritePreview = result.Trim();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _rewriteGenerating = false;
        }
    }

    private async Task ApplyRewrite()
    {
        if (string.IsNullOrEmpty(_rewritePreview)) return;

        var newValue = await JS.InvokeAsync<string>("writeInterop.replaceRange",
            "story-surface", _rewriteStart, _rewriteEnd, _rewritePreview);
        _storyText = newValue;

        UpdateWordCount();
        _showRewrite = false;
        _rewritePreview = "";
        Save();
    }

    // ── Audio ──

    private async Task SmartNarrate()
    {
        if (_narrating || string.IsNullOrWhiteSpace(_storyText)) return;

        // Check if there's a selection first
        try
        {
            var sel = await JS.InvokeAsync<SelectionInfo>("writeInterop.getSelection", "story-surface");
            if (sel != null && !string.IsNullOrWhiteSpace(sel.Text))
            {
                // Has selection — narrate it directly, no confirmation needed
                await NarrateText(sel.Text);
                return;
            }
        }
        catch { }

        // No selection — ask for confirmation before narrating all
        _confirmNarrateAll = true;
    }

    private async Task DoNarrateAll()
    {
        _confirmNarrateAll = false;
        if (!string.IsNullOrWhiteSpace(_storyText))
            await NarrateText(_storyText);
    }

    private async Task ConfirmProfessionalNarrate()
    {
        _confirmProfessional = false;
        _useProfessionalTts = true;
        await SmartNarrate();
        _useProfessionalTts = false;
    }

    private async Task NarrateText(string text)
    {
        _narrating = true;
        _showAudioPlayer = true;
        _error = null;
        _audioPlayer?.SetLoading(true);
        StateHasChanged();

        try
        {
            byte[] audio;
            if (_useProfessionalTts)
            {
                _statusMessage = "Synthesizing with Oliver Silk (ElevenLabs)...";
                StateHasChanged();
                audio = await TtsSvc.SynthesizeAsync(text);
            }
            else
            {
                _statusMessage = "Draft narration (Windows TTS)...";
                StateHasChanged();
                audio = await DraftTts.SynthesizeAsync(text);
            }

            if (_audioPlayer != null)
                await _audioPlayer.LoadAudioAsync(audio);
        }
        catch (Exception ex)
        {
            _audioPlayer?.SetError(ex.Message);
        }
        finally
        {
            _narrating = false;
            _statusMessage = "";
        }
    }

    // ── Synchronize ──

    private async Task StartSync()
    {
        if (string.IsNullOrWhiteSpace(_storyText) || _syncing) return;
        _syncing = true;
        _showSync = true;
        _syncIssues = "";
        _syncPreview = "";
        _syncStatus = "Analyzing story for issues...";
        SyncCharacters();
        StateHasChanged();

        try
        {
            var characterContext = string.Join("\n---\n",
                _project.Characters.Select(name => CanonDb.GetCharacterContext(name)).Where(c => c.Length > 0));

            var rulesContext = CanonDb.GetLiteraryRulesPrompt();

            var system = $"""
                You are a story editor analyzing cyberpunk fiction set in Meridian 88.
                Find every issue that needs fixing.

                KNOWN CHARACTERS:
                {characterContext}

                LITERARY RULES:
                {rulesContext}

                List EVERY issue as a numbered item, one per line. Be specific — quote the
                problematic text and explain what's wrong. Categories:
                - CANON: contradicts established character/world details
                - PLOT: logic gap, unexplained jump, dangling thread
                - VOICE: character doesn't sound like themselves
                - PACING: section drags or rushes
                - PROSE: clumsy phrasing, cliché, weak imagery

                Format each line as:
                1. [CATEGORY] "quoted problem text" — explanation of what to fix

                If the story is clean, say "No issues found." Do NOT invent problems.
                """;

            _syncIssues = await Llm.GenerateAsync(system, _storyText, 0.3, 4096);
        }
        catch (Exception ex)
        {
            _syncIssues = $"Analysis failed: {ex.Message}";
        }
        finally
        {
            _syncing = false;
            _syncStatus = "";
        }
    }

    private async Task RunSyncFixes()
    {
        if (string.IsNullOrWhiteSpace(_syncIssues) || _syncing) return;
        _syncing = true;
        _syncPreview = "";
        _syncStatus = "Applying fixes...";
        StateHasChanged();

        try
        {
            var system = """
                You are a literary editor fixing specific issues in cyberpunk fiction.
                You will receive the original text and a numbered list of issues to fix.
                Apply EVERY fix in the list. Do NOT change anything that isn't listed as an issue.
                Preserve the original voice, structure, and meaning — only fix what's broken.
                Return the COMPLETE corrected text. No commentary, no issue list, just the fixed story.
                """;

            var user = $"""
                ISSUES TO FIX:
                {_syncIssues}

                ORIGINAL TEXT:
                {_storyText}
                """;

            _syncPreview = await Llm.GenerateAsync(system, user, 0.3, 8192);
        }
        catch (Exception ex)
        {
            _error = $"Synchronize failed: {ex.Message}";
        }
        finally
        {
            _syncing = false;
            _syncStatus = "";
        }
    }

    private async Task ApplySync()
    {
        if (string.IsNullOrEmpty(_syncPreview)) return;
        _storyText = _syncPreview;
        await JS.InvokeVoidAsync("writeInterop.setText", "story-surface", _storyText);
        UpdateWordCount();
        Save();
        CloseSync();
    }

    private void CloseSync()
    {
        _showSync = false;
        _syncIssues = "";
        _syncPreview = "";
    }

    // ── Entity Extraction ──

    private async Task RunExtractionAsync()
    {
        if (_extracting || string.IsNullOrWhiteSpace(_storyText)) return;
        _extracting = true;
        _graphStatus = "Scanning story for entities...";
        await InvokeAsync(StateHasChanged);

        try
        {
            var (entities, relationships) = await EntityExtract.ExtractAndMergeAsync(_storyText, _project.Id);
            _lastExtractedText = _storyText;

            if (entities > 0 || relationships > 0)
                _graphStatus = $"Graph updated: +{entities} entities, +{relationships} relationships";
            else
                _graphStatus = "Graph up to date";
        }
        catch (Exception ex)
        {
            _graphStatus = $"Extraction failed: {ex.Message}";
        }
        finally
        {
            _extracting = false;
            await InvokeAsync(StateHasChanged);

            // Clear status after 5 seconds
            _ = Task.Delay(5000).ContinueWith(_ =>
                InvokeAsync(() => { _graphStatus = null; StateHasChanged(); }));
        }
    }

    // ── Cleanup ──

    public void Dispose()
    {
        // Final save if dirty
        if (_dirty)
        {
            SyncCharacters();
            SyncChapter();
            _project.SyncBlocksFromChapters();
            Repo.SaveProject(_project);
        }
        _saveTimer?.Dispose();
        try { JS.InvokeVoidAsync("writeInterop.unwatchRightClick", "story-surface"); } catch { }
        _dotNetRef?.Dispose();
    }

    // ── JS Interop types ──

    private record SelectionInfo(int Start, int End, string Text);
}
