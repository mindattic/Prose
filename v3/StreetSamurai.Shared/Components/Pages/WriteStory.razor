    private static string NormalizeImageSrc(string input)
    {
        var trimmed = input.Trim();
        if (trimmed.StartsWith("data:image/")) return trimmed;
        // Guess PNG if no prefix
        return $"data:image/png;base64,{trimmed}";
    }

