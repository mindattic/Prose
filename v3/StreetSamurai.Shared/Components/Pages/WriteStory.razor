@page "/write"
@page "/write/{ProjectId}"
@attribute [Authorize(Roles = "Contributor,Administrator")]
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@inject StoryStarterService Starter
@inject IStoryBlockRepository Repo
@inject NavigationManager Nav
@inject ElevenLabsTtsService TtsSvc
@inject WindowsTtsService DraftTts
@inject EntityExtractionService EntityExtract
@inject ILlmService Llm
@inject DatabaseService CanonDb
@inject WorldGraphService Graph
@inject IPathProvider Paths
@inject ValidationService Validator
@inject MarkdownService Markdown
@inject ExportService Export
@inject StoryStateService StoryState
@inject EventLogService EventLog
@inject KnowledgeMapService KnowledgeMap
@inject AgendaEngine Agenda
@inject OutlineService OutlineSvc
@inject SemanticIndexService SemanticIndex
@inject InferenceService Inference
@inject IJSRuntime JS
@implements IDisposable

@* ── Title + Save ─────────────────────────────────────── *@
<div class="d-flex align-items-center gap-2 mb-2" style="height: 32px;">
    <input type="text" class="form-control form-control-sm bg-dark text-danger border-secondary fw-bold flex-grow-1"
           style="font-family: Georgia, serif; font-size: 1rem; height: 32px;"
           placeholder="Untitled"
           @bind="project.Title"
           @bind:after="Save" />
    <button class="btn btn-sm btn-danger text-nowrap" style="height: 32px;" @onclick="ForceSave">
        <i class="bi bi-floppy"></i> Save
    </button>
</div>

@* ── Ask Modal ───────────────────────────────────────── *@
@if (showAskModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="() => showAskModal = false">
        <div class="card bg-dark text-light border-info" style="width: 650px; max-height: 85vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-info fw-bold"><i class="bi bi-chat-dots"></i> Ask</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => showAskModal = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                <div class="mb-2">
                    <select class="form-select form-select-sm bg-dark text-light border-secondary" style="width: auto;" @bind="askScope">
                        <option value="story">This Story</option>
                        <option value="series">All Stories (Series)</option>
                    </select>
                </div>
                <div class="mb-3">
                    <textarea class="form-control bg-dark text-light border-secondary" rows="3"
                              placeholder="Ask a question about the world, characters, story..."
                              @bind="commandText" @onkeydown="HandleAskKeyDown"
                              style="font-family: Georgia, serif;"></textarea>
                </div>
                @if (busy)
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="spinner-border spinner-border-sm text-info"></div>
                        <small class="text-muted">@statusMessage</small>
                    </div>
                }
                @if (!string.IsNullOrEmpty(commandResult))
                {
                    <div class="mb-3 bg-black rounded p-3 small" style="white-space: pre-wrap; max-height: 400px; overflow-y: auto;">@commandResult</div>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="CloseAsk">Close</button>
                }
                else if (!busy)
                {
                    <button class="btn btn-sm btn-info text-dark" @onclick="ExecuteAsk"><i class="bi bi-send"></i> Ask</button>
                }
            </div>
        </div>
    </div>
}

@* ── Write Modal ─────────────────────────────────────── *@
@if (showWriteModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="() => showWriteModal = false">
        <div class="card bg-dark text-light border-danger" style="width: 650px; max-height: 85vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-danger fw-bold"><i class="bi bi-pen"></i> Write</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => showWriteModal = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <textarea class="form-control bg-dark text-light border-secondary" rows="3"
                              placeholder="What should happen next? Describe the scene, direction, or premise..."
                              @bind="writeText" @onkeydown="HandleWriteKeyDown"
                              style="font-family: Georgia, serif;"></textarea>
                </div>
                @if (busy)
                {
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="spinner-border spinner-border-sm text-danger"></div>
                        <small class="text-muted">@statusMessage</small>
                    </div>
                }
                @if (!string.IsNullOrEmpty(writeResult))
                {
                    <div class="mb-3">
                        <textarea class="form-control bg-dark text-light border-secondary" rows="8"
                                  style="font-family: Georgia, serif; font-size: 14px; line-height: 1.7;"
                                  @bind="writeResult"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-success" @onclick="ApplyWrite"><i class="bi bi-check-lg"></i> Insert</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick='() => writeResult = ""'>Clear</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => showWriteModal = false">Dismiss</button>
                    </div>
                }
                else if (!busy)
                {
                    <button class="btn btn-sm btn-danger" @onclick="DoWrite"><i class="bi bi-pen"></i> Generate</button>
                }
            </div>
        </div>
    </div>
}

@* ── What Next Modal ─────────────────────────────────── *@
@if (showWhatNextModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="() => showWhatNextModal = false">
        <div class="card bg-dark text-light border-primary" style="width: 750px; max-height: 85vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-primary fw-bold"><i class="bi bi-lightning"></i> What Next?</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => showWhatNextModal = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                @if (generatingPremises)
                {
                    <div class="d-flex align-items-center gap-2">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                        <small class="text-muted">Analyzing character goals and finding conflicts...</small>
                    </div>
                }
                else if (conflictPremises.Any())
                {
                    <p class="text-muted small mb-3">Based on character goals and current story state, these conflicts are ready to erupt:</p>
                    @foreach (var premise in conflictPremises)
                    {
                        var p = premise;
                        <div class="border border-secondary rounded p-3 mb-2">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <span class="fw-bold">@p.Title</span>
                                <span class="badge bg-danger">Tension @p.Tension/10</span>
                            </div>
                            <div class="small text-muted mb-1">@p.ConflictType — @string.Join(", ", p.CharactersInvolved)</div>
                            <div class="small mb-2">@p.Premise</div>
                            <div class="small text-info mb-2">@p.ThematicResonance</div>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => UseConflictPremise(p)">
                                <i class="bi bi-pen"></i> Write This
                            </button>
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted text-center py-3">No conflicts found. Add more characters to the story.</div>
                }
            </div>
        </div>
    </div>
}

@* ── Outline Modal ──────────────────────────────────── *@
@if (showOutlineModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="() => showOutlineModal = false">
        <div class="card bg-dark text-light border-success" style="width: 800px; max-height: 85vh; overflow-y: auto;"
             @onclick:stopPropagation="true">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-success fw-bold"><i class="bi bi-list-ol"></i> Story Outline</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => showOutlineModal = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                @if (generatingOutline)
                {
                    <div class="d-flex align-items-center gap-2">
                        <div class="spinner-border spinner-border-sm text-success"></div>
                        <small class="text-muted">Architecting story arc...</small>
                    </div>
                }
                else if (currentOutline != null)
                {
                    <h6 class="text-danger">@currentOutline.Title</h6>
                    <p class="small text-muted">@currentOutline.Logline</p>
                    <p class="small text-info">Theme: @currentOutline.Theme</p>

                    @foreach (var act in currentOutline.Acts)
                    {
                        <div class="mb-3">
                            <div class="fw-bold text-warning">Act @act.ActNumber: @act.Name</div>
                            <small class="text-muted">@act.Purpose</small>
                            @foreach (var beat in act.Beats)
                            {
                                var b = beat;
                                <div class="d-flex align-items-start gap-2 border-start border-secondary ps-2 ms-2 mt-1 @(b.Written ? "opacity-50" : "")">
                                    <span class="badge @(b.Written ? "bg-success" : "bg-secondary") mt-1" style="min-width: 24px;">@(b.BeatIndex + 1)</span>
                                    <div class="flex-grow-1">
                                        <div class="small fw-bold">@b.Title</div>
                                        <div class="small text-muted">@b.Goal</div>
                                        @if (b.Seeds.Count > 0) { <small class="text-info">Seeds: @string.Join(", ", b.Seeds)</small> }
                                    </div>
                                    @if (!b.Written)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => WriteBeatFromOutline(b)">Write</button>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (currentOutline.CharacterArcs.Any())
                    {
                        <div class="field-label text-danger mt-3">Character Arcs</div>
                        @foreach (var arc in currentOutline.CharacterArcs)
                        {
                            <div class="small border-start border-secondary ps-2 ms-2 mt-1">
                                <span class="fw-bold">@arc.Character:</span> @arc.StartState → @arc.EndState
                                <div class="text-muted">Turning point: @arc.TurningPoint (Cost: @arc.Cost)</div>
                            </div>
                        }
                    }
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label text-muted">Premise</label>
                        <textarea class="form-control bg-dark text-light border-secondary" rows="2"
                                  placeholder="What's this story about?" @bind="outlinePremise"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted">Target Beats</label>
                        <input type="number" class="form-control form-control-sm bg-dark text-light border-secondary"
                               min="6" max="24" @bind="outlineTargetBeats" style="width: 80px;" />
                    </div>
                    <button class="btn btn-sm btn-success" @onclick="GenerateOutline" disabled="@string.IsNullOrWhiteSpace(outlinePremise)">
                        <i class="bi bi-list-ol"></i> Generate Outline
                    </button>
                }
            </div>
        </div>
    </div>
}

@* ── Validate Modal ──────────────────────────────────── *@
@if (showValidateModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);">
        <div class="card bg-dark text-light border-warning" style="width: 900px; max-height: 85vh; overflow-y: auto;">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-warning fw-bold"><i class="bi bi-shield-check"></i> Validate @(validationResults.Count > 0 ? "(1 issue found)" : "")</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => showValidateModal = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                @if (validating)
                {
                    <div class="d-flex align-items-center gap-2">
                        <div class="spinner-border spinner-border-sm text-warning"></div>
                        <small class="text-muted">@validateProgress</small>
                    </div>
                    @if (validateTotal > 0)
                    {
                        <div class="progress mt-2" style="height: 4px;">
                            <div class="progress-bar bg-warning" style="width: @(validateCompleted * 100 / validateTotal)%"></div>
                        </div>
                    }
                }
                else if (!validationResults.Any())
                {
                    <div class="text-success text-center py-4">
                        <i class="bi bi-check-circle" style="font-size: 2rem;"></i>
                        <div class="mt-2">No contradictions found</div>
                    </div>
                }
                else
                {
                    @for (int idx = 0; idx < validationResults.Count; idx++)
                    {
                        var issue = validationResults[idx];
                        var i = idx;
                        <div class="border border-secondary rounded p-3 mb-3 @(i == activeIssueIdx ? "border-warning" : "")">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge @(issue.Severity == IssueSeverity.Hard ? "bg-danger" : "bg-warning text-dark") me-2">@issue.Category</span>
                                    <span class="fw-bold">@issue.EntityName</span>
                                </div>
                                <small class="text-muted">@(i + 1) / @validationResults.Count</small>
                            </div>
                            <div class="small text-muted mb-2">@issue.Description</div>

                            @* Side-by-side: Canon (left) vs Story (right) *@
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <div class="field-label text-success">Canon Truth</div>
                                    <div class="bg-black rounded p-2 small" style="min-height: 40px;">@issue.CanonTruth</div>
                                </div>
                                <div class="col-6">
                                    <div class="field-label text-danger">In Story</div>
                                    <div class="bg-black rounded p-2 small" style="min-height: 40px;">@issue.StoryText</div>
                                </div>
                            </div>

                            @* Resolution: Sync Story → Canon *@
                            <div class="field-label text-success mb-1">Sync Story to Canon</div>
                            <div class="d-flex flex-column gap-1 mb-2">
                                @{ var storyFixes = issue.StoryFixes
                                    .Select((fix, idx) => (fix, score: idx < issue.StoryFixScores.Count ? issue.StoryFixScores[idx] : 0))
                                    .OrderByDescending(x => x.score)
                                    .ToList(); }
                                @foreach (var (fix, score) in storyFixes)
                                {
                                    var fixText = fix;
                                    <button class="btn btn-sm btn-outline-info text-start" style="height:auto; white-space:normal;" @onclick="() => ResolveWithAlternative(i, fixText)">
                                        @if (score > 0)
                                        {
                                            <span class="badge @(score >= 70 ? "bg-success" : score >= 40 ? "bg-warning text-dark" : "bg-secondary") me-1">@score%</span>
                                        }
                                        @fixText
                                    </button>
                                }
                            </div>

                            @* Resolution: Sync Canon → Story *@
                            @if (issue.CanonFixes.Count > 0)
                            {
                                <div class="field-label text-warning mb-1">Sync Canon to Story</div>
                                <div class="d-flex flex-column gap-1 mb-2">
                                    @{ var canonFixes = issue.CanonFixes
                                        .Select((fix, idx) => (fix, score: idx < issue.CanonFixScores.Count ? issue.CanonFixScores[idx] : 0))
                                        .OrderByDescending(x => x.score)
                                        .ToList(); }
                                    @foreach (var (fix, score) in canonFixes)
                                    {
                                        var fixText = fix;
                                        <button class="btn btn-sm btn-outline-warning text-start" style="height:auto; white-space:normal;" @onclick="() => ResolveUpdateCanon(i, fixText)">
                                            @if (score > 0)
                                            {
                                                <span class="badge @(score >= 70 ? "bg-success" : score >= 40 ? "bg-warning text-dark" : "bg-secondary") me-1">@score%</span>
                                            }
                                            @fixText
                                        </button>
                                    }
                                </div>
                            }

                            <div class="d-flex gap-1 mb-2">
                                <button class="btn btn-sm btn-outline-secondary text-start" style="height:auto; white-space:normal;" @onclick="() => GenerateMore(i)" disabled="@generatingMore">
                                    @if (generatingMore && activeIssueIdx == i) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    <i class="bi bi-arrow-repeat me-1"></i> More alternatives
                                </button>
                                <button class="btn btn-sm btn-outline-secondary text-start" style="height:auto; white-space:normal;" @onclick="() => DismissIssue(i)">
                                    <i class="bi bi-x me-1"></i> Ignore
                                </button>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}

@* ── Suggest Alternatives Modal ────────────────────────── *@
@if (showAlternativesModal)
{
    <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
         style="z-index: 1050; background: rgba(0,0,0,0.7);">
        <div class="card bg-dark text-light border-info" style="width: 800px; max-height: 85vh; overflow-y: auto;">
            <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                <span class="text-info fw-bold"><i class="bi bi-lightbulb"></i> Suggest Alternatives</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => showAlternativesModal = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="card-body">
                <div class="field-label text-muted mb-1">Original</div>
                <div class="bg-black rounded p-2 small mb-3">@altOriginalText</div>

                @if (generatingAlts)
                {
                    <div class="d-flex align-items-center gap-2">
                        <div class="spinner-border spinner-border-sm text-info"></div>
                        <small class="text-muted">Generating alternatives...</small>
                    </div>
                }
                else if (suggestedAlts.Count > 0)
                {
                    <div class="field-label text-info mb-1">Alternatives</div>
                    <div class="d-flex flex-column gap-1 mb-2">
                        @{ var sorted = suggestedAlts
                            .Select((alt, idx) => (alt, score: idx < altScores.Count ? altScores[idx] : 0))
                            .OrderByDescending(x => x.score)
                            .ToList(); }
                        @foreach (var (alt, score) in sorted)
                        {
                            var altText = alt;
                            <button class="btn btn-sm btn-outline-info text-start" style="height:auto; white-space:normal;" @onclick="() => ApplyAlternative(altText)">
                                @if (score > 0)
                                {
                                    <span class="badge @(score >= 70 ? "bg-success" : score >= 40 ? "bg-warning text-dark" : "bg-secondary") me-1">@score%</span>
                                }
                                @altText
                            </button>
                        }
                    </div>
                }

                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-outline-info" @onclick="GenerateMoreAlts" disabled="@generatingAlts">
                        <i class="bi bi-arrow-repeat me-1"></i> Generate more
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => showAlternativesModal = false">
                        Close
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Formatting Toolbar ────────────────────────────────── *@
@if (viewMode == "editor")
{
<div class="d-flex gap-1 mb-1 align-items-center" style="overflow-x: auto; white-space: nowrap; padding-top: 3px; padding-bottom: 3px;">
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatBlock("h1")' title="Heading 1" style="font-weight: bold;">H1</button>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatBlock("h2")' title="Heading 2" style="font-weight: bold;">H2</button>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatBlock("h3")' title="Heading 3" style="font-weight: bold;">H3</button>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatBlock("p")' title="Paragraph">P</button>
    <span class="text-secondary mx-1">|</span>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatInline("bold")' title="Bold"><i class="bi bi-type-bold"></i></button>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatInline("italic")' title="Italic"><i class="bi bi-type-italic"></i></button>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatInline("underline")' title="Underline"><i class="bi bi-type-underline"></i></button>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatInline("strikethrough")' title="Strikethrough"><i class="bi bi-type-strikethrough"></i></button>
    <span class="text-secondary mx-1">|</span>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatList("unordered")' title="Bullet list"><i class="bi bi-list-ul"></i></button>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatList("ordered")' title="Numbered list"><i class="bi bi-list-ol"></i></button>
    <button class="btn btn-outline-secondary tb" @onclick='() => FormatBlock("blockquote")' title="Quote"><i class="bi bi-quote"></i></button>
    <button class="btn btn-outline-secondary tb" @onclick="InsertHorizontalRule" title="Scene break"><i class="bi bi-dash-lg"></i></button>
    <button class="btn btn-outline-secondary tb" @onclick="() => showImageInsert = !showImageInsert" title="Insert image"><i class="bi bi-image"></i></button>
    <span class="text-secondary mx-1">|</span>
    @* Entity link toggle removed — use right-click > Ask instead *@
    <button class="btn @(showSceneSidebar ? "btn-outline-danger" : "btn-outline-secondary") tb" @onclick="() => showSceneSidebar = !showSceneSidebar" title="Scene sidebar"><i class="bi bi-diagram-3"></i></button>
    <div class="dropdown d-inline-block">
        <button class="btn btn-outline-secondary tb dropdown-toggle" type="button" data-bs-toggle="dropdown" title="Export">
            <i class="bi bi-download"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-dark">
            <li><button class="dropdown-item" @onclick="ExportAsTxt"><i class="bi bi-file-text me-2"></i>Plain Text (.txt)</button></li>
            <li><button class="dropdown-item" @onclick="ExportAsMd"><i class="bi bi-markdown me-2"></i>Markdown (.md)</button></li>
            <li><button class="dropdown-item" @onclick="ExportAsPdf"><i class="bi bi-file-pdf me-2"></i>PDF (Print)</button></li>
            <li><hr class="dropdown-divider"></li>
            <li><button class="dropdown-item @(narrating || !ttsAvailable ? "disabled" : "")" @onclick="ExportAsMp3"><i class="bi bi-file-music me-2"></i>MP3 (Narration)</button></li>
            <li><button class="dropdown-item @(narrating || !ttsAvailable ? "disabled" : "")" @onclick="ExportAsOgg"><i class="bi bi-file-music me-2"></i>OGG (Narration)</button></li>
        </ul>
    </div>
</div>
}

<div class="row g-2">
    <div class="@(showSceneSidebar ? "col-md-8" : "col-12")">
        @if (viewMode == "editor")
        {
            <div id="story-surface" class="form-control bg-dark text-light border-secondary rich-editor @(showLinks ? "" : "hide-links")"
                 contenteditable="true" style="min-height: calc(100vh - 300px); overflow-y: scroll; overflow-x: hidden;"
                 @onclick="() => { showContextMenu = false; showImageInsert = false; }"></div>
        }

        @* ── Image Insert Panel ────────────────────────── *@
        @* ── Image Insert Modal ─────────────────────── *@
        @if (showImageInsert)
        {
            <div class="position-fixed top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
                 style="z-index: 1050; background: rgba(0,0,0,0.7);" @onclick="() => showImageInsert = false">
                <div class="card bg-dark text-light border-secondary" style="width: 500px;" @onclick:stopPropagation="true">
                    <div class="card-header d-flex justify-content-between align-items-center border-secondary">
                        <span class="text-muted fw-bold"><i class="bi bi-image"></i> Insert Image</span>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => showImageInsert = false"><i class="bi bi-x-lg"></i></button>
                    </div>
                    <div class="card-body">
                        <textarea class="form-control form-control-sm bg-dark text-light border-secondary mb-2"
                                  placeholder="Paste base64 image data (data:image/png;base64,... or raw base64)"
                                  @bind="imageBase64" style="font-family: monospace; font-size: 0.7rem; min-height: 80px;"></textarea>
                        <div class="d-flex gap-2 align-items-center mb-2">
                            <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                                   placeholder="Alt text (optional)" @bind="imageAlt" />
                            <button class="btn btn-sm btn-info text-dark text-nowrap" @onclick="DoInsertImage"
                                    disabled="@string.IsNullOrWhiteSpace(imageBase64)">
                                <i class="bi bi-image"></i> Insert
                            </button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(imageBase64))
                        {
                            <div class="text-center">
                                <img src="@NormalizeImageSrc(imageBase64)" alt="@imageAlt" style="max-width: 100%; max-height: 250px; border-radius: 4px;" />
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @* ── Right-click context menu ──────────────────── *@
        @if (showContextMenu)
        {
            <div class="position-fixed bg-dark border border-secondary rounded shadow-lg py-1"
                 style="z-index: 1070; top: @(ctxMenuTop)px; left: @(ctxMenuLeft)px; min-width: 160px;">
                <button class="btn btn-sm btn-dark text-light d-block w-100 text-start px-3 py-1" @onclick="OpenSuggestAlternatives" disabled="@(!hasSelection)">
                    <i class="bi bi-lightbulb text-warning me-2"></i>Suggest Alternatives
                </button>
                <button class="btn btn-sm btn-dark text-light d-block w-100 text-start px-3 py-1" @onclick="ReadSelected" disabled="@(narrating || !hasSelection)">
                    <i class="bi bi-volume-up text-info me-2"></i>Read Selected
                </button>
                <button class="btn btn-sm btn-dark text-light d-block w-100 text-start px-3 py-1" @onclick="ReadAll" disabled="@narrating">
                    <i class="bi bi-megaphone text-info me-2"></i>Read All
                </button>
            </div>
        }

        @if (viewMode == "preview")
        {
            @if (string.IsNullOrWhiteSpace(printHtml))
            {
                <div class="text-muted d-flex align-items-center justify-content-center" style="min-height: 40vh;">
                    Nothing to preview — write something first.
                </div>
            }
            else
            {
                <div class="border border-secondary rounded" style="height: calc(100vh - 300px); overflow-y: auto;">
                    <div class="story-preview-print bg-white text-dark p-4" style="font-family: Georgia, serif; font-size: 16px; line-height: 2; max-width: 700px; margin: 0 auto;">
                        @((MarkupString)printHtml)
                    </div>
                </div>
            }
        }

        @* ── Audio Player ──────────────────────────── *@
        <AudioPlayer @ref="audioPlayer"
                     Visible="true"
                     OnDismissed="() => {}"
                     OnInsertTag="InsertTag"
                     OnReadSelected="ReadSelected"
                     OnReadAll="ReadAll"
                     HasSelection="hasSelection"
                     Engine="@ttsEngine"
                     EngineChanged="e => ttsEngine = e"
                     ShowTagInserter="false"
                     CssClass="mt-1" />

        @* ── ElevenLabs Tag Bar ────────────────────── *@
        <div class="bg-dark border border-secondary rounded mt-1 d-flex align-items-center gap-1 px-3 py-1 flex-wrap" style="font-size: 0.75rem;">
            <small class="text-muted fw-bold me-1">TTS Tags</small>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[short pause]")'>short pause</button>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[long pause]")'>long pause</button>
            <span class="text-secondary mx-1">|</span>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[whispers]")'>whispers</button>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[sighs]")'>sighs</button>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[laughs]")'>laughs</button>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[chuckles]")'>chuckles</button>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[clears throat]")'>clears throat</button>
            <span class="text-secondary mx-1">|</span>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[exhales]")'>exhales</button>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[exhales sharply]")'>sharp exhale</button>
            <button class="btn btn-dark btn-sm py-0 px-2 text-light" @onclick='() => InsertTag("[inhales deeply]")'>deep inhale</button>
        </div>

        @* ── Bottom bar: view toggle left, Ask/Write right ── *@
        <div class="d-flex align-items-center mt-1">
            <div class="btn-group">
                <button class="btn btn-sm @(viewMode == "editor" ? "btn-danger" : "btn-outline-secondary")" style="width: 100px;" @onclick='() => SwitchViewMode("editor")'><i class="bi bi-brush"></i> Editor</button>
                <button class="btn btn-sm @(viewMode == "preview" ? "btn-danger" : "btn-outline-secondary")" style="width: 100px;" @onclick='() => SwitchViewMode("preview")'><i class="bi bi-printer"></i> Preview</button>
            </div>
            <div class="ms-auto d-flex gap-2">
                <button class="btn btn-sm btn-outline-success" @onclick="ShowOutlineModal" disabled="@busy">
                    <i class="bi bi-list-ol"></i> Outline
                </button>
                <button class="btn btn-sm btn-outline-primary" @onclick="WhatNext" disabled="@(busy || project.Characters.Count == 0)">
                    <i class="bi bi-lightning"></i> What Next?
                </button>
                <button class="btn btn-sm btn-outline-warning" @onclick="RunValidation" disabled="@(busy || !hasExistingText)">
                    <i class="bi bi-shield-check"></i> Validate
                </button>
                <button class="btn btn-sm btn-outline-info" @onclick="() => showAskModal = true" disabled="@busy">
                    <i class="bi bi-chat-dots"></i> Ask
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="() => showWriteModal = true" disabled="@busy">
                    <i class="bi bi-pen"></i> Write
                </button>
            </div>
        </div>
    </div>

    @if (showSceneSidebar)
    {
        <div class="col-md-4">
            @* ── Validation Warnings ──────────────────── *@
            @if (validationIssues.Count > 0)
            {
                <div class="card bg-dark text-light border-warning mb-2">
                    <div class="card-header py-1 text-warning small fw-bold">
                        <i class="bi bi-exclamation-triangle"></i> Canon Issues (@validationIssues.Count)
                    </div>
                    <div class="card-body py-2 small">
                        @foreach (var issue in validationIssues)
                        {
                            <div class="d-flex align-items-start gap-1 mb-1">
                                <i class="bi bi-exclamation-circle text-warning" style="margin-top: 2px;"></i>
                                <span>@issue</span>
                            </div>
                        }
                        <button class="btn btn-sm btn-outline-warning mt-1" @onclick="() => validationIssues.Clear()">Dismiss</button>
                    </div>
                </div>
            }

            @* ── Live Outline ──────────────────────────── *@
            <div class="card bg-dark text-light border-secondary mb-2">
                <div class="card-header py-1 d-flex justify-content-between align-items-center">
                    <small class="text-muted fw-bold">Outline</small>
                    <button class="btn btn-sm btn-outline-info py-0 px-1" @onclick="RefreshOutline" title="Rebuild outline from text">
                        <i class="bi bi-arrow-repeat" style="font-size: 0.7rem;"></i>
                    </button>
                </div>
                <div class="card-body py-1" style="max-height: 40vh; overflow-y: auto;">
                    @if (outlineSections.Count == 0)
                    {
                        <small class="text-muted">Write some text, then refresh.</small>
                    }
                    @foreach (var sec in outlineSections)
                    {
                        <div class="mb-2">
                            <div class="fw-bold small text-danger" style="cursor: pointer;" @onclick="() => ScrollToSection(sec.index)">
                                @sec.title
                            </div>
                            @if (sec.characters.Count > 0)
                            {
                                <div class="ms-2">
                                    @foreach (var ch in sec.characters)
                                    {
                                        <span class="badge bg-info me-1 mb-1" style="font-size: 0.6rem; cursor: pointer;" @onclick="() => ShowEntityDetail(ch.id)">@ch.name</span>
                                    }
                                </div>
                            }
                            @if (sec.locations.Count > 0)
                            {
                                <div class="ms-2">
                                    @foreach (var loc in sec.locations)
                                    {
                                        <span class="badge bg-success me-1 mb-1" style="font-size: 0.6rem; cursor: pointer;" @onclick="() => ShowEntityDetail(loc.id)">@loc.name</span>
                                    }
                                </div>
                            }
                            @if (sec.items.Count > 0)
                            {
                                <div class="ms-2">
                                    @foreach (var item in sec.items)
                                    {
                                        <span class="badge @GetTypeBadgeClass(item.nodeType) me-1 mb-1" style="font-size: 0.6rem; cursor: pointer;" @onclick="() => ShowEntityDetail(item.id)">@item.name</span>
                                    }
                                </div>
                            }
                            <small class="text-muted ms-2">@sec.wordCount words</small>
                        </div>
                    }
                    @if (_sceneEntities.Count > 0)
                    {
                        <hr class="border-secondary my-2">
                        <small class="text-muted fw-bold">All Entities (@_sceneEntities.Count)</small>
                        @foreach (var group in _sceneEntities.GroupBy(e => e.nodeType))
                        {
                            <div class="mb-1">
                                <small class="fw-bold" style="color: @GetTypeColor(group.Key);">@group.Key</small>
                                @foreach (var ent in group)
                                {
                                    <span class="badge @GetTypeBadgeClass(group.Key) me-1" style="font-size: 0.55rem; cursor: pointer;" @onclick="() => ShowEntityDetail(ent.id)">@ent.name</span>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            @* ── Entity Detail ─────────────────────────── *@
            @if (detailNode != null)
            {
                <div class="card bg-dark text-light border-info mb-2">
                    <div class="card-header py-1 d-flex justify-content-between align-items-center">
                        <span>
                            <span class="badge @GetTypeBadgeClass(detailNode.NodeType) me-1">@detailNode.NodeType</span>
                            <strong>@detailNode.Name</strong>
                        </span>
                        <button class="btn btn-sm btn-outline-secondary py-0 px-1" @onclick="() => detailNode = null"><i class="bi bi-x"></i></button>
                    </div>
                    <div class="card-body py-2 small" style="max-height: 30vh; overflow-y: auto; line-height: 1.4;">
                        @foreach (var key in new[] { "gender", "pronouns", "role", "status", "age", "affiliation", "location", "category", "manufacturer" })
                        {
                            if (detailNode.Properties.TryGetValue(key, out var val) && val.Length > 0)
                            {
                                <div><span class="text-info">@key:</span> @val</div>
                            }
                        }
                        @if (detailNode.Properties.TryGetValue("description", out var ddesc) && ddesc.Length > 0)
                        {
                            <div class="text-muted mt-1">@(ddesc.Length > 300 ? ddesc[..297] + "..." : ddesc)</div>
                        }
                        @{ var detailEdges = Graph.GetAllEdges(detailNode.Id); }
                        @if (detailEdges.Count > 0)
                        {
                            <div class="mt-1"><small class="text-muted fw-bold">Relationships:</small></div>
                            @foreach (var edge in detailEdges.Take(10))
                            {
                                var other = edge.Source == detailNode.Id ? edge.Target : edge.Source;
                                var otherNode = Graph.GetNode(other);
                                <div class="d-flex align-items-center gap-1">
                                    <span class="badge bg-dark border border-secondary" style="font-size: 0.6rem;">@edge.RelationType</span>
                                    <span>@(otherNode?.Name ?? other)</span>
                                </div>
                            }
                        }
                        @if (detailNode.History.Count > 0)
                        {
                            <div class="mt-1 text-warning"><small class="fw-bold">Timeline:</small></div>
                            @foreach (var h in detailNode.History.OrderBy(x => x.StoryPoint))
                            {
                                <div>[@h.StoryPoint] @h.Property: @h.OldValue → @h.NewValue</div>
                            }
                        }
                    </div>
                </div>
            }

            @* ── Mini Scene Graph ──────────────────────── *@
            <div class="card bg-dark text-light border-secondary">
                <div class="card-header py-1 d-flex justify-content-between align-items-center">
                    <small class="text-muted fw-bold">Scene Graph</small>
                    <button class="btn btn-sm btn-outline-danger py-0 px-1" @onclick="RenderMiniGraph" title="Render">
                        <i class="bi bi-play" style="font-size: 0.7rem;"></i>
                    </button>
                </div>
                <div id="miniGraphCanvas" style="width: 100%; height: 25vh; background: #111; border-radius: 0 0 4px 4px;"></div>
            </div>
        </div>
    }
</div>

@if (error != null)
{
    <div class="alert alert-warning mt-2 py-1 small">@error</div>
}

@if (graphStatus != null)
{
    <div class="d-flex align-items-center gap-2 mt-1">
        @if (extracting) { <div class="spinner-border spinner-border-sm text-info" style="width: 0.8rem; height: 0.8rem;"></div> }
        else { <i class="bi bi-diagram-3 text-info" style="font-size: 0.75rem;"></i> }
        <small class="text-muted" style="font-size: 0.7rem;">@graphStatus</small>
    </div>
}

@code {
    [Parameter] public string? ProjectId { get; set; }

    // ── Core state ──
    private StoryProject project = new();
    private string storyText = "";
    private int wordCount;
    private bool saved;
    private string? error;
    private bool busy;
    private string statusMessage = "";

    // ── Audio ──
    private bool ttsAvailable;
    private bool narrating;
    private bool hasSelection;
    private string currentSelection = "";

    // ── Suggest Alternatives ──
    private bool showAlternativesModal;
    private bool generatingAlts;
    private string altOriginalText = "";
    private List<string> suggestedAlts = [];
    private List<int> altScores = [];
    private AudioPlayer? audioPlayer;
    private string ttsEngine = "elevenlabs"; // "elevenlabs" or "windows"


    // ── Bottom dock ──
    private bool showTagBar;

    // ── Image insert ──
    private bool showImageInsert;
    private string imageBase64 = "";
    private string imageAlt = "";

    // ── Context menu ──
    private bool showContextMenu;
    private double ctxMenuTop;
    private double ctxMenuLeft;

    // ── Entity extraction ──
    private bool extracting;
    private string? graphStatus;
    private string lastExtractedText = "";

    // ── Ask modal ──
    private bool showAskModal;
    private string commandText = "";
    private string commandResult = "";
    private string askScope = "story";

    // ── Write modal ──
    private bool showWriteModal;
    private string writeText = "";
    private string writeResult = "";

    // ── What Next ──
    private bool showWhatNextModal;
    private bool generatingPremises;
    private List<ConflictPremise> conflictPremises = [];

    // ── Outline ──
    private bool showOutlineModal;
    private bool generatingOutline;
    private StoryOutline? currentOutline;
    private string outlinePremise = "";
    private int outlineTargetBeats = 12;

    // ── Validate ──
    private bool showValidateModal;
    private bool validating;
    private bool generatingMore;
    private int activeIssueIdx;
    private string validateProgress = "";
    private int validateCompleted, validateTotal;
    private List<CanonIssue> validationResults = [];

    // ── Editor ──
    private bool showLinks;
    private string viewMode = "editor"; // "editor" or "preview"
    private string richHtml = "";
    private string printHtml = "";
    private DotNetObjectReference<WriteStory>? editorRef;
    private bool richEditorInitialized;

    // ── Scene sidebar ──
    private bool showSceneSidebar;
    private List<(string id, string name, string nodeType)> _sceneEntities = [];
    private List<string> validationIssues = [];
    private WorldNode? detailNode;
    private DotNetObjectReference<WriteStory>? miniGraphRef;
    private List<OutlineSection> outlineSections = [];

    private record OutlineSection(
        int index,
        string title,
        int wordCount,
        List<(string id, string name)> characters,
        List<(string id, string name)> locations,
        List<(string id, string name, string nodeType)> items);

    // ── Auto-save ──
    private System.Threading.Timer? saveTimer;
    private bool dirty;
    private bool hasExistingText => !string.IsNullOrWhiteSpace(storyText);

    // ── Lifecycle ──

    protected override async Task OnInitializedAsync()
    {
        ttsAvailable = await TtsSvc.IsConfiguredAsync();
        if (!string.IsNullOrEmpty(ProjectId))
        {
            var loaded = Repo.LoadProject(ProjectId);
            if (loaded != null) project = loaded;
        }
        richHtml = project.Html;
        storyText = project.PlainText;
        validationResults = LoadValidation();
        if (validationResults.Count > 0) showValidateModal = true;
        UpdateWordCount();

        // Auto-save new projects so they appear in the Stories list
        if (string.IsNullOrEmpty(ProjectId))
        {
            Repo.SaveProject(project);
            Nav.NavigateTo($"/write/{project.Id}", replace: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || (!richEditorInitialized && viewMode == "editor"))
            await InitRichEditor();
    }

    private async Task InitRichEditor()
    {
        if (viewMode != "editor") return;
        editorRef?.Dispose();
        editorRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("writeInterop.richEditor.init", "story-surface", editorRef, richHtml);
        richEditorInitialized = true;

        var allNodes = Graph.AllNodes();
        var entities = allNodes.Where(n => n.Name.Length >= 3)
            .Select(n => new { name = n.Name, id = n.Id, nodeType = n.NodeType }).ToArray();
        await JS.InvokeVoidAsync("writeInterop.richEditor.buildEntityIndex", (object)entities);
    }

    // ── JS Callbacks ──

    [JSInvokable]
    public void OnRichContentChanged(string html, string plainText)
    {
        richHtml = html;
        storyText = plainText;
        dirty = true;
        saved = false;
        UpdateWordCount();
        saveTimer?.Dispose();
        saveTimer = new System.Threading.Timer(_ => { if (dirty) InvokeAsync(Save); }, null, 2000, Timeout.Infinite);
    }

    [JSInvokable]
    public void OnEntityClicked(string entityId)
    {
        ShowEntityDetail(entityId);
        if (!showSceneSidebar) showSceneSidebar = true;
        StateHasChanged();
    }

    [JSInvokable] public void OnNodeClicked(string nodeId) => OnEntityClicked(nodeId);
    [JSInvokable] public Task OnNodeExpand(string nodeId) { OnEntityClicked(nodeId); return Task.CompletedTask; }
    [JSInvokable] public void OnBackgroundClicked() { detailNode = null; StateHasChanged(); }

    [JSInvokable]
    public void OnEditorContextMenu(double top, double left)
    {
        ctxMenuTop = top;
        ctxMenuLeft = left;
        showContextMenu = true;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnSelectionChanged(string selectedText)
    {
        currentSelection = selectedText;
        var wordCount = string.IsNullOrWhiteSpace(selectedText) ? 0
            : selectedText.Split([' ', '\n', '\r', '\t'], StringSplitOptions.RemoveEmptyEntries).Length;
        var had = hasSelection;
        hasSelection = wordCount >= 3;
        if (had != hasSelection) await InvokeAsync(StateHasChanged);
    }

    // ── Command Execution ──

    // ── Ask ──

    private async Task ExecuteAsk()
    {
        if (string.IsNullOrWhiteSpace(commandText)) return;
        busy = true;
        commandResult = "";
        statusMessage = askScope == "series" ? "Querying all stories + world graph..." : "Querying story + world graph...";
        StateHasChanged();

        try
        {
            var session = new NarrativeSessionContext(Graph);
            session.ScanText(commandText);
            if (hasExistingText) session.ScanText(storyText);
            var worldContext = session.BuildContext();

            string storyContext;
            if (askScope == "series")
            {
                var allProjects = Repo.ListProjects();
                var parts = new List<string>();
                foreach (var proj in allProjects)
                {
                    var full = Repo.LoadProject(proj.Id);
                    if (full == null) continue;
                    var text = full.PlainText;
                    if (text.Length > 0)
                        parts.Add($"=== {full.Title} ===\n{(text.Length > 8000 ? text[..8000] + "..." : text)}");
                }
                storyContext = string.Join("\n\n", parts);
            }
            else
                storyContext = storyText;

            var system = $"""
                You are a story assistant. Answer ONLY using the story text and world graph data below.
                Do NOT invent facts. If the answer is not in the provided data, say "Not found in available data."

                WORLD GRAPH (canonical entity data):
                {worldContext}

                STORY TEXT:
                {(storyContext.Length > 12000 ? storyContext[..12000] + "\n[truncated]" : storyContext)}
                """;
            commandResult = await Llm.GenerateAsync(system, commandText, 0.3, 2048);
        }
        catch (Exception ex) { commandResult = $"Error: {ex.Message}"; }
        finally { busy = false; statusMessage = ""; }
    }

    private void CloseAsk() { commandResult = ""; showAskModal = false; }

    private async Task HandleAskKeyDown(KeyboardEventArgs e)
    {
        if (e is { Key: "Enter", CtrlKey: true }) await ExecuteAsk();
    }

    // ── Write ──

    private async Task DoWrite()
    {
        if (string.IsNullOrWhiteSpace(writeText)) return;
        busy = true;
        writeResult = "";
        statusMessage = "Loading world context...";
        StateHasChanged();

        try
        {
            // Auto-detect characters and locations from existing story text + prompt
            // so the LLM always has full graph context for every entity mentioned
            var characters = new List<string>(project.Characters);
            if (hasExistingText)
            {
                var session = new NarrativeSessionContext(Graph);
                session.ScanText(storyText);
                session.ScanText(writeText);
                var snapshot = session.GetSnapshot();
                foreach (var e in snapshot.PrimaryEntities.Where(e => e.NodeType == "character"))
                    if (!characters.Contains(e.Name, StringComparer.OrdinalIgnoreCase))
                        characters.Add(e.Name);
            }

            // Detect location from scene sidebar or graph scan
            string? location = _sceneEntities
                .Where(e => e.nodeType is "district" or "place" or "location")
                .Select(e => e.name)
                .FirstOrDefault();

            statusMessage = "Writing...";
            StateHasChanged();

            if (!hasExistingText)
            {
                var opening = await Starter.GenerateOpeningAsync(new StoryStarterRequest
                {
                    Premise = writeText, Characters = characters, Location = location,
                });
                writeResult = opening.Text;
                if (project.Title is Constants.Defaults.UntitledStory or "") project.Title = opening.Title;
            }
            else
            {
                var paragraphs = storyText.Split(["\n\n", "\r\n\r\n"], StringSplitOptions.RemoveEmptyEntries)
                    .Select(p => p.Trim()).Where(p => p.Length > 0).ToList();

                // Inject story intelligence constraints
                var storyConstraints = StoryState.BuildConstraints(project.Id);
                var knowledgeConstraints = KnowledgeMap.BuildPovConstraints(project.Id, characters.FirstOrDefault() ?? "Kyle");
                var eventContext = EventLog.BuildRecentContext(project.Id);
                var outline = OutlineSvc.Load(project.Id);
                var outlineCtx = outline != null ? OutlineSvc.BuildBeatContext(outline, StoryState.GetState(project.Id).BeatCount) : null;

                writeResult = await Starter.ContinueAsync(paragraphs, writeText, null, location, characters,
                    storyConstraints, knowledgeConstraints, eventContext, outlineCtx);
            }
        }
        catch (Exception ex) { writeResult = $"Error: {ex.Message}"; }
        finally { busy = false; statusMessage = ""; }
    }

