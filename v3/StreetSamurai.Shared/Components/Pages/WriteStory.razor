    // ── Entity extraction ──
    private bool _extracting;
    private string? _graphStatus;
    private string _lastExtractedText = "";

    // ── Synchronize ──
    private bool _syncing;
    private bool _showSync;
    private string _syncIssues = "";
    private string _syncPreview = "";
    private string _syncStatus = "";

    // ── Chapters ──
    private int _activeChapter = 1;
    private bool _synopsizing;
    private bool _outlining;
    private bool _showOutline;
    private string _outlineText = "";
    private bool _showSynopsis = true;
    private StoryChapter? CurrentChapter => _project.Chapters.FirstOrDefault(c => c.Number == _activeChapter);
    private bool _showNewChapterDialog;
    private bool _showPerspectiveInput;
    private bool _creatingChapter;
    private string _newChapterPerspective = "";

    // ── Context menu ──
    private bool _showContextMenu;
    private double _menuTop;
    private double _menuLeft;
    private DotNetObjectReference<WriteStory>? _dotNetRef;
    private bool _confirmNarrateAll;
    private bool _confirmProfessional;
    private bool _useProfessionalTts;

