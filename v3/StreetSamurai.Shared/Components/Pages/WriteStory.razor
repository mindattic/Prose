    // ── Command Execution ──

    // ── Ask ──

    private async Task ExecuteAsk()
    {
        if (string.IsNullOrWhiteSpace(_commandText)) return;
        _busy = true;
        _commandResult = "";
        _statusMessage = _askScope == "series" ? "Querying all stories + world graph..." : "Querying story + world graph...";
        StateHasChanged();

        try
        {
            var session = new NarrativeSessionContext(Graph);
            session.ScanText(_commandText);
            if (_hasExistingText) session.ScanText(_storyText);
            var worldContext = session.BuildContext();

            string storyContext;
            if (_askScope == "series")
            {
                var allProjects = Repo.ListProjects();
                var parts = new List<string>();
                foreach (var proj in allProjects)
                {
                    var full = Repo.LoadProject(proj.Id);
                    if (full == null) continue;
                    var text = full.PlainText;
                    if (text.Length > 0)
                        parts.Add($"=== {full.Title} ===\n{(text.Length > 8000 ? text[..8000] + "..." : text)}");
                }
                storyContext = string.Join("\n\n", parts);
            }
            else
                storyContext = _storyText;

            var system = $"""
                You are a story assistant. Answer ONLY using the story text and world graph data below.
                Do NOT invent facts. If the answer is not in the provided data, say "Not found in available data."

                WORLD GRAPH (canonical entity data):
                {worldContext}

                STORY TEXT:
                {(storyContext.Length > 12000 ? storyContext[..12000] + "\n[truncated]" : storyContext)}
                """;
            _commandResult = await Llm.GenerateAsync(system, _commandText, 0.3, 2048);
        }
        catch (Exception ex) { _commandResult = $"Error: {ex.Message}"; }
        finally { _busy = false; _statusMessage = ""; }
    }

    private void CloseAsk() { _commandResult = ""; _showAskModal = false; }

    private async Task HandleAskKeyDown(KeyboardEventArgs e)
    {
        if (e is { Key: "Enter", CtrlKey: true }) await ExecuteAsk();
    }

    // ── Write ──

    private async Task DoWrite()
    {
        if (string.IsNullOrWhiteSpace(_writeText)) return;
        _busy = true;
        _writeResult = "";
        _statusMessage = "Loading world context...";
        StateHasChanged();

        try
        {
            // Auto-detect characters and locations from existing story text + prompt
            // so the LLM always has full graph context for every entity mentioned
            var characters = new List<string>(_project.Characters);
            if (_hasExistingText)
            {
                var session = new NarrativeSessionContext(Graph);
                session.ScanText(_storyText);
                session.ScanText(_writeText);
                var snapshot = session.GetSnapshot();
                foreach (var e in snapshot.PrimaryEntities.Where(e => e.NodeType == "character"))
                    if (!characters.Contains(e.Name, StringComparer.OrdinalIgnoreCase))
                        characters.Add(e.Name);
            }

            // Detect location from scene sidebar or graph scan
            string? location = _sceneEntities
                .Where(e => e.nodeType is "district" or "place" or "location")
                .Select(e => e.name)
                .FirstOrDefault();

            _statusMessage = "Writing...";
            StateHasChanged();

            if (!_hasExistingText)
            {
                var opening = await Starter.GenerateOpeningAsync(new StoryStarterRequest
                {
                    Premise = _writeText, Characters = characters, Location = location,
                });
                _writeResult = opening.Text;
                if (_project.Title is "Untitled" or "") _project.Title = opening.Title;
            }
            else
            {
                var paragraphs = _storyText.Split(["\n\n", "\r\n\r\n"], StringSplitOptions.RemoveEmptyEntries)
                    .Select(p => p.Trim()).Where(p => p.Length > 0).ToList();
                _writeResult = await Starter.ContinueAsync(paragraphs, _writeText, null, location, characters);
            }
        }
        catch (Exception ex) { _writeResult = $"Error: {ex.Message}"; }
        finally { _busy = false; _statusMessage = ""; }
    }

    private async Task ApplyWrite()
    {
        if (string.IsNullOrEmpty(_writeResult)) return;
        await AppendEditorText(_writeResult);
        UpdateWordCount();
        Save();
        _writeResult = "";
        _writeText = "";
        _showWriteModal = false;
        _ = PostGenerationHook();
        await FocusEditorEnd();
    }

    private async Task HandleWriteKeyDown(KeyboardEventArgs e)
    {
        if (e is { Key: "Enter", CtrlKey: true }) await DoWrite();
    }

