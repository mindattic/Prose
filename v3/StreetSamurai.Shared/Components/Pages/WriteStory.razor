    private void RefreshOutline()
    {
        if (string.IsNullOrWhiteSpace(storyText))
        {
            outlineSections = [];
            _sceneEntities = [];
            return;
        }

        // Split document on scene breaks (====== or <hr>)
        var sections = storyText.Split(["======"], StringSplitOptions.None)
            .Select(s => s.Trim())
            .Where(s => s.Length > 0)
            .ToList();

        outlineSections = [];

        for (int i = 0; i < sections.Count; i++)
        {
            var sectionText = sections[i];
            var title = $"Section {i + 1}";
            var wordCount = sectionText.Split((char[])[' ', '\n', '\r', '\t'], StringSplitOptions.RemoveEmptyEntries).Length;

            // Detect entities in this section
            var session = new NarrativeSessionContext(Graph);
            session.ScanText(sectionText);
            var snapshot = session.GetSnapshot();
            var textLower = sectionText.ToLowerInvariant();

            var chars = snapshot.PrimaryEntities
                .Where(e => e.NodeType == "character" && textLower.Contains(e.Name.ToLowerInvariant()))
                .Select(e => (id: Graph.ResolveId(e.Name) ?? "", name: e.Name))
                .DistinctBy(e => e.name).ToList();

            var locs = snapshot.PrimaryEntities
                .Where(e => e.NodeType == "place" && textLower.Contains(e.Name.ToLowerInvariant()))
                .Select(e => (id: Graph.ResolveId(e.Name) ?? "", name: e.Name))
                .DistinctBy(e => e.name).ToList();

            var items = snapshot.PrimaryEntities
                .Where(e => e.NodeType is "weapon" or "equipment" or "technology" && textLower.Contains(e.Name.ToLowerInvariant()))
                .Select(e => (id: Graph.ResolveId(e.Name) ?? "", name: e.Name, nodeType: e.NodeType))
                .DistinctBy(e => e.name).ToList();

            outlineSections.Add(new OutlineSection(i, title, wordCount, chars, locs, items));
        }

        // Also refresh the flat entity list
        RefreshSceneEntities();

        // Validation
        validationIssues = Validator.ValidateQuick(storyText)
            .Select(iss => $"[{iss.Category}] {iss.EntityName}: {iss.Description}").ToList();
    }

