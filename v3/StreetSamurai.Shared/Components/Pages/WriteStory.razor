    private async Task ExportAudio(string format, string ext, string mime)
    {
        if (_narrating || !_ttsAvailable || !_hasExistingText) return;
        _narrating = true;
        _statusMessage = $"Synthesizing {ext.TrimStart('.')} narration...";
        StateHasChanged();
        try
        {
            var ttsText = ConvertTagsForTts(_storyText);
            var audio = await TtsSvc.SynthesizeAsync(ttsText, voiceId: null, outputFormat: format, ct: default);
            var b64 = Convert.ToBase64String(audio);
            await JS.InvokeVoidAsync("writeInterop.downloadBlob", SafeFilename(ext), b64, mime);
        }
        catch (Exception ex) { _error = $"Audio export failed: {ex.Message}"; }
        finally { _narrating = false; _statusMessage = ""; }
    }

