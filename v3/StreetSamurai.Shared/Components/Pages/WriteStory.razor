    /// <summary>Strip entity links, ElevenLabs tags, and other interactive markup for print view.</summary>
    private static string BuildPrintHtml(string richHtml)
    {
        if (string.IsNullOrWhiteSpace(richHtml)) return "";
        var html = richHtml;
        // Strip entity link spans — keep inner text
        html = System.Text.RegularExpressions.Regex.Replace(html,
            @"<span[^>]*class=""entity-link[^""]*""[^>]*>(.*?)</span>", "$1");
        // Strip ElevenLabs tag spans
        html = System.Text.RegularExpressions.Regex.Replace(html,
            @"<span[^>]*class=""elevenlabs-tag[^""]*""[^>]*>.*?</span>", "");
        // Strip facet tag spans
        html = System.Text.RegularExpressions.Regex.Replace(html,
            @"<span[^>]*class=""facet-tag[^""]*""[^>]*>.*?</span>", "");
        // Strip all [bracket] tags — TTS/audio directions not for print
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\[[^\]]+\]", "");
        // Strip all {brace} tags — legacy format
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\{[^}]+\}", "");
        // Clean up double spaces
        html = System.Text.RegularExpressions.Regex.Replace(html, @"  +", " ");
        return html;
    }

    private string TextToHtml(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        // Decode unicode escapes like \u0022 \u0027 etc before processing
        text = System.Text.RegularExpressions.Regex.Replace(text, @"\\u([0-9a-fA-F]{4})",
            m => ((char)Convert.ToInt32(m.Groups[1].Value, 16)).ToString());
        var paragraphs = text.Split(["\n\n", "\r\n\r\n"], StringSplitOptions.RemoveEmptyEntries);
        return string.Join("", paragraphs.Select(p =>
            $"<p>{System.Net.WebUtility.HtmlEncode(p.Trim()).Replace("&#39;", "'").Replace("&#x27;", "'").Replace("\r\n", "<br>").Replace("\n", "<br>")}</p>"));
    }

    // ── Post-generation hook ──

    private async Task PostGenerationHook()
    {
        // Entity linking happens automatically via the 2s input debounce in JS
        if (showSceneSidebar) RefreshOutline();
        _ = RunExtractionAsync();

        // Closed-loop story intelligence: update state, log events, sync knowledge
        var pid = project.Id;
        var beatIdx = StoryState.GetState(pid).BeatCount;
        try
        {
            // Extract what changed in the narrative (character positions, injuries, emotions)
            await StoryState.UpdateFromTextAsync(pid, writeResult ?? storyText, storyText);

            // Record structured events (who did what, where)
            await EventLog.ExtractAndLogAsync(pid, writeResult ?? storyText, beatIdx);

            // Sync knowledge map (who learned what, dramatic irony tracking)
            var state = StoryState.GetState(pid);
            var recentEvents = EventLog.GetEvents(pid);
            KnowledgeMap.SyncFromState(pid, state, recentEvents, beatIdx);
        }
        catch { /* Story intelligence is best-effort — never break generation */ }
    }

