@page "/voice"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@using Microsoft.AspNetCore.Authorization
@using StreetSamurai.Core.Data.Entities
@using StreetSamurai.Core.Services
@inject VoiceHarvestService Harvest
@inject IJSRuntime JS

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <div class="small text-muted mb-1">
            <a href="/" class="text-muted text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Home</a>
        </div>
        <h4 class="text-info mb-0"><i class="bi bi-broadcast me-2"></i>Voice Harvest Log</h4>
        <p class="small text-muted mb-0">
            Proposed voice-rule changes from harvest, directives, and manual edits.
            Approve to fold a rule into the live writing voice; reject to decline it.
            Only <strong>proposed</strong> entries can be approved or rejected.
        </p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <button class="btn btn-sm btn-outline-info" @onclick="LoadAsync">
            <i class="bi bi-arrow-clockwise me-1"></i>Refresh
        </button>
    </div>
</div>

@* Stats strip *@
<div class="row g-2 mb-3">
    <div class="col-md-3"><div class="vcl-stat"><div class="lbl">Proposed</div><div class="val text-warning">@proposed.Count</div></div></div>
    <div class="col-md-3"><div class="vcl-stat"><div class="lbl">Applied</div><div class="val text-success">@applied.Count</div></div></div>
    <div class="col-md-3"><div class="vcl-stat"><div class="lbl">Rejected</div><div class="val text-muted">@rejected.Count</div></div></div>
    <div class="col-md-3"><div class="vcl-stat"><div class="lbl">Observed</div><div class="val text-info">@observed.Count</div></div></div>
</div>

@if (!string.IsNullOrEmpty(statusMsg))
{
    <div class="alert alert-@statusCss small py-2 mb-3">@statusMsg</div>
}

@* Tab bar *@
<div class="mb-3 d-flex gap-1 flex-wrap">
    <button class="btn btn-sm @(tab == "proposed" ? "btn-warning text-dark" : "btn-outline-secondary")" @onclick='() => tab = "proposed"'>
        Proposed (@proposed.Count)
    </button>
    <button class="btn btn-sm @(tab == "applied" ? "btn-success" : "btn-outline-secondary")" @onclick='() => tab = "applied"'>
        Applied (@applied.Count)
    </button>
    <button class="btn btn-sm @(tab == "rejected" ? "btn-secondary" : "btn-outline-secondary")" @onclick='() => tab = "rejected"'>
        Rejected (@rejected.Count)
    </button>
    <button class="btn btn-sm @(tab == "observed" ? "btn-info" : "btn-outline-secondary")" @onclick='() => tab = "observed"'>
        Observed (@observed.Count)
    </button>
</div>

@{
    var visible = tab switch
    {
        "applied"  => applied,
        "rejected" => rejected,
        "observed" => observed,
        _          => proposed,
    };
}

@if (!loaded)
{
    <div class="text-muted small"><span class="spinner-border spinner-border-sm me-1"></span>Loading…</div>
}
else if (visible.Count == 0)
{
    <div class="alert alert-secondary small py-2">No @tab entries.</div>
}
else
{
    @foreach (var entry in visible)
    {
        <div class="card bg-dark text-light border-secondary mb-2">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
                    <div class="d-flex gap-2 flex-wrap align-items-center">
                        <span class="badge @SourceBadge(entry.Source)">@entry.Source</span>
                        <span class="badge bg-secondary" title="Rule target — which voice store this informs">@entry.RuleTarget</span>
                        <span class="small text-muted">@entry.CreatedAt.ToLocalTime().ToString("MMM d, HH:mm")</span>
                    </div>
                    @if (tab == "proposed")
                    {
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-success" disabled="@(working == entry.Id)"
                                    @onclick="() => ApproveAsync(entry)">
                                @if (working == entry.Id) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                else { <i class="bi bi-check2 me-1"></i> }
                                Approve
                            </button>
                            <button class="btn btn-sm btn-outline-danger" disabled="@(working == entry.Id)"
                                    @onclick="() => RejectAsync(entry)">
                                <i class="bi bi-x me-1"></i>Reject
                            </button>
                        </div>
                    }
                </div>
                <div class="fw-semibold mb-1">@entry.Description</div>
                @if (!string.IsNullOrWhiteSpace(entry.Evidence))
                {
                    <div class="small text-muted fst-italic">Evidence: @entry.Evidence</div>
                }
                @if (!string.IsNullOrWhiteSpace(entry.Before) || !string.IsNullOrWhiteSpace(entry.After))
                {
                    <div class="row g-2 mt-2">
                        @if (!string.IsNullOrWhiteSpace(entry.Before))
                        {
                            <div class="col-md-6">
                                <div class="small text-muted mb-1">Before</div>
                                <div class="border border-danger rounded p-2 small fst-italic">"@entry.Before"</div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(entry.After))
                        {
                            <div class="col-md-6">
                                <div class="small text-muted mb-1">After</div>
                                <div class="border border-success rounded p-2 small fst-italic">"@entry.After"</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
}

<style>
    .vcl-stat { background:#1c2128; border-radius:4px; padding:8px 12px; text-align:center; }
    .vcl-stat .lbl { font-size:.7rem; text-transform:uppercase; color:var(--bs-secondary); }
    .vcl-stat .val { font-size:1.4rem; font-weight:600; }
</style>

@code {
    private bool loaded;
    private string tab = "proposed";
    private List<VoiceChangeLogEntry> proposed  = new();
    private List<VoiceChangeLogEntry> applied   = new();
    private List<VoiceChangeLogEntry> rejected  = new();
    private List<VoiceChangeLogEntry> observed  = new();
    private Guid? working;
    private string statusMsg = "";
    private string statusCss = "info";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loaded = false;
        statusMsg = "";
        StateHasChanged();
        try
        {
            proposed = await Harvest.GetByStatusAsync("proposed");
            applied  = await Harvest.GetByStatusAsync("applied");
            rejected = await Harvest.GetByStatusAsync("rejected");
            observed = await Harvest.GetByStatusAsync("observed");
        }
        catch (Exception ex)
        {
            statusMsg = "Load failed: " + ex.Message;
            statusCss = "danger";
        }
        finally { loaded = true; }
    }

    private async Task ApproveAsync(VoiceChangeLogEntry entry)
    {
        working = entry.Id;
        statusMsg = "";
        StateHasChanged();
        try
        {
            var ok = await Harvest.ApplyAsync(entry.Id);
            if (ok)
            {
                statusMsg = $"Applied: {Clip(entry.Description)}";
                statusCss = "success";
            }
            else
            {
                statusMsg = "Apply returned false — check logs.";
                statusCss = "warning";
            }
            await LoadAsync();
        }
        catch (Exception ex) { statusMsg = ex.Message; statusCss = "danger"; }
        finally { working = null; }
    }

    private async Task RejectAsync(VoiceChangeLogEntry entry)
    {
        working = entry.Id;
        statusMsg = "";
        StateHasChanged();
        try
        {
            await Harvest.RejectAsync(entry.Id);
            statusMsg = $"Rejected: {Clip(entry.Description)}";
            statusCss = "secondary";
            await LoadAsync();
        }
        catch (Exception ex) { statusMsg = ex.Message; statusCss = "danger"; }
        finally { working = null; }
    }

    private static string SourceBadge(string src) => src switch
    {
        "harvest"     => "bg-success",
        "directive"   => "bg-info text-dark",
        "manual_edit" => "bg-primary",
        _             => "bg-secondary",
    };

    private static string Clip(string s, int max = 80) =>
        s.Length <= max ? s : s[..max] + "…";
}
