@page "/equipment"
@inject EquipmentRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject WorldGraphService Graph

<div class="dict-layout">
    <div class="dict-list bg-dark border-end border-secondary">
        @foreach (var e in items)
        {
            <div class="list-item text-light @(editing?.Name == e.Name ? "active" : "")" @onclick="() => Edit(e)">
                <div class="fw-bold small">@(string.IsNullOrEmpty(e.ProductName) ? e.Name : e.ProductName)</div>
                <div class="text-muted" style="font-size: 0.7rem;">@e.BrandName @(string.IsNullOrEmpty(e.Category) ? "" : $"· {e.Category}")</div>
            </div>
        }
        <div class="p-2">
            <ExportButton Mode="repo" RepoName="Equipment" GetRepoEntries="GetExportEntries" />
            <button class="btn btn-sm btn-outline-danger w-100" @onclick="AddNew"><i class="bi bi-plus-lg"></i> New Equipment</button>
        </div>
    </div>

    <div class="dict-editor">
        @if (editing != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-danger mb-0">@(isNew ? "New Equipment" : editing.Name)</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i> Save</button>
                    @if (!isNew) { <ExportButton Mode="entry" RepoName="Equipment" EntryName="@editing.Name" EntryJson="@System.Text.Json.JsonSerializer.Serialize(editing)" /> }
                    @if (!isNew && !_confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-trash3"></i></button> }
                    @if (_confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete">Confirm</button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false">No</button> }
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-3"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Name" /></div>
                <div class="col-3"><div class="field-label">Category</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Category" /></div>
                <div class="col-3"><div class="field-label">Manufacturer</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Manufacturer" /></div>
                <div class="col-3"><div class="field-label">Tier Availability</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.TierAvailability" /></div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-4"><div class="field-label">Legality</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Legality" /></div>
                <div class="col-8"><div class="field-label">Base Technologies (comma-sep)</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_baseTechInput" /></div>
            </div>

            <div class="mb-3"><div class="field-label">Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.Description"></textarea></div>
            <div class="mb-3"><div class="field-label">Tactical Use</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.TacticalUse"></textarea></div>
            <div class="mb-3"><div class="field-label">Cultural Context</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.CulturalContext"></textarea></div>
        }
        else { <div class="text-muted d-flex align-items-center justify-content-center h-100">Select equipment or create new</div> }
    </div>
</div>

@code {
    private List<EquipmentData> items = [];
    private EquipmentData? editing;
    private bool isNew, _confirmDelete;
    private string originalName = "", _baseTechInput = "";
    protected override void OnInitialized() { Repo.Reload(); items = Repo.GetAll(); if (Nav.Uri.Contains("new=true")) AddNew(); }
    private void AddNew() { editing = new EquipmentData(); isNew = true; _confirmDelete = false; _baseTechInput = ""; }
    private void Edit(EquipmentData e) { editing = e; originalName = e.Name; isNew = false; _confirmDelete = false; _baseTechInput = string.Join(", ", e.BaseTechnologies); }
    private void SaveEdit()
    {
        if (editing == null || string.IsNullOrWhiteSpace(editing.Name)) return;
        editing.BaseTechnologies = _baseTechInput.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        if (!isNew && originalName != editing.Name) Repo.Delete(originalName);
        Repo.Save(editing); editing = null; items = Repo.GetAll();
    }
    private void DoDelete() { if (editing == null) return; Graph.RemoveNode(editing.Name); Repo.Delete(editing.Name); editing = null; _confirmDelete = false; items = Repo.GetAll(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { await JS.InvokeVoidAsync("writeInterop.autoResizeAll"); }
    private List<(string name, string json)> GetExportEntries() => items.Select(e => (e.Name, System.Text.Json.JsonSerializer.Serialize(e))).ToList();
}
