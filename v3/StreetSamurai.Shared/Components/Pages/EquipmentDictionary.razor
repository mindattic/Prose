@page "/equipment"
@inject EquipmentRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="dict-layout">
    <div class="dict-list bg-dark border-end border-secondary">
        @foreach (var e in _items)
        {
            <div class="list-item text-light @(_editing?.Name == e.Name ? "active" : "")" @onclick="() => Edit(e)">
                <div class="fw-bold small">@e.Name</div>
                <div class="text-muted" style="font-size: 0.7rem;">@e.Category</div>
            </div>
        }
    </div>

    <div class="dict-editor">
        @if (_editing != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-danger mb-0">@(_isNew ? "New Equipment" : _editing.Name)</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i> Save</button>
                    @if (!_isNew && !_confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-trash3"></i></button> }
                    @if (_confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete">Confirm</button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false">No</button> }
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-3"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Name" /></div>
                <div class="col-3"><div class="field-label">Category</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Category" /></div>
                <div class="col-3"><div class="field-label">Manufacturer</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Manufacturer" /></div>
                <div class="col-3"><div class="field-label">Tier Availability</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.TierAvailability" /></div>
            </div>
            <div class="row g-3 mb-3">
                <div class="col-4"><div class="field-label">Legality</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Legality" /></div>
                <div class="col-8"><div class="field-label">Base Technologies (comma-sep)</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_baseTechInput" /></div>
            </div>

            <div class="mb-3"><div class="field-label">Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.Description"></textarea></div>
            <div class="mb-3"><div class="field-label">Tactical Use</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.TacticalUse"></textarea></div>
            <div class="mb-3"><div class="field-label">Cultural Context</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.CulturalContext"></textarea></div>
        }
        else { <div class="text-muted d-flex align-items-center justify-content-center h-100">Select equipment or create new</div> }
    </div>
</div>

@code {
    private List<EquipmentData> _items = [];
    private EquipmentData? _editing;
    private bool _isNew, _confirmDelete;
    private string _originalName = "", _baseTechInput = "";
    protected override void OnInitialized() { Repo.Reload(); _items = Repo.GetAll(); if (Nav.Uri.Contains("new=true")) AddNew(); }
    private void AddNew() { _editing = new EquipmentData(); _isNew = true; _confirmDelete = false; _baseTechInput = ""; }
    private void Edit(EquipmentData e) { _editing = e; _originalName = e.Name; _isNew = false; _confirmDelete = false; _baseTechInput = string.Join(", ", e.BaseTechnologies); }
    private void SaveEdit()
    {
        if (_editing == null || string.IsNullOrWhiteSpace(_editing.Name)) return;
        _editing.BaseTechnologies = _baseTechInput.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        if (!_isNew && _originalName != _editing.Name) Repo.Delete(_originalName);
        Repo.Save(_editing); _editing = null; _items = Repo.GetAll();
    }
    private void DoDelete() { if (_editing == null) return; Repo.Delete(_editing.Name); _editing = null; _confirmDelete = false; _items = Repo.GetAll(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { await JS.InvokeVoidAsync("writeInterop.autoResizeAll"); }
}
