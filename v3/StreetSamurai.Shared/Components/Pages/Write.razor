@page "/write"
@page "/write/{BookId}"
@page "/write/{BookId}/{ChapterId}"
@attribute [Authorize(Roles = "Contributor,Administrator")]
@implements IAsyncDisposable
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@using StreetSamurai.Core.Services
@using Microsoft.AspNetCore.Components.Routing
@inject IBookRepository Books
@inject IChapterRepository Chapters
@inject MarkdownService Md
@inject FindingsService Findings
@inject BeatGeneratorService BeatGen
@inject DatabaseService CanonDb
@inject DialogueService Dialogue
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="write-shell @(focusModeClass) @(showFindings && chapter != null ? "with-findings" : "")">
    @if (book == null)
    {
        <div class="p-3">
            <div class="text-muted small mb-2">Pick a book to start writing.</div>
            <div class="d-flex flex-column gap-1">
                @foreach (var b in allBooks)
                {
                    <a href="@($"/write/{b.Id}")" class="text-decoration-none text-light">@b.Title</a>
                }
            </div>
        </div>
    }
    else
    {
        <aside class="write-side">
            <div class="write-side-head">
                <a href="@($"/books/{book.Id}/chapters")" class="text-muted small text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>@book.Title
                </a>
                <div class="write-side-tabs">
                    <button class="@($"write-side-tab{(sideTab == "chapters" ? " active" : "")}")"
                            @onclick='() => sideTab = "chapters"'>Chapters</button>
                    <button class="@($"write-side-tab{(sideTab == "beats" ? " active" : "")}")"
                            @onclick='() => sideTab = "beats"'
                            disabled="@(chapter == null)">Beats</button>
                    <button class="@($"write-side-tab{(sideTab == "outline" ? " active" : "")}")"
                            @onclick='() => sideTab = "outline"'
                            disabled="@(chapter == null)">Outline</button>
                </div>
            </div>
            <div class="write-side-list">
                @if (sideTab == "chapters")
                {
                    @foreach (var c in bookChapters)
                    {
                        var active = chapter != null && c.Id == chapter.Id;
                        <a href="@($"/write/{book.Id}/{c.Id}")"
                           class="@($"write-side-item{(active ? " active" : "")}")">
                            <span class="write-side-num">Ch @(c.Number?.ToString() ?? "?")</span>
                            <span class="write-side-title">@c.Title</span>
                        </a>
                    }
                    @if (bookChapters.Count == 0)
                    {
                        <div class="text-muted small px-2 py-3">No chapters yet.</div>
                    }
                }
                else if (sideTab == "beats" && chapter != null)
                {
                    @if (chapter.Beats.Count == 0)
                    {
                        <div class="text-muted small px-2 py-3">
                            No beats yet. Add a beat blurb below — when you click <strong>Update</strong>,
                            it expands the blurb into prose and appends it to the chapter.
                        </div>
                    }
                    @foreach (var b in chapter.Beats.OrderBy(b => b.Index))
                    {
                        var done = !string.IsNullOrWhiteSpace(b.Text);
                        var ready = !done && !string.IsNullOrWhiteSpace(b.Synopsis);
                        <div class="@($"write-beat{(done ? " done" : ready ? " ready" : "")}")">
                            <div class="write-beat-head">
                                <input class="write-beat-title" placeholder="Beat title…"
                                       @bind="b.Title" @bind:event="oninput" @bind:after="MarkPageDirty" />
                                @if (done)
                                {
                                    <span class="write-beat-status text-success" title="Prose written">●</span>
                                }
                                else if (ready)
                                {
                                    <span class="write-beat-status text-warning" title="Ready for Update">○</span>
                                }
                                else
                                {
                                    <span class="write-beat-status text-muted" title="Empty">·</span>
                                }
                            </div>
                            <textarea class="write-beat-blurb"
                                      placeholder="Kyle walks into the bar and asks the bartender for a seltzer with a lime."
                                      rows="2"
                                      @bind="b.Synopsis" @bind:event="oninput" @bind:after="MarkPageDirty"></textarea>
                            <div class="write-beat-actions">
                                <button class="btn btn-sm btn-outline-info py-0"
                                        title="Expand the blurb into prose and append it to the chapter"
                                        disabled="@(string.IsNullOrWhiteSpace(b.Synopsis) || beatExpanding == b.Id)"
                                        @onclick="() => ExpandBeat(b)">
                                    @if (beatExpanding == b.Id)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" />
                                        <span>Updating…</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-stars me-1" />
                                        <span>Update</span>
                                    }
                                </button>
                                <button class="btn btn-sm btn-link text-muted py-0" title="Remove this beat"
                                        @onclick="() => RemoveBeat(b)">
                                    <i class="bi bi-x-lg" />
                                </button>
                            </div>
                        </div>
                    }
                    @* Candidate next-beat blurbs from Legion's panel — pick one, write your own, or generate more. *@
                    @if (beatSuggestions.Count > 0)
                    {
                        <div class="write-beat-suggestions">
                            <div class="text-muted small mb-1">
                                <i class="bi bi-stars me-1" />Pick a next beat — or "Write my own" / "More".
                            </div>
                            @foreach (var s in beatSuggestions)
                            {
                                <button class="write-beat-suggestion" @onclick="() => CommitSuggestion(s)">
                                    @s
                                </button>
                            }
                        </div>
                    }
                    <div class="d-flex gap-1 mt-2 flex-wrap">
                        <button class="btn btn-sm btn-outline-info"
                                disabled="@suggestingBeats" @onclick="SuggestBeats">
                            @if (suggestingBeats)
                            {
                                <span class="spinner-border spinner-border-sm me-1" />
                                <span>Suggesting…</span>
                            }
                            else
                            {
                                <i class="bi bi-stars me-1" />
                                <span>@(beatSuggestions.Count == 0 ? "Suggest beats" : "More")</span>
                            }
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="AddBeat">
                            <i class="bi bi-pencil me-1" />Write my own
                        </button>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(beatStatus))
                    {
                        <div class="text-muted small mt-2">@beatStatus</div>
                    }
                }
                else if (sideTab == "outline")
                {
                    @if (Outline.Count == 0)
                    {
                        <div class="text-muted small px-2 py-3">No headings yet. Add <code>## </code> lines to outline this chapter.</div>
                    }
                    @foreach (var o in Outline)
                    {
                        <button class="write-outline-item" @onclick="() => JumpTo(o.Line)"
                                style="@($"padding-left:{4 + (o.Level - 1) * 12}px")">
                            <span class="write-outline-marker">@(new string('#', o.Level))</span>
                            <span class="write-outline-title">@o.Title</span>
                        </button>
                    }
                }
            </div>
        </aside>

        <main class="write-main">
            @if (chapter == null)
            {
                <div class="text-muted small p-3">Pick a chapter from the left to start writing.</div>
            }
            else
            {
                @if (recoveryAvailable)
                {
                    <div class="write-recovery">
                        <i class="bi bi-life-preserver me-1 text-warning"></i>
                        Found a newer local copy from @RecoveryAgo. Restore it?
                        <button class="btn btn-sm btn-warning ms-2" @onclick="RestoreLocal">Restore</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="DismissRecovery">Discard</button>
                    </div>
                }

                <div class="write-bar">
                    <input class="form-control form-control-sm bg-dark text-light border-secondary write-title"
                           placeholder="Chapter title"
                           @bind="pageTitle" @bind:event="oninput"
                           @bind:after="MarkPageDirty"
                           disabled="@readingMode" />
                    <span class="write-counts text-muted small">@WordCount words</span>
                    <span class="write-saved text-muted small">@SavedLabel</span>
                    <button class="btn btn-sm @(readingMode ? "btn-info" : "btn-outline-secondary")"
                            title="Reading mode" @onclick="ToggleReadingMode">
                        <i class="bi bi-book"></i>
                    </button>
                    <button class="btn btn-sm @(findOpen ? "btn-info" : "btn-outline-secondary")"
                            title="Find / replace" @onclick="ToggleFind"
                            disabled="@readingMode">
                        <i class="bi bi-search"></i>
                    </button>
                    <button class="btn btn-sm @(showFindings ? "btn-warning" : "btn-outline-secondary")"
                            title="Findings for this chapter" @onclick="ToggleFindings">
                        <i class="bi bi-clipboard-check"></i>
                        @if (findings.Count > 0)
                        {
                            <span class="badge bg-dark ms-1">@findings.Count</span>
                        }
                    </button>
                    <button class="btn btn-sm btn-outline-info" @onclick="SaveChapter"
                            disabled="@(!pageDirty || saving)">
                        <i class="bi bi-floppy"></i> Save
                    </button>
                </div>

                @if (!readingMode)
                {
                    <div class="write-toolbar" role="toolbar">
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Bold (Ctrl+B)"
                                @onclick='() => Wrap("**","**")'><b>B</b></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Italic (Ctrl+I)"
                                @onclick='() => Wrap("*","*")'><i>I</i></button>
                        <span class="write-toolbar-sep"></span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Heading"
                                @onclick='() => Prefix("## ")'>H</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Quote"
                                @onclick='() => Prefix("> ")'><i class="bi bi-quote"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Bulleted list"
                                @onclick='() => Prefix("- ")'><i class="bi bi-list-ul"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Numbered list"
                                @onclick='() => Prefix("1. ")'><i class="bi bi-list-ol"></i></button>
                    </div>

                    @if (findOpen)
                    {
                        <div class="write-find">
                            <input class="form-control form-control-sm bg-dark text-light border-secondary"
                                   placeholder="Find" @bind="findQuery" @bind:event="oninput" />
                            <input class="form-control form-control-sm bg-dark text-light border-secondary"
                                   placeholder="Replace with" @bind="replaceQuery" @bind:event="oninput" />
                            <label class="small text-muted d-flex align-items-center gap-1">
                                <input type="checkbox" @bind="findCaseSensitive" /> Aa
                            </label>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="FindNext"
                                    disabled="@string.IsNullOrEmpty(findQuery)">Next</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ReplaceNext"
                                    disabled="@string.IsNullOrEmpty(findQuery)">Replace</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ReplaceAll"
                                    disabled="@string.IsNullOrEmpty(findQuery)">All</button>
                            <span class="small text-muted">@findStatus</span>
                        </div>
                    }

                    <textarea id="write-surface"
                              class="form-control bg-dark text-light border-secondary write-surface"
                              placeholder="Write."
                              @bind="pageMarkdown" @bind:event="oninput"
                              @bind:after="MarkPageDirty"
                              @onkeydown="OnKey"
                              spellcheck="true"></textarea>
                }
                else
                {
                    <article class="write-reading">
                        @((MarkupString)Markdig.Markdown.ToHtml(pageMarkdown ?? ""))
                    </article>
                }
            }
        </main>

        @if (showFindings && chapter != null)
        {
            <aside class="write-findings-side">
                <div class="write-findings-head">
                    <span class="text-info small">
                        <i class="bi bi-clipboard-check me-1"></i>Findings
                    </span>
                    <button class="btn-close btn-close-white btn-sm" @onclick="ToggleFindings"></button>
                </div>
                <div class="write-findings-list">
                    @if (findings.Count == 0)
                    {
                        <div class="text-muted small px-2 py-3">
                            No findings for this chapter yet. Reviews and the contradiction sweep
                            attach findings here as they run.
                        </div>
                    }
                    @foreach (var f in findings)
                    {
                        <div class="@($"write-finding sev-{f.Severity.ToString().ToLowerInvariant()}")">
                            <div class="write-finding-head">
                                <span class="write-finding-cat">@f.Category</span>
                                <span class="write-finding-sev">@f.Severity</span>
                            </div>
                            <div class="write-finding-summary">@f.Summary</div>
                            @if (!string.IsNullOrWhiteSpace(f.Snippet))
                            {
                                <div class="write-finding-snippet">@f.Snippet</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(f.SuggestedFix))
                            {
                                <div class="write-finding-fix"><i class="bi bi-arrow-right me-1"></i>@f.SuggestedFix</div>
                            }
                        </div>
                    }
                </div>
            </aside>
        }
    }
</div>

<style>
  .write-shell { display:grid; grid-template-columns: 240px 1fr; height: calc(100vh - 56px); min-height:0; }
  .write-shell.with-findings { grid-template-columns: 240px 1fr 300px; }
  .write-side { border-right:1px solid #444; display:flex; flex-direction:column; min-height:0; }
  .write-side-head { padding:8px 10px; border-bottom:1px solid #2a2a32; display:flex; flex-direction:column; gap:6px; }
  .write-side-tabs { display:flex; gap:4px; }
  .write-side-tab { flex:1; background:transparent; border:1px solid #333; color:#aaa; padding:3px 0; font-size:.78rem; border-radius:3px; }
  .write-side-tab.active { background:#1c2a3a; color:#fff; border-color:#3a5a7a; }
  .write-side-tab:disabled { opacity:.45; cursor:not-allowed; }

  .write-side-list { flex:1; overflow-y:auto; padding:6px; display:flex; flex-direction:column; gap:2px; }
  .write-side-item { display:flex; gap:8px; padding:6px 8px; border-radius:4px; color:#bbb; text-decoration:none; }
  .write-side-item:hover { background:#1f2229; color:#fff; }
  .write-side-item.active { background:#1c2a3a; color:#fff; }
  .write-side-num { font-family:monospace; font-size:.75rem; color:#88a; min-width:46px; }
  .write-side-title { flex:1; font-size:.9rem; }

  .write-outline-item { display:flex; gap:6px; align-items:baseline; background:transparent; border:0;
                        text-align:left; color:#bbb; padding:4px 6px; border-radius:3px; font-size:.85rem; width:100%; }
  .write-outline-item:hover { background:#1f2229; color:#fff; }
  .write-outline-marker { color:#5b8; font-family:monospace; font-size:.7rem; }
  .write-outline-title { flex:1; }

  /* Beat blurbs — sequential authoring strip in the left aside.
     Status: dot color + left-border accent. Done = green, Ready (blurb but no
     prose) = amber, Empty = muted. The amber "ready" stripe is the user's
     visual hint for "this is the next beat to expand." */
  .write-beat { background:#16181d; border:1px solid #2a2a32; border-left:3px solid #444;
                padding:6px 8px; margin-bottom:6px; border-radius:3px; }
  .write-beat.ready { border-left-color:#ffc107; }
  .write-beat.done  { border-left-color:#2ecc71; opacity:0.85; }
  .write-beat-head  { display:flex; align-items:center; gap:6px; margin-bottom:4px; }
  .write-beat-title { flex:1; background:transparent; border:0; color:#ddd; font-size:.85rem;
                      font-weight:600; padding:2px 0; outline:none; }
  .write-beat-title::placeholder { color:#666; font-weight:400; }
  .write-beat-status { font-family:monospace; font-size:.9rem; }
  .write-beat-blurb { width:100%; background:#0e1014; color:#cfd; border:1px solid #2a2a32;
                      border-radius:3px; padding:4px 6px; font-size:.8rem; resize:vertical;
                      font-family:Georgia,serif; }
  .write-beat-actions { display:flex; gap:4px; align-items:center; margin-top:4px; }
  /* Legion-suggested next-beat candidates — clickable cards that commit on pick. */
  .write-beat-suggestions { margin-top:6px; display:flex; flex-direction:column; gap:4px; }
  .write-beat-suggestion {
      background:#0e1014; color:#cfd; border:1px solid #2a3a4a; border-left:3px solid #5be;
      border-radius:3px; padding:6px 8px; font-size:.8rem; text-align:left;
      font-family:Georgia,serif; line-height:1.4; cursor:pointer; transition:background 0.12s ease;
  }
  .write-beat-suggestion:hover { background:#162028; border-left-color:#9df; }

  .write-main { display:flex; flex-direction:column; min-height:0; padding:10px; }
  .write-bar { display:flex; gap:8px; align-items:center; margin-bottom:6px; }
  .write-title { flex:1; }
  .write-counts, .write-saved { white-space:nowrap; }
  .write-saved { font-variant-numeric:tabular-nums; min-width:84px; text-align:right; }

  .write-toolbar { display:flex; gap:4px; align-items:center; padding:4px 0; border-bottom:1px solid #333; margin-bottom:8px; }
  .write-toolbar .btn { min-width:34px; }
  .write-toolbar-sep { width:1px; height:18px; background:#333; margin:0 4px; }

  .write-find { display:flex; gap:6px; align-items:center; padding:6px 0; flex-wrap:wrap; }
  .write-find input.form-control { max-width: 220px; }

  .write-surface { flex:1; resize:none; font-family: Georgia, serif; line-height:1.6; font-size:1rem; min-height:0; }

  .write-reading { flex:1; overflow-y:auto; padding: 0 8% 6rem; max-width:none;
                   font-family: Georgia, serif; line-height:1.7; font-size:1.05rem; color:#e6e6e6; }
  .write-reading h1, .write-reading h2, .write-reading h3 { color:#fff; margin-top:1.6rem; }
  .write-reading p { margin: 0 0 1rem; }
  .write-reading blockquote { border-left:3px solid #444; padding-left:1rem; color:#bbb; margin: 1rem 0; }

  .write-recovery { background:#3a2e0a; border:1px solid #6a5b1d; color:#f5d97a; padding:6px 10px; border-radius:4px; margin-bottom:8px; font-size:.9rem; }

  .write-findings-side { border-left:1px solid #444; display:flex; flex-direction:column; min-height:0; }
  .write-findings-head { display:flex; justify-content:space-between; align-items:center; padding:8px 10px; border-bottom:1px solid #2a2a32; }
  .write-findings-list { flex:1; overflow-y:auto; padding:8px; display:flex; flex-direction:column; gap:8px; }
  .write-finding { background:#1a1a1a; border:1px solid #333; border-left-width:3px; padding:8px 10px; font-size:.85rem; }
  .write-finding.sev-high   { border-left-color:#c33; }
  .write-finding.sev-medium { border-left-color:#c93; }
  .write-finding.sev-low    { border-left-color:#48a; }
  .write-finding-head { display:flex; justify-content:space-between; gap:8px; font-size:.7rem; text-transform:uppercase; letter-spacing:0.05em; color:#888; margin-bottom:4px; }
  .write-finding-cat { color:#5be; }
  .write-finding-summary { color:#ddd; line-height:1.4; }
  .write-finding-snippet { color:#999; font-style:italic; margin-top:4px; padding-left:8px; border-left:2px solid #333; font-size:.8rem; }
  .write-finding-fix { color:#7c7; margin-top:6px; font-size:.8rem; }

  @@media (max-width: 720px) {
    .write-shell { grid-template-columns: 1fr; height: auto; }
    .write-side { max-height: 220px; border-right:none; border-bottom:1px solid #444; }
    .write-surface { min-height: 60vh; }
  }
</style>

@code {
    [Parameter] public string? BookId { get; set; }
    [Parameter] public string? ChapterId { get; set; }

    private List<Book> allBooks = new();
    private List<Chapter> bookChapters = new();
    private Book? book;
    private Chapter? chapter;

    private string pageTitle = "";
    private string pageMarkdown = "";
    private bool pageDirty;

    // Autosave + saved-time indicator
    private DateTime lastEditAt = DateTime.MinValue;
    private DateTime? lastSavedAt;
    private bool saving;
    private System.Threading.Timer? autosaveTimer;
    private const int AutosaveIdleMs = 2000;

    // Navigation guard
    private IDisposable? locationGuard;

    // Sidebar tab + reading + find
    // sideTab: "chapters" | "beats" | "outline" — replaces the old showOutline bool
    // so the chapter editor can offer the beats workflow alongside the prior two views.
    private string sideTab = "chapters";
    private bool readingMode;
    private bool findOpen;
    private bool showFindings;
    private IReadOnlyList<Finding> findings = Array.Empty<Finding>();
    // Per-beat expand state
    private string? beatExpanding;
    private string beatStatus = "";
    // Legion-suggested next-beat blurbs awaiting selection. Cleared on chapter change
    // and when a candidate is committed; "More" appends additional suggestions.
    private List<string> beatSuggestions = new();
    private bool suggestingBeats;
    private string findQuery = "";
    private string replaceQuery = "";
    private bool findCaseSensitive;
    private int findCursor;
    private string? findStatus;

    // Crash recovery
    private bool recoveryAvailable;
    private string? recoveredText;
    private DateTime? recoveredTs;

    // JS hook lifecycle — re-install when chapter changes
    private string? jsBoundChapterId;

    private string focusModeClass => readingMode ? "write-shell-reading" : "";

    private int WordCount => string.IsNullOrWhiteSpace(pageMarkdown)
        ? 0
        : pageMarkdown.Split(new[] { ' ', '\t', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries).Length;

    private string SavedLabel
    {
        get
        {
            if (saving) return "Saving…";
            if (pageDirty) return "Unsaved";
            if (lastSavedAt is null) return "";
            var d = DateTime.UtcNow - lastSavedAt.Value;
            if (d.TotalSeconds < 5)  return "Saved just now";
            if (d.TotalSeconds < 60) return $"Saved {(int)d.TotalSeconds}s ago";
            if (d.TotalMinutes < 60) return $"Saved {(int)d.TotalMinutes}m ago";
            if (d.TotalHours   < 24) return $"Saved {(int)d.TotalHours}h ago";
            return "Saved earlier";
        }
    }

    private string RecoveryAgo
    {
        get
        {
            if (recoveredTs is null) return "";
            var d = DateTime.UtcNow - recoveredTs.Value;
            if (d.TotalSeconds < 60) return $"{(int)d.TotalSeconds}s ago";
            if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m ago";
            if (d.TotalHours   < 24) return $"{(int)d.TotalHours}h ago";
            return "earlier";
        }
    }

    private record OutlineItem(int Line, int Level, string Title);

    private List<OutlineItem> Outline
    {
        get
        {
            if (string.IsNullOrEmpty(pageMarkdown)) return new();
            var rx = new System.Text.RegularExpressions.Regex(@"^(#{1,6})\s+(.+)$");
            var lines = pageMarkdown.Split('\n');
            var list = new List<OutlineItem>();
            for (int i = 0; i < lines.Length; i++)
            {
                var m = rx.Match(lines[i]);
                if (m.Success) list.Add(new OutlineItem(i, m.Groups[1].Length, m.Groups[2].Value.Trim()));
            }
            return list;
        }
    }

    protected override void OnInitialized()
    {
        locationGuard = Nav.RegisterLocationChangingHandler(OnLocationChanging);
        autosaveTimer = new System.Threading.Timer(_ => InvokeAsync(AutosaveTick),
            null, TimeSpan.FromMilliseconds(1500), TimeSpan.FromMilliseconds(1500));
    }

    protected override void OnParametersSet()
    {
        allBooks = Books.ListBooks();

        if (!string.IsNullOrEmpty(BookId))
        {
            book = Books.LoadBook(BookId);
            bookChapters = book == null
                ? new()
                : book.ChapterIds
                    .Select(Chapters.LoadChapter)
                    .Where(c => c != null)
                    .Cast<Chapter>()
                    .OrderBy(c => c.Number ?? int.MaxValue)
                    .ToList();
        }
        else { book = null; bookChapters = new(); }

        if (!string.IsNullOrEmpty(ChapterId))
        {
            var prevId = chapter?.Id;
            chapter = Chapters.LoadChapter(ChapterId);
            if (chapter != null)
            {
                pageTitle = chapter.Title;
                pageMarkdown = string.IsNullOrWhiteSpace(chapter.Markdown)
                    ? HtmlToMarkdownFallback(chapter.Html)
                    : chapter.Markdown;
                pageDirty = false;
                lastSavedAt = chapter.Modified;
                if (prevId != chapter.Id)
                {
                    recoveryAvailable = false;
                    recoveredText = null;
                    recoveredTs = null;
                    findOpen = false;
                    findCursor = 0;
                    findStatus = null;
                    sideTab = "chapters";
                    beatStatus = "";
                    beatSuggestions.Clear();
                    readingMode = false;
                }
                LoadFindings();
            }
        }
        else
        {
            chapter = null; pageTitle = ""; pageMarkdown = ""; pageDirty = false;
            lastSavedAt = null; recoveryAvailable = false;
            findings = Array.Empty<Finding>();
        }
    }

    private void LoadFindings()
    {
        findings = chapter == null
            ? Array.Empty<Finding>()
            : Findings.ListByChapter(chapter.Id);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("writeInterop.writer.installBeforeUnload"); } catch { }
        }
        if (chapter != null && jsBoundChapterId != chapter.Id)
        {
            jsBoundChapterId = chapter.Id;
            try
            {
                await JS.InvokeVoidAsync("writeInterop.writer.installPaste", "write-surface");
                await JS.InvokeVoidAsync("writeInterop.writer.installLocalBackup", "write-surface", chapter.Id);

                // Crash-recovery probe: only show banner if local copy beats server modified.
                var local = await JS.InvokeAsync<LocalBackup?>("writeInterop.writer.localLoad", chapter.Id);
                if (local is { Text.Length: > 0 })
                {
                    var localTs = DateTime.TryParse(local.Ts, null,
                        System.Globalization.DateTimeStyles.RoundtripKind, out var ts)
                        ? ts.ToUniversalTime() : DateTime.MinValue;
                    if (localTs > chapter.Modified.AddSeconds(1) && local.Text != pageMarkdown)
                    {
                        recoveredText = local.Text;
                        recoveredTs = localTs;
                        recoveryAvailable = true;
                        StateHasChanged();
                    }
                    else
                    {
                        // Local is stale or matches — drop it.
                        await JS.InvokeVoidAsync("writeInterop.writer.localClear", chapter.Id);
                    }
                }
            }
            catch { /* JS not ready or interop disabled — fail open */ }
        }
    }

    private record LocalBackup(string Text, string Ts);

    private async ValueTask OnLocationChanging(LocationChangingContext ctx)
    {
        if (!pageDirty || saving) return;
        bool keep;
        try { keep = await JS.InvokeAsync<bool>("confirm", "You have unsaved changes. Leave anyway?"); }
        catch { keep = true; }
        if (!keep) ctx.PreventNavigation();
    }

    private void MarkPageDirty()
    {
        pageDirty = true;
        lastEditAt = DateTime.UtcNow;
        _ = SyncDirty(true);
    }

    private async Task SyncDirty(bool dirty)
    {
        try { await JS.InvokeVoidAsync("writeInterop.writer.setDirty", dirty); } catch { }
    }

    private async Task Wrap(string pre, string suf)
    {
        await JS.InvokeVoidAsync("writeInterop.richEditor.mdWrapSelection", "write-surface", pre, suf);
    }

    private async Task Prefix(string pre)
    {
        await JS.InvokeVoidAsync("writeInterop.richEditor.mdPrefixLine", "write-surface", pre);
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (!(e.CtrlKey || e.MetaKey)) return;
        var k = (e.Key ?? "").ToLowerInvariant();
        if      (k == "b") await Wrap("**", "**");
        else if (k == "i") await Wrap("*", "*");
    }

    private void ToggleReadingMode() { readingMode = !readingMode; if (readingMode) findOpen = false; }
    private void ToggleFind()        { findOpen = !findOpen; findStatus = null; }
    private void ToggleFindings()    { showFindings = !showFindings; if (showFindings) LoadFindings(); }

    // ── Beat workflow ──────────────────────────────────────────────────────
    // Each ChapterBeat holds a Synopsis (the user-authored blurb — "Kyle walks
    // into the bar and asks for a seltzer with a lime") and a Text (the prose
    // produced by Update). Beats with prose are "done"; beats with a blurb but
    // no prose are "ready" — the next-up beat is implicitly whichever ready
    // one comes first in Index order.

    private void AddBeat()
    {
        if (chapter == null) return;
        var nextIdx = chapter.Beats.Count == 0 ? 0 : chapter.Beats.Max(b => b.Index) + 1;
        chapter.Beats.Add(new ChapterBeat { Index = nextIdx, Title = "", Synopsis = "", Text = "" });
        MarkPageDirty();
    }

    /// <summary>
    /// Ask Legion's panel for distinct next-beat blurbs. Each call appends to
    /// the candidate list (so "More" extends rather than replaces). Scene-so-far
    /// is built from prior beats' Text where possible, otherwise the chapter
    /// markdown — same continuity source the expand step uses.
    /// </summary>
    private async Task SuggestBeats()
    {
        if (chapter == null || suggestingBeats) return;
        suggestingBeats = true;
        beatStatus = "Polling Legion's panel for diverse next beats…";
        StateHasChanged();
        try
        {
            var doneBeats = chapter.Beats.OrderBy(b => b.Index)
                                          .Where(b => !string.IsNullOrWhiteSpace(b.Text))
                                          .ToList();
            var sceneSoFar = doneBeats.Any()
                ? string.Join("\n\n", doneBeats.Select(b => b.Text))
                : (pageMarkdown ?? "");

            var pov = chapter.Beats.LastOrDefault(b => !string.IsNullOrWhiteSpace(b.Text))?.Title ?? "";
            var fresh = await BeatGen.SuggestNextBeatsAsync(
                sceneSoFar:    sceneSoFar,
                chapterTitle:  pageTitle,
                povCharacter:  pov,
                count:         5);
            // Dedupe against what's already on the list so "More" never repeats.
            foreach (var s in fresh)
                if (!beatSuggestions.Any(x => string.Equals(x, s, StringComparison.OrdinalIgnoreCase)))
                    beatSuggestions.Add(s);
            beatStatus = beatSuggestions.Count == 0
                ? "Legion returned no suggestions — check API keys and try again."
                : $"{beatSuggestions.Count} candidate beat(s). Click one to commit, or write your own.";
        }
        catch (Exception ex)
        {
            beatStatus = $"Error: {ex.Message}";
        }
        finally
        {
            suggestingBeats = false;
            StateHasChanged();
        }
    }

    /// <summary>Commit a Legion-proposed blurb as a new beat at the end of the list.</summary>
    private void CommitSuggestion(string blurb)
    {
        if (chapter == null) return;
        var nextIdx = chapter.Beats.Count == 0 ? 0 : chapter.Beats.Max(b => b.Index) + 1;
        chapter.Beats.Add(new ChapterBeat { Index = nextIdx, Title = "", Synopsis = blurb, Text = "" });
        beatSuggestions.Clear();
        beatStatus = "Beat committed. Refine the blurb or click Update to expand it into prose.";
        MarkPageDirty();
    }

    private void RemoveBeat(ChapterBeat b)
    {
        if (chapter == null) return;
        chapter.Beats.Remove(b);
        MarkPageDirty();
    }

    /// <summary>
    /// Expand the beat's Synopsis (blurb) into prose using BeatGeneratorService,
    /// store the result in beat.Text, and append it to the chapter markdown.
    /// SceneSoFar is the concatenation of prior beats' prose so the LLM picks up
    /// continuity (mood shifts, revelations the room has just absorbed, etc).
    /// </summary>
    private async Task ExpandBeat(ChapterBeat b)
    {
        if (chapter == null || string.IsNullOrWhiteSpace(b.Synopsis)) return;
        beatExpanding = b.Id;
        beatStatus    = $"Expanding beat \"{(string.IsNullOrWhiteSpace(b.Title) ? b.Synopsis : b.Title)}\"…";
        StateHasChanged();
        try
        {
            // Earlier beats' Text feeds SceneSoFar so the new prose flows from the prior
            // beat. Falls back to the page markdown when no prior beats exist.
            var priorBeats = chapter.Beats.OrderBy(x => x.Index).TakeWhile(x => x.Id != b.Id).ToList();
            var sceneSoFar = priorBeats.Any(p => !string.IsNullOrWhiteSpace(p.Text))
                ? string.Join("\n\n", priorBeats.Select(p => p.Text).Where(t => !string.IsNullOrWhiteSpace(t)))
                : (pageMarkdown ?? "");

            // Canon wire-up: literary rules so the writer leans on the world's voice
            // instead of generic cyberpunk; dialogue voice anchors so each named
            // character speaks in their documented register without the user having
            // to inline character notes into every blurb.
            var storyBible = "";
            try { storyBible = CanonDb.GetLiteraryRulesPrompt() ?? ""; } catch { }
            var dialogueCtx = "";
            try
            {
                if (chapter.Characters?.Any() == true)
                    dialogueCtx = Dialogue.BuildDialogueContext(chapter.Characters) ?? "";
            }
            catch { }

            var ctx = new BeatContext
            {
                StoryBibleContext   = storyBible,
                RelationshipContext = "",
                LocationContext     = "",
                DialogueContext     = dialogueCtx,
                SceneSoFar          = sceneSoFar,
                BeatGoal            = b.Synopsis,
            };
            var prose = await BeatGen.GenerateBeatAsync(ctx);
            if (string.IsNullOrWhiteSpace(prose))
            {
                beatStatus = "LLM returned empty prose — check API key and try again.";
                return;
            }
            b.Text = prose.Trim();

            // Append to the page markdown so the prose appears in the chapter immediately.
            // Blank-line separator preserves paragraph boundaries in the rendered output.
            var sep = string.IsNullOrWhiteSpace(pageMarkdown) ? "" : "\n\n";
            pageMarkdown = (pageMarkdown ?? "") + sep + b.Text;
            MarkPageDirty();
            beatStatus = $"Updated. Next: pick the next beat or add one.";
        }
        catch (Exception ex)
        {
            beatStatus = $"Error: {ex.Message}";
        }
        finally
        {
            beatExpanding = null;
            StateHasChanged();
        }
    }

    private async Task AutosaveTick()
    {
        if (chapter == null) return;
        // Always re-render so the "saved Xs ago" label ticks forward.
        if (!pageDirty || saving)
        {
            StateHasChanged();
            return;
        }
        if ((DateTime.UtcNow - lastEditAt).TotalMilliseconds < AutosaveIdleMs)
        {
            StateHasChanged();
            return;
        }
        await SaveChapter();
    }

    private async Task SaveChapter()
    {
        if (chapter == null || saving) return;
        saving = true;
        StateHasChanged();
        try
        {
            chapter.Title    = string.IsNullOrWhiteSpace(pageTitle) ? "Untitled" : pageTitle.Trim();
            chapter.Markdown = pageMarkdown ?? "";
            chapter.Html     = Md.RenderToHtml(chapter.Markdown);
            Chapters.SaveChapter(chapter);
            lastSavedAt = DateTime.UtcNow;
            pageDirty = false;
            try { await JS.InvokeVoidAsync("writeInterop.writer.localClear", chapter.Id); } catch { }
            await SyncDirty(false);
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }

    private void RestoreLocal()
    {
        if (recoveredText is null) return;
        pageMarkdown = recoveredText;
        pageDirty = true;
        lastEditAt = DateTime.UtcNow;
        recoveryAvailable = false;
        recoveredText = null;
        _ = SyncDirty(true);
    }

    private async Task DismissRecovery()
    {
        recoveryAvailable = false;
        recoveredText = null;
        if (chapter != null)
        {
            try { await JS.InvokeVoidAsync("writeInterop.writer.localClear", chapter.Id); } catch { }
        }
    }

    // ── Outline jump ──
    private async Task JumpTo(int line)
    {
        if (readingMode) readingMode = false;
        StateHasChanged();
        await JS.InvokeVoidAsync("writeInterop.writer.scrollToLine", "write-surface", line);
    }

    // ── Find / Replace ──
    private record FindResult(int Start, int End);

    private async Task FindNext()
    {
        if (string.IsNullOrEmpty(findQuery)) return;
        FindResult? r = null;
        try { r = await JS.InvokeAsync<FindResult?>("writeInterop.writer.find",
            "write-surface", findQuery, findCursor, findCaseSensitive); }
        catch { }
        if (r != null) { findCursor = r.End; findStatus = "Found"; }
        else            { findCursor = 0;     findStatus = "Not found"; }
    }

    private async Task ReplaceNext()
    {
        if (string.IsNullOrEmpty(findQuery)) return;
        bool replaced = false;
        try { replaced = await JS.InvokeAsync<bool>("writeInterop.writer.replaceCurrent",
            "write-surface", findQuery, replaceQuery ?? "", findCaseSensitive); }
        catch { }
        if (replaced) findStatus = "Replaced";
        await FindNext();
    }

    private async Task ReplaceAll()
    {
        if (string.IsNullOrEmpty(findQuery)) return;
        int n = 0;
        try { n = await JS.InvokeAsync<int>("writeInterop.writer.replaceAll",
            "write-surface", findQuery, replaceQuery ?? "", findCaseSensitive); }
        catch { }
        findStatus = n > 0 ? $"Replaced {n}" : "No matches";
    }

    public async ValueTask DisposeAsync()
    {
        locationGuard?.Dispose();
        if (autosaveTimer != null)
        {
            await autosaveTimer.DisposeAsync();
            autosaveTimer = null;
        }
        try { await JS.InvokeVoidAsync("writeInterop.writer.uninstallBeforeUnload"); } catch { }
        try { await JS.InvokeVoidAsync("writeInterop.writer.setDirty", false); } catch { }
    }

    /// <summary>
    /// Best-effort recovery of markdown from chapters saved by the previous editor,
    /// which wrapped each line in &lt;p&gt; tags. Anything richer (e.g. raw &lt;strong&gt;
    /// in legacy HTML) is left in place for the writer to clean up by hand.
    /// </summary>
    private static string HtmlToMarkdownFallback(string html)
    {
        if (string.IsNullOrEmpty(html)) return "";
        var t = System.Text.RegularExpressions.Regex.Replace(html, @"<p>\s*</p>", "");
        t = System.Text.RegularExpressions.Regex.Replace(t, @"<p>(.*?)</p>", "$1\n\n",
            System.Text.RegularExpressions.RegexOptions.Singleline);
        return System.Net.WebUtility.HtmlDecode(t).Trim();
    }
