@page "/write"
@page "/write/{BookId}"
@page "/write/{BookId}/{ChapterId}"
@attribute [Authorize(Roles = "Contributor,Administrator")]
@implements IAsyncDisposable
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@using StreetSamurai.Core.Services
@using StreetSamurai.Shared.Services
@using Microsoft.AspNetCore.Components.Routing
@inject IBookRepository Books
@inject IChapterRepository Chapters
@inject MarkdownService Md
@inject FindingsService Findings
@inject BeatGeneratorService BeatGen
@inject BookOutlineService OutlineSvc
@inject DatabaseService CanonDb
@inject DialogueService Dialogue
@inject CharacterRepository CharRepo
@inject ToastNotifier Toast
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="write-shell @(focusModeClass) @(showFindings && chapter != null ? "with-findings" : "")">
    @if (book == null)
    {
        <div class="p-3">
            <div class="text-muted small mb-2">Pick a book to start writing.</div>
            <div class="d-flex flex-column gap-1">
                @foreach (var b in allBooks)
                {
                    <a href="@($"/write/{b.Id}")" class="text-decoration-none text-light">@b.Title</a>
                }
            </div>
        </div>
    }
    else
    {
        <aside class="write-side">
            <div class="write-side-head">
                <a href="/books" class="text-muted small text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>@book.Title
                </a>
                <div class="write-side-tabs">
                    <button class="@($"write-side-tab{(sideTab == "chapters" ? " active" : "")}")"
                            @onclick='() => sideTab = "chapters"'>Chapters</button>
                    <button class="@($"write-side-tab{(sideTab == "beats" ? " active" : "")}")"
                            @onclick='() => sideTab = "beats"'
                            disabled="@(chapter == null)">Beats</button>
                    <button class="@($"write-side-tab{(sideTab == "outline" ? " active" : "")}")"
                            @onclick='() => sideTab = "outline"'
                            disabled="@(chapter == null)">Outline</button>
                </div>
            </div>
            <div class="write-side-list">
                @if (sideTab == "chapters")
                {
                    @foreach (var c in bookChapters)
                    {
                        var active = chapter != null && c.Id == chapter.Id;
                        // "Complete" = at least one beat AND every beat has prose. The
                        // green tick is a quiet finish-line signal in the sidebar.
                        var hasBeats = c.Beats != null && c.Beats.Count > 0;
                        var complete = hasBeats && c.Beats.All(b => !string.IsNullOrWhiteSpace(b.Text));
                        <a href="@($"/write/{book.Id}/{c.Id}")"
                           class="@($"write-side-item{(active ? " active" : "")}")">
                            <span class="write-side-num">Ch @(c.Number?.ToString() ?? "?")</span>
                            <span class="write-side-title">@c.Title</span>
                            @if (complete)
                            {
                                <span class="write-side-done text-success" title="Every beat has prose">✓</span>
                            }
                        </a>
                    }
                    @if (bookChapters.Count == 0)
                    {
                        <div class="text-muted small px-2 py-3">No chapters yet.</div>
                    }
                }
                else if (sideTab == "beats" && chapter != null)
                {
                    @if (chapter.Beats.Count == 0)
                    {
                        <div class="text-muted small px-2 py-3">
                            No beats yet. Add a beat blurb below — when you click <strong>Update</strong>,
                            it expands the blurb into prose and appends it to the chapter.
                        </div>
                    }
                    @foreach (var b in chapter.Beats.OrderBy(b => b.Index))
                    {
                        var done = !string.IsNullOrWhiteSpace(b.Text);
                        var ready = !done && !string.IsNullOrWhiteSpace(b.Synopsis);
                        <div class="@($"write-beat{(done ? " done" : ready ? " ready" : "")}{(draggingBeatId == b.Id ? " dragging" : "")}")"
                             draggable="true"
                             @ondragstart="() => OnBeatDragStart(b)"
                             @ondragover:preventDefault="true"
                             @ondragenter="() => OnBeatDragOver(b)"
                             @ondrop="() => OnBeatDrop(b)"
                             @ondragend="OnBeatDragEnd">
                            <div class="write-beat-head">
                                <span class="write-beat-grip" title="Drag to reorder">⋮⋮</span>
                                <input class="write-beat-title" placeholder="Beat title…"
                                       @bind="b.Title" @bind:event="oninput" @bind:after="MarkPageDirty" />
                                @if (done)
                                {
                                    <span class="write-beat-status text-success" title="Prose written">●</span>
                                }
                                else if (ready)
                                {
                                    <span class="write-beat-status text-warning" title="Ready for Update">○</span>
                                }
                                else
                                {
                                    <span class="write-beat-status text-muted" title="Empty">·</span>
                                }
                            </div>
                            <textarea class="write-beat-blurb"
                                      id="@($"beat-blurb-{b.Id}")"
                                      placeholder="Kyle walks into the bar and asks the bartender for a seltzer with a lime."
                                      rows="2"
                                      @bind="b.Synopsis" @bind:event="oninput" @bind:after="MarkPageDirty"
                                      @onblur="() => SaveBeatCursor(b.Id)"
                                      @onfocus="() => RestoreBeatCursor(b.Id)"></textarea>
                            <div class="write-beat-actions">
                                <button class="btn btn-sm btn-outline-info py-0"
                                        title="Expand the blurb into prose and append it to the chapter"
                                        disabled="@(string.IsNullOrWhiteSpace(b.Synopsis) || beatExpanding == b.Id)"
                                        @onclick="() => ExpandBeat(b)">
                                    @if (beatExpanding == b.Id)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" />
                                        <span>Updating…</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-stars me-1" />
                                        <span>Update</span>
                                    }
                                </button>
                                <button class="btn btn-sm btn-link text-muted py-0" title="Remove this beat"
                                        @onclick="() => RemoveBeat(b)">
                                    <i class="bi bi-x-lg" />
                                </button>
                            </div>
                        </div>
                    }
                    @* Ranked next-beat blurbs (100-persona scoring) take precedence; otherwise show the raw suggestions. *@
                    @if (rankedSuggestions.Count > 0)
                    {
                        <div class="write-beat-suggestions">
                            <div class="text-muted small mb-1">
                                <i class="bi bi-bar-chart-fill me-1" />Ranked by 100 personas (25 each: claude / openai / gemini / deepseek).
                            </div>
                            @foreach (var r in rankedSuggestions)
                            {
                                <button class="write-beat-suggestion ranked" @onclick="() => CommitSuggestion(r.Blurb)">
                                    <span class="write-beat-rank-score">@($"{r.Score:F0}")</span>
                                    <span class="write-beat-rank-blurb">@r.Blurb</span>
                                </button>
                            }
                        </div>
                    }
                    else if (beatSuggestions.Count > 0)
                    {
                        <div class="write-beat-suggestions">
                            <div class="text-muted small mb-1">
                                <i class="bi bi-stars me-1" />Pick a next beat — or "Write my own" / "More" / "Rank".
                            </div>
                            @foreach (var s in beatSuggestions)
                            {
                                <button class="write-beat-suggestion" @onclick="() => CommitSuggestion(s)">
                                    @s
                                </button>
                            }
                        </div>
                    }
                    <div class="d-flex gap-1 mt-2 flex-wrap">
                        <button class="btn btn-sm btn-outline-info"
                                disabled="@(suggestingBeats || ranking)" @onclick="SuggestBeats">
                            @if (suggestingBeats)
                            {
                                <span class="spinner-border spinner-border-sm me-1" />
                                <span>Suggesting…</span>
                            }
                            else
                            {
                                <i class="bi bi-stars me-1" />
                                <span>@(beatSuggestions.Count == 0 && rankedSuggestions.Count == 0 ? "Suggest beats" : "More")</span>
                            }
                        </button>
                        @if (beatSuggestions.Count > 1 && rankedSuggestions.Count == 0)
                        {
                            <button class="btn btn-sm btn-outline-warning"
                                    disabled="@(ranking || suggestingBeats)" @onclick="RankBeats"
                                    title="Score every candidate 0-100 with a 100-persona panel (25 per provider). Costs ~$0.30+ in API calls.">
                                @if (ranking)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" />
                                    <span>Ranking 100 personas…</span>
                                }
                                else
                                {
                                    <i class="bi bi-bar-chart-fill me-1" />
                                    <span>Rank (100 personas)</span>
                                }
                            </button>
                        }
                        <button class="btn btn-sm btn-outline-secondary" @onclick="AddBeat">
                            <i class="bi bi-pencil me-1" />Write my own
                        </button>
                    </div>
                    @if (oocFindings.Count > 0)
                    {
                        <div class="write-ooc-block mt-3">
                            <div class="text-warning small mb-1">
                                <i class="bi bi-exclamation-diamond me-1" />Character drift detected:
                            </div>
                            @foreach (var f in oocFindings)
                            {
                                <div class="write-ooc-card">
                                    <div class="write-ooc-field">@f.Field</div>
                                    <div class="write-ooc-detected">Detected: @f.Detected</div>
                                    @if (!string.IsNullOrWhiteSpace(f.CanonValue))
                                    {
                                        <div class="write-ooc-canon">Canon: @f.CanonValue</div>
                                    }
                                    <div class="write-ooc-suggestion"><i class="bi bi-arrow-right me-1" />@f.Suggestion</div>
                                    <div class="d-flex gap-1 mt-1">
                                        <button class="btn btn-sm btn-outline-success py-0"
                                                title="Pick which canon field receives the detected trait"
                                                @onclick="() => OpenOocPicker(f)">
                                            <i class="bi bi-plus-lg me-1" />Add to canon…
                                        </button>
                                    </div>
                                </div>
                            }
                            <button class="btn btn-sm btn-link text-muted py-0 mt-1"
                                    @onclick="() => oocFindings.Clear()">Dismiss</button>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(beatStatus))
                    {
                        <div class="text-muted small mt-2">@beatStatus</div>
                    }
                }
                else if (sideTab == "outline")
                {
                    @if (Outline.Count == 0)
                    {
                        <div class="text-muted small px-2 py-3">No headings yet. Add <code>## </code> lines to outline this chapter.</div>
                    }
                    @foreach (var o in Outline)
                    {
                        <button class="write-outline-item" @onclick="() => JumpTo(o.Line)"
                                style="@($"padding-left:{4 + (o.Level - 1) * 12}px")">
                            <span class="write-outline-marker">@(new string('#', o.Level))</span>
                            <span class="write-outline-title">@o.Title</span>
                        </button>
                    }
                }
            </div>
        </aside>

        <main class="write-main">
            @if (chapter == null)
            {
                <div class="text-muted small p-3">Pick a chapter from the left to start writing.</div>
            }
            else
            {
                @if (recoveryAvailable)
                {
                    <div class="write-recovery">
                        <i class="bi bi-life-preserver me-1 text-warning"></i>
                        Found a newer local copy from @RecoveryAgo. Restore it?
                        <button class="btn btn-sm btn-warning ms-2" @onclick="RestoreLocal">Restore</button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="DismissRecovery">Discard</button>
                    </div>
                }

                <div class="write-bar">
                    <input class="form-control form-control-sm bg-dark text-light border-secondary write-title"
                           placeholder="Chapter title"
                           @bind="pageTitle" @bind:event="oninput"
                           @bind:after="MarkPageDirty"
                           disabled="@readingMode" />
                    <span class="write-counts text-muted small">@WordCount words</span>
                    <span class="write-saved text-muted small">@SavedLabel</span>
                    <button class="btn btn-sm @(readingMode ? "btn-info" : "btn-outline-secondary")"
                            title="Reading mode" @onclick="ToggleReadingMode">
                        <i class="bi bi-book"></i>
                    </button>
                    <button class="btn btn-sm @(findOpen ? "btn-info" : "btn-outline-secondary")"
                            title="Find / replace" @onclick="ToggleFind"
                            disabled="@readingMode">
                        <i class="bi bi-search"></i>
                    </button>
                    <button class="btn btn-sm @(showFindings ? "btn-warning" : "btn-outline-secondary")"
                            title="Findings for this chapter" @onclick="ToggleFindings">
                        <i class="bi bi-clipboard-check"></i>
                        @if (findings.Count > 0)
                        {
                            <span class="badge bg-dark ms-1">@findings.Count</span>
                        }
                    </button>
                    <button class="btn btn-sm btn-outline-info" @onclick="SaveChapter"
                            disabled="@(!pageDirty || saving)">
                        <i class="bi bi-floppy"></i> Save
                    </button>
                    @if (book != null)
                    {
                        <button class="btn btn-sm btn-outline-warning"
                                title="Compare this chapter's outline against the prose; persists drift as findings"
                                disabled="@(checkingDrift || chapter == null)" @onclick="CheckOutlineDrift">
                            @if (checkingDrift)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <i class="bi bi-shield-check"></i>
                            }
                        </button>
                        <a href="@($"/books/{book.Id}/motifs")" class="btn btn-sm btn-outline-secondary"
                           title="Motifs — recurring phrases / images / objects across the book">
                            <i class="bi bi-tags"></i>
                        </a>
                        <a href="@($"/publish/{book.Id}")" class="btn btn-sm btn-outline-secondary"
                           title="Publish — EPUB / HTML / Markdown / Audio">
                            <i class="bi bi-cloud-download"></i>
                        </a>
                    }
                </div>

                @if (!readingMode)
                {
                    <div class="write-toolbar" role="toolbar">
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Bold (Ctrl+B)"
                                @onclick='() => Wrap("**","**")'><b>B</b></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Italic (Ctrl+I)"
                                @onclick='() => Wrap("*","*")'><i>I</i></button>
                        <span class="write-toolbar-sep"></span>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Heading"
                                @onclick='() => Prefix("## ")'>H</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Quote"
                                @onclick='() => Prefix("> ")'><i class="bi bi-quote"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Bulleted list"
                                @onclick='() => Prefix("- ")'><i class="bi bi-list-ul"></i></button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Numbered list"
                                @onclick='() => Prefix("1. ")'><i class="bi bi-list-ol"></i></button>
                    </div>

                    @if (findOpen)
                    {
                        <div class="write-find">
                            <input class="form-control form-control-sm bg-dark text-light border-secondary"
                                   placeholder="Find" @bind="findQuery" @bind:event="oninput" />
                            <input class="form-control form-control-sm bg-dark text-light border-secondary"
                                   placeholder="Replace with" @bind="replaceQuery" @bind:event="oninput" />
                            <label class="small text-muted d-flex align-items-center gap-1">
                                <input type="checkbox" @bind="findCaseSensitive" /> Aa
                            </label>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="FindNext"
                                    disabled="@string.IsNullOrEmpty(findQuery)">Next</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ReplaceNext"
                                    disabled="@string.IsNullOrEmpty(findQuery)">Replace</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ReplaceAll"
                                    disabled="@string.IsNullOrEmpty(findQuery)">All</button>
                            <span class="small text-muted">@findStatus</span>
                        </div>
                    }

                    <textarea id="write-surface"
                              class="form-control bg-dark text-light border-secondary write-surface"
                              placeholder="Write."
                              @bind="pageMarkdown" @bind:event="oninput"
                              @bind:after="MarkPageDirty"
                              @onkeydown="OnKey"
                              spellcheck="true"></textarea>
                }
                else
                {
                    <article class="write-reading">
                        @((MarkupString)Markdig.Markdown.ToHtml(pageMarkdown ?? ""))
                    </article>
                }
            }
        </main>

        @if (showFindings && chapter != null)
        {
            <aside class="write-findings-side">
                <div class="write-findings-head">
                    <span class="text-info small">
                        <i class="bi bi-clipboard-check me-1"></i>Findings
                    </span>
                    <button class="btn-close btn-close-white btn-sm" @onclick="ToggleFindings"></button>
                </div>
                <div class="write-findings-list">
                    @if (findings.Count == 0)
                    {
                        <div class="text-muted small px-2 py-3">
                            No findings for this chapter yet. Reviews and the contradiction sweep
                            attach findings here as they run.
                        </div>
                    }
                    @foreach (var f in findings)
                    {
                        <div class="@($"write-finding sev-{f.Severity.ToString().ToLowerInvariant()}")">
                            <div class="write-finding-head">
                                <span class="write-finding-cat">@f.Category</span>
                                <span class="write-finding-sev">@f.Severity</span>
                            </div>
                            <div class="write-finding-summary">@f.Summary</div>
                            @if (!string.IsNullOrWhiteSpace(f.Snippet))
                            {
                                <div class="write-finding-snippet">@f.Snippet</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(f.SuggestedFix))
                            {
                                <div class="write-finding-fix"><i class="bi bi-arrow-right me-1"></i>@f.SuggestedFix</div>
                            }
                        </div>
                    }
                </div>
            </aside>
        }
    }
</div>

@* ── OOC field-picker modal — explicit field choice for "Add to canon" ── *@
@if (oocPickerFor != null)
{
    <div class="modal-backdrop fade show" style="z-index:1050;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index:1055;" @onclick="CloseOocPicker">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content bg-dark text-light border-success">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-success"><i class="bi bi-plus-lg me-2"></i>Add to canon</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseOocPicker"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small mb-2">Trait to add to <strong>@(chapter?.Characters?.FirstOrDefault() ?? "?")</strong>:</p>
                    <div class="bg-black p-2 mb-3 small" style="border-left:3px solid #5be;">
                        @oocPickerFor.Detected
                    </div>
                    <p class="text-muted small mb-2">Pick the canonical field this lands in:</p>
                    <div class="d-flex flex-column gap-1">
                        @foreach (var (key, label) in OocFieldChoices)
                        {
                            <button class="btn btn-sm btn-outline-info text-start"
                                    @onclick="() => CommitOocPick(key)">
                                <strong>@key</strong> <span class="text-muted small">— @label</span>
                            </button>
                        }
                    </div>
                </div>
                <div class="modal-footer border-secondary">
                    <button class="btn btn-sm btn-secondary" @onclick="CloseOocPicker">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
  .write-shell { display:grid; grid-template-columns: 240px 1fr; height: calc(100vh - 56px); min-height:0; }
  .write-shell.with-findings { grid-template-columns: 240px 1fr 300px; }
  .write-side { border-right:1px solid #444; display:flex; flex-direction:column; min-height:0; }
  .write-side-head { padding:8px 10px; border-bottom:1px solid #2a2a32; display:flex; flex-direction:column; gap:6px; }
  .write-side-tabs { display:flex; gap:4px; }
  .write-side-tab { flex:1; background:transparent; border:1px solid #333; color:#aaa; padding:3px 0; font-size:.78rem; border-radius:3px; }
  .write-side-tab.active { background:#1c2a3a; color:#fff; border-color:#3a5a7a; }
  .write-side-tab:disabled { opacity:.45; cursor:not-allowed; }

  .write-side-list { flex:1; overflow-y:auto; padding:6px; display:flex; flex-direction:column; gap:2px; }
  .write-side-item { display:flex; gap:8px; padding:6px 8px; border-radius:4px; color:#bbb; text-decoration:none; }
  .write-side-item:hover { background:#1f2229; color:#fff; }
  .write-side-item.active { background:#1c2a3a; color:#fff; }
  .write-side-num { font-family:monospace; font-size:.75rem; color:#88a; min-width:46px; }
  .write-side-title { flex:1; font-size:.9rem; }
  .write-side-done { font-family:monospace; font-size:.85rem; margin-left:auto; }

  .write-outline-item { display:flex; gap:6px; align-items:baseline; background:transparent; border:0;
                        text-align:left; color:#bbb; padding:4px 6px; border-radius:3px; font-size:.85rem; width:100%; }
  .write-outline-item:hover { background:#1f2229; color:#fff; }
  .write-outline-marker { color:#5b8; font-family:monospace; font-size:.7rem; }
  .write-outline-title { flex:1; }

  /* Beat blurbs — sequential authoring strip in the left aside.
     Status: dot color + left-border accent. Done = green, Ready (blurb but no
     prose) = amber, Empty = muted. The amber "ready" stripe is the user's
     visual hint for "this is the next beat to expand." */
  .write-beat { background:#16181d; border:1px solid #2a2a32; border-left:3px solid #444;
                padding:6px 8px; margin-bottom:6px; border-radius:3px;
                cursor:default; transition:opacity 0.15s ease, transform 0.15s ease; }
  .write-beat.dragging { opacity:0.4; }
  .write-beat-grip { color:#666; font-family:monospace; cursor:grab; user-select:none; padding:0 2px; }
  .write-beat-grip:active { cursor:grabbing; }
  .write-beat.ready { border-left-color:#ffc107; }
  .write-beat.done  { border-left-color:#2ecc71; opacity:0.85; }
  .write-beat-head  { display:flex; align-items:center; gap:6px; margin-bottom:4px; }
  .write-beat-title { flex:1; background:transparent; border:0; color:#ddd; font-size:.85rem;
                      font-weight:600; padding:2px 0; outline:none; }
  .write-beat-title::placeholder { color:#666; font-weight:400; }
  .write-beat-status { font-family:monospace; font-size:.9rem; }
  .write-beat-blurb { width:100%; background:#0e1014; color:#cfd; border:1px solid #2a2a32;
                      border-radius:3px; padding:4px 6px; font-size:.8rem; resize:vertical;
                      font-family:Georgia,serif; }
  .write-beat-actions { display:flex; gap:4px; align-items:center; margin-top:4px; }
  /* Legion-suggested next-beat candidates — clickable cards that commit on pick. */
  .write-beat-suggestions { margin-top:6px; display:flex; flex-direction:column; gap:4px; }
  .write-beat-suggestion {
      background:#0e1014; color:#cfd; border:1px solid #2a3a4a; border-left:3px solid #5be;
      border-radius:3px; padding:6px 8px; font-size:.8rem; text-align:left;
      font-family:Georgia,serif; line-height:1.4; cursor:pointer; transition:background 0.12s ease;
  }
  .write-beat-suggestion:hover { background:#162028; border-left-color:#9df; }
  /* Ranked variant — score badge prefixed to the blurb. */
  .write-beat-suggestion.ranked { display:flex; gap:8px; align-items:flex-start; border-left-color:#ffc107; }
  .write-beat-suggestion.ranked:hover { border-left-color:#ffe59a; }
  .write-beat-rank-score { background:#ffc107; color:#000; font-weight:600; font-size:.7rem;
                            min-width:30px; text-align:center; padding:1px 4px; border-radius:2px;
                            font-family:monospace; }
  .write-beat-rank-blurb { flex:1; }
