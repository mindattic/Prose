@code {
    [Parameter] public string? BookId { get; set; }
    [Parameter] public string? ChapterId { get; set; }

    private List<Book> allBooks = new();
    private List<Chapter> bookChapters = new();
    private Book? book;
    private Chapter? chapter;

    private string pageTitle = "";
    private string pageMarkdown = "";
    private bool pageDirty;

    // Autosave + saved-time indicator
    private DateTime lastEditAt = DateTime.MinValue;
    private DateTime? lastSavedAt;
    private bool saving;
    private System.Threading.Timer? autosaveTimer;
    private const int AutosaveIdleMs = 2000;

    // Navigation guard
    private IDisposable? locationGuard;

    // Sidebar tab + reading + find
    // sideTab: "chapters" | "beats" | "outline" — replaces the old showOutline bool
    // so the chapter editor can offer the beats workflow alongside the prior two views.
    private string sideTab = "chapters";
    private bool readingMode;
    private bool findOpen;
    private bool showFindings;
    private IReadOnlyList<Finding> findings = Array.Empty<Finding>();
    // Per-beat expand state
    private string? beatExpanding;
    private string beatStatus = "";
    // OOC drift detected on the most recent expand — surfaced inline in the
    // beat panel with "edit prose" or "add to canon" affordances.
    private List<OocFinding> oocFindings = new();
    // Outline-vs-prose drift audit state. Drift findings are persisted to
    // FindingsService so they appear in the regular findings sidebar instead
    // of needing a parallel surface.
    private bool checkingDrift;
    // Drag-to-reorder state for beats. We swap Index values rather than
    // shifting the list so the order is stable and saves immediately.
    private string? draggingBeatId;
    // OOC field-picker modal state — set when the user clicks "Add to canon…"
    // on a drift card; cleared on commit or cancel.
    private OocFinding? oocPickerFor;
    // Field choices presented in the picker. Key is the structured field path;
    // value is the display description.
    private static readonly (string Key, string Label)[] OocFieldChoices =
    [
        ("speech_patterns.verbal_tics",        "Recurring verbal habit, tic, or signature phrase"),
        ("speech_patterns.under_pressure",     "How they speak under threat or provocation"),
        ("speech_patterns.example_lines",      "An example line to anchor the voice"),
        ("speech_patterns.avoidances",         "Topics, words, or registers they refuse"),
        ("speech_patterns.subtext",            "How they say one thing while meaning another"),
        ("psychology.coping_mechanisms",       "How they manage stress / threat / loss"),
        ("psychology.blind_spots",             "What they miss about themselves or the world"),
    ];
    // localStorage-backed resume: at most one redirect attempt per page load
    // so we don't ping-pong if the saved selection was deleted.
    private bool redirectAttempted;
    // Legion-suggested next-beat blurbs awaiting selection. Cleared on chapter change
    // and when a candidate is committed; "More" appends additional suggestions.
    private List<string> beatSuggestions = new();
    private bool suggestingBeats;
    // Ranked suggestions from the 100-persona scoring pass. When non-empty, the UI
    // renders these (with score badges) in place of the unranked list.
    private List<BeatRankResult> rankedSuggestions = new();
    private bool ranking;
    private string findQuery = "";
    private string replaceQuery = "";
    private bool findCaseSensitive;
    private int findCursor;
    private string? findStatus;

    // Crash recovery
    private bool recoveryAvailable;
    private string? recoveredText;
    private DateTime? recoveredTs;

    // JS hook lifecycle — re-install when chapter changes
    private string? jsBoundChapterId;

    private string focusModeClass => readingMode ? "write-shell-reading" : "";

    private int WordCount => string.IsNullOrWhiteSpace(pageMarkdown)
        ? 0
        : pageMarkdown.Split(new[] { ' ', '\t', '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries).Length;

    private string SavedLabel
    {
        get
        {
            if (saving) return "Saving…";
            if (pageDirty) return "Unsaved";
            if (lastSavedAt is null) return "";
            var d = DateTime.UtcNow - lastSavedAt.Value;
            if (d.TotalSeconds < 5)  return "Saved just now";
            if (d.TotalSeconds < 60) return $"Saved {(int)d.TotalSeconds}s ago";
            if (d.TotalMinutes < 60) return $"Saved {(int)d.TotalMinutes}m ago";
            if (d.TotalHours   < 24) return $"Saved {(int)d.TotalHours}h ago";
            return "Saved earlier";
        }
    }

    private string RecoveryAgo
    {
        get
        {
            if (recoveredTs is null) return "";
            var d = DateTime.UtcNow - recoveredTs.Value;
            if (d.TotalSeconds < 60) return $"{(int)d.TotalSeconds}s ago";
            if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m ago";
            if (d.TotalHours   < 24) return $"{(int)d.TotalHours}h ago";
            return "earlier";
        }
    }

    private record OutlineItem(int Line, int Level, string Title);

    private List<OutlineItem> Outline
    {
        get
        {
            if (string.IsNullOrEmpty(pageMarkdown)) return new();
            var rx = new System.Text.RegularExpressions.Regex(@"^(#{1,6})\s+(.+)$");
            var lines = pageMarkdown.Split('\n');
            var list = new List<OutlineItem>();
            for (int i = 0; i < lines.Length; i++)
            {
                var m = rx.Match(lines[i]);
                if (m.Success) list.Add(new OutlineItem(i, m.Groups[1].Length, m.Groups[2].Value.Trim()));
            }
            return list;
        }
    }

    protected override void OnInitialized()
    {
        locationGuard = Nav.RegisterLocationChangingHandler(OnLocationChanging);
        autosaveTimer = new System.Threading.Timer(_ => InvokeAsync(AutosaveTick),
            null, TimeSpan.FromMilliseconds(1500), TimeSpan.FromMilliseconds(1500));
    }

    protected override void OnParametersSet()
    {
        allBooks = Books.ListBooks();

        // If no book/chapter is in the route, hop to the last selection from
        // localStorage so navigating to /write resumes where the user left off.
        // Only fires on the bare /write entry; explicit /write/{book}/{chapter}
        // routes win.
        if (string.IsNullOrEmpty(BookId) && allBooks.Count > 0 && !redirectAttempted)
        {
            redirectAttempted = true;
            _ = TryResumeLastSelectionAsync();
            return;
        }

        if (!string.IsNullOrEmpty(BookId))
        {
            book = Books.LoadBook(BookId);
            bookChapters = book == null
                ? new()
                : book.ChapterIds
                    .Select(Chapters.LoadChapter)
                    .Where(c => c != null)
                    .Cast<Chapter>()
                    .OrderBy(c => c.Number ?? int.MaxValue)
                    .ToList();
        }
        else { book = null; bookChapters = new(); }

        if (!string.IsNullOrEmpty(ChapterId))
        {
            var prevId = chapter?.Id;
            chapter = Chapters.LoadChapter(ChapterId);
            if (chapter != null)
            {
                pageTitle = chapter.Title;
                pageMarkdown = string.IsNullOrWhiteSpace(chapter.Markdown)
                    ? HtmlToMarkdownFallback(chapter.Html)
                    : chapter.Markdown;
                pageDirty = false;
                lastSavedAt = chapter.Modified;
                if (prevId != chapter.Id)
                {
                    recoveryAvailable = false;
                    recoveredText = null;
                    recoveredTs = null;
                    findOpen = false;
                    findCursor = 0;
                    findStatus = null;
                    sideTab = "chapters";
                    beatStatus = "";
                    beatSuggestions.Clear();
                    rankedSuggestions.Clear();
                    oocFindings.Clear();
                    readingMode = false;
                }
                LoadFindings();
            }
        }
        else
        {
            chapter = null; pageTitle = ""; pageMarkdown = ""; pageDirty = false;
            lastSavedAt = null; recoveryAvailable = false;
            findings = Array.Empty<Finding>();
        }
        // Fire-and-forget — JS may be unavailable during prerender.
        _ = PersistSelectionAsync();
    }

    private void LoadFindings()
    {
        findings = chapter == null
            ? Array.Empty<Finding>()
            : Findings.ListByChapter(chapter.Id);
    }

    /// <summary>
    /// Read the last (book, chapter) selection from localStorage and navigate
    /// there. Falls back to the most-recent book on the bookshelf if no saved
    /// selection exists, or stays on the picker view if no books are loaded.
    /// </summary>
    private async Task TryResumeLastSelectionAsync()
    {
        try
        {
            var lastBook    = await JS.InvokeAsync<string?>("ssState.get", "write:last-book");
            var lastChapter = await JS.InvokeAsync<string?>("ssState.get", "write:last-chapter");
            if (!string.IsNullOrWhiteSpace(lastBook) && allBooks.Any(b => b.Id == lastBook))
            {
                var url = string.IsNullOrWhiteSpace(lastChapter)
                    ? $"/write/{lastBook}"
                    : $"/write/{lastBook}/{lastChapter}";
                Nav.NavigateTo(url, replace: true);
            }
        }
        catch { /* JS may be unavailable during prerender — picker view stays */ }
    }

    /// <summary>Persist the current (book, chapter) selection so /write resumes here next time.</summary>
    private async Task PersistSelectionAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("ssState.set", "write:last-book",    book?.Id ?? "");
            await JS.InvokeVoidAsync("ssState.set", "write:last-chapter", chapter?.Id ?? "");
        }
        catch { }
    }

    /// <summary>Capture the textarea's caret position into localStorage when it loses focus.</summary>
    private async Task SaveBeatCursor(string beatId)
    {
        try { await JS.InvokeVoidAsync("ssState.saveCursorById", $"beat-blurb-{beatId}", $"write:beat-cursor:{beatId}"); }
        catch { }
    }

    /// <summary>Restore the textarea's caret position from localStorage when it gains focus.</summary>
    private async Task RestoreBeatCursor(string beatId)
    {
        try { await JS.InvokeVoidAsync("ssState.restoreCursorById", $"beat-blurb-{beatId}", $"write:beat-cursor:{beatId}"); }
        catch { }
    }

    private void OpenOocPicker(OocFinding f) => oocPickerFor = f;
    private void CloseOocPicker() => oocPickerFor = null;

    /// <summary>
    /// Commit the chosen field for the OOC pick. Routes the trait to the
    /// structured field the user explicitly picked — no auto-routing
    /// heuristic, no silent canon corruption. Each field's container has
    /// different shape (string vs List&lt;string&gt;) so the switch dispatches
    /// per-field.
    /// </summary>
    private void CommitOocPick(string fieldKey)
    {
        var f = oocPickerFor;
        if (f == null) { CloseOocPicker(); return; }
        if (chapter?.Characters?.FirstOrDefault() is not string povName || string.IsNullOrWhiteSpace(povName))
        {
            Toast.Warning("OOC-CANON-NO-POV", "Chapter has no POV character — can't route the trait to canon.");
            CloseOocPicker();
            return;
        }
        try
        {
            var c = CharRepo.GetAll().FirstOrDefault(x => string.Equals(x.Name, povName, StringComparison.OrdinalIgnoreCase));
            if (c == null)
            {
                Toast.Error("OOC-CANON-NOT-FOUND", $"No character named '{povName}' in canon.");
                CloseOocPicker();
                return;
            }
            var trait = (f.Detected ?? "").Trim();
            if (string.IsNullOrWhiteSpace(trait))
            {
                Toast.Warning("OOC-CANON-EMPTY", "Nothing detected to add.");
                CloseOocPicker();
                return;
            }

            switch (fieldKey)
            {
                case "speech_patterns.verbal_tics":    c.SpeechPatterns.VerbalTics.Add(trait); break;
                case "speech_patterns.example_lines":  c.SpeechPatterns.ExampleLines.Add(trait); break;
                case "speech_patterns.avoidances":     c.SpeechPatterns.Avoidances.Add(trait); break;
                case "speech_patterns.under_pressure":
                    c.SpeechPatterns.UnderPressure = string.IsNullOrWhiteSpace(c.SpeechPatterns.UnderPressure)
                        ? trait : $"{c.SpeechPatterns.UnderPressure}; {trait}";
                    break;
                case "speech_patterns.subtext":
                    c.SpeechPatterns.Subtext = string.IsNullOrWhiteSpace(c.SpeechPatterns.Subtext)
                        ? trait : $"{c.SpeechPatterns.Subtext}; {trait}";
                    break;
                case "psychology.coping_mechanisms":   c.Psychology.CopingMechanisms.Add(trait); break;
                case "psychology.blind_spots":         c.Psychology.BlindSpots.Add(trait); break;
                default:
                    Toast.Warning("OOC-CANON-UNKNOWN-FIELD", $"Unknown field '{fieldKey}'.");
                    CloseOocPicker();
                    return;
            }
            CharRepo.Save(c);
            oocFindings.Remove(f);
            Toast.Success("OOC-CANON-OK", $"Added to {povName}'s {fieldKey}.");
        }
        catch (Exception ex)
        {
            Toast.Error("OOC-CANON-FAIL", $"Couldn't add to canon: {ex.Message}");
        }
        finally
        {
            CloseOocPicker();
        }
    }

    /// <summary>
    /// When the user edits the chapter prose, mark this chapter's outstanding
    /// drift findings as Dismissed — the prose has changed, the LLM's earlier
    /// drift verdict is now stale. The user can rerun the audit to get a fresh
    /// read. Triggered from MarkPageDirty so any keystroke counts.
    /// </summary>
    private void StaleDriftFindingsForCurrentChapter()
    {
        if (chapter == null) return;
        try
        {
            // Drift findings now carry FindingCategory.OutlineDrift; filtering
            // on category leaves unrelated findings (cliché, voice checks,
            // etc.) untouched. The legacy OUTLINE-DRIFT summary-prefix path
            // still matches old rows that pre-date the category promotion.
            var drifts = Findings.ListByChapter(chapter.Id)
                .Where(f => f.Status == FindingStatus.New
                         && (f.Category == FindingCategory.OutlineDrift
                             || (f.Summary?.StartsWith("OUTLINE-DRIFT", StringComparison.OrdinalIgnoreCase) ?? false)))
                .ToList();
            foreach (var d in drifts)
                Findings.SetStatus(d.Id, FindingStatus.Dismissed);
            if (drifts.Count > 0) LoadFindings();
        }
        catch { /* non-fatal; user can rerun the audit */ }
    }

    /// <summary>
    /// Fire the outline-vs-prose drift audit for the current chapter.
    /// Findings are written into the FindingsService so they show up in the
    /// existing findings sidebar — no parallel UI surface needed.
    /// </summary>
    private async Task CheckOutlineDrift()
    {
        if (book == null || chapter == null || checkingDrift) return;
        checkingDrift = true;
        StateHasChanged();
        try
        {
            var prose = pageMarkdown ?? "";
            if (string.IsNullOrWhiteSpace(prose))
            {
                Toast.Warning("DRIFT-EMPTY", "No prose written yet — nothing to compare against the outline.");
                return;
            }
            var drifts = await OutlineSvc.DetectChapterDriftAsync(book.Id, chapter.Id, prose);
            if (drifts.Count == 0)
            {
                Toast.Success("DRIFT-NONE", "Prose delivers the outline. No drift.");
                return;
            }
            // Persist each drift as a finding so it lives in the inbox + sidebar.
            // OutlineDrift is now a first-class FindingCategory; the [kind]
            // prefix in Summary stays for human readability (it's the visible
            // distinguishing label between missing/contradiction/extra) but
            // filtering / auto-dismiss now key on Category, not the prefix.
            foreach (var d in drifts)
            {
                Findings.Upsert(
                    filePath: $"chapter:{chapter.Id}",
                    chapterId: chapter.Id,
                    category: FindingCategory.OutlineDrift,
                    severity: d.Kind == "contradiction" ? FindingSeverity.High : FindingSeverity.Medium,
                    summary: $"[{d.Kind}] {d.Summary}",
                    snippet: $"Outline says: {d.OutlineSays}\nProse says: {d.ProseSays}",
                    suggestedFix: d.Kind switch
                    {
                        "missing"       => "Either deliver this beat in the prose or trim it from the outline.",
                        "contradiction" => "Reconcile — the outline and the prose disagree.",
                        "extra"         => "If this addition belongs, fold it into the outline body.",
                        _               => "Review and reconcile.",
                    });
            }
            // Refresh the sidebar so the new findings show up immediately.
            LoadFindings();
            if (!showFindings) showFindings = true;
            Toast.Warning("DRIFT-FOUND", $"{drifts.Count} drift finding(s) added — see the sidebar.");
        }
        catch (Exception ex)
        {
            Toast.Error("DRIFT-FAIL", $"Drift audit failed: {ex.Message}");
        }
        finally
        {
            checkingDrift = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("writeInterop.writer.installBeforeUnload"); } catch { }
            // Persist + restore the sidebar list scroll position. Key keys per
            // book so a long chapter list resumes its scroll on chapter switch.
            try
            {
                var scrollKey = $"write:side-scroll:{book?.Id ?? "none"}";
                await JS.InvokeVoidAsync("ssState.autoSaveScrollOf", ".write-side-list", scrollKey);
                await JS.InvokeVoidAsync("ssState.restoreScrollOf",  ".write-side-list", scrollKey);
            }
            catch { }
        }
        if (chapter != null && jsBoundChapterId != chapter.Id)
        {
            jsBoundChapterId = chapter.Id;
            try
            {
                await JS.InvokeVoidAsync("writeInterop.writer.installPaste", "write-surface");
                await JS.InvokeVoidAsync("writeInterop.writer.installLocalBackup", "write-surface", chapter.Id);

                // Crash-recovery probe: only show banner if local copy beats server modified.
                var local = await JS.InvokeAsync<LocalBackup?>("writeInterop.writer.localLoad", chapter.Id);
                if (local is { Text.Length: > 0 })
                {
                    var localTs = DateTime.TryParse(local.Ts, null,
                        System.Globalization.DateTimeStyles.RoundtripKind, out var ts)
                        ? ts.ToUniversalTime() : DateTime.MinValue;
                    if (localTs > chapter.Modified.AddSeconds(1) && local.Text != pageMarkdown)
                    {
                        recoveredText = local.Text;
                        recoveredTs = localTs;
                        recoveryAvailable = true;
                        StateHasChanged();
                    }
                    else
                    {
                        // Local is stale or matches — drop it.
                        await JS.InvokeVoidAsync("writeInterop.writer.localClear", chapter.Id);
                    }
                }
            }
            catch { /* JS not ready or interop disabled — fail open */ }
        }
    }

    private record LocalBackup(string Text, string Ts);

    private async ValueTask OnLocationChanging(LocationChangingContext ctx)
    {
        if (!pageDirty || saving) return;
        bool keep;
        try { keep = await JS.InvokeAsync<bool>("confirm", "You have unsaved changes. Leave anyway?"); }
        catch { keep = true; }
        if (!keep) ctx.PreventNavigation();
    }

    private void MarkPageDirty()
    {
        pageDirty = true;
        lastEditAt = DateTime.UtcNow;
        _ = SyncDirty(true);
        // Drift findings are stale once the prose changes — dismiss them so
        // the user isn't second-guessing edits they just made. Cheap (single
        // SQL UPDATE per finding) and idempotent; LoadFindings refreshes the
        // sidebar in the same call.
        StaleDriftFindingsForCurrentChapter();
    }

    private async Task SyncDirty(bool dirty)
    {
        try { await JS.InvokeVoidAsync("writeInterop.writer.setDirty", dirty); } catch { }
    }

    private async Task Wrap(string pre, string suf)
    {
        await JS.InvokeVoidAsync("writeInterop.richEditor.mdWrapSelection", "write-surface", pre, suf);
    }

    private async Task Prefix(string pre)
    {
        await JS.InvokeVoidAsync("writeInterop.richEditor.mdPrefixLine", "write-surface", pre);
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (!(e.CtrlKey || e.MetaKey)) return;
        var k = (e.Key ?? "").ToLowerInvariant();
        if      (k == "b") await Wrap("**", "**");
        else if (k == "i") await Wrap("*", "*");
    }

    private void ToggleReadingMode() { readingMode = !readingMode; if (readingMode) findOpen = false; }
    private void ToggleFind()        { findOpen = !findOpen; findStatus = null; }
    private void ToggleFindings()    { showFindings = !showFindings; if (showFindings) LoadFindings(); }

    // ── Beat workflow ──────────────────────────────────────────────────────
    // Each ChapterBeat holds a Synopsis (the user-authored blurb — "Kyle walks
    // into the bar and asks for a seltzer with a lime") and a Text (the prose
    // produced by Update). Beats with prose are "done"; beats with a blurb but
    // no prose are "ready" — the next-up beat is implicitly whichever ready
    // one comes first in Index order.

    private void AddBeat()
    {
        if (chapter == null) return;
        var nextIdx = chapter.Beats.Count == 0 ? 0 : chapter.Beats.Max(b => b.Index) + 1;
        chapter.Beats.Add(new ChapterBeat { Index = nextIdx, Title = "", Synopsis = "", Text = "" });
        MarkPageDirty();
    }

    /// <summary>
    /// Ask Legion's panel for distinct next-beat blurbs. Each call appends to
    /// the candidate list (so "More" extends rather than replaces). Scene-so-far
    /// is built from prior beats' Text where possible, otherwise the chapter
    /// markdown — same continuity source the expand step uses.
    /// </summary>
    private async Task SuggestBeats()
    {
        if (chapter == null || suggestingBeats) return;
        suggestingBeats = true;
        beatStatus = "Polling Legion's panel for diverse next beats…";
        StateHasChanged();
        try
        {
            var doneBeats = chapter.Beats.OrderBy(b => b.Index)
                                          .Where(b => !string.IsNullOrWhiteSpace(b.Text))
                                          .ToList();
            var sceneSoFar = doneBeats.Any()
                ? string.Join("\n\n", doneBeats.Select(b => b.Text))
                : (pageMarkdown ?? "");

            var pov = chapter.Beats.LastOrDefault(b => !string.IsNullOrWhiteSpace(b.Text))?.Title ?? "";
            var fresh = await BeatGen.SuggestNextBeatsAsync(
                sceneSoFar:    sceneSoFar,
                chapterTitle:  pageTitle,
                povCharacter:  pov,
                count:         5);
            // Dedupe against what's already on the list so "More" never repeats.
            foreach (var s in fresh)
                if (!beatSuggestions.Any(x => string.Equals(x, s, StringComparison.OrdinalIgnoreCase)))
                    beatSuggestions.Add(s);
            beatStatus = beatSuggestions.Count == 0
                ? "Legion returned no suggestions — check API keys and try again."
                : $"{beatSuggestions.Count} candidate beat(s). Click one to commit, or write your own.";
        }
        catch (Exception ex)
        {
            beatStatus = $"Error: {ex.Message}";
            Toast.Error("BEAT-SUGGEST-FAIL", $"Couldn't suggest beats: {ex.Message}");
        }
        finally
        {
            suggestingBeats = false;
            StateHasChanged();
        }
    }

    /// <summary>Commit a Legion-proposed blurb as a new beat at the end of the list.</summary>
    private void CommitSuggestion(string blurb)
    {
        if (chapter == null) return;
        var nextIdx = chapter.Beats.Count == 0 ? 0 : chapter.Beats.Max(b => b.Index) + 1;
        chapter.Beats.Add(new ChapterBeat { Index = nextIdx, Title = "", Synopsis = blurb, Text = "" });
        beatSuggestions.Clear();
        rankedSuggestions.Clear();
        beatStatus = "Beat committed. Refine the blurb or click Update to expand it into prose.";
        MarkPageDirty();
    }

    /// <summary>
    /// Run a 100-persona ranking pass over the current candidate suggestions.
    /// Each persona scores every candidate 0-100; the result list replaces the
    /// unranked view sorted strongest-first.
    /// </summary>
    private async Task RankBeats()
    {
        if (chapter == null || ranking || beatSuggestions.Count == 0) return;
        ranking = true;
        beatStatus = "Polling 100 personas (25 each: claude / openai / gemini / deepseek)…";
        StateHasChanged();
        try
        {
            var doneBeats = chapter.Beats.OrderBy(b => b.Index)
                                          .Where(b => !string.IsNullOrWhiteSpace(b.Text))
                                          .ToList();
            var sceneSoFar = doneBeats.Any()
                ? string.Join("\n\n", doneBeats.Select(b => b.Text))
                : (pageMarkdown ?? "");

            var pov = chapter.Beats.LastOrDefault(b => !string.IsNullOrWhiteSpace(b.Text))?.Title ?? "";
            var ranked = await BeatGen.RankBeatBlurbsAsync(
                blurbs:       beatSuggestions,
                sceneSoFar:   sceneSoFar,
                chapterTitle: pageTitle,
                povCharacter: pov);
            rankedSuggestions = ranked;
            beatStatus = ranked.Count == 0
                ? "Ranking returned no scores — check API keys and try again."
                : $"Ranked {ranked.Count} candidate(s). Top score: {ranked[0].Score:F0} (n={ranked[0].VoteCount}).";
        }
        catch (Exception ex)
        {
            beatStatus = $"Error: {ex.Message}";
            Toast.Error("BEAT-RANK-FAIL", $"Couldn't rank beats: {ex.Message}");
        }
        finally
        {
            ranking = false;
            StateHasChanged();
        }
    }

    private void RemoveBeat(ChapterBeat b)
    {
        if (chapter == null) return;
        chapter.Beats.Remove(b);
        MarkPageDirty();
    }

    // ── Drag-to-reorder ────────────────────────────────────────────────────
    // The dragged beat's Index is set to the target's Index, with intermediate
    // beats shifted by one in the direction of the move. List position in the
    // model follows Index via OrderBy(b => b.Index) in the render.

    private void OnBeatDragStart(ChapterBeat b)
    {
        draggingBeatId = b.Id;
    }

    private void OnBeatDragOver(ChapterBeat target)
    {
        // Visual feedback only — the @ondragover:preventDefault on the row
        // already lets the drop fire. No state change here.
    }

    private void OnBeatDrop(ChapterBeat target)
    {
        if (chapter == null || draggingBeatId == null) return;
        var dragged = chapter.Beats.FirstOrDefault(b => b.Id == draggingBeatId);
        if (dragged == null || dragged.Id == target.Id) { draggingBeatId = null; return; }

        var ordered = chapter.Beats.OrderBy(b => b.Index).ToList();
        ordered.Remove(dragged);
        var targetIdx = ordered.FindIndex(b => b.Id == target.Id);
        if (targetIdx < 0) targetIdx = ordered.Count;
        ordered.Insert(targetIdx, dragged);
        // Re-stamp Index in the new order — keeps the dense 0..N-1 contract
        // the rest of the code expects.
        for (int i = 0; i < ordered.Count; i++) ordered[i].Index = i;
        draggingBeatId = null;
        MarkPageDirty();
    }

    private void OnBeatDragEnd()
    {
        draggingBeatId = null;
    }

    /// <summary>
    /// Expand the beat's Synopsis (blurb) into prose using BeatGeneratorService,
    /// store the result in beat.Text, and append it to the chapter markdown.
    /// SceneSoFar is the concatenation of prior beats' prose so the LLM picks up
    /// continuity (mood shifts, revelations the room has just absorbed, etc).
    /// </summary>
    private async Task ExpandBeat(ChapterBeat b)
    {
        if (chapter == null || string.IsNullOrWhiteSpace(b.Synopsis)) return;
        beatExpanding = b.Id;
        beatStatus    = $"Expanding beat \"{(string.IsNullOrWhiteSpace(b.Title) ? b.Synopsis : b.Title)}\"…";
        StateHasChanged();
        try
        {
            // Earlier beats' Text feeds SceneSoFar so the new prose flows from the prior
            // beat. Falls back to the page markdown when no prior beats exist.
            var priorBeats = chapter.Beats.OrderBy(x => x.Index).TakeWhile(x => x.Id != b.Id).ToList();
            var sceneSoFar = priorBeats.Any(p => !string.IsNullOrWhiteSpace(p.Text))
                ? string.Join("\n\n", priorBeats.Select(p => p.Text).Where(t => !string.IsNullOrWhiteSpace(t)))
                : (pageMarkdown ?? "");

            // Canon wire-up: literary rules so the writer leans on the world's voice
            // instead of generic cyberpunk; dialogue voice anchors so each named
            // character speaks in their documented register without the user having
            // to inline character notes into every blurb.
            var storyBible = "";
            try { storyBible = CanonDb.GetLiteraryRulesPrompt() ?? ""; } catch { }
            var dialogueCtx = "";
            try
            {
                if (chapter.Characters?.Any() == true)
                    dialogueCtx = Dialogue.BuildDialogueContext(chapter.Characters) ?? "";
            }
            catch { }

            var ctx = new BeatContext
            {
                StoryBibleContext   = storyBible,
                RelationshipContext = "",
                LocationContext     = "",
                DialogueContext     = dialogueCtx,
                SceneSoFar          = sceneSoFar,
                BeatGoal            = b.Synopsis,
            };
            var prose = await BeatGen.GenerateBeatAsync(ctx);
            if (string.IsNullOrWhiteSpace(prose))
            {
                beatStatus = "LLM returned empty prose — check API key and try again.";
                return;
            }
            b.Text = prose.Trim();

            // Append to the page markdown so the prose appears in the chapter immediately.
            // Blank-line separator preserves paragraph boundaries in the rendered output.
            var sep = string.IsNullOrWhiteSpace(pageMarkdown) ? "" : "\n\n";
            pageMarkdown = (pageMarkdown ?? "") + sep + b.Text;
            MarkPageDirty();
            beatStatus = $"Updated. Next: pick the next beat or add one.";

            // Out-of-character drift check — fires after the expand so the user
            // sees the finding in context. Quick + low-tier; failure is silent.
            try
            {
                if (chapter.Characters?.FirstOrDefault() is string pov && !string.IsNullOrWhiteSpace(pov))
                {
                    var canonProfile = dialogueCtx; // already built above; fine as the ground truth source
                    if (!string.IsNullOrWhiteSpace(canonProfile))
                    {
                        var ooc = await BeatGen.DetectOutOfCharacterAsync(b.Text, pov, canonProfile);
                        if (ooc.Count > 0)
                        {
                            oocFindings = ooc;
                            beatStatus = $"Updated. {ooc.Count} character drift(s) flagged below — review.";
                        }
                    }
                }
            }
            catch { /* non-fatal */ }
        }
        catch (Exception ex)
        {
            beatStatus = $"Error: {ex.Message}";
            Toast.Error("BEAT-EXPAND-FAIL", $"Couldn't expand beat: {ex.Message}");
        }
        finally
        {
            beatExpanding = null;
            StateHasChanged();
        }
    }

    private async Task AutosaveTick()
    {
        if (chapter == null) return;
        // Always re-render so the "saved Xs ago" label ticks forward.
        if (!pageDirty || saving)
        {
            StateHasChanged();
            return;
        }
        if ((DateTime.UtcNow - lastEditAt).TotalMilliseconds < AutosaveIdleMs)
        {
            StateHasChanged();
            return;
        }
        await SaveChapter();
    }

    private async Task SaveChapter()
    {
        if (chapter == null || saving) return;
        saving = true;
        StateHasChanged();
        try
        {
            chapter.Title    = string.IsNullOrWhiteSpace(pageTitle) ? "Untitled" : pageTitle.Trim();
            chapter.Markdown = pageMarkdown ?? "";
            chapter.Html     = Md.RenderToHtml(chapter.Markdown);
            Chapters.SaveChapter(chapter);
            lastSavedAt = DateTime.UtcNow;
            pageDirty = false;
            try { await JS.InvokeVoidAsync("writeInterop.writer.localClear", chapter.Id); } catch { }
            await SyncDirty(false);
        }
        finally
        {
            saving = false;
            StateHasChanged();
        }
    }

    private void RestoreLocal()
    {
        if (recoveredText is null) return;
        pageMarkdown = recoveredText;
        pageDirty = true;
        lastEditAt = DateTime.UtcNow;
        recoveryAvailable = false;
        recoveredText = null;
        _ = SyncDirty(true);
    }

    private async Task DismissRecovery()
    {
        recoveryAvailable = false;
        recoveredText = null;
        if (chapter != null)
        {
            try { await JS.InvokeVoidAsync("writeInterop.writer.localClear", chapter.Id); } catch { }
        }
    }

    // ── Outline jump ──
    private async Task JumpTo(int line)
    {
        if (readingMode) readingMode = false;
        StateHasChanged();
        await JS.InvokeVoidAsync("writeInterop.writer.scrollToLine", "write-surface", line);
    }

    // ── Find / Replace ──
    private record FindResult(int Start, int End);

    private async Task FindNext()
    {
        if (string.IsNullOrEmpty(findQuery)) return;
        FindResult? r = null;
        try { r = await JS.InvokeAsync<FindResult?>("writeInterop.writer.find",
            "write-surface", findQuery, findCursor, findCaseSensitive); }
        catch { }
        if (r != null) { findCursor = r.End; findStatus = "Found"; }
        else            { findCursor = 0;     findStatus = "Not found"; }
    }

    private async Task ReplaceNext()
    {
        if (string.IsNullOrEmpty(findQuery)) return;
        bool replaced = false;
        try { replaced = await JS.InvokeAsync<bool>("writeInterop.writer.replaceCurrent",
            "write-surface", findQuery, replaceQuery ?? "", findCaseSensitive); }
        catch { }
        if (replaced) findStatus = "Replaced";
        await FindNext();
    }

    private async Task ReplaceAll()
    {
        if (string.IsNullOrEmpty(findQuery)) return;
        int n = 0;
        try { n = await JS.InvokeAsync<int>("writeInterop.writer.replaceAll",
            "write-surface", findQuery, replaceQuery ?? "", findCaseSensitive); }
        catch { }
        findStatus = n > 0 ? $"Replaced {n}" : "No matches";
    }

    public async ValueTask DisposeAsync()
    {
        locationGuard?.Dispose();
        if (autosaveTimer != null)
        {
            await autosaveTimer.DisposeAsync();
            autosaveTimer = null;
        }
        try { await JS.InvokeVoidAsync("writeInterop.writer.uninstallBeforeUnload"); } catch { }
        try { await JS.InvokeVoidAsync("writeInterop.writer.setDirty", false); } catch { }
    }

    /// <summary>
    /// Best-effort recovery of markdown from chapters saved by the previous editor,
    /// which wrapped each line in &lt;p&gt; tags. Anything richer (e.g. raw &lt;strong&gt;
    /// in legacy HTML) is left in place for the writer to clean up by hand.
    /// </summary>
    private static string HtmlToMarkdownFallback(string html)
    {
        if (string.IsNullOrEmpty(html)) return "";
        var t = System.Text.RegularExpressions.Regex.Replace(html, @"<p>\s*</p>", "");
        t = System.Text.RegularExpressions.Regex.Replace(t, @"<p>(.*?)</p>", "$1\n\n",
            System.Text.RegularExpressions.RegexOptions.Singleline);
        return System.Net.WebUtility.HtmlDecode(t).Trim();
    }
}
