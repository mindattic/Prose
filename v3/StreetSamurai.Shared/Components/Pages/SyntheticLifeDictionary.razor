@page "/synthetics"
@using StreetSamurai.Core.Models.Canon
@inject SyntheticLifeRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="dict-layout">
    <div class="dict-list">
        <div class="card bg-dark text-light border-secondary mb-2 card-body">
            <FilterBar AllTags="allTags" @bind-Filter="filter" SelectedTags="selectedTags" SelectedTagsChanged="OnTagsChanged" />

        </div>
        <div class="dict-items">
            @foreach (var s in PagedItems)
            {
                <div class="list-item text-light @(editing?.Name == s.Name ? "active" : "")" @onclick="() => Edit(s)">
                    <div class="fw-bold small">@s.Name</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@s.Classification</div>
                </div>
            }
        </div>
        <PaginationBar CurrentPage="currentPage" TotalPages="TotalPages" OnPageChanged="p => currentPage = p" />
    </div>

    <div class="dict-editor">
        @if (editing != null)
        {
            <EditViewToggle RepoName="synthetics" Title="@(isNew ? "New Synthetic Life" : editing.Name)" Json="@System.Text.Json.JsonSerializer.Serialize(editing)" HideToggle="@_confirmDelete">
                <HeaderButtons>
                    @if (!_confirmDelete)
                    {
                        <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i><div class="btn-lbl"> Save</div></button>
                        @if (!isNew) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-archive"></i></button> }
                    }
                    else
                    {
                        <span class="small text-muted me-1">Archive Entry?</span>
                        <button class="btn btn-sm btn-danger" @onclick="DoDelete"><div class="btn-lbl">Yes</div></button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false"><div class="btn-lbl">No</div></button>
                    }
                </HeaderButtons>
                <ChildContent>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <div style="flex: 2; min-width: 200px;"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Name" /></div>
                        <div style="flex: 1; min-width: 120px;"><div class="field-label">Classification</div>
                            <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="editing.Classification">
                                <option value="E.L.F. (Electronic Life Form)">E.L.F.</option>
                                <option value="Rogue AI — Fragment">Fragment</option>
                                <option value="Rogue AI — Stray">Stray</option>
                                <option value="Rogue AI — Prowler">Prowler</option>
                                <option value="Rogue AI — Leviathan">Leviathan</option>
                                <option value="Supermind">Supermind</option>
                            </select>
                        </div>
                        <div style="flex: 1; min-width: 100px;"><div class="field-label">Status</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Status" /></div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <div style="flex: 1; min-width: 120px;"><div class="field-label">Disposition</div>
                            <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="editing.Disposition">
                                <option value="brownie">Brownie</option>
                                <option value="gremlin">Gremlin</option>
                                <option value="trickster">Trickster</option>
                                <option value="echo">Echo</option>
                                <option value="wisp">Wisp</option>
                                <option value="predator">Predator</option>
                                <option value="neutral">Neutral</option>
                            </select>
                        </div>
                        <div style="flex: 1; min-width: 120px;"><div class="field-label">Habitat</div>
                            <select class="form-select form-select-sm bg-dark text-light border-secondary" @bind="editing.Habitat">
                                <option value="chrome_dweller">Chrome Dweller</option>
                                <option value="network_sprite">Network Sprite</option>
                                <option value="wallet_whisper">Wallet Whisper</option>
                                <option value="threshold_keeper">Threshold Keeper</option>
                                <option value="void_swimmer">Void Swimmer</option>
                                <option value="distributed">Distributed</option>
                            </select>
                        </div>
                        <div style="flex: 1; min-width: 120px;"><div class="field-label">Origin</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Origin" /></div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <div style="flex: 1; min-width: 100px;"><div class="field-label">DTI Rating</div><input type="number" step="0.1" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.DtiRating" /></div>
                        <div style="flex: 1; min-width: 100px;"><div class="field-label">Encounter Frequency</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.EncounterFrequency" /></div>
                        <div style="flex: 1; min-width: 100px;"><div class="field-label">Confirmed Sightings</div><input type="number" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.ConfirmedSightings" /></div>
                    </div>
                    <div class="mb-3"><div class="field-label">Location</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Location" /></div>
                    <div class="mb-3"><div class="field-label">Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="4" @bind="editing.Description"></textarea></div>
                    <div class="mb-3"><div class="field-label">Observed Behavior</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="3" @bind="editing.ObservedBehavior"></textarea></div>
                </ChildContent>
            </EditViewToggle>
        }
        else
        {
            <div class="text-center text-muted py-5"><i class="bi bi-cpu" style="font-size:3rem;"></i><p class="mt-2">Select a synthetic life form or create a new one.</p></div>
        }
    </div>
</div>

@code {
    private List<SyntheticLifeData> items = [];
    private SyntheticLifeData? editing;
    private string originalName = "";
    private string filter = "";
    private List<(string name, int count)> allTags = [];
    private HashSet<string> selectedTags = [];
    private bool isNew, _confirmDelete;

    private IEnumerable<SyntheticLifeData> FilteredItems
    {
        get
        {
            IEnumerable<SyntheticLifeData> result = items;
            if (!string.IsNullOrWhiteSpace(filter))
                result = result.Where(s => s.Name.Contains(filter, StringComparison.OrdinalIgnoreCase));
            if (selectedTags.Count > 0)
                result = result.Where(s => selectedTags.All(t => s.Tags.Contains(t)));
            return result;
        }
    }
    private int currentPage = 1;
    private const int PageSize = 100;
    private IEnumerable<SyntheticLifeData> PagedItems { get { var f = FilteredItems.ToList(); var mp = Math.Max(1, (int)Math.Ceiling(f.Count / (double)PageSize)); if (currentPage > mp) currentPage = mp; return f.Skip((currentPage - 1) * PageSize).Take(PageSize); } }
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredItems.Count() / PageSize));

    protected override void OnInitialized() { Repo.Reload(); items = Repo.GetAll(); RebuildTags(); if (Nav.Uri.Contains("new=true")) AddNew(); else { var qid = Nav.Uri.Contains("id=") ? Uri.UnescapeDataString(Nav.Uri.Split(new[]{"id="}, StringSplitOptions.None).Last().Split(new[]{"&"}, StringSplitOptions.None)[0]) : ""; if (!string.IsNullOrEmpty(qid)) { var t = items.FirstOrDefault(e => e.Id == qid); if (t != null) Edit(t); } if (editing == null) { var first = items.FirstOrDefault(); if (first != null) Edit(first); } } }
    private void AddNew() { editing = new SyntheticLifeData(); isNew = true; _confirmDelete = false; }
    private void Edit(SyntheticLifeData s) { _ = JS.InvokeVoidAsync("localStorage.setItem", "ss_sel_synthetics", s.Id); editing = s; originalName = s.Name; isNew = false; _confirmDelete = false; }
    private void SaveEdit() { if (editing == null || string.IsNullOrWhiteSpace(editing.Name)) return; if (!isNew && originalName != editing.Name) Repo.Delete(originalName); Repo.Save(editing); editing = null; items = Repo.GetAll(); }
    private void DoDelete() { if (editing != null) { Repo.Delete(editing.Name); editing = null; items = Repo.GetAll(); _confirmDelete = false; } }
    private void RebuildTags() { allTags = items.SelectMany(x => x.Tags).GroupBy(t => t).Select(g => (g.Key, g.Count())).OrderBy(t => t.Key).ToList(); }
    private void OnTagsChanged(HashSet<string> tags) { selectedTags = tags; }
    private List<(string name, string json)> GetExportEntries() => items.Select(e => (e.Name, System.Text.Json.JsonSerializer.Serialize(e))).ToList();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("writeInterop.autoResizeAll");
        if (firstRender && !Nav.Uri.Contains("new=true") && !Nav.Uri.Contains("id=") && items.Count > 0)
        {
            var lastId = "";
            try { lastId = await JS.InvokeAsync<string>("localStorage.getItem", "ss_sel_synthetics") ?? ""; } catch { }
            if (!string.IsNullOrEmpty(lastId))
            {
                var target = items.FirstOrDefault(x => x.Id == lastId);
                if (target != null) { Edit(target); StateHasChanged(); }
            }
        }
    }

}
