@page "/entertainment"
@inject EntertainmentRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject WorldGraphService Graph

<h4 class="text-danger mb-3">Entertainment</h4>
<div class="dict-layout">
    <div class="dict-list">
        <div class="card bg-dark text-light border-secondary mb-2 card-body">
            <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary mb-2"
                   placeholder="Filter..." @bind="filter" @bind:event="oninput" />
            <div class="mb-2">
                <TagFilter AllTags="allTags" SelectedTags="selectedTags" SelectedTagsChanged="OnTagsChanged" />
            </div>
            <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-danger" style="width:calc(50% - 5px)" @onclick="AddNew"><i class="bi bi-plus-lg"></i> New</button>
            </div>
        </div>
        <div class="dict-items">
            @foreach (var e in PagedItems)
            {
                <div class="list-item text-light @(editing?.Name == e.Name ? "active" : "")" @onclick="() => Edit(e)">
                    <div class="fw-bold small">@e.Name</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@e.Category — @e.Genre</div>
                </div>
            }
        </div>
        <PaginationBar CurrentPage="currentPage" TotalPages="TotalPages" OnPageChanged="p => currentPage = p" />
    </div>

    <div class="dict-editor">
        @if (editing != null)
        {
            <EditViewToggle RepoName="entertainment" Title="@(isNew ? "New Entry" : editing.Name)" Json="@System.Text.Json.JsonSerializer.Serialize(editing)">
                <HeaderButtons>
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i> Save</button>
                    @if (!isNew && !_confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-archive"></i></button> }
                    @if (_confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete">Confirm</button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false">No</button> }
                </HeaderButtons>
                <ChildContent>
                    <div class="row g-3 mb-3">
                        <div class="col-3"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Name" /></div>
                        <div class="col-3"><div class="field-label">Category</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Category" /></div>
                        <div class="col-3"><div class="field-label">Genre</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Genre" /></div>
                        <div class="col-3"><div class="field-label">Medium</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Medium" /></div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-3"><div class="field-label">Creator</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Creator" /></div>
                        <div class="col-3"><div class="field-label">Distributor</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Distributor" /></div>
                        <div class="col-3"><div class="field-label">Tier</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.TierAvailability" /></div>
                        <div class="col-3"><div class="field-label">Legality</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Legality" /></div>
                    </div>
                    <div class="mb-3"><div class="field-label">Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.Description"></textarea></div>
                    <div class="mb-3"><div class="field-label">Cultural Impact</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.CulturalImpact"></textarea></div>
                </ChildContent>
            </EditViewToggle>
        }
        else { <div class="text-muted d-flex align-items-center justify-content-center h-100">Select an entry or create a new one</div> }
    </div>
</div>

@code {
    private List<EntertainmentData> items = [];
    private EntertainmentData? editing;
    private bool isNew, _confirmDelete;
    private string originalName = "";
    private string filter = "";
    private List<(string name, int count)> allTags = [];
    private HashSet<string> selectedTags = [];

    private IEnumerable<EntertainmentData> FilteredItems
    {
        get
        {
            IEnumerable<EntertainmentData> result = items;
            if (!string.IsNullOrWhiteSpace(filter))
                result = result.Where(e => e.Name.Contains(filter, StringComparison.OrdinalIgnoreCase));
            if (selectedTags.Count > 0)
                result = result.Where(e => selectedTags.All(tag => e.Tags.Contains(tag)));
            return result;
        }
    }
    private int currentPage = 1;
    private const int PageSize = 100;
    private IEnumerable<EntertainmentData> PagedItems { get { var f = FilteredItems.ToList(); var mp = Math.Max(1, (int)Math.Ceiling(f.Count / (double)PageSize)); if (currentPage > mp) currentPage = mp; return f.Skip((currentPage - 1) * PageSize).Take(PageSize); } }
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredItems.Count() / PageSize));

    protected override void OnInitialized() { Repo.Reload(); items = Repo.GetAll(); RebuildTags(); if (Nav.Uri.Contains("new=true")) AddNew(); else { var qid = Nav.Uri.Contains("id=") ? Uri.UnescapeDataString(Nav.Uri.Split(new[]{"id="}, StringSplitOptions.None).Last().Split(new[]{"&"}, StringSplitOptions.None)[0]) : ""; if (!string.IsNullOrEmpty(qid)) { var t = items.FirstOrDefault(e => e.Id == qid); if (t != null) Edit(t); } } }
    private void RebuildTags() { allTags = items.SelectMany(e => e.Tags).GroupBy(t => t).Select(g => (g.Key, g.Count())).OrderBy(t => t.Key).ToList(); }
    private void OnTagsChanged(HashSet<string> tags) { selectedTags = tags; }
    private void AddNew() { editing = new EntertainmentData(); isNew = true; _confirmDelete = false; }
    private void Edit(EntertainmentData e) { editing = e; originalName = e.Name; isNew = false; _confirmDelete = false; }
    private void SaveEdit()
    {
        if (editing == null || string.IsNullOrWhiteSpace(editing.Name)) return;
        if (!isNew && originalName != editing.Name) Repo.Delete(originalName);
        Repo.Save(editing); editing = null; items = Repo.GetAll(); RebuildTags();
    }
    private void DoDelete() { if (editing == null) return; Graph.RemoveNode(editing.Name); Repo.Delete(editing.Name); editing = null; _confirmDelete = false; items = Repo.GetAll(); RebuildTags(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { await JS.InvokeVoidAsync("writeInterop.autoResizeAll"); }
    private List<(string name, string json)> GetExportEntries() => items.Select(e => (e.Name, System.Text.Json.JsonSerializer.Serialize(e))).ToList();
}
