@page "/"
@inject CanonService Canon
@inject WorldGraphService Graph
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@inject IStoryBlockRepository StoryRepo
@inject FacetService FacetSvc
@inject ILlmService Llm
@inject ITtsService Tts

<h3 class="text-danger mb-1">Street Samurai — Canon Engine</h3>
<p class="text-muted mb-3">Story authoring platform for the StreetSamurai cyberpunk universe. Browse worldbuilding, generate AI-driven scenes, and write canon fiction.</p>

@* ── Stat Cards ─────────────────────────────────────── *@
<div class="row g-3">
    <div class="col-md-2">
        <div class="card bg-dark text-light border-secondary" title="Markdown and YAML files in the worldbuilding directory">
            <div class="card-body text-center">
                <h6 class="card-title text-muted small">Canon Vault</h6>
                <p class="display-6 mb-0">@_docCount</p>
                <small class="text-muted">documents</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-dark text-light border-secondary" title="Sovereign corporate entities parsed from worldbuilding">
            <div class="card-body text-center">
                <h6 class="card-title text-muted small">Corponations</h6>
                <p class="display-6 mb-0">@_corpCount</p>
                <small class="text-muted">entities</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-dark text-light border-secondary" title="Character YAML profiles with facet weights and relationships">
            <div class="card-body text-center">
                <h6 class="card-title text-muted small">Characters</h6>
                <p class="display-6 mb-0">@_charCount</p>
                <small class="text-muted">profiles</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-dark text-light border-secondary" title="QuikGraph relationship network — entities and their connections">
            <div class="card-body text-center">
                <h6 class="card-title text-muted small">World Graph</h6>
                <p class="display-6 mb-0">@_nodeCount</p>
                <small class="text-muted">@_edgeCount edges</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-dark text-light border-secondary" title="Character psychology engine — wound, ideal, id, shadow, mask, ghost">
            <div class="card-body text-center">
                <h6 class="card-title text-muted small">Facets</h6>
                <p class="display-6 mb-0">@_facetCount</p>
                <small class="text-muted">loaded</small>
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card bg-dark text-light border-secondary" title="External services — green means configured and ready">
            <div class="card-body text-center">
                <h6 class="card-title text-muted small">Systems</h6>
                <div class="d-flex justify-content-center gap-1 mt-1">
                    <span class="badge @(_llmReady ? "bg-success" : "bg-secondary")" title="LLM: AI text generation (Claude/OpenAI)">LLM</span>
                    <span class="badge @(_ttsReady ? "bg-success" : "bg-secondary")" title="TTS: Text-to-speech narration (ElevenLabs)">TTS</span>
                </div>
            </div>
        </div>
    </div>
</div>

@* ── Quick Actions ──────────────────────────────────── *@
<div class="d-flex gap-2 mt-3 mb-3">
    <a href="write" class="btn btn-sm btn-danger"><i class="bi bi-pen"></i> Story Editor</a>
    <a href="graph" class="btn btn-sm btn-outline-info"><i class="bi bi-diagram-3"></i> World Graph</a>
    <a href="search" class="btn btn-sm btn-outline-secondary"><i class="bi bi-search"></i> Search Canon</a>
</div>

<div class="row g-3">
    @* ── Stories ────────────────────────────────────────── *@
    <div class="col-md-4">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted d-flex justify-content-between align-items-center">
                Stories
                <a href="stories" class="text-info small text-decoration-none">View all</a>
            </div>
            <div class="card-body">
                @if (_stories.Any())
                {
                    @foreach (var s in _stories.Take(6))
                    {
                        <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                            <a href="write/@s.Id" class="text-light text-decoration-none small fst-italic">@s.Title</a>
                            <span class="badge bg-secondary" style="font-size: 0.6rem;">@s.Status</span>
                        </div>
                    }
                }
                else
                {
                    <small class="text-muted">No stories yet. <a href="write" class="text-info">Write one.</a></small>
                }
            </div>
        </div>
    </div>

    @* ── Quick Search ──────────────────────────────────── *@
    <div class="col-md-4">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted">Quick Search</div>
            <div class="card-body">
                <div class="input-group">
                    <input type="text" class="form-control bg-dark text-light border-secondary"
                           placeholder="Search canon..." @bind="_searchQuery" @bind:event="oninput"
                           @onkeydown="HandleSearchKey" />
                    <button class="btn btn-outline-danger" @onclick="DoSearch">Search</button>
                </div>
                @if (_searchResults.Any())
                {
                    <div class="mt-3">
                        @foreach (var r in _searchResults.Take(5))
                        {
                            <div class="border-bottom border-secondary py-2">
                                <small class="text-muted">@r.FileName:@r.LineNumber</small>
                                @if (!string.IsNullOrEmpty(r.Heading))
                                {
                                    <small class="text-info"> > @r.Heading</small>
                                }
                                <div class="small mt-1" style="white-space: pre-wrap;">@r.Context</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Most Connected / Canon Docs ──────────────────── *@
    <div class="col-md-4">
        <div class="card bg-dark text-light border-secondary mb-3">
            <div class="card-header text-muted">Most Connected Entities</div>
            <div class="card-body">
                @foreach (var (node, count) in _topConnected)
                {
                    <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                        <a href="graph" class="text-light text-decoration-none small">@node.Name</a>
                        <span class="badge bg-danger rounded-pill">@count</span>
                    </div>
                }
            </div>
        </div>

        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted d-flex justify-content-between align-items-center">
                Recent Documents
                <a href="documents" class="text-info small text-decoration-none">Browse</a>
            </div>
            <div class="card-body">
                @foreach (var doc in _recentDocs)
                {
                    <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                        <a href="documents/@doc.FileName" class="text-light text-decoration-none small">@doc.FileName</a>
                        <small class="text-muted">@doc.LineCount lines</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private int _docCount, _corpCount, _charCount, _nodeCount, _edgeCount, _facetCount;
    private bool _llmReady, _ttsReady;
    private string _searchQuery = "";
    private List<SearchResult> _searchResults = [];
    private List<CanonDocument> _recentDocs = [];
    private List<StoryProject> _stories = [];
    private List<(WorldNode node, int count)> _topConnected = [];

    protected override async Task OnInitializedAsync()
    {
        var docs = Canon.ListDocuments();
        _docCount = docs.Count;
        _corpCount = Canon.ListCorponations().Count;
        _charCount = Canon.ListCharacters().Count;
        _recentDocs = docs.OrderByDescending(d => d.LineCount).Take(6).ToList();

        Graph.EnsureLoaded();
        _nodeCount = Graph.NodeCount;
        _edgeCount = Graph.EdgeCount;

        _facetCount = FacetSvc.LoadAllFacets().Count;
        _stories = StoryRepo.ListProjects();

        _llmReady = await Llm.IsConfiguredAsync();
        _ttsReady = await Tts.IsConfiguredAsync();

        // Top connected entities
        var allNodes = Graph.AllNodes();
        _topConnected = allNodes
            .Select(n => (node: n, count: Graph.GetAllEdges(n.Id).Count))
            .Where(x => x.count > 0)
            .OrderByDescending(x => x.count)
            .Take(6)
            .ToList();
    }

    private void DoSearch()
    {
        if (!string.IsNullOrWhiteSpace(_searchQuery))
            _searchResults = Canon.Search(_searchQuery, 5);
    }

    private void HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") DoSearch();
    }
}
