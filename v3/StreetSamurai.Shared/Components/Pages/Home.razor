@page "/"
@inject IWriteAccessProvider Access

@* CyberSpace animated background removed 2026-06-15 — plain dark mode (universe-neutral shell). *@

<div class="home-wrapper">
    <div class="home-content">

        @* ── Two-tab interface: Writing (default) + Repositories ─── *@
        <ul class="nav nav-tabs home-tabs mb-3" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "writing" ? "active" : "")"
                        type="button" role="tab"
                        @onclick='() => activeTab = "writing"'>
                    <i class="bi bi-pencil-square me-2"></i>Writing
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(activeTab == "repos" ? "active" : "")"
                        type="button" role="tab"
                        @onclick='() => activeTab = "repos"'>
                    <i class="bi bi-grid me-2"></i>Repositories
                </button>
            </li>
        </ul>

        @if (activeTab == "writing")
        {
            <div class="home-writing-tab">
                @* ── Primary CTA: open the writer ───────────── *@
                <div class="home-writing-hero mb-4">
                    <a href="/write" class="home-write-cta btn btn-danger btn-lg">
                        <i class="bi bi-pencil-square me-2"></i>Open Writer
                    </a>
                    <a href="/strands" class="home-strands-cta btn btn-outline-secondary btn-lg ms-2">
                        <i class="bi bi-collection me-2"></i>Browse Strands
                    </a>
                </div>

                @* ── Quick-access writing tools ─────────────── *@
                <div class="home-writing-grid">
                    <a href="/strands" class="home-writing-card">
                        <i class="bi bi-collection home-writing-card-icon"></i>
                        <div class="home-writing-card-name">Strands</div>
                        <div class="home-writing-card-desc">All stories, chapters, episodes, scenes — one schema.</div>
                    </a>
                    <a href="/books" class="home-writing-card">
                        <i class="bi bi-book home-writing-card-icon"></i>
                        <div class="home-writing-card-name">Bookshelf</div>
                        <div class="home-writing-card-desc">Collect strands into books; export chapters to docx.</div>
                    </a>
                    <a href="/series" class="home-writing-card">
                        <i class="bi bi-journals home-writing-card-icon"></i>
                        <div class="home-writing-card-name">Series</div>
                        <div class="home-writing-card-desc">Group books into multi-book arcs and series outlines.</div>
                    </a>
                    @if (Access.IsContributor)
                    {
                        <a href="/continuity" class="home-writing-card">
                            <i class="bi bi-database-check home-writing-card-icon"></i>
                            <div class="home-writing-card-name">Continuity</div>
                            <div class="home-writing-card-desc">Atomic-claim store; surface and resolve contradictions.</div>
                        </a>
                    }
                    <a href="/findings" class="home-writing-card">
                        <i class="bi bi-inbox home-writing-card-icon"></i>
                        <div class="home-writing-card-name">Findings</div>
                        <div class="home-writing-card-desc">Quality findings and continuity issues to resolve.</div>
                    </a>
                    <a href="/ask" class="home-writing-card">
                        <i class="bi bi-chat-dots home-writing-card-icon"></i>
                        <div class="home-writing-card-name">Ask</div>
                        <div class="home-writing-card-desc">Natural-language questions against live canon prose.</div>
                    </a>
                </div>
            </div>
        }
        else
        {
            <CategoryTiles />
        }

    </div>
</div>

@code {
    private string activeTab = "writing";
}
