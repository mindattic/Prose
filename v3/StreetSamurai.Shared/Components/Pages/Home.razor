@page "/"
@inject LoreService Canon
@inject WorldGraphService Graph
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@inject IStoryBlockRepository StoryRepo
@inject FacetService FacetSvc
@inject ILlmService Llm
@inject ITtsService Tts
@inject TriviaService TriviaSvc

<h3 class="text-danger mb-1">Dashboard</h3>
<p class="text-muted mb-3">Story authoring platform for the StreetSamurai cyberpunk universe. Browse worldbuilding, generate AI-driven scenes, and write canon fiction.</p>


<div class="row g-3 mt-2">
    @* ── Stories ────────────────────────────────────────── *@
    <div class="col-md-4">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted d-flex justify-content-between align-items-center">
                Stories
                <a href="stories" class="text-info small text-decoration-none">View all</a>
            </div>
            <div class="card-body">
                @if (stories.Any())
                {
                    @foreach (var s in stories.Take(6))
                    {
                        <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                            <a href="write/@s.Id" class="text-light text-decoration-none small fst-italic">@s.Title</a>
                            <span class="badge bg-secondary" style="font-size: 0.6rem;">@s.Status</span>
                        </div>
                    }
                }
                else
                {
                    <small class="text-muted">No stories yet. <a href="write" class="text-info">Write one.</a></small>
                }
            </div>
        </div>
    </div>

    @* ── Quick Search ──────────────────────────────────── *@
    <div class="col-md-4">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted">Quick Search</div>
            <div class="card-body">
                <div class="input-group">
                    <input type="text" class="form-control bg-dark text-light border-secondary"
                           placeholder="Search canon..." @bind="searchQuery" @bind:event="oninput"
                           @onkeydown="HandleSearchKey" style="height: 32px;" />
                    <button class="btn btn-outline-danger" @onclick="DoSearch" style="height: 32px;">Search</button>
                </div>
                @if (searchResults.Any())
                {
                    <div class="mt-3">
                        @foreach (var r in searchResults.Take(8))
                        {
                            <a href="@r.Route" class="d-block text-decoration-none border-bottom border-secondary py-2" style="cursor: pointer;">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge @TypeBadge(r.EntityType)">@r.EntityType</span>
                                    <span class="text-light fw-bold small">@(string.IsNullOrEmpty(r.EntityName) ? r.FileName : r.EntityName)</span>
                                </div>
                                @if (!string.IsNullOrEmpty(r.Heading))
                                {
                                    <small class="text-info">@r.Heading</small>
                                }
                                <div class="text-muted small mt-1" style="white-space: pre-wrap; max-height: 3em; overflow: hidden;">@r.Context</div>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Most Connected / Canon Docs ──────────────────── *@
    <div class="col-md-4">
        <div class="card bg-dark text-light border-secondary mb-3">
            <div class="card-header text-muted">Most Connected Entities</div>
            <div class="card-body">
                @foreach (var (node, count) in _topConnected)
                {
                    <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                        <a href="graph" class="text-light text-decoration-none small">@node.Name</a>
                        <span class="badge bg-danger rounded-pill">@count</span>
                    </div>
                }
                @if (orphanCount > 0)
                {
                    <div class="d-flex justify-content-between py-1 mt-1">
                        <small class="text-muted">Orphaned Nodes</small>
                        <span class="badge bg-secondary rounded-pill">@orphanCount</span>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Trivia Ticker ─────────────────────────────────── *@
    <div class="col-md-4">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <small class="text-muted"><i class="bi bi-lightbulb text-warning"></i> DID YOU KNOW? <span style="opacity:0.5;">@(triviaPos + 1)/@triviaRing.Length</span></small>
                    <div class="d-flex gap-1">
                        <button class="btn btn-outline-secondary tb" @onclick="PrevTrivia" title="Previous"><i class="bi bi-chevron-left"></i></button>
                        <button class="btn btn-outline-secondary tb" @onclick="NextTrivia" title="Next"><i class="bi bi-chevron-right"></i></button>
                    </div>
                </div>
                <div class="small text-light">@GetCurrentTrivia()</div>
            </div>
        </div>
    </div>
</div>

@code {
    private int docCount, _corpCount, _charCount, _nodeCount, _edgeCount, _facetCount;
    private bool llmReady, _ttsReady;
    private string searchQuery = "";
    private List<SearchResult> searchResults = [];
    private List<StoryProject> stories = [];
    private List<(WorldNode node, int count)> _topConnected = [];
    private int orphanCount;

    protected override async Task OnInitializedAsync()
    {
        var docs = Canon.ListDocuments();
        docCount = docs.Count;
        _corpCount = Canon.ListCorponations().Count;
        _charCount = Canon.ListCharacters().Count;

        Graph.EnsureLoaded();
        _nodeCount = Graph.NodeCount;
        _edgeCount = Graph.EdgeCount;

        _facetCount = FacetSvc.LoadAllFacets().Count;
        stories = StoryRepo.ListProjects();

        triviaRing = TriviaSvc.GetFacts();
        llmReady = await Llm.IsConfiguredAsync();
        _ttsReady = await Tts.IsConfiguredAsync();

        // Top connected entities
        var allNodes = Graph.AllNodes();
        _topConnected = allNodes
            .Where(n => !string.IsNullOrWhiteSpace(n.Id) && !string.IsNullOrWhiteSpace(n.Name))
            .Select(n => (node: n, count: Graph.GetAllEdges(n.Id).Count))
            .Where(x => x.count > 0)
            .OrderByDescending(x => x.count)
            .Take(6)
            .ToList();
        orphanCount = allNodes.Count(n => string.IsNullOrWhiteSpace(n.Id) || string.IsNullOrWhiteSpace(n.Name)
            || Graph.GetAllEdges(n.Id).Count == 0);
    }

    private void DoSearch()
    {
        if (!string.IsNullOrWhiteSpace(searchQuery))
            searchResults = Canon.Search(searchQuery, 8);
    }

    private void HandleSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") DoSearch();
    }

    private string[] triviaRing = [];
    private int triviaPos;

    private string GetCurrentTrivia() => triviaRing.Length > 0 ? triviaRing[triviaPos] : Constants.Defaults.Loading;

    private void NextTrivia() { if (triviaRing.Length > 0) triviaPos = (triviaPos + 1) % triviaRing.Length; }

    private void PrevTrivia() { if (triviaRing.Length > 0) triviaPos = (triviaPos - 1 + triviaRing.Length) % triviaRing.Length; }

    private static string TypeBadge(string type) => Constants.TypeBadge.For(type);
}
