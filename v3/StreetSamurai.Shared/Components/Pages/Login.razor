@page "/login"
@inject IWriteAccessProvider Access
@inject NavigationManager Nav

<div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="card bg-dark text-light border-secondary" style="width: 360px;">
        <div class="card-header text-danger fw-bold">
            <i class="bi bi-shield-lock"></i> Sign In
        </div>
        <div class="card-body">
            @if (Access.IsReadOnlyMode)
            {
                <p class="text-muted">Authentication is disabled in this deployment.</p>
                <a href="/" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
            }
            else
            {
                @* UserLogin (MindAttic.UiUx) styles the library MaLogin static-SSR form; its default
                   dark/red palette is on-theme. Posts to /_ma-auth/login; failure -> /login?error=1. *@
                <UserLogin ReturnUrl="/" Error="@hasError" />
            }
        </div>
    </div>
</div>

@code {
    private bool hasError;

    protected override void OnInitialized()
    {
        // The MindAttic.Authentication login endpoint redirects to /login?error=1 on failure.
        var uri = new Uri(Nav.Uri);
        hasError = uri.Query.Contains("error=1");
    }
}
