@page "/ask"
@using Microsoft.Extensions.Logging
@inject AskService AskSvc
@inject NavigationManager Nav
@inject ILogger<Ask> Log

<PageTitle>Ask Canon</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-question-circle"></i> Ask Canon</h4>
    <span class="text-muted small">Cloud RAG over the canonical entity corpus — embedding-retrieved context, LLM-grounded answer.</span>
</div>

<div class="mb-3">
    <textarea class="form-control bg-dark text-light border-secondary"
              rows="3"
              placeholder="Ask anything about the canon. Examples: 'Who broker information between CorpoNations?', 'What weapons does Kyle carry?', 'Where does Sasha train?'"
              @bind="question"
              @bind:event="oninput"
              @onkeydown="OnKeyDown"
              disabled="@asking"></textarea>
</div>

<div class="d-flex gap-2 align-items-center mb-3">
    <button class="btn btn-info" @onclick="AskNow" disabled="@(asking || string.IsNullOrWhiteSpace(question))">
        @if (asking) { <span class="spinner-border spinner-border-sm me-1"></span> <text>Asking…</text> }
        else { <i class="bi bi-search me-1"></i> <text>Ask</text> }
    </button>

    <div class="form-check form-check-inline ms-3 m-0">
        <input class="form-check-input" type="checkbox" id="onlyChars"
               checked="@charsOnly"
               @onchange="@(e => charsOnly = (bool)(e.Value ?? false))"
               disabled="@asking" />
        <label class="form-check-label small" for="onlyChars">Characters only</label>
    </div>

    <span class="text-muted small ms-2">Top-K context:
        <select class="form-select form-select-sm d-inline-block bg-dark text-light border-secondary" style="width:5rem;"
                @bind="topK" disabled="@asking">
            <option value="4">4</option>
            <option value="8">8</option>
            <option value="12">12</option>
            <option value="16">16</option>
        </select>
    </span>
</div>

@if (errorMessage != null)
{
    <div class="alert alert-danger small">@errorMessage</div>
}

@if (answer != null)
{
    <div class="card bg-dark text-light border-secondary mb-3">
        <div class="card-header text-muted d-flex justify-content-between">
            <span><i class="bi bi-chat-square-text me-1"></i> Answer</span>
            <span class="small">@answer.CorpusChunks chunks · @answer.Duration.TotalSeconds.ToString("F1")s</span>
        </div>
        <div class="card-body">
            <pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">@answer.Answer</pre>
        </div>
    </div>

    @if (answer.Citations.Count > 0)
    {
        <div class="card bg-dark text-light border-secondary">
            <div class="card-header text-muted">
                <i class="bi bi-link-45deg me-1"></i> Citations (semantic similarity, best-first)
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var c in answer.Citations)
                    {
                        <a class="btn btn-sm btn-outline-info" href="/entity/@c.EntityId">
                            @c.EntityName
                            <span class="badge bg-secondary ms-1">@c.EntityType</span>
                            <span class="text-muted small ms-1">@c.Similarity.ToString("F3")</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    }
}
else if (!asking)
{
    <div class="alert alert-secondary small">
        Type a question and press <kbd>Ctrl</kbd>+<kbd>Enter</kbd> (or click Ask). Answers are grounded in the
        canonical entity corpus via cloud embedding retrieval — the LLM sees only canon context, not the open web.
    </div>
}

@code {
    private string question = "";
    private int topK = 8;
    private bool charsOnly = false;
    private bool asking;
    private string? errorMessage;
    private AskService.AskAnswer? answer;

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)) await AskNow();
    }

    private async Task AskNow()
    {
        if (string.IsNullOrWhiteSpace(question) || asking) return;
        asking = true; errorMessage = null; answer = null;
        StateHasChanged();
        try
        {
            string[]? types = charsOnly ? new[] { "character" } : null;
            answer = await AskSvc.AnswerAsync(question, retrieveK: topK, entityTypes: types);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Ask page failed");
            errorMessage = ex.Message;
        }
        finally
        {
            asking = false;
            StateHasChanged();
        }
    }
}
