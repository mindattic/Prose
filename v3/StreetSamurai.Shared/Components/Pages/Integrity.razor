@page "/integrity"
@using Microsoft.Extensions.Logging
@inject DataConsistencyService Consistency
@inject ILogger<Integrity> Log

<PageTitle>Data Integrity</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-clipboard2-check"></i> Data Integrity</h4>
    <div class="d-flex gap-2 align-items-center">
        @if (running)
        {
            <span class="text-muted small">Scanning…</span>
        }
        else
        {
            <button class="btn btn-sm btn-outline-info" @onclick="RunScan">
                <i class="bi bi-arrow-clockwise"></i> Run scan
            </button>
        }
        @if (report != null && safeFixCodes.Count > 0)
        {
            <button class="btn btn-sm btn-outline-warning" @onclick="ApplyFixes" disabled="@running">
                <i class="bi bi-magic"></i> Apply @safeFixCodes.Count safe fix@(safeFixCodes.Count == 1 ? "" : "es")
            </button>
        }
    </div>
</div>

<p class="text-muted small mb-3">
    Audits SSOT drift across the SQL schema — slug collisions, missing canonical
    Records.Json blobs, dangling edges, bi-temporal hygiene on
    <code>EntityStateEvents</code>, and cross-FK type confusion. Findings are
    informational unless you press <em>Apply safe fixes</em>; ambiguous repairs
    (slug collision resolution, edge repointing) require a human.
</p>

@if (errorMessage != null)
{
    <div class="alert alert-danger small">@errorMessage</div>
}

@if (report == null)
{
    <div class="alert alert-secondary">No scan yet. Click <em>Run scan</em>.</div>
}
else
{
    var r = report;
    <div class="row g-2 mb-3">
        <div class="col-auto"><span class="badge bg-danger">@r.ErrorCount errors</span></div>
        <div class="col-auto"><span class="badge bg-warning text-dark">@r.WarnCount warnings</span></div>
        <div class="col-auto"><span class="badge bg-secondary">@r.InfoCount info</span></div>
        <div class="col-auto"><span class="badge bg-dark">@r.TotalDrift.ToString("N0") drift rows</span></div>
        <div class="col-auto"><span class="text-muted small">scanned @r.RanAtUtc.ToLocalTime().ToString("HH:mm:ss")</span></div>
    </div>

    @if (lastApplied is { Count: > 0 })
    {
        <div class="alert alert-success small">
            Applied:
            @foreach (var kv in lastApplied)
            {
                <span class="badge bg-success me-1">@kv.Key — @kv.Value rows</span>
            }
        </div>
    }

    <div class="table-responsive">
        <table class="table table-sm table-dark align-middle">
            <thead>
                <tr>
                    <th style="width:5rem;">Sev</th>
                    <th>Code / Title</th>
                    <th class="text-end" style="width:8rem;">Drift</th>
                    <th>Sample</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var f in r.Findings.OrderBy(f => SeverityRank(f.Severity)).ThenByDescending(f => f.DriftCount))
                {
                    <tr class="@RowClass(f.Severity)">
                        <td>
                            <span class="badge @SeverityBadge(f.Severity)">@f.Severity.ToUpper()</span>
                        </td>
                        <td>
                            <code class="text-info">@f.Code</code><br />
                            <strong>@f.Title</strong>
                            <div class="small text-muted">@f.Description</div>
                            @if (f.FixHint != null)
                            {
                                <div class="small text-warning"><i class="bi bi-wrench"></i> @f.FixHint</div>
                            }
                        </td>
                        <td class="text-end">
                            <span class="@(f.DriftCount > 0 ? "text-warning fw-semibold" : "text-muted")">
                                @f.DriftCount.ToString("N0")
                            </span>
                        </td>
                        <td>
                            @if (f.Samples.Count == 0)
                            {
                                <span class="text-muted small">—</span>
                            }
                            else
                            {
                                <ul class="list-unstyled mb-0 small">
                                    @foreach (var s in f.Samples)
                                    {
                                        <li><strong>@s.Label</strong> <span class="text-muted">@s.Detail</span></li>
                                    }
                                </ul>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private DataConsistencyService.ConsistencyReport? report;
    private Dictionary<string, int>? lastApplied;
    private bool running;
    private string? errorMessage;

    // Codes the deterministic auto-fixer knows how to repair.
    private static readonly HashSet<string> KnownSafeFixes =
        new(StringComparer.Ordinal)
        {
            "CHAR-HOMETURF-DRIFT",
            "ESE-MISSING-INWORLD-FROM",
            "ESE-DANGLING",
            "ESE-WINDOW-OVERLAP",
        };

    private List<string> safeFixCodes =>
        report?.Findings
            .Where(f => f.DriftCount > 0 && KnownSafeFixes.Contains(f.Code))
            .Select(f => f.Code)
            .ToList() ?? new();

    protected override async Task OnInitializedAsync() => await RunScan();

    private async Task RunScan()
    {
        running = true; errorMessage = null; lastApplied = null;
        try
        {
            report = await Consistency.RunAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Integrity scan failed");
            errorMessage = ex.Message;
        }
        finally
        {
            running = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFixes()
    {
        running = true; errorMessage = null;
        try
        {
            lastApplied = await Consistency.ApplyDeterministicFixesAsync(safeFixCodes);
            report = await Consistency.RunAsync();
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Apply-fixes failed");
            errorMessage = ex.Message;
        }
        finally
        {
            running = false;
            StateHasChanged();
        }
    }

    private static int SeverityRank(string s) => s switch
    {
        "error" => 0, "warn" => 1, _ => 2,
    };

    private static string SeverityBadge(string s) => s switch
    {
        "error" => "bg-danger",
        "warn"  => "bg-warning text-dark",
        _       => "bg-secondary",
    };

    private static string RowClass(string s) => s switch
    {
        "error" => "table-danger-subtle",
        _       => "",
    };
}
