@page "/stories/write/{ProjectId}"
@attribute [Authorize(Roles = "Contributor,Administrator")]
@using StreetSamurai.Core.Interfaces
@inject IChapterRepository Chapters
@inject NavigationManager Nav

@* Legacy route → /write surface. Anyone deep-linking to
   /stories/write/{ProjectId} now lands on /write/{BookId}/{ChapterId}. The
   old multi-tool page lives at /stories/write-legacy/{ProjectId} for
   one-off comparisons but is no longer the primary writer. *@

<div class="container py-3 small text-muted">
    <i class="bi bi-arrow-right-circle me-1"></i> Redirecting to the writer…
</div>

@code {
    [Parameter] public string ProjectId { get; set; } = "";

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        var chapter = Chapters.LoadChapter(ProjectId);
        if (chapter == null) { Nav.NavigateTo("/write", replace: true); return; }
        if (string.IsNullOrEmpty(chapter.BookId))
            Nav.NavigateTo("/write", replace: true);
        else
            Nav.NavigateTo($"/write/{chapter.BookId}/{chapter.Id}", replace: true);
    }
}
