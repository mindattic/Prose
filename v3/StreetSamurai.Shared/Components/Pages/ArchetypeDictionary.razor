@page "/archetypes"
@using StreetSamurai.Core.Models.Canon
@inject ArchetypeRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="dict-layout">
    <div class="dict-list">
        <div class="card bg-dark text-light border-secondary mb-2 card-body">
            <FilterBar AllTags="allTags" @bind-Filter="filter" SelectedTags="selectedTags" SelectedTagsChanged="OnTagsChanged" />

        </div>
        <div class="dict-items">
            @foreach (var a in SortedItems)
            {
                <div class="list-item text-light @(editing?.Name == a.Name ? "active" : "")" @onclick="() => Edit(a)">
                    <div class="fw-bold small">@a.Name</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@a.Category</div>
                </div>
            }
        </div>
    </div>
    <div class="dict-editor">
        @if (editing != null)
        {
            <EditViewToggle RepoName="archetypes" Title="@(isNew ? "New Archetype" : editing.Name)" Json="@System.Text.Json.JsonSerializer.Serialize(editing)">
                <HeaderButtons>
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i><div class="btn-lbl"> Save</div></button>
                    @if (!isNew && !confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmDelete = true"><i class="bi bi-archive"></i></button> }
                    @if (confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete"><div class="btn-lbl">Confirm</div></button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirmDelete = false"><div class="btn-lbl">No</div></button> }
                </HeaderButtons>
                <ChildContent>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <div style="flex: 2; min-width: 200px;"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Name" /></div>
                        <div style="flex: 1; min-width: 120px;"><div class="field-label">Category</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Category" /></div>
                    </div>
                    <div class="mb-3"><div class="field-label">Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="2" @bind="editing.Description"></textarea></div>
                    <div class="mb-3"><div class="field-label">Behavioral Signature</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="2" @bind="editing.BehavioralSignature"></textarea></div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <div style="flex: 1; min-width: 200px;"><div class="field-label">Under Stress</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="2" @bind="editing.UnderStress"></textarea></div>
                        <div style="flex: 1; min-width: 200px;"><div class="field-label">At Rest</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="2" @bind="editing.AtRest"></textarea></div>
                    </div>
                </ChildContent>
            </EditViewToggle>
        }
        else
        {
            <div class="text-center text-muted py-5"><i class="bi bi-person-bounding-box" style="font-size:3rem;"></i><p class="mt-2">Select an archetype or create a new one.</p></div>
        }
    </div>
</div>

@code {
    private List<ArchetypeData> items = [];
    private ArchetypeData? editing;
    private string originalName = "", filter = "";
    private List<(string name, int count)> allTags = [];
    private HashSet<string> selectedTags = [];
    private bool isNew, confirmDelete;
    private List<ArchetypeData> FilteredItems
    {
        get
        {
            IEnumerable<ArchetypeData> result = items;
            if (!string.IsNullOrWhiteSpace(filter))
                result = result.Where(a => a.Name.Contains(filter, StringComparison.OrdinalIgnoreCase));
            if (selectedTags.Count > 0)
                result = result.Where(a => selectedTags.All(t => a.Tags.Contains(t)));
            return result.ToList();
        }
    }
    private List<ArchetypeData> SortedItems => FilteredItems.OrderBy(x => x.Name).ToList();
    protected override void OnInitialized() { Repo.Reload(); items = Repo.GetAll(); RebuildTags(); if (Nav.Uri.Contains("new=true")) AddNew(); else { var qid = Nav.Uri.Contains("id=") ? Uri.UnescapeDataString(Nav.Uri.Split(new[]{"id="}, StringSplitOptions.None).Last().Split(new[]{"&"}, StringSplitOptions.None)[0]) : ""; if (!string.IsNullOrEmpty(qid)) { var t = items.FirstOrDefault(e => e.Id == qid); if (t != null) Edit(t); } if (editing == null) { var first = items.FirstOrDefault(); if (first != null) Edit(first); } } }
    private void AddNew() { editing = new ArchetypeData(); isNew = true; confirmDelete = false; }
    private void Edit(ArchetypeData a) { _ = JS.InvokeVoidAsync("localStorage.setItem", "ss_sel_archetypes", a.Id); editing = a; originalName = a.Name; isNew = false; confirmDelete = false; if (!Nav.Uri.Contains("id=" + a.Id)) Nav.NavigateTo(Nav.Uri.Split('?')[0] + "?id=" + a.Id, forceLoad: false); }
    private void SaveEdit() { if (editing == null || string.IsNullOrWhiteSpace(editing.Name)) return; if (!isNew && originalName != editing.Name) Repo.Delete(originalName); Repo.Save(editing); editing = null; items = Repo.GetAll(); }
    private void DoDelete() { if (editing != null) { Repo.Delete(editing.Name); editing = null; items = Repo.GetAll(); confirmDelete = false; } }
    private List<(string name, string json)> GetExportEntries() => items.Select(e => (e.Name, System.Text.Json.JsonSerializer.Serialize(e))).ToList();
    private void RebuildTags() { allTags = items.SelectMany(x => x.Tags).GroupBy(t => t).Select(g => (g.Key, g.Count())).OrderBy(t => t.Key).ToList(); }
    private void OnTagsChanged(HashSet<string> tags) { selectedTags = tags; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("writeInterop.autoResizeAll");
        if (firstRender && !Nav.Uri.Contains("new=true") && !Nav.Uri.Contains("id=") && items.Count > 0)
        {
            var lastId = "";
            try { lastId = await JS.InvokeAsync<string>("localStorage.getItem", "ss_sel_archetypes") ?? ""; } catch { }
            if (!string.IsNullOrEmpty(lastId))
            {
                var target = items.FirstOrDefault(x => x.Id == lastId);
                if (target != null) { Edit(target); StateHasChanged(); }
            }
        }
    }

}
