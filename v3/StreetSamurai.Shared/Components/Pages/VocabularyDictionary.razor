@page "/vocabulary"
@using StreetSamurai.Core.Models.Canon
@inject VocabularyRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="dict-layout">
    <div class="dict-list bg-dark border-end border-secondary">
        <div class="p-2">
            <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary"
                   placeholder="Filter..." @bind="_filter" @bind:event="oninput" />
        </div>
        @foreach (var v in FilteredItems)
        {
            <div class="list-item text-light @(_editing?.Term == v.Term ? "active" : "")" @onclick="() => Edit(v)">
                <div class="fw-bold small">@v.Term</div>
                <div class="text-muted" style="font-size: 0.7rem;">@v.Category</div>
            </div>
        }
        <div class="p-2">
            <button class="btn btn-sm btn-outline-danger w-100" @onclick="AddNew"><i class="bi bi-plus-lg"></i> New Term</button>
        </div>
    </div>

    <div class="dict-editor" style="overflow-y: auto; max-height: calc(100vh - 60px);">
        @if (_editing != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-danger mb-0">@(_isNew ? "New Term" : _editing.Term)</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i> Save</button>
                    @if (!_isNew && !_confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDelete = true"><i class="bi bi-trash3"></i></button> }
                    @if (_confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete">Confirm</button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDelete = false">No</button> }
                </div>
            </div>

            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 2; min-width: 200px;"><div class="field-label">Term</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Term" /></div>
                <div style="flex: 1; min-width: 120px;"><div class="field-label">Category</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Category" /></div>
                <div style="flex: 1; min-width: 100px;"><div class="field-label">Tier</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="_editing.Tier" /></div>
            </div>
            <div class="mb-3"><div class="field-label">Definition</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.Definition"></textarea></div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Origin</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.Origin"></textarea></div>
                <div style="flex: 1; min-width: 200px;"><div class="field-label">Usage</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.Usage"></textarea></div>
            </div>
            <div class="mb-3"><div class="field-label">Example</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="_editing.Example"></textarea></div>
        }
        else { <div class="text-muted d-flex align-items-center justify-content-center h-100">Select a term or create new</div> }
    </div>
</div>

@code {
    private List<VocabularyEntry> _items = [];
    private VocabularyEntry? _editing;
    private bool _isNew, _confirmDelete;
    private string _originalTerm = "";
    private string _filter = "";

    private IEnumerable<VocabularyEntry> FilteredItems => string.IsNullOrWhiteSpace(_filter)
        ? _items
        : _items.Where(v => v.Term.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || v.Definition.Contains(_filter, StringComparison.OrdinalIgnoreCase)
            || v.Category.Contains(_filter, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized() { Repo.Reload(); _items = Repo.GetAll(); if (Nav.Uri.Contains("new=true")) AddNew(); }
    private void AddNew() { _editing = new VocabularyEntry(); _isNew = true; _confirmDelete = false; }
    private void Edit(VocabularyEntry v) { _editing = v; _originalTerm = v.Term; _isNew = false; _confirmDelete = false; }
    private void SaveEdit() { if (_editing == null || string.IsNullOrWhiteSpace(_editing.Term)) return; if (!_isNew && _originalTerm != _editing.Term) Repo.Delete(_originalTerm); Repo.Save(_editing); _editing = null; _items = Repo.GetAll(); }
    private void DoDelete() { if (_editing == null) return; Repo.Delete(_editing.Term); _editing = null; _confirmDelete = false; _items = Repo.GetAll(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { await JS.InvokeVoidAsync("writeInterop.autoResizeAll"); }
}
