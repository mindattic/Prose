@page "/books/{BookId}/chapters"
@attribute [Authorize(Roles = "Contributor,Administrator")]
@using StreetSamurai.Core
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@inject IChapterRepository Repo
@inject IBookRepository BookRepo
@inject IBookReviewService ReviewSvc
@inject BookExportService ExportSvc
@inject MotifService MotifSvc
@inject DatabaseService CanonDb
@inject BookOutlineService OutlineSvc
@inject StoryDirectorService Director
@inject NavigationManager Nav
@inject SuggestionEngineService Suggestions
@inject CharacterRepository CharRepo
@inject DistrictRepository DistrictRepo
@inject SettingsService SettingsSvc
@implements IDisposable

@if (book == null)
{
    <div class="alert alert-danger">
        Book not found. <a href="/books">Back to bookshelf</a>
    </div>
}
else
{
    @* Always-on collaborative dialog. Persistent across edits — collapse if it's in the way. *@
    <CoWriter BookId="@BookId" />
    @* ── Book Header ──────────────────────────────── *@
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div class="flex-grow-1 me-3">
            <div class="small text-muted mb-1">
                <a href="/books" class="text-muted text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Bookshelf
                </a>
            </div>
            <h4 class="text-danger mb-0">@book.Title</h4>
            @if (!string.IsNullOrEmpty(book.Tagline))
            {
                <div class="text-warning fst-italic small">@book.Tagline</div>
            }
            @if (!string.IsNullOrEmpty(book.Premise))
            {
                <p class="text-muted small mb-1 mt-1">@book.Premise</p>
            }
            @if (book.Protagonists.Any())
            {
                <div class="small text-muted">
                    <i class="bi bi-people-fill me-1"></i>@string.Join(", ", book.Protagonists)
                </div>
            }
        </div>
        <div class="d-flex gap-2 align-items-center flex-wrap justify-content-end">
            <a href="@($"/books/{BookId}/outline")" class="btn btn-sm btn-outline-warning" title="Build / edit the book's outline (the plot every chapter shares)">
                <i class="bi bi-list-ol"></i><div class="btn-lbl"> Outline</div>
            </a>
            <button class="btn btn-sm btn-outline-info" @onclick="ToggleEditBook" title="Edit book metadata">
                <i class="bi bi-gear"></i>
            </button>
            <button class="btn btn-sm btn-outline-success" @onclick="OpenReview" disabled="@reviewing" title="Multi-LLM book review">
                <i class="bi bi-search-heart"></i><div class="btn-lbl"> Review</div>
                @if (PendingFindingsCount > 0)
                {
                    <span class="badge bg-danger ms-1">@PendingFindingsCount</span>
                }
            </button>
            <button class="btn btn-sm btn-outline-info" @onclick="OpenMotifs" title="Detect motif candidates / manage motif inventory">
                <i class="bi bi-tags"></i><div class="btn-lbl"> Motifs</div>
                @if (motifInventory != null && motifInventory.Motifs.Count > 0)
                {
                    <span class="badge bg-secondary ms-1">@motifInventory.Motifs.Count</span>
                }
            </button>
            <div class="btn-group btn-group-sm" role="group">
                <button class="btn btn-sm btn-outline-warning dropdown-toggle" data-bs-toggle="dropdown" title="Export / Publish">
                    <i class="bi bi-cloud-download"></i><div class="btn-lbl"> Publish</div>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                    <li><button class="dropdown-item" @onclick='() => Export("epub")'>
                        <i class="bi bi-book me-2"></i>EPUB <span class="text-muted small">(for Calibre → Kindle)</span></button></li>
                    <li><button class="dropdown-item" @onclick='() => Export("html")'>
                        <i class="bi bi-filetype-html me-2"></i>Standalone HTML</button></li>
                    <li><button class="dropdown-item" @onclick='() => Export("md")'>
                        <i class="bi bi-markdown me-2"></i>Markdown</button></li>
                </ul>
            </div>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleAbsorb" title="Absorb a loose chapter into this book">
                <i class="bi bi-box-arrow-in-down"></i><div class="btn-lbl"> Absorb</div>
            </button>
            <button class="btn btn-sm btn-outline-primary" @onclick="SurpriseMe"
                    disabled="@(generating || !OutlineApproved)"
                    title="@(OutlineApproved ? "Generate a chapter from the outline" : "Approve the outline first")">
                <i class="bi bi-lightning"></i><div class="btn-lbl"> Surprise Me</div>
            </button>
            <button class="btn btn-sm btn-outline-warning" @onclick="OpenGuideMe"
                    disabled="@(generating || !OutlineApproved)"
                    title="@(OutlineApproved ? "Generate a chapter with custom synopsis" : "Approve the outline first")">
                <i class="bi bi-compass"></i><div class="btn-lbl"> Guide Me</div>
            </button>
            <button class="btn btn-sm btn-outline-danger" @onclick="CreateNew">
                <i class="bi bi-plus-lg"></i><div class="btn-lbl"> New Chapter</div>
            </button>
        </div>
    </div>

    @* ── Outline Status Banner ──────────────────────────────── *@
    @if (!OutlineApproved)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center small mb-3">
            <div>
                <i class="bi bi-exclamation-triangle me-1"></i>
                <strong>Outline is @outlineStatus.</strong>
                Build the outline first — the Director uses it as the spine for every chapter.
                Generating prose against a draft outline produces incoherent chapters.
            </div>
            <a href="@($"/books/{BookId}/outline")" class="btn btn-sm btn-warning">
                <i class="bi bi-list-ol me-1"></i>Open Outline
            </a>
        </div>
    }

    @* ── Edit Book Metadata Modal ──────────────────────────────── *@
    @if (editBookOpen)
    {
        <div class="modal-backdrop fade show" style="z-index:1050;"></div>
        <div class="modal fade show d-block" tabindex="-1" style="z-index:1055;" @onclick="ToggleEditBook">
            <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content bg-dark text-light border-info">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title text-info"><i class="bi bi-gear me-2"></i>Edit Book</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="ToggleEditBook"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2">
                            <label class="form-label small text-info mb-1">Title</label>
                            <input class="form-control bg-black text-light border-secondary" @bind="book.Title" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-info mb-1">Tagline</label>
                            <input class="form-control bg-black text-light border-secondary" @bind="book.Tagline" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-info mb-1">Premise</label>
                            <textarea class="form-control bg-black text-light border-secondary" rows="3" @bind="book.Premise"></textarea>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-info mb-1">Arc target</label>
                            <input class="form-control bg-black text-light border-secondary" @bind="book.ArcTarget" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-info mb-1">Protagonists (comma-separated)</label>
                            <input class="form-control bg-black text-light border-secondary" @bind="protagonistsCsv" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-info mb-1">Status</label>
                            <select class="form-select bg-black text-light border-secondary" @bind="book.Status">
                                <option value="drafting">drafting</option>
                                <option value="review">review</option>
                                <option value="published">published</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button class="btn btn-secondary btn-sm" @onclick="ToggleEditBook">Cancel</button>
                        <button class="btn btn-info btn-sm" @onclick="SaveBookMeta">
                            <i class="bi bi-check-lg"></i> Save
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ── Book Review Panel ──────────────────────────────── *@
    @if (reviewOpen)
    {
        <div class="modal-backdrop fade show" style="z-index:1050;"></div>
        <div class="modal fade show d-block" tabindex="-1" style="z-index:1055;" @onclick="CloseReview">
            <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable" @onclick:stopPropagation="true">
                <div class="modal-content bg-dark text-light border-success">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title text-success">
                            <i class="bi bi-search-heart me-2"></i>Book Review
                            @if (review != null && review.VoterCount > 0)
                            {
                                <span class="text-muted small ms-2">@review.VoterCount voters · @review.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            }
                        </h5>
                        <div class="d-flex gap-2 align-items-center">
                            <button class="btn btn-sm btn-success" @onclick="StartReview" disabled="@reviewing">
                                @if (reviewing)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-clockwise me-1"></i>
                                }
                                @(review == null ? "Run Review" : "Re-review")
                            </button>
                            <button type="button" class="btn-close btn-close-white" @onclick="CloseReview"></button>
                        </div>
                    </div>
                    <div class="modal-body">
                        @if (reviewing)
                        {
                            <div class="alert alert-info small">@reviewProgress</div>
                        }
                        else if (review == null)
                        {
                            <div class="text-muted">
                                Click <strong>Run Review</strong> to ask every configured LLM to surface continuity gaps,
                                dropped motifs, and small in-chapter edits that thread a through-line across the book's
                                chapters. Multi-voter aggregation keeps single-model hallucinations out.
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(review.Error))
                        {
                            <div class="alert alert-danger">@review.Error</div>
                        }
                        else
                        {
                            @RenderFindingsGroup("Whole Book", review.BookFindings, "bi-bookmark-star")
                            @RenderFindingsGroup("Between Chapters (Seams)", review.SeamFindings, "bi-link-45deg")
                            @RenderFindingsGroup("Per Chapter", review.ChapterFindings, "bi-card-text")

                            @if (!review.BookFindings.Any() && !review.SeamFindings.Any() && !review.ChapterFindings.Any())
                            {
                                <div class="alert alert-success">No findings — the book is well-threaded as-is.</div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @* ── Motif Inventory Modal ──────────────────────────────── *@
    @if (motifsOpen)
    {
        <div class="modal-backdrop fade show" style="z-index:1050;"></div>
        <div class="modal fade show d-block" tabindex="-1" style="z-index:1055;" @onclick="CloseMotifs">
            <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable" @onclick:stopPropagation="true">
                <div class="modal-content bg-dark text-light border-info">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title text-info"><i class="bi bi-tags me-2"></i>Motifs</h5>
                        <div class="d-flex gap-2 align-items-center">
                            <button class="btn btn-sm btn-info" @onclick="DetectMotifs" disabled="@detectingMotifs">
                                @if (detectingMotifs)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                else
                                {
                                    <i class="bi bi-search me-1"></i>
                                }
                                Auto-detect from chapters
                            </button>
                            <button type="button" class="btn-close btn-close-white" @onclick="CloseMotifs"></button>
                        </div>
                    </div>
                    <div class="modal-body">
                        <h6 class="text-success">Registered Motifs</h6>
                        @if (motifInventory != null && motifInventory.Motifs.Any())
                        {
                            <ul class="list-group mb-3">
                                @foreach (var m in motifInventory.Motifs)
                                {
                                    <li class="list-group-item bg-black text-light border-secondary d-flex justify-content-between align-items-start">
                                        <div>
                                            <strong>@m.Name</strong>
                                            <span class="badge bg-dark text-info ms-2">@m.Kind</span>
                                            <div class="small text-muted">@m.Description</div>
                                            @if (m.ReferencedInChapterIds.Any())
                                            {
                                                <div class="small text-success">Referenced in @m.ReferencedInChapterIds.Count chapter(s).</div>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-muted small mb-3">No motifs registered yet.</div>
                        }

                        <h6 class="text-warning mt-3">Proposals
                            @if (motifProposals.Any())
                            {
                                <span class="badge bg-warning text-dark ms-2">@motifProposals.Count</span>
                            }
                        </h6>
                        @if (!motifProposals.Any() && !detectingMotifs)
                        {
                            <div class="text-muted small">Click <strong>Auto-detect from chapters</strong> to surface candidate motifs (italicized recurring phrases, capitalized named objects).</div>
                        }
                        @foreach (var (chapterTitle, p) in motifProposals)
                        {
                            <div class="card bg-black border-warning mb-2">
                                <div class="card-body py-2 px-3">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <strong>@p.Name</strong>
                                            <span class="badge bg-dark text-info ms-2">@p.Kind</span>
                                            <span class="text-muted small ms-2">in @chapterTitle</span>
                                            <div class="small text-muted">@p.Description</div>
                                            <div class="small text-warning">@p.Evidence</div>
                                        </div>
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-sm btn-success py-0" @onclick="() => AcceptMotif(p)">
                                                <i class="bi bi-check-lg"></i> Accept
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => DismissMotif(p)">
                                                <i class="bi bi-x-lg"></i> Dismiss
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    @* ── Absorb Modal ──────────────────────────────── *@
    @if (absorbOpen)
    {
        <div class="modal-backdrop fade show" style="z-index:1050;"></div>
        <div class="modal fade show d-block" tabindex="-1" style="z-index:1055;" @onclick="ToggleAbsorb">
            <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
                <div class="modal-content bg-dark text-light border-secondary">
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title"><i class="bi bi-box-arrow-in-down me-2"></i>Absorb a Loose Chapter</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="ToggleAbsorb"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted mb-3">Pick a chapter that isn't currently part of any book.</p>
                        @if (looseCandidates.Any())
                        {
                            <div class="list-group">
                                @foreach (var c in looseCandidates)
                                {
                                    <button class="list-group-item list-group-item-action bg-black text-light border-secondary"
                                            @onclick="() => AbsorbChapter(c.Id)">
                                        <div class="d-flex justify-content-between">
                                            <strong>@c.Title</strong>
                                            <small class="text-muted">@c.Modified.ToString("yyyy-MM-dd")</small>
                                        </div>
                                        @if (c.Characters.Any())
                                        {
                                            <small class="text-info">@string.Join(", ", c.Characters)</small>
                                        }
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small">No loose chapters available — every chapter is already part of a book.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

@* ── Guide Me Modal ──────────────────────────────── *@
@if (guideMeOpen)
{
    <div class="modal-backdrop fade show" style="z-index:1050;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index:1055;" @onclick="CloseGuideMe">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content bg-dark text-light border-warning">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning"><i class="bi bi-compass me-2"></i>Guide the Story</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseGuideMe"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted">Pick the protagonist(s), write a synopsis, and the director will build the outline, review it, and write every beat.</p>

                    @* Protagonists *@
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">
                            Protagonist(s) <span class="text-danger">*</span>
                            <span class="text-muted ms-1">— click to add, × to remove. Multiple allowed.</span>
                        </label>

                        @* Selected badges — prominent above input so user sees what they've picked *@
                        <div class="d-flex flex-wrap gap-1 mb-2 p-2 border border-secondary rounded"
                             style="min-height:42px;background:rgba(0,0,0,0.3);">
                            @if (selectedProtagonists.Any())
                            {
                                @foreach (var p in selectedProtagonists)
                                {
                                    <span class="badge bg-warning text-dark d-flex align-items-center gap-2 py-2 px-2" style="font-size:0.85rem;">
                                        <i class="bi bi-person-fill"></i>
                                        @p
                                        <button type="button" class="btn btn-sm p-0 border-0 bg-transparent text-dark"
                                                style="line-height:1;font-weight:bold;"
                                                title="Remove @p"
                                                @onclick="() => RemoveProtagonist(p)">×</button>
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small fst-italic align-self-center">No protagonists picked yet — click a character below to add.</span>
                            }
                        </div>

                        @* Search input *@
                        <input type="text" class="form-control form-control-sm bg-black text-light border-secondary"
                               placeholder="Search characters..."
                               @bind="protagonistQuery" @bind:event="oninput" @onkeydown="OnProtagonistKeyDown" />

                        @* Dropdown: only visible when query has >=3 chars AND at least one name match *@
                        @{
                            var showDropdown = protagonistQuery.Trim().Length >= 3;
                            var matches = showDropdown ? FilteredCharacters().Take(12).ToList() : [];
                        }
                        @if (matches.Count > 0)
                        {
                            <div class="list-group mt-1" style="max-height:220px;overflow-y:auto;">
                                @foreach (var c in matches)
                                {
                                    <button type="button"
                                            class="list-group-item list-group-item-action list-group-item-dark py-1 small d-flex align-items-center gap-2"
                                            @onclick="() => AddProtagonist(c.Name)">
                                        <i class="bi bi-plus-circle text-warning"></i>
                                        <span class="fw-semibold text-light">@c.Name</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    @* Synopsis *@
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Synopsis <span class="text-danger">*</span></label>
                        <textarea class="form-control form-control-sm bg-black text-light border-secondary"
                                  rows="5" placeholder="What is this story about? How does it start, what does the protagonist want, what complicates things?"
                                  @bind="synopsisText" @bind:event="oninput"></textarea>
                        <div class="small text-muted mt-1">@(synopsisText?.Length ?? 0) chars — more detail = more control.</div>
                    </div>

                    @* Optional location *@
                    <div class="mb-2">
                        <label class="form-label small text-info mb-1">Location <span class="text-muted">(optional)</span></label>
                        <select class="form-select form-select-sm bg-black text-light border-secondary" @bind="selectedLocation">
                            <option value="">— Let the director choose —</option>
                            @foreach (var d in districts)
                            {
                                <option value="@d.Name">@d.Name</option>
                            }
                        </select>
                    </div>

                    @* Length *@
                    <div class="mb-2">
                        <label class="form-label small text-info mb-1">Length</label>
                        <select class="form-select form-select-sm bg-black text-light border-secondary" @bind="selectedBeats">
                            <option value="5">Short — 5 beats (~3–5 min)</option>
                            <option value="8">Standard — 8 beats (~4–8 min)</option>
                            <option value="12">Long — 12 beats (~6–12 min)</option>
                        </select>
                    </div>

                    @if (!string.IsNullOrEmpty(guideMeError))
                    {
                        <div class="alert alert-danger small py-2 mt-2 mb-0">@guideMeError</div>
                    }
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseGuideMe">Cancel</button>
                    <button type="button" class="btn btn-sm btn-warning" @onclick="StartGuided" disabled="@(!CanStartGuided())">
                        <i class="bi bi-lightning-fill me-1"></i>Start Story
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Autonomous Generation Progress ────────────────────── *@
@if (generating)
{
    <div class="card bg-dark text-light border-primary mb-3">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="spinner-border spinner-border-sm text-primary"></div>
                <span class="fw-bold text-primary">Autonomous Story Generation</span>
            </div>
            @if (autonomousStory != null)
            {
                <div class="small mb-2">
                    <span class="text-info">Protagonist:</span> @autonomousStory.Protagonist
                    <span class="text-muted mx-2">|</span>
                    <span class="text-info">Cast:</span> @string.Join(", ", autonomousStory.Characters)
                    @if (!string.IsNullOrEmpty(autonomousStory.Location))
                    {
                        <span class="text-muted mx-2">|</span>
                        <span class="text-info">Location:</span> @autonomousStory.Location
                    }
                </div>
            }
            <div class="small text-muted mb-2">@progressMessage</div>
            @if (_progressTotal > 0)
            {
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-danger" style="width: @(progressCurrent * 100 / _progressTotal)%"></div>
                </div>
                <small class="text-muted">Beat @progressCurrent / @_progressTotal</small>
            }

            @* Outline review scores *@
            @if (autonomousStory?.OutlineReview != null)
            {
                var review = autonomousStory.OutlineReview;
                <div class="mt-2 d-flex gap-3 flex-wrap small">
                    <span class="text-muted">
                        Moral complexity:
                        <span class="@(review.MoralAmbiguityScore >= 7 ? "text-success" : review.MoralAmbiguityScore >= 4 ? "text-warning" : "text-danger")">
                            @review.MoralAmbiguityScore/10
                        </span>
                    </span>
                    <span class="text-muted">
                        Narrative strength:
                        <span class="@(review.NarrativeStrength >= 7 ? "text-success" : review.NarrativeStrength >= 4 ? "text-warning" : "text-danger")">
                            @review.NarrativeStrength/10
                        </span>
                    </span>
                    @if (review.ClicheFlags.Count > 0)
                    {
                        <span class="text-warning"><i class="bi bi-exclamation-circle"></i> @review.ClicheFlags.Count cliché(s) caught and revised</span>
                    }
                    @if (review.ImprovementsMade.Count > 0)
                    {
                        <span class="text-info"><i class="bi bi-arrow-up-circle"></i> @review.ImprovementsMade.Count outline improvement(s) applied</span>
                    }
                </div>
            }

            @* Live beat rendering *@
            @foreach (var beat in liveBeats)
            {
                <div class="mt-3 border-start border-danger ps-3">
                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                        <small class="text-danger fw-bold">Act @beat.Act — @beat.Title</small>
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(beat.StructureRole))
                            {
                                <span class="badge" style="font-size:0.6rem;background:@(beat.SceneType=="sequel"?"#1f4e79":"#3d1f00");color:@(beat.SceneType=="sequel"?"#58a6ff":"#f0883e");">@beat.StructureRole</span>
                            }
                            <small class="text-muted">Beat @(beat.BeatIndex + 1)</small>
                        </div>
                    </div>
                    <div class="small mt-1" style="font-family: Georgia, serif; line-height: 1.7; white-space: pre-wrap; max-height: 150px; overflow-y: auto;">@beat.Text</div>
                </div>
            }

            <div class="mt-3">
                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelGeneration"><div class="btn-lbl">Cancel</div></button>
            </div>
        </div>
    </div>
}

@* ── Suggestion Panel ────────────────────── *@
@if (suggestedBeats.Count > 0 && !generating)
{
    <div class="card bg-dark text-light border-info mb-3">
        <div class="card-body">
            <h6 class="text-info"><i class="bi bi-signpost-split"></i> What Happens Next?</h6>
            <p class="text-muted small mb-3">Choose a direction for the story, or let the engine decide.</p>
            @foreach (var (suggestion, idx) in suggestedBeats.Select((s, i) => (s, i)))
            {
                <div class="border border-secondary rounded p-2 mb-2" style="cursor: pointer;"
                     @onclick="() => PickSuggestion(idx)">
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold text-light">@suggestion.Title</span>
                        <span class="badge @(suggestion.Tone == "action" ? "bg-danger" : suggestion.Tone == "intimate" ? "bg-info" : suggestion.Tone == "revelation" ? "bg-warning" : "bg-secondary")">
                            @suggestion.Tone @suggestion.Tension/10
                        </span>
                    </div>
                    <div class="small text-muted mt-1">@suggestion.Description</div>
                    @if (suggestion.SeedsResolved.Count > 0)
                    {
                        <div class="small text-success mt-1">Resolves: @string.Join(", ", suggestion.SeedsResolved)</div>
                    }
                    <div class="small text-secondary mt-1 fst-italic">@suggestion.Rationale</div>
                </div>
            }
            <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="ClearSuggestions"><div class="btn-lbl">Dismiss</div></button>
        </div>
    </div>
}

@if (failedCheckpoints.Any() && !generating)
{
    <div class="mb-3">
        <h6 class="text-warning"><i class="bi bi-exclamation-triangle"></i> Damaged Stories</h6>
        @foreach (var cp in failedCheckpoints)
        {
            var state = StoryDamage.Classify(cp);
            var canSuggest = state == StoryDamageState.BeatsIncomplete && cp.Beats.Count > 0 && cp.Outline != null;
            <div class="card bg-dark border-warning mb-2">
                <div class="card-body py-2 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold text-light">@(string.IsNullOrWhiteSpace(cp.Title) || cp.Title.Equals("Outline generation failed", StringComparison.OrdinalIgnoreCase) ? Constants.Defaults.UntitledStory : cp.Title)</span>
                        <div class="small text-warning mt-1">@StoryDamage.Describe(cp)</div>
                        @if (!string.IsNullOrEmpty(cp.FailureReason))
                        {
                            <div class="small text-muted fst-italic">@cp.FailureReason</div>
                        }
                    </div>
                    <div class="d-flex gap-1">
                        @if (canSuggest)
                        {
                            <button class="btn btn-sm btn-outline-info" @onclick="() => GetSuggestions(cp)" disabled="@suggestionsLoading">
                                <i class="bi bi-signpost-split"></i><div class="btn-lbl"> What Next?</div>
                            </button>
                        }
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => RepairCheckpoint(cp)" title="@StoryDamage.Describe(cp)">
                            <i class="bi bi-wrench-adjustable"></i><div class="btn-lbl"> Repair</div>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ArchiveCheckpoint(cp.ProjectId)" title="Archive">
                            <i class="bi bi-archive"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (projects.Any())
{
    <div class="table-responsive">
        <table class="table table-dark table-hover table-sm">
            <thead>
                <tr>
                    <th style="width:60px;">#</th>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Modified</th>
                    <th style="width:170px;text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @{ var chapterIdx = 0; }
                @foreach (var p in projects)
                {
                    var idx = chapterIdx++;
                    var isFirst = idx == 0;
                    var isLast  = idx == projects.Count - 1;
                    <tr style="cursor: pointer;" @onclick="() => OpenProject(p.Id)">
                        <td class="text-muted">@(idx + 1)</td>
                        <td class="fw-bold">@(string.IsNullOrWhiteSpace(p.Title) ? Constants.Defaults.UntitledStory : p.Title)</td>
                        <td><span class="badge bg-secondary">@p.Status</span></td>
                        <td class="text-muted small">@p.Modified.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-end" @onclick:stopPropagation="true">
                            <button class="btn btn-sm btn-outline-secondary py-0 me-1"
                                    title="Move up"
                                    disabled="@isFirst"
                                    @onclick="() => MoveChapterUp(p.Id)">
                                <i class="bi bi-arrow-up"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-secondary py-0 me-1"
                                    title="Move down"
                                    disabled="@isLast"
                                    @onclick="() => MoveChapterDown(p.Id)">
                                <i class="bi bi-arrow-down"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-info py-0 me-1"
                                    title="Insert new chapter below this one"
                                    @onclick="() => InsertAfter(p.Id)">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                            @if (confirmArchiveId == p.Id)
                            {
                                <button class="btn btn-sm btn-warning py-0" @onclick="() => DoArchive(p.Id)"><div class="btn-lbl">Archive</div></button>
                                <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => confirmArchiveId = null"><div class="btn-lbl">No</div></button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary py-0" title="Archive" @onclick="() => confirmArchiveId = p.Id">
                                    <i class="bi bi-archive"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (!generating)
{
    <div class="text-center py-5 text-muted">
        <p>No chapters in this book yet.</p>
        <div class="d-flex gap-2 justify-content-center">
            <button class="btn btn-outline-primary" @onclick="SurpriseMe"><i class="bi bi-lightning"></i><div class="btn-lbl"> Surprise Me</div></button>
            <button class="btn btn-outline-warning" @onclick="OpenGuideMe"><i class="bi bi-compass"></i><div class="btn-lbl"> Guide Me</div></button>
            <button class="btn btn-outline-danger" @onclick="CreateNew"><i class="bi bi-plus-lg"></i><div class="btn-lbl"> New Chapter</div></button>
            <button class="btn btn-outline-secondary" @onclick="ToggleAbsorb"><i class="bi bi-box-arrow-in-down"></i><div class="btn-lbl"> Absorb</div></button>
        </div>
    </div>
}

@code {
    private List<Chapter> projects = [];
    private List<AutonomousStory> failedCheckpoints = [];
    private string? confirmArchiveId;
    private bool generating;
    private bool suggestionsLoading;
    private string progressMessage = "";
    private int progressCurrent, _progressTotal;
    private AutonomousStory? autonomousStory;
    private AutonomousStory? suggestionSource;
    private List<GeneratedStoryBeat> liveBeats = [];
    private List<BeatSuggestion> suggestedBeats = [];
    private CancellationTokenSource? cts;

    [Parameter] public string BookId { get; set; } = "";

    private Book? book;
    private List<Chapter> looseCandidates = [];
    private bool absorbOpen;
    private bool editBookOpen;
    private string protagonistsCsv = "";

    // ── Book Review state ──
    private bool reviewOpen;
    private bool reviewing;
    private string reviewProgress = "";
    private BookReviewReport? review;
    private string? applyError;

    // ── Outline gate state ──
    private OutlineStatus outlineStatus = OutlineStatus.Draft;
    private bool OutlineApproved => outlineStatus == OutlineStatus.Approved;

    // ── Motif state ──
    private bool motifsOpen;
    private bool detectingMotifs;
    private MotifInventory? motifInventory;
    private List<(string chapterTitle, MotifProposal proposal)> motifProposals = [];
    private HashSet<string> dismissedProposalKeys = new(StringComparer.OrdinalIgnoreCase);
    private int PendingFindingsCount =>
        review == null ? 0 :
        review.BookFindings.Count(f => f.Status == ReviewStatus.Pending) +
        review.ChapterFindings.Count(f => f.Status == ReviewStatus.Pending) +
        review.SeamFindings.Count(f => f.Status == ReviewStatus.Pending);

    private static readonly string DiagPath = System.IO.Path.Combine(System.IO.Path.GetTempPath(), "stories-diag.log");
    private static void Diag(string step) => System.IO.File.AppendAllText(DiagPath,
        $"{DateTime.Now:HH:mm:ss.fff} {step}{Environment.NewLine}");

    protected override void OnInitialized()
    {
        Diag($"OnInitialized: enter BookId={BookId}");
        Director.OnProgress += OnDirectorProgress;
        Diag("OnInitialized: hooked OnProgress");
        CharRepo.Reload();
        Diag("OnInitialized: CharRepo.Reload done");
        allCharacters = CharRepo.GetAll();
        Diag($"OnInitialized: CharRepo.GetAll done ({allCharacters.Count})");
        districts = DistrictRepo.GetAll();
        Diag($"OnInitialized: DistrictRepo.GetAll done ({districts.Count}) — exit");
    }

    protected override void OnParametersSet()
    {
        Diag($"OnParametersSet: enter BookId={BookId}");
        ReloadBook();
        Diag("OnParametersSet: ReloadBook returned");
        if (!string.IsNullOrWhiteSpace(ProtagonistParam) && !generating && book != null)
            _ = SurpriseMeFor(ProtagonistParam);
        Diag("OnParametersSet: exit");
    }

    /// <summary>Loads this book's chapters in declared order. Filters out anything that doesn't belong to this book.</summary>
    private void ReloadBook()
    {
        Diag("ReloadBook: enter");
        book = BookRepo.LoadBook(BookId);
        Diag($"ReloadBook: BookRepo.LoadBook done (book={(book == null ? "null" : book.Title)})");
        if (book == null) { projects = []; return; }

        var all = Repo.ListChapters().ToDictionary(c => c.Id);
        Diag($"ReloadBook: Repo.ListChapters done ({all.Count})");
        // Use Book.ChapterIds as the canonical order; fall back to anything pointing at this book that isn't in the list yet.
        projects = book.ChapterIds
            .Select(id => all.GetValueOrDefault(id))
            .Where(c => c != null)
            .ToList()!;
        var inOrder = projects.Select(p => p.Id).ToHashSet();
        var orphaned = all.Values.Where(c => c.BookId == BookId && !inOrder.Contains(c.Id));
        projects.AddRange(orphaned);
        Diag($"ReloadBook: projects assembled ({projects.Count})");

        // Loose candidates: chapters with no book or pointing at a vanished book.
        var liveBookIds = BookRepo.ListBooks().Select(b => b.Id).ToHashSet();
        looseCandidates = all.Values
            .Where(c => string.IsNullOrEmpty(c.BookId) || !liveBookIds.Contains(c.BookId))
            .OrderByDescending(c => c.Modified)
            .ToList();
        Diag($"ReloadBook: looseCandidates done ({looseCandidates.Count})");

        // Load any existing review report so the pending-findings badge can render on first paint.
        review = ReviewSvc.LoadReport(BookId);
        Diag("ReloadBook: ReviewSvc.LoadReport done");
        motifInventory = MotifSvc.Load(BookId);
        Diag("ReloadBook: MotifSvc.Load done");
        outlineStatus = OutlineSvc.Load(BookId).Status;
        Diag($"ReloadBook: OutlineSvc.Load done (status={outlineStatus})");

        LoadFailedCheckpoints();
        Diag("ReloadBook: LoadFailedCheckpoints done — exit");
    }

    /// <summary>Sets BookId + Number on a new chapter, saves it, and pushes the id onto the parent book's ordered list.</summary>
    private void AttachToBook(Chapter chapter)
    {
        if (book == null) { Repo.SaveChapter(chapter); return; }

        chapter.BookId = book.Id;
        chapter.Number = book.ChapterIds.Count + 1;
        Repo.SaveChapter(chapter);

        if (!book.ChapterIds.Contains(chapter.Id))
        {
            book.ChapterIds.Add(chapter.Id);
            BookRepo.SaveBook(book);
        }
    }

    private void ToggleAbsorb()
    {
        absorbOpen = !absorbOpen;
        if (absorbOpen) ReloadBook();
    }

    private void AbsorbChapter(string chapterId)
    {
        if (book == null) return;
        var chapter = Repo.LoadChapter(chapterId);
        if (chapter == null) return;

        chapter.BookId = book.Id;
        chapter.Number = book.ChapterIds.Count + 1;
        Repo.SaveChapter(chapter);

        if (!book.ChapterIds.Contains(chapter.Id))
        {
            book.ChapterIds.Add(chapter.Id);
            BookRepo.SaveBook(book);
        }

        absorbOpen = false;
        ReloadBook();
    }

    private void ToggleEditBook()
    {
        if (!editBookOpen && book != null)
            protagonistsCsv = string.Join(", ", book.Protagonists);
        editBookOpen = !editBookOpen;
    }

    private void SaveBookMeta()
    {
        if (book == null) return;
        book.Protagonists = protagonistsCsv
            .Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
            .ToList();
        if (string.IsNullOrWhiteSpace(book.Tagline)) book.Tagline = null;
        BookRepo.SaveBook(book);
        editBookOpen = false;
    }

    // ── Review handlers ─────────────────────────────────────────

    private void OpenReview()
    {
        if (book == null) return;
        review = ReviewSvc.LoadReport(book.Id);
        applyError = null;
        reviewOpen = true;
    }

    private void CloseReview() => reviewOpen = false;

    private async Task StartReview()
    {
        if (book == null || reviewing) return;
        reviewing = true;
        reviewProgress = "Starting...";
        applyError = null;
        StateHasChanged();

        var progress = new Progress<string>(msg =>
        {
            reviewProgress = msg;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            review = await ReviewSvc.ReviewAsync(book.Id, progress);
        }
        catch (Exception ex)
        {
            review = new BookReviewReport { BookId = book.Id, Error = ex.Message };
        }
        finally
        {
            reviewing = false;
            StateHasChanged();
        }
    }

    private async Task ApplyFinding(string findingId)
    {
        if (book == null) return;
        applyError = null;
        var result = await ReviewSvc.ApplyFindingAsync(book.Id, findingId);
        if (!result.Success) { applyError = result.Error; }
        review = ReviewSvc.LoadReport(book.Id);
        ReloadBook();
        StateHasChanged();
    }

    private void RejectFinding(string findingId)
    {
        if (book == null) return;
        ReviewSvc.RejectFinding(book.Id, findingId);
        review = ReviewSvc.LoadReport(book.Id);
    }

    // ── Motif handlers ──────────────────────────────────────────

    private void OpenMotifs()
    {
        motifInventory = MotifSvc.Load(BookId);
        motifsOpen = true;
    }
    private void CloseMotifs() => motifsOpen = false;

    private void DetectMotifs()
    {
        if (book == null) return;
        detectingMotifs = true;
        StateHasChanged();
        try
        {
            // Pass canonical character names so the proposer doesn't flag them as motif candidates.
            var knownNames = CanonDb.Characters.Select(c => c.Name).Where(n => !string.IsNullOrEmpty(n));

            motifProposals.Clear();
            foreach (var c in projects)
            {
                var proposals = MotifSvc.ProposeFromChapter(BookId, c, knownNames);
                foreach (var p in proposals)
                {
                    var key = $"{p.Kind}::{p.Name}".ToLowerInvariant();
                    if (dismissedProposalKeys.Contains(key)) continue;
                    motifProposals.Add((c.Title, p));
                }
            }
        }
        finally
        {
            detectingMotifs = false;
            StateHasChanged();
        }
    }

    private void AcceptMotif(MotifProposal p)
    {
        if (book == null) return;
        // Find the chapter this proposal came from to record introduction.
        var sourceChapter = motifProposals.FirstOrDefault(t => t.proposal.Name == p.Name).chapterTitle;
        var introducedIn = projects.FirstOrDefault(c => c.Title == sourceChapter)?.Id ?? "";
        MotifSvc.Plant(BookId, p.Name, p.Description, p.Kind, introducedIn);
        motifInventory = MotifSvc.Load(BookId);
        motifProposals.RemoveAll(t => string.Equals(t.proposal.Name, p.Name, StringComparison.OrdinalIgnoreCase));
    }

    private void DismissMotif(MotifProposal p)
    {
        var key = $"{p.Kind}::{p.Name}".ToLowerInvariant();
        dismissedProposalKeys.Add(key);
        motifProposals.RemoveAll(t => string.Equals(t.proposal.Name, p.Name, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>Build an export of the current book in the requested format and surface the path.</summary>
    private void Export(string format)
    {
        if (book == null) return;
        try
        {
            string path = format switch
            {
                "html" => ExportSvc.ExportHtml(book.Id),
                "md"   => ExportSvc.ExportMarkdown(book.Id),
                _      => ExportSvc.ExportEpub(book.Id),
            };
            applyError = $"Exported: {path}";  // reuse the alert slot — green path message
        }
        catch (Exception ex)
        {
            applyError = $"Export failed: {ex.Message}";
        }
    }

    private string ChapterTitleFor(string? chapterId)
    {
        if (string.IsNullOrEmpty(chapterId)) return "";
        var p = projects.FirstOrDefault(c => c.Id == chapterId);
        return p?.Title ?? "(unknown chapter)";
    }

    private static string SeverityClass(ReviewSeverity s) => s switch
    {
        ReviewSeverity.Critical => "bg-danger",
        ReviewSeverity.Warning => "bg-warning text-dark",
        _ => "bg-info text-dark",
    };

    private RenderFragment RenderFindingsGroup(string heading, List<ReviewFinding> findings, string icon) => __builder =>
    {
        var visible = findings.Where(f => f.Status != ReviewStatus.Rejected).ToList();
        if (!visible.Any()) return;

        <h6 class="text-success mt-3 mb-2">
