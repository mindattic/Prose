@page "/stories"
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@inject IStoryBlockRepository Repo
@inject StoryDirectorService Director
@inject NavigationManager Nav
@implements IDisposable

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-danger mb-0">Stories</h4>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-primary" @onclick="SurpriseMe" disabled="@generating">
            <i class="bi bi-lightning"></i> Surprise Me
        </button>
        <button class="btn btn-sm btn-outline-danger" @onclick="CreateNew"><i class="bi bi-plus-lg"></i> New Story</button>
    </div>
</div>

@* ── Autonomous Generation Progress ────────────────────── *@
@if (generating)
{
    <div class="card bg-dark text-light border-primary mb-3">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="spinner-border spinner-border-sm text-primary"></div>
                <span class="fw-bold text-primary">Autonomous Story Generation</span>
            </div>
            @if (autonomousStory != null)
            {
                <div class="small mb-2">
                    <span class="text-info">Protagonist:</span> @autonomousStory.Protagonist
                    <span class="text-muted mx-2">|</span>
                    <span class="text-info">Cast:</span> @string.Join(", ", autonomousStory.Characters)
                    @if (!string.IsNullOrEmpty(autonomousStory.Location))
                    {
                        <span class="text-muted mx-2">|</span>
                        <span class="text-info">Location:</span> @autonomousStory.Location
                    }
                </div>
            }
            <div class="small text-muted mb-2">@progressMessage</div>
            @if (_progressTotal > 0)
            {
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-danger" style="width: @(progressCurrent * 100 / _progressTotal)%"></div>
                </div>
                <small class="text-muted">Beat @progressCurrent / @_progressTotal</small>
            }

            @* Live beat rendering *@
            @foreach (var beat in liveBeats)
            {
                <div class="mt-3 border-start border-danger ps-3">
                    <div class="d-flex justify-content-between">
                        <small class="text-danger fw-bold">Act @beat.Act — @beat.Title</small>
                        <small class="text-muted">Beat @(beat.BeatIndex + 1)</small>
                    </div>
                    <div class="small mt-1" style="font-family: Georgia, serif; line-height: 1.7; white-space: pre-wrap; max-height: 150px; overflow-y: auto;">@beat.Text</div>
                </div>
            }

            <div class="mt-3">
                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelGeneration">Cancel</button>
            </div>
        </div>
    </div>
}

@if (projects.Any())
{
    <div class="table-responsive">
        <table class="table table-dark table-hover table-sm">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Modified</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in projects)
                {
                    <tr style="cursor: pointer;" @onclick="() => OpenProject(p.Id)">
                        <td class="fw-bold fst-italic">@(string.IsNullOrWhiteSpace(p.Title) ? "Untitled" : p.Title)</td>
                        <td><span class="badge bg-secondary">@p.Status</span></td>
                        <td class="text-muted small">@p.Modified.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (confirmDeleteId == p.Id)
                            {
                                <button class="btn btn-sm btn-danger py-0" @onclick="() => DoDelete(p.Id)" @onclick:stopPropagation="true">Confirm</button>
                                <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => confirmDeleteId = null" @onclick:stopPropagation="true">No</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-danger py-0" @onclick="() => confirmDeleteId = p.Id" @onclick:stopPropagation="true"><i class="bi bi-trash3"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (!generating)
{
    <div class="text-center py-5 text-muted">
        <p>No stories yet.</p>
        <div class="d-flex gap-2 justify-content-center">
            <button class="btn btn-outline-primary" @onclick="SurpriseMe"><i class="bi bi-lightning"></i> Surprise Me</button>
            <button class="btn btn-outline-danger" @onclick="CreateNew">New Story</button>
        </div>
    </div>
}

@code {
    private List<StoryProject> projects = [];
    private string? confirmDeleteId;
    private bool generating;
    private string progressMessage = "";
    private int progressCurrent, _progressTotal;
    private AutonomousStory? autonomousStory;
    private List<GeneratedStoryBeat> liveBeats = [];
    private CancellationTokenSource? cts;

    protected override void OnInitialized()
    {
        projects = Repo.ListProjects();
        Director.OnProgress += OnDirectorProgress;
    }

    public void Dispose()
    {
        Director.OnProgress -= OnDirectorProgress;
        cts?.Cancel();
    }

    private void OnDirectorProgress(DirectorProgress p)
    {
        progressMessage = p.Message;
        progressCurrent = p.CurrentBeat;
        _progressTotal = p.TotalBeats;

        // Check if new beats arrived
        if (autonomousStory?.Beats.Count > liveBeats.Count)
            liveBeats = new List<GeneratedStoryBeat>(autonomousStory.Beats);

        InvokeAsync(StateHasChanged);
    }

    private void OpenProject(string id) => Nav.NavigateTo($"/write/{id}");

    private void CreateNew()
    {
        var project = new StoryProject();
        Repo.SaveProject(project);
        Nav.NavigateTo($"/write/{project.Id}");
    }

    private async Task SurpriseMe()
    {
        generating = true;
        liveBeats.Clear();
        progressMessage = "Initializing...";
        progressCurrent = 0;
        _progressTotal = 0;
        cts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            autonomousStory = await Director.SurpriseMeAsync(cts.Token);

            if (autonomousStory.Complete)
            {
                // Save as a StoryProject
                var project = new StoryProject
                {
                    Title = autonomousStory.Title,
                    Characters = autonomousStory.Characters,
                    Html = ConvertToHtml(autonomousStory),
                    Status = "draft",
                };
                Repo.SaveProject(project);
                projects = Repo.ListProjects();

                // Navigate to the new story
                Nav.NavigateTo($"/write/{project.Id}");
            }
        }
        catch (OperationCanceledException) { progressMessage = "Cancelled."; }
        catch (Exception ex) { progressMessage = $"Error: {ex.Message}"; }
        finally { generating = false; }
    }

    private void CancelGeneration() => cts?.Cancel();

    private void DoDelete(string id)
    {
        Repo.DeleteProject(id);
        confirmDeleteId = null;
        projects.RemoveAll(p => p.Id == id);
    }

    private static string ConvertToHtml(AutonomousStory story)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append($"<h1>{System.Web.HttpUtility.HtmlEncode(story.Title)}</h1>");
        sb.Append($"<p><em>Protagonist: {System.Web.HttpUtility.HtmlEncode(story.Protagonist)}</em></p>");

        int lastAct = 0;
        foreach (var beat in story.Beats)
        {
            if (beat.Act != lastAct)
            {
                var actName = story.Outline?.Acts.FirstOrDefault(a => a.ActNumber == beat.Act)?.Name ?? $"Act {beat.Act}";
                sb.Append($"<h2>Act {beat.Act}: {System.Web.HttpUtility.HtmlEncode(actName)}</h2>");
                lastAct = beat.Act;
            }

            // Convert newlines to paragraphs
            var paragraphs = beat.Text.Split(["\n\n", "\r\n\r\n"], StringSplitOptions.RemoveEmptyEntries);
            foreach (var p in paragraphs)
                sb.Append($"<p>{System.Web.HttpUtility.HtmlEncode(p.Trim())}</p>");

            sb.Append("<hr/>");
        }

        return sb.ToString();
    }
}
