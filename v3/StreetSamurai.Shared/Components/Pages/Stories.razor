    private void DoArchive(string id)
    {
        Repo.DeleteChapter(id);
        confirmArchiveId = null;
        projects.RemoveAll(p => p.Id == id);

        // Drop from the book's ordered list too — otherwise the next ReloadBook leaves a hole.
        if (book != null && book.ChapterIds.Remove(id))
        {
            BookRepo.SaveBook(book);
            RenumberChapters();
        }
    }

    private void MoveChapterUp(string id)
    {
        if (book == null) return;
        var i = book.ChapterIds.IndexOf(id);
        if (i <= 0) return;
        (book.ChapterIds[i - 1], book.ChapterIds[i]) = (book.ChapterIds[i], book.ChapterIds[i - 1]);
        BookRepo.SaveBook(book);
        RenumberChapters();
        ReloadBook();
    }

    private void MoveChapterDown(string id)
    {
        if (book == null) return;
        var i = book.ChapterIds.IndexOf(id);
        if (i < 0 || i >= book.ChapterIds.Count - 1) return;
        (book.ChapterIds[i + 1], book.ChapterIds[i]) = (book.ChapterIds[i], book.ChapterIds[i + 1]);
        BookRepo.SaveBook(book);
        RenumberChapters();
        ReloadBook();
    }

    /// <summary>Creates a new blank chapter and inserts it directly after the chapter with the given id.</summary>
    private void InsertAfter(string anchorChapterId)
    {
        if (book == null) return;
        var i = book.ChapterIds.IndexOf(anchorChapterId);
        if (i < 0) return;

        var newChapter = new Chapter
        {
            BookId = book.Id,
            Title  = $"Chapter {i + 2}",
        };
        Repo.SaveChapter(newChapter);

        // Insert at position i+1 so it falls between the anchor and what came after.
        book.ChapterIds.Insert(i + 1, newChapter.Id);
        BookRepo.SaveBook(book);
        RenumberChapters();

        Nav.NavigateTo($"/stories/write/{newChapter.Id}");
    }

    /// <summary>Rewrites Chapter.Number on every chapter to match its new position in book.ChapterIds.</summary>
    private void RenumberChapters()
    {
        if (book == null) return;
        for (int i = 0; i < book.ChapterIds.Count; i++)
        {
            var c = Repo.LoadChapter(book.ChapterIds[i]);
            if (c == null) continue;
            var newNumber = i + 1;
            if (c.Number != newNumber)
            {
                c.Number = newNumber;
                Repo.SaveChapter(c);
            }
        }
    }

    private async Task GetSuggestions(AutonomousStory checkpoint)
    {
        if (checkpoint.Outline == null) return;
        suggestionsLoading = true;
        suggestionSource = checkpoint;
        StateHasChanged();

        try
        {
            var storySoFar = string.Join("\n\n", checkpoint.Beats.Select(b => b.Text));
            suggestedBeats = await Suggestions.SuggestNextBeatsAsync(
                checkpoint.ProjectId, checkpoint.Outline,
                checkpoint.Beats.Count - 1,
                checkpoint.Characters, checkpoint.Location ?? "The Shelf",
                storySoFar);
        }
        catch (Exception ex)
        {
            progressMessage = $"Suggestion failed: {ex.Message}";
        }
        finally
        {
            suggestionsLoading = false;
            StateHasChanged();
        }
    }

    private void PickSuggestion(int index)
    {
        if (suggestionSource == null || index >= suggestedBeats.Count) return;
        var chosen = suggestedBeats[index];
        suggestedBeats.Clear();
        var goalOverride = $"{chosen.Title}: {chosen.Description}";
        _ = ResumeCheckpoint(suggestionSource, goalOverride);
    }

    private void ClearSuggestions() => suggestedBeats.Clear();

