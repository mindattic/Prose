@page "/stories"
@attribute [Authorize(Roles = "Contributor,Administrator")]
@using StreetSamurai.Core
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@inject IStoryBlockRepository Repo
@inject StoryDirectorService Director
@inject NavigationManager Nav
@inject SuggestionEngineService Suggestions
@inject CharacterRepository CharRepo
@inject DistrictRepository DistrictRepo
@implements IDisposable

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="text-danger mb-0">Stories</h4>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-primary" @onclick="SurpriseMe" disabled="@generating">
            <i class="bi bi-lightning"></i><div class="btn-lbl"> Surprise Me</div>
        </button>
        <button class="btn btn-sm btn-outline-warning" @onclick="OpenGuideMe" disabled="@generating">
            <i class="bi bi-compass"></i><div class="btn-lbl"> Guide Me</div>
        </button>
        <button class="btn btn-sm btn-outline-danger" @onclick="CreateNew"><i class="bi bi-plus-lg"></i><div class="btn-lbl"> New Story</div></button>
    </div>
</div>

@* ── Guide Me Modal ──────────────────────────────── *@
@if (guideMeOpen)
{
    <div class="modal-backdrop fade show" style="z-index:1050;"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index:1055;" @onclick="CloseGuideMe">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content bg-dark text-light border-warning">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-warning"><i class="bi bi-compass me-2"></i>Guide the Story</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseGuideMe"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted">Pick the protagonist(s), write a synopsis, and the director will build the outline, review it, and write every beat.</p>

                    @* Protagonists *@
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">
                            Protagonist(s) <span class="text-danger">*</span>
                            <span class="text-muted ms-1">— click to add, × to remove. Multiple allowed.</span>
                        </label>

                        @* Selected badges — prominent above input so user sees what they've picked *@
                        <div class="d-flex flex-wrap gap-1 mb-2 p-2 border border-secondary rounded"
                             style="min-height:42px;background:rgba(0,0,0,0.3);">
                            @if (selectedProtagonists.Any())
                            {
                                @foreach (var p in selectedProtagonists)
                                {
                                    <span class="badge bg-warning text-dark d-flex align-items-center gap-2 py-2 px-2" style="font-size:0.85rem;">
                                        <i class="bi bi-person-fill"></i>
                                        @p
                                        <button type="button" class="btn btn-sm p-0 border-0 bg-transparent text-dark"
                                                style="line-height:1;font-weight:bold;"
                                                title="Remove @p"
                                                @onclick="() => RemoveProtagonist(p)">×</button>
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small fst-italic align-self-center">No protagonists picked yet — click a character below to add.</span>
                            }
                        </div>

                        @* Search input *@
                        <input type="text" class="form-control form-control-sm bg-black text-light border-secondary"
                               placeholder="Search characters..."
                               @bind="protagonistQuery" @bind:event="oninput" @onkeydown="OnProtagonistKeyDown" />

                        @* Always-visible scrollable suggestion list *@
                        @{
                            var matches = FilteredCharacters().Take(12).ToList();
                        }
                        <div class="list-group mt-1" style="max-height:220px;overflow-y:auto;">
                            @if (matches.Any())
                            {
                                @foreach (var c in matches)
                                {
                                    <button type="button"
                                            class="list-group-item list-group-item-action list-group-item-dark py-1 small d-flex align-items-center gap-2"
                                            @onclick="() => AddProtagonist(c.Name)">
                                        <i class="bi bi-plus-circle text-warning"></i>
                                        <span class="fw-semibold text-light">@c.Name</span>
                                        @if (!string.IsNullOrEmpty(c.Role))
                                        {
                                            <span class="text-muted">— @c.Role</span>
                                        }
                                    </button>
                                }
                            }
                            else
                            {
                                <div class="list-group-item list-group-item-dark small text-muted fst-italic py-2">
                                    @(string.IsNullOrWhiteSpace(protagonistQuery)
                                        ? "All characters added."
                                        : $"No canon character matches \"{protagonistQuery}\". Only defined characters can be selected.")
                                </div>
                            }
                        </div>
                    </div>

                    @* Synopsis *@
                    <div class="mb-3">
                        <label class="form-label small text-info mb-1">Synopsis <span class="text-danger">*</span></label>
                        <textarea class="form-control form-control-sm bg-black text-light border-secondary"
                                  rows="5" placeholder="What is this story about? How does it start, what does the protagonist want, what complicates things?"
                                  @bind="synopsisText" @bind:event="oninput"></textarea>
                        <div class="small text-muted mt-1">@(synopsisText?.Length ?? 0) chars — more detail = more control.</div>
                    </div>

                    @* Optional location *@
                    <div class="mb-2">
                        <label class="form-label small text-info mb-1">Location <span class="text-muted">(optional)</span></label>
                        <select class="form-select form-select-sm bg-black text-light border-secondary" @bind="selectedLocation">
                            <option value="">— Let the director choose —</option>
                            @foreach (var d in districts)
                            {
                                <option value="@d.Name">@d.Name</option>
                            }
                        </select>
                    </div>

                    @* Length *@
                    <div class="mb-2">
                        <label class="form-label small text-info mb-1">Length</label>
                        <select class="form-select form-select-sm bg-black text-light border-secondary" @bind="selectedBeats">
                            <option value="5">Short — 5 beats (~3–5 min)</option>
                            <option value="8">Standard — 8 beats (~4–8 min)</option>
                            <option value="12">Long — 12 beats (~6–12 min)</option>
                        </select>
                    </div>

                    @if (!string.IsNullOrEmpty(guideMeError))
                    {
                        <div class="alert alert-danger small py-2 mt-2 mb-0">@guideMeError</div>
                    }
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="CloseGuideMe">Cancel</button>
                    <button type="button" class="btn btn-sm btn-warning" @onclick="StartGuided" disabled="@(!CanStartGuided())">
                        <i class="bi bi-lightning-fill me-1"></i>Start Story
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ── Autonomous Generation Progress ────────────────────── *@
@if (generating)
{
    <div class="card bg-dark text-light border-primary mb-3">
        <div class="card-body">
            <div class="d-flex align-items-center gap-2 mb-2">
                <div class="spinner-border spinner-border-sm text-primary"></div>
                <span class="fw-bold text-primary">Autonomous Story Generation</span>
            </div>
            @if (autonomousStory != null)
            {
                <div class="small mb-2">
                    <span class="text-info">Protagonist:</span> @autonomousStory.Protagonist
                    <span class="text-muted mx-2">|</span>
                    <span class="text-info">Cast:</span> @string.Join(", ", autonomousStory.Characters)
                    @if (!string.IsNullOrEmpty(autonomousStory.Location))
                    {
                        <span class="text-muted mx-2">|</span>
                        <span class="text-info">Location:</span> @autonomousStory.Location
                    }
                </div>
            }
            <div class="small text-muted mb-2">@progressMessage</div>
            @if (_progressTotal > 0)
            {
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar bg-danger" style="width: @(progressCurrent * 100 / _progressTotal)%"></div>
                </div>
                <small class="text-muted">Beat @progressCurrent / @_progressTotal</small>
            }

            @* Outline review scores *@
            @if (autonomousStory?.OutlineReview != null)
            {
                var review = autonomousStory.OutlineReview;
                <div class="mt-2 d-flex gap-3 flex-wrap small">
                    <span class="text-muted">
                        Moral complexity:
                        <span class="@(review.MoralAmbiguityScore >= 7 ? "text-success" : review.MoralAmbiguityScore >= 4 ? "text-warning" : "text-danger")">
                            @review.MoralAmbiguityScore/10
                        </span>
                    </span>
                    <span class="text-muted">
                        Narrative strength:
                        <span class="@(review.NarrativeStrength >= 7 ? "text-success" : review.NarrativeStrength >= 4 ? "text-warning" : "text-danger")">
                            @review.NarrativeStrength/10
                        </span>
                    </span>
                    @if (review.ClicheFlags.Count > 0)
                    {
                        <span class="text-warning"><i class="bi bi-exclamation-circle"></i> @review.ClicheFlags.Count cliché(s) caught and revised</span>
                    }
                    @if (review.ImprovementsMade.Count > 0)
                    {
                        <span class="text-info"><i class="bi bi-arrow-up-circle"></i> @review.ImprovementsMade.Count outline improvement(s) applied</span>
                    }
                </div>
            }

            @* Live beat rendering *@
            @foreach (var beat in liveBeats)
            {
                <div class="mt-3 border-start border-danger ps-3">
                    <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                        <small class="text-danger fw-bold">Act @beat.Act — @beat.Title</small>
                        <div class="d-flex align-items-center gap-2">
                            @if (!string.IsNullOrEmpty(beat.StructureRole))
                            {
                                <span class="badge" style="font-size:0.6rem;background:@(beat.SceneType=="sequel"?"#1f4e79":"#3d1f00");color:@(beat.SceneType=="sequel"?"#58a6ff":"#f0883e");">@beat.StructureRole</span>
                            }
                            <small class="text-muted">Beat @(beat.BeatIndex + 1)</small>
                        </div>
                    </div>
                    <div class="small mt-1" style="font-family: Georgia, serif; line-height: 1.7; white-space: pre-wrap; max-height: 150px; overflow-y: auto;">@beat.Text</div>
                </div>
            }

            <div class="mt-3">
                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelGeneration"><div class="btn-lbl">Cancel</div></button>
            </div>
        </div>
    </div>
}

@* ── Suggestion Panel ────────────────────── *@
@if (suggestedBeats.Count > 0 && !generating)
{
    <div class="card bg-dark text-light border-info mb-3">
        <div class="card-body">
            <h6 class="text-info"><i class="bi bi-signpost-split"></i> What Happens Next?</h6>
            <p class="text-muted small mb-3">Choose a direction for the story, or let the engine decide.</p>
            @foreach (var (suggestion, idx) in suggestedBeats.Select((s, i) => (s, i)))
            {
                <div class="border border-secondary rounded p-2 mb-2" style="cursor: pointer;"
                     @onclick="() => PickSuggestion(idx)">
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold text-light">@suggestion.Title</span>
                        <span class="badge @(suggestion.Tone == "action" ? "bg-danger" : suggestion.Tone == "intimate" ? "bg-info" : suggestion.Tone == "revelation" ? "bg-warning" : "bg-secondary")">
                            @suggestion.Tone @suggestion.Tension/10
                        </span>
                    </div>
                    <div class="small text-muted mt-1">@suggestion.Description</div>
                    @if (suggestion.SeedsResolved.Count > 0)
                    {
                        <div class="small text-success mt-1">Resolves: @string.Join(", ", suggestion.SeedsResolved)</div>
                    }
                    <div class="small text-secondary mt-1 fst-italic">@suggestion.Rationale</div>
                </div>
            }
            <button class="btn btn-sm btn-outline-secondary mt-2" @onclick="ClearSuggestions"><div class="btn-lbl">Dismiss</div></button>
        </div>
    </div>
}

@if (failedCheckpoints.Any() && !generating)
{
    <div class="mb-3">
        <h6 class="text-warning"><i class="bi bi-exclamation-triangle"></i> Failed / Partial Stories</h6>
        @foreach (var cp in failedCheckpoints)
        {
            <div class="card bg-dark border-warning mb-2">
                <div class="card-body py-2 d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold text-light">@(string.IsNullOrWhiteSpace(cp.Title) ? Constants.Defaults.UntitledStory : cp.Title)</span>
                        <small class="text-muted ms-2">@cp.Beats.Count beats written</small>
                        @if (!string.IsNullOrEmpty(cp.FailureReason))
                        {
                            <div class="small text-warning mt-1">@cp.FailureReason</div>
                        }
                    </div>
                    <div class="d-flex gap-1">
                        <button class="btn btn-sm btn-outline-info" @onclick="() => GetSuggestions(cp)" disabled="@suggestionsLoading">
                            <i class="bi bi-signpost-split"></i><div class="btn-lbl"> What Next?</div>
                        </button>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ResumeCheckpoint(cp)">
                            <i class="bi bi-play-fill"></i><div class="btn-lbl"> Resume</div>
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => ArchiveCheckpoint(cp.ProjectId)">
                            <i class="bi bi-archive"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (projects.Any())
{
    <div class="table-responsive">
        <table class="table table-dark table-hover table-sm">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Modified</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in projects)
                {
                    <tr style="cursor: pointer;" @onclick="() => OpenProject(p.Id)">
                        <td class="fw-bold">@(string.IsNullOrWhiteSpace(p.Title) ? Constants.Defaults.UntitledStory : p.Title)</td>
                        <td><span class="badge bg-secondary">@p.Status</span></td>
                        <td class="text-muted small">@p.Modified.ToString("yyyy-MM-dd HH:mm")</td>
                        <td>
                            @if (confirmArchiveId == p.Id)
                            {
                                <button class="btn btn-sm btn-warning py-0" @onclick="() => DoArchive(p.Id)" @onclick:stopPropagation="true"><div class="btn-lbl">Archive</div></button>
                                <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => confirmArchiveId = null" @onclick:stopPropagation="true"><div class="btn-lbl">No</div></button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary py-0" @onclick="() => confirmArchiveId = p.Id" @onclick:stopPropagation="true"><i class="bi bi-archive"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else if (!generating)
{
    <div class="text-center py-5 text-muted">
        <p>No stories yet.</p>
        <div class="d-flex gap-2 justify-content-center">
            <button class="btn btn-outline-primary" @onclick="SurpriseMe"><i class="bi bi-lightning"></i><div class="btn-lbl"> Surprise Me</div></button>
            <button class="btn btn-outline-warning" @onclick="OpenGuideMe"><i class="bi bi-compass"></i><div class="btn-lbl"> Guide Me</div></button>
            <button class="btn btn-outline-danger" @onclick="CreateNew"><div class="btn-lbl">New Story</div></button>
        </div>
    </div>
}

@code {
    private List<StoryProject> projects = [];
    private List<AutonomousStory> failedCheckpoints = [];
    private string? confirmArchiveId;
    private bool generating;
    private bool suggestionsLoading;
    private string progressMessage = "";
    private int progressCurrent, _progressTotal;
    private AutonomousStory? autonomousStory;
    private AutonomousStory? suggestionSource;
    private List<GeneratedStoryBeat> liveBeats = [];
    private List<BeatSuggestion> suggestedBeats = [];
    private CancellationTokenSource? cts;

    protected override void OnInitialized()
    {
        projects = Repo.ListProjects();
        LoadFailedCheckpoints();
        Director.OnProgress += OnDirectorProgress;
        CharRepo.Reload();
        allCharacters = CharRepo.GetAll();
        districts = DistrictRepo.GetAll();
    }

    // ── Guide Me modal state ────────────────────────────
    private bool guideMeOpen;
    private List<CharacterData> allCharacters = [];
    private List<DistrictData> districts = [];
    private List<string> selectedProtagonists = [];
    private string protagonistQuery = "";
    private string synopsisText = "";
    private string selectedLocation = "";
    private int selectedBeats = 8;
    private string guideMeError = "";

    private void OpenGuideMe()
    {
        selectedProtagonists = [];
        protagonistQuery = "";
        synopsisText = "";
        selectedLocation = "";
        selectedBeats = 8;
        guideMeError = "";
        guideMeOpen = true;
    }

    private void CloseGuideMe() => guideMeOpen = false;

    private IEnumerable<CharacterData> FilteredCharacters()
    {
        var q = protagonistQuery.Trim();
        var pool = allCharacters
            .Where(c => !selectedProtagonists.Contains(c.Name, StringComparer.OrdinalIgnoreCase));

        if (q.Length == 0)
            return pool.OrderBy(c => c.Name);

        return pool
            .Select(c => new { Char = c, Rank = MatchRank(c, q) })
            .Where(x => x.Rank < int.MaxValue)
            .OrderBy(x => x.Rank)
            .ThenBy(x => x.Char.Name)
            .Select(x => x.Char);
    }

    // Rank: 0 exact, 1 name starts-with, 2 token starts-with, 3 name ends-with,
    // 4 name contains, 5 alias match, 6 role match. int.MaxValue = no match.
    private static int MatchRank(CharacterData c, string q)
    {
        var cmp = StringComparison.OrdinalIgnoreCase;
        var name = c.Name ?? "";

        if (name.Equals(q, cmp)) return 0;
        if (name.StartsWith(q, cmp)) return 1;

        foreach (var token in name.Split(' ', StringSplitOptions.RemoveEmptyEntries))
            if (token.StartsWith(q, cmp)) return 2;

        if (name.EndsWith(q, cmp)) return 3;
        if (name.Contains(q, cmp)) return 4;

        if (c.Aliases?.Any(a => a.Contains(q, cmp)) == true) return 5;
        if (!string.IsNullOrEmpty(c.Role) && c.Role.Contains(q, cmp)) return 6;

        return int.MaxValue;
    }

    // Only canon characters (those with a character file) can be selected.
    // The name passed in must match a Character.Name from Canon.ListCharacters().
    private void AddProtagonist(string name)
    {
        var trimmed = name.Trim();
        if (trimmed.Length == 0) return;
        if (!allCharacters.Any(c => string.Equals(c.Name, trimmed, StringComparison.OrdinalIgnoreCase)))
            return;
        if (!selectedProtagonists.Contains(trimmed, StringComparer.OrdinalIgnoreCase))
            selectedProtagonists.Add(trimmed);
        protagonistQuery = "";
    }

    private void RemoveProtagonist(string name) =>
        selectedProtagonists.RemoveAll(p => string.Equals(p, name, StringComparison.OrdinalIgnoreCase));

    private void OnProtagonistKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var match = FilteredCharacters().FirstOrDefault();
        if (match != null) AddProtagonist(match.Name);
    }

    private bool CanStartGuided() =>
        selectedProtagonists.Count > 0
        && !string.IsNullOrWhiteSpace(synopsisText)
        && synopsisText.Trim().Length >= 20
        && !generating;

    private async Task StartGuided()
    {
        if (!CanStartGuided())
        {
            guideMeError = selectedProtagonists.Count == 0
                ? "Pick at least one protagonist."
                : "Synopsis needs at least 20 characters.";
            return;
        }

        var protags = selectedProtagonists.ToList();
        var synopsis = synopsisText.Trim();
        var loc = string.IsNullOrWhiteSpace(selectedLocation) ? null : selectedLocation;

        guideMeOpen = false;
        generating = true;
        liveBeats.Clear();
        progressMessage = $"Starting guided story for {protags[0]}...";
        progressCurrent = 0;
        _progressTotal = 0;
        cts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            autonomousStory = await Director.GuidedStoryAsync(protags, synopsis, loc, selectedBeats, cts.Token);

            if (autonomousStory.Complete)
            {
                var project = new StoryProject
                {
                    Id = autonomousStory.ProjectId,
                    Title = autonomousStory.Title,
                    Characters = autonomousStory.Characters,
                    Html = ConvertToHtml(autonomousStory),
                    Status = Constants.Status.Draft,
                };
                Repo.SaveProject(project);
                projects = Repo.ListProjects();
                Nav.NavigateTo($"/stories/write/{project.Id}");
            }
        }
        catch (OperationCanceledException) { progressMessage = "Cancelled."; }
        catch (Exception ex) { progressMessage = $"Error: {ex.Message}"; }
        finally { generating = false; StateHasChanged(); }
    }

    private void LoadFailedCheckpoints()
    {
        failedCheckpoints = Director.ListCheckpoints()
            .Where(c => !c.Complete && !string.IsNullOrEmpty(c.ProjectId))
            .OrderByDescending(c => c.LastModified)
            .ToList();
    }

    public void Dispose()
    {
        Director.OnProgress -= OnDirectorProgress;
        cts?.Cancel();
    }

    private void OnDirectorProgress(DirectorProgress p)
    {
        progressMessage = p.Message;
        progressCurrent = p.CurrentBeat;
        _progressTotal = p.TotalBeats;

        // Check if new beats arrived
        if (autonomousStory?.Beats.Count > liveBeats.Count)
            liveBeats = new List<GeneratedStoryBeat>(autonomousStory.Beats);

        InvokeAsync(StateHasChanged);
    }

    private void OpenProject(string id) => Nav.NavigateTo($"/stories/write/{id}");

    private void CreateNew()
    {
        var project = new StoryProject();
        Repo.SaveProject(project);
        Nav.NavigateTo($"/stories/write/{project.Id}");
    }

    [SupplyParameterFromQuery(Name = "protagonist")]
    public string? ProtagonistParam { get; set; }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(ProtagonistParam) && !generating)
            _ = SurpriseMeFor(ProtagonistParam);
    }

    private async Task SurpriseMeFor(string characterName)
    {
        generating = true;
        liveBeats.Clear();
        progressMessage = $"Starting story for {characterName}...";
        progressCurrent = 0;
        _progressTotal = 0;
        cts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            autonomousStory = await Director.SurpriseMeForAsync(characterName, cts.Token);

            if (autonomousStory.Complete)
            {
                var project = new StoryProject
                {
                    Id = autonomousStory.ProjectId,
                    Title = autonomousStory.Title,
                    Characters = autonomousStory.Characters,
                    Html = ConvertToHtml(autonomousStory),
                    Status = Constants.Status.Draft,
                };
                Repo.SaveProject(project);
                projects = Repo.ListProjects();
            }
        }
        catch (OperationCanceledException) { progressMessage = "Cancelled."; }
        catch (Exception ex) { progressMessage = $"Error: {ex.Message}"; }
        finally { generating = false; StateHasChanged(); }
    }

    private async Task SurpriseMe()
    {
        generating = true;
        liveBeats.Clear();
        progressMessage = "Initializing...";
        progressCurrent = 0;
        _progressTotal = 0;
        cts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            autonomousStory = await Director.SurpriseMeAsync(cts.Token);

            if (autonomousStory.Complete)
            {
                // Save as a StoryProject — reuse the AutonomousStory's ProjectId
                // so checkpoint, outline, events, and knowledge files stay associated
                var project = new StoryProject
                {
                    Id = autonomousStory.ProjectId,
                    Title = autonomousStory.Title,
                    Characters = autonomousStory.Characters,
                    Html = ConvertToHtml(autonomousStory),
                    Status = Constants.Status.Draft,
                };
                Repo.SaveProject(project);
                projects = Repo.ListProjects();

                // Navigate to the new story
                Nav.NavigateTo($"/stories/write/{project.Id}");
            }
        }
        catch (OperationCanceledException) { progressMessage = "Cancelled."; }
        catch (Exception ex) { progressMessage = $"Error: {ex.Message}"; }
        finally { generating = false; }
    }

    private void CancelGeneration() => cts?.Cancel();

    private async Task ResumeCheckpoint(AutonomousStory checkpoint, string? nextBeatGoal = null)
    {
        generating = true;
        liveBeats = new List<GeneratedStoryBeat>(checkpoint.Beats);
        autonomousStory = checkpoint;
        progressMessage = $"Resuming from beat {checkpoint.Beats.Count}...";
        progressCurrent = checkpoint.Beats.Count;
        _progressTotal = checkpoint.Outline?.Acts.Sum(a => a.Beats.Count) ?? 0;
        cts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            autonomousStory = await Director.ResumeStoryAsync(checkpoint, nextBeatGoal, cts.Token);

            if (autonomousStory.Complete)
            {
                var project = new StoryProject
                {
                    Id = autonomousStory.ProjectId,
                    Title = autonomousStory.Title,
                    Characters = autonomousStory.Characters,
                    Html = ConvertToHtml(autonomousStory),
                    Status = Constants.Status.Draft,
                };
                Repo.SaveProject(project);
                projects = Repo.ListProjects();
                LoadFailedCheckpoints();
                Nav.NavigateTo($"/stories/write/{project.Id}");
            }
            else
            {
                LoadFailedCheckpoints();
            }
        }
        catch (OperationCanceledException) { progressMessage = "Cancelled."; }
        catch (Exception ex) { progressMessage = $"Error: {ex.Message}"; LoadFailedCheckpoints(); }
        finally { generating = false; }
    }

    private void ArchiveCheckpoint(string projectId)
    {
        Director.ArchiveCheckpoint(projectId);
        LoadFailedCheckpoints();
    }

    private void DoArchive(string id)
    {
        Repo.DeleteProject(id);
        confirmArchiveId = null;
        projects.RemoveAll(p => p.Id == id);
    }

    private async Task GetSuggestions(AutonomousStory checkpoint)
    {
        if (checkpoint.Outline == null) return;
        suggestionsLoading = true;
        suggestionSource = checkpoint;
        StateHasChanged();

        try
        {
            var storySoFar = string.Join("\n\n", checkpoint.Beats.Select(b => b.Text));
            suggestedBeats = await Suggestions.SuggestNextBeatsAsync(
                checkpoint.ProjectId, checkpoint.Outline,
                checkpoint.Beats.Count - 1,
                checkpoint.Characters, checkpoint.Location ?? "The Shelf",
                storySoFar);
        }
        catch (Exception ex)
        {
            progressMessage = $"Suggestion failed: {ex.Message}";
        }
        finally
        {
            suggestionsLoading = false;
            StateHasChanged();
        }
    }

    private void PickSuggestion(int index)
    {
        if (suggestionSource == null || index >= suggestedBeats.Count) return;
        var chosen = suggestedBeats[index];
        suggestedBeats.Clear();
        var goalOverride = $"{chosen.Title}: {chosen.Description}";
        _ = ResumeCheckpoint(suggestionSource, goalOverride);
    }

    private void ClearSuggestions() => suggestedBeats.Clear();

    private static string ConvertToHtml(AutonomousStory story)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append($"<h1>{System.Web.HttpUtility.HtmlEncode(story.Title)}</h1>");
        sb.Append($"<p><em>Protagonist: {System.Web.HttpUtility.HtmlEncode(story.Protagonist)}</em></p>");

        int lastAct = 0;
        foreach (var beat in story.Beats)
        {
            if (beat.Act != lastAct)
            {
                var actName = story.Outline?.Acts.FirstOrDefault(a => a.ActNumber == beat.Act)?.Name ?? $"Act {beat.Act}";
                sb.Append($"<h2>Act {beat.Act}: {System.Web.HttpUtility.HtmlEncode(actName)}</h2>");
                lastAct = beat.Act;
            }

            // Convert newlines to paragraphs
            var paragraphs = beat.Text.Split(["\n\n", "\r\n\r\n"], StringSplitOptions.RemoveEmptyEntries);
            foreach (var p in paragraphs)
                sb.Append($"<p>{System.Web.HttpUtility.HtmlEncode(p.Trim())}</p>");

            sb.Append("<hr/>");
        }

        return sb.ToString();
    }
}
