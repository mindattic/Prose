    // ── LLM bottom sheet ──────────────────────────────────────────────────
    // Free-text instruction → calls ILlmService.GenerateAsync with the beat
    // text + neighbour context → previews the proposal → user picks Apply
    // (replaces beat.Text) or Discard.

    private void OpenLlmSheet(BeatEntity b)
    {
        llmSheetBeat = b;
        llmSheetBeatPosition = beats.FindIndex(x => x.Beat.Id == b.Id) + 1;
        llmSheetRefText = node != null ? $"{node.Id}.{b.Id}" : b.Id.ToString();
        llmSheetInstruction = "";
        llmSheetProposal = "";
        llmSheetRunning = false;
        llmSheetIdCopied = false;
    }

    private void CloseLlmSheet()
    {
        llmSheetBeat = null;
        llmSheetInstruction = "";
        llmSheetProposal = "";
        llmSheetRefText = "";
        llmSheetIdCopied = false;
    }

    private async Task CopyLlmSheetRefAsync()
    {
        if (string.IsNullOrEmpty(llmSheetRefText)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", llmSheetRefText);
            llmSheetIdCopied = true;
            StateHasChanged();
            await Task.Delay(1200);
            llmSheetIdCopied = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { Toast.Error("COPY-FAIL", ex.Message); }
    }

    private void DiscardLlmSheetProposal()
    {
        llmSheetProposal = "";
    }

    private async Task RunLlmSheetAsync()
    {
        if (llmSheetBeat == null || string.IsNullOrWhiteSpace(llmSheetInstruction) || llmSheetRunning) return;
        llmSheetRunning = true;
        llmSheetProposal = "";
        StateHasChanged();
        try
        {
            var bibleBlock = !string.IsNullOrWhiteSpace(node?.NodeBible)
                ? $"\n\nNODE BIBLE (the full story plan — stay consistent with this arc):\n{node!.NodeBible}"
                : "";
            var system = "You are an assistant rewriting a single beat of prose for a noir/cyberpunk narrative. " +
                         "Return ONLY the rewritten beat text — no preamble, no commentary, no quotes around it. " +
                         $"Preserve the beat's voice and tense unless the instruction says otherwise.{bibleBlock}";
            var nodeTitle = node?.Title ?? "(unknown node)";
            var user =
                $"NODE: {nodeTitle}\n" +
                $"REFERENCE: {llmSheetRefText}    (CLI handle: node-guid.beat-guid)\n" +
                $"POSITION: Beat #{llmSheetBeatPosition} in this node\n\n" +
                $"INSTRUCTION:\n{llmSheetInstruction.Trim()}\n\n" +
                $"CURRENT BEAT TEXT:\n{llmSheetBeat.Text}";
            var raw = await Llm.GenerateAsync(system, user, temperature: 0.7, maxTokens: 1500);
            llmSheetProposal = (raw ?? "").Trim();
            if (string.IsNullOrEmpty(llmSheetProposal))
                Toast.Info("LLM", "Empty response — try a different instruction.");
        }
        catch (Exception ex)
        {
            Toast.Error("LLM-FAIL", ex.Message);
        }
        finally
        {
            llmSheetRunning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ApplyLlmSheetAsync()
    {
        if (llmSheetBeat == null || string.IsNullOrEmpty(llmSheetProposal)) return;
        var beatId = llmSheetBeat.Id;
        try
        {
            await Workbench.UpdateBeatTextAsync(beatId, llmSheetProposal, expectedUpdatedAt: llmSheetBeat.UpdatedAt);
            // System-versioned: the pre-rewrite text is captured to history by
            // the UPDATE itself, so an LLM rewrite is a cyclable version too.
            llmSheetBeat.Text = llmSheetProposal;
            llmSheetBeat.UpdatedAt = DateTime.UtcNow;
            // Drop any draft so the reload reseeds this beat's textarea from the
            // LLM's new text (otherwise a stale draft would mask the rewrite).
            drafts.Remove(beatId);
            draftBase.Remove(beatId);
            Toast.Success("LLM", "Beat rewritten — audio invalidated; re-record to refresh.");
            CloseLlmSheet();
            await ReloadBeatsAsync();
        }
        catch (Exception ex)
        {
            Toast.Error("LLM-APPLY-FAIL", ex.Message);
        }
    }

    /// <summary>Render the WHOLE node as one continuous narration and save the
    /// MP3 to Downloads. One-pass on purpose: per-beat recording let the TTS
    /// voice drift between beats, so the audiobook tier assembles the full text
    /// (beats + inter-beat pauses) and tiers it — one request if it fits, else
    /// one per chapter, else split on length — for a cohesive read.
    ///
    /// Runs on the circuit's sync context and polls the in-memory export
    /// progress to drive the ring loader, exactly like the old combine did, so
    /// the page stays responsive while the render is in flight.</summary>
    private async Task PublishAudiobookAsync()
    {
        if (node == null || publishing || exportBusy) return;
        publishing = true;
        publishCurrent = 0;
        publishTotal = beats.Count;
        publishLabel = "narrating";
        await InvokeAsync(StateHasChanged);
        try
        {
            var task = Workbench.PublishAudiobookAsync(node.Id);
            while (!task.IsCompleted)
            {
                var p = Workbench.GetExportProgress(node.Id);
                if (p != null)
                {
                    publishCurrent = p.Current;
                    if (p.Total > 0) publishTotal = p.Total;
                    publishLabel = p.Label;
                }
                await InvokeAsync(StateHasChanged);
                await Task.Delay(150);
            }
            var path = await task; // observe the result and surface any exception
            await ReloadBeatsAsync();
            if (path == null) Toast.Info("AUDIOBOOK", "Nothing to narrate yet — add beat text first.");
            else Toast.Success("AUDIOBOOK", "Audiobook published — MP3 saved to your Downloads.");
        }
        catch (Exception ex) { Toast.Error("AUDIOBOOK-FAIL", ex.Message); }
        finally { publishing = false; await InvokeAsync(StateHasChanged); }
    }

