    /// <summary>Last beat the listener was playing, surfaced as a "resume here"
    /// banner + a green highlight ring on the row. Backed by
    /// Node.LastPlayedBeatId; written by OnBeatStarted as the JS player
    /// advances.</summary>
    private Guid? resumeBeatId;

    /// <summary>Token returned by streetsamurai.installPageEscape — handed
    /// back to uninstallPageEscape on Dispose so the keydown listener does
    /// not leak across page navigation.</summary>
    private string? escapeToken;

    /// <summary>Stable .NET-to-JS callback shim. JS holds this for play
    /// progress AND drag-drop callbacks. Disposed in Dispose so the GC can
    /// collect the page after navigation.</summary>
    private DotNetObjectReference<Node>? selfRef;

    /// <summary>Beat currently being synthesised by the per-beat preview
    /// button. Drives the spinner on that row; disables the play button
    /// on all other rows while the TTS call is in flight.</summary>
    private Guid? narratingBeatId;

