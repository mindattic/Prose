    private async Task DemoVoiceAsync()
    {
        if (node == null || demoing) return;
        if (string.IsNullOrWhiteSpace(editorProfile.VoiceId)) { Toast.Error("DEMO", "Pick a voice first."); return; }
        demoing = true;
        studioAudioUrl = null;
        StateHasChanged();
        try
        {
            var bytes = await Workbench.AuditionVoiceAsync(node.Id, editorProfile,
                text: NodeWorkbenchService.DemoSampleText);
            studioAudioLabel = "Demo — synthesized with your dials";
            studioAudioUrl = "data:audio/mpeg;base64," + Convert.ToBase64String(bytes);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Demo failed for node {S}", node.Id);
            Toast.Error("DEMO", ex.Message);
        }
        finally { demoing = false; StateHasChanged(); }
    }

    /// <summary>Synthesize a demo passage through the selected local engine
    /// (Kokoro or Piper) and play it in the engine-row audio element.</summary>
    private async Task DemoLocalAsync()
    {
        if (node == null || localDemoing) return;
        localDemoing = true;
        studioAudioUrl = null;
        StateHasChanged();
        try
        {
            var wav = await Workbench.SynthesizeLocalBeatAsync(
                NodeWorkbenchService.DemoSampleText, selectedEngine);
            if (wav == null)
            {
                Toast.Error("LOCAL-DEMO", "ffmpeg not found on PATH — required for local TTS preview.");
                return;
            }
            studioAudioLabel = $"Demo — {selectedEngine} synthesis";
            studioAudioUrl = "data:audio/wav;base64," + Convert.ToBase64String(wav);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Local demo failed for node {S} engine {E}", node.Id, selectedEngine);
            var engineHint = selectedEngine == "kokoro"
                ? "Kokoro not installed — see tools/kokoro/README for one-time setup."
                : "Piper not installed — see tools/piper/README for one-time setup.";
            Toast.Error("LOCAL-DEMO", ex.Message.Contains("not installed") ? engineHint : ex.Message);
        }
        finally { localDemoing = false; StateHasChanged(); }
    }

