</style>

<ReviewsModal Visible="reviewsOpen" Title="@reviewModalTitle" Items="reviewModalItems"
              Max="reviewModalMax" ScoreSuffix="@reviewModalSuffix"
              OnClose="@(() => { reviewsOpen = false; })" />

@code {
    [Parameter] public string IdOrSlug { get; set; } = "";

    private NodeEntity? node;

    // ── Reviews modal (shared sortable component; node = full reviews, beat = micro) ──
    private bool reviewsOpen;
    private string reviewModalTitle = "";
    private double reviewModalMax = 100;
    private string reviewModalSuffix = "/100";
    private List<ReviewsModal.Item> reviewModalItems = new();

    // Traffic-light thresholds per SS-US-J4: ≥80 green, 70–79 yellow, <70 red.
    private static string ScorePctColor(double pct) => pct >= 80 ? "success" : pct >= 70 ? "warning" : "danger";

    private async Task OpenNodeReviewsAsync()
    {
        if (node == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var all = await db.NodeReviews
            .Where(r => r.NodeId == node.Id)
            .Include(r => r.BeatScores)
            .ToListAsync();
        reviewModalTitle = $"Reader reviews — {node.Title}";
        reviewModalMax = 100; reviewModalSuffix = "/100";
        if (all.Count == 0) { reviewModalItems = new(); reviewsOpen = true; return; }

        // Rows = the personas in the latest run's Group panels; each expands to that
        // persona's FULL history (every run, newest first) with body + per-beat micros.
        var latestHash = all.OrderByDescending(r => r.ReviewedAt).Select(r => r.ContentHash).First();
        var latestPersonas = all
            .Where(r => r.ContentHash == latestHash && r.FocusGroupName != null && r.FocusGroupName.StartsWith("Group"))
            .Select(r => r.PersonaId).ToHashSet();
        reviewModalItems = all
            .Where(r => latestPersonas.Contains(r.PersonaId))
            .GroupBy(r => r.PersonaId)
            .Select(g =>
            {
                var ordered = g.OrderByDescending(r => r.ReviewedAt).ToList();
                var latest = ordered[0];
                var history = ordered.Select(r => new ReviewsModal.HistoryEntry(
                    r.ReviewedAt.ToLocalTime().ToString("MM-dd HH:mm"),
                    r.ContentHash.Length >= 6 ? r.ContentHash[..6] : r.ContentHash,
                    r.Score,
                    string.IsNullOrWhiteSpace(r.Improvements) ? r.ReviewText : r.ReviewText + "\n\nFixes:\n" + r.Improvements,
                    r.BeatScores.Count > 0 ? r.BeatScores.OrderBy(b => b.BeatNumber).Select(b => b.Score).ToList() : null))
                    .ToList();
                return new ReviewsModal.Item(latest.PersonaName, latest.ProviderId, latest.Score,
                    PersonaLibrary.GetProfile(g.Key)?.Summary(), history);
            })
            .ToList();
        reviewsOpen = true;
    }

    private async Task OpenBeatReviewsAsync(int positional, BeatEntity b)
    {
        if (node == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var all = await db.NodeReviews
            .Where(r => r.NodeId == node.Id && r.BeatScores.Any(bs => bs.BeatNumber == positional))
            .Include(r => r.BeatScores)
            .ToListAsync();
        reviewModalItems = all
            .GroupBy(r => r.PersonaId)
            .Select(g =>
            {
                var ordered = g.OrderByDescending(r => r.ReviewedAt).ToList();
                var latest = ordered[0];
                static double Micro(NodeReview r, int pos) =>
                    r.BeatScores.Where(bs => bs.BeatNumber == pos).Select(bs => (double)bs.Score).FirstOrDefault();
                var history = ordered.Select(r => new ReviewsModal.HistoryEntry(
                    r.ReviewedAt.ToLocalTime().ToString("MM-dd HH:mm"),
                    r.ContentHash.Length >= 6 ? r.ContentHash[..6] : r.ContentHash,
                    Micro(r, positional),
                    ExtractBeatNote(r.Improvements, positional),
                    null)).ToList();
                return new ReviewsModal.Item(latest.PersonaName, latest.ProviderId, Micro(latest, positional),
                    PersonaLibrary.GetProfile(g.Key)?.Summary(), history);
            })
            .ToList();
        var title = string.IsNullOrEmpty(b.BeatTitle) ? $"Beat #{positional}" : $"Beat #{positional} — {b.BeatTitle}";
        reviewModalTitle = $"{title} · micro-reviews";
        reviewModalMax = 5; reviewModalSuffix = "/5";
        reviewsOpen = true;
    }

    private static string ExtractBeatNote(string? improvements, int positional)
    {
        if (string.IsNullOrWhiteSpace(improvements)) return "";
        var hits = improvements
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(l => l.Contains($"Beat {positional}", StringComparison.OrdinalIgnoreCase));
        return string.Join("\n", hits);
    }
    /// <summary>UpdatedAt of the node row at the moment LoadAsync ran.
    /// Passed back into SaveNodeHeaderAsync as an optimistic-concurrency
    /// check — if the row moved underneath us (another tab, an MCP tool),
    /// the save aborts with a toast instead of silently clobbering the
    /// other write.</summary>
    private DateTime? nodeLoadedUpdatedAt;
    private List<NodeWorkbenchService.OrderedBeat> beats = new();
    /// <summary>Ancestors of the current node, root first. Empty if this is
    /// a top-level node. Used for the breadcrumb at the page header.</summary>
    private List<NodeEntity> ancestors = new();
    /// <summary>Direct children of the current node. A book node shows
    /// its chapter children here so the user can navigate down without
    /// going back to /nodes.</summary>
    private List<NodeEntity> children = new();
    private bool loading = true;
    private bool working;
    private bool showBible;
    private bool bibleGenerating;
    /// <summary>The beat whose Save is mid-flight (drives the spinner on that
    /// one row's check button). Null when nothing is saving.</summary>
    private Guid? savingBeatId;

    // ── Per-beat draft model ─────────────────────────────────────────────
    // Every beat is always an editable textarea (no read-only view), so each
    // needs its own live draft + concurrency token rather than the old single
    // editingBeatId/editingText pair. drafts[id] is the current textarea text;
    // draftBase[id] is the Beat.UpdatedAt captured when the draft was seeded,
    // passed back on save so the workbench can detect "another tab/MCP-tool
    // wrote in between" and surface a conflict instead of clobbering.
    private readonly Dictionary<Guid, string> drafts = new();
    private readonly Dictionary<Guid, DateTime> draftBase = new();

    // ── Per-beat version cycler (system-versioned temporal history) ───────
    // historyCounts: how many stored versions (current + history) each beat
    // has, from the Beats_History temporal table — drives the arrows' disabled
    // state. Refreshed from the DB after each genuine (re)load. historyCursor:
    // which version the editor is previewing — 0 = current/most-recent edit,
    // higher = further back in history. Capture is automatic (every UPDATE is
    // versioned by SQL Server), so there's nothing to push from the client.
    private readonly Dictionary<Guid, int>      historyCounts     = new();
    private readonly Dictionary<Guid, int>      historyCursor     = new();
    private readonly Dictionary<Guid, DateTime> historyTimestamps = new();
    private bool showDisabledBeats;

    /// <summary>Return this beat's live draft text, seeding it from the
    /// canonical Beat.Text on first access. Called from the textarea's
    /// @bind:get on every render — must be cheap and side-effect-light.</summary>
    private string DraftFor(BeatEntity b)
    {
        if (!drafts.TryGetValue(b.Id, out var t))
        {
            t = b.Text ?? "";
            drafts[b.Id] = t;
            draftBase[b.Id] = b.UpdatedAt;
        }
        return t;
    }

    /// <summary>@bind:set target — record what the user typed.</summary>
    private void OnDraftSet(Guid beatId, string value) => drafts[beatId] = value ?? "";

    /// <summary>True when the draft differs from the saved beat text.</summary>
    private bool IsDirty(BeatEntity b)
        => drafts.TryGetValue(b.Id, out var t) && t != (b.Text ?? "");

    /// <summary>Discard a beat's unsaved edits back to the saved text.</summary>
    private void RevertDraft(BeatEntity b)
    {
        drafts[b.Id] = b.Text ?? "";
        draftBase[b.Id] = b.UpdatedAt;
        autoSizePendingBeatId = b.Id;
    }

    /// <summary>Reconcile drafts against a freshly reloaded beat list. Clean
    /// (or absent) drafts are reseeded to the new text + token so re-records
    /// and external edits to untouched beats don't leave a stale concurrency
    /// token or a false "dirty" flag. Drafts the user has actually changed are
    /// preserved verbatim. Drafts for deleted beats are dropped.</summary>
    private void SyncDraftsAfterReload()
    {
        var live = new HashSet<Guid>();
        foreach (var ob in beats)
        {
            var id = ob.Beat.Id;
            var txt = ob.Beat.Text ?? "";
            live.Add(id);
            if (!drafts.TryGetValue(id, out var d) || d == txt)
            {
                drafts[id] = txt;
                draftBase[id] = ob.Beat.UpdatedAt;
            }
            // else: unsaved user edit — keep the draft and its original token.
        }
        foreach (var stale in drafts.Keys.Where(k => !live.Contains(k)).ToList())
        {
            drafts.Remove(stale);
            draftBase.Remove(stale);
            historyCounts.Remove(stale);
            historyCursor.Remove(stale);
        }
        sizeAllPending = true;
    }

    /// <summary>Set after any (re)load of the beat list so OnAfterRenderAsync
    /// runs one pass of autosize across every textarea — each beat now renders
    /// its own editor, so they all need sizing, not just the active one.</summary>
    private bool sizeAllPending;

    /// <summary>When set, the beat-details metadata panel is open for this beat.</summary>
    private Guid? metaOpenBeatId;
    /// <summary>Working copy of the meta panel form. Re-populated from the
    /// beat each time the panel opens; not persisted until Save.</summary>
    private MetaForm metaForm = new();
    /// <summary>Beat id + owning node id captured at the moment the user
    /// clicks Delete. The owning node may differ from the top-level
    /// <see cref="node"/> when we are viewing a collection whose beats
    /// come from child nodes — passing the wrong node id to
    /// <see cref="NodeWorkbenchService.DeleteBeatAsync"/> would silently
    /// no-op because the junction lookup finds nothing.</summary>
    private (Guid BeatId, Guid OwningNodeId)? pendingDelete;
    private System.Threading.Timer? poll;
    private string? lastIdOrSlug;

    /// <summary>One-shot guard for the deep-link #beat-… fragment scroll —
    /// fire it on the first render where beat rows exist, never again.</summary>
    private bool fragmentScrolled;

    /// <summary>Per-beat "just copied to clipboard" flash state. The copy-text
    /// button toggles to a check icon for ~1.4s after a successful copy.</summary>
    private Guid? copiedTextBeatId;

    // ── Publish (combined export) progress ───────────────────────────────
    /// <summary>True while a Publish/combine is running — drives the ring-loader
    /// overlay. The export runs on the circuit's sync context and the handler
    /// polls <see cref="NodeWorkbenchService.GetExportProgress"/> between its
    /// await points to update the ring.</summary>
    private bool publishing;
    private int publishCurrent;
    private int publishTotal;
    private string? publishLabel;

    // ── Reader panel (in-UI sampled review) — EXPLICIT Cloud/Local brain. ──────
    private bool reviewRunning;
    private bool reviewUseLocal;            // selected brain; false = cloud trusted-4 (default)
    private int reviewProgress;
    private bool reviewRanLocal;            // brain that actually produced reviewResult
    private string reviewRanModel = "";
    private NodeReviewService.SampledRunResult? reviewResult;

    /// <summary>Run the economical sampled reader panel on the currently-selected
    /// brain (cloud trusted-4 by default, or the local Ollama model when the Local
    /// toggle is on). The result panel always states which brain ran.</summary>
    private async Task RunReaderPanelAsync()
    {
        if (node is null || reviewRunning) return;
        reviewRunning  = true;
        reviewResult   = null;
        reviewProgress = 0;
        reviewRanLocal = reviewUseLocal;
        reviewRanModel = reviewUseLocal ? Settings.LocalReviewModel : "trusted-4 panel";
        StateHasChanged();
        try
        {
            var progress = new Progress<int>(n => { reviewProgress = n; _ = InvokeAsync(StateHasChanged); });
            reviewResult = await ReviewSvc.RunSampledReviewAsync(
                node.Id, Settings.ReviewBallots, Settings.ReviewProse, progress,
                useLocal: reviewUseLocal);
            if (reviewResult.BlockedByStructure)
                Toast.Error("REVIEW", "Blocked by structural pre-flight — fix the failures, then re-run.");
            else
                Toast.Success("REVIEW", $"{(reviewRanLocal ? "LOCAL" : "CLOUD")} reader panel: {reviewResult.MeanScore:0.0}/100 ({reviewResult.BallotsSaved} ballots).");
        }
        catch (Exception ex)
        {
            Toast.Error("REVIEW-FAIL", ex.Message);
        }
        finally
        {
            reviewRunning = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Structural diagnostics (J5) ──────────────────────────────────────────
    private bool diagRunning;
    private StructuralDiagnosisResult? diagResult;

    private async Task RunDiagnosticsAsync()
    {
        if (node is null || diagRunning) return;
        diagRunning = true;
        diagResult  = null;
        StateHasChanged();
        try
        {
            diagResult = await DiagSvc.DiagnoseNodeAsync(node.Id);
        }
        catch (Exception ex)
        {
            Toast.Error("DIAG-FAIL", ex.Message);
        }
        finally
        {
            diagRunning = false;
            await InvokeAsync(StateHasChanged);
        }
    }
    /// <summary>True while a file manuscript export (Word/PDF/Markdown/text) is
    /// running (drives the Export button spinner). Cheap/synchronous-ish; no
    /// ring — the audiobook is the only export that drives the progress ring.</summary>
    private bool exportBusy;
    private const double PublishRingRadius = 54;
    private double PublishRingCircumference => 2 * Math.PI * PublishRingRadius;
    /// <summary>Capped at 99% on purpose — the ring never shows a full 100%
    /// while work is outstanding; the overlay closes when the export completes.</summary>
    private int PublishPercent => publishTotal > 0 ? Math.Min(99, (int)(100.0 * publishCurrent / publishTotal)) : 0;
    private double PublishRingOffset => PublishRingCircumference * (1 - PublishPercent / 100.0);
    private string PublishRingDash => PublishRingCircumference.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    private string PublishRingOff  => PublishRingOffset.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    // ── LLM bottom-sheet state ───────────────────────────────────────────
    /// <summary>When non-null, the bottom sheet is open with this beat as
    /// context. Cleared on close.</summary>
    private BeatEntity? llmSheetBeat;
    private int llmSheetBeatPosition;
    private string llmSheetInstruction = "";
    private string llmSheetProposal = "";
    private bool llmSheetRunning;
    private bool llmSheetIdCopied;
    /// <summary>Stable node.beat reference printed in the sheet header
    /// and used as the CLI handle ("node-guid.beat-guid"). Built when
    /// the sheet opens so it's always populated alongside the beat.</summary>
    private string llmSheetRefText = "";

    private string defaultVoiceId = "";
    private List<TtsVoice> voices = new();

    // ── Voice Studio ───────────────────────────────────────────────────────
    // Pick any v2/v3 voice, turn its dials, audition Beat 001 (throwaway), then
    // pin it to this node and/or save it as a reusable profile. editorProfile
    // is the live dial set being tuned; it is seeded from the node's current
    // voice snapshot whenever a node loads.
    private bool showVoiceStudio;
    private StreetSamurai.Core.Models.VoiceProfile editorProfile = new() { Model = "eleven_multilingual_v2", Stability = 0.5, SimilarityBoost = 0.75, Style = 0.0, UseSpeakerBoost = true };
    private bool demoing;
    private string? studioAudioUrl;
    private string studioAudioLabel = "";
    private string newProfileLabel = "";
    private bool importingVoices;

    // ── Per-node TTS engine selector ────────────────────────────────────
    // selectedEngine mirrors Node.TtsEngine on the page (null/"elevenlabs",
