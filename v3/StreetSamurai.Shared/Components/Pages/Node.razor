    private void RequestDeleteAsync(Guid beatId)
    {
        // Capture the owning node from the in-memory beat list — when
        // viewing a collection, beats from child nodes carry that child's
        // node id, NOT the parent's. Passing the wrong id to DeleteBeatAsync
        // would silently no-op because the junction WHERE NodeId=X finds
        // nothing. Escape handler is installed once on first render.
        var owning = beats.FirstOrDefault(b => b.Beat.Id == beatId)?.NodeId
                     ?? node!.Id;
        pendingDelete = (beatId, owning);
    }
    private void CancelDelete() => pendingDelete = null;

    private async Task ConfirmDeleteAsync()
    {
        if (node == null || pendingDelete == null) return;
        var (bid, owningNodeId) = pendingDelete.Value;
        pendingDelete = null;
        working = true;
        StateHasChanged();
        try
        {
            await Workbench.DeleteBeatAsync(owningNodeId, bid);
            await ReloadBeatsAsync();
            Toast.Success("DELETE", "Beat removed.");
        }
        catch (Exception ex) { Toast.Error("DELETE-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }


