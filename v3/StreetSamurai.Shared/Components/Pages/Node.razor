    /// Null when no preview is running.</summary>
    private Guid? playingBeatId;

    /// <summary>True when the active preview beat is paused mid-playback.</summary>
    private bool beatPreviewPaused;

    /// <summary>True once JS has been told about the beat-row container.
    /// Drag handlers attach once and are idempotent on the JS side.</summary>
    private bool dragHandlersAttached;

    private int TotalChars    => beats.Sum(b => b.Beat.Text?.Length ?? 0);

    protected override async Task OnInitializedAsync()
    {
        defaultVoiceId = Settings.ElevenLabsVoiceId ?? "";
        try
        {
            voices = (await Tts.ListVoicesAsync()).OrderBy(v => v.Name).ToList();
            if (!string.IsNullOrEmpty(defaultVoiceId) && !voices.Any(v => v.VoiceId == defaultVoiceId))
                voices.Insert(0, new TtsVoice { VoiceId = defaultVoiceId, Name = "(saved default)" });
        }
        catch
        {
            voices = new() { new TtsVoice { VoiceId = defaultVoiceId, Name = "Default" } };
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (lastIdOrSlug == IdOrSlug) return;
        lastIdOrSlug = IdOrSlug;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Per-instance Escape handler — registers via JS interop and
            // returns a token we hand back on Dispose. Replaces the old
            // window-flag eval hook that leaked across page navigation.
            try { escapeToken = await JS.InvokeAsync<string>("streetsamurai.installPageEscape"); }
            catch { /* JS not loaded yet — selection-bar Esc just won't fire */ }
        }
        // Honor a #beat-… fragment once the beat rows exist. Blazor's router
        // doesn't scroll to fragments on its own, so deep links into a long
        // (book) node would otherwise land at the top.
        if (!fragmentScrolled && beats.Count > 0)
        {
            fragmentScrolled = true;
            var frag = new Uri(Nav.Uri).Fragment;
            if (frag.StartsWith("#beat-") && Guid.TryParseExact(frag["#beat-".Length..], "N", out var fragBeat))
            {
                try { await JS.InvokeVoidAsync("streetsamurai.scrollBeatIntoView", fragBeat.ToString()); }
                catch { /* JS not loaded yet — non-fatal, TOC click still works */ }
            }
        }

        // Wire drag-and-drop reorder handlers as soon as the beats container
        // exists. Idempotent on the JS side; the C# guard avoids the extra
        // interop hop on every re-render.
        if (!dragHandlersAttached && node != null && beats.Count > 0)
        {
            try
            {
                selfRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("streetsamurai.attachBeatDragHandlers", "node-beats-root", selfRef);
                dragHandlersAttached = true;
            }
            catch { /* JS load race — try again next render */ }
        }
        // After any (re)load, size EVERY beat's textarea to its content —
        // all beats render their own editor now, so a single per-beat autosize
        // isn't enough. One JS call walks them all; cheap and idempotent.
        if (sizeAllPending)
        {
            sizeAllPending = false;
            try { await JS.InvokeVoidAsync("streetsamurai.autoSizeAllTextareas", "node-beats-root"); }
            catch { /* JS not loaded yet — first input on each textarea will size it */ }
        }
        // If a beat was just inserted / reverted, size its textarea to match the
        // content height and focus it. Subsequent typing keeps it sized via
        // @oninput on the textarea itself.
        if (autoSizePendingBeatId is { } b)
        {
            autoSizePendingBeatId = null;
            await AutoSizeTextareaAsync(b);
            // Move focus to the textarea via a typed helper. Runs on the
            // circuit thread (no Task.Run, no eval, no hard delay race
            // against the render).
            try { await JS.InvokeVoidAsync("streetsamurai.focusElement", $"beat-{b:N}-edit"); }
            catch { /* JS not loaded yet — focus just won't move; non-fatal */ }
        }
    }

    /// <summary>The beat id whose textarea was just revealed and needs an
    /// initial autosize once the DOM has settled. Set by StartBeatEdit;
    /// cleared by OnAfterRenderAsync after the JS interop call.</summary>
    private Guid? autoSizePendingBeatId;

    /// <summary>Beat whose read-view was clicked; shows the textarea for that beat until blur-without-changes.</summary>
    private Guid activeBeatEditId = Guid.Empty;

    private void StartReadViewEdit(Guid beatId)
    {
        activeBeatEditId = beatId;
        autoSizePendingBeatId = beatId;
    }

    /// <summary>Tell the textarea for this beat to shrink/grow its height
    /// to match its content. Called on every input + once when edit mode
    /// opens. JS interop is wrapped in try/catch so we don't bubble up
    /// when the script hasn't loaded yet (cold-start race).</summary>
    private async Task AutoSizeTextareaAsync(Guid beatId)
    {
        var elementId = $"beat-{beatId:N}-edit";
        try { await JS.InvokeVoidAsync("streetsamurai.autoSizeTextarea", elementId); }
        catch { /* JS not yet loaded — initial autosize will fire on first input instead */ }
    }

    private async Task LoadAsync()
    {
        loading = true;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            if (Guid.TryParse(IdOrSlug, out var guid))
                node = await db.Nodes.FirstOrDefaultAsync(s => s.Id == guid);
            if (node == null)
                node = await db.Nodes.FirstOrDefaultAsync(s => s.Slug == IdOrSlug);

            if (node != null)
            {
                nodeLoadedUpdatedAt = node.UpdatedAt;
                if (string.IsNullOrEmpty(node.VoiceId)) node.VoiceId = defaultVoiceId;
                SeedVoiceEditorFromNode();
                beats = await Workbench.GetOrderedBeatsAsync(node.Id, includeDisabled: showDisabledBeats);
                SyncDraftsAfterReload();
                await RefreshHistoryCountsAsync();

                // Surface the saved listening position so the user can jump back
                // to where they walked away. Cleared from the banner if the beat
                // no longer exists (deleted between sessions).
                resumeBeatId = node.LastPlayedBeatId;

                // Walk ancestors (root first) and load direct children.
                ancestors = await LoadAncestorsAsync(db, node.ParentNodeId);
                children = await db.Nodes.AsNoTracking()
                    .Where(s => s.ParentNodeId == node.Id)
                    .OrderBy(s => s.SortKey)
                    .ToListAsync();

                if (node.Status is "narrating" or "generating")
                    StartPolling();
            }
        }
        catch (Exception ex)
        {
            // Surface load failure (cycle in a corrupted parent chain,
            // transient DB blip) instead of nodeing the user on a
            // perpetual spinner. node stays null → the "No node found"
            // alert renders.
            Toast.Error("NODE-LOAD-FAIL", ex.Message);
            Console.Error.WriteLine($"[node-load] {IdOrSlug}: {ex}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private static async Task<List<NodeEntity>> LoadAncestorsAsync(StreetSamuraiDbContext db, Guid? parentId)
    {
        var chain = new List<NodeEntity>();
        var visited = new HashSet<Guid>();
        var current = parentId;
        // Same cycle guard the workbench uses for beat traversal — a
        // corrupted parent loop shouldn't hang the page.
        while (current is { } id && visited.Add(id))
        {
            var p = await db.Nodes.AsNoTracking().FirstOrDefaultAsync(s => s.Id == id);
            if (p == null) break;
            chain.Insert(0, p);
            current = p.ParentNodeId;
        }
        return chain;
    }

    private void StartPolling()
    {
        poll?.Dispose();
        poll = new System.Threading.Timer(async _ =>
        {
            // Defensive try/catch: a transient DB disconnect on the timer
            // thread used to crash silently in unobserved-exception land
            // and the UI would freeze on "narrating" forever. Now we log
            // and keep ticking — the next interval gets a fresh attempt.
            try
            {
                if (node == null) return;
                await using var db = await DbFactory.CreateDbContextAsync();
                var fresh = await db.Nodes.AsNoTracking().FirstOrDefaultAsync(s => s.Id == node.Id);
                if (fresh == null) return;
                node.Status = fresh.Status;
                node.CombinedAudioPath = fresh.CombinedAudioPath;
                node.CharsNarrated = fresh.CharsNarrated;
                beats = await Workbench.GetOrderedBeatsAsync(node.Id, includeDisabled: showDisabledBeats);
                SyncDraftsAfterReload();
                await InvokeAsync(StateHasChanged);
                if (node.Status is "ready" or "failed" or "stopped")
                {
                    poll?.Dispose();
                    poll = null;
                }
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[node-poll] tick failed for {node?.Id}: {ex.Message}");
            }
        }, null, TimeSpan.FromSeconds(2), TimeSpan.FromSeconds(3));
    }

    private async Task SaveNodeHeaderAsync()
    {
        if (node == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var s = await db.Nodes.FirstOrDefaultAsync(x => x.Id == node.Id);
        if (s == null) return;
        // Optimistic concurrency: refuse to write if the node's UpdatedAt
        // moved between LoadAsync and now (another tab / MCP tool wrote in
        // between). Without this check, the last-saver silently wins and
        // the first-saver's edit vanishes with no signal.
        if (nodeLoadedUpdatedAt is { } expected
            && Math.Abs((s.UpdatedAt - expected).TotalMilliseconds) > 1)
        {
            Toast.Error("NODE-CONFLICT", "Another change landed since you opened the page — reload and re-apply.");
            return;
        }
        s.Title = node.Title;
        s.Synopsis = node.Synopsis;
        s.VoiceId = node.VoiceId;
        s.TtsEngine = (selectedEngine == "elevenlabs" || selectedEngine == "webspeech") ? null : selectedEngine;
        s.UpdatedAt = DateTime.UtcNow;
        await db.SaveChangesAsync();
        nodeLoadedUpdatedAt = s.UpdatedAt;
    }

    /// <summary>Toggle IsCanon on this node — the author-only trust gate (SS-LAW-9).
    /// Canon nodes are the gold standard for voice-harvest; only the author sets this.</summary>
    private async Task ToggleCanonAsync()
    {
        if (node == null || working) return;
        working = true;
        StateHasChanged();
        try
        {
            var newVal = !node.IsCanon;
            var ok = await Workbench.SetCanonAsync(node.Id, newVal);
            if (ok)
            {
                node.IsCanon = newVal;
                Toast.Success("CANON",
                    newVal
                        ? "Node marked Canon — the voice-harvest gold standard (SS-LAW-9)."
                        : "Canon mark cleared.");
            }
        }
        catch (Exception ex) { Toast.Error("CANON-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    /// <summary>Persist the local-engine dials (VoiceId, VoiceStyle, VoiceStability)
    /// for Kokoro/Piper without touching other ElevenLabs-specific columns.</summary>
    private async Task SaveLocalEngineAsync()
    {
        if (node == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var s = await db.Nodes.FirstOrDefaultAsync(x => x.Id == node.Id);
        if (s == null) return;
        s.TtsEngine    = selectedEngine == "webspeech" ? null : selectedEngine;
        s.VoiceId      = localVoiceId;
        // VoiceStyle  → kokoro speed; piper noise_scale
        s.VoiceStyle   = localSpeed;
        // VoiceStability → piper length_scale; null for kokoro
        s.VoiceStability = selectedEngine == "piper" ? localLengthScale : null;
        s.UpdatedAt    = DateTime.UtcNow;
        await db.SaveChangesAsync();
        nodeLoadedUpdatedAt = s.UpdatedAt;
        // Sync back the in-memory node so the right-column Voice selector stays consistent
        node.TtsEngine = s.TtsEngine;
        node.VoiceId   = s.VoiceId;
    }

    /// <summary>Called when the engine dropdown changes. Persists immediately.
    /// Browser Voice (webspeech) is preview-only and is never written to TtsEngine.</summary>
    private async Task OnEngineChangedAsync()
    {
        studioAudioUrl = null;
        if (selectedEngine == "webspeech")
        {
            // Stop any active playback from previous engine; load OS voices
            await StopWebSpeechAsync();
            await LoadWebSpeechVoicesAsync();
        }
        else
        {
            webSpeaking = false;
            if (selectedEngine == "elevenlabs")
                await SaveNodeHeaderAsync();
            else
                await SaveLocalEngineAsync();
        }
    }

    /// <summary>Seed a beat's draft and queue focus + autosize on its
    /// textarea. All beats are always editable now, so this is just the
    /// "jump the caret into this beat" helper — used after inserting a new
    /// beat so the user lands in it ready to type. Flag is honoured in
    /// OnAfterRenderAsync once the DOM exists (no Task.Run / eval race).</summary>
    private void StartBeatEdit(BeatEntity b)
    {
        if (!drafts.ContainsKey(b.Id))
        {
            drafts[b.Id] = b.Text ?? "";
            draftBase[b.Id] = b.UpdatedAt;
        }
        autoSizePendingBeatId = b.Id;
    }

    private void ToggleMeta(Guid beatId)
    {
        if (metaOpenBeatId == beatId)
        {
            metaOpenBeatId = null;
            return;
        }
        var beat = beats.FirstOrDefault(b => b.Beat.Id == beatId)?.Beat;
        if (beat == null) return;
        metaForm = new MetaForm
        {
            BeatTitle      = beat.BeatTitle ?? "",
            Synopsis       = beat.Synopsis ?? "",
            EmotionalTone  = beat.EmotionalTone ?? "",
            PaceHint       = beat.PaceHint ?? "",
            StructureRole  = beat.StructureRole ?? "",
            Act            = beat.Act,
            SceneType      = string.IsNullOrEmpty(beat.SceneType) ? "scene" : beat.SceneType,
            IsChapterStart = beat.IsChapterStart,
            Kind           = string.IsNullOrEmpty(beat.Kind) ? "prose" : beat.Kind,
        };
        metaOpenBeatId = beatId;
    }

    private void CancelMeta() => metaOpenBeatId = null;

    private async Task SaveMetaAsync(Guid beatId)
    {
        if (working) return;
        working = true;
        StateHasChanged();
        try
        {
            await Workbench.UpdateBeatMetadataAsync(beatId, new NodeWorkbenchService.BeatMetadataUpdate(
                BeatTitle:      metaForm.BeatTitle,
                Synopsis:       metaForm.Synopsis,
                EmotionalTone:  metaForm.EmotionalTone,
                PaceHint:       metaForm.PaceHint,
                StructureRole:  metaForm.StructureRole,
                Act:            metaForm.Act,
                SceneType:      metaForm.SceneType,
                IsChapterStart: metaForm.IsChapterStart,
                Kind:           metaForm.Kind));
            await ReloadBeatsAsync();
            metaOpenBeatId = null;
            Toast.Success("BEAT-META", "Beat details saved. Re-record this beat to apply the new tone.");
        }
        catch (Exception ex) { Toast.Error("BEAT-META-FAIL", ex.Message); }
        finally { working = false; await InvokeAsync(StateHasChanged); }
    }

    /// <summary>Local working copy of the meta editor's bound values. Kept
    /// separate from the beat row so cancel / close discards pending
    /// changes without touching the DB.</summary>
    private class MetaForm
    {
        public string BeatTitle { get; set; } = "";
        public string Synopsis { get; set; } = "";
        public string EmotionalTone { get; set; } = "";
        public string PaceHint { get; set; } = "";
        public string StructureRole { get; set; } = "";
        public int Act { get; set; }
        public string SceneType { get; set; } = "scene";
        public bool IsChapterStart { get; set; }
        public string Kind { get; set; } = "prose";
    }

    private async Task OnEditorKeydown(KeyboardEventArgs e, BeatEntity b)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey)) await SaveBeatEditAsync(b.Id);
        else if (e.Key == "Escape") RevertDraft(b);
    }

    private async Task SaveBeatEditAsync(Guid beatId)
    {
        if (node == null || savingBeatId != null) return;
        if (!drafts.TryGetValue(beatId, out var text)) return; // nothing seeded
        draftBase.TryGetValue(beatId, out var baseToken);
        savingBeatId = beatId;
        StateHasChanged();
        try
        {
            await Workbench.UpdateBeatTextAsync(beatId, text, baseToken);
            // The UPDATE is system-versioned, so the prior text is now in
            // Beats_History automatically — nothing to snapshot client-side.
            // Drop this beat's draft so the reload reseeds it from the
            // freshly-saved text + new concurrency token (clean state).
            drafts.Remove(beatId);
            draftBase.Remove(beatId);
            await ReloadBeatsAsync();
            Toast.Success("BEAT-EDIT", "Beat updated; audio invalidated.");
        }
        catch (BeatConflictException conflict)
        {
            // Another tab/MCP-tool wrote in between. Reload so the user sees
            // the current canonical text on the OTHER rows, but keep THIS
            // beat's draft (their unsaved text) and advance its base token to
            // the conflicting version so a re-save applies over it. No silent
            // clobber. SyncDraftsAfterReload preserves a dirty draft, so we
            // just re-point the token here.
            await ReloadBeatsAsync();
            draftBase[beatId] = conflict.CurrentUpdatedAt;
            Toast.Error("BEAT-CONFLICT", "Beat was modified elsewhere. Your edit is kept in the box — re-save to apply it over the latest version.");
        }
        catch (Exception ex) { Toast.Error("BEAT-EDIT-FAIL", ex.Message); }
        finally { savingBeatId = null; await InvokeAsync(StateHasChanged); }
    }

    /// <summary>Refresh the per-beat version counts from the temporal history
    /// so the cycler arrows render the right disabled state, and reset every
    /// cursor to the current version (0). One grouped DB query per (re)load.
    /// Non-fatal — on failure the arrows simply stay disabled.</summary>
    private async Task RefreshHistoryCountsAsync()
    {
        if (node == null) return;
        try
        {
            var counts = await Workbench.GetBeatVersionCountsAsync(node.Id);
            historyCounts.Clear();
            historyCursor.Clear();
            historyTimestamps.Clear();
            foreach (var kv in counts) historyCounts[kv.Key] = kv.Value;
        }
        catch (Exception ex) { Console.Error.WriteLine($"[node-history] count refresh failed: {ex.Message}"); }
    }

    /// <summary>Step the version cycler for one beat. delta +1 = older, -1 =
    /// newer; cursor 0 is the current/most-recent edit. Pulls the selected
    /// version's prose and its timestamp from the temporal history and loads
    /// them so the editor previews the version with its edit date shown.
    /// No-op when the move would run past either end.</summary>
    private async Task StepHistoryAsync(Guid beatId, int delta)
    {
        if (!historyCounts.TryGetValue(beatId, out var count) || count == 0) return;
        var cursor = historyCursor.TryGetValue(beatId, out var c) ? c : 0;
        var next = Math.Clamp(cursor + delta, 0, count - 1);
        if (next == cursor) return;
        NodeWorkbenchService.BeatVersion? version;
        try { version = await Workbench.GetBeatVersionAsync(beatId, next); }
        catch (Exception ex) { Toast.Error("BEAT-HISTORY", ex.Message); return; }
        if (version is null) return; // version vanished — leave the editor as-is
        historyCursor[beatId] = next;
        historyTimestamps[beatId] = version.ValidFrom;
        drafts[beatId] = version.Text;
        autoSizePendingBeatId = beatId;
        await InvokeAsync(StateHasChanged);
    }

