    private async Task ListenWebSpeechAsync()
    {
        if (node == null) return;
        try
        {
            var ordered = await Workbench.GetOrderedBeatsAsync(node.Id, includeDisabled: false);
            var chunks = ordered.Select(b => (b.Beat.Text ?? "").Trim()).Where(t => t.Length > 0).ToList();
            if (chunks.Count == 0) chunks = new List<string> { NodeWorkbenchService.DemoSampleText };
            webSpeaking = true;
            StateHasChanged();
            await JS.InvokeVoidAsync("streetSamuraiSpeech.speak", chunks, webSpeechVoice, webSpeechRate);
        }
        catch (Exception ex)
        {
            Log.LogWarning(ex, "Web Speech playback failed");
            Toast.Error("BROWSER-VOICE", "Browser voice playback failed.");
            webSpeaking = false;
        }
    }

