@page "/apparel"
@using StreetSamurai.Core.Models.Canon
@inject ApparelRepository Repo
@inject NavigationManager Nav

<h4 class="text-danger mb-3">Apparel</h4>
<div class="dict-layout">
    <div class="dict-list">
        <div class="card bg-dark text-light border-secondary mb-2 card-body">
            <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary mb-2"
                   placeholder="Filter..." @bind="filter" @bind:event="oninput" />
            <div class="d-flex gap-2">
            <ExportButton Mode="repo" ExtraStyle="width:calc(50% - 5px);" RepoName="Apparel" GetRepoEntries="GetExportEntries" />
            <button class="btn btn-sm btn-outline-danger" style="width:calc(50% - 5px)" @onclick="AddNew"><i class="bi bi-plus-lg"></i> New</button>
            </div>
        </div>
        <div class="dict-items">
            @foreach (var a in FilteredItems)
            {
                <div class="list-item text-light @(editing?.Name == a.Name ? "active" : "")" @onclick="() => Edit(a)">
                    <div class="fw-bold small">@a.Name</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@a.Category</div>
                </div>
            }
        </div>
    </div>
    <div class="dict-editor">
        @if (editing != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="text-danger mb-0">@(isNew ? "New Apparel" : editing.Name)</h5>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i> Save</button>
                    @if (!isNew) { <ExportButton Mode="entry" RepoName="Apparel" EntryName="@editing.Name" EntryJson="@System.Text.Json.JsonSerializer.Serialize(editing)" /> }
                    @if (!isNew && !confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmDelete = true"><i class="bi bi-trash3"></i></button> }
                    @if (confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete">Confirm</button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirmDelete = false">No</button> }
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 2; min-width: 200px;"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Name" /></div>
                <div style="flex: 1; min-width: 120px;"><div class="field-label">Category</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Category" /></div>
                <div style="flex: 1; min-width: 120px;"><div class="field-label">Tier Association</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.TierAssociation" /></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div style="flex: 1; min-width: 150px;"><div class="field-label">Manufacturer</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Manufacturer" /></div>
                <div style="flex: 1; min-width: 100px;"><div class="field-label">Price Range</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.PriceRange" /></div>
                <div style="flex: 0 0 auto;" class="d-flex align-items-end gap-3">
                    <div class="form-check form-switch"><input class="form-check-input" type="checkbox" @bind="editing.AugCompatible" /><label class="form-check-label text-muted small">Aug Compatible</label></div>
                    <div class="form-check form-switch"><input class="form-check-input" type="checkbox" @bind="editing.GeneCompatible" /><label class="form-check-label text-muted small">Gene Compatible</label></div>
                </div>
            </div>
            <div class="mb-3"><div class="field-label">Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="3" @bind="editing.Description"></textarea></div>
            <div class="mb-3"><div class="field-label">Functionality</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="2" @bind="editing.Functionality"></textarea></div>
            <div class="mb-3"><div class="field-label">What It Says About the Wearer</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="2" @bind="editing.WhatItSays"></textarea></div>
        }
        else
        {
            <div class="text-center text-muted py-5"><i class="bi bi-handbag" style="font-size:3rem;"></i><p class="mt-2">Select an apparel item or create a new one.</p></div>
        }
    </div>
</div>

@code {
    private List<ApparelData> items = [];
    private ApparelData? editing;
    private string originalName = "", filter = "";
    private bool isNew, confirmDelete;
    private IEnumerable<ApparelData> FilteredItems => string.IsNullOrWhiteSpace(filter) ? items : items.Where(a => a.Name.Contains(filter, StringComparison.OrdinalIgnoreCase) || a.Category.Contains(filter, StringComparison.OrdinalIgnoreCase) || a.WhatItSays.Contains(filter, StringComparison.OrdinalIgnoreCase));
    protected override void OnInitialized() { Repo.Reload(); items = Repo.GetAll(); if (Nav.Uri.Contains("new=true")) AddNew(); }
    private void AddNew() { editing = new ApparelData(); isNew = true; confirmDelete = false; }
    private void Edit(ApparelData a) { editing = a; originalName = a.Name; isNew = false; confirmDelete = false; }
    private void SaveEdit() { if (editing == null || string.IsNullOrWhiteSpace(editing.Name)) return; if (!isNew && originalName != editing.Name) Repo.Delete(originalName); Repo.Save(editing); editing = null; items = Repo.GetAll(); }
    private void DoDelete() { if (editing != null) { Repo.Delete(editing.Name); editing = null; items = Repo.GetAll(); confirmDelete = false; } }
    private List<(string name, string json)> GetExportEntries() => items.Select(e => (e.Name, System.Text.Json.JsonSerializer.Serialize(e))).ToList();
}
