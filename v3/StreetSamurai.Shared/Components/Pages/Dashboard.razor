@page "/dashboard"
@inject LoreService Canon
@inject WorldGraphService Graph
@using StreetSamurai.Core.Models
@using StreetSamurai.Core.Interfaces
@inject IStoryBlockRepository StoryRepo
@inject FacetService FacetSvc
@inject ILlmService Llm
@inject ITtsService Tts
@inject TriviaService TriviaSvc
@inject IWriteAccessProvider Access
@inject StoryDirectorService Director
@implements IDisposable


<div class="row g-3 mt-2">

    @* ── Story Engine ────────────────────────────────────── *@
    @if (Access.CanWrite)
    {
        <div class="col-12">
            <div class="card bg-dark text-light border-secondary">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="text-danger fw-semibold"><i class="bi bi-book-half me-1"></i>Story Engine</span>
                    <a href="stories" class="text-info small text-decoration-none">Open Stories →</a>
                </div>
                <div class="card-body py-2">
                    @if (Director.IsGenerating)
                    {
                        <div class="d-flex align-items-center gap-3 flex-wrap">
                            <div class="spinner-border spinner-border-sm text-danger flex-shrink-0"></div>
                            <div class="flex-grow-1" style="min-width:0;">
                                @if (Director.CurrentStory != null)
                                {
                                    <div class="d-flex flex-wrap gap-2 small mb-1">
                                        <span><span class="text-muted">Protagonist</span> <span class="text-light fw-semibold">@Director.CurrentStory.Protagonist</span></span>
                                        @if (Director.CurrentStory.Characters.Count > 0)
                                        {
                                            <span class="text-muted">|</span>
                                            <span><span class="text-muted">Cast</span> <span class="text-light">@string.Join(", ", Director.CurrentStory.Characters)</span></span>
                                        }
                                        @if (!string.IsNullOrEmpty(Director.CurrentStory.Location))
                                        {
                                            <span class="text-muted">|</span>
                                            <span><span class="text-muted">Zone</span> <span class="text-light">@Director.CurrentStory.Location</span></span>
                                        }
                                    </div>
                                }
                                <div class="small text-warning">@Director.ProgressMessage</div>
                                @if (Director.ProgressTotal > 0)
                                {
                                    <div class="progress mt-1" style="height:3px;">
                                        <div class="progress-bar bg-danger" style="width:@(Director.ProgressCurrent * 100 / Director.ProgressTotal)%"></div>
                                    </div>
                                    <div class="small text-muted mt-1">Beat @Director.ProgressCurrent / @Director.ProgressTotal</div>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        var recent = stories.FirstOrDefault();
                        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                            @if (recent != null)
                            {
                                <div class="small">
                                    <span class="text-muted">Last story:</span>
                                    <a href="stories/write/@recent.Id" class="text-light fst-italic text-decoration-none ms-1">@recent.Title</a>
                                    <span class="badge bg-secondary ms-2" style="font-size:0.6rem;">@recent.Status</span>
                                </div>
                            }
                            else
                            {
                                <span class="small text-muted">No stories yet.</span>
                            }
                            <a href="stories" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-lightning me-1"></i>Generate Story
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (Access.CanWrite)
    {
        @* ── Stories ────────────────────────────────────────── *@
        <div class="col-md-4">
            <div class="card bg-dark text-light border-secondary">
                <div class="card-header text-muted d-flex justify-content-between align-items-center">
                    Stories
                    <a href="stories" class="text-info small text-decoration-none">View all</a>
                </div>
                <div class="card-body">
                    @if (stories.Any())
                    {
                        @foreach (var s in stories.Take(6))
                        {
                            <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                                <a href="stories/write/@s.Id" class="text-light text-decoration-none small fst-italic">@s.Title</a>
                                <span class="badge bg-secondary" style="font-size: 0.6rem;">@s.Status</span>
                            </div>
                        }
                    }
                    else
                    {
                        <small class="text-muted">No stories yet. <a href="stories" class="text-info">Write one.</a></small>
                    }
                </div>
            </div>
        </div>
    }


    @* ── Most Connected / Canon Docs ──────────────────── *@
    <div class="col-md-4">
        <div class="card bg-dark text-light border-secondary mb-3">
            <div class="card-header text-muted">Most Connected Entities</div>
            <div class="card-body">
                @foreach (var (node, count) in topConnected)
                {
                    <div class="d-flex justify-content-between border-bottom border-secondary py-1">
                        <a href="graph" class="text-light text-decoration-none small">@node.Name</a>
                        <span class="badge bg-danger rounded-pill">@count</span>
                    </div>
                }
                @if (orphanCount > 0)
                {
                    <div class="d-flex justify-content-between py-1 mt-1">
                        <small class="text-muted">Orphaned Nodes</small>
                        <span class="badge bg-secondary rounded-pill">@orphanCount</span>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Trivia Ticker ─────────────────────────────────── *@
    <div class="col-md-4">
        <div class="card bg-dark text-light border-secondary">
            <div class="card-body py-2">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <small class="text-muted"><i class="bi bi-lightbulb text-warning"></i> DID YOU KNOW? <span style="opacity:0.5;">@(triviaPos + 1)/@triviaRing.Length</span></small>
                    <div class="d-flex gap-1">
                        <button class="btn btn-outline-secondary tb" @onclick="PrevTrivia" title="Previous"><i class="bi bi-chevron-left"></i></button>
                        <button class="btn btn-outline-secondary tb" @onclick="NextTrivia" title="Next"><i class="bi bi-chevron-right"></i></button>
                    </div>
                </div>
                <div class="small text-light">@GetCurrentTrivia()</div>
            </div>
        </div>
    </div>

    @* ── Most Interesting Leaderboard ──────────────────── *@
    <div class="col-12">
        <TopRatedLeaderboard />
    </div>
</div>

@code {
    private int docCount, corpCount, charCount, nodeCount, edgeCount, facetCount;
    private bool llmReady, ttsReady;
    private List<StoryProject> stories = [];
    private List<(WorldNode node, int count)> topConnected = [];
    private int orphanCount;

    protected override async Task OnInitializedAsync()
    {
        var docs = Canon.ListDocuments();
        docCount = docs.Count;
        corpCount = Canon.ListCorponations().Count;
        charCount = Canon.ListCharacters().Count;

        Graph.EnsureLoaded();
        nodeCount = Graph.NodeCount;
        edgeCount = Graph.EdgeCount;

        facetCount = FacetSvc.LoadAllFacets().Count;
        stories = StoryRepo.ListProjects();

        triviaRing = TriviaSvc.GetFacts();
        llmReady = await Llm.IsConfiguredAsync();
        ttsReady = await Tts.IsConfiguredAsync();

        // Top connected entities
        var allNodes = Graph.AllNodes();
        topConnected = allNodes
            .Where(n => !string.IsNullOrWhiteSpace(n.Id) && !string.IsNullOrWhiteSpace(n.Name))
            .Select(n => (node: n, count: Graph.GetAllEdges(n.Id).Count))
            .Where(x => x.count > 0)
            .OrderByDescending(x => x.count)
            .Take(6)
            .ToList();
        orphanCount = allNodes.Count(n => string.IsNullOrWhiteSpace(n.Id) || string.IsNullOrWhiteSpace(n.Name)
            || Graph.GetAllEdges(n.Id).Count == 0);

        Director.OnProgress += OnDirectorProgress;
    }

    private void OnDirectorProgress(DirectorProgress _) =>
        InvokeAsync(StateHasChanged);

    public void Dispose() => Director.OnProgress -= OnDirectorProgress;

    private string[] triviaRing = [];
    private int triviaPos;

    private string GetCurrentTrivia() => triviaRing.Length > 0 ? triviaRing[triviaPos] : Constants.Defaults.Loading;

    private void NextTrivia() { if (triviaRing.Length > 0) triviaPos = (triviaPos + 1) % triviaRing.Length; }

    private void PrevTrivia() { if (triviaRing.Length > 0) triviaPos = (triviaPos - 1 + triviaRing.Length) % triviaRing.Length; }

}
