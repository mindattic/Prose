@page "/districts"
@inject CanonService Canon
@inject WorldGraphService Graph

@if (_selectedYaml != null)
{
    <div class="d-flex align-items-center gap-2 mb-3">
        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSelection">Back</button>
        <h4 class="text-danger mb-0">@_selectedDistrict?.Name</h4>
        <a href="graph" class="btn btn-sm btn-outline-info ms-auto" title="View relationships in World Graph"><i class="bi bi-diagram-3"></i> Graph</a>
    </div>

    <div class="row g-3">
        <div class="col-md-5">
            <div class="card bg-dark text-light border-secondary">
                <div class="card-header text-muted">Overview</div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(_selectedDistrict?.Description))
                    {
                        <p class="small">@_selectedDistrict.Description</p>
                    }
                </div>
            </div>

            @if (_relationships.Any())
            {
                <div class="card bg-dark text-light border-secondary mt-3">
                    <div class="card-header text-muted">Who Operates Here</div>
                    <div class="card-body">
                        @foreach (var edge in _relationships)
                        {
                            var other = edge.Source == _nodeId ? edge.Target : edge.Source;
                            var otherNode = Graph.GetNode(other);
                            <div class="border-bottom border-secondary py-1 small">
                                <span class="text-info">@(otherNode?.Name ?? other)</span>
                                <span class="text-muted ms-1">(@edge.RelationType)</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="col-md-7">
            <div class="card bg-dark text-light border-secondary">
                <div class="card-header text-muted">Raw YAML</div>
                <div class="card-body" style="max-height: 70vh; overflow-y: auto;">
                    <pre style="white-space: pre-wrap; font-size: 0.8rem; color: #ddd;">@_selectedYaml</pre>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <h4 class="text-danger mb-1">Districts (@_districts.Count)</h4>
    <p class="text-muted mb-3">Named zones of Meridian City — each with its own atmosphere, dangers, and power structures.</p>

    <div class="row g-3">
        @foreach (var d in _districts)
        {
            <div class="col-md-6">
                <div class="card bg-dark text-light border-secondary h-100" style="cursor: pointer;"
                     @onclick="() => Select(d)">
                    <div class="card-body">
                        <h6 class="text-info">@d.Name</h6>
                        @if (!string.IsNullOrEmpty(d.Description))
                        {
                            <p class="small text-muted mb-0">@Truncate(d.Description, 200)</p>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<District> _districts = [];
    private District? _selectedDistrict;
    private string? _selectedYaml;
    private string _nodeId = "";
    private List<WorldEdge> _relationships = [];

    protected override void OnInitialized()
    {
        _districts = Canon.ListDistricts();
        Graph.EnsureLoaded();
    }

    private void Select(District d)
    {
        _selectedDistrict = d;
        _selectedYaml = Canon.ReadDistrictJson(d.Name);
        _nodeId = WorldGraphService.Slugify(d.Name);
        _relationships = Graph.GetAllEdges(_nodeId);
    }

    private void ClearSelection()
    {
        _selectedDistrict = null;
        _selectedYaml = null;
        _relationships = [];
    }

    private static string Truncate(string s, int max) =>
        s.Length > max ? s[..(max - 3)] + "..." : s;
}
