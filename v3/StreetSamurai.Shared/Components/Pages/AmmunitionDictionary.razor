@page "/ammunition"
@using StreetSamurai.Core.Models.Canon
@inject AmmunitionRepository Repo
@inject NavigationManager Nav

<h4 class="text-danger mb-3">Ammunition</h4>
<div class="dict-layout">
    <div class="dict-list">
        <div class="card bg-dark text-light border-secondary mb-2 card-body">
            <input type="text" class="form-control form-control-sm bg-dark text-light border-secondary mb-2"
                   placeholder="Filter..." @bind="filter" @bind:event="oninput" />
            <div class="mb-2">
                <TagFilter AllTags="allTags" SelectedTags="selectedTags" SelectedTagsChanged="OnTagsChanged" />
            </div>
            <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-danger" style="width:calc(50% - 5px)" @onclick="AddNew"><i class="bi bi-plus-lg"></i> New</button>
            </div>
        </div>
        <div class="dict-items">
            @foreach (var a in PagedItems)
            {
                <div class="list-item text-light @(editing?.Name == a.Name ? "active" : "")" @onclick="() => Edit(a)">
                    <div class="fw-bold small">@a.Name</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@a.Category</div>
                </div>
            }
        </div>
        <PaginationBar CurrentPage="currentPage" TotalPages="TotalPages" OnPageChanged="p => currentPage = p" />
    </div>

    <div class="dict-editor">
        @if (editing != null)
        {
            <EditViewToggle RepoName="ammunition" Title="@(isNew ? "New Ammunition" : editing.Name)" Json="@System.Text.Json.JsonSerializer.Serialize(editing)">
                <HeaderButtons>
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i> Save</button>
                    @if (!isNew && !confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmDelete = true"><i class="bi bi-archive"></i></button> }
                    @if (confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete">Confirm</button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirmDelete = false">No</button> }
                </HeaderButtons>
                <ChildContent>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <div style="flex: 2; min-width: 200px;"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Name" /></div>
                        <div style="flex: 1; min-width: 120px;"><div class="field-label">Category</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Category" /></div>
                        <div style="flex: 1; min-width: 100px;"><div class="field-label">Caliber</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Caliber" /></div>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <div style="flex: 1; min-width: 150px;"><div class="field-label">Manufacturer</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Manufacturer" /></div>
                        <div style="flex: 1; min-width: 100px;"><div class="field-label">Tier</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.TierAvailability" /></div>
                        <div style="flex: 1; min-width: 100px;"><div class="field-label">Legality</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Legality" /></div>
                    </div>
                    <div class="mb-3"><div class="field-label">Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="3" @bind="editing.Description"></textarea></div>
                    <div class="mb-3"><div class="field-label">Specifications</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="2" @bind="editing.Specifications"></textarea></div>
                    <div class="mb-3"><div class="field-label">Cultural Context</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" rows="2" @bind="editing.CulturalContext"></textarea></div>
                </ChildContent>
            </EditViewToggle>
        }
        else
        {
            <div class="text-center text-muted py-5"><i class="bi bi-bullseye" style="font-size:3rem;"></i><p class="mt-2">Select ammunition or create a new type.</p></div>
        }
    </div>
</div>

@code {
    private List<AmmunitionData> items = [];
    private AmmunitionData? editing;
    private string originalName = "";
    private string filter = "";
    private List<(string name, int count)> allTags = [];
    private HashSet<string> selectedTags = [];
    private bool isNew, confirmDelete;

    private IEnumerable<AmmunitionData> FilteredItems
    {
        get
        {
            IEnumerable<AmmunitionData> result = items;
            if (!string.IsNullOrWhiteSpace(filter))
                result = result.Where(a => a.Name.Contains(filter, StringComparison.OrdinalIgnoreCase));
            if (selectedTags.Count > 0)
                result = result.Where(a => selectedTags.All(t => a.Tags.Contains(t)));
            return result;
        }
    }
    private int currentPage = 1;
    private const int PageSize = 100;
    private IEnumerable<AmmunitionData> PagedItems { get { var f = FilteredItems.ToList(); var mp = Math.Max(1, (int)Math.Ceiling(f.Count / (double)PageSize)); if (currentPage > mp) currentPage = mp; return f.Skip((currentPage - 1) * PageSize).Take(PageSize); } }
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)FilteredItems.Count() / PageSize));

    protected override void OnInitialized() { Repo.Reload(); items = Repo.GetAll(); RebuildTags(); if (Nav.Uri.Contains("new=true")) AddNew(); else { var qid = Nav.Uri.Contains("id=") ? Uri.UnescapeDataString(Nav.Uri.Split(new[]{"id="}, StringSplitOptions.None).Last().Split(new[]{"&"}, StringSplitOptions.None)[0]) : ""; if (!string.IsNullOrEmpty(qid)) { var t = items.FirstOrDefault(e => e.Id == qid); if (t != null) Edit(t); } } }
    private void AddNew() { editing = new AmmunitionData(); isNew = true; confirmDelete = false; }
    private void Edit(AmmunitionData a) { editing = a; originalName = a.Name; isNew = false; confirmDelete = false; }
    private void SaveEdit() { if (editing == null || string.IsNullOrWhiteSpace(editing.Name)) return; if (!isNew && originalName != editing.Name) Repo.Delete(originalName); Repo.Save(editing); editing = null; items = Repo.GetAll(); }
    private void DoDelete() { if (editing != null) { Repo.Delete(editing.Name); editing = null; items = Repo.GetAll(); confirmDelete = false; } }
    private void RebuildTags() { allTags = items.SelectMany(x => x.Tags).GroupBy(t => t).Select(g => (g.Key, g.Count())).OrderBy(t => t.Key).ToList(); }
    private void OnTagsChanged(HashSet<string> tags) { selectedTags = tags; }
    private List<(string name, string json)> GetExportEntries() => items.Select(e => (e.Name, System.Text.Json.JsonSerializer.Serialize(e))).ToList();
}
