@inherits LayoutComponentBase
@inject SettingsService SettingsSvc
@inject IWriteAccessProvider Access
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SearchTriggerService SearchTrigger
@inject IToastService Toast
@implements IDisposable

<style>
    html, body { font-family: '@SettingsSvc.FontFamily', 'Helvetica Neue', Helvetica, Arial, sans-serif; }
</style>

<div class="app-shell @(!Access.CanWrite ? "readonly-mode" : "")"
     @onkeydown="OnGlobalKeyDown" tabindex="-1">
    <div class="app-container d-flex">
        <NavMenu />
        <main class="flex-grow-1" style="padding: 10px; padding-top: var(--titlebar-offset) !important; min-width: 0; overflow-x: hidden; overflow-y: auto; height: 100vh;">
            <div class="container-fluid">
                @Body
            </div>
        </main>
    </div>
</div>

<BlazoredToasts Position="ToastPosition.TopCenter" Timeout="12" MaxToasts="5" />
<SearchOverlay />

@code {
    // SS_ environment variables required in Production
    private static readonly string[] RequiredEnvVars =
    [
        "SS_CLAUDE_API_KEY",
        "SS_ELEVENLABS_API_KEY",
        "SS_OPENAI_API_KEY",
        "STREETSAMURAI_DATA_ROOT",
        "SS_MUTABLE_DATA_ROOT",
    ];

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            Nav.LocationChanged += OnLocationChanged;
            Nav.RegisterLocationChangingHandler(OnLocationChanging);
            CheckMissingEnvVars();
        }
    }

    private void CheckMissingEnvVars()
    {
        // Only warn in Production — dev runs fine without Azure env vars
        var env = Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") ?? "";
        if (!string.Equals(env, "Production", StringComparison.OrdinalIgnoreCase))
            return;

        var missing = RequiredEnvVars
            .Where(v => string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable(v)))
            .ToList();

        if (missing.Count == 0) return;

        var list = string.Join(", ", missing);
        Toast.ShowWarning($"Missing Azure App Settings: {list}");
    }

    private async Task OnGlobalKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "k")
            await SearchTrigger.RequestOpenAsync();
    }

    private async ValueTask OnLocationChanging(LocationChangingContext ctx)
    {
        try { await JS.InvokeVoidAsync("__loaderShow", 500); } catch { }
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        try { await JS.InvokeVoidAsync("__loaderHide"); } catch { }
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
