@inherits LayoutComponentBase
@inject SettingsService SettingsSvc
@inject IWriteAccessProvider Access
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject SearchTriggerService SearchTrigger
@inject ToastNotifier Toast
@inject MediaService Media
@inject StreetSamurai.Core.Services.IUniverseContext Universe
@implements IDisposable

<style>
    html, body { font-family: '@SettingsSvc.FontFamily', 'Helvetica Neue', Helvetica, Arial, sans-serif; }
</style>

@* CyberSpace background removed 2026-06-15 — plain dark mode (universe-neutral shell). *@

@* portrait disabled
@if (bgImage != null)
{
    <img id="home-bg-img" src="/api/media/@bgImage" class="home-bg-img"
         style="opacity:0" alt="" aria-hidden="true" />
}
*@

@* Auth chrome (MindAttic.UiUx) — UserTimeout arms the 30-min idle auto-logout. The user identity
   lives in NavMenu's UserBoard (bound to Access.CurrentUserName); the old upper-right UserCircle
   was redundant and has been removed. *@
<UserTimeout />

@if (embed)
{
    @* Embedded mode (the writer iframe loads /strand/{id}?embed=1): render bare so the persistent
       two-pane shell does NOT recurse into itself. *@
    <div class="app-shell app-embed" data-theme="@currentTheme">
        <main class="topnav-main"><div class="container-fluid">@Body</div></main>
    </div>
}
else
{
    <div class="app-shell @(!Access.IsContributor ? "readonly-mode" : "") @(SettingsSvc.RepoListOnRight ? "list-right" : "")"
         data-theme="@currentTheme"
         @onkeydown="OnGlobalKeyDown" tabindex="-1">
        <AppBanner OnThemeChanged="OnThemeChanged" />
        <div class="app-split-controls">
            <button class="btn btn-sm btn-outline-secondary" title="Swap sides (writer ↔ repositories)" @onclick="ToggleSwap">
                <i class="bi bi-arrow-left-right"></i>
            </button>
            <button class="btn btn-sm btn-outline-secondary" title="@SplitTitle" @onclick="CycleSplit">
                <i class="bi @SplitIcon"></i>
            </button>
        </div>
        @* Left = strand selection + writer; Right = repositories & tools (@Body). Swap flips them. *@
        <div class="app-split layout-@(splitLayout)">
            @if (splitSwapped)
            {
                <main class="topnav-main app-pane app-pane-repos">
                    <div class="container-fluid">
                        <AutoBreadcrumb />
                        @Body
                    </div>
                </main>
                <div class="app-pane app-pane-writer"><WriterPane /></div>
            }
            else
            {
                <div class="app-pane app-pane-writer"><WriterPane /></div>
                <main class="topnav-main app-pane app-pane-repos">
                    <div class="container-fluid">
                        <AutoBreadcrumb />
                        @Body
                    </div>
                </main>
            }
        </div>
        <AppStatusBar />
    </div>
}

<SearchOverlay />

@code {
    // SS_ environment variables required in Production
    private static readonly string[] RequiredEnvVars =
    [
        "SS_CLAUDE_API_KEY",
        "SS_ELEVENLABS_API_KEY",
        "SS_OPENAI_API_KEY",
        "STREETSAMURAI_DATA_ROOT",
        "SS_MUTABLE_DATA_ROOT",
    ];

    private bool navPending = false;
    private string? bgImage;
    private string currentTheme = ""; // always set in OnInitialized

    // Persistent two-pane shell: left = strand selection + writer, right = repositories & tools
    // (@Body). Swap flips them; the cycle button collapses left / right / neither. State persists
    // to localStorage. `embed` renders bare so the writer iframe (which loads a real page) can't
    // recurse into the shell.
    private bool embed;
    private bool splitSwapped;
    private string splitLayout = "equal"; // equal | left (left pane collapsed) | right

    private bool IsEmbed() => Nav.Uri.Contains("embed=1", StringComparison.OrdinalIgnoreCase);

    private string SplitIcon => splitLayout switch
    {
        "left"  => "bi-layout-sidebar-inset-reverse",
        "right" => "bi-layout-sidebar-inset",
        _       => "bi-layout-split",
    };
    private string SplitTitle => splitLayout switch
    {
        "left"  => "Left pane collapsed — click to collapse right",
        "right" => "Right pane collapsed — click for equal width",
        _       => "Equal width — click to collapse left",
    };

    protected override void OnInitialized()
    {
        bgImage = Media.GetRandomImage();
        var universeTheme = AppBanner.ThemeFor(Universe);
        currentTheme = SettingsSvc.Theme == "auto" ? universeTheme : SettingsSvc.Theme;
        embed = IsEmbed();
        SettingsSvc.ThemeChanged += OnSettingsThemeChanged;
    }

    private void OnThemeChanged(string theme)
        => currentTheme = SettingsSvc.Theme == "auto" ? theme : SettingsSvc.Theme;

    private void OnSettingsThemeChanged(string theme)
    {
        currentTheme = theme == "auto" ? AppBanner.ThemeFor(Universe) : theme;
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleSwap()
    {
        splitSwapped = !splitSwapped;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "app.split.swapped", splitSwapped ? "1" : "0"); } catch { }
    }

    private async Task CycleSplit()
    {
        splitLayout = splitLayout switch { "equal" => "left", "left" => "right", _ => "equal" };
        try { await JS.InvokeVoidAsync("localStorage.setItem", "app.split.layout", splitLayout); } catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Nav.LocationChanged += OnLocationChanged;
            Nav.RegisterLocationChangingHandler(OnLocationChanging);
            CheckMissingEnvVars();
            if (!embed)
            {
                try
                {
                    splitSwapped = (await JS.InvokeAsync<string>("localStorage.getItem", "app.split.swapped")) == "1";
                    var l = await JS.InvokeAsync<string>("localStorage.getItem", "app.split.layout");
                    if (l is "equal" or "left" or "right") splitLayout = l;
                    StateHasChanged();
                }
                catch { /* prerender / JS unavailable */ }
            }
            // List-item neon flicker DISABLED 2026-05-09 — too distracting in
            // the dictionary UIs. JS (`cyberspaceStartListItemFlicker` in console-bg.js)
            // and CSS (`.neon-flicker-loop` in app.css) are intact for later
            // re-enablement; uncomment the line below to restore.
            // try { await JS.InvokeVoidAsync("cyberspaceStartListItemFlicker"); } catch { }
            // portrait disabled
            // if (bgImage != null)
            // {
            //     try { await JS.InvokeVoidAsync("homeBg.apply", "home-bg-img", $"/api/media/{bgImage}"); } catch { }
            // }
        }
        if (navPending)
        {
            navPending = false;
            try { await JS.InvokeVoidAsync("__loaderHide"); } catch { }
        }
    }

    private void CheckMissingEnvVars()
    {
        // Only warn in Production — dev runs fine without Azure env vars
        var env = Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") ?? "";
        if (!string.Equals(env, "Production", StringComparison.OrdinalIgnoreCase))
            return;

        var missing = RequiredEnvVars
            .Where(v => string.IsNullOrWhiteSpace(Environment.GetEnvironmentVariable(v)))
            .ToList();

        if (missing.Count == 0) return;

        var list = string.Join(", ", missing);
        Toast.Warning(AppError.ConfMissingEnvVar, $"Missing Azure App Settings: {list}");
    }

    private async Task OnGlobalKeyDown(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.Key == "k")
            await SearchTrigger.RequestOpenAsync();
    }

    private async ValueTask OnLocationChanging(LocationChangingContext ctx)
    {
        navPending = true;
        var isWritePage = ctx.TargetLocation.Contains("/stories/write/", StringComparison.OrdinalIgnoreCase)
                       || Nav.Uri.Contains("/stories/write/", StringComparison.OrdinalIgnoreCase);
        if (!isWritePage)
        {
            // TV-static navigation flourish removed 2026-06-15 (CyberSpace theme retired).
            try { await JS.InvokeVoidAsync("__loaderShow", 0); } catch { }
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // Recompute embed mode (the writer iframe vs the full shell) on navigation.
        var wasEmbed = embed;
        embed = IsEmbed();
        if (wasEmbed != embed) StateHasChanged();
        // OnAfterRenderAsync will fire next and hide the loader
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        SettingsSvc.ThemeChanged -= OnSettingsThemeChanged;
    }
}
