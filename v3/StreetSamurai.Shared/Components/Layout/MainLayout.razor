@inherits LayoutComponentBase
@inject SettingsService SettingsSvc

<style>
    html, body { font-family: '@SettingsSvc.FontFamily', 'Helvetica Neue', Helvetica, Arial, sans-serif; }
</style>

<div class="app-shell">
    <div class="app-container d-flex">
        <NavMenu />
        <main class="flex-grow-1" style="padding: 10px; padding-top: var(--titlebar-offset) !important; min-width: 0; overflow-x: hidden; overflow-y: auto; height: 100vh;">
            <div class="container-fluid">
                @Body
            </div>
        </main>
    </div>
</div>
