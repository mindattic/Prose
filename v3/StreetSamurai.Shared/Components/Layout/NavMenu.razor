@inject CorponationRepository CorpRepo
@inject FactionRepository FactionRepo
@inject CharacterRepository CharRepo
@inject DistrictRepository DistrictRepo
@inject WorldbuildingDocRepository DocRepo
@inject TechnologyRepository TechRepo
@inject WeaponryRepository WeaponRepo
@inject EquipmentRepository EquipRepo
@inject CyberwareRepository CyberRepo
@inject AmmunitionRepository AmmoRepo
@inject QuoteRepository QuoteRepo
@inject ConsumerGoodRepository GoodsRepo
@inject PharmaceuticalRepository PharmaRepo
@inject SubstrateRepository SubstrateRepo
@inject ContractRepository ContractRepo
@inject NewsRepository NewsRepo
@inject ArchetypeRepository ArchetypeRepo
@inject VocabularyRepository VocabRepo
@inject SyntheticLifeRepository SynthRepo
@inject GenewareRepository GenewareRepo
@inject TransportationRepository TransportRepo
@inject WorldGraphService GraphSvc
@inject NavigationManager Nav

<nav class="sidebar bg-dark text-light p-3 pb-5" style="width: fit-content; min-width: 240px; white-space: nowrap; flex-shrink: 0; padding-top: var(--titlebar-offset) !important; height: 100vh; overflow-y: auto;">
    <div class="mb-4">
        <h4 class="text-danger mb-0">Street Samurai</h4>
    </div>
    <li class="nav-header text-muted small mt-3 mb-1 text-uppercase">Canon Engine</li>

    <ul class="nav flex-column">
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door"></i> Dashboard
            </NavLink>
        </li>

        <li class="nav-header text-muted small mt-3 mb-1 text-uppercase">Narrative</li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="stories">
                <i class="bi bi-journal-text"></i> Stories
            </NavLink>
        </li>
        <li class="nav-item">
            <div class="d-flex align-items-center">
                <NavLink class="nav-link text-light flex-grow-1 py-1" href="contracts">
                    <i class="bi bi-clipboard-check"></i> Contracts
                </NavLink>
                <span class="badge bg-secondary me-1" style="min-width: 44px; text-align: right; font-variant-numeric: tabular-nums;">@_contractCount</span>
            </div>
        </li>

        <li class="nav-header text-muted small mt-3 mb-1 text-uppercase">Tools</li>
        <li class="nav-item">
            <div class="d-flex align-items-center">
                <NavLink class="nav-link text-light flex-grow-1 py-1" href="graph">
                    <i class="bi bi-diagram-3"></i> World Graph
                </NavLink>
                <span class="badge bg-secondary me-1" style="min-width: 44px; text-align: right; font-variant-numeric: tabular-nums;">@_graphNodeCount</span>
            </div>
        </li>
        <li class="nav-header text-muted small mt-3 mb-1 text-uppercase">Lore</li>

        @NavItem("bi-building", "corps", "Corponations", corpCount)
        @NavItem("bi-shield-exclamation", "factions", "Factions", _factionCount)
        @NavItem("bi-people", "characters", "Characters", _charCount)
        @NavItem("bi-geo-alt", "places", "Places", _districtCount)
        @NavItem("bi-cpu", "technology", "Technology", _techCount)
        @NavItem("bi-crosshair", "weaponry", "Weaponry", _weaponCount)
        @NavItem("bi-bullseye", "ammunition", "Ammunition", _ammoCount)
        @NavItem("bi-shield-shaded", "equipment", "Equipment", _equipCount)
        @NavItem("bi-motherboard", "cyberware", "Cyberware", _cyberwareCount)
        @NavItem("bi-file-earmark-text", "documents", "Documents", _docCount)
        @NavItem("bi-chat-quote", "vocabulary", "Vocabulary", _vocabCount)
        @NavItem("bi-quote", "quotes", "Quotes", _quoteCount)
        @NavItem("bi-basket", "goods", "Consumer Goods", _goodsCount)
        @NavItem("bi-capsule", "pharmaceuticals", "Pharmaceuticals", _pharmaCount)
        @NavItem("bi-gem", "substrates", "Substrates", _substrateCount)
        @NavItem("bi-newspaper", "news", "News Archive", _newsCount)
        @NavItem("bi-person-bounding-box", "archetypes", "Archetypes", _archetypeCount)
        @NavItem("bi-cpu", "synthetics", "Synthetics", _synthCount)
        @NavItem("bi-virus", "geneware", "Geneware", _genewareCount)
        @NavItem("bi-truck", "transportation", "Transportation", _transportCount)


        <li class="nav-header text-muted small mt-3 mb-1 text-uppercase">System</li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="rules">
                <i class="bi bi-book"></i> World Rules
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="settings">
                <i class="bi bi-gear"></i> Settings
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="logging">
                <i class="bi bi-journal-code"></i> Logging
            </NavLink>
        </li>
    </ul>
</nav>

@code {
    private int corpCount, _factionCount, _charCount, _districtCount, _techCount, _weaponCount, _ammoCount, _equipCount, _cyberwareCount, _docCount, _vocabCount, _quoteCount, _goodsCount, _pharmaCount, _substrateCount, _contractCount, _newsCount, _archetypeCount, _synthCount, _genewareCount, _transportCount, _graphNodeCount;

    protected override void OnInitialized()
    {
        corpCount = CorpRepo.GetAll().Count;
        _factionCount = FactionRepo.GetAll().Count;
        _charCount = CharRepo.GetAll().Count;
        _districtCount = DistrictRepo.GetAll().Count;
        _weaponCount = WeaponRepo.GetAll().Count;
        _ammoCount = AmmoRepo.GetAll().Count;
        _equipCount = EquipRepo.GetAll().Count;
        _cyberwareCount = CyberRepo.GetAll().Count;
        _techCount = TechRepo.GetAll().Count;
        _docCount = DocRepo.GetAll().Count;
        _vocabCount = VocabRepo.GetAll().Count;
        _quoteCount = QuoteRepo.GetAll().Count;
        _goodsCount = GoodsRepo.GetAll().Count;
        _pharmaCount = PharmaRepo.GetAll().Count;
        _substrateCount = SubstrateRepo.GetAll().Count;
        _contractCount = ContractRepo.GetAll().Count;
        _newsCount = NewsRepo.GetAll().Count;
        _archetypeCount = ArchetypeRepo.GetAll().Count;
        _synthCount = SynthRepo.GetAll().Count;
        _genewareCount = GenewareRepo.GetAll().Count;
        _transportCount = TransportRepo.GetAll().Count;
        GraphSvc.EnsureLoaded();
        _graphNodeCount = GraphSvc.NodeCount;
    }

    private RenderFragment NavItem(string icon, string href, string label, int count) => __builder =>
    {
        <li class="nav-item">
            <div class="d-flex align-items-center">
                <NavLink class="nav-link text-light flex-grow-1 py-1" href="@href">
                    <i class="bi @icon"></i> @label
                </NavLink>
                <span class="badge bg-secondary me-1" style="min-width: 44px; text-align: right; font-variant-numeric: tabular-nums;">@count</span>
            </div>
        </li>;
    };
}
