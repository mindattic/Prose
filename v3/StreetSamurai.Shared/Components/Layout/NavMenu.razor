@inject CorponationRepository CorpRepo
@inject FactionRepository FactionRepo
@inject CharacterRepository CharRepo
@inject DistrictRepository DistrictRepo
@inject WorldbuildingDocRepository DocRepo
@inject TechnologyRepository TechRepo
@inject WeaponryRepository WeaponRepo
@inject EquipmentRepository EquipRepo

<nav class="sidebar bg-dark text-light p-3" style="width: fit-content; min-width: 200px; min-height: 100vh; white-space: nowrap;">
    <div class="mb-4">
        <h5 class="text-danger fw-bold">Street Samurai</h5>
        <small class="text-muted">Canon Engine v3</small>
    </div>

    <ul class="nav flex-column">
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="" Match="NavLinkMatch.All">
                <i class="bi bi-house-door"></i> Dashboard
            </NavLink>
        </li>

        <li class="nav-header text-muted small mt-3 mb-1 text-uppercase">Story Engine</li>
        <li class="nav-item">
            <NavLink class="nav-link text-danger fw-bold" href="write">
                <i class="bi bi-pen"></i> Story Editor
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="stories">
                <i class="bi bi-journal-text"></i> Stories
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="queue">
                <i class="bi bi-inbox"></i> Canon Queue
            </NavLink>
        </li>

        <li class="nav-header text-muted small mt-3 mb-1 text-uppercase">Lore Browser</li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="search">
                <i class="bi bi-search"></i> Search
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="corps">
                <i class="bi bi-building"></i> Corponations <span class="badge bg-secondary ms-1">@_corpCount</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="factions">
                <i class="bi bi-shield-exclamation"></i> Factions <span class="badge bg-secondary ms-1">@_factionCount</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="characters">
                <i class="bi bi-people"></i> Characters <span class="badge bg-secondary ms-1">@_charCount</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="districts">
                <i class="bi bi-geo-alt"></i> Districts <span class="badge bg-secondary ms-1">@_districtCount</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="technology">
                <i class="bi bi-cpu"></i> Technology <span class="badge bg-secondary ms-1">@_techCount</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="weaponry">
                <i class="bi bi-crosshair"></i> Weaponry <span class="badge bg-secondary ms-1">@_weaponCount</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="equipment">
                <i class="bi bi-shield-shaded"></i> Equipment <span class="badge bg-secondary ms-1">@_equipCount</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="documents">
                <i class="bi bi-file-earmark-text"></i> Documents <span class="badge bg-secondary ms-1">@_docCount</span>
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="rules">
                <i class="bi bi-book"></i> World Rules
            </NavLink>
        </li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="graph">
                <i class="bi bi-diagram-3"></i> World Graph
            </NavLink>
        </li>

        <li class="nav-header text-muted small mt-3 mb-1 text-uppercase">System</li>
        <li class="nav-item">
            <NavLink class="nav-link text-light" href="settings">
                <i class="bi bi-gear"></i> Settings
            </NavLink>
        </li>
    </ul>
</nav>

@code {
    private int _corpCount, _factionCount, _charCount, _districtCount, _techCount, _weaponCount, _equipCount, _docCount;

    protected override void OnInitialized()
    {
        _corpCount = CorpRepo.GetAll().Count;
        _factionCount = FactionRepo.GetAll().Count;
        _charCount = CharRepo.GetAll().Count;
        _districtCount = DistrictRepo.GetAll().Count;
        _weaponCount = WeaponRepo.GetAll().Count;
        _equipCount = EquipRepo.GetAll().Count;
        _techCount = TechRepo.GetAll().Count;
        _docCount = DocRepo.GetAll().Count;
    }
}
