@implements IDisposable
@inject NavigationManager Nav
@inject IWriteAccessProvider Access
@inject SearchTriggerService SearchTrigger

<nav class="topnav navbar navbar-expand-md">

    @* ── Brand + Breadcrumb — consolidated left side ──────── *@
    @{ var crumb = GetCrumb(); }
    <div class="topnav-left me-auto d-flex align-items-center">
        <NavLink class="topnav-brand" href="" Match="NavLinkMatch.All">
            <i class="bi bi-house-fill"></i>
        </NavLink>
        @if (crumb != null)
        {
            <span class="topnav-crumb-sep">›</span>
            @* Mobile: icons only *@
            <span class="d-flex d-md-none align-items-center gap-1">
                @if (crumb.CatIcon != null && crumb.PageIcon != null)
                {
                    <a href="@crumb.CatUrl" class="topnav-crumb-icon-link">
                        <i class="bi @crumb.CatIcon topnav-crumb-icon"></i>
                    </a>
                    <span class="topnav-crumb-sep">›</span>
                    <i class="bi @crumb.PageIcon topnav-crumb-icon topnav-crumb-icon-cur"></i>
                }
                else
                {
                    <i class="bi @(crumb.CatIcon ?? crumb.PageIcon ?? "bi-grid") topnav-crumb-icon topnav-crumb-icon-cur"></i>
                }
            </span>
            @* Desktop: text *@
            <span class="d-none d-md-flex align-items-center gap-1">
                @if (crumb.Category != null && crumb.PageName != null)
                {
                    <a href="@crumb.CatUrl" class="topnav-crumb-link">@crumb.Category</a>
                    <span class="topnav-crumb-sep">›</span>
                    <span class="topnav-crumb-current">@crumb.PageName</span>
                }
                else
                {
                    <span class="topnav-crumb-current">@(crumb.PageName ?? crumb.Category)</span>
                }
            </span>
        }
    </div>

    @* ── Mobile: search icon + controls inline in header (upper right) ──────── *@
    <div class="d-flex d-md-none ms-auto align-items-center gap-1">
        <button class="topnav-link" @onclick="OpenSearch" title="Search">
            <i class="bi bi-search"></i>
        </button>
        <div class="topnav-controls d-flex align-items-center gap-1">
            <UserBoard />
        </div>
    </div>

    @* ── Desktop: search + controls in standard navbar collapse ── *@
    <div class="collapse navbar-collapse" id="topnav-nav">
        <div class="topnav-right ms-auto">
            <div class="topnav-search-wrap">
                <input class="topnav-search" type="search" placeholder="Search canon…"
                       value="@searchInput" @oninput="OnSearchInput" @onkeydown="HandleKey" />
            </div>
            <div class="topnav-controls d-flex align-items-center gap-1">
                <UserBoard />
            </div>
        </div>
    </div>

</nav>

@code {
    private string searchInput = "";

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        SyncSearchFromUrl();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncSearchFromUrl();
        InvokeAsync(StateHasChanged);
    }

    private void SyncSearchFromUrl()
    {
        var uri = new Uri(Nav.Uri);
        var path = uri.AbsolutePath.TrimStart('/');
        if (path.Equals("search", StringComparison.OrdinalIgnoreCase))
            searchInput = GetQueryParam(uri.Query, "q");
        else
            searchInput = "";
    }

    private static string GetQueryParam(string query, string key)
    {
        if (string.IsNullOrEmpty(query)) return "";
        foreach (var pair in query.TrimStart('?').Split('&'))
        {
            var kv = pair.Split('=', 2);
            if (kv.Length == 2 && Uri.UnescapeDataString(kv[0]).Equals(key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(kv[1]);
        }
        return "";
    }

    private void OnSearchInput(ChangeEventArgs e) => searchInput = e.Value?.ToString() ?? "";

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchInput))
            Nav.NavigateTo($"/search?q={Uri.EscapeDataString(searchInput.Trim())}");
    }

    private async Task OpenSearch() => await SearchTrigger.RequestOpenAsync();

    // ── Breadcrumb ───────────────────────────────────────────

    private record CrumbInfo(string? Category, string? CatUrl, string? PageName, string? CatIcon = null, string? PageIcon = null);

    private CrumbInfo? GetCrumb()
    {
        var seg = new Uri(Nav.Uri).AbsolutePath.TrimStart('/').ToLower();
        return seg switch
        {
            "" or "login" => null,
            "search"          => new(null, null, "Search",           null,          "bi-search"),
            "profile"         => new(null, null, "Profile",          null,          "bi-person-circle"),
            "settings"        => new(null, null, "Settings",         null,          "bi-gear"),
            "users"           => new(null, null, "Users",            null,          "bi-people-fill"),
            "logging"         => new(null, null, "Logging",          null,          "bi-journal-code"),
            "dashboard"       => new("Tools",         "/board/tools",         "Dashboard",       "bi-grid-3x3-gap", "bi-speedometer2"),
            "graph"           => new("Tools",         "/board/tools",         "World Graph",     "bi-grid-3x3-gap", "bi-diagram-3"),
            "map"             => new("Tools",         "/board/tools",         "Map",             "bi-grid-3x3-gap", "bi-map-fill"),
            "facts"           => new("Tools",         "/board/tools",         "Fact Discovery",  "bi-grid-3x3-gap", "bi-lightbulb"),
            "heritage"        => new("Tools",         "/board/tools",         "Heritage",        "bi-grid-3x3-gap", "bi-tree-fill"),
            "contracts"       => new(null,            null,                   "Contracts",       null,                   "bi-file-earmark-text"),
            "characters"      => new("Characters",    "/board/characters",    "People",          "bi-people-fill",       "bi-person"),
            "synthetics"      => new("Characters",    "/board/characters",    "Synthetic Life",  "bi-people-fill",       "bi-cpu-fill"),
            "archetypes"      => new("Characters",    "/board/characters",    "Archetypes",      "bi-people-fill",       "bi-person-bounding-box"),
            "ceramic-men"     => new("Characters",    "/board/characters",    "Ceramic Men",     "bi-people-fill",            "bi-emoji-neutral"),
            "corps"           => new("Organizations", "/board/organizations", "Corponations",    "bi-buildings",         "bi-building"),
            "subsidiaries"    => new("Organizations", "/board/organizations", "Subsidiaries",    "bi-buildings",         "bi-diagram-3"),
            "factions"        => new("Organizations", "/board/organizations", "Factions",        "bi-buildings",         "bi-shield-exclamation"),
            "weaponry"        => new("Gear",          "/board/gear",          "Weaponry",        "bi-tools",             "bi-crosshair"),
            "ammunition"      => new("Gear",          "/board/gear",          "Ammunition",      "bi-tools",             "bi-bullseye"),
            "cyberware"       => new("Gear",          "/board/gear",          "Cyberware",       "bi-tools",             "bi-motherboard"),
            "equipment"       => new("Gear",          "/board/gear",          "Equipment",       "bi-tools",             "bi-shield-shaded"),
            "apparel"         => new("Gear",          "/board/gear",          "Apparel",         "bi-tools",             "bi-handbag"),
            "genemods"        => new("Gear",          "/board/gear",          "Genemods",        "bi-tools",             "bi-virus"),
            "pharmaceuticals" => new("Gear",          "/board/gear",          "Pharmaceuticals", "bi-tools",             "bi-capsule"),
            "places"          => new("World",         "/board/world",         "Places",          "bi-globe2",            "bi-geo-alt"),
            "transportation"  => new("World",         "/board/world",         "Transportation",  "bi-globe2",            "bi-truck"),
            "materials"       => new("World",         "/board/world",         "Materials",       "bi-globe2",            "bi-gem"),
            "technology"      => new("World",         "/board/world",         "Technology",      "bi-globe2",            "bi-cpu"),
            "automata"        => new("World",         "/board/world",         "Automata",        "bi-globe2",            "bi-robot"),
            "specimens"       => new("World",         "/board/world",         "Lab Specimens",   "bi-globe2",            "bi-radioactive"),
            "wasteland"       => new("World",         "/board/world",         "Wasteland",       "bi-globe2",            "bi-tornado"),
            "psionics"        => new("World",         "/board/world",         "Psionics",        "bi-globe2",            "bi-eye"),
            "rules"           => new("World",         "/board/world",         "World Rules",     "bi-globe2",            "bi-book"),
            "documents"       => new("Culture",       "/board/culture",       "Documents",       "bi-palette2",          "bi-file-earmark-text"),
            "quotes"          => new("Culture",       "/board/culture",       "Quotes",          "bi-palette2",          "bi-quote"),
            "vocabulary"      => new("Culture",       "/board/culture",       "Vocabulary",      "bi-palette2",          "bi-chat-quote"),
            "news"            => new("Culture",       "/board/culture",       "News",            "bi-palette2",          "bi-newspaper"),
            "entertainment"   => new("Culture",       "/board/culture",       "Entertainment",   "bi-palette2",          "bi-film"),
            "goods"           => new("Culture",       "/board/culture",       "Consumer Goods",  "bi-palette2",          "bi-basket"),
            "board/characters"    => new(null, null, "Characters",    null, "bi-people-fill"),
            "board/organizations" => new(null, null, "Organizations", null, "bi-buildings"),
            "board/gear"          => new(null, null, "Gear",          null, "bi-tools"),
            "board/world"         => new(null, null, "World",         null, "bi-globe2"),
            "board/culture"       => new(null, null, "Culture",       null, "bi-palette2"),
            "board/tools"         => new(null, null, "Tools",         null, "bi-grid-3x3-gap"),
            _ when seg.StartsWith("board/") => new(null, null, BoardTitle(seg[6..]), null, "bi-grid"),
            _ => null
        };
    }

    private static string BoardTitle(string slug) => slug switch
    {
        "characters"    => "Characters",
        "organizations" => "Organizations",
        "gear"          => "Gear",
        "world"         => "World",
        "culture"       => "Culture",
        "tools"         => "Tools",
        _ => slug.Length == 0 ? "" : char.ToUpper(slug[0]) + slug[1..]
    };

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
