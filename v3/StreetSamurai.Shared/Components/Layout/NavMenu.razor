@implements IDisposable
@inject NavigationManager Nav
@inject IWriteAccessProvider Access
@inject SearchTriggerService SearchTrigger
@inject StreetSamurai.Core.Services.FindingsService Findings
@inject StreetSamurai.Core.Services.ContinuityService Continuity

<nav class="topnav navbar navbar-expand-md">

    @* ── Brand + Breadcrumb — consolidated left side ──────── *@
    @{ var crumb = GetCrumb(); }
    <div class="topnav-left me-auto d-flex align-items-center">
        <NavLink class="topnav-brand" href="" Match="NavLinkMatch.All">
            <i class="bi bi-house-fill"></i>
        </NavLink>
        @if (crumb != null)
        {
            <span class="topnav-crumb-sep">›</span>
            @* Mobile: icons only *@
            <span class="d-flex d-md-none align-items-center gap-1">
                @if (crumb.Grandparent != null && crumb.GrandparentIcon != null)
                {
                    <a href="@crumb.GrandparentUrl" class="topnav-crumb-icon-link">
                        <i class="bi @crumb.GrandparentIcon topnav-crumb-icon"></i>
                    </a>
                    <span class="topnav-crumb-sep">›</span>
                }
                @if (crumb.CatIcon != null && crumb.PageIcon != null)
                {
                    <a href="@crumb.CatUrl" class="topnav-crumb-icon-link">
                        <i class="bi @crumb.CatIcon topnav-crumb-icon"></i>
                    </a>
                    <span class="topnav-crumb-sep">›</span>
                    <i class="bi @crumb.PageIcon topnav-crumb-icon topnav-crumb-icon-cur"></i>
                }
                else
                {
                    <i class="bi @(crumb.CatIcon ?? crumb.PageIcon ?? "bi-grid") topnav-crumb-icon topnav-crumb-icon-cur"></i>
                }
            </span>
            @* Desktop: text *@
            <span class="d-none d-md-flex align-items-center gap-1">
                @if (crumb.Grandparent != null)
                {
                    <a href="@crumb.GrandparentUrl" class="topnav-crumb-link">@crumb.Grandparent</a>
                    <span class="topnav-crumb-sep">›</span>
                }
                @if (crumb.Category != null && crumb.PageName != null)
                {
                    <a href="@crumb.CatUrl" class="topnav-crumb-link">@crumb.Category</a>
                    <span class="topnav-crumb-sep">›</span>
                    <span class="topnav-crumb-current">@crumb.PageName</span>
                }
                else
                {
                    <span class="topnav-crumb-current">@(crumb.PageName ?? crumb.Category)</span>
                }
            </span>
        }
    </div>

    @* ── Mobile: search icon + controls inline in header (upper right) ──────── *@
    <div class="d-flex d-md-none ms-auto align-items-center gap-1">
        <button class="topnav-link" @onclick="OpenSearch" title="Search">
            <i class="bi bi-search"></i>
        </button>
        <a class="topnav-link" href="/strands" title="Strands — writer + recorder + listener">
            <i class="bi bi-headphones"></i>
        </a>
        <AuthorizeView Policy="@MaPolicies.Admin">
            <a class="topnav-link" href="/strands" title="Strands — writer + recorder + listener">
                <i class="bi bi-pencil-square"></i>
            </a>
        </AuthorizeView>
        <a class="topnav-link" href="/timeline" title="Story timeline">
            <i class="bi bi-clock-history"></i>
        </a>
        <a class="topnav-link" href="/schema" title="Database schema viewer">
            <i class="bi bi-diagram-3"></i>
        </a>
        <AuthorizeView Policy="@MaPolicies.Admin">
            <a class="topnav-link position-relative" href="/findings" title="@(inboxCount > 0 ? inboxTooltip : "Inbox — findings & continuity contradictions")">
                <i class="bi bi-inbox"></i>
                @if (inboxCount > 0)
                {
                    <span class="badge bg-warning text-dark inbox-count start-100 translate-middle">@inboxCount</span>
                }
            </a>
        </AuthorizeView>
        <div class="topnav-controls d-flex align-items-center gap-1">
            <UserBoard />
        </div>
    </div>

    @* ── Desktop: search + controls in standard navbar collapse ── *@
    <div class="collapse navbar-collapse" id="topnav-nav">
        <div class="topnav-right ms-auto">
            <div class="topnav-search-wrap">
                <input class="topnav-search" type="search" placeholder="Search canon…"
                       value="@searchInput" @oninput="OnSearchInput" @onkeydown="HandleKey" />
            </div>
            <div class="topnav-controls d-flex align-items-center gap-1">
                <a class="topnav-link" href="/listen" title="Tonight's adventure">
                    <i class="bi bi-headphones"></i>
                </a>
                <AuthorizeView Policy="@MaPolicies.Admin">
                    <a class="topnav-link" href="/write" title="Write">
                        <i class="bi bi-pencil-square"></i>
                    </a>
                </AuthorizeView>
                <AuthorizeView Policy="@MaPolicies.Admin">
                    <a class="topnav-link position-relative" href="/findings" title="@(inboxCount > 0 ? inboxTooltip : "Inbox — findings & continuity contradictions")">
                        <i class="bi bi-inbox"></i>
                        @if (inboxCount > 0)
                        {
                            <span class="badge bg-warning text-dark inbox-count start-100 translate-middle">@inboxCount</span>
                        }
                    </a>
                </AuthorizeView>
                <UserBoard />
            </div>
        </div>
    </div>

</nav>

@code {
    private string searchInput = "";
    // Inbox badge — combined unread count across the two persistent issue
    // streams: ContinuousQualityService findings (status='New') and
    // ContinuityService contradictions (status='CONTRADICTED'). Both stay in
    // SQL until the user explicitly resolves them, so the count survives
    // restarts and only goes down when issues are actually dealt with.
    private int findingsUnread;
    private int contradictionsUnread;
    private int inboxCount => findingsUnread + contradictionsUnread;
    private string inboxTooltip = "";
    private System.Threading.Timer? inboxPoll;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        SyncSearchFromUrl();
        RefreshInboxCount();
        // Poll every 15s so the badge picks up findings/contradictions posted
        // by the autonomous monitor + the daily continuity sweep without
        // requiring the user to navigate.
        inboxPoll = new System.Threading.Timer(_ =>
        {
            RefreshInboxCount();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    private void RefreshInboxCount()
    {
        try { findingsUnread = Findings.CountByStatus(StreetSamurai.Core.Services.FindingStatus.New); }
        catch { findingsUnread = 0; }
        try { contradictionsUnread = Continuity.CountUnresolvedContradictions(); }
        catch { contradictionsUnread = 0; }
        inboxTooltip = (findingsUnread, contradictionsUnread) switch
        {
            (0, 0) => "Inbox empty",
            (_, 0) => $"{findingsUnread} unread finding{(findingsUnread == 1 ? "" : "s")}",
            (0, _) => $"{contradictionsUnread} unresolved continuity contradiction{(contradictionsUnread == 1 ? "" : "s")}",
            _      => $"{findingsUnread} finding{(findingsUnread == 1 ? "" : "s")} · {contradictionsUnread} contradiction{(contradictionsUnread == 1 ? "" : "s")}",
        };
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncSearchFromUrl();
        RefreshInboxCount();
        InvokeAsync(StateHasChanged);
    }

    private void SyncSearchFromUrl()
    {
        var uri = new Uri(Nav.Uri);
        var path = uri.AbsolutePath.TrimStart('/');
        if (path.Equals("search", StringComparison.OrdinalIgnoreCase))
            searchInput = GetQueryParam(uri.Query, "q");
        else
            searchInput = "";
    }

    private static string GetQueryParam(string query, string key)
    {
        if (string.IsNullOrEmpty(query)) return "";
        foreach (var pair in query.TrimStart('?').Split('&'))
        {
            var kv = pair.Split('=', 2);
            if (kv.Length == 2 && Uri.UnescapeDataString(kv[0]).Equals(key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(kv[1]);
        }
        return "";
    }

    private void OnSearchInput(ChangeEventArgs e) => searchInput = e.Value?.ToString() ?? "";

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchInput))
            Nav.NavigateTo($"/search?q={Uri.EscapeDataString(searchInput.Trim())}");
    }

    private async Task OpenSearch() => await SearchTrigger.RequestOpenAsync();

    // ── Breadcrumb ───────────────────────────────────────────

    private record CrumbInfo(
        string? Category, string? CatUrl, string? PageName,
        string? CatIcon = null, string? PageIcon = null,
        string? Grandparent = null, string? GrandparentUrl = null, string? GrandparentIcon = null);

    private CrumbInfo? GetCrumb()
    {
        var seg = new Uri(Nav.Uri).AbsolutePath.TrimStart('/').ToLower();
        return seg switch
        {
            "" or "login" => null,
            "search"          => new(null, null, "Search",           null,          "bi-search"),
            "profile"         => new(null, null, "Profile",          null,          "bi-person-circle"),
            "settings"        => new(null, null, "Settings",         null,          "bi-gear"),
            "users"           => new(null, null, "Users",            null,          "bi-people-fill"),
            "logging"         => new(null, null, "Logging",          null,          "bi-journal-code"),
            "utilities"       => new(null, null, "Utilities",        null,          "bi-tools"),
            "strands"         => new(null, null, "Strands",          null,          "bi-collection"),
            _ when seg.StartsWith("strand/")
                              => new("Strands",       "/strands",              StrandTitle(seg[7..]), "bi-collection",     "bi-pencil-square"),
            "dashboard"       => new("Tools",          "/board/tools",          "Dashboard",         "bi-grid-3x3-gap",     "bi-speedometer2"),
            "ask"             => new("Tools",          "/board/tools",          "Ask",               "bi-grid-3x3-gap",     "bi-chat-dots"),
            "books"           => new("Tools",          "/board/tools",          "Bookshelf",         "bi-grid-3x3-gap",     "bi-book"),
            _ when seg.StartsWith("books/") && seg.EndsWith("/motifs")
                              => new("Bookshelf",      "/books",                "Motifs",            "bi-book",             "bi-tags",
                                     "Tools",          "/board/tools",          "bi-grid-3x3-gap"),
            _ when seg.StartsWith("books/") && seg.EndsWith("/continuity-extract")
                              => new("Bookshelf",      "/books",                "Continuity",        "bi-book",             "bi-search",
                                     "Tools",          "/board/tools",          "bi-grid-3x3-gap"),
            _ when seg.StartsWith("books/") && seg.EndsWith("/outline")
                              => new("Bookshelf",      "/books",                "Outline",           "bi-book",             "bi-list-ol",
                                     "Tools",          "/board/tools",          "bi-grid-3x3-gap"),
            _ when seg.StartsWith("books/")
                              => new("Bookshelf",      "/books",                "Book",              "bi-book",             "bi-book-half",
                                     "Tools",          "/board/tools",          "bi-grid-3x3-gap"),
            "continuity"      => new("Tools",          "/board/tools",          "Continuity",        "bi-grid-3x3-gap",     "bi-database-check"),
            "atlas"           => new("Tools",          "/board/tools",          "Atlas",             "bi-grid-3x3-gap",     "bi-book-half"),
            "architecture"    => new("Tools",          "/board/tools",          "Architecture",      "bi-grid-3x3-gap",     "bi-diagram-3"),
            "series"          => new("Tools",          "/board/tools",          "Series",            "bi-grid-3x3-gap",     "bi-collection"),
            "char-pipeline"   => new("Tools",          "/board/tools",          "Character Pipeline","bi-grid-3x3-gap",     "bi-person-badge"),
            "world-health"    => new("Tools",          "/board/tools",          "World Health",      "bi-grid-3x3-gap",     "bi-heart-pulse"),
            "data-repair"     => new("Tools",          "/board/tools",          "Data Repair",       "bi-grid-3x3-gap",     "bi-tools"),
            "generators"      => new("Tools",          "/board/tools",          "Generator Console", "bi-grid-3x3-gap",     "bi-terminal"),
            "graph"           => new("Visualizations", "/board/visualizations", "World Graph",       "bi-easel2",           "bi-diagram-3"),
            "graph-3d"        => new("Visualizations", "/board/visualizations", "World Graph 3D",    "bi-easel2",           "bi-bounding-box"),
            "map"             => new("Visualizations", "/board/visualizations", "Map",               "bi-easel2",           "bi-map-fill"),
            "heritage"        => new("Visualizations", "/board/visualizations", "Heritage",          "bi-easel2",           "bi-tree-fill"),
            _ when seg.StartsWith("stories/write/")
                              => new("Bookshelf",      "/books",                "Edit Chapter",      "bi-book",             "bi-pencil-fill",
                                     "Tools",          "/board/tools",          "bi-grid-3x3-gap"),
            "contracts"       => new(null,            null,                   "Contracts",       null,                   "bi-file-earmark-text"),
            "characters"      => new("Characters",    "/board/characters",    "People",          "bi-people-fill",       "bi-person"),
            "archetypes"      => new("Characters",    "/board/characters",    "Archetypes",      "bi-people-fill",       "bi-person-bounding-box"),
            "corps"           => new("Organizations", "/board/organizations", "Corponations",    "bi-buildings",         "bi-building"),
            "subsidiaries"    => new("Organizations", "/board/organizations", "Subsidiaries",    "bi-buildings",         "bi-diagram-3"),
            "factions"        => new("Organizations", "/board/organizations", "Factions",        "bi-buildings",         "bi-shield-exclamation"),
            "weaponry"        => new("Gear",          "/board/gear",          "Weaponry",        "bi-tools",             "bi-crosshair"),
            "ammunition"      => new("Gear",          "/board/gear",          "Ammunition",      "bi-tools",             "bi-bullseye"),
            "cyberware"       => new("Gear",          "/board/gear",          "Cyberware",       "bi-tools",             "bi-motherboard"),
            "equipment"       => new("Gear",          "/board/gear",          "Equipment",       "bi-tools",             "bi-shield-shaded"),
            "apparel"         => new("Gear",          "/board/gear",          "Apparel",         "bi-tools",             "bi-handbag"),
            "genemods"        => new("Gear",          "/board/gear",          "Genemods",        "bi-tools",             "bi-virus"),
            "pharmaceuticals" => new("Gear",          "/board/gear",          "Pharmaceuticals", "bi-tools",             "bi-capsule"),
            "places"          => new("World",         "/board/world",         "Places",          "bi-globe2",            "bi-geo-alt"),
            "transportation"  => new("World",         "/board/world",         "Transportation",  "bi-globe2",            "bi-truck"),
            "materials"       => new("World",         "/board/world",         "Materials",       "bi-globe2",            "bi-gem"),
            "technology"      => new("World",         "/board/world",         "Technology",      "bi-globe2",            "bi-cpu"),
            "automata"        => new("World",         "/board/world",         "Automata",        "bi-globe2",            "bi-robot"),
            "specimens"       => new("World",         "/board/world",         "Lab Specimens",   "bi-globe2",            "bi-radioactive"),
            "flyover"         => new("World",         "/board/world",         "The Gap",         "bi-globe2",            "bi-tree"),
            "psionics"        => new("World",         "/board/world",         "Psionics",        "bi-globe2",            "bi-eye"),
            "rules"           => new("World",         "/board/world",         "World Rules",     "bi-globe2",            "bi-book"),
            "documents"       => new("Culture",       "/board/culture",       "Documents",       "bi-palette2",          "bi-file-earmark-text"),
            "quotes"          => new("Culture",       "/board/culture",       "Quotes",          "bi-palette2",          "bi-quote"),
            "vocabulary"      => new("Culture",       "/board/culture",       "Vocabulary",      "bi-palette2",          "bi-chat-quote"),
            "news"            => new("Culture",       "/board/culture",       "News",            "bi-palette2",          "bi-newspaper"),
            "entertainment"   => new("Culture",       "/board/culture",       "Entertainment",   "bi-palette2",          "bi-film"),
            "goods"           => new("Culture",       "/board/culture",       "Consumer Goods",  "bi-palette2",          "bi-basket"),
            "board/characters"     => new(null, null, "Characters",     null, "bi-people-fill"),
            "board/organizations"  => new(null, null, "Organizations",  null, "bi-buildings"),
            "board/gear"           => new(null, null, "Gear",           null, "bi-tools"),
            "board/world"          => new(null, null, "World",          null, "bi-globe2"),
            "board/culture"        => new(null, null, "Culture",        null, "bi-palette2"),
            "board/tools"          => new(null, null, "Tools",          null, "bi-grid-3x3-gap"),
            "board/visualizations" => new(null, null, "Visualizations", null, "bi-easel2"),
            _ when seg.StartsWith("board/") => new(null, null, BoardTitle(seg[6..]), null, "bi-grid"),
            _ => null
        };
    }

    private static string BoardTitle(string slug) => slug switch
    {
        "characters"     => "Characters",
        "organizations"  => "Organizations",
        "gear"           => "Gear",
        "world"          => "World",
        "culture"        => "Culture",
        "tools"          => "Tools",
        "visualizations" => "Visualizations",
        _ => slug.Length == 0 ? "" : char.ToUpper(slug[0]) + slug[1..]
    };

    // Render the slug portion of /strand/{idOrSlug} as a human title in the
    // crumb. Slugs come in two shapes: a GUID (no readable name available
    // without a DB lookup) or a kebab/underscore slug ("bushido_coda" or
    // "bushido-coda-1a2b3c4d"). For GUIDs, fall back to "Strand". For slugs,
    // strip any trailing 8-hex disambiguator, then Title Case each word.
    private static string StrandTitle(string slug)
    {
        if (string.IsNullOrEmpty(slug)) return "Strand";
        if (Guid.TryParse(slug, out _)) return "Strand";
        var s = slug.Replace('_', ' ').Replace('-', ' ').Trim();
        // Drop a trailing 8-hex disambiguator (the suffix CreateAsync appends).
        var parts = s.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length > 1)
        {
            var last = parts[^1];
            if (last.Length == 8 && last.All(c => "0123456789abcdef".Contains(c)))
                parts = parts[..^1];
        }
        return string.Join(' ', parts.Select(p => p.Length == 0 ? p : char.ToUpper(p[0]) + p[1..]));
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
        inboxPoll?.Dispose();
    }
}
