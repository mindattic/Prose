@inject CorponationRepository CorpRepo
@inject FactionRepository FactionRepo
@inject CharacterRepository CharRepo
@inject DistrictRepository DistrictRepo
@inject WorldbuildingDocRepository DocRepo
@inject TechnologyRepository TechRepo
@inject WeaponryRepository WeaponRepo
@inject EquipmentRepository EquipRepo
@inject CyberwareRepository CyberRepo
@inject AmmunitionRepository AmmoRepo
@inject QuoteRepository QuoteRepo
@inject ConsumerGoodRepository GoodsRepo
@inject PharmaceuticalRepository PharmaRepo
@inject MaterialRepository MaterialRepo
@inject ContractRepository ContractRepo
@inject NewsRepository NewsRepo
@inject ArchetypeRepository ArchetypeRepo
@inject VocabularyRepository VocabRepo
@inject SyntheticLifeRepository SynthRepo
@inject GenemodRepository GenemodRepo
@inject TransportationRepository TransportRepo
@inject AutomatonRepository AutomatonRepo
@inject ApparelRepository ApparelRepo
@inject EntertainmentRepository EntertainmentRepo
@inject SubsidiaryRepository SubsidiaryRepo
@inject WorldGraphService GraphSvc
@inject NavigationManager Nav
@inject IWriteAccessProvider Access

<nav class="topnav">
    @* Brand *@
    <NavLink class="topnav-brand" href="" Match="NavLinkMatch.All">Street Samurai</NavLink>
    <div class="topnav-sep"></div>

    @* Quick links *@
    <NavLink class="topnav-link" href="" Match="NavLinkMatch.All" title="Dashboard"><i class="bi bi-house-door"></i></NavLink>
    <NavLink class="topnav-link" href="search" title="Search (Ctrl+K)"><i class="bi bi-search"></i></NavLink>
    @if (Access.CanWrite)
    {
        <NavLink class="topnav-link" href="stories">Stories</NavLink>
    }
    <NavLink class="topnav-link" href="contracts">Contracts <span class="topnav-count">@contractCount</span></NavLink>
    <div class="topnav-sep"></div>

    @* ── Category board links ─────────────────────────────────────── *@
    <NavLink class="topnav-link" href="/board/characters"><i class="bi bi-people-fill topnav-cat-icon"></i>Characters</NavLink>
    <NavLink class="topnav-link" href="/board/organizations"><i class="bi bi-buildings topnav-cat-icon"></i>Organizations</NavLink>
    <NavLink class="topnav-link" href="/board/gear"><i class="bi bi-tools topnav-cat-icon"></i>Gear</NavLink>
    <NavLink class="topnav-link" href="/board/world"><i class="bi bi-globe2 topnav-cat-icon"></i>World</NavLink>
    <NavLink class="topnav-link" href="/board/culture"><i class="bi bi-palette2 topnav-cat-icon"></i>Culture</NavLink>
    <NavLink class="topnav-link" href="/board/tools"><i class="bi bi-grid-3x3-gap topnav-cat-icon"></i>Tools</NavLink>

    @* ── Right side: system + account ─────────────────────────────── *@
    <div class="ms-auto d-flex align-items-center gap-1">
        @if (Access.CanAdminister)
        {
            @Drop("⚙",
                ("bi-book",         "rules",    "World Rules", 0),
                ("bi-people-fill",  "users",    "Users",       0),
                ("bi-gear",         "settings", "Settings",    0),
                ("bi-journal-code", "logging",  "Logging",     0))
        }
        else
        {
            <NavLink class="topnav-link" href="rules" title="World Rules"><i class="bi bi-book"></i></NavLink>
        }

        @if (!Access.IsReadOnlyMode)
        {
            @if (Access.CurrentUserRole != "Anonymous")
            {
                <span class="topnav-user"><i class="bi bi-person-circle"></i> @Access.CurrentUserName</span>
                <form method="post" action="/api/auth/logout" class="d-inline">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-outline-secondary topnav-logout">Logout</button>
                </form>
            }
            else
            {
                <NavLink class="topnav-link" href="login"><i class="bi bi-box-arrow-in-right"></i> Login</NavLink>
            }
        }
    </div>
</nav>

@code {
    private int corpCount, factionCount, charCount, districtCount, techCount, weaponCount,
                ammoCount, equipCount, cyberwareCount, docCount, vocabCount, quoteCount,
                goodsCount, pharmaCount, materialCount, contractCount, newsCount, archetypeCount,
                synthCount, genemodCount, transportCount, automataCount, apparelCount,
                entertainmentCount, subsidiaryCount, graphNodeCount;

    protected override void OnInitialized()
    {
        corpCount          = CorpRepo.GetAll().Count;
        factionCount       = FactionRepo.GetAll().Count;
        charCount          = CharRepo.GetAll().Count;
        districtCount      = DistrictRepo.GetAll().Count;
        weaponCount        = WeaponRepo.GetAll().Count;
        ammoCount          = AmmoRepo.GetAll().Count;
        equipCount         = EquipRepo.GetAll().Count;
        cyberwareCount     = CyberRepo.GetAll().Count;
        techCount          = TechRepo.GetAll().Count;
        docCount           = DocRepo.GetAll().Count;
        vocabCount         = VocabRepo.GetAll().Count;
        quoteCount         = QuoteRepo.GetAll().Count;
        goodsCount         = GoodsRepo.GetAll().Count;
        pharmaCount        = PharmaRepo.GetAll().Count;
        materialCount      = MaterialRepo.GetAll().Count;
        contractCount      = ContractRepo.GetAll().Count;
        newsCount          = NewsRepo.GetAll().Count;
        archetypeCount     = ArchetypeRepo.GetAll().Count;
        synthCount         = SynthRepo.GetAll().Count;
        genemodCount       = GenemodRepo.GetAll().Count;
        transportCount     = TransportRepo.GetAll().Count;
        automataCount      = AutomatonRepo.GetAll().Count;
        apparelCount       = ApparelRepo.GetAll().Count;
        entertainmentCount = EntertainmentRepo.GetAll().Count;
        subsidiaryCount    = SubsidiaryRepo.GetAll().Count;
        GraphSvc.EnsureLoaded();
        graphNodeCount     = GraphSvc.NodeCount;
    }

    private RenderFragment Drop(string label, params (string icon, string href, string name, int count)[] items) => __builder =>
    {
        var boardUrl = label.Length > 1 ? $"/board/{label.ToLower()}" : null;
        @if (boardUrl != null)
        {
            <NavLink class="topnav-link" href="@boardUrl">@label</NavLink>
        }
        else
        {
            <div class="dropdown">
                <button class="topnav-link dropdown-toggle" data-bs-toggle="dropdown" type="button">@label</button>
                <ul class="dropdown-menu topnav-drop-menu">
                    @foreach (var item in items)
                    {
                        <li>
                            <a class="dropdown-item topnav-drop-item" href="@item.href">
                                <i class="bi @item.icon topnav-drop-icon"></i>
                                <span class="flex-grow-1">@item.name</span>
                                @if (item.count > 0)
                                {
                                    <span class="topnav-count">@item.count</span>
                                }
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    };
}
