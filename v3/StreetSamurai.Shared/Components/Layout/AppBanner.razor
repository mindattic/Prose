@* AppBanner — single top bar.
   LEFT:  Universe selector (sole universe switch; NavMenu's duplicate is gone).
   RIGHT: Search · listen · write (admin) · findings-inbox badge · UserBoard.
   Inbox polling + search logic live here; NavMenu is now a no-op stub. *@

@implements IDisposable
@inject NavigationManager Nav
@inject IWriteAccessProvider Access
@inject SearchTriggerService SearchTrigger
@inject StreetSamurai.Core.Services.FindingsService Findings
@inject StreetSamurai.Core.Services.ContinuityService Continuity
@inject StreetSamurai.Core.Services.IUniverseContext Universe
@inject StreetSamurai.Core.Services.AppLinks Links
@inject TabService TabSvc

<div class="app-banner">

    @* ── LEFT: universe selector ─────────────────────────────────────────── *@
    <div class="app-banner-left">
        @if (universes.Count > 1)
        {
            <select class="app-banner-universe form-select form-select-sm"
                    title="Switch universe"
                    @onchange="OnUniverseChanged">
                @foreach (var u in universes)
                {
                    <option value="@u.Id" selected="@(u.Id == currentUniverseId)">@u.Name</option>
                }
            </select>
        }
        else
        {
            <span class="app-banner-title">Street Samurai</span>
        }
    </div>

    @* ── RIGHT: a single hamburger menu — user info, actions, settings, logout ─── *@
    <div class="app-banner-right">
        <div class="ab-menu-wrap">
            @if (menuOpen)
            {
                <div class="ab-menu-backdrop" @onclick="CloseMenu"></div>
            }
            <button class="topnav-link ab-menu-trigger position-relative @(menuOpen ? "open" : "")"
                    type="button" @onclick="ToggleMenu" title="@(inboxCount > 0 ? inboxTooltip : "Menu")">
                <i class="bi bi-list"></i>
                @if (inboxCount > 0)
                {
                    <span class="badge bg-warning text-dark inbox-count start-100 translate-middle">@inboxCount</span>
                }
            </button>

            @if (menuOpen)
            {
                <div class="ab-menu-panel">
                    <div class="ab-menu-user">
                        <i class="bi bi-person-circle ab-menu-user-avatar"></i>
                        <div class="ab-menu-user-meta">
                            <div class="ab-menu-user-name">@Access.CurrentUserName</div>
                            <div class="ab-menu-user-role">@Access.CurrentUserRole</div>
                        </div>
                    </div>
                    <div class="ab-menu-divider"></div>

                    <button class="ab-menu-item" @onclick="OpenSettingsTab">
                        <i class="bi bi-gear"></i><span>Settings</span>
                    </button>

                    <div class="ab-menu-divider"></div>
                    <form method="post" action="/_ma-auth/logout" class="ab-menu-logout">
                        <Microsoft.AspNetCore.Components.Forms.AntiforgeryToken />
                        <button type="submit" class="ab-menu-item ab-menu-logout-btn">
                            <i class="bi bi-box-arrow-right"></i><span>Logout</span>
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>

</div>

@code {
    // ── Universe switch ───────────────────────────────────────────────────
    private IReadOnlyList<StreetSamurai.Core.Services.UniverseInfo> universes
        = new List<StreetSamurai.Core.Services.UniverseInfo>();
    private Guid currentUniverseId;

    /// <summary>Raised when the universe changes so MainLayout can update data-theme.</summary>
    [Parameter] public EventCallback<string> OnThemeChanged { get; set; }

    // ── Hamburger menu ────────────────────────────────────────────────────
    private bool disposed;
    private bool menuOpen;
    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;
    private async Task OpenSearchAndClose() { menuOpen = false; await OpenSearch(); }
    private void OpenSettingsTab()
    {
        menuOpen = false;
        TabSvc.Open(new AppTab("settings", "Settings", "bi-gear", "/settings"));
        Nav.NavigateTo("/settings");
    }

    // ── Search ────────────────────────────────────────────────────────────
    private string searchInput = "";

    // ── Inbox badge ───────────────────────────────────────────────────────
    private int findingsUnread;
    private int contradictionsUnread;
    private int inboxCount => findingsUnread + contradictionsUnread;
    private string inboxTooltip = "";
    private System.Threading.Timer? inboxPoll;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        SyncSearchFromUrl();
        RefreshInboxCount();

        try
        {
            universes = Universe.ListUniverses();
            currentUniverseId = Universe.CurrentId;
        }
        catch
        {
            universes = new List<StreetSamurai.Core.Services.UniverseInfo>();
        }

        inboxPoll = new System.Threading.Timer(_ =>
        {
            if (disposed) return;
            RefreshInboxCount();
            InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(15), TimeSpan.FromSeconds(15));
    }

    // ── Theme helper (used by MainLayout) ────────────────────────────────
    /// <summary>Returns "glmz" for GLMZ (or no universe), "fantasy" for Fantasy.</summary>
    public static string ThemeFor(StreetSamurai.Core.Services.IUniverseContext ctx)
        => ctx.IsGlmz ? "glmz" : "fantasy";

    // ── Universe change ───────────────────────────────────────────────────
    private async Task OnUniverseChanged(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id) || id == currentUniverseId) return;
        Universe.UseUniverse(id);
        Universe.PersistAsDefault(id);
        currentUniverseId = id;
        var theme = Universe.IsGlmz ? "glmz" : "fantasy";
        await OnThemeChanged.InvokeAsync(theme);
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    // ── Search ────────────────────────────────────────────────────────────
    private void SyncSearchFromUrl()
    {
        var uri = new Uri(Nav.Uri);
        var path = uri.AbsolutePath.TrimStart('/');
        searchInput = path.Equals("search", StringComparison.OrdinalIgnoreCase)
            ? GetQueryParam(uri.Query, "q")
            : "";
    }

    private static string GetQueryParam(string query, string key)
    {
        if (string.IsNullOrEmpty(query)) return "";
        foreach (var pair in query.TrimStart('?').Split('&'))
        {
            var kv = pair.Split('=', 2);
            if (kv.Length == 2 && Uri.UnescapeDataString(kv[0]).Equals(key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(kv[1]);
        }
        return "";
    }

    private void OnSearchInput(ChangeEventArgs e) => searchInput = e.Value?.ToString() ?? "";

    private void HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchInput))
            Nav.NavigateTo($"/search?q={Uri.EscapeDataString(searchInput.Trim())}");
    }

    private async Task OpenSearch() => await SearchTrigger.RequestOpenAsync();

    // ── Inbox ─────────────────────────────────────────────────────────────
    private void RefreshInboxCount()
    {
        try { findingsUnread = Findings.CountByStatus(StreetSamurai.Core.Services.FindingStatus.New); }
        catch { findingsUnread = 0; }
        try { contradictionsUnread = Continuity.CountUnresolvedContradictions(); }
        catch { contradictionsUnread = 0; }
        inboxTooltip = (findingsUnread, contradictionsUnread) switch
        {
            (0, 0) => "Inbox empty",
            (_, 0) => $"{findingsUnread} unread finding{(findingsUnread == 1 ? "" : "s")}",
            (0, _) => $"{contradictionsUnread} unresolved continuity contradiction{(contradictionsUnread == 1 ? "" : "s")}",
            _      => $"{findingsUnread} finding{(findingsUnread == 1 ? "" : "s")} · {contradictionsUnread} contradiction{(contradictionsUnread == 1 ? "" : "s")}",
        };
    }

    // ── Location change ───────────────────────────────────────────────────
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        menuOpen = false;
        SyncSearchFromUrl();
        RefreshInboxCount();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        disposed = true;
        Nav.LocationChanged -= OnLocationChanged;
        inboxPoll?.Dispose();
    }
}
