    private async Task StopAsync()
    {
        if (node == null) return;
        if (Workbench.CancelNarration(node.Id))
        {
            Toast.Info("STOP", "Narration cancelled.");
            await ReloadBeatsAsync();
        }
    }

    private async Task ReloadBeatsAsync()
    {
        if (node == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var fresh = await db.Nodes.AsNoTracking().FirstOrDefaultAsync(s => s.Id == node.Id);
        if (fresh != null)
        {
            node.Status = fresh.Status;
            node.CombinedAudioPath = fresh.CombinedAudioPath;
            node.CharsNarrated = fresh.CharsNarrated;
        }
        beats = await Workbench.GetOrderedBeatsAsync(node.Id, includeDisabled: showDisabledBeats);
        SyncDraftsAfterReload();
        await RefreshHistoryCountsAsync();
    }

    /// <summary>Build the combined-audio URL with a cache-bust query string.
    /// Without the bust, re-stitching a node writes new bytes to the same
    /// URL — browsers serve the stale cached version until the page is
    /// hard-reloaded. AudioCompletedAt ticks change on every successful
    /// re-narrate, so appending them invalidates the browser cache cleanly.</summary>
    private string CombinedAudioUrl()
    {
        if (node == null) return "";
        var bust = node.AudioCompletedAt?.Ticks.ToString() ?? node.UpdatedAt.Ticks.ToString();
        return $"/api/nodes/{node.Id}/node.wav?v={bust}";
    }

    private static string StatusColor(string status) => NodeWorkbenchService.StatusColor(status);
    private static string StatusLabel(string status) => NodeWorkbenchService.StatusLabel(status);

    private static string FormatDuration(double sec)
    {
        var ts = TimeSpan.FromSeconds(sec);
        return ts.TotalMinutes >= 1 ? $"{(int)ts.TotalMinutes}:{ts.Seconds:D2}" : $"{ts.TotalSeconds:0.0}s";
    }

    /// <summary>Called from JS as each beat in a play-selected sequence
    /// begins. Persists Node.LastPlayedBeatId so the resume banner shows
    /// up next time the node loads. Fire-and-forget; failures don't
    /// interrupt playback.
    ///
    /// Coalesced: a fast playback of 50 beats would otherwise trigger 50
    /// UPDATEs against Nodes. We compare against the in-memory
    /// <c>resumeBeatId</c> first so duplicate "still on the same beat"
    /// callbacks (paused/resumed without advancing, double-fire from the
    /// audio element's events) are a no-op.</summary>
    [JSInvokable]
    public async Task OnBeatStarted(string beatIdString)
    {
        if (node == null || !Guid.TryParse(beatIdString, out var bid)) return;
        // Already recorded — skip the round-trip. resumeBeatId tracks the
        // in-memory equivalent of Nodes.LastPlayedBeatId so a stable read
        // means a stable write too.
        if (resumeBeatId == bid) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.Nodes.FirstOrDefaultAsync(s => s.Id == node.Id);
            if (row == null) return;
            row.LastPlayedBeatId = bid;
            row.LastPlayedSec    = 0; // resume granularity is per-beat for now
            row.UpdatedAt        = DateTime.UtcNow;
            await db.SaveChangesAsync();
            resumeBeatId = bid;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) { Console.Error.WriteLine($"[node-resume] save failed: {ex.Message}"); }
    }

    /// <summary>Called from JS when the user attempted to drop a beat onto
    /// a row in a different node. Re-parenting across nodes isn't
    /// supported by MoveBeatAsync today — surface a clear toast instead of
    /// the silent no-op the user would otherwise see.</summary>
    [JSInvokable]
    public Task OnCrossNodeDropRejected()
    {
        Toast.Warning("MOVE", "Cross-node reorder isn't supported yet — drag only works within one node.");
        return Task.CompletedTask;
    }

    /// <summary>Called from JS when the user drops a beat row onto another.
    /// Routes through Workbench.MoveBeatAsync which only mutates the
    /// fractional SortKey — audio stays valid.</summary>
    [JSInvokable]
    public async Task OnBeatDropped(string draggedIdString, string targetIdString)
    {
        if (node == null) return;
        if (!Guid.TryParse(draggedIdString, out var dragged) || !Guid.TryParse(targetIdString, out var target)) return;
        if (dragged == target) return;
        try
        {
            // Drop-target semantics: the dragged beat lands AFTER the row
            // it was dropped on. Dropping onto the first row therefore moves
            // the beat to position 2; use "insert at top" affordance for
            // position 1 (drag onto self is rejected by the workbench).
            await Workbench.MoveBeatAsync(node.Id, dragged, target);
            await ReloadBeatsAsync();
            await InvokeAsync(StateHasChanged);
            Toast.Success("MOVE", "Beat reordered.");
        }
        catch (Exception ex) { Toast.Error("MOVE-FAIL", ex.Message); }
    }

    /// <summary>Scroll to the saved resume beat. Smooth-scroll via JS; the
    /// row's .resume-here class gives the visual landing point.</summary>
    private async Task ScrollToResumeAsync()
    {
        if (!resumeBeatId.HasValue) return;
        try { await JS.InvokeVoidAsync("streetsamurai.scrollBeatIntoView", resumeBeatId.Value.ToString()); }
        catch { /* JS race — banner stays visible, user can click again */ }
    }

    /// <summary>TOC click → smooth-scroll to the section's first beat.</summary>
    private async Task ScrollToBeatAsync(Guid beatId)
    {
        try { await JS.InvokeVoidAsync("streetsamurai.scrollBeatIntoView", beatId.ToString()); }
        catch { /* JS race — user can click the entry again */ }
    }

    /// <summary>Forget the saved listening position. Updates the node row
    /// AND the in-memory resume marker so the banner disappears immediately.</summary>
    private async Task ClearResumeAsync()
    {
        if (node == null) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var row = await db.Nodes.FirstOrDefaultAsync(s => s.Id == node.Id);
            if (row != null)
            {
                row.LastPlayedBeatId = null;
                row.LastPlayedSec    = null;
                row.UpdatedAt        = DateTime.UtcNow;
                await db.SaveChangesAsync();
            }
            resumeBeatId = null;
            StateHasChanged();
        }
        catch (Exception ex) { Toast.Error("RESUME-CLEAR-FAIL", ex.Message); }
    }

    /// <summary>Play or pause/resume the per-beat narration preview.
    /// First call synthesises via ElevenLabs and caches the result in
    /// Beat.AudioPath; re-clicking the same beat toggles pause/resume;
    /// clicking a different beat stops the current one and starts the new one.
    /// NarrateBeatAsync is idempotent — it skips TTS when audio is already
    /// cached and Beat.Stale is false.</summary>
    private async Task ToggleBeatPreviewAsync(Guid beatId)
    {
        if (node == null) return;

        // Toggle pause/resume when this beat is already active.
        if (playingBeatId == beatId && narratingBeatId == null)
        {
            beatPreviewPaused = await JS.InvokeAsync<bool>("streetsamurai.pauseBeatPreview");
            StateHasChanged();
            return;
        }

        // Stop any currently active preview before starting a new one.
        if (playingBeatId.HasValue)
        {
            try { _ = JS.InvokeVoidAsync("streetsamurai.stopBeatPreview"); } catch { }
            playingBeatId     = null;
            beatPreviewPaused = false;
        }

        narratingBeatId = beatId;
        StateHasChanged();
        try
        {
            await Workbench.NarrateBeatAsync(node.Id, beatId, force: false);

            await using var db = await DbFactory.CreateDbContextAsync();
            var refreshed = await db.Beats.AsNoTracking().FirstOrDefaultAsync(b => b.Id == beatId);
            if (refreshed == null || string.IsNullOrEmpty(refreshed.AudioPath)) return;

            // Push updated audio metadata into the live list so Stale chips refresh.
            var entry = beats.FirstOrDefault(e => e.Beat.Id == beatId);
            if (entry != null)
            {
                entry.Beat.AudioPath  = refreshed.AudioPath;
                entry.Beat.NarratedAt = refreshed.NarratedAt;
                entry.Beat.Stale      = refreshed.Stale;
                entry.Beat.TextHash   = refreshed.TextHash;
            }

            var url = $"/api/nodes/{node.Id}/beat/{beatId}/audio?v={refreshed.NarratedAt?.Ticks ?? 0}";
            playingBeatId     = beatId;
            beatPreviewPaused = false;
            selfRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("streetsamurai.playBeatPreview", url, selfRef);
        }
        catch (Exception ex)
        {
            Toast.Error("BEAT-PREVIEW", ex.Message);
            playingBeatId = null;
        }
        finally
        {
            narratingBeatId = null;
            StateHasChanged();
        }
    }

    /// <summary>Called from JS when the preview audio finishes playing naturally.
    /// Resets the play button back to the idle state.</summary>
    [JSInvokable]
    public void OnBeatPreviewEnded()
    {
        playingBeatId     = null;
        beatPreviewPaused = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        poll?.Dispose();
        // Best-effort JS teardown — page is unloading, so a fire-and-forget
        // is fine. Don't await; the framework expects Dispose to be sync.
        if (!string.IsNullOrEmpty(escapeToken))
        {
            try { _ = JS.InvokeVoidAsync("streetsamurai.uninstallPageEscape", escapeToken); }
            catch { /* circuit may already be torn down */ }
        }
        try { _ = JS.InvokeVoidAsync("streetsamurai.stopBeatPreview"); } catch { }
        selfRef?.Dispose();
    }
}
