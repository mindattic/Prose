    private async Task RunReaderPanelAsync()
    {
        if (node is null || reviewRunning) return;
        reviewRunning  = true;
        reviewResult   = null;
        reviewProgress = 0;
        reviewRanLocal = reviewUseLocal;
        reviewRanModel = reviewUseLocal ? Settings.LocalReviewModel : "trusted-4 panel";
        StateHasChanged();
        try
        {
            var progress = new Progress<int>(n => { reviewProgress = n; _ = InvokeAsync(StateHasChanged); });
            reviewResult = await ReviewSvc.RunSampledReviewAsync(
                node.Id, Settings.ReviewBallots, Settings.ReviewProse, progress,
                useLocal: reviewUseLocal,
                allowVotes: true); // SS-A44: the panel button IS the explicit user request to vote.
            if (reviewResult.BlockedByStructure)
                Toast.Error("REVIEW", "Blocked by structural pre-flight — fix the failures, then re-run.");
            else
                Toast.Success("REVIEW", $"{(reviewRanLocal ? "LOCAL" : "CLOUD")} reader panel: {reviewResult.MeanScore:0.0}/100 ({reviewResult.BallotsSaved} ballots).");
        }
        catch (Exception ex)
        {
            Toast.Error("REVIEW-FAIL", ex.Message);
        }
        finally
        {
            reviewRunning = false;
            await InvokeAsync(StateHasChanged);
        }
