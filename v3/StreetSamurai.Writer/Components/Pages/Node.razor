@page "/node/{IdOrSlug}"
@page "/story/{IdOrSlug}"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@using Microsoft.EntityFrameworkCore
@using StreetSamurai.Core.Data
@using StreetSamurai.Core.Data.Entities
@using StreetSamurai.Core.Services
@using StreetSamurai.Shared.Services
@using NodeEntity = StreetSamurai.Core.Data.Entities.Node
@using BeatEntity = StreetSamurai.Core.Data.Entities.Beat
@using MindAttic.Legion
@inject IDbContextFactory<StreetSamuraiDbContext> DbFactory
@inject NodeWorkbenchService Workbench
@inject ElevenLabsTtsService Tts
@inject SettingsService Settings
@inject NavigationManager Nav
@inject ToastNotifier Toast
@inject IJSRuntime JS
@inject StreetSamurai.Core.Interfaces.ILlmService Llm
@inject ILogger<Node> Log
@inject DocxExportService Docx
@inject ManuscriptExportService Manuscript
@inject NodeBibleService BibleService
@inject StructuralDiagnosticService DiagSvc
@inject NodeReviewService ReviewSvc
@implements IDisposable

@*
   The unified writer + recorder + listener. One page does everything:
   write, edit, record, add beats (before/after), split, join, re-record,
   delete. /write, /listen, /recordings all funnel here.
*@

<style>
    .node-shell { max-width: 1040px; }
    .node-head { background: rgba(15,15,15,0.95); border-bottom: 1px solid #2a2a2a; padding: 0.75rem 0; margin-bottom: 1rem; }
    .node-title { background: transparent; border: none; color: #f8f9fa; font-size: 1.5rem; font-weight: 600; padding: 0; outline: none; }
    .node-title:focus { box-shadow: none; border-bottom: 2px solid #0dcaf0; }
    .node-description { background: transparent; border: none; color: #adb5bd; font-size: 0.9rem; resize: none; padding: 0; outline: none; width: 100%; }
    .node-description:focus { color: #ced4da; }
    .bible-panel { background: #0d1117; border: 1px solid #2a2a2a; border-radius: 6px; padding: 0.75rem 1rem; margin-top: 0.5rem; }
    .bible-panel pre { white-space: pre-wrap; word-break: break-word; font-size: 0.82rem; color: #adb5bd; margin: 0; }
    .bible-toggle { font-size: 0.8rem; color: #6c757d; cursor: pointer; user-select: none; }
    .bible-toggle:hover { color: #adb5bd; }
    .beat-card { background: #161616; border: 1px solid #2a2a2a; border-radius: 8px; padding: 0.65rem 0.9rem; transition: border-color 0.15s ease, box-shadow 0.15s ease; position: relative; }

    /* 3-row layout: header bar (controls), body (prose ↔ textarea), footer
       (gap-after + meta chips). Rows separated by margin only — no borders
       between rows so the card reads as one block. */
    .beat-row-1 { /* spacing handled by .mb-2 on the element */ }
    .beat-row-2 { min-height: 1.55rem; }
    .beat-row-3 { margin-top: 0.5rem; padding-top: 0.4rem; border-top: 1px solid #1f1f1f; }
    /* Row 3 bottom bar: meta chips (left) + gap-after editor (right) in one flex line.
       gap-inline shrinks but won't wrap below the chips unless the card is very narrow. */
    .beat-row-3-bar { gap: 0.5rem; }
    .beat-row-3-bar .beat-meta-chips { margin-top: 0; flex: 1 1 auto; min-width: 0; }
    .beat-row-3-bar .beat-gap-inline { flex: 0 0 auto; }

    /* Inline checkbox replaces the absolute-positioned one. Slightly larger
       hit target so it's easy to click on mobile. */
    .beat-select-box-inline { width: 1rem; height: 1rem; accent-color: #ffc107; cursor: pointer; flex-shrink: 0; }

    /* Format toolbar: tight grouped pill of icon buttons. Disabled state
       dims to ~40% so the writer sees them but doesn't try clicking when
       there's no textarea active. */
    .beat-format-toolbar { display: inline-flex; gap: 0.15rem; margin-left: 0.5rem; padding: 0.1rem 0.25rem; background: rgba(255,255,255,0.02); border: 1px solid #2a2a2a; border-radius: 4px; }
    .beat-format-toolbar .btn { padding: 0.1rem 0.4rem; line-height: 1; font-size: 0.85rem; }
    .beat-format-toolbar .btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .beat-char-count { font-variant-numeric: tabular-nums; }

    /* Tone-tag emoji rendered in the read view. The title attribute holds
       the original bracketed form so a hover reveals the source token. */
    .tone-tag { display: inline-block; padding: 0 0.1em; cursor: help; }
    .tone-tag:hover { filter: brightness(1.15); }

    .beat-card:hover { border-color: #0dcaf0; box-shadow: 0 0 0 1px rgba(13,202,240,0.25); }
    .beat-card.editing { border-color: #0dcaf0; box-shadow: 0 0 0 1px rgba(13,202,240,0.35); }
    .beat-card.selected { border-color: #ffc107; box-shadow: 0 0 0 1px rgba(255,193,7,0.35); }
    .beat-card.resume-here { border-color: #20c997; box-shadow: 0 0 0 1px rgba(32,201,151,0.55), 0 0 22px rgba(32,201,151,0.20); }
    .beat-card.beat-dragging { opacity: 0.5; }
    .beat-card.beat-drop-target { outline: 2px dashed #0dcaf0; outline-offset: 2px; }
    /* Cross-node drop: highlighted in red so the user sees the drop
       attempt was recognised but rejected (a chapter beat can't be dropped
       on a sibling chapter's beat — reorder is single-node only). */
    .beat-card.beat-drop-blocked { outline: 2px dashed #dc3545; outline-offset: 2px; cursor: not-allowed; }

    /* Drag handle in the row-1 cluster. Only the handle itself initiates
       a drag — clicking elsewhere in the card still works as before. */
    .beat-drag-handle { cursor: grab; color: #6c757d; padding: 0 0.2rem; user-select: none; }
    .beat-drag-handle:hover { color: #0dcaf0; }
    .beat-drag-handle:active { cursor: grabbing; }
    .resume-banner { background: rgba(32,201,151,0.08); border: 1px solid rgba(32,201,151,0.35); border-radius: 6px; padding: 0.4rem 0.65rem; color: #c8f0e0; font-size: 0.85rem; display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; }
    .resume-banner .btn { padding: 0.1rem 0.5rem; font-size: 0.75rem; }

    /* Upper-right hover action buttons. Dim at rest (40% opacity) so they don't
       compete with the prose; full opacity when hovering the card, focused
       within it, or when the card is selected/editing. All icon-only with
       Bootstrap btn-outline-* coloring; the .copied state turns the copy-text
       button green via the .btn-outline-secondary.copied override below. */
    .beat-actions { opacity: 0.4; transition: opacity 0.15s ease; }
    .beat-card:hover .beat-actions,
    .beat-card:focus-within .beat-actions,
    .beat-card.selected .beat-actions,
    .beat-card.editing .beat-actions { opacity: 1; }
    .beat-actions .btn { padding: 0.15rem 0.45rem; line-height: 1; }
    /* Thin divider grouping Save/Revert (left) apart from copy/LLM/mic/delete. */
    .beat-action-sep { width: 1px; align-self: stretch; margin: 0.1rem 0.15rem; background: #2a2a2a; }
    /* Copy-guid icon buttons (next to Beat # and the node title). Muted until hover. */
    .beat-guid-copy, .node-guid-copy { color: #6c757d; border: none; background: none; line-height: 1; }
    .beat-guid-copy:hover, .node-guid-copy:hover { color: #0dcaf0; }
    .btn-outline-secondary.copied { color: #75b798; border-color: #198754; background: rgba(25,135,84,0.15); }
    .beat-id-chip { color: #0dcaf0; font-variant-numeric: tabular-nums; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.02em; }

    /* Chapter divider: rendered above any beat with IsChapterStart=true.
       Reads the heading from BeatTitle. Visually announces "new division
       of the prose" without nesting. */
    .beat-chapter-divider { display: flex; align-items: center; gap: 0.75rem; margin: 1.5rem 0 0.6rem; }
    .beat-chapter-line { flex: 1; height: 1px; background: linear-gradient(to right, transparent, #d9a030, transparent); }
    .beat-chapter-label { color: #d9a030; font-family: 'Outfit', sans-serif; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.12em; white-space: nowrap; }

    /* Beat-kind renderings — visual variants of .beat-prose driven by
       Beat.Kind. All still click to edit. */
    .beat-prose-book-title { text-align: center; padding: 1.5rem 0; }
    .beat-prose-book-title .book-title-line { font-family: 'Outfit', sans-serif; font-size: 1.6rem; font-weight: 700; letter-spacing: 0.04em; color: #f8f9fa; }
    .beat-prose-book-title .book-title-byline { font-size: 0.9rem; color: #adb5bd; margin-top: 0.4rem; font-style: italic; }
    .beat-prose-dedication { text-align: center; font-style: italic; color: #ced4da; padding: 0.6rem 1.5rem; }
    .beat-prose-quote { border-left: 3px solid #d9a030; padding: 0.5rem 1rem; margin: 0; background: rgba(217,160,48,0.04); }
    .beat-prose-quote .quote-text { font-style: italic; color: #e6edf3; }
    .beat-prose-quote .quote-attribution { font-size: 0.78rem; color: #adb5bd; margin-top: 0.4rem; text-align: right; }

    /* Chapter index — jump-links to every IsChapterStart beat at the top
       of the node. Replaces the old child-node sidebar. */
    .chapter-index { border: 1px solid #2a2a2a; border-radius: 6px; padding: 0.6rem 0.9rem; margin-bottom: 1rem; background: #0f0f0f; }
    .chapter-index-head { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #8b949e; margin-bottom: 0.4rem; }
    .chapter-index-list { display: flex; flex-direction: column; gap: 0.15rem; }
    .chapter-index-link { color: #79d2e8; text-decoration: none; font-size: 0.9rem; padding: 0.15rem 0; }
    .chapter-index-link:hover { color: #f8f9fa; text-decoration: underline; }
    .chapter-index-link .ci-pos { color: #6c757d; font-variant-numeric: tabular-nums; margin-right: 0.5rem; font-size: 0.8rem; }

    /* Children nav — shown on collection nodes (those with direct children).
       Each child node is a row: kind badge · title · score/status · arrow.
       Clicking navigates to /node/{child.Slug} to edit that node alone. */
    .node-toc { border: 1px solid #2a2a2a; border-radius: 6px; background: #0f0f0f; margin-bottom: 1.5rem; }
    .node-toc-head { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: #8b949e; padding: 0.45rem 0.9rem 0.3rem; border-bottom: 1px solid #1a1a1a; }
    .node-toc-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.4rem 0.9rem; text-decoration: none; color: #adb5bd; border-bottom: 1px solid #1a1a1a; transition: color 0.1s ease; font-size: 0.9rem; }
    .node-toc-item:last-child { border-bottom: none; }
    .node-toc-item:hover { color: #0dcaf0; }
    .node-toc-num { color: #495057; font-size: 0.8rem; min-width: 1.5rem; }
    .chapter-heading { font-size: 1rem; font-weight: 600; color: #8b949e; text-transform: uppercase; letter-spacing: 0.08em; padding: 0.5rem 0 0.4rem; border-top: 1px solid #2a2a2a; margin-top: 1.5rem; margin-bottom: 0.75rem; }
    .scn-kind { font-size: 0.6rem; flex-shrink: 0; }
    .scn-title { font-size: 0.92rem; font-weight: 500; flex-grow: 1; }
    .scn-status { font-size: 0.6rem; flex-shrink: 0; }
    .scn-arrow { color: #495057; font-size: 1.1rem; flex-shrink: 0; }
    .scn-description { font-size: 0.78rem; color: #8b949e; margin-left: 0.2rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 40ch; }
    .beat-gap-inline { display: inline-flex; gap: 0.4rem; align-items: center; font-size: 0.72rem; color: #adb5bd; }
    .beat-gap-inline.custom { color: #ffc107; }
    .beat-gap-input { width: 70px; background: #161616; color: #f8f9fa; border: 1px solid #2a2a2a; padding: 0 0.3rem; font-size: 0.72rem; border-radius: 3px; }
    .beat-gap-input:focus { outline: none; border-color: #0dcaf0; }
    .beat-gap-inline.custom .beat-gap-input { border-color: rgba(255,193,7,0.5); }

    .selection-bar { position: sticky; bottom: 1rem; z-index: 6; background: rgba(15,15,15,0.95); backdrop-filter: blur(6px); border: 1px solid #ffc107; border-radius: 8px; padding: 0.6rem 0.9rem; display: flex; align-items: center; gap: 0.75rem; margin-top: 1rem; box-shadow: 0 -4px 18px rgba(0,0,0,0.35); }
    .selection-bar .count { color: #ffc107; font-weight: 600; font-size: 0.95rem; }
    .selection-bar .hint { color: #6c757d; font-size: 0.75rem; }
    .beat-card.playing { border-color: #20c997; box-shadow: 0 0 0 1px rgba(32,201,151,0.4), 0 0 18px rgba(32,201,151,0.25); }
    .beat-card.stale { border-left: 3px solid #dc3545; }
    .beat-card.recorded { border-left: 3px solid #198754; }

    /* Live Broadcast cursor: the beat currently on air. Pulsing cyan rail so
       the eye can track the cursor and edit the beats just past it. */
    .beat-card.broadcasting-now {
        border-color: #0dcaf0;
        box-shadow: 0 0 0 1px rgba(13,202,240,0.55), 0 0 26px rgba(13,202,240,0.28);
        animation: broadcast-pulse 1.6s ease-in-out infinite;
    }
    @@keyframes broadcast-pulse {
        0%, 100% { box-shadow: 0 0 0 1px rgba(13,202,240,0.55), 0 0 12px rgba(13,202,240,0.18); }
        50%      { box-shadow: 0 0 0 1px rgba(13,202,240,0.75), 0 0 30px rgba(13,202,240,0.35); }
    }

    /* Publish ring-loader overlay: full-viewport scrim with a clockwise-filling
       cyan ring and the percentage in the middle (capped at 99% while working). */
    .publish-overlay {
        position: fixed; inset: 0; z-index: 1080;
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem;
        background: rgba(0,0,0,0.72); backdrop-filter: blur(3px);
    }
    .publish-ring-wrap { position: relative; width: 180px; height: 180px; }
    /* rotate -90deg so the bar starts at 12 o'clock and fills clockwise */
    .publish-ring { width: 180px; height: 180px; transform: rotate(-90deg); }
    .publish-ring-track { fill: none; stroke: rgba(255,255,255,0.12); stroke-width: 8; }
    .publish-ring-bar {
        fill: none; stroke: #0dcaf0; stroke-width: 8; stroke-linecap: round;
        transition: stroke-dashoffset 0.2s linear;
        filter: drop-shadow(0 0 6px rgba(13,202,240,0.5));
    }
    .publish-ring-center {
        position: absolute; inset: 0;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        color: #fff;
    }
    .publish-pct { font-size: 2.4rem; font-weight: 700; line-height: 1; }
    .publish-pct span { font-size: 1.1rem; opacity: 0.7; margin-left: 2px; }
    .publish-stage { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; opacity: 0.7; margin-top: 0.3rem; }
    .publish-detail { color: #cdd6dd; font-size: 0.9rem; text-align: center; }
    .publish-detail .publish-count { color: #6ee7b7; margin-left: 0.5rem; font-variant-numeric: tabular-nums; }

    /* Read / edit must share the exact same box: same font, line-height,
       padding, border, background. Clicking into edit only swaps the
       displayed content (formatted prose ↔ raw text with tags); the
       container itself doesn't move. */
    .beat-prose,
    .beat-textarea {
        display: block;
        width: 100%;
        margin: 0;
        padding: 0;
        border: none;
        background: transparent;
        color: #e9ecef;
        font-family: inherit;
        font-size: 1rem;
        line-height: 1.55;
        white-space: pre-wrap;
        min-height: 1.55rem;
        cursor: text;
    }
    .beat-prose:hover { color: #f8f9fa; }
    .beat-prose-empty { color: #495057; font-style: italic; }
    .beat-textarea {
        resize: none;            /* no drag handle — sizes by row count */
        outline: none;
        overflow: hidden;        /* row count drives height, no scrollbars */
        box-shadow: none;
    }
    /* Focus indicator: the parent .beat-card.editing already turns its
       border cyan, so a textarea-specific focus rule is redundant and
       would risk shifting the box. Just kill the user-agent outline. */
    .beat-textarea:focus { outline: none; }
    /* Edit textarea sizes to content via JS interop (autoSizeTextarea).
       Min-height matches the prose container so very short beats don't
       collapse below readable size. */
    .beat-textarea { min-height: 1.55rem; }
    /* Read view: renders entity-linked prose instead of raw textarea when beat is not dirty. */
    .beat-read-wrapper { min-height: 1.55rem; cursor: text; padding: 0.15rem 0; }
    .beat-read-wrapper:hover { background: rgba(255,255,255,0.03); border-radius: 3px; }
    .beat-prose-render p { margin: 0 0 0.65em; line-height: 1.65; }
    .beat-prose-render p:last-child { margin-bottom: 0; }
    /* Save/Cancel render INLINE in the same .beat-actions row that holds
       the read-mode copy/llm/mic/delete buttons — conditional swap, so
       they can never overlap. The absolute-positioned .beat-edit-actions
       overlay is gone. */
    /* Gutter insert: faintly visible at rest so the affordance is
       discoverable, full strength when the pointer enters the gutter. */
    .insert-bar { display: flex; align-items: center; gap: 0.5rem; opacity: 0.22; transition: opacity 0.15s ease; padding: 0.25rem 0; margin-bottom: 0.5rem; }
    .insert-bar:hover, .insert-bar:focus-within { opacity: 1; }
    .insert-bar-line { flex-grow: 1; height: 1px; background: #2a2a2a; }
    .beat-meta-chips { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-top: 0.35rem; font-size: 0.7rem; }
    .beat-meta-chip { padding: 0.1rem 0.45rem; border-radius: 10px; background: rgba(13,202,240,0.08); color: #79d2e8; cursor: pointer; }
    .beat-meta-chip.unset { color: #495057; background: transparent; border: 1px dashed #2a2a2a; }
    .beat-meta-chip:hover { background: rgba(13,202,240,0.15); }
    .beat-meta-panel { margin-top: 0.6rem; padding: 0.6rem; background: #0d0d0d; border: 1px solid #2a2a2a; border-radius: 6px; }
    .beat-meta-panel label { color: #adb5bd; font-size: 0.75rem; margin-bottom: 0.15rem; }
    .beat-meta-panel select, .beat-meta-panel input { background: #0a0a0a; border: 1px solid #2a2a2a; color: #f8f9fa; font-size: 0.85rem; }
    .insert-bar-btn { background: transparent; border: 1px dashed #3a3a3a; color: #0dcaf0; font-size: 0.75rem; padding: 0.15rem 0.55rem; border-radius: 12px; cursor: pointer; }
    .insert-bar-btn:hover { background: rgba(13,202,240,0.08); border-color: #0dcaf0; }
    .beat-audio { width: 100%; height: 28px; margin-top: 0.5rem; filter: brightness(0.85); }
    .node-meta-chip { font-size: 0.7rem; padding: 0.2rem 0.5rem; }
    /* Per-beat version cycler — two arrows that scrub the editor back and
       forth through the beat's system-versioned history. When a past (non-
       current) version is showing, the cluster glows so it's clear the editor
       is previewing history, not the live text. */
    .beat-history-nav.cycling .btn { border-color: #0dcaf0; color: #0dcaf0; }
    .beat-history-nav .beat-version-ts { font-size: 0.7rem; color: #6c757d; white-space: nowrap; padding: 0 0.3rem; }
    .beat-history-nav.cycling .beat-version-ts { color: #0dcaf0; }

    /* Soft-deleted (disabled) beat: dimmed border, reduced opacity on the body,
       a strikethrough badge. The card is still interactive (history cycler, restore). */
    .beat-card.beat-disabled { border-color: #3a3a3a; opacity: 0.55; }
    .beat-card.beat-disabled:hover { border-color: #555; box-shadow: none; opacity: 0.75; }
    .beat-disabled-badge { font-size: 0.65rem; color: #dc3545; border: 1px solid #dc354560; border-radius: 3px; padding: 0.05rem 0.3rem; }
</style>

@if (loading)
{
    <div class="container py-4 text-muted">
        <div class="spinner-border spinner-border-sm me-2"></div>Loading node…
    </div>
}
else if (node == null)
{
    <div class="container py-4">
        <div class="alert alert-warning">No node found for <code>@IdOrSlug</code>. <a href="/nodes">Back to index</a>.</div>
    </div>
}
else
{
    <div class="container node-shell py-3">
        <div class="node-head">
            <div class="d-flex align-items-start gap-3">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                        <span class="badge bg-secondary node-meta-chip text-uppercase">@node.Kind</span>
                        <span class="badge bg-@StatusColor(node.Status) node-meta-chip text-uppercase">@StatusLabel(node.Status)</span>
                    </div>
                    <input class="node-title w-100" placeholder="Untitled node"
                           @bind="node.Title" @bind:event="oninput" @onblur="SaveNodeHeaderAsync" />
                    <textarea class="node-description mt-1" rows="5" placeholder="Description (optional)"
                              style="width:100%; resize:none; overflow-y:auto;"
                              @bind="node.Description" @bind:event="oninput" @onblur="SaveNodeHeaderAsync"></textarea>

                </div>
            </div>

            <div class="d-flex gap-2 flex-wrap mt-2 align-items-center">
                <button class="btn btn-sm btn-outline-success" @onclick="ExportAllAsync"
                        disabled="@(publishing || exportBusy)">
                    @if (publishing || exportBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    else { <i class="bi bi-download me-1"></i> }
                    Export
                </button>
            </div>

        </div>

        @* Table of Contents — anchor links to each chapter section below. *@
        @if (children.Count > 0)
        {
            <div class="node-toc">
                <div class="node-toc-head">Table of Contents</div>
                @for (var ci = 0; ci < children.Count; ci++)
                {
                    var child = children[ci];
                    var chTitle = string.IsNullOrWhiteSpace(child.Title) ? $"Chapter {ci + 1}" : child.Title;
                    <a href="#chapter-@child.Id.ToString("N")" class="node-toc-item">
                        <span class="node-toc-num">@(ci + 1).</span>
                        <span>@chTitle</span>
                    </a>
                }
            </div>
        }


        @if (beats.Count == 0)
        {
            <div class="card bg-dark border-secondary text-center py-5 text-muted">
                <div class="mb-3">
                    <i class="bi bi-stars" style="font-size: 2rem; opacity: 0.4;"></i>
                </div>
                <div class="mb-1">An empty node. The first beat starts the story.</div>
                <div class="mt-3">
                    <button class="btn btn-outline-info" @onclick="() => InsertBeatAsync(null)" disabled="@working" data-cy="insert-first">
                        <i class="bi bi-plus-circle me-1"></i>Add the first beat
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column" id="node-beats-root">
                <div class="insert-bar">
                    <div class="insert-bar-line"></div>
                    <button class="insert-bar-btn" @onclick="() => InsertBeatAsync(null)" disabled="@working" data-cy="insert-top">
                        <i class="bi bi-plus-circle me-1"></i>insert at top
                    </button>
                    <div class="insert-bar-line"></div>
                </div>

                @{ int position = 0; Guid lastChapterId = Guid.Empty; }
                @foreach (var entry in beats)
                {
                    position++;
                    var b = entry.Beat;
                    @* Chapter section header — injected whenever the NodeId changes (only relevant
                       for story nodes whose beats come from multiple chapter children). *@
                    @if (children.Count > 0 && entry.NodeId != lastChapterId)
                    {
                        lastChapterId = entry.NodeId;
                        var chapterNode = children.FirstOrDefault(c => c.Id == entry.NodeId);
                        var chapterIndex = children.IndexOf(chapterNode!);
                        var chapterLabel = chapterNode == null ? "" :
                            string.IsNullOrWhiteSpace(chapterNode.Title) ? $"Chapter {chapterIndex + 1}" : chapterNode.Title;
                        if (chapterNode != null)
                        {
                            <h5 class="chapter-heading" id="chapter-@entry.NodeId.ToString("N")">@chapterLabel</h5>
                        }
                    }
                    var bid = b.Id;
                    // Every beat is always an editable textarea (no read-only
                    // rendered view). "editing" here means the draft has
                    // unsaved changes — it lights the card border + keeps the
                    // action buttons visible until the user saves or reverts.
                    var isDirty = IsDirty(b);
                    var rowClass = "beat-card mb-1";
                    if (!entry.IsEnabled) rowClass += " beat-disabled";
                    if (isDirty) rowClass += " editing";
                    if (resumeBeatId == bid) rowClass += " resume-here";
                    var rowPosition = position;
                    <div class="@rowClass" id="@($"beat-{bid:N}")" data-cy="beat-row" data-beat-id="@bid" data-node-id="@entry.NodeId">
                        <div class="beat-row-1 d-flex align-items-center gap-2 mb-2">
                            <span class="beat-id-chip" data-cy="beat-id" title="@($"Position {rowPosition} in node — Beat guid {bid}")">#@rowPosition.ToString("D3")</span>
                            <div class="beat-actions d-flex align-items-center gap-1 ms-auto">
                                <button class="btn btn-sm btn-success"
                                        @onclick="() => SaveBeatEditAsync(bid)"
                                        @onclick:stopPropagation
                                        disabled="@(savingBeatId == bid || !isDirty)"
                                        title="Save (⌘/Ctrl+Enter)"
                                        data-cy="beat-save">
                                    @if (savingBeatId == bid) { <span class="spinner-border spinner-border-sm"></span> }
                                    else { <i class="bi bi-check-lg"></i> }
                                </button>
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => RevertDraft(b)"
                                        @onclick:stopPropagation
                                        disabled="@(!isDirty)"
                                        title="Revert unsaved changes (Esc)"
                                        data-cy="beat-cancel">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger"
                                        title="Delete this beat"
                                        @onclick="async () => { RequestDeleteAsync(bid); await ConfirmDeleteAsync(); }"
                                        @onclick:stopPropagation
                                        disabled="@working"
                                        data-cy="beat-delete">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>

                        @* ── Row 2: the beat body.
                           When the beat has saved text and no pending draft (not dirty),
                           render a read-only prose view via BeatReadView (XrefText with NER).
                           Clicking the read view or starting a fresh beat opens the textarea.
                           @bind:get/@bind:set route through the per-beat draft dictionary so
                           each beat is independently editable; Save commits, Revert restores.
                           No rows attribute — JS autoSizeTextarea sizes height to content. ── *@
                        <div class="beat-row-2">
                            @if (IsDirty(b) || string.IsNullOrEmpty(b.Text) || activeBeatEditId == bid)
                            {
                                <textarea class="beat-textarea" id="@($"beat-{bid:N}-edit")"
                                          placeholder="(empty beat — write here)"
                                          @bind:get="DraftFor(b)"
                                          @bind:set="@(v => OnDraftSet(bid, v))"
                                          @bind:event="oninput"
                                          @onkeyup="@(() => AutoSizeTextareaAsync(bid))"
                                          @onkeydown="@(e => OnEditorKeydown(e, b))"
                                          @onblur="@(() => { if (!IsDirty(b)) activeBeatEditId = Guid.Empty; })"></textarea>
                            }
                            else
                            {
                                <div class="beat-read-wrapper" @onclick="@(() => StartReadViewEdit(bid))">
                                    <BeatReadView Text="@(b.Text ?? "")" />
                                </div>
                            }
                        </div>

                    </div>

                    <div class="insert-bar">
                        <div class="insert-bar-line"></div>
                        <button class="insert-bar-btn" @onclick="() => InsertBeatAsync(bid)" disabled="@working" data-cy="insert-after">
                            <i class="bi bi-plus-circle me-1"></i>insert beat
                        </button>
                        <div class="insert-bar-line"></div>
                    </div>
                } @* end foreach *@

            </div>
        }
    </div>
}


@code {
    [Parameter] public string IdOrSlug { get; set; } = "";

    private NodeEntity? node;

    // ── Reviews modal (shared sortable component; node = full reviews, beat = micro) ──
    private bool reviewsOpen;
    private string reviewModalTitle = "";
    private double reviewModalMax = 100;
    private string reviewModalSuffix = "/100";
    private List<ReviewsModal.Item> reviewModalItems = new();

    // Traffic-light thresholds per SS-US-J4: ≥80 green, 70–79 yellow, <70 red.
    private static string ScorePctColor(double pct) => pct >= 80 ? "success" : pct >= 70 ? "warning" : "danger";

    private async Task OpenNodeReviewsAsync()
    {
        if (node == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var all = await db.NodeReviews
            .Where(r => r.NodeId == node.Id)
            .Include(r => r.BeatScores)
            .ToListAsync();
        reviewModalTitle = $"Reader reviews — {node.Title}";
        reviewModalMax = 100; reviewModalSuffix = "/100";
        if (all.Count == 0) { reviewModalItems = new(); reviewsOpen = true; return; }

        // Rows = the personas in the latest run's Group panels; each expands to that
        // persona's FULL history (every run, newest first) with body + per-beat micros.
        var latestHash = all.OrderByDescending(r => r.ReviewedAt).Select(r => r.ContentHash).First();
        var latestPersonas = all
            .Where(r => r.ContentHash == latestHash && r.FocusGroupName != null && r.FocusGroupName.StartsWith("Group"))
            .Select(r => r.PersonaId).ToHashSet();
        reviewModalItems = all
            .Where(r => latestPersonas.Contains(r.PersonaId))
            .GroupBy(r => r.PersonaId)
            .Select(g =>
            {
                var ordered = g.OrderByDescending(r => r.ReviewedAt).ToList();
                var latest = ordered[0];
                var history = ordered.Select(r => new ReviewsModal.HistoryEntry(
                    r.ReviewedAt.ToLocalTime().ToString("MM-dd HH:mm"),
                    r.ContentHash.Length >= 6 ? r.ContentHash[..6] : r.ContentHash,
                    r.Score,
                    string.IsNullOrWhiteSpace(r.Improvements) ? r.ReviewText : r.ReviewText + "\n\nFixes:\n" + r.Improvements,
                    r.BeatScores.Count > 0 ? r.BeatScores.OrderBy(b => b.BeatNumber).Select(b => b.Score).ToList() : null))
                    .ToList();
                return new ReviewsModal.Item(latest.PersonaName, latest.ProviderId, latest.Score,
                    PersonaLibrary.GetProfile(g.Key)?.Summary(), history);
            })
            .ToList();
        reviewsOpen = true;
    }

    private async Task OpenBeatReviewsAsync(int positional, BeatEntity b)
    {
        if (node == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var all = await db.NodeReviews
            .Where(r => r.NodeId == node.Id && r.BeatScores.Any(bs => bs.BeatNumber == positional))
            .Include(r => r.BeatScores)
            .ToListAsync();
        reviewModalItems = all
            .GroupBy(r => r.PersonaId)
            .Select(g =>
            {
                var ordered = g.OrderByDescending(r => r.ReviewedAt).ToList();
                var latest = ordered[0];
                static double Micro(NodeReview r, int pos) =>
                    r.BeatScores.Where(bs => bs.BeatNumber == pos).Select(bs => (double)bs.Score).FirstOrDefault();
                var history = ordered.Select(r => new ReviewsModal.HistoryEntry(
                    r.ReviewedAt.ToLocalTime().ToString("MM-dd HH:mm"),
                    r.ContentHash.Length >= 6 ? r.ContentHash[..6] : r.ContentHash,
                    Micro(r, positional),
                    ExtractBeatNote(r.Improvements, positional),
                    null)).ToList();
                return new ReviewsModal.Item(latest.PersonaName, latest.ProviderId, Micro(latest, positional),
                    PersonaLibrary.GetProfile(g.Key)?.Summary(), history);
            })
            .ToList();
        var title = string.IsNullOrEmpty(b.Title) ? $"Beat #{positional}" : $"Beat #{positional} — {b.Title}";
        reviewModalTitle = $"{title} · micro-reviews";
        reviewModalMax = 5; reviewModalSuffix = "/5";
        reviewsOpen = true;
    }

    private static string ExtractBeatNote(string? improvements, int positional)
    {
        if (string.IsNullOrWhiteSpace(improvements)) return "";
        var hits = improvements
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(l => l.Contains($"Beat {positional}", StringComparison.OrdinalIgnoreCase));
        return string.Join("\n", hits);
    }
    /// <summary>UpdatedAt of the node row at the moment LoadAsync ran.
    /// Passed back into SaveNodeHeaderAsync as an optimistic-concurrency
    /// check — if the row moved underneath us (another tab, an MCP tool),
    /// the save aborts with a toast instead of silently clobbering the
    /// other write.</summary>
    private DateTime? nodeLoadedUpdatedAt;
    private List<NodeWorkbenchService.OrderedBeat> beats = new();
    /// <summary>Ancestors of the current node, root first. Empty if this is
    /// a top-level node. Used for the breadcrumb at the page header.</summary>
    private List<NodeEntity> ancestors = new();
    /// <summary>Direct children of the current node. A book node shows
    /// its chapter children here so the user can navigate down without
    /// going back to /nodes.</summary>
    private List<NodeEntity> children = new();
    private bool loading = true;
    private bool working;
    private bool showBible;
    private bool bibleGenerating;
    /// <summary>The beat whose Save is mid-flight (drives the spinner on that
    /// one row's check button). Null when nothing is saving.</summary>
    private Guid? savingBeatId;

    // ── Per-beat draft model ─────────────────────────────────────────────
    // Every beat is always an editable textarea (no read-only view), so each
    // needs its own live draft + concurrency token rather than the old single
    // editingBeatId/editingText pair. drafts[id] is the current textarea text;
    // draftBase[id] is the Beat.UpdatedAt captured when the draft was seeded,
    // passed back on save so the workbench can detect "another tab/MCP-tool
    // wrote in between" and surface a conflict instead of clobbering.
    private readonly Dictionary<Guid, string> drafts = new();
    private readonly Dictionary<Guid, DateTime> draftBase = new();

    // ── Per-beat version cycler (system-versioned temporal history) ───────
    // historyCounts: how many stored versions (current + history) each beat
    // has, from the Beats_History temporal table — drives the arrows' disabled
    // state. Refreshed from the DB after each genuine (re)load. historyCursor:
    // which version the editor is previewing — 0 = current/most-recent edit,
    // higher = further back in history. Capture is automatic (every UPDATE is
    // versioned by SQL Server), so there's nothing to push from the client.
    private readonly Dictionary<Guid, int>      historyCounts     = new();
    private readonly Dictionary<Guid, int>      historyCursor     = new();
    private readonly Dictionary<Guid, DateTime> historyTimestamps = new();
    private bool showDisabledBeats;

    /// <summary>Return this beat's live draft text, seeding it from the
    /// canonical Beat.Text on first access. Called from the textarea's
    /// @bind:get on every render — must be cheap and side-effect-light.</summary>
    private string DraftFor(BeatEntity b)
    {
        if (!drafts.TryGetValue(b.Id, out var t))
        {
            t = b.Text ?? "";
            drafts[b.Id] = t;
            draftBase[b.Id] = b.UpdatedAt;
        }
        return t;
    }

    /// <summary>@bind:set target — record what the user typed.</summary>
    private void OnDraftSet(Guid beatId, string value) => drafts[beatId] = value ?? "";

    /// <summary>True when the draft differs from the saved beat text.</summary>
    private bool IsDirty(BeatEntity b)
        => drafts.TryGetValue(b.Id, out var t) && t != (b.Text ?? "");

    /// <summary>Discard a beat's unsaved edits back to the saved text.</summary>
    private void RevertDraft(BeatEntity b)
    {
        drafts[b.Id] = b.Text ?? "";
        draftBase[b.Id] = b.UpdatedAt;
        autoSizePendingBeatId = b.Id;
    }

    /// <summary>Reconcile drafts against a freshly reloaded beat list. Clean
    /// (or absent) drafts are reseeded to the new text + token so re-records
    /// and external edits to untouched beats don't leave a stale concurrency
    /// token or a false "dirty" flag. Drafts the user has actually changed are
    /// preserved verbatim. Drafts for deleted beats are dropped.</summary>
    private void SyncDraftsAfterReload()
    {
        var live = new HashSet<Guid>();
        foreach (var ob in beats)
        {
            var id = ob.Beat.Id;
            var txt = ob.Beat.Text ?? "";
            live.Add(id);
            if (!drafts.TryGetValue(id, out var d) || d == txt)
            {
                drafts[id] = txt;
                draftBase[id] = ob.Beat.UpdatedAt;
            }
            // else: unsaved user edit — keep the draft and its original token.
        }
        foreach (var stale in drafts.Keys.Where(k => !live.Contains(k)).ToList())
        {
            drafts.Remove(stale);
            draftBase.Remove(stale);
            historyCounts.Remove(stale);
            historyCursor.Remove(stale);
        }
        sizeAllPending = true;
    }

    /// <summary>Set after any (re)load of the beat list so OnAfterRenderAsync
    /// runs one pass of autosize across every textarea — each beat now renders
