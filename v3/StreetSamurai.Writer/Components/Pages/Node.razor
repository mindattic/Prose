    // ── Gap-after-beat editor ─────────────────────────────────────────────
    // Each beat owns the silence that follows it (Beat.GapAfterMs). Null =
    // use the computed default; a value (incl. 0) is an explicit override.

    /// <summary>Auto-computed ms the server-side engine would use as the gap
    /// after <paramref name="above"/>, before <paramref name="below"/>.</summary>
    private int ComputeAutoGapMs(BeatEntity above, BeatEntity? below)
        => NodeWorkbenchService.ComputeTrailingSilenceMs(above, below, Settings);

    private void OnGapEditorKeydown(KeyboardEventArgs e, Guid beatId, string editorId)
    {
        if (e.Key == "Enter") { _ = SaveGapAfterFromInputAsync(beatId, editorId); }
    }

    private async Task SaveGapAfterFromInputAsync(Guid beatId, string editorId)
    {
        try
        {
            var raw = await JS.InvokeAsync<string>("streetsamurai.readInput", editorId);
            if (!int.TryParse(raw, out var ms)) return;
            ms = Math.Clamp(ms, 0, 6000);
            await Workbench.SetGapAfterAsync(beatId, ms);
            // Reflect in the in-memory list so the chip updates without a full reload.
            var entry = beats.FirstOrDefault(x => x.Beat.Id == beatId);
            if (entry != null) entry.Beat.GapAfterMs = ms;
            Toast.Success("GAP", $"Gap after this beat → {ms} ms.");
            StateHasChanged();
        }
        catch (Exception ex) { Toast.Error("GAP-FAIL", ex.Message); }
    }

