    private List<WebSpeechVoice> webSpeechVoices = new();
    private string? webSpeechVoice;
    private double webSpeechRate = 1.0;
    private bool webSpeaking;

    public class WebSpeechVoice { public string Name { get; set; } = ""; public string Lang { get; set; } = ""; }

    private string StudioPreviewUrl =>
        voices.FirstOrDefault(v => v.VoiceId == editorProfile.VoiceId)?.PreviewUrl ?? "";
    private string StudioVoiceDescription =>
        voices.FirstOrDefault(v => v.VoiceId == editorProfile.VoiceId)?.Description ?? "";

    private void OnStudioVoiceChanged() => studioAudioUrl = null;

    /// <summary>Copy the node's pinned voice snapshot into the editor so the
    /// studio opens showing what the node currently uses. Also seeds the
    /// TTS engine selector and local-engine dials.</summary>
    private void SeedVoiceEditorFromNode()
    {
        if (node == null) return;

        // Seed engine selector
        selectedEngine = string.IsNullOrEmpty(node.TtsEngine) ? "elevenlabs" : node.TtsEngine;

        if (selectedEngine != "elevenlabs")
        {
            // Local engine — seed the local dials from the re-used Voice* columns
            localVoiceId    = node.VoiceId ?? "";
            localSpeed      = node.VoiceStyle      ?? 1.0;   // kokoro speed / piper noise_scale
            localLengthScale = node.VoiceStability ?? 1.0;   // piper length_scale
        }

        // ElevenLabs profile (always kept in sync for when user switches back)
        editorProfile = new StreetSamurai.Core.Models.VoiceProfile
        {
            Id              = "",
            Label           = "",
            VoiceId         = string.IsNullOrEmpty(node.VoiceId) ? defaultVoiceId : node.VoiceId,
            Model           = string.IsNullOrEmpty(node.VoiceModel) ? (Settings.TtsModel ?? "eleven_multilingual_v2") : node.VoiceModel,
            Stability       = node.VoiceStability  ?? Settings.TtsStability,
            SimilarityBoost = node.VoiceSimilarity ?? Settings.TtsSimilarityBoost,
            Style           = node.VoiceStyle      ?? Settings.TtsStyle,
            UseSpeakerBoost = true,
        };
        studioAudioUrl = null;
    }

    private void LoadProfileIntoEditor(string profileId)
    {
        var p = Settings.VoiceProfiles.FirstOrDefault(x => x.Id == profileId);
        if (p == null) return;
        editorProfile = new StreetSamurai.Core.Models.VoiceProfile
        {
            Id = "", Label = "", VoiceId = p.VoiceId, Model = p.Model,
            Stability = p.Stability, SimilarityBoost = p.SimilarityBoost,
            Style = p.Style, UseSpeakerBoost = p.UseSpeakerBoost,
        };
        newProfileLabel = $"{p.Label} (copy)";
        studioAudioUrl = null;
    }

    private void PreviewVoiceAsync()
    {
        if (string.IsNullOrWhiteSpace(StudioPreviewUrl)) { Toast.Error("PREVIEW", "No preview clip available for this voice."); return; }
        studioAudioLabel = "Preview — ElevenLabs static sample clip";
        studioAudioUrl = StudioPreviewUrl;
    }

    private async Task DemoVoiceAsync()
    {
        if (node == null || demoing) return;
        if (string.IsNullOrWhiteSpace(editorProfile.VoiceId)) { Toast.Error("DEMO", "Pick a voice first."); return; }
        demoing = true;
        studioAudioUrl = null;
        StateHasChanged();
        try
        {
            var bytes = await Workbench.AuditionVoiceAsync(node.Id, editorProfile,
                text: NodeWorkbenchService.DemoSampleText);
            studioAudioLabel = "Demo — synthesized with your dials";
            studioAudioUrl = "data:audio/mpeg;base64," + Convert.ToBase64String(bytes);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Demo failed for node {S}", node.Id);
            Toast.Error("DEMO", ex.Message);
        }
        finally { demoing = false; StateHasChanged(); }
    }

    /// <summary>Synthesize a demo passage through the selected local engine
    /// (Kokoro or Piper) and play it in the engine-row audio element.</summary>
    private async Task DemoLocalAsync()
    {
        if (node == null || localDemoing) return;
        localDemoing = true;
        studioAudioUrl = null;
        StateHasChanged();
        try
        {
            var wav = await Workbench.SynthesizeLocalBeatAsync(
                NodeWorkbenchService.DemoSampleText, selectedEngine);
            if (wav == null)
            {
                Toast.Error("LOCAL-DEMO", "ffmpeg not found on PATH — required for local TTS preview.");
                return;
            }
            studioAudioLabel = $"Demo — {selectedEngine} synthesis";
            studioAudioUrl = "data:audio/wav;base64," + Convert.ToBase64String(wav);
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "Local demo failed for node {S} engine {E}", node.Id, selectedEngine);
            var engineHint = selectedEngine == "kokoro"
                ? "Kokoro not installed — see tools/kokoro/README for one-time setup."
                : "Piper not installed — see tools/piper/README for one-time setup.";
