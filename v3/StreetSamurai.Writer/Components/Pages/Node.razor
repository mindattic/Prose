    /// ring — the audiobook is the only export that drives the progress ring.</summary>
    private bool exportBusy;
    private const double PublishRingRadius = 54;
    private double PublishRingCircumference => 2 * Math.PI * PublishRingRadius;
    /// <summary>Capped at 99% on purpose — the ring never shows a full 100%
    /// while work is outstanding; the overlay closes when the export completes.</summary>
    private int PublishPercent => publishTotal > 0 ? Math.Min(99, (int)(100.0 * publishCurrent / publishTotal)) : 0;
    private double PublishRingOffset => PublishRingCircumference * (1 - PublishPercent / 100.0);
    private string PublishRingDash => PublishRingCircumference.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
    private string PublishRingOff  => PublishRingOffset.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    // ── LLM bottom-sheet state ───────────────────────────────────────────
