    private string selectedEngine = "elevenlabs";   // "elevenlabs"|"kokoro"|"piper"|"webspeech"
    private string localVoiceId   = "";             // engine voice id
    private double localSpeed     = 1.0;            // kokoro: speed; piper: noise_scale
    private double localLengthScale = 1.0;          // piper only: length_scale (playback speed)
    private bool   localDemoing;                    // spinner while local demo synthesises

