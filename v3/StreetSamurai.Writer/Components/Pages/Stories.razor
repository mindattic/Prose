@page "/nodes"
@page "/stories"
@page "/strands"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@using Microsoft.EntityFrameworkCore
@using StreetSamurai.Core.Data
@using StreetSamurai.Shared.Services
@using NodeEntity = StreetSamurai.Core.Data.Entities.Node
@inject IDbContextFactory<StreetSamuraiDbContext> DbFactory
@inject NavigationManager Nav
@inject ToastNotifier Toast
@inject IJSRuntime JS
@inject StreetSamurai.Core.Services.IUniverseContext Universe
@inject StreetSamurai.Core.Services.NodeWorkbenchService Workbench
@inject StreetSamurai.Core.Services.DocxExportService Docx
@inject StreetSamurai.Core.Services.ManuscriptExportService Manuscript
@inject StreetSamurai.Core.Services.NodeReviewService ReviewSvc
@inject StreetSamurai.Shared.Services.TabService TabSvc
@*
   Story index over the node tree (SeriesNode / BookNode / ChapterNode).
   Lists every top-level node grouped by kind. Click to open in the
   unified writer/recorder at /node/{id}. The Create CTA below creates a
   blank top-level node and routes you there.
*@

<div class="container py-3" style="max-width: 900px;">
    <h4 class="text-light mb-3"><i class="bi bi-book me-2"></i>Stories</h4>

    @if (loading)
    {
        <div class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading…</div>
    }
    else if (allStories.Count == 0)
    {
        <div class="text-muted">No stories found.</div>
    }
    else
    {
        <ul class="nodes-list">
            @foreach (var s in allStories)
            {
                var beatCount = beatCounts.GetValueOrDefault(s.Id, 0);
                <li class="story-row @(editingId == s.Id ? "story-row--editing" : "")">
                    @if (editingId == s.Id)
                    {
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">Title</label>
                            <input class="form-control form-control-sm bg-black text-light border-secondary"
                                   @bind="editTitle" @bind:event="oninput" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">Description</label>
                            <textarea class="form-control form-control-sm bg-black text-light border-secondary"
                                      rows="3" @bind="editDescription" @bind:event="oninput"></textarea>
                        </div>
                        <div class="mb-2">
                            <label class="form-label small text-muted mb-1">Summary <span class="text-muted" style="font-size:0.75em">(KDP jacket blurb)</span></label>
                            <textarea class="form-control form-control-sm bg-black text-light border-secondary"
                                      rows="5" @bind="editSummary" @bind:event="oninput"></textarea>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-success" @onclick="SaveEditAsync"
                                    disabled="@(savingEdit || string.IsNullOrWhiteSpace(editTitle))">
                                @if (savingEdit) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                <i class="bi bi-check-lg me-1"></i>Save
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit" disabled="@savingEdit">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <div class="story-header">
                            <span class="story-title-link">@s.Title</span>
                            @if (!string.IsNullOrWhiteSpace(s.NodeCode))
                            {
                                <span class="story-code">@s.NodeCode</span>
                            }
                            @if (beatCount > 0) { <span class="story-stat">@beatCount beats</span> }
                            @if (s.Score.HasValue) { <span class="story-stat story-stat--score">@s.Score.Value.ToString("0")%</span> }
                            @{ var pages = pageCounts.GetValueOrDefault(s.Id, 0); }
                            @if (pages > 0) { <span class="story-stat">@pages pg</span> }
                            @{ var dur = audioDurations.GetValueOrDefault(s.Id); }
                            @if (!string.IsNullOrEmpty(dur)) { <span class="story-stat">@dur</span> }
                            <code class="story-guid" title="Click to copy full ID" @onclick="() => CopyGuidAsync(s.Id)">@s.Id.ToString()[..8]…</code>
                            <span class="story-spacer"></span>
                            <button class="story-edit-btn" title="Edit" @onclick="() => BeginEdit(s)">
                                <i class="bi bi-pencil"></i>
                            </button>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(s.Description))
                        {
                            <div class="story-desc">@s.Description</div>
                        }
                        <div class="story-footer">
                            <button class="story-open-btn" @onclick="() => OpenNode(s.Slug, s.NodeCode)">
                                Open <i class="bi bi-arrow-right-short"></i>
                            </button>
                        </div>
                    }
                </li>
            }
        </ul>
    }
</div>


@* ── Score history chart modal ───────────────────────────────────────── *@
<ScoreHistoryModal Visible="scoreHistoryOpen"
                   NodeId="scoreHistoryNodeId"
                   NodeTitle="scoreHistoryTitle"
                   OnClose="() => scoreHistoryOpen = false" />

@* ── Reader-reviews bottom sheet ─────────────────────────────────────── *@
@if (reviewsOpen)
{
    <div class="review-sheet-backdrop" @onclick="CloseReviews"></div>
    <div class="review-sheet" @onclick:stopPropagation>
        <div class="review-sheet-header d-flex justify-content-between align-items-start gap-2">
            <div>
                <strong class="text-light"><i class="bi bi-star-half me-1 text-warning"></i>Reader reviews — @reviewsTitle</strong>
                <div><code class="node-guid">@reviewsNodeId</code></div>
            </div>
            <button class="btn btn-sm btn-outline-secondary" @onclick="CloseReviews"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="review-sheet-body">
            @if (reviewsLoading)
            {
                <div class="text-muted"><span class="spinner-border spinner-border-sm me-2"></span>Loading reviews…</div>
            }
            else if (reviewList.Count == 0)
            {
                <div class="text-muted">
                    No reviews yet for this node. Run
                    <code>ss --review-book --slug @reviewsSlug --readers 128</code> to generate them.
                </div>
            }
            else
            {
                @if (reviewSummary != null)
                {
                    <div class="review-summary mb-3">
                        <div class="d-flex align-items-center gap-3 flex-wrap mb-2">
                            <span class="review-avg">@reviewSummary.AvgScore.ToString("0.0")<span class="review-avg-max">/100</span></span>
                            <span class="text-muted small">@reviewSummary.ReviewCount reviews · generated @reviewSummary.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                            @if (reviewStaleNote)
                            {
                                <span class="badge bg-danger" title="The node's beat count changed since these reviews were written.">story edited since</span>
                            }
                        </div>
                        @foreach (var b in scoreBuckets)
                        {
                            <div class="d-flex align-items-center gap-2 review-bar-row">
                                <span class="review-bar-label">@b.Key</span>
                                <div class="review-bar-track"><div class="review-bar-fill" style="width:@(BarPct(b.Value))%"></div></div>
                                <span class="review-bar-count">@b.Value</span>
                            </div>
                        }
                        <div class="review-summary-md mt-2">@reviewSummary.SummaryMarkdown</div>
                    </div>
                    <hr class="border-secondary" />
                }
                <div class="review-list">
                    @foreach (var r in reviewList)
                    {
                        <div class="review-card">
                            <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                                <div>
                                    <strong class="text-light">@r.PersonaName</strong>
                                    <span class="badge bg-secondary ms-1" title="@r.Model">@r.ProviderId</span>
                                </div>
                                <span class="badge @ScoreBadge(r.Score)">@r.Score/100</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(r.PersonaBlurb))
                            {
                                <div class="text-muted review-blurb">@r.PersonaBlurb</div>
                            }
                            <div class="review-text">@r.ReviewText</div>
                            @if (!string.IsNullOrWhiteSpace(r.Improvements))
                            {
                                <ul class="review-fixes">
                                    @foreach (var fix in r.Improvements.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                    {
                                        <li>@fix</li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

<style>
    .node-code-chip { font-size: 0.65rem; font-weight: 700; color: #0dcaf0; background: rgba(13,202,240,0.1); border: 1px solid rgba(13,202,240,0.3); border-radius: 3px; padding: 1px 5px; letter-spacing: 0.04em; font-family: monospace; flex-shrink: 0; }
    .node-guid { font-size: 0.68rem; color: #6c757d; cursor: pointer; }
    .node-guid:hover { color: #0dcaf0; }
    .node-description-line { font-size: 0.85rem; color: #adb5bd; white-space: pre-wrap; line-height: 1.35; }
    .node-description-empty { font-style: italic; color: #5c636a; }
