    };

    // ── Reviews modal ────────────────────────────────────────────────────
    private bool reviewsOpen;
    private bool reviewsLoading;
    private Guid reviewsNodeId;
    private string reviewsTitle = "";
    private string reviewsSlug = "";
    private bool reviewStaleNote;
    private List<StreetSamurai.Core.Data.Entities.NodeReview> reviewList = new();
    private StreetSamurai.Core.Data.Entities.NodeReviewSummary? reviewSummary;
    private List<KeyValuePair<string, int>> scoreBuckets = new();

    private async Task OpenReviewsAsync(NodeEntity s)
    {
        reviewsOpen = true;
        reviewsLoading = true;
        reviewsNodeId = s.Id;
        reviewsTitle = s.Title;
        reviewsSlug = s.Slug;
        reviewList = new();
        reviewSummary = null;
        scoreBuckets = new();
        reviewStaleNote = false;
        StateHasChanged();

        await using var db = await DbFactory.CreateDbContextAsync();
        // Newest run = reviews carrying the most-recent content fingerprint.
        var latestHash = await db.NodeReviews
            .Where(r => r.NodeId == s.Id)
            .OrderByDescending(r => r.ReviewedAt)
            .Select(r => r.ContentHash)
            .FirstOrDefaultAsync();
        if (!string.IsNullOrEmpty(latestHash))
        {
            reviewList = await db.NodeReviews
                .Where(r => r.NodeId == s.Id && r.ContentHash == latestHash)
                .OrderByDescending(r => r.Score)
                .AsNoTracking()
                .ToListAsync();
        }
        reviewSummary = await db.NodeReviewSummaries
            .Where(r => r.NodeId == s.Id)
            .AsNoTracking()
            .FirstOrDefaultAsync();

        if (reviewSummary?.ScoreDistributionJson is { Length: > 0 } dj)
        {
            try
            {
                var d = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, int>>(dj);
                if (d != null)
                {
                    var order = new[] { "81-100", "61-80", "41-60", "21-40", "1-20" };
                    scoreBuckets = order.Where(d.ContainsKey).Select(k => new KeyValuePair<string, int>(k, d[k])).ToList();
                }
            }
            catch { }
        }

        // Cheap staleness cue: the reviewed beat count vs the node's current count.
        if (reviewList.Count > 0 && beatCounts.TryGetValue(s.Id, out var currentBeats))
            reviewStaleNote = reviewList[0].BeatCount != currentBeats;

        reviewsLoading = false;
        StateHasChanged();
    }

    private void CloseReviews() => reviewsOpen = false;

