    .story-open-btn:hover { color: #fff; background: #1a3a5c; }
</style>

@code {
    private bool loading = true;
    private List<NodeEntity> nodes = new();
    private List<NodeEntity> allStories = new();
#pragma warning disable CS0414
    private IEnumerable<IGrouping<string, NodeEntity>> grouped = Array.Empty<IGrouping<string, NodeEntity>>();
#pragma warning restore CS0414
    /// <summary>Direct-beat count per top-level node id. Lets the index
    /// show a "this has stuff" cue without opening every node.</summary>
    private Dictionary<Guid, int> beatCounts = new();
    /// <summary>Number of direct child nodes per top-level node id —
    /// e.g. a book node reports its chapter count here.</summary>
    private Dictionary<Guid, int> childCounts = new();
    /// <summary>Full child node entities per top-level node id — populated for inline expansion.</summary>
    private Dictionary<Guid, List<NodeEntity>> childNodes = new();
    /// <summary>Top-level node ids whose children are currently expanded inline.</summary>
    private HashSet<Guid> expandedParents = new();
    /// <summary>Estimated page count per node id (word count / 250).</summary>
    private Dictionary<Guid, int> pageCounts = new();
    /// <summary>Estimated audio duration per node id, formatted as "Xh Ym" at 150 wpm.</summary>
    private Dictionary<Guid, string> audioDurations = new();
    /// <summary>Id of the parent node currently running a collection export. Null when idle.</summary>
    private Guid? exportingCollectionId;
    private string newTitle = "";
    private string newKind = "book";

    // ── Inline title/synopsis/summary editing ────────────────────────────
    private Guid? editingId;
    private string editTitle = "";
    private string editDescription = "";
    private string editSummary = "";
    private bool savingEdit;

    private void BeginEdit(NodeEntity s)
    {
        editingId = s.Id;
        editTitle = s.Title;
        editDescription = s.Description ?? "";
        editSummary = s.Summary ?? "";
    }

    private void CancelEdit()
    {
        editingId = null;
        editTitle = editDescription = editSummary = "";
    }

    private async Task SaveEditAsync()
    {
        if (editingId is not { } id || string.IsNullOrWhiteSpace(editTitle)) return;
        savingEdit = true;
        StateHasChanged();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var entity = await db.Nodes.FirstOrDefaultAsync(x => x.Id == id);
            if (entity == null) { Toast.Error("NODE-EDIT", "Story not found."); return; }
            entity.Title = editTitle.Trim();
            entity.Description = string.IsNullOrWhiteSpace(editDescription) ? null : editDescription.Trim();
            entity.Summary = string.IsNullOrWhiteSpace(editSummary) ? null : editSummary.Trim();
            entity.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();

            // Reflect the change in the already-loaded list without a full reload.
            var local = nodes.FirstOrDefault(x => x.Id == id);
            if (local != null) { local.Title = entity.Title; local.Description = entity.Description; local.Summary = entity.Summary; }
            grouped = nodes.GroupBy(s => s.Kind).OrderBy(g => g.Key);
            allStories = nodes.Where(n => n.Kind == "book")
                .Concat(childNodes.Values.SelectMany(kids => kids.Where(k => k.Kind == "book")))
                .OrderBy(s => s.SortKey).ThenBy(s => s.Title).ToList();
            CancelEdit();
            Toast.Info("SAVED", "Story updated.");
        }
        catch (Exception ex)
        {
            Toast.Error("NODE-EDIT-FAIL", ex.InnerException?.Message ?? ex.Message);
        }
        finally
        {
            savingEdit = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!loading)
            await JS.InvokeVoidAsync("streetsamurai.equalizeHeights", ".story-row", false);
    }


    private async Task LoadAsync()
    {
        loading = true;
        StateHasChanged();
        await using var db = await DbFactory.CreateDbContextAsync();
        nodes = await db.Nodes
            .Where(s => s.ParentNodeId == null) // top-level only on this view
            .AsNoTracking()
            .ToListAsync();
        var ids = nodes.Select(s => s.Id).ToHashSet();

        // Recursive descendant count: walk the parent → children map in memory
        // so a book node reports total beats across all chapter children,
        // not just the (zero) direct memberships. Single Node read + single
        // BeatNode read covers the whole site; the in-memory rollup is O(N)
        // and cheaper than a recursive CTE per row.
        var parentMap = await db.Nodes
            .AsNoTracking()
            .Where(s => s.ParentNodeId != null)
            .Select(s => new { s.Id, s.ParentNodeId })
            .ToListAsync();
        var byParent = parentMap
            .GroupBy(s => s.ParentNodeId!.Value)
            .ToDictionary(g => g.Key, g => g.Select(x => x.Id).ToList());

        var perBeatNodeCount = await db.BeatNodes
            .GroupBy(sb => sb.NodeId)
            .Select(g => new { NodeId = g.Key, Count = g.Count() })
            .ToDictionaryAsync(x => x.NodeId, x => x.Count);

        beatCounts = new Dictionary<Guid, int>(ids.Count);
        foreach (var top in ids)
        {
            int total = 0;
            var stack = new Stack<Guid>();
            stack.Push(top);
            var visited = new HashSet<Guid>();
            while (stack.Count > 0)
            {
                var id = stack.Pop();
                if (!visited.Add(id)) continue; // cycle guard
                total += perBeatNodeCount.GetValueOrDefault(id, 0);
                if (byParent.TryGetValue(id, out var kids))
                    foreach (var k in kids) stack.Push(k);
            }
            beatCounts[top] = total;
        }

        childCounts = byParent
            .Where(kvp => ids.Contains(kvp.Key))
            .ToDictionary(kvp => kvp.Key, kvp => kvp.Value.Count);

        // Load full child node entities for top-level parents that have children,
        // so the inline expansion view can render them without an extra round-trip.
        var parentIds = childCounts.Keys.ToHashSet();
        if (parentIds.Count > 0)
        {
            var childList = await db.Nodes
                .Where(s => s.ParentNodeId != null && parentIds.Contains(s.ParentNodeId.Value))
                .AsNoTracking()
                .ToListAsync();
            childNodes = childList
                .GroupBy(s => s.ParentNodeId!.Value)
                .ToDictionary(g => g.Key, g => g.ToList());

            // Seed beat counts for children using the same recursive DFS as top-level nodes,
            // so story nodes that own chapter children (e.g. BCODA, JOY) report the full total.
            foreach (var kid in childList)
            {
                if (beatCounts.ContainsKey(kid.Id)) continue;
                int total = 0;
                var stack = new Stack<Guid>();
                stack.Push(kid.Id);
                var visited = new HashSet<Guid>();
                while (stack.Count > 0)
                {
                    var id = stack.Pop();
                    if (!visited.Add(id)) continue;
                    total += perBeatNodeCount.GetValueOrDefault(id, 0);
                    if (byParent.TryGetValue(id, out var grandkids))
                        foreach (var gk in grandkids) stack.Push(gk);
                }
                beatCounts[kid.Id] = total;
            }
        }
        else
        {
            childNodes = new();
        }

        // Page estimates: sum beat text length per node, divide by ~5.2 chars/word / 250 words/page.
        var allIds = nodes.Select(s => s.Id)
            .Concat(childNodes.Values.SelectMany(v => v.Select(c => c.Id)))
            .Distinct().ToList();
        var charCounts = await db.BeatNodes
            .AsNoTracking()
            .Where(sb => allIds.Contains(sb.NodeId) && sb.IsEnabled)
            .Join(db.Beats.AsNoTracking().Where(b => b.Text != null && b.Text != ""),
                  sb => sb.BeatId, b => b.Id, (sb, b) => new { sb.NodeId, b.Text })
            .GroupBy(x => x.NodeId)
            .Select(g => new { NodeId = g.Key, Chars = g.Sum(x => (long)x.Text!.Length) })
            .ToDictionaryAsync(x => x.NodeId);
        pageCounts = charCounts.ToDictionary(kvp => kvp.Key, kvp => (int)(kvp.Value.Chars / 5.2 / 250));
        audioDurations = charCounts.ToDictionary(kvp => kvp.Key, kvp =>
        {
            var totalMinutes = (int)(kvp.Value.Chars / 5.2 / 150);
            return totalMinutes >= 60
                ? $"{totalMinutes / 60}h {totalMinutes % 60:D2}m"
                : $"{totalMinutes}m";
        });

        grouped = nodes.GroupBy(s => s.Kind).OrderBy(g => g.Key);
        allStories = nodes.Where(n => n.Kind == "book")
            .Concat(childNodes.Values.SelectMany(kids => kids.Where(k => k.Kind == "book")))
            .OrderBy(s => s.SortKey).ThenBy(s => s.Title)
            .ToList();
        loading = false;
        StateHasChanged();
    }

    private void ToggleExpand(Guid id)
    {
        if (!expandedParents.Add(id)) expandedParents.Remove(id);
        StateHasChanged();
    }

    private async Task ExportCollectionAudiobookAsync(Guid nodeId)
    {
        if (exportingCollectionId != null) return;
        exportingCollectionId = nodeId;
        await InvokeAsync(StateHasChanged);
        try
        {
            await Workbench.ExportAudiobookAsync(nodeId);
            Toast.Success("AUDIOBOOK", "Audiobook published — MP3 saved to Downloads.");
        }
        catch (Exception ex) { Toast.Error("AUDIOBOOK-FAIL", ex.Message); }
        finally { exportingCollectionId = null; await InvokeAsync(StateHasChanged); }
    }

    private async Task ExportCollectionManuscriptAsync(Guid nodeId)
    {
        if (exportingCollectionId != null) return;
        exportingCollectionId = nodeId;
        await InvokeAsync(StateHasChanged);
        try
        {
            // docx first — it increments node.Version; the rest then share that version.
            await Docx.ExportNodeAsync(nodeId);
            await Manuscript.ExportEpubAsync(nodeId);
            await Manuscript.ExportPdfAsync(nodeId);
            await Manuscript.ExportAudioTxtAsync(nodeId);
            Toast.Success("EXPORT", "Manuscript exported — .docx, .epub, .pdf, and .txt saved to Downloads.");
        }
        catch (Exception ex) { Toast.Error("EXPORT-FAIL", ex.Message); }
        finally { exportingCollectionId = null; await InvokeAsync(StateHasChanged); }
    }

    private async Task ExportCollectionAsync(Guid nodeId, string tag, string label, Func<Guid, Task<string>> export)
    {
        if (exportingCollectionId != null) return;
        exportingCollectionId = nodeId;
        await InvokeAsync(StateHasChanged);
        try
        {
            await export(nodeId);
            Toast.Success(tag, $"{label} saved to Downloads.");
        }
        catch (Exception ex) { Toast.Error($"{tag}-FAIL", ex.Message); }
        finally { exportingCollectionId = null; await InvokeAsync(StateHasChanged); }
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        var id = Guid.CreateVersion7();
        var baseSlug = System.Text.RegularExpressions.Regex
            .Replace(newTitle.ToLowerInvariant(), @"[^a-z0-9]+", "-")
            .Trim('-');
        if (string.IsNullOrEmpty(baseSlug)) baseSlug = "node";
        var slug = $"{baseSlug}-{id.ToString("N")[..8]}";

        // Chapters without a parent are orphans — auto-route to the "Drafts" story.
        Guid? parentId = null;
        if (newKind == "chapter")
        {
            var universeId = Universe.CurrentId;
            var drafts = await db.Nodes.FirstOrDefaultAsync(s =>
                s.Title == "Drafts" && s is StreetSamurai.Core.Data.Entities.BookNode && s.ParentNodeId == null && s.UniverseId == universeId);
            if (drafts == null)
            {
                drafts = new StreetSamurai.Core.Data.Entities.BookNode
                {
                    Id = Guid.CreateVersion7(),
                    Slug = $"drafts-{Guid.CreateVersion7().ToString("N")[..8]}",
                    Title = "Drafts",
                    Status = "draft",
                    SortKey = (nodes.Count + 2) * 100.0,
                    UniverseId = universeId,
                };
                db.Nodes.Add(drafts);
            }
            parentId = drafts.Id;
            Toast.Info("DRAFTS", "Chapter routed to “Drafts” — assign it to a story when ready.");
        }

        var newNode = StreetSamurai.Core.Data.Entities.NodeFactory.Create(newKind);
        newNode.Id = id;
        newNode.Slug = slug;
        newNode.Title = newTitle.Trim();
        newNode.Status = "draft";
        newNode.ParentNodeId = parentId;
        newNode.SortKey = (nodes.Count + 1) * 100.0;
        db.Nodes.Add(newNode);
        try
        {
            await db.SaveChangesAsync();
        }
        catch (DbUpdateException ex)
        {
            // Slug collision is the only foreseeable unique-index hit here
            // (two near-simultaneous creates whose titles slugify to the same
            // base AND whose 8-char id prefixes collide — vanishingly rare
            // but not impossible). Surface a friendly retry hint instead of
            // letting the raw SqlException bubble up to the user.
            var msg = ex.InnerException?.Message ?? ex.Message;
            Toast.Error("NODE-CREATE-FAIL",
                msg.Contains("UNIQUE", StringComparison.OrdinalIgnoreCase) || msg.Contains("duplicate", StringComparison.OrdinalIgnoreCase)
                    ? "A node with that slug already exists. Try a different title or click Create again — the id suffix will reshuffle."
                    : $"Couldn't save the new node: {msg}");
            return;
        }
        OpenNode(slug);
    }

    private void OpenNode(string? slug, string? nodeCode = null)
    {
        if (string.IsNullOrEmpty(slug)) return;
        var code = nodeCode ?? slug;
        TabSvc.Open(new AppTab($"node-{code}", code, "bi-pencil-square", $"/node/{slug}", "/node"));
        Nav.NavigateTo($"/node/{slug}");
    }

