@page "/change-password"
@page "/account/change-password"
@attribute [Authorize]
@inject IWriteAccessProvider Access
@inject NavigationManager Nav
@inject PasswordPolicyDescriptor Policy

<div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="card bg-dark text-light border-secondary" style="width: 400px;">
        <div class="card-header text-danger fw-bold">
            <i class="bi bi-shield-exclamation"></i> Change Password
        </div>
        <div class="card-body">
            @if (Access.CurrentUserName == "Visitor")
            {
                <p class="text-muted">You must be logged in to change your password.</p>
                <a href="/login" class="btn btn-outline-danger btn-sm">Login</a>
            }
            else
            {
                <p class="text-muted small mb-3">Choose a new password for your account.</p>

                @* Presentation-only form; the MindAttic.Authentication endpoint
                   (/_ma-auth/change-password) owns the change, then redirects to
                   /account?changed=1 on success or back here with ?error=1. *@
                <MaChangePassword Error="@hasError" />

                <div class="text-muted mt-3" style="font-size: 0.72rem; line-height: 1.6;">
                    @foreach (var req in Policy.Requirements)
                    {
                        <div><i class="bi bi-dot"></i> @req</div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool hasError;

    protected override void OnInitialized()
        => hasError = new Uri(Nav.Uri).Query.Contains("error=1");
}
