@using Microsoft.EntityFrameworkCore
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<Prose.Core.Data.ProseDbContext> DbFactory
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject Prose.Core.Services.AppLinks Links

@* The persistent Writer pane: pick a node up top, write in the embedded editor below. The editor
   is the real /node page loaded in an iframe (?embed=1 renders it bare) so its heavy, route-driven
   state is fully isolated and it survives navigation in the repositories pane beside it.

   The selected node rides the ?node= query string so the full view is a shareable URL. The token
   is the slug when one exists (clean), and REVERTS TO THE UUIDv7 ID when the slug fails to
   resolve — slugs are recomputed on rename, so a stale slug link self-heals through the guid,
   and the /node/{IdOrSlug} page accepts either form. localStorage keeps the guid (rename-proof)
   as fallback when the URL carries no selection. *@
<div class="writer-pane">
    <div class="writer-pane-head">
        <span class="writer-pane-title"><i class="bi bi-pencil-square me-2"></i>Writer</span>
        <select class="form-select form-select-sm writer-pane-select" @bind="selectedKey" @bind:after="OnSelected">
            <option value="">— select a node —</option>
            @foreach (var s in nodes)
            {
                <option value="@KeyFor(s)">@s.Title</option>
            }
        </select>
        @if (!string.IsNullOrEmpty(selectedKey))
        {
            <a class="btn btn-sm btn-outline-secondary" href="@Links.Writer($"/node/{selectedKey}")" target="_blank" title="Open full-screen"><i class="bi bi-arrows-fullscreen"></i></a>
        }
    </div>
    <div class="writer-pane-body">
        @if (string.IsNullOrEmpty(selectedKey))
        {
            <div class="writer-pane-empty">
                <i class="bi bi-pencil-square"></i>
                <div>Select a node above to start writing, or <a href="@Links.Writer("/nodes")">browse all nodes</a>.</div>
            </div>
        }
        else
        {
            <iframe class="writer-pane-frame" src="@Links.Writer($"/node/{selectedKey}?embed=1")" title="Writer"></iframe>
        }
    </div>
</div>

@code {
    private record NodeRow(Guid Id, string Slug, string Title);
    private List<NodeRow> nodes = new();
    private string selectedKey = "";

    private static string KeyFor(NodeRow row)
        => string.IsNullOrEmpty(row.Slug) ? row.Id.ToString() : row.Slug;

    protected override void OnInitialized()
    {
        using var db = DbFactory.CreateDbContext();
        nodes = db.Nodes.AsNoTracking()
            .OrderByDescending(s => s.UpdatedAt)
            .Select(s => new NodeRow(s.Id, s.Slug ?? "", s.Title))
            .Take(100)
            .ToList();

        // Query string wins — a shared link opens exactly what the sender saw.
        var resolved = Resolve(GetQueryParam("node"));
        if (resolved != null)
        {
            selectedKey = KeyFor(resolved);
            // Self-heal: a guid or stale-slug token becomes the node's current slug.
            SyncUrl(replaceOnly: true);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !string.IsNullOrEmpty(selectedKey)) return;
        try
        {
            var saved = await JS.InvokeAsync<string>("localStorage.getItem", "writer.node");
            var resolved = Resolve(saved);
            if (resolved != null)
            {
                selectedKey = KeyFor(resolved);
                StateHasChanged();
            }
        }
        catch { /* prerender / JS unavailable */ }
    }

    private async Task OnSelected()
    {
        var row = nodes.FirstOrDefault(s => KeyFor(s) == selectedKey);
        // Persist the GUID — it survives renames; the slug in the URL may not.
        try { await JS.InvokeVoidAsync("localStorage.setItem", "writer.node", row?.Id.ToString() ?? ""); } catch { }
        SyncUrl(replaceOnly: true);
    }

    /// <summary>Resolve a ?node= token to a node: slug first, then UUIDv7 id fallback.
    /// Looks past the top-100 picker list straight into the DB, and inserts a hit
    /// into the list so the select can show it.</summary>
    private NodeRow? Resolve(string? token)
    {
        if (string.IsNullOrWhiteSpace(token)) return null;

        var inList = nodes.FirstOrDefault(s => s.Slug == token)
                  ?? (Guid.TryParse(token, out var listId) ? nodes.FirstOrDefault(s => s.Id == listId) : null);
        if (inList != null) return inList;

        using var db = DbFactory.CreateDbContext();
        var hit = db.Nodes.AsNoTracking()
            .Where(s => s.Slug == token)
            .Select(s => new NodeRow(s.Id, s.Slug ?? "", s.Title))
            .FirstOrDefault();
        if (hit == null && Guid.TryParse(token, out var id))
        {
            hit = db.Nodes.AsNoTracking()
                .Where(s => s.Id == id)
                .Select(s => new NodeRow(s.Id, s.Slug ?? "", s.Title))
                .FirstOrDefault();
        }
        if (hit != null && !nodes.Any(s => s.Id == hit.Id))
            nodes.Insert(0, hit);
        return hit;
    }

    private void SyncUrl(bool replaceOnly)
    {
        var target = Nav.GetUriWithQueryParameter("node", string.IsNullOrEmpty(selectedKey) ? null : selectedKey);
        if (target != Nav.Uri)
            Nav.NavigateTo(target, replace: replaceOnly);
    }

    private string GetQueryParam(string key)
    {
        var query = new Uri(Nav.Uri).Query;
        if (string.IsNullOrEmpty(query)) return "";
        foreach (var pair in query.TrimStart('?').Split('&'))
        {
            var kv = pair.Split('=', 2);
            if (kv.Length == 2 && Uri.UnescapeDataString(kv[0]).Equals(key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(kv[1]);
        }
        return "";
    }
}
