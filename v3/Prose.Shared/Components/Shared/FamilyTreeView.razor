@using Prose.Core.Data.Entities
@using Prose.Core.Services
@inject FamilyTieService Family
@inject ToastNotifier Toast

@*
   Generation-grid family tree. CSS-grid-only (no D3, no JS interop) so it
   renders inline with the rest of the page. Row 1 = grandparents,
   row 2 = parents + aunts/uncles, row 3 = subject + siblings + spouse,
   row 4 = children. Each character is a small chip linking to /entity/{id}.

   The subject's row is highlighted; subject is centered with a thicker border.
*@

@if (loading)
{
    <div class="card bg-dark text-light border-secondary mb-3">
        <div class="card-header text-muted small">
            <i class="bi bi-diagram-2 me-1"></i> Family tree
        </div>
        <div class="card-body small text-muted">
            <span class="spinner-border spinner-border-sm me-2"></span> loading family graph...
        </div>
    </div>
}
else if (snapshot != null && Total > 0)
{
    <div class="card bg-dark text-light border-secondary mb-3">
        <div class="card-header text-muted small d-flex justify-content-between">
            <span><i class="bi bi-diagram-2 me-1"></i> Family tree — @Total people across @GenerationsRendered generations</span>
            <span class="text-muted">@SubjectName</span>
        </div>
        <div class="card-body">
            <div class="family-tree">
                @if (snapshot.Grandparents.Count > 0)
                {
                    <div class="ft-row">
                        <div class="ft-row-label">Grandparents</div>
                        <div class="ft-row-people">
                            @foreach (var gp in snapshot.Grandparents)
                            {
                                @ChipFor(gp, false)
                            }
                        </div>
                    </div>
                }

                @if (snapshot.Parents.Count > 0 || auntsUncles.Count > 0)
                {
                    <div class="ft-row">
                        <div class="ft-row-label">Parents · Aunts/Uncles</div>
                        <div class="ft-row-people">
                            @foreach (var p in snapshot.Parents)
                            {
                                @ChipFor(p, false, "ft-parent")
                            }
                            @foreach (var au in auntsUncles)
                            {
                                @ChipFor(au, false, "ft-aunt")
                            }
                        </div>
                    </div>
                }

                <div class="ft-row ft-row-subject">
                    <div class="ft-row-label">Subject · Siblings · Spouse · Cousins</div>
                    <div class="ft-row-people">
                        @foreach (var sib in snapshot.Siblings)
                        {
                            @ChipFor(sib, false, "ft-sibling")
                        }
                        <span class="ft-chip ft-subject" title="Subject">
                            <strong>@SubjectName</strong>
                        </span>
                        @foreach (var sp in snapshot.Spouses)
                        {
                            @ChipFor(sp, false, "ft-spouse")
                        }
                        @foreach (var c in snapshot.Cousins)
                        {
                            @ChipFor(c, false, "ft-cousin")
                        }
                    </div>
                </div>

                @if (snapshot.Children.Count > 0)
                {
                    <div class="ft-row">
                        <div class="ft-row-label">Children</div>
                        <div class="ft-row-people">
                            @foreach (var c in snapshot.Children)
                            {
                                @ChipFor(c, false, "ft-child")
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="ft-legend small text-muted mt-2">
                <span class="me-3"><span class="ft-swatch ft-parent"></span>parent</span>
                <span class="me-3"><span class="ft-swatch ft-aunt"></span>aunt/uncle</span>
                <span class="me-3"><span class="ft-swatch ft-sibling"></span>sibling</span>
                <span class="me-3"><span class="ft-swatch ft-spouse"></span>spouse</span>
                <span class="me-3"><span class="ft-swatch ft-cousin"></span>cousin</span>
                <span class="me-3"><span class="ft-swatch ft-child"></span>child</span>
            </div>
        </div>
    </div>

    <style>
        .family-tree { display: flex; flex-direction: column; gap: 0.75rem; }
        .ft-row { padding: 0.5rem; border-radius: 6px; background: #1a1f25; }
        .ft-row-subject { background: #1f2933; border: 1px solid #3d4853; }
        .ft-row-label { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.05em;
                        color: #8a96a3; margin-bottom: 0.4rem; }
        .ft-row-people { display: flex; flex-wrap: wrap; gap: 0.35rem; align-items: center; justify-content: center; }
        .ft-chip { display: inline-block; padding: 0.25rem 0.55rem; border-radius: 999px;
                   font-size: 0.85rem; text-decoration: none; line-height: 1.3;
                   border: 1px solid transparent; background: #2a3038; color: #cfd6dd; }
        .ft-chip:hover { background: #3a414a; color: #fff; }
        .ft-subject { background: #4a3a2a; color: #ffd089; border-color: #b88a44; padding: 0.4rem 0.8rem; }
        .ft-parent  { border-color: #5b8def; }
        .ft-aunt    { border-color: #7c93b3; }
        .ft-sibling { border-color: #6cae6c; }
        .ft-spouse  { border-color: #d77c8a; }
        .ft-cousin  { border-color: #9b7cd7; }
        .ft-child   { border-color: #d7a35c; }
        .ft-swatch { display: inline-block; width: 0.7rem; height: 0.7rem; border-radius: 50%;
                     margin-right: 0.25rem; vertical-align: middle; background: #2a3038;
                     border: 1px solid transparent; }
        .ft-legend .ft-parent  { border-color: #5b8def; }
        .ft-legend .ft-aunt    { border-color: #7c93b3; }
        .ft-legend .ft-sibling { border-color: #6cae6c; }
        .ft-legend .ft-spouse  { border-color: #d77c8a; }
        .ft-legend .ft-cousin  { border-color: #9b7cd7; }
        .ft-legend .ft-child   { border-color: #d7a35c; }
    </style>
}
else if (snapshot != null)
{
    <div class="card bg-dark text-light border-secondary mb-3">
        <div class="card-header text-muted small">
            <i class="bi bi-diagram-2 me-1"></i> Family tree
        </div>
        <div class="card-body small text-muted">
            No family ties yet. Use the <em>Propose family</em> button on the Family panel below
            (or <code>ss --family-gen propose --of @EntityId --commit</code>) to seed the tree.
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public string  EntityId    { get; set; } = "";
    [Parameter] public string SubjectName { get; set; } = "";

    private bool loading = true;
    private FamilyTieService.FamilySnapshot? snapshot;
    private List<Entity> auntsUncles = new();
    private string lastLoadedFor = "";

    private int Total =>
        (snapshot?.Parents.Count ?? 0) + (snapshot?.Siblings.Count ?? 0) +
        (snapshot?.Spouses.Count ?? 0) + (snapshot?.Children.Count ?? 0) +
        (snapshot?.Grandparents.Count ?? 0) + (snapshot?.Cousins.Count ?? 0) +
        auntsUncles.Count + 1 /* subject */;

    private int GenerationsRendered =>
        (snapshot?.Grandparents.Count > 0 ? 1 : 0) +
        ((snapshot?.Parents.Count > 0 || auntsUncles.Count > 0) ? 1 : 0) +
        1 +  // subject row
        (snapshot?.Children.Count > 0 ? 1 : 0);

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(EntityId, lastLoadedFor, StringComparison.OrdinalIgnoreCase)) return;
        lastLoadedFor = EntityId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true; snapshot = null; auntsUncles = new();
        StateHasChanged();
        try
        {
            if (Guid.TryParse(EntityId, out var id) ||
                (EntityId.Length == 32 && Guid.TryParseExact(EntityId, "N", out id)))
            {
                snapshot = await Family.GetSnapshotAsync(id);

                // Aunts/uncles aren't on the snapshot record (cousins/grandparents
                // ARE) — derive them as the siblings of each parent.
                var seen = new HashSet<Guid>();
                foreach (var p in snapshot.Parents)
                    foreach (var s in await Family.GetSiblingsAsync(p.Id))
                        if (s.Id != id && seen.Add(s.Id)) auntsUncles.Add(s);
            }
        }
        catch (Exception ex)
        {
            Toast.Warning("FAMILYTREE-001", $"Could not load tree for {EntityId}: {ex.Message}");
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private RenderFragment ChipFor(Entity e, bool subject, string extraClass = "") => __builder =>
    {
        var cls = "ft-chip " + extraClass;
        <a href="/entity/@e.Id" class="@cls" title="@e.Name">@e.Name</a>
    };
}
