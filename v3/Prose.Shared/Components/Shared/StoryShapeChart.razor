@using Prose.Core.Services
@inject IJSRuntime JS
@implements IAsyncDisposable

@* ── Archetype selector ────────────────────────────────────────────── *@
<div class="d-flex gap-1 flex-wrap @(Compact ? "mb-1" : "mb-2")">
    @foreach (var (key, label) in ArchetypeLabels)
    {
        var k = key;
        <button class="btn btn-sm @(selectedArchetype == k ? "btn-light text-dark" : "btn-outline-secondary")"
                style="font-size:0.7rem; padding: 1px 8px;"
                @onclick="() => SwitchArchetype(k)">@label</button>
    }
</div>

@* ── D3 chart container ────────────────────────────────────────────── *@
<div id="@chartId" style="position:relative; width:100%; min-height:@(Compact ? "100px" : "248px");"></div>

@if (!Compact)
{
    @* ── Selected beat detail ──────────────────────────────────────────── *@
    @if (selectedBeatIndex >= 0 && AllBeats != null && AllBeats.Count > 0 && selectedBeatIndex < AllBeats.Count)
    {
        var b = AllBeats[selectedBeatIndex];
        <div class="mt-2 rounded p-2" style="background:#0d1117; border:1px solid #30363d; font-size:0.8rem;">
            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                <span class="fw-bold text-light">@b.Title</span>
                @if (!string.IsNullOrEmpty(b.StructureRole))
                {
                    <span class="badge" style="font-size:0.6rem;background:@(b.SceneType=="sequel"?"#1f4e79":"#3d1f00");color:@(b.SceneType=="sequel"?"#58a6ff":"#f0883e");">@b.StructureRole</span>
                }
                <span class="badge bg-secondary ms-auto">Tension @b.Tension/10</span>
            </div>
            @if (!string.IsNullOrEmpty(b.Goal))
            {
                <div class="text-muted">@b.Goal</div>
            }
            @if (!string.IsNullOrEmpty(b.EmotionalArc))
            {
                <div class="text-info" style="font-size:0.75rem; margin-top:2px;">@b.EmotionalArc</div>
            }
            @if (b.Seeds.Count > 0)
            {
                <div class="mt-1"><span class="text-warning" style="font-size:0.7rem;">SEEDS</span> <span class="text-muted">@string.Join(" · ", b.Seeds)</span></div>
            }
        </div>
    }
    else
    {
        <div class="text-muted mt-1" style="font-size:0.75rem; min-height:18px;">Click a beat to inspect it.</div>
    }

    @* ── Archetype description ─────────────────────────────────────────── *@
    <div class="mt-1 mb-3 text-muted" style="font-size:0.75rem; font-style:italic; line-height:1.5;">
        @ArchetypeDescs[selectedArchetype]
    </div>
}

@* ── Beat list ─────────────────────────────────────────────────────── *@
@if (Outline != null)
{
    <div class="mb-1 fw-bold text-danger" style="font-size:0.85rem;">@Outline.Title</div>
    @if (!string.IsNullOrEmpty(Outline.Logline))
    {
        <p class="small text-muted mb-1">@Outline.Logline</p>
    }
    @if (!string.IsNullOrEmpty(Outline.Theme))
    {
        <p class="small text-info mb-2">Theme: @Outline.Theme</p>
    }

    @foreach (var act in Outline.Acts)
    {
        <div class="mb-3">
            <div class="fw-bold text-warning" style="font-size:0.85rem;">Act @act.ActNumber: @act.Name</div>
            <small class="text-muted">@act.Purpose</small>
            @foreach (var beat in act.Beats)
            {
                var b = beat;
                var isSelected = b.BeatIndex == selectedBeatIndex;
                <div class="d-flex align-items-start gap-2 border-start ps-2 ms-2 mt-1 @(b.Written ? "opacity-50" : "")"
                     style="border-color: @(isSelected ? "#58a6ff" : "#30363d") !important; cursor:pointer;"
                     @onclick="() => SelectBeatFromList(b.BeatIndex)">
                    <span class="badge @(b.Written ? "bg-success" : isSelected ? "bg-primary" : "bg-secondary") mt-1"
                          style="min-width:24px; font-size:0.65rem;">@(b.BeatIndex + 1)</span>
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <div class="small fw-bold">@b.Title</div>
                            @if (!string.IsNullOrEmpty(b.StructureRole))
                            {
                                <span class="badge" style="font-size:0.55rem;background:@(b.SceneType=="sequel"?"#1f4e79":"#3d1f00");color:@(b.SceneType=="sequel"?"#58a6ff":"#f0883e");">@b.StructureRole</span>
                            }
                            <span class="ms-auto badge bg-dark text-secondary border border-secondary" style="font-size:0.6rem;">@b.Tension/10</span>
                        </div>
                        <div class="small text-muted">@b.Goal</div>
                        @if (b.Seeds.Count > 0)
                        {
                            <small class="text-info">Seeds: @string.Join(", ", b.Seeds)</small>
                        }
                    </div>
                    @if (!b.Written && OnWriteBeat.HasDelegate)
                    {
                        <button class="btn btn-sm btn-outline-danger" style="font-size:0.7rem; padding:1px 8px;"
                                @onclick:stopPropagation="true"
                                @onclick="() => OnWriteBeat.InvokeAsync(b)">Write</button>
                    }
                </div>
            }
        </div>
    }

    @* ── Character arcs ─────────────────────────────────────────────── *@
    @if (Outline.CharacterArcs.Any())
    {
        <div class="field-label text-danger mt-3 mb-1" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:1px;">Character Arcs</div>
        @foreach (var arc in Outline.CharacterArcs)
        {
            <div class="small border-start border-secondary ps-2 ms-2 mt-1">
                <span class="fw-bold text-light">@arc.Character</span>
                <div class="d-flex gap-3 mt-1 flex-wrap">
                    @if (!string.IsNullOrEmpty(arc.Want))
                    {
                        <span><span class="text-warning" style="font-size:0.65rem;">WANT</span> <span class="text-muted">@arc.Want</span></span>
                    }
                    @if (!string.IsNullOrEmpty(arc.Need))
                    {
                        <span><span class="text-info" style="font-size:0.65rem;">NEED</span> <span class="text-muted">@arc.Need</span></span>
                    }
                </div>
                <div class="text-muted mt-1">@arc.StartState → @arc.EndState</div>
                @if (!string.IsNullOrEmpty(arc.TurningPoint))
                {
                    <div class="text-muted" style="font-size:0.72rem;">Turning point: @arc.TurningPoint · Cost: @arc.Cost</div>
                }
            </div>
        }
    }
}

@code {
    [Parameter] public StoryOutline? Outline { get; set; }
    [Parameter] public EventCallback<OutlineBeat> OnWriteBeat { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string? TrackScrollOf { get; set; }

    string chartId     = "story-shape-" + Guid.NewGuid().ToString("N")[..8];
    string selectedArchetype = "cinderella";
    int    selectedBeatIndex = -1;
    bool   needsRender = true;

    DotNetObjectReference<StoryShapeChart>? dotnetRef;
    List<OutlineBeat>? AllBeats;
    bool disposed;

    static readonly Dictionary<string, string> ArchetypeLabels = new()
    {
        ["cinderella"]   = "Cinderella",
        ["man-in-hole"]  = "Man in a Hole",
        ["greek-tragedy"]= "Greek Tragedy",
        ["freytag"]      = "Freytag's Pyramid",
        ["hero-journey"] = "Hero's Journey"
    };

    static readonly Dictionary<string, string> ArchetypeDescs = new()
    {
        ["cinderella"]    = "Starting in hardship, a stroke of luck brings joy — but it's snatched away. Earned transformation leads to a permanent rise.",
        ["man-in-hole"]   = "Character starts okay, falls into trouble, climbs back out — better for the experience. The simplest satisfying shape.",
        ["greek-tragedy"] = "Aristotle's model: the hero begins high, is undone by a fatal flaw (hamartia), and falls to ruin. The audience feels catharsis — pity and fear — precisely because the peak was so high.",
        ["freytag"]       = "Gustav Freytag (1863): rising action builds to a climax, then falling action descends through resolution to catastrophe or denouement.",
        ["hero-journey"]  = "Joseph Campbell's monomyth (1949): the hero leaves home, descends into a dangerous unknown, faces a death-like ordeal, and returns transformed. The lowest point creates the most powerful rise."
    };

    protected override void OnParametersSet()
    {
        AllBeats = Outline?.Acts
            .SelectMany(a => a.Beats)
            .OrderBy(b => b.BeatIndex)
            .ToList();
        needsRender = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;

        if (firstRender)
            dotnetRef = DotNetObjectReference.Create(this);

        if (needsRender)
        {
            needsRender = false;
            await RenderChart();
        }
    }

    async Task RenderChart()
    {
        if (disposed) return;
        var beats = BuildBeatDtos();
        try
        {
            await JS.InvokeVoidAsync("storyShape.render", chartId, beats, selectedArchetype, Compact ? null : (object?)dotnetRef, Compact);
            if (!disposed && !string.IsNullOrEmpty(TrackScrollOf))
                await JS.InvokeVoidAsync("storyShape.trackScroll", TrackScrollOf, chartId);
        }
        catch (ObjectDisposedException) { }
        catch (JSDisconnectedException) { }
    }

    async Task SwitchArchetype(string key)
    {
        if (disposed) return;
        selectedArchetype = key;
        var beats = BuildBeatDtos();
        try
        {
            await JS.InvokeVoidAsync("storyShape.update", chartId, beats, selectedArchetype, Compact ? null : (object?)dotnetRef, Compact);
            if (!disposed && !string.IsNullOrEmpty(TrackScrollOf))
                await JS.InvokeVoidAsync("storyShape.trackScroll", TrackScrollOf, chartId);
        }
        catch (ObjectDisposedException) { }
        catch (JSDisconnectedException) { }
    }

    void SelectBeatFromList(int index)
    {
        selectedBeatIndex = index == selectedBeatIndex ? -1 : index;
    }

    [JSInvokable]
    public void SelectBeat(int index)
    {
        selectedBeatIndex = index == selectedBeatIndex ? -1 : index;
        InvokeAsync(StateHasChanged);
    }

    record BeatDto(int index, string title, string goal, int tension, int act, string role, string sceneType, bool written);

    BeatDto[] BuildBeatDtos()
    {
        if (Outline == null) return [];
        return Outline.Acts
            .SelectMany(a => a.Beats.Select(b => new BeatDto(
                b.BeatIndex,
                b.Title,
                b.Goal,
                b.Tension == 0 ? 5 : b.Tension,
                a.ActNumber,
                b.StructureRole,
                b.SceneType,
                b.Written
            )))
            .OrderBy(b => b.index)
            .ToArray();
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        try { await JS.InvokeVoidAsync("storyShape.destroy", chartId); } catch { }
        dotnetRef?.Dispose();
        dotnetRef = null;
    }
}
