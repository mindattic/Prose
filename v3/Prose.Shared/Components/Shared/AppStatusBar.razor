@* AppStatusBar — thin bottom-of-shell bar that mirrors the most recent toast
   message from ToastNotifier so system events are visible at a glance even
   when the JS toast has already faded. *@

@implements IDisposable
@inject ToastNotifier Toast

<div class="app-statusbar app-statusbar--@(latestLevel ?? "idle")">
    @if (latestMessage != null)
    {
        <span class="app-statusbar-icon">
            @(latestLevel switch
            {
                "error"   => "⚠",
                "warn"    => "!",
                "success" => "✓",
                _         => "ℹ"
            })
        </span>
        <span class="app-statusbar-text">@latestMessage</span>
    }
    else
    {
        <span class="app-statusbar-idle">Ready</span>
    }
</div>

@code {
    private string? latestMessage;
    private string? latestLevel;

    protected override void OnInitialized()
    {
        Toast.ToastRaised += OnToast;
    }

    private void OnToast(ToastMessage msg)
    {
        InvokeAsync(() =>
        {
            latestMessage = string.IsNullOrEmpty(msg.Code)
                ? msg.Message
                : $"[{msg.Code}] {msg.Message}";
            latestLevel = msg.Level;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Toast.ToastRaised -= OnToast;
    }
}
