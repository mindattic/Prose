@using Prose.Core.Services
@inject CoWriterService Svc

<div class="cowriter-drawer @(open ? "cowriter-open" : "cowriter-closed")">
    <div class="cowriter-toggle" @onclick="Toggle" title="@(open ? "Hide co-writer" : "Open co-writer")">
        @if (open)
        {
            <i class="bi bi-chevron-right"></i>
        }
        else
        {
            <i class="bi bi-chat-dots"></i>
        }
    </div>

    @if (open)
    {
        <div class="cowriter-header">
            <strong class="text-info"><i class="bi bi-chat-dots me-1"></i>Co-Writer</strong>
            <span class="text-muted small ms-2">working on this book with you</span>
            <button class="btn btn-sm btn-outline-secondary py-0 ms-auto" @onclick="ClearHistory" title="Clear conversation">
                <i class="bi bi-trash"></i>
            </button>
        </div>

        <div class="cowriter-history" @ref="historyEl">
            @if (history.Count == 0)
            {
                <div class="text-muted small p-3">
                    Talk to the system about your book. Ask it to draft, revise, challenge, or surface
                    canon implications. If you propose something that conflicts with established canon,
                    you'll be told — and you can override (the change propagates) or revise.
                </div>
            }
            @foreach (var msg in history)
            {
                <div class="cowriter-msg @(msg.Role == "user" ? "cowriter-user" : "cowriter-assistant")">
                    <div class="cowriter-msg-role">@(msg.Role == "user" ? "you" : "co-writer")</div>
                    <div class="cowriter-msg-body">@msg.Content</div>
                </div>
            }
            @if (working)
            {
                <div class="cowriter-msg cowriter-assistant">
                    <div class="cowriter-msg-role">co-writer</div>
                    <div class="cowriter-msg-body"><span class="spinner-border spinner-border-sm me-2"></span>thinking...</div>
                </div>
            }
        </div>

        <div class="cowriter-input">
            <textarea class="form-control bg-black text-light border-secondary small"
                      rows="3"
                      placeholder="Tell me what to change, ask a question, or describe a scene…"
                      @bind="userInput"
                      @bind:event="oninput"
                      @onkeydown="HandleKey"
                      disabled="@working"></textarea>
            <button class="btn btn-sm btn-info mt-2" @onclick="Send" disabled="@(working || string.IsNullOrWhiteSpace(userInput))">
                <i class="bi bi-send me-1"></i>Send <span class="text-muted ms-2 small">(Ctrl+Enter)</span>
            </button>
        </div>
    }
</div>

<style>
    .cowriter-drawer {
        position: fixed;
        top: 60px;
        right: 0;
        bottom: 0;
        background: #0a0a0a;
        border-left: 1px solid #2a2a2a;
        display: flex;
        flex-direction: column;
        z-index: 900;
        transition: width 0.2s ease;
    }
    .cowriter-open { width: 380px; }
    .cowriter-closed { width: 36px; }
    .cowriter-toggle {
        position: absolute;
        top: 14px;
        left: -1px;
        width: 36px;
        height: 36px;
        background: #1a1a1a;
        border: 1px solid #2a2a2a;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #999;
    }
    .cowriter-toggle:hover { color: #c00; }
    .cowriter-header {
        display: flex;
        align-items: center;
        padding: 12px 14px 12px 50px;
        border-bottom: 1px solid #2a2a2a;
        font-size: 0.9rem;
    }
    .cowriter-history {
        flex: 1;
        overflow-y: auto;
        padding: 10px 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }
    .cowriter-msg { font-size: 0.85rem; }
    .cowriter-msg-role {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 3px;
    }
    .cowriter-user .cowriter-msg-role { color: #c00; }
    .cowriter-assistant .cowriter-msg-role { color: #0dcaf0; }
    .cowriter-msg-body {
        background: #1a1a1a;
        border: 1px solid #2a2a2a;
        padding: 8px 10px;
        white-space: pre-wrap;
        line-height: 1.45;
    }
    .cowriter-user .cowriter-msg-body { border-left: 2px solid #c00; }
    .cowriter-assistant .cowriter-msg-body { border-left: 2px solid #0dcaf0; }
    .cowriter-input {
        padding: 10px 14px 14px;
        border-top: 1px solid #2a2a2a;
    }
</style>

@code {
    [Parameter] public string BookId { get; set; } = "";

    private bool open = false;
    private string userInput = "";
    private bool working = false;
    private List<CoWriterMessage> history = new();
    private ElementReference historyEl;

    private void Toggle() => open = !open;

    private void ClearHistory() => history.Clear();

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey))
        {
            await Send();
        }
    }

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(userInput) || working) return;
        var msg = userInput.Trim();
        userInput = "";
        history.Add(new CoWriterMessage { Role = "user", Content = msg });
        working = true;
        StateHasChanged();

        try
        {
            var response = await Svc.AskAsync(BookId, msg, history);
            history.Add(new CoWriterMessage { Role = "assistant", Content = response.AssistantMessage });
        }
        catch (Exception ex)
        {
            history.Add(new CoWriterMessage { Role = "assistant", Content = $"(Error: {ex.Message})" });
        }
        finally
        {
            working = false;
            StateHasChanged();
        }
    }
}
