@* Single-entity Google Maps marker — used on entity detail pages with coordinates. *@
@inject SettingsService Settings
@inject IJSRuntime JS
@implements IDisposable

@if (HasCoords)
{
    @if (!string.IsNullOrWhiteSpace(Settings.GoogleMapsApiKey))
    {
        <div id="@mapId" class="geo-map-container" style="height:@Height;"></div>
    }
    else
    {
        <div class="geo-map-placeholder text-muted small">
            <i class="bi bi-geo-alt"></i>
            @Lat.ToString("F4"), @Lng.ToString("F4")
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public double Lat { get; set; }
    [Parameter, EditorRequired] public double Lng { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Height { get; set; } = "260px";

    private string mapId = "geomap-" + Guid.NewGuid().ToString("N")[..8];
    private bool HasCoords => Lat != 0 || Lng != 0;
    private bool rendered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && HasCoords && !string.IsNullOrWhiteSpace(Settings.GoogleMapsApiKey))
        {
            rendered = true;
            await JS.InvokeVoidAsync("geoMap.show", mapId, Settings.GoogleMapsApiKey, Lat, Lng, Title);
        }
    }

    public void Dispose()
    {
        if (rendered)
        {
            try { JS.InvokeVoidAsync("geoMap.destroy", mapId); } catch { }
        }
    }
}
