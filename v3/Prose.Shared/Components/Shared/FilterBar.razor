@* Unified filter bar: text input + tag chips in a single control.
   Usage: <FilterBar AllTags="allTags" @bind-Filter="filter" SelectedTags="selectedTags" SelectedTagsChanged="OnTagsChanged" /> *@

<div class="filter-bar" @onfocusout="HandleFocusOut" tabindex="-1">
    <div class="filter-bar-inner">
        @foreach (var tag in SelectedTags.OrderBy(t => t))
        {
            var t = tag;
            <span class="filter-chip" @onclick="() => RemoveTag(t)" @onclick:stopPropagation="true">
                @t <i class="bi bi-x"></i>
            </span>
        }
        <input class="filter-bar-input"
               type="text"
               placeholder="@(SelectedTags.Count == 0 ? "Filter..." : "Add tag...")"
               value="@Filter"
               @oninput="OnInput"
               @onfocus="OnFocus" />
    </div>
    @if (showDropdown && SuggestedTags.Any())
    {
        <div class="filter-bar-dropdown" @onclick:stopPropagation="true">
            @foreach (var tag in SuggestedTags)
            {
                var tagName = tag.name;
                <div class="filter-bar-suggestion" @onclick="() => AddTag(tagName)">
                    <span>@tag.name</span>
                    <span class="filter-bar-count">@tag.count</span>
                </div>
            }
        </div>
    }
</div>

<style>
    .filter-bar { position: relative; }
    .filter-bar-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 3px; background: #0d1117; border: 1px solid #30363d; border-radius: 5px; padding: 1px 7px; min-height: 24px; cursor: text; }
    .filter-bar-inner:focus-within { border-color: #58a6ff; box-shadow: 0 0 0 1px rgba(88,166,255,0.15); }
    .filter-bar-input { flex: 1; min-width: 80px; background: transparent; border: none; color: #e6edf3; font-size: 0.78rem; outline: none; padding: 0; line-height: 1.4; }
    .filter-bar-input::placeholder { color: #8b949e; }
    .filter-chip { background: #dc3545; color: #fff; border-radius: 10px; padding: 1px 7px; font-size: 0.7rem; cursor: pointer; display: inline-flex; align-items: center; gap: 3px; white-space: nowrap; user-select: none; }
    .filter-chip:hover { opacity: 0.8; }
    .filter-chip i { font-size: 0.6rem; }
    .filter-bar-dropdown { position: absolute; top: calc(100% + 3px); left: 0; right: 0; background: #161b22; border: 1px solid #30363d; border-radius: 6px; box-shadow: 0 6px 20px rgba(0,0,0,0.5); z-index: 9999; max-height: 240px; overflow-y: auto; }
    .filter-bar-suggestion { display: flex; align-items: center; justify-content: space-between; padding: 6px 12px; cursor: pointer; font-size: 0.8rem; color: #e6edf3; }
    .filter-bar-suggestion:hover { background: #1c2128; }
    .filter-bar-count { background: #30363d; color: #8b949e; border-radius: 8px; padding: 1px 6px; font-size: 0.65rem; min-width: 24px; text-align: center; }
</style>

@code {
    [Parameter] public List<(string name, int count)> AllTags { get; set; } = [];
    [Parameter] public string Filter { get; set; } = "";
    [Parameter] public EventCallback<string> FilterChanged { get; set; }
    [Parameter] public HashSet<string> SelectedTags { get; set; } = [];
    [Parameter] public EventCallback<HashSet<string>> SelectedTagsChanged { get; set; }

    private bool showDropdown;

    private IEnumerable<(string name, int count)> SuggestedTags =>
        AllTags
            .Where(t => t.count >= 2 && !SelectedTags.Contains(t.name))
            .Where(t => !string.IsNullOrWhiteSpace(Filter) && t.name.Contains(Filter, StringComparison.OrdinalIgnoreCase))
            .Take(8);

    private async Task OnInput(ChangeEventArgs e)
    {
        var val = e.Value?.ToString() ?? "";
        await FilterChanged.InvokeAsync(val);
        showDropdown = !string.IsNullOrWhiteSpace(val);
    }

    private void OnFocus()
    {
        if (!string.IsNullOrWhiteSpace(Filter))
            showDropdown = true;
    }

    private async Task AddTag(string tag)
    {
        SelectedTags.Add(tag);
        await SelectedTagsChanged.InvokeAsync(SelectedTags);
        await FilterChanged.InvokeAsync("");
        showDropdown = false;
    }

    private async Task RemoveTag(string tag)
    {
        SelectedTags.Remove(tag);
        await SelectedTagsChanged.InvokeAsync(SelectedTags);
    }

    private async Task HandleFocusOut()
    {
        await Task.Delay(200);
        showDropdown = false;
        await InvokeAsync(StateHasChanged);
    }
}
