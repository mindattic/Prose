@if (Visible)
{
    @if (Overlay)
    {
        <div style="position: fixed; inset: 0; background: rgba(13,17,23,0.85); z-index: 9999; display: flex; align-items: center; justify-content: center;">
            <div class="text-center">
                <div class="spinner-border text-danger" style="width: 4rem; height: 4rem;" role="status"></div>
                @if (!string.IsNullOrEmpty(Message))
                {
                    <div class="text-muted mt-3 small">@Message</div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="d-flex align-items-center gap-2 text-muted">
            <div class="spinner-border spinner-border-sm" role="status"></div>
            <span class="small">@Message</span>
        </div>
    }
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public bool Overlay { get; set; }
    [Parameter] public string Message { get; set; } = Constants.Defaults.Loading;
}
