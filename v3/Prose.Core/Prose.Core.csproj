<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- EF1002/EF1003: all raw-SQL call sites use SQL identifiers, temporal table syntax,
         or DDL that cannot be parameterized — suppressed project-wide after audit 2026-07-02. -->
    <NoWarn>$(NoWarn);EF1002;EF1003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <PackageReference Include="Markdig" Version="1.1.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <!-- Direct override: Microsoft.Data.Sqlite 10.0.9 floors SQLitePCLRaw.bundle_e_sqlite3 at
         2.1.11, which is vulnerable to CVE-2025-6965 (CVSS 9.8, a SQLite aggregate-term memory
         corruption bug fixed upstream in SQLite 3.50.2). Pinning a direct reference to a patched
         version wins NuGet's transitive version resolution (highest requested version wins).
         Confirmed 2026-08-09 via dotnet's package vulnerability check. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.10" />
    <PackageReference Include="MindAttic.Media" Version="1.0.0" />
    <PackageReference Include="MindAttic.Media.Azure" Version="1.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="MindAttic.Legion" Version="23.0.0" />
    <PackageReference Include="MindAttic.Vault" Version="1.0.0" />
    <PackageReference Include="MindAttic.Authentication" Version="2.0.0" />
    <PackageReference Include="QuestPDF" Version="2026.5.0" />
    <PackageReference Include="QuikGraph" Version="2.5.0" />
    <PackageReference Include="QuikGraph.Serialization" Version="2.5.0" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="System.Speech" Version="10.0.9" />
  </ItemGroup>

</Project>


