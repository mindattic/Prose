@page "/species"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@using Microsoft.AspNetCore.Authorization
@using Prose.Core.Data.Entities
@using Prose.Core.Services
@inject SpeciesRepository Repo

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <div class="small text-muted mb-1">
            <a href="/" class="text-muted text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Home</a>
        </div>
        <h4 class="text-info mb-0"><i class="bi bi-diagram-3 me-2"></i>Species</h4>
        <p class="small text-muted mb-0">
            The first-class species taxonomy for sentient life. Non-sentient machines are Automata,
            not species. GLMZ defines exactly five; other universes may extend the set.
        </p>
    </div>
</div>

<div class="row g-3">
    @foreach (var s in species)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card bg-dark text-light border-secondary h-100">
                <div class="card-header border-secondary d-flex align-items-center justify-content-between">
                    <span class="fw-semibold">@s.Label</span>
                    <code class="small text-muted">@s.Name</code>
                </div>
                <div class="card-body">
                    <p class="small mb-2">@s.Description</p>
                    @if (!string.IsNullOrWhiteSpace(s.Examples))
                    {
                        <div class="small text-muted">
                            <i class="bi bi-people me-1"></i><em>Examples:</em> @s.Examples
                        </div>
                    }
                </div>
                <div class="card-footer border-secondary d-flex gap-2">
                    @if (s.Sentient)
                    {
                        <span class="badge bg-info text-dark">Sentient</span>
                    }
                    @if (s.UniverseId != Guid.Empty)
                    {
                        <span class="badge bg-secondary" title="Universe ID: @s.UniverseId">Universe-scoped</span>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (species.Count == 0)
{
    <div class="alert alert-secondary small py-2 mt-3">
        No species found — run <code>ss --seed</code> to load the canonical five.
    </div>
}

@code {
    private List<Prose.Core.Data.Entities.Species> species = new();

    protected override void OnInitialized()
        => species = Repo.GetAll();
}
