@page "/entity/stub/{Slug}"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@using Prose.Core.Models.Canon
@using Prose.Core.Services
@inject CharacterRepository Characters
@inject DistrictRepository Districts
@inject FactionRepository Factions
@inject WeaponryRepository Weapons
@inject EquipmentRepository Equipment
@inject WorldGraphService Graph
@inject WorldStateService World
@inject NavigationManager Nav

<div class="container py-3" style="max-width: 720px;">
    <div class="card bg-dark text-light border-warning">
        <div class="card-header border-warning">
            <h5 class="text-warning mb-0"><i class="bi bi-question-octagon me-2"></i>Stub: @CleanName</h5>
        </div>
        <div class="card-body">
            <p class="small text-muted mb-3">
                A wiki link pointed here, but no canon entity matches the slug <code>@Slug</code>.
                Pick a kind to scaffold a stub record. The dossier will pick it up immediately.
            </p>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger small">@error</div>
            }

            <div class="d-flex flex-column gap-2">
                <button class="btn btn-outline-info" @onclick="CreateCharacter">
                    <i class="bi bi-person-plus me-1"></i> Create stub <strong>character</strong> named "@CleanName"
                </button>
                <button class="btn btn-outline-info" @onclick="CreatePlace">
                    <i class="bi bi-geo-alt me-1"></i> Create stub <strong>place</strong> named "@CleanName"
                </button>
                <button class="btn btn-outline-info" @onclick="CreateFaction">
                    <i class="bi bi-people-fill me-1"></i> Create stub <strong>faction</strong> named "@CleanName"
                </button>
                <button class="btn btn-outline-info" @onclick="CreateWeapon">
                    <i class="bi bi-asterisk me-1"></i> Create stub <strong>weapon</strong> named "@CleanName"
                </button>
                <button class="btn btn-outline-info" @onclick="CreateEquipment">
                    <i class="bi bi-tools me-1"></i> Create stub <strong>equipment</strong> named "@CleanName"
                </button>
            </div>

            <hr class="border-secondary my-3" />
            <div class="small text-muted">
                Cancel and go back: <a href="javascript:history.back()" class="text-info">return</a>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private string CleanName => string.IsNullOrEmpty(Slug)
        ? ""
        : System.Globalization.CultureInfo.InvariantCulture.TextInfo
            .ToTitleCase(Slug.Replace('_', ' ').Replace('-', ' '));

    private string error = "";

    private void CreateCharacter()
    {
        try
        {
            var stub = new CharacterData
            {
                Name = CleanName,
                Description = "Stub auto-created from a wiki link. Fill in canon details.",
                Status = "alive",
                Tags = new() { "stub", "needs-review" },
            };
            Characters.Save(stub);
            Graph.EnsureFresh();
            World.InvalidateAll();
            Nav.NavigateTo($"/entity/{stub.Id}");
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private void CreatePlace()
    {
        try
        {
            var stub = new DistrictData { Name = CleanName, Description = "Stub auto-created from a wiki link." };
            Districts.Save(stub);
            Graph.EnsureFresh();
            World.InvalidateAll();
            Nav.NavigateTo($"/entity/{stub.Id}");
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private void CreateFaction()
    {
        try
        {
            var stub = new FactionData { Name = CleanName, Description = "Stub auto-created from a wiki link." };
            Factions.Save(stub);
            Graph.EnsureFresh();
            World.InvalidateAll();
            Nav.NavigateTo($"/entity/{stub.Id}");
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private void CreateWeapon()
    {
        try
        {
            var stub = new WeaponryData { Name = CleanName, Description = "Stub auto-created from a wiki link." };
            Weapons.Save(stub);
            Graph.EnsureFresh();
            World.InvalidateAll();
            Nav.NavigateTo($"/entity/{stub.Id}");
        }
        catch (Exception ex) { error = ex.Message; }
    }

    private void CreateEquipment()
    {
        try
        {
            var stub = new EquipmentData { Name = CleanName, Description = "Stub auto-created from a wiki link." };
            Equipment.Save(stub);
            Graph.EnsureFresh();
            World.InvalidateAll();
            Nav.NavigateTo($"/entity/{stub.Id}");
        }
        catch (Exception ex) { error = ex.Message; }
    }
}
