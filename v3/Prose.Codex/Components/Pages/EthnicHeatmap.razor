@page "/heritage"
@inject CharacterRepository CharRepo
@inject IJSRuntime JS

<h4 class="text-danger mb-1">Genetic Ancestry Heatmap</h4>
<p class="text-muted mb-3">23andMe-style genetic ancestry across @totalCharacters people in the GLMZ. Based on demographic projections for a 2226 megacity. Click a region to drill down into sub-groups.</p>

<div class="row g-3 mb-3">
    <div class="col-auto">
        <span class="badge bg-secondary">@totalCharacters people</span>
        <span class="badge bg-secondary">@uniqueGroups ancestry groups</span>
        <span class="badge bg-danger">Weighted by genetic percentage per person</span>
    </div>
</div>

<div id="heritage-treemap" style="width:100%; min-height:500px; background:#161b22; border-radius:8px; border:1px solid #30363d;"></div>

@if (heritageData.Count > 0)
{
    <div class="mt-3">
        <h6 class="text-muted">Heritage Groups</h6>
        <table class="table table-sm table-dark">
            <thead><tr><th>Heritage</th><th class="text-end">References</th><th class="text-end">%</th><th>Bar</th></tr></thead>
            <tbody>
                @foreach (var h in heritageData)
                {
                    <tr>
                        <td class="text-light">@h.name</td>
                        <td class="text-end text-muted">@h.value</td>
                        <td class="text-end text-muted">@h.pct%</td>
                        <td style="width:200px;">
                            <div style="background:#dc3545; height:12px; border-radius:3px; width:@(h.value * 100 / heritageData[0].value)%"></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<HeritageEntry> heritageData = [];
    private List<TopRegionEntry> hierarchy = [];
    private int totalCharacters;
    private int totalReferences;
    private int uniqueGroups;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ParseHeritages();
            StateHasChanged();
            await Task.Delay(100);
            await JS.InvokeVoidAsync("heritageTreemap.render", "heritage-treemap", hierarchy);
        }
    }

    private void ParseHeritages()
    {
        // Accumulate three-tier ancestry_detail across all characters
        // Structure: region → sub-region → nationality → total weight
        var regionTotals = new Dictionary<string, double>(StringComparer.OrdinalIgnoreCase);
        var subRegionTotals = new Dictionary<string, Dictionary<string, double>>(StringComparer.OrdinalIgnoreCase);
        var nationalityTotals = new Dictionary<string, Dictionary<string, Dictionary<string, double>>>(StringComparer.OrdinalIgnoreCase);

        var characters = CharRepo.GetAll();
        totalCharacters = characters.Count;

        foreach (var c in characters)
        {
            var detail = c.AncestryDetail;
            if (detail == null || detail.Count == 0)
            {
                // Fall back to flat genetic_ancestry for characters without detail
                var flat = c.GeneticAncestry;
                if (flat == null || flat.Count == 0) continue;
                foreach (var (region, pct) in flat)
                {
                    if (pct <= 0) continue;
                    regionTotals[region] = regionTotals.GetValueOrDefault(region) + pct;
                }
                continue;
            }

            foreach (var (region, subRegions) in detail)
            {
                foreach (var (subRegion, nationalities) in subRegions)
                {
                    foreach (var (nationality, pct) in nationalities)
                    {
                        if (pct <= 0) continue;

                        // Region totals
                        regionTotals[region] = regionTotals.GetValueOrDefault(region) + pct;

                        // Sub-region totals
                        if (!subRegionTotals.ContainsKey(region))
                            subRegionTotals[region] = new(StringComparer.OrdinalIgnoreCase);
                        subRegionTotals[region][subRegion] = subRegionTotals[region].GetValueOrDefault(subRegion) + pct;

                        // Nationality totals
                        if (!nationalityTotals.ContainsKey(region))
                            nationalityTotals[region] = new(StringComparer.OrdinalIgnoreCase);
                        if (!nationalityTotals[region].ContainsKey(subRegion))
                            nationalityTotals[region][subRegion] = new(StringComparer.OrdinalIgnoreCase);
                        nationalityTotals[region][subRegion][nationality] =
                            nationalityTotals[region][subRegion].GetValueOrDefault(nationality) + pct;
                    }
                }
            }
        }

        var totalWeight = regionTotals.Values.Sum();
        uniqueGroups = regionTotals.Count;
        totalReferences = (int)totalWeight;

        // Build flat list for the table
        heritageData = regionTotals
            .OrderByDescending(kv => kv.Value)
            .Select(kv => new HeritageEntry
            {
                name = kv.Key,
                value = (int)Math.Round(kv.Value),
                pct = totalWeight > 0 ? (kv.Value * 100.0 / totalWeight).ToString("F1") : "0"
            })
            .ToList();

        // Build three-tier hierarchy for the treemap
        hierarchy = regionTotals
            .OrderByDescending(kv => kv.Value)
            .Select(kv =>
            {
                var regionName = kv.Key;
                var regionValue = (int)Math.Round(kv.Value);

                // Build sub-region entries with nationality drill-down
                var subs = subRegionTotals.GetValueOrDefault(regionName)?
                    .OrderByDescending(s => s.Value)
                    .Select(s =>
                    {
                        var nats = nationalityTotals
                            .GetValueOrDefault(regionName)?
                            .GetValueOrDefault(s.Key)?
                            .OrderByDescending(n => n.Value)
                            .Select(n => new HeritageEntry
                            {
                                name = n.Key,
                                value = (int)Math.Round(n.Value),
                                pct = totalWeight > 0 ? (n.Value * 100.0 / totalWeight).ToString("F1") : "0"
                            })
                            .ToList() ?? [];

                        return new RegionEntry
                        {
                            name = s.Key,
                            value = (int)Math.Round(s.Value),
                            pct = totalWeight > 0 ? (s.Value * 100.0 / totalWeight).ToString("F1") : "0",
                            subGroups = nats.Count > 1 ? nats : []
                        };
                    })
                    .ToList() ?? [];

                return new TopRegionEntry
                {
                    name = regionName,
                    value = regionValue,
                    pct = totalWeight > 0 ? (kv.Value * 100.0 / totalWeight).ToString("F1") : "0",
                    subGroups = subs.Count > 1 ? subs : []
                };
            })
            .ToList();
    }

    private record HeritageEntry
    {
        public string name { get; init; } = "";
        public int value { get; init; }
        public string pct { get; init; } = "0";
    }

    private record RegionEntry
    {
        public string name { get; init; } = "";
        public int value { get; init; }
        public string pct { get; init; } = "0";
        public List<HeritageEntry> subGroups { get; init; } = [];
    }

    private record TopRegionEntry
    {
        public string name { get; init; } = "";
        public int value { get; init; }
        public string pct { get; init; } = "0";
        public List<RegionEntry> subGroups { get; init; } = [];
    }
}
