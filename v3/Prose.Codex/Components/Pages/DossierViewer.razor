@page "/dossier/{EntityId}"
@inject NavigationManager Nav

@* Legacy route. The dossier now lives as a tab on /entity/{id}. *@
<div class="container py-3 small text-muted">
    <i class="bi bi-arrow-right-circle me-1"></i> Redirecting to the dossier tab on the entity page…
</div>

@code {
    [Parameter] public string EntityId { get; set; } = "";
    [SupplyParameterFromQuery(Name = "asOf")] public int? AsOf { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        var query = AsOf.HasValue ? $"?tab=dossier&asOf={AsOf}" : "?tab=dossier";
        Nav.NavigateTo($"/entity/{EntityId}{query}", replace: true);
    }
}
