@page "/repo/{Slug}"
@using Microsoft.EntityFrameworkCore
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<Prose.Core.Data.ProseDbContext> DbFactory
@inject Prose.Core.Services.RepositoryDefinitionService RepoDefs

@* Generic listing for a runtime-defined repository (custom entity type). Lists the active entities
   of this type in the CURRENT universe (the EF query filter scopes by universe automatically), since
   custom types have no bespoke page. *@

<div class="container-fluid" style="padding:1rem;">
    @if (def == null)
    {
        <div class="text-muted">Unknown repository '<code>@Slug</code>'.</div>
    }
    else
    {
        <h3><i class="bi @def.Icon me-2"></i>@def.Name</h3>
        @if (!string.IsNullOrWhiteSpace(def.Description)) { <p class="text-muted">@def.Description</p> }

        @if (rows.Count == 0)
        {
            <div class="text-muted">No entities in this repository for the current universe yet.</div>
        }
        else
        {
            <div class="board-grid">
                @foreach (var e in rows)
                {
                    <a href="/entity/@e.Id" class="board-tile" title="@e.Description">
                        <i class="bi @def.Icon board-tile-icon"></i>
                        <div class="board-tile-name">@e.Name</div>
                    </a>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private Prose.Core.Data.Entities.RepositoryDefinition? def;
    private record Row(Guid Id, string Name, string? Description);
    private List<Row> rows = new();

    protected override void OnParametersSet()
    {
        def = RepoDefs.GetBySlug(Slug);
        rows = new();
        if (def == null) return;
        using var db = DbFactory.CreateDbContext();
        rows = db.Entities.AsNoTracking()
            .Where(e => e.EntityType == Slug && e.IsActive)
            .OrderBy(e => e.Name)
            .Select(e => new Row(e.Id, e.Name, e.Description))
            .ToList();
    }
}
