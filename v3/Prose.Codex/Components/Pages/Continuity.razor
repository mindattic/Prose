        background:#1c2128;
        border-bottom:1px solid #30363d;
        color:#c9d1d9;
    }
    .continuity-browse code { color:#ff7b72; background:transparent; }
    /* Bootstrap's table-warning is yellow-on-yellow inside table-dark — recolor for legibility */
    .continuity-browse > tbody > tr.table-warning,
    .continuity-browse > tbody > tr.table-warning > * {
        --bs-table-bg: rgba(255, 193, 7, .12);
        --bs-table-color: #ffe69c;
        background-color: var(--bs-table-bg);
        color: var(--bs-table-color);
    }
</style>

@code {
    private ContinuityStats stats = new();
    private List<ContradictionPair> contradictions = new();
    private List<ContradictionGroup> contradictionGroups = new();
    private List<ContinuityClaim> allClaims = new();
    private List<ContinuityClaim> pendingApply = new();
    private List<Prose.Core.Models.Book> books = new();
    private Dictionary<string, Prose.Core.Models.Chapter> chaptersById = new();

    private bool working;
    private string action = "";
    private string applyingUid = "";
    private string status = "";
    private string errorMessage = "";

    private string extractTarget = "";
    private string filter = "";
    private string? customOpenFor;
    private string customValue = "";

    // Wizard state — session-only, never persisted.
    private HashSet<string> wizardSkipped = new();
    private int wizardResolved;

    private ContradictionGroup? CurrentWizardGroup =>
        contradictionGroups.FirstOrDefault(g => !wizardSkipped.Contains(g.Key));

    private int WizardRemaining =>
        contradictionGroups.Count(g => !wizardSkipped.Contains(g.Key));

    protected override void OnInitialized()
    {
        books = BookRepo.ListBooks();
        chaptersById = ChapterRepo.ListChapters().ToDictionary(c => c.Id, c => c);
        Reload();
    }

    private void Reload()
    {
        stats               = Store.GetStats();
        contradictions      = Store.GetContradictions();
        contradictionGroups = Store.GetContradictionGroups();
        // Most-recent claims for browser (cap at a few hundred to keep render light)
        var pulled = new List<ContinuityClaim>();
        foreach (var s in new[] { "NEW", "CONFIRMED", "CONTRADICTED", "CANONICAL", "REJECTED", "SUPERSEDED" })
            pulled.AddRange(Store.GetByStatus(s));
        allClaims = pulled.OrderByDescending(c => c.LastConfirmedAt).Take(500).ToList();
        pendingApply = Store.GetByStatus("CANONICAL").Where(c => string.IsNullOrEmpty(c.AppliedAt)).ToList();
    }

    private List<ContinuityClaim> filtered()
    {
        if (string.IsNullOrWhiteSpace(filter)) return allClaims;
        return allClaims.Where(c => c.EntityName.Contains(filter, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private void MakeCanonical(string claimUid)
    {
        working = true; action = "canonical"; errorMessage = "";
        try
        {
            Store.MakeCanonical(claimUid, "Selected from contradiction-groups UI.");
            Reload();
            status = "Canonical claim set; siblings rejected.";
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { working = false; action = ""; }
    }

    private void RejectClaim(string claimUid)
    {
        working = true; action = "reject"; errorMessage = "";
        try
        {
            Store.RejectClaim(claimUid, "Rejected from contradiction-groups UI.");
            Reload();
            status = "Claim rejected.";
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { working = false; action = ""; }
    }

    private void WizardMakeCanonical(string claimUid)
    {
        working = true; action = "canonical"; errorMessage = "";
        try
        {
            Store.MakeCanonical(claimUid, "Selected from contradiction wizard.");
            wizardResolved++;
            Reload();
            status = "Resolved — siblings rejected automatically.";
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { working = false; action = ""; }
    }

    private void WizardRejectAll()
    {
        var g = CurrentWizardGroup;
        if (g is null) return;
        working = true; action = "reject-all"; errorMessage = "";
        try
        {
            foreach (var c in g.Claims)
                Store.RejectClaim(c.ClaimUid, "All values rejected from contradiction wizard.");
            wizardResolved++;
            Reload();
            status = $"All {g.Claims.Count} values rejected.";
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { working = false; action = ""; }
    }

    private void WizardSkip()
    {
        var g = CurrentWizardGroup;
        if (g is not null) wizardSkipped.Add(g.Key);
    }

    private void WizardShowSkipped() => wizardSkipped.Clear();

    private static string OptionColClass(int count) =>
        count <= 1 ? "col-12"
        : count == 3 ? "col-md-4"
        : "col-md-6";

    private static string ConflictQuestion(ContradictionGroup g)
    {
        var name = string.IsNullOrWhiteSpace(g.EntityName) ? "this entity" : g.EntityName;
        var pred = (g.Predicate ?? "").ToLowerInvariant();
        return pred switch
        {
            "age"               => $"What is {name}'s age?",
            "name"              => $"What is {name}'s name?",
            "build"             => $"What is {name}'s build?",
            "height"            => $"What is {name}'s height?",
            "weight"            => $"What is {name}'s weight?",
            "eye_color" or "eyes" => $"What colour are {name}'s eyes?",
            "hair" or "hair_color" => $"What is {name}'s hair?",
            "employment"        => $"What is {name}'s employment?",
            "occupation"        => $"What is {name}'s occupation?",
            "knowledge"         => $"What does {name} know?",
            "location"          => $"Where is {name}?",
            "home_turf" or "hometurf" => $"Where is {name}'s home turf?",
            "affiliation"       => $"What is {name}'s affiliation?",
            "status"            => $"What is {name}'s status?",
            "relationship"      => $"What is {name}'s relationship?",
            _                   => $"What is {name}'s {pred.Replace('_', ' ')}?"
        };
    }

    private async Task RunExtraction()
    {
        if (string.IsNullOrEmpty(extractTarget)) return;
        working = true; action = "extract"; status = "Running extraction (this can take a while)…"; errorMessage = "";
        try
        {
            if (extractTarget.StartsWith("chapter:"))
            {
                var cid = extractTarget["chapter:".Length..];
                var r = await Extract.ExtractFromChapterAsync(cid);
                status = $"Done. {r.NewClaims} new, {r.ConfirmedClaims} confirmed, {r.ContradictedClaims} new contradictions, {r.UnknownEntities.Count} unknown entity references.";
            }
            else if (extractTarget.StartsWith("book:"))
            {
                var bid = extractTarget["book:".Length..];
                var book = BookRepo.LoadBook(bid);
                if (book == null) throw new InvalidOperationException("Book not found");
                var rs = await Extract.ExtractFromBookAsync(book);
                var n = rs.Sum(r => r.NewClaims);
                var cf = rs.Sum(r => r.ConfirmedClaims);
                var ct = rs.Sum(r => r.ContradictedClaims);
                status = $"Book extraction done. {n} new, {cf} confirmed, {ct} new contradictions across {rs.Count} chapters.";
            }
            Reload();
        }
        catch (Exception ex)
        {
            errorMessage = "Extraction error: " + ex.Message;
            status = "";
        }
        finally
        {
            working = false; action = ""; StateHasChanged();
        }
    }

    private void OpenCustom(ContradictionPair pair)
    {
        customOpenFor = pair.A.ClaimUid + "|" + pair.B.ClaimUid;
        customValue = "";
    }

    private async Task DoResolve(ContradictionPair pair, string winner, string? customObj)
    {
        if (winner == "custom" && string.IsNullOrWhiteSpace(customObj)) { errorMessage = "Custom requires a value."; return; }
        working = true; action = "resolve"; errorMessage = "";
        try
        {
            await Task.Run(() => Store.Resolve(pair.A.ClaimUid, pair.B.ClaimUid, winner, customObj ?? "", ""));
            customOpenFor = null;
            customValue = "";
            status = $"Resolved {pair.A.EntityName}.{pair.A.Predicate} (winner: {winner}).";
            Reload();
        }
        catch (Exception ex)
        {
            errorMessage = "Resolve error: " + ex.Message;
        }
        finally
        {
            working = false; action = ""; StateHasChanged();
        }
    }

    private async Task DoApply(ContinuityClaim claim)
    {
        working = true; action = "apply"; applyingUid = claim.ClaimUid; errorMessage = "";
        try
        {
            var r = await Apply.ApplyAsync(claim.ClaimUid);
            if (r.Ok)
            {
                status = $"Applied to {Path.GetFileName(r.EntityFile)} → {r.FieldPath} (confidence {r.DecisionConfidence:P0}).";
                Reload();
            }
            else
            {
                errorMessage = "Apply failed: " + r.Error;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Apply error: " + ex.Message;
        }
        finally
        {
            working = false; action = ""; applyingUid = ""; StateHasChanged();
        }
    }

    private static string SourceLabel(ContinuityClaim c)
    {
        return c.SourceType switch
        {
            "prose"           => $"prose ch.{c.SourceChapterNumber}",
            "entity_record"   => $"record {Path.GetFileName(c.SourcePath ?? "")}",
            "writer_assertion" => "writer",
            _                 => c.SourceType,
        };
    }

    private static string StatusClass(string s) => s switch
    {
        "CONTRADICTED" => "table-warning",
        "REJECTED"     => "text-muted",
        "SUPERSEDED"   => "text-muted",
        _              => "",
    };

    private static string StatusBadge(string s) => s switch
    {
        "CANONICAL"    => "bg-success",
        "CONFIRMED"    => "bg-success bg-opacity-50",
        "NEW"          => "bg-info",
        "CONTRADICTED" => "bg-warning text-dark",
        "REJECTED"     => "bg-secondary",
        "SUPERSEDED"   => "bg-secondary",
        _              => "bg-light text-dark",
    };
}
