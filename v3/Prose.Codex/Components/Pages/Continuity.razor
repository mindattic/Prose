@page "/continuity"
@attribute [Authorize(Policy = MaPolicies.Admin)]
@using Prose.Core.Interfaces
@using Prose.Core.Services
@using MindAttic.Legion
@inject ContinuityService Store
@inject ContinuityExtractionService Extract
@inject ContinuityApplyService Apply
@inject IChapterRepository ChapterRepo
@inject IBookRepository BookRepo
@inject NavigationManager Nav

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <div class="small text-muted mb-1">
            <a href="/" class="text-muted text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Home</a>
        </div>
        <h4 class="text-info mb-0"><i class="bi bi-database-check me-2"></i>Continuity</h4>
        <p class="small text-muted mb-0">
            One store of atomic claims about every entity, extracted from prose and entity records. Find contradictions, resolve them, and apply the truth back to the entity.
        </p>
    </div>
    <div class="d-flex flex-column gap-2 align-items-end">
        <div class="d-flex gap-2 align-items-center">
            <select class="form-select form-select-sm bg-dark text-light border-secondary continuity-extract-select" style="width:280px;" @bind="extractTarget">
                <option value="">— pick a book or chapter to extract —</option>
                @foreach (var b in books)
                {
                    <option value="@($"book:{b.Id}")">📚 @b.Title</option>
                    @foreach (var cid in b.ChapterIds ?? new())
                    {
                        var c = chaptersById.GetValueOrDefault(cid);
                        if (c != null)
                        {
                            <option value="@($"chapter:{c.Id}")">  └─ ch.@c.Number @c.Title</option>
                        }
                    }
                }
            </select>
            <button class="btn btn-sm btn-outline-primary" disabled="@(working || string.IsNullOrEmpty(extractTarget))"
                    @onclick="RunExtraction">
                @(working && action == "extract" ? "extracting…" : "Extract")
            </button>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(status))
{
    <div class="alert alert-info small py-2">@status</div>
}
@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger small py-2">@errorMessage</div>
}

@* ── Stats strip ─────────────────────────────────────────── *@
<div class="row g-2 mb-3">
    <div class="col"><div class="continuity-stat"><div class="lbl">Total</div><div class="val text-info">@stats.Total</div></div></div>
    <div class="col"><div class="continuity-stat"><div class="lbl">New</div><div class="val text-info">@stats.New</div></div></div>
    <div class="col"><div class="continuity-stat"><div class="lbl">Confirmed</div><div class="val text-success">@stats.Confirmed</div></div></div>
    <div class="col"><div class="continuity-stat"><div class="lbl">Contradicted</div><div class="val text-warning">@stats.Contradicted</div></div></div>
    <div class="col"><div class="continuity-stat"><div class="lbl">Canonical</div><div class="val text-success">@stats.Canonical</div></div></div>
    <div class="col"><div class="continuity-stat"><div class="lbl">Rejected</div><div class="val text-muted">@stats.Rejected</div></div></div>
    <div class="col"><div class="continuity-stat"><div class="lbl">From prose</div><div class="val">@stats.FromProse</div></div></div>
    <div class="col"><div class="continuity-stat"><div class="lbl">From record</div><div class="val">@stats.FromEntityRecord</div></div></div>
</div>

@* ── Conflicting-claims wizard (one group at a time) ───────── *@
@{
    var wizardCurrent = CurrentWizardGroup;
    var wizardTotal = wizardResolved + contradictionGroups.Count;
    var wizardPct = wizardTotal == 0 ? 0 : (int)Math.Round(100.0 * wizardResolved / wizardTotal);
}
@if (wizardCurrent is not null)
{
    <div class="card bg-dark text-light mb-3 border-warning continuity-wizard">
        <div class="card-header bg-warning bg-opacity-25 border-warning d-flex justify-content-between align-items-center">
            <strong><i class="bi bi-exclamation-diamond me-1"></i>Conflicting claims</strong>
            <span class="small text-muted">
                Decided <strong class="text-success">@wizardResolved</strong>
                · Left <strong class="text-warning">@WizardRemaining</strong>
                @if (wizardSkipped.Count > 0)
                {
                    <text> · Skipped <strong>@wizardSkipped.Count</strong></text>
                }
            </span>
        </div>
        <div class="card-body">
            <div class="progress mb-3" style="height:6px;background:#1c2128;">
                <div class="progress-bar bg-success" role="progressbar" style="width:@wizardPct%"></div>
            </div>

            <h5 class="mb-1">@ConflictQuestion(wizardCurrent)</h5>
            <p class="small text-muted mb-3">
                @wizardCurrent.Claims.Count passages disagree — pick the true one.
                Picking one resolves the rest automatically.
            </p>

            <div class="row g-3">
                @foreach (var c in wizardCurrent.Claims)
                {
                    <div class="@OptionColClass(wizardCurrent.Claims.Count)">
                        <div class="continuity-wizard-option h-100 d-flex flex-column">
                            <div class="small text-muted mb-1">
                                @c.SourceType
                                @if (!string.IsNullOrEmpty(c.SourceChapterTitle))
                                {
                                    <span> · ch.@c.SourceChapterNumber @c.SourceChapterTitle</span>
                                }
                            </div>
                            <div class="fw-bold fs-6 mb-1">@c.Object</div>
                            @if (!string.IsNullOrEmpty(c.Snippet))
                            {
                                <div class="small fst-italic text-muted flex-grow-1">"@c.Snippet"</div>
                            }
                            else
                            {
                                <div class="flex-grow-1"></div>
                            }
                            <button class="btn btn-success mt-3 w-100" disabled="@working"
                                    @onclick="@(() => WizardMakeCanonical(c.ClaimUid))">
                                <i class="bi bi-check2 me-1"></i>This is true
                            </button>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <button class="btn btn-sm btn-outline-danger" disabled="@working"
                        @onclick="WizardRejectAll">
                    <i class="bi bi-x-circle me-1"></i>None of these — reject all
                </button>
                <div class="d-flex gap-2 align-items-center">
                    @if (wizardSkipped.Count > 0)
                    {
                        <button class="btn btn-sm btn-link text-muted text-decoration-none" @onclick="WizardShowSkipped">
                            Show @wizardSkipped.Count skipped
                        </button>
                    }
                    <button class="btn btn-sm btn-outline-secondary" disabled="@working"
                            @onclick="WizardSkip">
                        Skip <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
}
else if (contradictionGroups.Count > 0 && wizardSkipped.Count > 0)
{
    @* All remaining groups are skipped this session *@
    <div class="alert alert-info small py-2 d-flex justify-content-between align-items-center mb-3">
        <span>
            <i class="bi bi-skip-forward me-1"></i>
            You skipped @wizardSkipped.Count conflict@(wizardSkipped.Count == 1 ? "" : "s") this session.
            Decided @wizardResolved.
        </span>
        <button class="btn btn-sm btn-outline-info" @onclick="WizardShowSkipped">
            Bring them back
        </button>
    </div>
}

@* ── Contradictions panel ─────────────────────────────────── *@
@if (contradictions.Count > 0)
{
    <div class="card bg-dark text-light mb-3 border-warning">
        <div class="card-header bg-warning bg-opacity-25 border-warning d-flex justify-content-between align-items-center">
            <strong><i class="bi bi-exclamation-triangle me-1"></i>Unresolved contradictions</strong>
            <span class="badge bg-warning text-dark">@contradictions.Count</span>
        </div>
        <div class="card-body">
            @foreach (var pair in contradictions)
            {
                <div class="border border-secondary rounded p-2 mb-2">
                    <div class="small text-muted mb-1">
                        <strong>@pair.A.EntityName</strong>
                        <span class="ms-2">predicate: <code>@pair.A.Predicate</code></span>
                    </div>
                    <div class="row g-2">
                        <div class="col-md-5">
                            <div class="border border-secondary rounded p-2 h-100">
                                <div class="small text-muted">A · @SourceLabel(pair.A) · by @string.Join(", ", pair.A.ExtractedBy)</div>
                                <div class="fw-bold">@pair.A.Object</div>
                                @if (!string.IsNullOrEmpty(pair.A.Snippet))
                                {
                                    <div class="small fst-italic text-muted">"@pair.A.Snippet"</div>
                                }
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="border border-secondary rounded p-2 h-100">
                                <div class="small text-muted">B · @SourceLabel(pair.B) · by @string.Join(", ", pair.B.ExtractedBy)</div>
                                <div class="fw-bold">@pair.B.Object</div>
                                @if (!string.IsNullOrEmpty(pair.B.Snippet))
                                {
                                    <div class="small fst-italic text-muted">"@pair.B.Snippet"</div>
                                }
                            </div>
                        </div>
                        <div class="col-md-2 d-flex flex-column gap-1">
                            <button class="btn btn-sm btn-outline-success py-0" disabled="@working"
                                    @onclick="@(() => DoResolve(pair, "A", null))">A wins</button>
                            <button class="btn btn-sm btn-outline-success py-0" disabled="@working"
                                    @onclick="@(() => DoResolve(pair, "B", null))">B wins</button>
                            <button class="btn btn-sm btn-outline-info py-0" disabled="@working"
                                    @onclick="@(() => OpenCustom(pair))">Custom…</button>
                        </div>
                    </div>
                    @if (customOpenFor == pair.Key)
                    {
                        <div class="mt-2">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">@pair.A.Predicate =</span>
                                <input class="form-control" @bind="customValue" placeholder="agreed-upon value" />
                                <button class="btn btn-success" disabled="@(working || string.IsNullOrWhiteSpace(customValue))"
                                        @onclick="@(() => DoResolve(pair, "custom", customValue))">Save</button>
                                <button class="btn btn-outline-secondary" @onclick="@(() => customOpenFor = null)">Cancel</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
else if (stats.Total > 0 && contradictionGroups.Count == 0)
{
    <div class="alert alert-success small py-2">
        <i class="bi bi-check-circle me-1"></i>No unresolved contradictions.
    </div>
}

@* ── Canonical claims awaiting apply ────────────────────── *@
@if (pendingApply.Count > 0)
{
    <div class="card bg-dark text-light mb-3 border-info">
        <div class="card-header bg-info bg-opacity-25 border-info d-flex justify-content-between align-items-center">
            <strong><i class="bi bi-arrow-right-circle me-1"></i>Canonical claims ready to apply to entity records</strong>
            <span class="badge bg-info">@pendingApply.Count</span>
        </div>
        <div class="card-body p-0">
            <table class="table table-sm table-dark table-hover small mb-0">
                <thead><tr><th>Entity</th><th>Predicate</th><th>Value</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in pendingApply)
                    {
                        <tr>
                            <td>@c.EntityName <span class="text-muted">(@c.EntityKind)</span></td>
                            <td><code>@c.Predicate</code></td>
                            <td>@c.Object</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-info py-0" disabled="@working"
                                        @onclick="() => DoApply(c)">
                                    @(working && applyingUid == c.ClaimUid ? "applying…" : "Apply")
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* ── Per-entity browser ─────────────────────────────────── *@
<div class="card continuity-browse-card border-secondary">
    <div class="card-header continuity-browse-header border-secondary d-flex justify-content-between align-items-center">
        <strong><i class="bi bi-search me-1"></i>Browse claims</strong>
        <input type="text" class="form-control form-control-sm continuity-filter-input" style="width:240px;"
               placeholder="filter by entity name…" @bind="filter" @bind:event="oninput" />
    </div>
    <div class="card-body p-0 continuity-browse-body" style="max-height:540px;overflow-y:auto;">
        @{
            var visible = filtered();
        }
        @if (visible.Count == 0)
        {
            <div class="text-muted text-center py-4 small">No claims match.</div>
        }
        else
        {
            <table class="table table-sm table-dark table-hover small mb-0 continuity-browse">
                <thead class="sticky-top">
                    <tr>
                        <th>Entity</th>
                        <th>Predicate</th>
                        <th>Value</th>
                        <th>Source</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in visible)
                    {
                        <tr class="@StatusClass(c.Status)">
                            <td>@c.EntityName <span class="text-muted small">(@c.EntityKind)</span></td>
                            <td><code>@c.Predicate</code></td>
                            <td>@c.Object</td>
                            <td class="small text-muted">@SourceLabel(c)</td>
                            <td><span class="badge @StatusBadge(c.Status)">@c.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<style>
    .continuity-stat { background:#1c2128; border-radius:4px; padding:8px 12px; text-align:center; }
    .continuity-stat .lbl { font-size:.7rem; text-transform:uppercase; color:var(--bs-secondary); }
    .continuity-stat .val { font-size:1.4rem; font-weight:600; }

    /* Conflicts wizard */
    .continuity-wizard-option {
        background:#0d1117;
        border:1px solid #30363d;
        border-radius:8px;
        padding:14px;
        transition: border-color .15s ease, background-color .15s ease;
    }
    .continuity-wizard-option:hover {
        border-color:#3fb950;
        background:#101820;
    }
    .continuity-wizard-option .btn-success {
        background:#238636;
        border-color:#238636;
    }
    .continuity-wizard-option .btn-success:hover {
        background:#2ea043;
        border-color:#2ea043;
    }

    /* Dark dropdown */
    .continuity-extract-select {
        background-color:#0d1117 !important;
        color:#c9d1d9 !important;
        border-color:#30363d !important;
    }
    .continuity-extract-select:focus {
        background-color:#0d1117 !important;
        color:#c9d1d9 !important;
        border-color:#58a6ff !important;
        box-shadow:0 0 0 .2rem rgba(88,166,255,.25) !important;
    }
    .continuity-extract-select option {
        background-color:#0d1117;
        color:#c9d1d9;
    }

    /* Force dark on browse-claims card (bg-dark was being overridden) */
    .continuity-browse-card {
        background-color:#0d1117 !important;
        color:#c9d1d9 !important;
    }
    .continuity-browse-header {
        background-color:#161b22 !important;
        color:#c9d1d9 !important;
        border-color:#30363d !important;
    }
    .continuity-browse-body {
        background-color:#0d1117 !important;
    }
    .continuity-filter-input {
        background-color:#0d1117 !important;
        color:#c9d1d9 !important;
        border-color:#30363d !important;
    }
    .continuity-filter-input::placeholder { color:#6e7681 !important; }
    .continuity-filter-input:focus {
        background-color:#0d1117 !important;
        color:#c9d1d9 !important;
        border-color:#58a6ff !important;
        box-shadow:0 0 0 .2rem rgba(88,166,255,.25) !important;
    }

    /* Dark continuity browse table */
    .continuity-browse {
        --bs-table-bg: #0d1117;
        --bs-table-color: #c9d1d9;
        --bs-table-striped-bg: #161b22;
        --bs-table-hover-bg: #1f2937;
        --bs-table-hover-color: #ffffff;
        --bs-table-border-color: #30363d;
    }
