@page "/flyover"
@page "/wasteland"
@inject FlyoverEntityRepository Repo
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject WorldGraphService Graph

<div class="dict-layout">
    <div class="dict-list">
        <div class="card bg-dark text-light border-secondary mb-2 card-body">
            <FilterBar AllTags="allTags" @bind-Filter="filter" SelectedTags="selectedTags" SelectedTagsChanged="OnTagsChanged" />
        </div>
        <div class="dict-items">
            @foreach (var w in SortedItems)
            {
                <div class="list-item text-light @(editing?.Name == w.Name ? "active" : "")" @onclick="() => Edit(w)">
                    <div class="fw-bold small">@w.Name</div>
                    <div class="text-muted" style="font-size: 0.7rem;">@w.Classification</div>
                </div>
            }
        </div>
    </div>

    <div class="dict-editor">
        @if (editing != null)
        {
            <EditViewToggle RepoName="flyover" Title="@(isNew ? "New Flyover Entity" : editing.Name)" Json="@System.Text.Json.JsonSerializer.Serialize(editing)" Rating="@(editing?.Rating ?? 0)" RatingChanged="OnRatingChanged">
                <HeaderButtons>
                    <button class="btn btn-sm btn-success" @onclick="SaveEdit"><i class="bi bi-floppy"></i><div class="btn-lbl"> Save</div></button>
                    @if (!isNew && !confirmDelete) { <button class="btn btn-sm btn-outline-danger" @onclick="() => confirmDelete = true"><i class="bi bi-archive"></i></button> }
                    @if (confirmDelete) { <button class="btn btn-sm btn-danger" @onclick="DoDelete"><div class="btn-lbl">Confirm</div></button> <button class="btn btn-sm btn-outline-secondary" @onclick="() => confirmDelete = false"><div class="btn-lbl">No</div></button> }
                </HeaderButtons>
                <ChildContent>
                    <div class="row g-3 mb-3">
                        <div class="col-4"><div class="field-label">Name</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Name" /></div>
                        <div class="col-4"><div class="field-label">Classification</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Classification" /></div>
                        <div class="col-4"><div class="field-label">Aliases (comma-sep)</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="aliasInput" /></div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-4"><div class="field-label">Substrate</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Substrate" /></div>
                        <div class="col-4"><div class="field-label">Territory</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.Territory" /></div>
                        <div class="col-4"><div class="field-label">Threat Level</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.ThreatLevel" /></div>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-6"><div class="field-label">GLMZ Migration Risk</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="editing.GlmzMigrationRisk" /></div>
                        <div class="col-6"><div class="field-label">Known Locations (comma-sep)</div><input type="text" class="form-control form-control-sm bg-dark text-light border-secondary" @bind="locationsInput" /></div>
                    </div>
                    <div class="mb-3"><div class="field-label">Origin</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.Origin"></textarea></div>
                    <div class="mb-3"><div class="field-label">Physical Description</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.PhysicalDescription"></textarea></div>
                    <div class="mb-3"><div class="field-label">Behavioral Profile</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.BehavioralProfile"></textarea></div>
                    <div class="mb-3"><div class="field-label">Human Remnants</div><textarea class="form-control bg-dark text-light border-secondary auto-grow" @bind="editing.HumanRemnants"></textarea></div>
                </ChildContent>
            </EditViewToggle>
        }
        else { <div class="text-muted d-flex align-items-center justify-content-center h-100">Select an entity or create a new one</div> }
    </div>
</div>

@code {
    private List<FlyoverEntityData> items = [];
    private FlyoverEntityData? editing;
    private bool isNew, confirmDelete;
    private string originalName = "", aliasInput = "", locationsInput = "";
    private string filter = "";
    private List<(string name, int count)> allTags = [];
    private HashSet<string> selectedTags = [];

    private List<FlyoverEntityData> FilteredItems
    {
        get
        {
            IEnumerable<FlyoverEntityData> result = items;
            if (!string.IsNullOrWhiteSpace(filter))
                result = result.Where(w => w.Name.Contains(filter, StringComparison.OrdinalIgnoreCase));
            if (selectedTags.Count > 0)
                result = result.Where(w => selectedTags.All(t => w.Tags.Contains(t)));
            return result.ToList();
        }
    }
    private List<FlyoverEntityData> SortedItems => FilteredItems.OrderBy(x => x.Name).ToList();

    protected override void OnInitialized()
    {
        Repo.Reload();
        items = Repo.GetAll();
        RebuildTags();
        if (Nav.Uri.Contains("new=true")) AddNew();
        else
        {
            var qid = Nav.Uri.Contains("id=") ? Uri.UnescapeDataString(Nav.Uri.Split(new[] { "id=" }, StringSplitOptions.None).Last().Split(new[] { "&" }, StringSplitOptions.None)[0]) : "";
            if (!string.IsNullOrEmpty(qid)) { var t = items.FirstOrDefault(e => e.Id == qid); if (t != null) Edit(t); }
        }
    }

    private void RebuildTags() => allTags = items.SelectMany(x => x.Tags).GroupBy(t => t).Select(g => (g.Key, g.Count())).OrderBy(t => t.Key).ToList();
    private void OnTagsChanged(HashSet<string> tags) { selectedTags = tags; }
    private void AddNew() { editing = new FlyoverEntityData(); isNew = true; confirmDelete = false; aliasInput = ""; locationsInput = ""; }
    private void Edit(FlyoverEntityData w) { _ = JS.InvokeVoidAsync("localStorage.setItem", "ss_sel_flyover", w.Id); editing = w; originalName = w.Name; isNew = false; confirmDelete = false; aliasInput = string.Join(", ", w.Aliases); locationsInput = string.Join(", ", w.KnownLocations); if (!Nav.Uri.Contains("id=" + w.Id)) Nav.NavigateTo(Nav.Uri.Split('?')[0] + "?id=" + w.Id, forceLoad: false); }

    private void SaveEdit()
    {
        if (editing == null || string.IsNullOrWhiteSpace(editing.Name)) return;
        editing.Aliases = aliasInput.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        editing.KnownLocations = locationsInput.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
        if (!isNew && originalName != editing.Name) Repo.Delete(originalName);
        Repo.Save(editing);
        editing = null;
        items = Repo.GetAll();
        RebuildTags();
    }

    private void DoDelete() { if (editing == null) return; Graph.RemoveNode(editing.Name); Repo.Delete(editing.Name); editing = null; confirmDelete = false; items = Repo.GetAll(); RebuildTags(); }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("writeInterop.autoResizeAll");
        if (firstRender && editing == null && items.Count > 0 && !Nav.Uri.Contains("new=true") && !Nav.Uri.Contains("id="))
        {
            var lastId = "";
            try { lastId = await JS.InvokeAsync<string>("localStorage.getItem", "ss_sel_flyover") ?? ""; } catch { }
            var target = (!string.IsNullOrEmpty(lastId) ? items.FirstOrDefault(x => x.Id == lastId) : null) ?? items.First();
            if (target != null) { Edit(target); StateHasChanged(); }
        }
    }
    private void OnRatingChanged(double value) { if (editing == null) return; editing.Rating = value; Repo.Save(editing); }
}