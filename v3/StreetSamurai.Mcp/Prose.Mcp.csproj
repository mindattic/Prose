<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Prose.Mcp</RootNamespace>
    <AssemblyName>Prose.Mcp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Anthropic's C# Model Context Protocol SDK. The server-side bits live in the
         core package; the package version intentionally floats so security updates
         flow without touching this csproj. -->
    <PackageReference Include="ModelContextProtocol" Version="*" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- Re-uses every Core service (repos, BookOutlineService, SemanticIndexService,
         MotifService, WritingQualityService, etc) via AddProseServices(). -->
    <ProjectReference Include="..\Prose.Core\Prose.Core.csproj" />
  </ItemGroup>

</Project>
