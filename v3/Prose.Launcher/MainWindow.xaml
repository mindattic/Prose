<Window x:Class="Prose.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Prose" Height="420" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1e1e1e">
    <Window.Resources>
        <Style x:Key="Tile" TargetType="Button">
            <Setter Property="Height" Value="64" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Background" Value="#2a2a2a" />
            <Setter Property="Foreground" Value="#eeeeee" />
            <Setter Property="BorderBrush" Value="#6a6a6a" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="16,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="Prose" Foreground="#eeeeee" FontSize="30" FontFamily="Georgia" />
        <TextBlock x:Name="HubStatus" Text="Checking Prose Hub…" Foreground="#999999"
                   FontFamily="Segoe UI" FontSize="12" Margin="0,4,0,20" TextWrapping="Wrap" />

        <Button x:Name="WriterButton" Style="{StaticResource Tile}" Click="OpenWriter">
            <StackPanel>
                <TextBlock Text="Writer" FontSize="15" />
                <TextBlock Text="Read and hand-edit a book, beat by beat" Foreground="#999999" FontSize="11" />
            </StackPanel>
        </Button>

        <Button x:Name="KdpButton" Style="{StaticResource Tile}" Click="OpenKdp">
            <StackPanel>
                <TextBlock Text="KDP Publish" FontSize="15" />
                <TextBlock Text="Publish and update books on Amazon" Foreground="#999999" FontSize="11" />
            </StackPanel>
        </Button>

        <Button x:Name="HubButton" Style="{StaticResource Tile}" Click="OpenHubDashboard">
            <StackPanel>
                <TextBlock Text="Hub dashboard" FontSize="15" />
                <TextBlock Text="Logs, DCM, findings — opens in your browser" Foreground="#999999" FontSize="11" />
            </StackPanel>
        </Button>
    </StackPanel>
</Window>
