.env
__pycache__/
*.pyc
sessions/*/facet_responses/
*.egg-info/

# Engine data (rebuilt from canon, not tracked)
engine_data/

# Chapter folders — SQL Server is the source of truth post-cutover (2026-05-06).
# On-disk chapter.json files remain only as legacy seeds for `ss --migrate-sql --import books`.
engine/data/chapters/

# Generated narration audio (WAV/MP3) — runtime output of Publish Audiobook /
# combined export, regenerated from the beats in SQL Server. Never source.
engine/data/strands/

# Runtime logs
engine/data/logs/

# Canon queue working directories
canon_queue/pending/
canon_queue/rejected/

# Database files (regenerated locally)
*.db

# .NET build artifacts
**/bin/
**/obj/
v3/.vs/
*.user

# DB backups (1GB+ .bak files, never commit)
backups/
.claude/backups/
*.bak

# Cypress / Node
node_modules/
cypress/screenshots/
cypress/videos/
cypress/downloads/

# Local DB backups / large dumps (never commit)
archives/

# Local CLI build output (lock-free runner)
.cli-tmp/

# Python virtual environments (never commit — too large, regenerated locally)
.venv/
venv/

# Large ML model files (download separately)
*.onnx

# ML artifacts — all generated data lives in %APPDATA%\MindAttic\ML, never the repo
v3/ml/artifacts/
*.parquet
*.pkl
*.npy

# scratch logs
*.log

# World graph is a regenerable per-universe cache derived from SQL (the source of
# truth, SS-LAW-1). Rebuilt on demand via `ss --rebuild-graph --universe <slug>`;
# not tracked — it churned tens of thousands of lines per universe switch.
engine/data/graph/*_universe_graph.json
engine/data/graph/world_graph.json

# Logic sweep outputs — session artifacts, never canon
audit-outlines-*/
audit-haiku-*/

# Test run output
**/TestResults/

# Scratch output files
*.out

# Runtime lock files
.claude/scheduled_tasks.lock

# Legacy story outline format (superseded by DB beats)
*.strand
