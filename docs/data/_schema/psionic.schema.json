{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ss://schema/psionic",
  "title": "StreetSamurai canon — Psionic ability (engine_data/psionics/*.json)",
  "description": "A psionic enhancement/ability. Carries its own opaque hex id on disk.",
  "type": "object",
  "required": ["id", "type", "name"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string" },
    "type": { "const": "psionic" },
    "name": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "classification": { "type": "string" },
    "enhancement_type": { "type": "string" },
    "mechanism": { "type": "string" },
    "abilities": { "type": "array" },
    "side_effects": { "type": "array" },
    "story_hooks": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
