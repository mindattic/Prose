<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Prose.ObserverUi</RootNamespace>
    <AssemblyName>Prose.ObserverUi</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plain Microsoft.AspNetCore.Components.Web (not a FrameworkReference to the full
         ASP.NET Core server framework) - this library is referenced by Prose.Hub (Blazor
         Server) AND, later, Prose.Maui (MAUI Blazor Hybrid), so it must stay portable. -->
    <!-- 10.0.14, not 10.0.0-*: that pin held SignalR.Common at 10.0.0, flagged high severity (GHSA-334f-vvp4-7g6p, PRS-T836). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure DTOs shared with Prose.Hub and (later) Prose.Maui - zero further dependencies. -->
    <ProjectReference Include="..\Prose.Hub.Contracts\Prose.Hub.Contracts.csproj" />
  </ItemGroup>

</Project>
