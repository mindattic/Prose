@implements IAsyncDisposable

<div class="p-4 dashboard-tab">
    <h4>Dashboard</h4>

    @if (error != null)
    {
        <p class="err">@error</p>
    }

    <div class="dash-card">
        <h6>Live Write Status</h6>
        @if (currentRun != null)
        {
            <p>
                Writing <strong>@currentRun.NodeSlug</strong> — beat @beatCount so far,
                started @currentRun.StartedAt.ToLocalTime().ToString("HH:mm:ss")
                @if (lastBeatTitle != null)
                {
                    <text> — latest: <em>@lastBeatTitle</em></text>
                }
            </p>
        }
        else
        {
            <p class="muted">No write in progress.</p>
        }
    </div>

    <div class="dash-card">
        <h6>Read-along</h6>
        @if (readAlong is null)
        {
            <p class="muted">No status yet.</p>
        }
        else
        {
            <p>
                Following <strong>@readAlong.FollowedBooks</strong> book@(readAlong.FollowedBooks == 1 ? "" : "s")
                · <strong>@readAlong.OpenCards</strong> open continuity card@(readAlong.OpenCards == 1 ? "" : "s")
                · <strong>@readAlong.PendingDrafts</strong> draft@(readAlong.PendingDrafts == 1 ? "" : "s") waiting
            </p>
            <p class="muted">
                @(readAlong.LastSweepAt is { } at
                    ? $"Last sweep {at.ToLocalTime():yyyy-MM-dd HH:mm}: {readAlong.LastSweepSummary} ({readAlong.LastSweepMs:F0} ms, no tokens)."
                    : "The job has not read anything yet.")
                <a href="/story">Open the Story workspace</a>
            </p>
        }
    </div>

    <div class="dash-grid">
        <div class="dash-card">
            <div class="dash-card-head">
                <h6>Recent Commands</h6>
                <button class="btn" @onclick="RefreshAsync">Refresh</button>
            </div>
            @if (commands.Count == 0)
            {
                <p class="muted">Nothing yet.</p>
            }
            else
            {
                @foreach (var c in commands)
                {
                    <div class="feed-row @(c.Success ? "" : "feed-fail")">
                        <span class="feed-time">@c.At.ToLocalTime().ToString("HH:mm:ss")</span>
                        <span class="feed-src">@c.Source</span>
                        <span class="feed-name">@c.HandlerClass</span>
                        <span class="feed-dur">@c.DurationMs.ToString("F0")ms</span>
                    </div>
                }
            }
        </div>

        <div class="dash-card">
            <div class="dash-card-head">
                <h6>Recent Decisions</h6>
            </div>
            @if (decisions.Count == 0)
            {
                <p class="muted">Nothing yet.</p>
            }
            else
            {
                @foreach (var d in decisions)
                {
                    <div class="feed-row">
                        <span class="feed-time">@d.At.ToLocalTime().ToString("HH:mm:ss")</span>
                        <span class="feed-name">@d.Summary</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [Inject] private HubApiClient hub { get; set; } = default!;
    [Inject] private ObserverHttpClient api { get; set; } = default!;

    private DcmRunDto? currentRun;
    private int beatCount;
    private string? lastBeatTitle;

    private List<CommandLedgerDto> commands = [];
    private ReadAlongJobStatusDto? readAlong;
    private List<DecisionLedgerDto> decisions = [];
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        hub.DcmRunStarted += OnRunStarted;
        hub.DcmBeat += OnBeat;
        hub.DcmRunEnded += OnRunEnded;
        await hub.EnsureStartedAsync();
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        // The Hub call throws on a transport failure (bad/missing key, Hub restarting, a 500) by
        // design — say so here rather than let it escape this handler and take the circuit down.
        try
        {
            commands = await api.GetCommandLogAsync(20);
            decisions = await api.GetDecisionLogAsync(20);
            try { readAlong = await api.GetReadAlongJobStatusAsync(); }
            catch (Exception ex) when (ex is InvalidOperationException or System.Text.Json.JsonException) { readAlong = null; }
            error = null;
        }
        catch (HttpRequestException ex) { error = ex.Message; }
        await InvokeAsync(StateHasChanged);
    }

    // The three hub events arrive on SignalR threads; each is marshalled onto the circuit whole, so
    // a beat that lands while a run is starting cannot increment a count the start then resets.
    private void OnRunStarted(DcmRunDto run) => _ = InvokeAsync(() =>
    {
        currentRun = run;
        beatCount = 0;
        lastBeatTitle = null;
        StateHasChanged();
    });

    private void OnBeat(DcmBeatDto beat) => _ = InvokeAsync(() =>
    {
        if (currentRun == null || beat.RunId != currentRun.RunId) return;
        beatCount++;
        lastBeatTitle = beat.BeatTitle;
        StateHasChanged();
    });

    private void OnRunEnded(DcmRunDto run) => _ = InvokeAsync(() =>
    {
        if (currentRun != null && run.RunId == currentRun.RunId) currentRun = null;
        StateHasChanged();
    });

    public ValueTask DisposeAsync()
    {
        hub.DcmRunStarted -= OnRunStarted;
        hub.DcmBeat -= OnBeat;
        hub.DcmRunEnded -= OnRunEnded;
        return ValueTask.CompletedTask;
    }
}
