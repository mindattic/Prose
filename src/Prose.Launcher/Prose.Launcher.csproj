<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>1.0.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Prose.Launcher</RootNamespace>
    <AssemblyName>Launcher</AssemblyName>
    <!-- Embedded into Launcher.exe as its Win32 resource icon; WPF windows inherit it. -->
    <ApplicationIcon>..\..\assets\M.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Linked, not referenced: HubProcess is ~80 lines with no dependencies, and a project whose
         only purpose is to share one file costs more than it saves. Both apps genuinely need the
         same "is the Hub up, and if not start it" behaviour, and it must not drift. -->
    <Compile Include="..\Prose.Writer\HubProcess.cs" Link="HubProcess.cs" />
  </ItemGroup>

</Project>
