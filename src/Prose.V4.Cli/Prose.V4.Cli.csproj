<Project Sdk="Microsoft.NET.Sdk">

  <!-- Composition-pipeline CLI: verbs that exercise StoryStateQuery/SceneWindowService against the
       real DB. Deliberately NOT forwarded through Prose.Hub (see HubCliClient.cs in Prose.Cli — that
       Stage C migration is for production write commands). Runs standalone with local DbContext
       access, exactly like Prose.Cli's own not-yet-migrated commands, so development doesn't wait on
       an author Hub redeploy for every change.

       TRANSITIONAL: these verbs are being folded into Prose.Cli's handler convention, after which
       this project is retired. It is kept whole here so no command is missing in the interim. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);EF1002;EF1003</NoWarn>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prose.V4.Core's services now live in Prose.Core/Composition, so one reference covers both. -->
    <ProjectReference Include="..\Prose.Core\Prose.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

</Project>
