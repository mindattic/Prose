<Window x:Class="Prose.Writer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Prose Writer" Height="1000" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MaChrome}">
    <Grid>
        <!-- Splash. Visible until the Hub answers and the page has been navigated to; the
             WebView2 underneath is transparent until first paint, and a WebView2 showing the
             browser's own error page is a worse first impression than a status line. -->
        <StackPanel x:Name="Splash" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="Prose Writer" Foreground="{StaticResource MaText}" FontSize="28" FontFamily="Georgia"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="SplashStatus" Text="Starting…" Foreground="{StaticResource MaMuted}" FontSize="13"
                       FontFamily="Segoe UI" Margin="0,12,0,0" HorizontalAlignment="Center"
                       TextAlignment="Center" MaxWidth="640" TextWrapping="Wrap" />

            <!-- The way back. Every failure path above used to end here with a status line and no
                 action, so a Hub that went away — a redeploy, a crash, a machine asleep — meant
                 closing and reopening the whole app. This button re-runs the same search-and-start
                 sequence the window runs at launch. It cannot live in the editor itself: that page
                 is served BY the Hub, so when the Hub is gone the Blazor circuit is gone with it
                 and no button inside it is running any more. -->
            <Button x:Name="ConnectButton" Content="Connect" Visibility="Collapsed"
                    Margin="0,20,0,0" HorizontalAlignment="Center" Padding="22,7"
                    Style="{StaticResource MaButton}" Click="OnConnectClick" />
        </StackPanel>

        <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />
    </Grid>
</Window>
