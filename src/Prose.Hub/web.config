<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- Only IIS / Azure App Service read this file (hosted mode, PRS-T1005); the local Hub is Hub.exe.
           `dotnet publish` fills in the launcher (dotnet .\Hub.dll).

           startupTimeLimit (PRS-T1012): the Hub does not listen until its start-up work is done: wake the
           database (a paused Azure SQL serverless database takes about a minute), check migrations and
           the auth schema, and load the resident universe graph from SQL. IIS kills a process that is not
           listening within this many seconds (120 by default) and starts it again, so with the default the
           hosted Hub never came up: every attempt was killed mid graph load and the next one began again
           from nothing.

           OutOfProcess: the /app page calls the Hub's own HTTP API over loopback, which in-process hosting
           has no port for (see Prose.Hub.csproj).

           stdout goes to C:\home\LogFiles\stdout_*.log: it is where a refusal to start (exit 78) and its
           reason are printed. -->
      <aspNetCore processPath="%LAUNCHER_PATH%" arguments="%LAUNCHER_ARGS%"
                  stdoutLogEnabled="true" stdoutLogFile="\\?\%home%\LogFiles\stdout"
                  hostingModel="OutOfProcess" startupTimeLimit="900" />
    </system.webServer>
  </location>
</configuration>
