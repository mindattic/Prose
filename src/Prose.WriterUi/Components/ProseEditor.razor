@* The editing surface itself, and the only component that talks to window.proseEditor.

   Everything here is about one beat's text. The shell owns which beat that is, what saving means
   and what a chip click should do; this component owns the DOM, the caret, and the interop. That
   seam is deliberate: the Discuss panel attaches to a *selection*, which is this component's
   business, while what a discussion then does is not.

   The shell keys this component on the beat id, so moving to another beat builds a new editor
   rather than reusing the old one. That is what keeps the browser's undo history from reaching
   across beats: a fresh element has none, where a reused one would let Ctrl+Z pull the last beat's
   edits into this one. *@

@inject IJSRuntime JS
@inject WikiService Wiki
@inject Prose.Core.Services.Spelling.SpellingService Spelling
@implements IAsyncDisposable

@* The shortcuts, where a screen reader will find them: announced as the editor's description when
   focus arrives, instead of existing only in button tooltips a keyboard user never hovers. *@
<p id="prose-editor-keys" class="visually-hidden">
    @if (Mode == EditorMode.Display)
    {
        @:Control B bold, Control I italic, Control U underline, Control Shift X strikethrough,
        @:Control K insert an entity, or link the selected words to one, Control S save. With the
        @:caret beside an entity link its details are read out; Shift F10 opens more actions,
        @:including editing or removing that link.
    }
    else
    {
        @:The raw markup of the beat. Control B, I and U and Control Shift X insert the markers for
        @:bold, italic, underline and strikethrough. Control S saves.
    }
</p>

@if (Mode == EditorMode.Display)
{
    @* spellcheck="false": the squiggles are Prose's own (SpellingService, over the author's
       dictionary), drawn by writer.js. Chromium's checker has its own dictionary, and two
       checkers that disagree are worse than one. *@
    <article class="prose" contenteditable="true" spellcheck="false"
             role="textbox" aria-multiline="true" aria-label="@Label"
             aria-describedby="prose-editor-keys" @ref="editorRef"></article>
}
else
{
    <textarea class="raw-editor" spellcheck="false" aria-label="@($"{Label}, markup")"
              aria-describedby="prose-editor-keys"
              @ref="rawRef" value="@Text" @oninput="OnRawInput"></textarea>
}

@code {
    /// <summary>A chip the author clicked or right-clicked. <c>Repo</c> is a hint only — the guid
    /// is the truth (see <c>BeatMarkup</c>).</summary>
    public sealed record EntityChip(string Guid, string Repo, string Text);

    /// <summary>What <c>proseEditor.selection</c> hands back.</summary>
    public sealed record Selection(string Text, bool Ok);

    /// <summary>What <c>proseEditor.caret</c> hands back: whether the author is in the prose, what
    /// they have selected (empty for a bare caret), and where on screen the caret is: X and Y are
    /// just below it, Top is the top of its line.</summary>
    public sealed record Caret(bool Ok, string Text, int X, int Y, int Top);

    /// <summary>
    /// A passage the author right-clicked, with what surrounds it. All three are beat markup, as
    /// the editor's own serializer produces it — the server strips them and works out the position,
    /// so no character offsets cross this boundary.
    /// </summary>
    public sealed record SelectedSpan(string Quote, string Prefix, string Suffix);

    /// <summary>
    /// Everything the context menu needs, gathered at the moment of the click.
    ///
    /// <para>Gathered then and carried, rather than asked for again when an item is chosen:
    /// opening a menu moves focus, and a selection read back afterwards is not reliably the one
    /// the author right-clicked.</para>
    /// </summary>
    /// <param name="EntityGuid">Null unless the click landed on an entity chip.</param>
    /// <param name="Quote">Null unless something was selected. Beat markup, like
    /// <see cref="SelectedSpan"/>.</param>
    /// <param name="SpellWord">The misspelled word the click landed on (or the caret is in), else
    /// null.</param>
    public sealed record ContextTarget(
        int X, int Y,
        string? EntityGuid, string? EntityRepo, string? EntityText,
        string? Quote, string? Prefix, string? Suffix,
        string? SelectedText,
        string? SpellWord = null)
    {
        public bool HasSelection => !string.IsNullOrWhiteSpace(SelectedText);
        public bool OnEntity => !string.IsNullOrEmpty(EntityGuid);

        public SelectedSpan? Span => Quote is null
            ? null
            : new SelectedSpan(Quote, Prefix ?? "", Suffix ?? "");
    }

    [Parameter] public string Text { get; set; } = "";
    [Parameter] public EventCallback<string> TextChanged { get; set; }
    [Parameter] public EditorMode Mode { get; set; }

    /// <summary>The editor's accessible name. Which beat it is, so a screen reader user moving
    /// between beats hears that they arrived somewhere new.</summary>
    [Parameter] public string Label { get; set; } = "Beat text";

    /// <summary>The author asked for the context menu: right-click, Shift+F10, or a click on an
    /// entity chip.</summary>
    [Parameter] public EventCallback<ContextTarget> ContextMenuRequested { get; set; }

    /// <summary>Ctrl+K: insert an entity, or link the selected words to one.</summary>
    [Parameter] public EventCallback LinkRequested { get; set; }

    /// <summary>"Edit link" on an entity's hover card.</summary>
    [Parameter] public EventCallback<EntityChip> EditEntityRequested { get; set; }

    /// <summary>"Open in the wiki" on an entity's hover card.</summary>
    [Parameter] public EventCallback<EntityChip> OpenEntityRequested { get; set; }

    /// <summary>The author pasted something the sanitizer had to trim — an image, a table, a
    /// heading, list formatting, or a hyperlink's target. The words are kept; this says what
    /// wasn't.</summary>
    [Parameter] public EventCallback<string> PasteNote { get; set; }

    /// <summary>The circuit lost its browser. The shell greys the status dot.</summary>
    [Parameter] public EventCallback OnDisconnected { get; set; }

    /// <summary>Interop failed. The shell shows the message and falls back to Markdown mode —
    /// a surface that needs no JavaScript at all.</summary>
    [Parameter] public EventCallback<string> OnJsError { get; set; }

    private ElementReference editorRef;
    private ElementReference rawRef;
    private DotNetObjectReference<ProseEditor>? selfRef;

    private bool wired;
    private string renderedFor = "";
    private EditorMode lastMode;

    protected override void OnParametersSet()
    {
        // Switching modes destroys one element and builds the other, so the listeners attached
        // to the old one are gone with it and wiring has to run again. A new beat needs nothing
        // here: the shell's @key makes that a new component.
        if (lastMode != Mode)
        {
            lastMode = Mode;
            wired = false;
            renderedFor = "";
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (Mode != EditorMode.Display)
            {
                if (!wired)
                {
                    await JS.InvokeVoidAsync("proseEditor.initRaw", rawRef);
                    wired = true;
                }
                return;
            }

            if (!wired)
            {
                selfRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("proseEditor.init", editorRef, selfRef);
                wired = true;
                renderedFor = "";
            }

            // Only push HTML when the text changed for a reason other than the author typing.
            // Rewriting innerHTML on every keystroke would throw the caret to the top of the beat.
            if (renderedFor != Text)
            {
                renderedFor = Text;
                await JS.InvokeVoidAsync("proseEditor.setHtml", editorRef, ProseRenderer.ToHtml(Text));
            }
        }
        catch (JSDisconnectedException)
        {
            await OnDisconnected.InvokeAsync();
        }
        catch (JSException ex)
        {
            // An interop failure escaping OnAfterRenderAsync tears down the whole circuit: the page
            // stops responding entirely, with nothing on screen to say why. A broken editor surface
            // is bad; a dead application is worse.
            wired = false;
            await OnJsError.InvokeAsync(ex.Message);
        }
    }

    // ── Called from JavaScript ─────────────────────────────────────────────

    /// <summary>The editor's DOM, serialized back to beat markup. Fired on every input.</summary>
    [JSInvokable]
    public Task OnEditorInput(string text)
    {
        // Recorded before the parent is told, so the round trip back down as a parameter does not
        // look like an outside change and push HTML over the author's caret.
        renderedFor = text;
        return TextChanged.InvokeAsync(text);
    }

    [JSInvokable]
    public Task OnContextMenu(ContextTarget target) => ContextMenuRequested.InvokeAsync(target);

    [JSInvokable]
    public Task OnLinkRequested() => LinkRequested.InvokeAsync();

    [JSInvokable]
    public Task OnPasteNote(string message) => PasteNote.InvokeAsync(message);

    /// <summary>The book, so its universe's entity names count as spelled right.</summary>
    [Parameter] public Guid? BookId { get; set; }

    /// <summary>The misspelled words among <paramref name="words"/>; writer.js draws the squiggles.
    /// A checker fault flags nothing rather than everything.</summary>
    [JSInvokable]
    public async Task<IReadOnlyList<string>> CheckSpelling(string[] words)
    {
        try { return await Spelling.MisspelledAsync(words, BookId); }
        catch (Exception) { return []; }
    }

    /// <summary>The hover card's content. Null when the chip points at nothing.</summary>
    [JSInvokable]
    public async Task<WikiService.EntityPreview?> GetEntityPreview(string guid)
        => Guid.TryParse(guid, out var id) ? await Wiki.GetPreviewAsync(id) : null;

    /// <summary>A button on the hover card. "remove" never gets here — writer.js unwraps the chip
    /// itself, the same as the menu's Remove link.</summary>
    [JSInvokable]
    public Task OnEntityCardAction(string action, string guid, string repo, string text) => action switch
    {
        "edit" => EditEntityRequested.InvokeAsync(new EntityChip(guid, repo, text)),
        "open" => OpenEntityRequested.InvokeAsync(new EntityChip(guid, repo, text)),
        _ => Task.CompletedTask,
    };

    // ── Called by the shell (toolbar, entity dialog) ───────────────────────

    /// <param name="command">bold, italic, underline or strikeThrough. Markdown mode inserts the
    /// matching markers; writer.js owns that mapping so the shortcuts and the toolbar share it.</param>
    public Task FormatAsync(string command) => Mode == EditorMode.Display
        ? JsVoidAsync("proseEditor.format", command)
        : JsVoidAsync("proseEditor.formatRaw", rawRef, command);

    public Task InsertEmDashAsync() => Mode == EditorMode.Display
        ? JsVoidAsync("proseEditor.insert", "—")
        : JsVoidAsync("proseEditor.wrapTextarea", rawRef, "—", "");

    public Task<Selection?> GetSelectionAsync() => JsAsync<Selection>("proseEditor.selection");

    /// <summary>Remember the caret (or selection) for the entity picker, and say where it is.</summary>
    public Task<Caret?> GetCaretAsync() => JsAsync<Caret>("proseEditor.caret");

    /// <summary>Reader-visible characters before the caret, or -1 when the caret is elsewhere.
    /// Mapped to a stored offset by the caller — see <c>PlainTextMap</c>.</summary>
    public async Task<int> GetCaretOffsetAsync() => await JsAsync<int>("proseEditor.caretOffset");

    // The three link operations return null when they worked and a sentence when they did not.
    // They used to return a bool nobody read, so a refused link closed the dialog and changed
    // nothing, with nothing on screen to say so.

    public Task<string?> WrapSelectionAsync(string guid, string repo)
        => JsAsync<string?>("proseEditor.wrapSelection", guid, repo);

    public Task<string?> ApplyEntityAsync(string guid, string repo, string text)
        => JsAsync<string?>("proseEditor.applyEntity", guid, repo, text);

    public Task<string?> RemoveEntityAsync() => JsAsync<string?>("proseEditor.removeEntity");

    /// <summary>Insert the entity's name, linked, at the caret <see cref="GetCaretAsync"/> saw.</summary>
    public Task<string?> InsertEntityAsync(string guid, string repo, string name)
        => JsAsync<string?>("proseEditor.insertEntity", guid, repo, name);

    // ── Interop plumbing ───────────────────────────────────────────────────

    private Task OnRawInput(ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? string.Empty;
        renderedFor = text;
        return TextChanged.InvokeAsync(text);
    }

    /// <summary>
    /// Every call into the editor's JavaScript goes through here. An unhandled
    /// <see cref="JSException"/> inside a Blazor Server event handler tears down the circuit and
    /// the page simply stops responding — no error, no clue. A toolbar button that does nothing is
    /// a far better failure than an application that dies.
    /// </summary>
    private async Task<T?> JsAsync<T>(string identifier, params object?[] args)
    {
        try
        {
            return await JS.InvokeAsync<T>(identifier, args);
        }
        catch (JSDisconnectedException) { await OnDisconnected.InvokeAsync(); }
        catch (JSException ex) { await OnJsError.InvokeAsync(ex.Message); }
        return default;
    }

    private async Task JsVoidAsync(string identifier, params object?[] args)
    {
        try
        {
            await JS.InvokeVoidAsync(identifier, args);
        }
        catch (JSDisconnectedException) { await OnDisconnected.InvokeAsync(); }
        catch (JSException ex) { await OnJsError.InvokeAsync(ex.Message); }
    }

    public ValueTask DisposeAsync()
    {
        selfRef?.Dispose();
        return ValueTask.CompletedTask;
    }
}
