@* Dictionary and voice.

   LAMP (PRS-T829): Prose's app settings and every API key are edited in MindAttic Vault
   (Vault.Desktop, Prose tab), not here. This panel keeps what belongs to the books themselves —
   the spelling dictionary — plus read-only status for discussion, read-aloud and dictation, and a
   button that opens Vault. Nothing here reads a key back out: only whether one is set. *@

@inject SettingsUiService Settings
@inject ReadAloudUiService ReadAloud
@inject SpeechUiService Speech
@inject Prose.Core.Services.Spelling.SpellingService Spelling
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="scrim" aria-hidden="true" @onclick="() => OnClose.InvokeAsync()"></div>
<div class="modal settings" role="dialog" aria-modal="true" aria-labelledby="settings-title"
     tabindex="-1" @ref="dialog" @onkeydown="OnKeyDown">
    <h2 id="settings-title">Dictionary and voice</h2>

    <section class="set-block">
        <h3>App settings and API keys</h3>
        <p class="set-note">
            Models, review defaults, narration, export folders and every API key are edited in
            MindAttic Vault, on its Prose tab. A change there reaches the running Hub without a restart.
        </p>
        <div class="set-add">
            <button class="mini" @onclick="OpenVault">Open in MindAttic Vault</button>
        </div>
        @if (vaultMissing)
        {
            <p class="set-note">
                <span class="set-warn">MindAttic Vault isn't installed on the machine running the Hub.</span>
                <a href="@Settings.VaultLink">Open it from this link</a> on a PC that has it.
            </p>
        }
    </section>

    <section class="set-block">
        <h3>Discussion</h3>
        <p class="set-note">
            Claude is tried first, then OpenAI. Keys assigned to Prose in MindAttic Vault are used
            first, then any <span class="mono">prose --set-byo-key</span> pool.
            @if (Settings.ActiveProvider is { } active)
            {
                <span class="set-ok">Currently using <strong>@active</strong> (@Settings.KeySource(active)).</span>
            }
            else
            {
                <span class="set-warn">No key set, so discussion is unavailable and nothing can be spent.</span>
            }
        </p>
    </section>

    <section class="set-block">
        <h3>Reading aloud</h3>
        <p class="set-note">
            Read-aloud uses a local voice by default — free, offline, and unlimited. An ElevenLabs
            key is only needed to hear a passage in the book's own narration voice.
        </p>

        @{ var voice = ReadAloud.Probe(); }
        <p class="set-note">
            @if (voice.LocalReady)
            {
                <span class="set-ok">Local voice ready — replays cost nothing.</span>
            }
            else if (voice.CloudReady)
            {
                <span class="set-warn">
                    No local voice, so read-aloud uses ElevenLabs and spends characters on every
                    replay.
                </span>
                <br />
                <span class="muted">@voice.LocalBlocker</span>
            }
            else
            {
                <span class="set-warn">Nothing can speak yet.</span>
                <br />
                <span class="muted">@voice.LocalBlocker</span>
            }
        </p>
        <p class="set-note">
            @(Settings.HasElevenLabsKey
              ? "An ElevenLabs key is set."
              : "No ElevenLabs key is set. Add one in MindAttic Vault's Keys tab.")
        </p>
    </section>

    <section class="set-block">
        <h3>Dictation</h3>
        <p class="set-note">
            Spoken turns are transcribed with this book's own proper nouns supplied to the model,
            so invented names come back spelled the way the manuscript spells them. The recording
            itself is kept beside the turn — a transcription error otherwise reads exactly like a
            change of mind.
        </p>

        @{ var ear = Speech.Probe(); }
        <p class="set-note">
            @if (ear.Ready)
            {
                <span class="set-ok">Dictation ready — @ear.Engine.</span>
                <span class="muted">About four cents per hour of audio on Groq.</span>
            }
            else
            {
                <span class="set-warn">Nothing can transcribe yet.</span>
                <br />
                <span class="muted">@ear.Blocker</span>
            }
        </p>
    </section>

    <section class="set-block">
        <h3>Dictionary</h3>
        <p class="set-note">
            Words the spellcheck accepts beyond English. The world's entity names are already known.
            One entry covers its plural and possessive: <em>CorpoNation</em> also accepts
            CorpoNations and CorpoNation's. A word with capitals must be written with them. The same
            list as <span class="mono">prose --dictionary</span> and "Add to dictionary".
        </p>

        @if (dictionary is null)
        {
            <div class="menu-note">Loading…</div>
        }
        else if (dictionary.Count == 0)
        {
            <div class="menu-note">No words yet.</div>
        }
        else
        {
            <ul class="set-keys set-words">
                @foreach (var row in dictionary)
                {
                    <li>
                        <span>@row.Word</span>
                        <span class="muted">@row.AddedBy</span>
                        <div class="spacer"></div>
                        <button class="mini danger-btn"
                                aria-label="Remove @row.Word from the dictionary"
                                @onclick="() => RemoveWordAsync(row.Word)">Remove</button>
                    </li>
                }
            </ul>
        }

        <div class="set-add">
            <label class="visually-hidden" for="dict-word">Word to add to the dictionary</label>
            <input type="text" id="dict-word" placeholder="Add a word…" autocomplete="off" spellcheck="false"
                   value="@wordDraft"
                   @oninput="e => wordDraft = e.Value?.ToString() ?? string.Empty"
                   @onkeydown="OnWordKeyDown" />
            <button class="mini" disabled="@(string.IsNullOrWhiteSpace(wordDraft))"
                    @onclick="AddWordAsync">Add</button>
        </div>
    </section>

    @* Adding or removing a word destroys the button that was just pressed, so focus drops to the
       body — the confirmation was silent AND the focus was gone. *@
    <div class="banner info" role="status" style="@(note is null ? "display:none" : null)">@note</div>

    <div class="modal-actions">
        <div class="spacer"></div>
        <button class="primary" @onclick="() => OnClose.InvokeAsync()">Done</button>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>A word was added or removed, so the open beat's squiggles are out of date.</summary>
    [Parameter] public EventCallback DictionaryChanged { get; set; }

    private IReadOnlyList<Prose.Core.Data.Entities.SpellingWord>? dictionary;
    private string wordDraft = "";

    protected override async Task OnInitializedAsync()
    {
        try { dictionary = await Spelling.ListAsync(); }
        catch (Exception ex) { dictionary = []; note = $"The dictionary could not be read: {ex.Message}"; }
    }

    private async Task AddWordAsync()
    {
        try
        {
            var r = await Spelling.AddAsync(wordDraft, "writer");
            note = r.Added ? $"Added “{r.Row.Word}” to the dictionary." : $"“{wordDraft.Trim()}” is {r.Note}.";
            wordDraft = "";
            dictionary = await Spelling.ListAsync();
            await DictionaryChanged.InvokeAsync();
        }
        catch (ArgumentException ex) { note = $"Not added: {ex.Message}"; }
        // The database, not the word: an exception escaping a click handler ends the circuit.
        catch (Exception ex) { note = $"The dictionary could not be written: {ex.Message}"; }
    }

    private async Task RemoveWordAsync(string word)
    {
        try
        {
            note = await Spelling.RemoveAsync(word)
                ? $"Removed “{word}” from the dictionary."
                : $"“{word}” was not in the dictionary.";
            dictionary = await Spelling.ListAsync();
            await DictionaryChanged.InvokeAsync();
        }
        catch (Exception ex) { note = $"The dictionary could not be written: {ex.Message}"; }
    }

    private Task OnWordKeyDown(KeyboardEventArgs e) =>
        e.Key == "Enter" && !string.IsNullOrWhiteSpace(wordDraft) ? AddWordAsync() : Task.CompletedTask;

    private string? note;
    private bool vaultMissing;

    // Runs on the Hub (the user's own PC), so it reaches Vault.Desktop's local pipe.
    private void OpenVault()
    {
        vaultMissing = !Settings.OpenVault();
        note = vaultMissing ? null : "Opened MindAttic Vault at Prose's tab.";
    }

    private ElementReference dialog;
    private bool wired;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (wired) return;
        wired = true;
        try { trap = await JS.InvokeAsync<int>("proseModal.open", dialog); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }

    /// <summary>This panel's own focus trap, so closing it can never release another's.</summary>
    private int trap;

    private Task OnKeyDown(KeyboardEventArgs e)
        => e.Key == "Escape" ? OnClose.InvokeAsync() : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        if (trap == 0) return;
        try { await JS.InvokeVoidAsync("proseModal.close", trap); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
    }
}
