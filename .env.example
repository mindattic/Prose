# ---------------------------------------------------------------------------
# Environment variables for StreetSamurai tooling.
# Copy this file to ".env" and fill in real values.
# ".env" is gitignored — never commit real credentials.
# ---------------------------------------------------------------------------

# RunPod vLLM API key — used by tools/gpu-health-monitor.ps1 and review scripts.
# Generate at: https://www.runpod.io/console/user/settings
VLLM_KEY=your-runpod-vllm-key-here
