        {
          "file": "harmonize_descriptions.py",
          "runner": "python",
          "description": "Ensures description tone and vocabulary are consistent across related entity sets",
          "docs": "Compares descriptions within a repo for tone consistency. Entities with outlier tone scores are flagged and optionally regenerated with a harmonizing system prompt that references the established style.",
          "args": [
            { "flag": "--repo REPO",  "default": null,  "desc": "Repo to harmonize" },
            { "flag": "--apply",      "default": false, "desc": "Regenerate outlier descriptions" }
          ]
        },
        {
          "file": "generate_ancestry.py",
          "runner": "python",
          "description": "Generates character family trees and genealogical relationships",
          "docs": "Creates ancestry records for human characters, respecting the Ubiquitous Diaspora world rule (mixed heritage from unexpected global combinations). Non-human species in NON_HUMAN_SPECIES are skipped.",
          "args": [
            { "flag": "--concurrency N", "default": 10, "desc": "Max concurrent API calls" }
          ]
        },
        {
          "file": "generate_character_images.py",
          "runner": "python",
          "description": "Generates character portrait descriptions for image generation pipelines",
          "docs": "Produces visual description prompts for character portraits, organized by tier and role. Output can be fed into image generation APIs.",
          "args": [
            { "flag": "--repo REPO", "default": "people", "desc": "Character repo to process" }
          ]
        }
      ]
