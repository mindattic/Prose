{
  "version": "1.0",
  "categories": [
    {
      "id": "world-linking",
      "name": "World Linking",
      "type": "python",
      "scripts": [
        {
          "file": "wiki_scan.py",
          "runner": "python",
          "description": "Scans all entity files and inserts [[wiki links]] for cross-referencing",
          "docs": "Builds a name index from every entity in engine/data, then scans all text fields for unlinked mentions of other entities. Inserts [[Name]] or [[Name|display]] syntax so the Blazor WikiText renderer can turn them into clickable hyperlinks. Uses word-boundary detection to avoid false matches inside compound words.",
          "args": [
            { "flag": "--dry-run",      "default": true,  "desc": "Preview what would be linked without writing any files (default)" },
            { "flag": "--apply",        "default": false, "desc": "Write [[...]] syntax back to entity JSON files" },
            { "flag": "--interactive",  "default": false, "desc": "Prompt before each insertion; y=accept, n=skip, q=quit" },
            { "flag": "--partial",      "default": false, "desc": "Also report partial/fuzzy matches (name inside compound word)" },
            { "flag": "--repo REPO",    "default": null,  "desc": "Limit scan to one repo folder, e.g. --repo people" },
            { "flag": "--min-length N", "default": 4,     "desc": "Minimum entity name length to match (avoids noise like 'AI')" },
            { "flag": "--data-dir DIR", "default": null,  "desc": "Override engine/data path" }
          ]
        }
      ]
    },
    {
      "id": "data-quality",
      "name": "Data Quality",
      "type": "python",
      "scripts": [
        {
          "file": "consistency_check.py",
          "runner": "python",
          "description": "Cross-entity contradiction detection using local, named-reference, and semantic strategies",
          "docs": "Checks for worldbuilding rule violations across all entity files. Catches currency inconsistencies, broken entity references, pronoun mismatches, and semantic contradictions using three complementary strategies: local field validation, named-reference resolution, and Claude-powered semantic analysis.",
          "args": [
            { "flag": "--repo REPO",    "default": null, "desc": "Limit check to one repo folder" },
            { "flag": "--strategy",     "default": "all","desc": "Which strategies to run: local, named, semantic, all" },
            { "flag": "--output FILE",  "default": null, "desc": "Write report to JSON file instead of stdout" }
          ]
        },
        {
          "file": "quality_rate.py",
          "runner": "python",
          "description": "Rates generated content quality across coherence, flavor, and tone dimensions",
          "docs": "Uses Claude to score entity descriptions across multiple quality dimensions (1-10): coherence (internal logic), flavor (worldbuilding texture), tone (neo-noir appropriateness). Flags low-scoring entities for manual review or regeneration.",
          "args": [
            { "flag": "--repo REPO",   "default": null, "desc": "Limit to one repo folder" },
            { "flag": "--threshold N", "default": 5,    "desc": "Flag entities scoring below N (default: 5)" },
            { "flag": "--apply",       "default": false,"desc": "Write scores back to entity JSON" }
          ]
        },
        {
          "file": "fact_query.py",
          "runner": "python",
          "description": "Query the facts database: statistics, flagged inconsistencies, and entity search",
          "docs": "Interface for querying the SQLite facts database produced by the fact pipeline. Shows overall stats, lists flagged contradictions, and lets you search triples by subject entity name.",
          "args": [
            { "flag": "--stats",          "default": false, "desc": "Show database summary statistics" },
            { "flag": "--flagged",        "default": false, "desc": "List all flagged inconsistencies" },
            { "flag": "--entity NAME",    "default": null,  "desc": "Show all facts for a named entity" },
            { "flag": "--db PATH",        "default": null,  "desc": "Path to facts.db file" }
          ]
        }
      ]
    },
    {
      "id": "fact-pipeline",
      "name": "Fact Pipeline",
      "type": "python",
      "scripts": [
        {
          "file": "run_fact_pipeline.py",
          "runner": "python",
          "description": "Master orchestrator: runs all fact pipeline phases sequentially with resume support",
          "docs": "Runs the complete fact discovery pipeline: extract → embed → cluster → score → repair. Each phase can be skipped with --skip-* flags. Supports resume from any phase if a previous run was interrupted.",
          "args": [
            { "flag": "--skip-extract",  "default": false, "desc": "Skip phase 1 (extraction)" },
            { "flag": "--skip-embed",    "default": false, "desc": "Skip phase 2 (embedding)" },
            { "flag": "--skip-cluster",  "default": false, "desc": "Skip phase 3 (clustering)" },
            { "flag": "--skip-score",    "default": false, "desc": "Skip phase 4 (scoring)" },
            { "flag": "--skip-repair",   "default": false, "desc": "Skip phase 5 (repair)" },
            { "flag": "--repo REPO",     "default": null,  "desc": "Limit to one repo folder" },
            { "flag": "--concurrency N", "default": 20,    "desc": "Max concurrent API calls" }
          ]
        },
        {
          "file": "fact_extract.py",
          "runner": "python",
          "description": "Phase 1: Extracts Subject-Predicate-Object triples from entity descriptions via Claude",
          "docs": "Calls Claude for each entity to extract atomic SPO claims from description text. Stores triples in the facts SQLite database. Supports resume — already-processed entities are skipped.",
          "args": [
            { "flag": "--repo REPO",     "default": null, "desc": "Limit to one repo folder" },
            { "flag": "--concurrency N", "default": 20,   "desc": "Max concurrent API calls" },
            { "flag": "--resume",        "default": true, "desc": "Skip already-processed entities (default: on)" }
          ]
        },
        {
          "file": "fact_embed.py",
          "runner": "python",
          "description": "Phase 2: Converts triples to 384-dimensional sentence embeddings for similarity comparison",
          "docs": "Uses the sentence-transformers library (no API calls) to embed each triple as a dense vector. These vectors are stored in the DB and used by fact_cluster.py to group semantically similar claims.",
          "args": [
            { "flag": "--batch-size N", "default": 64, "desc": "Embedding batch size" }
          ]
        },
        {
          "file": "fact_cluster.py",
          "runner": "python",
          "description": "Phase 3: Groups similar triples with HDBSCAN to identify equivalent claims",
          "docs": "Runs HDBSCAN density-based clustering on the triple embeddings to group claims that say the same thing different ways. Cluster membership is written back to the DB for use in scoring.",
          "args": [
            { "flag": "--min-cluster-size N", "default": 3, "desc": "Minimum cluster size for HDBSCAN" }
          ]
        },
        {
          "file": "fact_score.py",
          "runner": "python",
          "description": "Phase 4: Consensus voting within clusters to determine truth confidence and flag contradictions",
          "docs": "Within each cluster, votes on which claims are true and which contradict the majority. Assigns confidence scores (0.0-1.0) and flags contradictions for review or repair.",
          "args": [
            { "flag": "--threshold F", "default": 0.67, "desc": "Quorum threshold for consensus (default: 0.67)" }
          ]
        },
        {
          "file": "fact_repair.py",
          "runner": "python",
          "description": "Phase 5: Auto-fixes high-confidence errors in source JSON files",
          "docs": "Reviews flagged contradictions with confidence above the threshold and patches the source entity JSON files. Uses Claude to generate the corrected value. Always creates a backup before modifying.",
          "args": [
            { "flag": "--confidence F", "default": 0.9,   "desc": "Minimum confidence to auto-repair (default: 0.9)" },
            { "flag": "--dry-run",      "default": false,  "desc": "Preview repairs without modifying files" }
          ]
        }
      ]
    },
