<Project Sdk="Microsoft.NET.Sdk">

  <!-- v4 Phase 0 CLI: read-only verbs to test StoryStateQuery/SceneWindowService against the real
       DB. Deliberately NOT forwarded through Prose.Hub (see HubCliClient.cs in v3\Prose.Cli — that
       Stage C migration is for production write commands). This runs standalone, local DbContext
       access, exactly like v3's own not-yet-migrated commands already do — so Phase 0-2 development
       doesn't wait on an author Hub redeploy for every change. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);EF1002;EF1003</NoWarn>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\v3\Prose.Core\Prose.Core.csproj" />
    <ProjectReference Include="..\Prose.V4.Core\Prose.V4.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

</Project>
